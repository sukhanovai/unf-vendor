#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	РежимВыбора = Параметры.РежимВыбора;
	
	Элементы.Список.РежимВыбора = РежимВыбора;
	Элементы.КлассификаторВыбрать.КнопкаПоУмолчанию = Не РежимВыбора;
	Если РежимВыбора Тогда
		Элементы.КлассификаторВыбрать.Заголовок = НСтр("ru = 'Выбрать'");
	Иначе
		Элементы.КлассификаторВыбрать.Заголовок = НСтр("ru = 'Загрузить'");
	КонецЕсли;
	
	УстановитьВидимостьЭлементовДляИнтерфейса85();
	
	ТекстЗапроса = "";
	ИнтеграцияИС.ОпределитьТекстЗапросаСопоставлениеКодовТНВЭД(ТекстЗапроса);
	Если ТекстЗапроса <> "" Тогда
		Список.ТекстЗапроса = ТекстЗапроса;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ВидПродукцииТоварнаяГруппа) Тогда
		
		ВходящиеВидыПродукции = КонструкторИСМПОбщегоНазначенияКлиентСервер.ВидыПродукции(Параметры.ВидПродукцииТоварнаяГруппа);
		Если ТипЗнч(ВходящиеВидыПродукции) = Тип("Массив") Тогда
			ВидыПродукции = Новый ФиксированныйМассив(ВходящиеВидыПродукции);
		Иначе
			ВидыПродукции = ВходящиеВидыПродукции;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список, "ВидПродукции", ВидыПродукции,,, Истина);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Классификатор, "ВидПродукции", ВидыПродукции,,, Истина);
		
		Элементы.СписокВидПродукции.Видимость        = Ложь;
		Элементы.КлассификаторВидПродукции.Видимость = Ложь;
		
	КонецЕсли;
	
	ВозвращатьСсылкуНаЭлементКлассификатора = Параметры.ВозвращатьСсылкуНаЭлементКлассификатора;
	
	ОбщегоНазначенияСобытияФормИСПереопределяемый.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьДоступностьКнопкиВыбрать();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	УстановитьВидимостьДоступностьКнопкиВыбрать();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ОбработкаВыбораЗначенияСписка(Элемент.ТекущаяСтрока, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОбработкаВыбораЗначенияСписка(ВыбраннаяСтрока, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	УстановитьВидимостьДоступностьКнопкиВыбрать();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКлассификатор

&НаКлиенте
Процедура КлассификаторВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ОбработкаВыбораЗначенияКлассификатораИзСписка(Элемент.ТекущаяСтрока, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура КлассификаторВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОбработкаВыбораЗначенияКлассификатораИзСписка(ВыбраннаяСтрока, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура КлассификаторПриАктивизацииСтроки(Элемент)
	
	УстановитьВидимостьДоступностьКнопкиВыбрать();
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ВыбратьИзТекущегоСписка(Команда)
	
	ИмяЭлементаСписок = ИмяСпискаПоТекущейСтранице(ЭтотОбъект);
	
	ТекущиеДанные = Элементы[ИмяЭлементаСписок].ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Если ИмяЭлементаСписок = "Список" Тогда
			ОбработкаВыбораЗначенияСписка(ТекущиеДанные, Ложь);
		Иначе
			ОбработкаВыбораЗначенияКлассификатораИзСписка(ТекущиеДанные, Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораЗначенияСписка(ВыбраннаяСтрока, СтандартнаяОбработка)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимВыбора Тогда
		
		СтандартнаяОбработка = Ложь;
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыбраннаяСтрока);
		
		Если ТипЗнч(ВыбраннаяСтрока) = Тип("ДанныеФормыСтруктура")
			Или ТипЗнч(ВыбраннаяСтрока) = Тип("ДанныеФормыЭлементКоллекции") Тогда
			ДанныеСтроки = ВыбраннаяСтрока;
		Иначе
			ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыбраннаяСтрока);
		КонецЕсли;
	
		Если ВозвращатьСсылкуНаЭлементКлассификатора Тогда
			Результат = ОбработкаВыбораЗначенияИзСпискаНаСервере(
				ДанныеСтроки.КодТНВЭД,
				ДанныеСтроки.НаименованиеПолное,
				ДанныеСтроки.ВидПродукции,
				Ложь);
			ВыбранноеЗначение = Результат.ЭлементСправочника;
		Иначе
			ВыбранноеЗначение = ДанныеСтроки.КодТНВЭД;
		КонецЕсли;
		
		ОповеститьОВыборе(ВыбранноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораЗначенияКлассификатораИзСписка(ВыбраннаяСтрока, СтандартнаяОбработка)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбраннаяСтрока) = Тип("ДанныеФормыСтруктура")
		Или ТипЗнч(ВыбраннаяСтрока) = Тип("ДанныеФормыЭлементКоллекции") Тогда
		ДанныеСтроки = ВыбраннаяСтрока;
	Иначе
		ДанныеСтроки = Элементы.Классификатор.ДанныеСтроки(ВыбраннаяСтрока);
	КонецЕсли;
	
	Результат = ОбработкаВыбораЗначенияИзСпискаНаСервере(
		ДанныеСтроки.Код,
		ДанныеСтроки.НаименованиеПолное,
		ДанныеСтроки.ВидПродукции,
		ДанныеСтроки.Загружен = 0);
	
	Если ВозвращатьСсылкуНаЭлементКлассификатора Тогда
		ВыбранноеЗначение = Результат.ЭлементСправочника;
	Иначе
		ВыбранноеЗначение = ДанныеСтроки.Код;
	КонецЕсли;
	
	Если РежимВыбора Тогда
		ОповеститьОВыборе(ВыбранноеЗначение);
	ИначеЕсли ДанныеСтроки.Загружен = 0 Тогда
		Элементы.Список.Обновить();
		Элементы.Классификатор.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработкаВыбораЗначенияИзСпискаНаСервере(КодТНВЭД, Наименование, ВидПродукции, Записывать)
	
	Результат = ИнтеграцияИСМП.ПолучитьДанныеСопоставленногоКлассификатораТНВЭД(КодТНВЭД, Наименование);
	
	Если Записывать Тогда
		
		Если ЗначениеЗаполнено(Результат.НаименованиеПолное) Тогда
			НаименованиеПолное = Результат.НаименованиеПолное;
		Иначе
			НаименованиеПолное = Наименование;
		КонецЕсли;
		
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("КодТНВЭД", КодТНВЭД);
		СтруктураЗаписи.Вставить("ВидПродукции", ВидПродукции);
		СтруктураЗаписи.Вставить("НаименованиеПолное", НаименованиеПолное);
		
		РегистрыСведений.КодыТНВЭДИСМП.ЗаписатьДанныеКода(СтруктураЗаписи);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьДоступностьКнопкиВыбрать()
	
	Если Не ЭтоИнтерфейс85 Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ФормаВыбратьИзТекущегоСписка.Видимость = РежимВыбора;
	Если РежимВыбора Тогда
		
		ИмяЭлементаСписок = ИмяСпискаПоТекущейСтранице(ЭтотОбъект);
		ДоступностьКоманды = Элементы[ИмяЭлементаСписок].ТекущиеДанные <> Неопределено;
		
		Элементы.ФормаВыбратьИзТекущегоСписка.Доступность = ДоступностьКоманды;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяСпискаПоТекущейСтранице(Форма)
	
	Элементы = Форма.Элементы;
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗагружено Тогда
		Возврат "Список";
	Иначе //Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаКлассификатор
		Возврат "Классификатор";
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьЭлементовДляИнтерфейса85()
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияИСКлиентСерверПовтИсп.ЭтоИнтерфейс85();
	
	ОтображатьКоманднуюПанель = ЭтоИнтерфейс85;
	
	Элементы.Список.РежимВыбора                     = РежимВыбора И Не ЭтоИнтерфейс85;
	Элементы.КлассификаторВыбрать.КнопкаПоУмолчанию = Не РежимВыбора И Не ЭтоИнтерфейс85;
	Элементы.КлассификаторВыбрать.Видимость         = Не РежимВыбора Или Не ЭтоИнтерфейс85;
	
КонецПроцедуры

#КонецОбласти
