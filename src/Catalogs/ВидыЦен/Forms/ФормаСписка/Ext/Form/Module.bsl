#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//// СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	
	//// Конец СтандартныеПодсистемы.ПодключаемыеКоманды  
	
	
	// Установка доступности цен для редактирования.
	РазрешеноРедактированиеЦенДокументов = УправлениеДоступомУНФ.РазрешеноРедактированиеЦенДокументов();
	
	ИспользоватьУстановкуЦен = ПолучитьФункциональнуюОпцию("ИспользоватьУстановкуЦен");
	
	Элементы.Список.ТолькоПросмотр = НЕ РазрешеноРедактированиеЦенДокументов;
	Элементы.УстановитьЦены.Видимость = РазрешеноРедактированиеЦенДокументов И ИспользоватьУстановкуЦен;
	
	ЦенообразованиеСервер.УстановитьПараметрыДинамическогоСпискаВидовЦен(Список);
	Список.Параметры.УстановитьЗначениеПараметра("УстановитьЦены", НСтр("ru = 'Установить цены'"));
	
	Если НЕ ИспользоватьУстановкуЦен Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаУстановкаЦен", "Видимость", Ложь);

	КонецЕсли; 
	
	// Установить основной элемент списка
	ОсновнойВидЦен	= ПерсональныеНастройкиРУНФ.Прочитать("ОсновнойВидЦенПродажи");
	Список.Параметры.УстановитьЗначениеПараметра("ОсновнойВидЦен", ОсновнойВидЦен);

	
	КэшЗначений = Новый Структура;
	КэшЗначений.Вставить("Статический",			Перечисления.ТипыВидовЦен.Статический);
	КэшЗначений.Вставить("ДинамическийПроцент", Перечисления.ТипыВидовЦен.ДинамическийПроцент);
	КэшЗначений.Вставить("ДинамическийФормула", Перечисления.ТипыВидовЦен.ДинамическийФормула);
	КэшЗначений.Вставить("ПроизвольныйЗапрос",	Перечисления.ТипыВидовЦен.ПроизвольныйЗапрос);
	КэшЗначений.Вставить("Расширение",	Перечисления.ТипыВидовЦен.Расширение);
	КэшЗначений.Вставить("ЭтоЗагрузкаИзВнешнегоИсточника", Неопределено);
	КэшЗначений.Вставить("ПараметрыДлительнойОперации", Новый Структура);
	КэшЗначений.ПараметрыДлительнойОперации.Вставить("РезультатЗагрузки",	Неопределено);
	КэшЗначений.ПараметрыДлительнойОперации.Вставить("ИдентификаторЗадания","");
	
	Параметры.Свойство("ЭтоЗагрузкаИзВнешнегоИсточника", КэшЗначений.ЭтоЗагрузкаИзВнешнегоИсточника);
	
	ПрочитатьПрайсЛисты();
	
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		
		ИндикаторКоличестваЦен();
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОчисткаЦен", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаКомандаУстановитьОсновнойЭлемент",
			"Видимость", УправлениеДоступомУНФ.РазрешеноРедактированиеЦенДокументов());
		
	КонецЕсли; 	
		
	// СтандартныеПодсистемы.ЗагрузкаДанныхИзВнешнегоИсточника
	ЗагрузкаДанныхИзВнешнегоИсточника.ПриСозданииНаСервере(Метаданные.РегистрыСведений.ЦеныНоменклатуры,
		НастройкиЗагрузкиДанных, ЭтотОбъект, Ложь);
	// Конец СтандартныеПодсистемы.ЗагрузкаДанныхИзВнешнегоИсточника
	
	Если ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		
		Элементы.ОтборПрайсЛистыФлаг.Вид = ВидПоляФормы.ПолеНадписи;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборПрайсЛистыФлаг", "Формат",
			"БЛ=пропустить; БИ=рассчитывается;");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Группа1", "Группировка",
			ГруппировкаКолонок.Горизонтальная);
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Недействителен", Ложь,,,
		Не Элементы.ПоказыватьНедействительных.Пометка);
		
	ПрочитатьИУстановитьНастройкиФормы();
	
	УстановитьУсловноеОформление();
	
	Если Параметры.ВыделитьКолонкуПорядок Тогда
		Элементы.ПорядокОтображения.ЦветФонаЗаголовка = ЦветаПалитры.ФонУправляющегоПоляУНФ;
	КонецЕсли;
	
	АдаптацияТакси();
	УстановитьОтображениеКомандыСброситьВсеОтборыНаСервере();
	ВывестиВажноеСообщениеБаннерНаСервере();
	
КонецПроцедуры // ПриСозданииНаСервере()

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если КэшЗначений.ЭтоЗагрузкаИзВнешнегоИсточника = Истина Тогда
		
		ПодключитьОбработчикОжидания("ПоказатьПомощникЗагрузкиДанныхИзВнешнегоИсточника", 0.2, Истина);
		
	КонецЕсли;
	
	ВремяЗадержкиОбработчиковОжидания = ДокументыУНФКлиент.ВремяЗадержкиОбработчиковОжидания(); 
	
КонецПроцедуры

&НаКлиенте
// Процедура - обработчик события ОбработкаОповещения
//
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписьРасчетныхЦен" Тогда
		
		Элементы.Список.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЗначокДеталиНажатие(Элемент)
	
	СвернутьРазвернутьПанельОтборов();
	ТекущаяСтраница = Элементы.Детали;
	Элементы.ПраваяПанельСтраницы.ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваяПанельСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница) 
	
	Если Элементы.ПраваяПанельСтраницы.ТекущаяСтраница = Элементы.Детали Тогда
		ОбновитьДетали();
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗначокФильтрыНажатие(Элемент)
	
	СвернутьРазвернутьПанельОтборов(); 
	
	ТекущаяСтраница = Элементы.ФильтрыНастройкиИДопИнфо;
	Элементы.ПраваяПанельСтраницы.ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

&НаКлиенте
Процедура ИндексФильтрыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;   
	
	СвернутьРазвернутьПанельОтборов();  
	
	ТекущаяСтраница = Элементы.ФильтрыНастройкиИДопИнфо;
	Элементы.ПраваяПанельСтраницы.ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияКартинкаКоличестваЦенНажатие(Элемент)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеУдалениеУстаревшихЦен", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.УдалениеУстаревшихЦен.Форма", Неопределено, ЭтотОбъект, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияКартинкаКоличестваЦенРасширеннаяПодсказкаОбработкаНавигационнойСсылки(Элемент,
	НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеУдалениеУстаревшихЦен", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.УдалениеУстаревшихЦен.Форма", Неопределено, ЭтотОбъект, , , , ОписаниеОповещения);
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Для каждого СтрокаСписка Из Строки Цикл
	
		СтрокаСписка.Значение.Данные.ПредставлениеРасчета = 
			Справочники.ВидыЦен.ПолучитьПредставлениеСпособаРасчетаВидаЦены(СтрокаСписка.Ключ);
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	ОценкаПроизводительностиКлиент.ЗамерВремени("СозданиеФормы"
		+ РаботаСФормойДокументаКлиентСервер.ПолучитьИмяФормыСтрокой(ИмяФормы));
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	ОценкаПроизводительностиКлиент.ЗамерВремени("ОткрытиеФормы"
		+ РаботаСФормойДокументаКлиентСервер.ПолучитьИмяФормыСтрокой(ИмяФормы));
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.УстановитьЦены Тогда
		
		СтандартнаяОбработка = Ложь;
		СформироватьЦены(ВыбраннаяСтрока);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ОбновитьДетали = Элементы.ПраваяПанельСтраницы.ТекущаяСтраница = Элементы.Детали
	И ТипЗнч(Элемент.ТекущаяСтрока) <> Тип("СтрокаГруппировкиДинамическогоСписка");
	СписокПриАктивизацииСтрокиОбработчикНаСервере(ОбновитьДетали);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры 

&НаКлиенте
Процедура СписокПриНаведении(Элемент, Строка, Поле)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтборПрайсЛисты

&НаКлиенте
Процедура ОтборПрайсЛистыФлагПриИзменении(Элемент)
	
	ОбработатьИзменениеФлажкаОтбораПрайсЛистов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПрайсЛистыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	#Если МобильныйКлиент Тогда
		
		СтандартнаяОбработка = Ложь;
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПрайсЛистыПриАктивизацииСтроки(Элемент)
	
	#Если НЕ МобильныйКлиент Тогда
		
		Возврат;
		
	#КонецЕсли
	
	ДанныеТекущейСтроки = Элементы.ОтборПрайсЛисты.ТекущиеДанные;
	Если ДанныеТекущейСтроки = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДанныеТекущейСтроки.Флаг = НЕ ДанныеТекущейСтроки.Флаг;
	ОбработатьИзменениеФлажкаОтбораПрайсЛистов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СброситьВсеОтборы(Команда) 
	
	СброситьВсеМеткиОтбораНаСервере(); 
	
КонецПроцедуры 

&НаКлиенте
Процедура НастройкиМинимальныхЦен(Команда)
	
	ОткрытьФорму("Справочник.СтруктурныеЕдиницы.Форма.ФормаУказанияМинимальныхЦен");
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьПравуюПанель(Команда)     
	 
	СвернутьРазвернутьПанельОтборов();
	
КонецПроцедуры 

// Процедура - обработчик выполнения команды УстановитьОсновнойЭлемент
//
&НаКлиенте
Процедура КомандаУстановитьОсновнойЭлемент(Команда)
		
	ВыбранныйЭлемент = Элементы.Список.ТекущаяСтрока;
	Если ЗначениеЗаполнено(ВыбранныйЭлемент) Тогда
		УстановитьОсновнойЭлемент(ВыбранныйЭлемент);	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьНедействительных(Команда)
	
	Элементы.ПоказыватьНедействительных.Пометка = Не Элементы.ПоказыватьНедействительных.Пометка;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Недействителен",
		Ложь,
		,
		,
		Не Элементы.ПоказыватьНедействительных.Пометка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЦеныИзВнешнегоИсточника(Команда)
	
	ДанныеТекущейСтроки = Элементы.Список.ТекущиеДанные;
	Если ДанныеТекущейСтроки = Неопределено Тогда
		
		ТекстСообщения = НСтр("ru ='Необходимо выделить вид цен, для которого планируется загрузить цены'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
		
	КонецЕсли;

	Если ДанныеТекущейСтроки.ТипВидаЦен <> КэшЗначений.Статический Тогда
		
		ТекстСообщения = НСтр("ru ='Загрузка предназначена только для статических видов цен.'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения, 15, НСтр("ru ='Загрузить цены из внешнего источника'"));
		Возврат;
		
	КонецЕсли;
	
	ПоказатьПомощникЗагрузкиДанныхИзВнешнегоИсточника();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура АдаптацияТакси()
	
	Интерфейс85 = ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	ИнтерфейсТакси = Не Интерфейс85;
	
	Элементы.ИндексФильтрыТакси.Видимость = ИнтерфейсТакси;
	Элементы.ИндексФильтры.Видимость = Интерфейс85;	
			
	Если ИнтерфейсТакси Тогда 
		
		Элементы.Переместить(Элементы.ФормаНастройкиМинимальныхЦен, Элементы.СписокКоманднаяПанель);
		Элементы.ФормаКоманднаяПанель.Видимость = Ложь;

	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ВывестиВажноеСообщениеБаннерНаСервере()
		
	ПараметрыСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыСообщения.ТипСообщения			= "Информация";
	ПараметрыСообщения.Скрываемый			= Истина;  
	ПараметрыСообщения.Заголовок			= НСтр("ru = 'Варианты установки цен:'");
	
	Сообщение = СтроковыеФункции.ФорматированнаяСтрока(НСтр("ru = 'Для установки цены номенклатуры можно воспользоваться следующими инструментами:
	| • Продажи - Цены и скидки - документ ""Установка цен"" или вводом на основании документов: ""Приходная накладная"", ""Авансовый отчет"", ""Оприходование товаров""
	| • Главное - Товары и услуги - Номенклатура - Карточка товара'"));
	
	ПараметрыСообщения.Сообщение			= Сообщение; 
	
	ПараметрыСообщения.КраткоеПредставление	= НСтр("ru = 'Варианты установки цен'");
	ПараметрыСообщения.Идентификатор 		= "ВариантыУстановкиЦенВидыЦен"; 
	ПараметрыСообщения.ОбработчикЗакрытия	= "Подключаемый_ОбработчикЗакрытияОсновнойБанерФормы";
	
	Действие1 = ОбщегоНазначения.ПараметрыДействияВажногоСообщения();
	Действие1.ИмяКоманды	= "ПерейтиКДокументамУстановкаЦен";
	Действие1.Заголовок	= НСтр("ru = 'Документ ""Установка цен""'");
	Действие1.Обработчик	= "Подключаемый_ПерейтиКДокументУстановкаЦен";
	
	Действие2 = ОбщегоНазначения.ПараметрыДействияВажногоСообщения();
	Действие2.ИмяКоманды	= "ПерейтиКСпискуНоменклатуры";
	Действие2.Заголовок	= НСтр("ru = 'В карточке номенклатуры'");
	Действие2.Обработчик	= "Подключаемый_ПерейтиКСпискуНоменклатуры";
	
	МассивДействий = Новый Массив;   
	МассивДействий.Добавить(Действие1);
	МассивДействий.Добавить(Действие2);
	
	ПараметрыСообщения.ПараметрыДействия = МассивДействий;
	
