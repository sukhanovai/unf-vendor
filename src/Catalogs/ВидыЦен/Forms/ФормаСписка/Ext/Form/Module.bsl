&НаСервере
Процедура СписокПриАктивизацииСтрокиОбработчикНаСервере(ОбновитьДетали)
		
	Если ОбновитьДетали Тогда
		ОбновитьДетали();
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ОбновитьДетали()
	
	ЗаполнитьПанельДетали();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПанельДетали()
	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписаниеВидаЦен(ТекущаяСтрока);
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьОписаниеВидаЦен(ДанныеТекущейСтроки)
		
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеТекущейСтроки, "ПоказатьПредупреждение") Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияПредупреждение",
			"Видимость", ДанныеТекущейСтроки.ПоказатьПредупреждение);
		
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеФлажкаОтбораПрайсЛистов()
	
	ТекущаяСтрокаДерева = ОтборПрайсЛисты.НайтиПоИдентификатору(
		Элементы.ОтборПрайсЛисты.ТекущиеДанные.ПолучитьИдентификатор());
	УстановитьФлагУПодчиненных(ТекущаяСтрокаДерева.ПолучитьЭлементы(), ТекущаяСтрокаДерева.Флаг);
	
	ПрайсЛисты	= НайтиВыбранныеСтроки(ОтборПрайсЛисты.ПолучитьЭлементы());
	ВидыЦен		= ВидыЦенПрайсЛистов(ПрайсЛисты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", ВидыЦен,
		ВидСравненияКомпоновкиДанных.ВСписке, , (ВидыЦен.Количество() > 0));
	
	#Если МобильныйКлиент Тогда
		
		ТекстЗаголовка = СтрШаблон(НСтр("ru ='Фильтр по прайс-листам %1'"), ?(ВидыЦен.Количество() > 0, НСтр(
		"ru =' (установлен)'"), ""));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФильтрыНастройкиИДопИнфо", "Заголовок",
		ТекстЗаголовка);
		
	#КонецЕсли	
	
	КоличествоФильтров = ПрайсЛисты.Количество();
	КоличествоФильтровИндекс = Мин(ПрайсЛисты.Количество(), 10);
	КоличествоДопФильтров = КоличествоФильтров;
	
	УстановитьОтображениеКомандыСброситьВсеОтборыНаСервере();
	
КонецПроцедуры 

#КонецОбласти
