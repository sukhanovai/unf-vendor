#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	Если ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
		ПараметрыРазмещения.КоманднаяПанель = Элементы.Список.КоманднаяПанель;
	Иначе
		ПараметрыРазмещения.КоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	КонецЕсли;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// УНФ.ПанельКонтактнойИнформации
	КонтактнаяИнформацияПанельУНФ.ПриСозданииНаСервере(ЭтотОбъект, "КонтактнаяИнформация", "СписокКонтекстноеМеню");
	// Конец УНФ.ПанельКонтактнойИнформации
	
	РежимВыбора = Параметры.РежимВыбора;
	
	Элементы.Список.РежимВыбора = РежимВыбора;

	Если Не Элементы.Список.РежимВыбора Тогда
		Если Параметры.Свойство("ПодчиненныеКассыККМ") Тогда
			Элементы.ПраваяПанель.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// УНФ.ОтборыСписка
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект);
	// Конец УНФ.ОтборыСписка
	
	Элементы.ОтборТип.СписокВыбора.Добавить(Перечисления.ТипыКассККМ.ФискальныйРегистратор);
	
	Если ПолучитьФункциональнуюОпцию("УчетРозничныхПродаж") Тогда
		Элементы.ОтборТип.СписокВыбора.Добавить(Перечисления.ТипыКассККМ.АвтономнаяККМ);
		Элементы.ОтборТип.СписокВыбора.Добавить(Перечисления.ТипыКассККМ.ККМED);
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьОбменСПодключаемымОборудованиемOffline") Тогда
		Элементы.ОтборТип.СписокВыбора.Добавить(Перечисления.ТипыКассККМ.ККМOffline);
		Элементы.ОтборТип.СписокВыбора.Добавить(Перечисления.ТипыКассККМ.СервисОборудования);
	КонецЕсли;
	
	// УНФ.ОтборыСписка
	Если Не Параметры.Свойство("ПодчиненныеКассыККМ") Тогда
		ИспользоватьГруппыМагазины = Константы.ИспользоватьГруппыМагазины.Получить();
		Элементы.МагазинИлиГруппа.Видимость = ИспользоватьГруппыМагазины;
		Элементы.ОтборГруппа.Видимость = ИспользоватьГруппыМагазины;
	КонецЕсли;
	РаботаСОтборами.ВосстановитьНастройкиОтборов(ЭтотОбъект, Список, "Список",,,,Ложь);
	// Конец УНФ.ОтборыСписка
	Если РежимВыбора Тогда
		ЗначениеНастройки = ПерсональныеНастройкиРУНФ.Прочитать("ОсновнаяГруппаСкладов");
		ОсновнаяГруппаСкладов = ?(ЗначениеЗаполнено(ЗначениеНастройки), ЗначениеНастройки, Справочники.СтруктурныеЕдиницы.ПустаяСсылка());
	КонецЕсли;
	
	Если РежимВыбора
		И ЗначениеЗаполнено(ОсновнаяГруппаСкладов) Тогда
		ТипСклада = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновнаяГруппаСкладов, "ТипСтруктурнойЕдиницы");
		Если ТипСклада = Перечисления.ТипыСтруктурныхЕдиниц.МагазинГруппаСкладов Тогда
			РаботаСОтборами.ПрикрепитьМеткуОтбора(ЭтотОбъект, "СтруктурнаяЕдиницаРодитель", "МагазинИлиГруппа", ЗначениеНастройки, Строка(ЗначениеНастройки));
			РаботаСОтборами.УстановитьОтборСписка(ЭтотОбъект, Список, "СтруктурнаяЕдиницаРодитель",,Истина);
		Иначе
			РаботаСОтборами.ПрикрепитьМеткуОтбора(ЭтотОбъект, "СтруктурнаяЕдиница", "ТорговаяТочка", ЗначениеНастройки, Строка(ЗначениеНастройки));
			РаботаСОтборами.УстановитьОтборСписка(ЭтотОбъект, Список, "СтруктурнаяЕдиница",,Истина);
		КонецЕсли;
	КонецЕсли;
		
		
	Если Не Параметры.Свойство("ПодчиненныеКассыККМ") Тогда
		
		Для Каждого ЭлементОтбора Из Параметры.Отбор Цикл
			Если Не ЗначениеЗаполнено(ЭлементОтбора.Значение) Тогда
				Параметры.Отбор.Удалить(ЭлементОтбора.Ключ);
			КонецЕсли
		КонецЦикла;
		
		Если Параметры.Отбор.Свойство("ТипКассы") Тогда
			
			Элементы.ОтборТип.Доступность = Ложь;
			
			Если ТипЗнч(Параметры.Отбор.ТипКассы) = Тип("ПеречислениеСсылка.ТипыКассККМ") Тогда
				РаботаСОтборами.ПрикрепитьМеткуОтбора(ЭтотОбъект, "ТипКассы", "Тип", Параметры.Отбор.ТипКассы, Строка(Параметры.Отбор.ТипКассы));
			ИначеЕсли ТипЗнч(Параметры.Отбор.ТипКассы) = Тип("ФиксированныйМассив") Тогда
				Для Каждого ЭлементМассива Из Параметры.Отбор.ТипКассы Цикл
					РаботаСОтборами.ПрикрепитьМеткуОтбора(ЭтотОбъект, "ТипКассы", "Тип", ЭлементМассива, Строка(ЭлементМассива));
				КонецЦикла;
			ИначеЕсли Параметры.Отбор.Свойство("ТипСтруктурнойЕдиницы") Тогда
				Для Каждого ЭлементМассива Из Параметры.Отбор.ТипСтруктурнойЕдиницы Цикл
					РаботаСОтборами.ПрикрепитьМеткуОтбора(ЭтотОбъект, "ТипКассы", "Тип", ЭлементМассива, Строка(ЭлементМассива));
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущееРабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	Список.Параметры.УстановитьЗначениеПараметра("ТекущееРабочееМесто", ТекущееРабочееМесто);
	
	СписокИспользуемыхКассККМТипаККМED = СписокИспользуемыхКассККМТипаККМED();
	Список.Параметры.УстановитьЗначениеПараметра("СписокИспользуемыхКассККМТипаККМED",
		СписокИспользуемыхКассККМТипаККМED);
		
	ИнтерфейсТакси = НЕ ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	УстановитьУсловноеОформлениеПоЦветамСостоянийСервер();
	ВремяЗадержкиОбработчиковОжидания = 0.3;
	АдаптацияФормыТакси();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВремяЗадержкиОбработчиковОжидания = ДокументыУНФКлиент.ВремяЗадержкиОбработчиковОжидания();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Элементы.Список.РежимВыбора Тогда
		
		Если Элементы.ПраваяПанель.Видимость Тогда
			
			//УНФ.ОтборыСписка
			СохранитьНастройкиОтборов();
			//Конец УНФ.ОтборыСписка
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьМеткуИОтборСписка("Владелец", Элемент.Родитель.Имя, ВыбранноеЗначение);
	ВыбранноеЗначение = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура ОтборТипОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьМеткуИОтборСписка("ТипКассы", Элемент.Родитель.Имя, ВыбранноеЗначение);
	ВыбранноеЗначение = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ОтборИспользуетсяОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные,
	ВыборДобавлением, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьМеткуИОтборСписка("Используется", Элемент.Родитель.Имя, ВыбранноеЗначение);
	ВыбранноеЗначение = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборГруппаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьМеткуИОтборСписка("СтруктурнаяЕдиницаРодитель", Элемент.Родитель.Имя, ВыбранноеЗначение);
	ВыбранноеЗначение = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура ОтборТорговаяТочкаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьМеткуИОтборСписка("СтруктурнаяЕдиница", Элемент.Родитель.Имя, ВыбранноеЗначение);
	
	ВыбранноеЗначение = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура ОтборТорговаяТочкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МассивОтбора = Новый Массив;
	МассивОтбора.Добавить(ПредопределенноеЗначение("Перечисление.ТипыСтруктурныхЕдиниц.Склад"));
	МассивОтбора.Добавить(ПредопределенноеЗначение("Перечисление.ТипыСтруктурныхЕдиниц.Розница"));
	
	ПараметрыОтбора = Новый Структура("ТипСтруктурнойЕдиницы", МассивОтбора);
	
	ПараметрыФормы = Новый Структура("Отбор, РежимВыбора", ПараметрыОтбора, Истина);
	
	ОткрытьФорму("Справочник.СтруктурныеЕдиницы.ФормаСписка", ПараметрыФормы, Элемент, , , , ,
		РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначокФильтрыНажатие(Элемент)
	
	СвернутьРазвернутьПанельОтборов();
	ТекущаяСтраница = Элементы.ФильтрыНастройкиИДопИнфо;
	Элементы.ПраваяПанельСтраницы.ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

&НаКлиенте
Процедура ИндексФильтрыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СвернутьРазвернутьПанельОтборов();
	ТекущаяСтраница = Элементы.ФильтрыНастройкиИДопИнфо;
	Элементы.ПраваяПанельСтраницы.ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначокКонтактыНажатие(Элемент)
	
	СвернутьРазвернутьПанельОтборов();
	ТекущаяСтраница = Элементы.Контакты;
	Элементы.ПраваяПанельСтраницы.ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ЭтотОбъект.КИ_НужноИзменитьДанныеПриАктивизацииСтрокиТаблицы =
		КонтактнаяИнформацияПанельУНФКлиент.НужноИзменитьКонтактнуюИнформациюПриАктивизацииСтрокиТаблицы(
		ЭтотОбъект, Элемент, ТекущаяСтруктурнаяЕдиница, "СтруктурнаяЕдиница");
	
	Если ЭтотОбъект.КИ_НужноИзменитьДанныеПриАктивизацииСтрокиТаблицы Тогда
		ПодключитьОбработчикОжидания("СписокПриАктивизацииСтрокиОбработчик",
			ВремяЗадержкиОбработчиковОжидания, Истина);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриНаведении(Элемент, Строка, Поле)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НастроитьОтборы(Команда)
	
	ИмяРеквизитаСписка = "Список";
	ИмяТЧДанныеМеток = "ДанныеМеток";
	ИмяТЧДанныеОтборов = "ДанныеОтборов";
	ИмяГруппыОтборов = "ГруппаОтборы";
	ИмяПредопределенныеОтборыПоУмолчанию = "ПредопределенныеОтборыПоУмолчанию";
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяРеквизитаСписка", ИмяРеквизитаСписка);
	ДополнительныеПараметры.Вставить("ИмяТЧДанныеМеток", ИмяТЧДанныеМеток);
	ДополнительныеПараметры.Вставить("ИмяТЧДанныеОтборов", ИмяТЧДанныеОтборов);
	ДополнительныеПараметры.Вставить("ИмяГруппыОтборов", ИмяГруппыОтборов);
	ДополнительныеПараметры.Вставить("ИмяПредопределенныеОтборыПоУмолчанию", ИмяПредопределенныеОтборыПоУмолчанию);
	
	РаботаСОтборамиКлиент.НастроитьОтборыНажатие(ЭтотОбъект, ПараметрыОткрытияФормыСНастройкамиОтборов(
		ДополнительныеПараметры), ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьВсеОтборы(Команда)
	СброситьВсеМеткиОтбораНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СвернутьПравуюПанель(Команда)
	
	СвернутьРазвернутьПанельОтборов();
	
КонецПроцедуры

#КонецОбласти

