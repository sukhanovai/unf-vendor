#КонецОбласти

&НаСервере
Процедура АдаптацияФормыТакси()
	
	Элементы.ГруппаГлобальныеКоманды.Видимость = ИнтерфейсТакси;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтрокиОбработчик()
	
	ОбновитьКИ = ЭтотОбъект.КИ_НужноИзменитьДанныеПриАктивизацииСтрокиТаблицы;
	СписокПриАктивизацииСтрокиОбработчикНаСервере(ОбновитьКИ);
	
КонецПроцедуры

&НаСервере
Процедура СписокПриАктивизацииСтрокиОбработчикНаСервере(Знач ОбновитьКИ)
	
	Если ОбновитьКИ Тогда
		КонтактнаяИнформацияПанельУНФ.ОбновитьДанныеПанели(ЭтотОбъект, ТекущаяСтруктурнаяЕдиница);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеПоЦветамСостоянийСервер(ИспользоватьОплатуСертификатамиНСПК = Ложь)
	
	Если ИнтерфейсТакси Тогда
		СтильОформления = "ЦветФона";
	Иначе
		СтильОформления = "ЦветОтметки";
	КонецЕсли;
	
	УсловноеОформлениеКД = Список.КомпоновщикНастроек.Настройки.УсловноеОформление;
	УдаляемыеЭлементы = Новый Массив;
	ИдентификаторНастройкиСостояния = "ЦветСостоянияИспользованияКассыКММ";
	
	Для Каждого ЭлементУсловногоОформления Из УсловноеОформлениеКД.Элементы Цикл
		Если ЭлементУсловногоОформления.ИдентификаторПользовательскойНастройки = ИдентификаторНастройкиСостояния Тогда
			УдаляемыеЭлементы.Добавить(ЭлементУсловногоОформления);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементУсловногоОформления Из УдаляемыеЭлементы Цикл
		УсловноеОформлениеКД.Элементы.Удалить(ЭлементУсловногоОформления);
	КонецЦикла;
	
	ЦветаСостояний = ЦветаСостоянийИспользованияКассКММ();
	Для Каждого ЦветСостояния Из ЦветаСостояний Цикл
		ЭлементУсловногоОформления = УсловноеОформлениеКД.Элементы.Добавить();
		
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра(СтильОформления, ЦветСостояния.Значение);
		ЭлементУсловногоОформления.ИдентификаторПользовательскойНастройки = ИдентификаторНастройкиСостояния;
		ЭлементУсловногоОформления.Представление = НСтр("ru='Оформление бейджика в цвет состояния использования кассы КММ'");
		ЭлементУсловногоОформления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		
		ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных("Используется");
		ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение	= ЦветСостояния.Ключ;
		
		ОформляемоеПолеКД = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПолеКД.Поле = Новый ПолеКомпоновкиДанных("Используется");
		ОформляемоеПолеКД.Использование = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦветаСостоянийИспользованияКассКММ()
	
	ЦветаСостояний = Новый Соответствие;
	ЦветаСостояний.Вставить(Перечисления.СостоянияИспользованияКассКММ.ТекущееРабочееМесто, ЦветаПалитры.Зеленый);
	ЦветаСостояний.Вставить(Перечисления.СостоянияИспользованияКассКММ.ОбщийДоступ, ЦветаПалитры.Зеленый);
	ЦветаСостояний.Вставить(Перечисления.СостоянияИспользованияКассКММ.ОбменСДругойПрограммой, ЦветаПалитры.Зеленый);
	ЦветаСостояний.Вставить(Перечисления.СостоянияИспользованияКассКММ.БезПодключения, ЦветаПалитры.Голубой);
	ЦветаСостояний.Вставить(Перечисления.СостоянияИспользованияКассКММ.ДругоеРабочееМесто, ЦветаПалитры.Голубой);
	ЦветаСостояний.Вставить(Перечисления.СостоянияИспользованияКассКММ.НеНастроенОбмен, ЦветаПалитры.Голубой);
	
	Возврат ЦветаСостояний;
	
КонецФункции

#КонецОбласти
