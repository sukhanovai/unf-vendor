&НаСервере
Процедура ПодключаемоеОборудованиеПриИзмененииНаСервере()

	ТипОборудования = ?(ЗначениеЗаполнено(Объект.ПодключаемоеОборудование),
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПодключаемоеОборудование, "ТипОборудования"),
		Перечисления.ТипыПодключаемогоОборудования.ПустаяСсылка());
	
	ОблачнаяККТ 					 = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ;
	
	Объект.СерийныйНомер 			 = Объект.ПодключаемоеОборудование.СерийныйНомер;
	Объект.ТипОборудования 			 = ТипОборудования;

	Если ЗначениеЗаполнено(Объект.ПодключаемоеОборудование)
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПодключаемоеОборудование, "ТипОборудования") = ОблачнаяККТ Тогда

		Объект.НеПечататьБумажныйЧек = Истина;
		
	КонецЕсли;
	
	УстановитьВидимостьДопСвойств();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДопСвойств()

	Если Не ЗначениеЗаполнено(Объект.ТипКассы)
		Или Объект.ТипКассы = Перечисления.ТипыКассККМ.АвтономнаяККМ
		Или Объект.ТипКассы = Перечисления.ТипыКассККМ.ККМED
		Или Объект.ТипКассы = Перечисления.ТипыКассККМ.ККМOffline
		Или Объект.ТипКассы = Перечисления.ТипыКассККМ.СервисОборудования Тогда

		Элементы.ГруппаНастройкиСБП.Видимость						= Ложь;
			
	Иначе

		ИнтеграцияДоступна = ИнтеграцияСПлатежнымиСистемамиУНФПовтИсп.ИнтеграцияДоступна();
		
		Элементы.ГруппаНастройкиСБП.Видимость					   = ИнтеграцияДоступна;
			
	КонецЕсли;

	УдалитьВыводИнформацииПоОблачнойКассе();
	Элементы.ГруппаШаблоныЧеков.Видимость = Истина;
	
	Если Объект.ТипКассы = Перечисления.ТипыКассККМ.ФискальныйРегистратор Тогда
		
		ТипОборудования = ?(ЗначениеЗаполнено(Объект.ПодключаемоеОборудование),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПодключаемоеОборудование, "ТипОборудования"),
			Перечисления.ТипыПодключаемогоОборудования.ПустаяСсылка());
		
		Элементы.ГруппаАвтоинкассация.Видимость = Истина;
		Элементы.ИспользоватьБезПодключенияОборудования.Видимость = Истина;
		
		Если ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ККТ Тогда
			Элементы.РеквизитыККТ.Видимость = Истина;
			Элементы.ГруппаПечать.Видимость = Истина;
			Элементы.ГруппаОФД.Видимость    = Истина;
			Элементы.ГруппаРасчетВИнтернете.Видимость    = Истина;
		ИначеЕсли ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ПринтерЧеков Тогда
			Элементы.РеквизитыККТ.Видимость = Ложь;
			Элементы.ГруппаПечать.Видимость = Истина;
			Элементы.ГруппаОФД.Видимость    = Ложь;
			Элементы.ГруппаРасчетВИнтернете.Видимость    = Ложь;
		ИначеЕсли ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ Тогда
			
			Элементы.ГруппаНастройкиСБП.Видимость 	= Ложь;
			Элементы.РеквизитыККТ.Видимость 		= Ложь;
			Элементы.ГруппаПечать.Видимость 		= Истина;
			Элементы.ГруппаШаблоныЧеков.Видимость 	= Ложь;
			Элементы.ГруппаОФД.Видимость    		= Ложь;
			Элементы.ГруппаАвтоинкассация.Видимость = Ложь;
			Элементы.ГруппаРасчетВИнтернете.Видимость    = Истина;
			
			Элементы.ИспользоватьБезПодключенияОборудования.Видимость	= Ложь;
			ВыводИнформацииПоОблачнойКассе();
			
		Иначе
			Элементы.РеквизитыККТ.Видимость = Ложь;
			Элементы.ГруппаПечать.Видимость = Ложь;
			Элементы.ГруппаОФД.Видимость    = Ложь;
			Элементы.ГруппаРасчетВИнтернете.Видимость    = Ложь;
		КонецЕсли;
	Иначе
		Элементы.РеквизитыККТ.Видимость = Ложь;
		Элементы.ГруппаПечать.Видимость = Ложь; 
		Элементы.ГруппаОФД.Видимость    = Ложь;
		Элементы.ГруппаРасчетВИнтернете.Видимость    = Ложь;
	КонецЕсли;
	
	Если Объект.ИспользоватьБезПодключенияОборудования Тогда
		Элементы.РеквизитыККТ.Видимость = Ложь;
		Элементы.ГруппаПечать.Видимость = Ложь;
		Элементы.ГруппаОФД.Видимость    = Ложь;
		Элементы.ГруппаРасчетВИнтернете.Видимость    = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьEmail()
	
	Если Объект.ЭлектронныйЧекEmailПередаютсяПрограммой1С Тогда
		Email = "ИзПриложения";
	Иначе
		Email = "ЧерезОФД";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьSMS()
	
	Если Объект.ЭлектронныйЧекSMSПередаютсяПрограммой1С Тогда
		SMS = "ИзПриложения";
	Иначе
		SMS = "ЧерезОФД";
	КонецЕсли
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПересчитатьФормуНаСервере()
	
	ИспользоватьQRКод = Ложь;
	СпособыОплаты	  = Новый СписокЗначений;

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ИнтеграцияСПлатежнымиСистемамиУНФ.ПолучитьНастройкиКассовогоQRКода(Объект.Ссылка, ИспользоватьQRКод, СпособыОплаты);
	КонецЕсли;
	
	ЗаголовокСсылки = НСтр("ru='Подключить кассовый QR-код СБП'");
	Если СпособыОплаты.Количество() Тогда
		ЗаголовокСсылки = СтрШаблон(НСтр("ru='Кассовые QR-коды СБП (%1)'"), СпособыОплаты.Количество())
	КонецЕсли;
	
	СсылкаПодключения = Новый ФорматированнаяСтрока(ЗаголовокСсылки,,,, "ОткрытьФОрмуПодключения");
	
	Элементы.ДекорацияНастроитьКассовыйQRКод.Заголовок = СсылкаПодключения;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьНастройкиСБП(РезультатВопроса, ДополнительныеПараметры) Экспорт

	ПересчитатьФормуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КассыОФДЗагрузкаОтчетовЗавершение(Результат, Параметры) Экспорт
	
	Если НЕ ТипЗнч(Результат) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Неопределено;
	ЕстьНесопоставленныеТовары = Результат.Свойство("НесопоставленныеТоварыОФД") И Результат.НесопоставленныеТоварыОФД.Количество() > 0;
	Если ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("ОписаниеОшибки") Тогда
		
		Если НЕ ЕстьНесопоставленныеТовары Тогда
			ПоказатьПредупреждение(Неопределено, Результат.ОписаниеОшибки, 10);
		Иначе
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ОписаниеОшибки", Результат.ОписаниеОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьНесопоставленныеТовары Тогда
		
		ОповещениеОСопоставлении = Новый ОписаниеОповещения(
			"СопоставлениеТоваровОФДЗавершение",
			ЭтотОбъект,
			ДополнительныеПараметры);
			
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("НесопоставленныеТоварыОФД", Результат.НесопоставленныеТоварыОФД);
		ПараметрыФормы.Вставить("СопоставлениеПослеЗагрузки", Истина);
			
		ОткрытьФорму("РегистрСведений.СопоставлениеНоменклатурыОФД.Форма.ФормаСопоставленияТоваров", ПараметрыФормы,
			ЭтотОбъект, , , , ОповещениеОСопоставлении, РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеТоваровОФДЗавершение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") И
		Результат.Свойство("СопоставлениеВыполнено") И 
		Результат.СопоставлениеВыполнено Тогда
		
		Если Параметры.Свойство("ОписаниеОшибки") Тогда
			ПоказатьПредупреждение(Неопределено, Параметры.ОписаниеОшибки, 10);
		КонецЕсли;
		
		ОповещениеОВыполнении = Новый ОписаниеОповещения(
			"КассыОФДЗагрузкаОтчетовЗавершение",
			ЭтотОбъект);
		МенеджерОфлайнОборудованияКлиент.НачатьЗагрузкуДанныхИзККМ(Объект.ОфлайнОборудование, УникальныйИдентификатор, ОповещениеОВыполнении);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОфлайнОборудованиеПриИзмененииНаСервере()
	
	Если Объект.ОфлайнОборудование.ТипОфлайнОборудования = Перечисления.ТипыОфлайнОборудования.ОФД Тогда
		Элементы.ЗагрузитьДанныеОПродажах.Видимость = Истина;
	Иначе
		Элементы.ЗагрузитьДанныеОПродажах.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьНастройкуПоказыватьИнформациюПоОблачнойКассе()

	ХранилищеСистемныхНастроек.Сохранить(
		"КассыККМ", 
		"КассыККМ_ПоказыватьИнформациюПоОблачнойКассе", 
		Ложь);
	
КонецПроцедуры

&НаСервере
Процедура АдаптацияФормыТакси()
	
	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	Если ЭтоИнтерфейсТакси Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СоздаватьПоступлениеВКассу",
			"ВысотаЗаголовка", 0);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АдаптацияФормыМК()
	
	Если ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		Элементы.Переместить(Элементы.ГруппаДанныеКассы, Элементы.ГруппаОсновныеПараметрыКассы,
			Элементы.ГруппаПодключаемоеОборудование);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ПраваяКолонка", "Объединенная", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыводИнформацииПоОблачнойКассе()
	
	Если НЕ ПоказыватьИнформациюПоОблачнойКассе Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВажногоСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщения.Скрываемый = Истина;
	ПараметрыВажногоСообщения.ТипСообщения = "Информация";
	ПараметрыВажногоСообщения.Идентификатор = "КассыККМ_ПоказыватьИнформациюПоОблачнойКассе";
	ПараметрыВажногоСообщения.Сообщение = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = 'При использовании кассы, подключенной к сервису <a href=""%1"">1С-Облачная касса</a>, доступна автоматическая фискализация чеков по документам, оплаченных с помощью <a href=""%2"">1С:СБП</a>.'"),"ОблачнаяКасса", "СБП");
	ПараметрыВажногоСообщения.КраткоеПредставление = НСтр("ru = 'Доступна автоматическая фискализация чеков'");
	ПараметрыВажногоСообщения.Обработчик = "Подключаемый_ОбработкаНавигационнойСсылкиИнформацияПоОблачнойКассе";
	ПараметрыВажногоСообщения.ОбработчикЗакрытия = "Подключаемый_ИнформацияПоОблачнойКассеЗакрытьНажатие";
	ОбщегоНазначения.ДобавитьВажноеСообщение(ЭтотОбъект, ПараметрыВажногоСообщения);
	
	ОбщегоНазначения.ВывестиСтатусыИВажныеСообщенияНаФорму(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьВыводИнформацииПоОблачнойКассе()
	ОбщегоНазначенияКлиентСервер.УдалитьСтатусИлиВажноеСообщение(ЭтотОбъект, "КассыККМ_ПоказыватьИнформациюПоОблачнойКассе");
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ИнформацияПоОблачнойКассеЗакрытьНажатие(Команда)
	ПоказыватьИнформациюПоОблачнойКассе = Ложь;
	СохранитьНастройкуПоказыватьИнформациюПоОблачнойКассе();
	УдалитьВыводИнформацииПоОблачнойКассе();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработкаНавигационнойСсылкиИнформацияПоОблачнойКассе(Элемент,
	НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ОблачнаяКасса" Тогда
		ПерейтиПоНавигационнойСсылке("https://portal.1c.ru/applications/1C-Cloud-Kassa");
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "СБП" Тогда
		ПерейтиПоНавигационнойСсылке("https://portal.1c.ru/applications/1C-SBP");
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
