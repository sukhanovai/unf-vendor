&НаКлиенте
Функция МенюРазделовТекущаяСтрокаУстановить(ИмяСтраницы, УзелДерева = Неопределено)
	Успех = Ложь;
	АнализируемыйУзел = МенюРазделов;
	Если НЕ УзелДерева = Неопределено Тогда
		АнализируемыйУзел = УзелДерева;
	КонецЕсли;
	СтрокиМенюРазделов = АнализируемыйУзел.ПолучитьЭлементы();
	Для Каждого Раздел Из СтрокиМенюРазделов Цикл
		Если Раздел.ИмяСтраницы = ИмяСтраницы Тогда
			Элементы.МенюРазделов.ТекущаяСтрока = Раздел.ПолучитьИдентификатор();
			Успех = Истина;
			Прервать;
		ИначеЕсли МенюРазделовТекущаяСтрокаУстановить(ИмяСтраницы, Раздел) Тогда
			Успех = Истина;
			ПРервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Успех;
КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьРазделов()
	ПодарокДоступен = Ложь;
	Если Объект.СпособПредоставления = СпособПредоставленияПодарок Тогда
		ПодарокДоступен = Истина;
	КонецЕсли;
	СтрокаРаздела = НайтиСтрокуРазделаПоИмениСтраницы("ГруппаПодарок");
	СтрокаРаздела.СкрытьСтроку = НЕ ПодарокДоступен;
	
	СуммаВДокументе = ((Объект.СпособПредоставления = СпособПредоставленияСумма Или Объект.СпособПредоставления = СпособПредоставленияКоличествоБонусами)
						И Объект.ОбластьПредоставления = ОбластьВДокументе) ИЛИ Объект.СпособПредоставления = СпособПредоставленияВидЦен;
		
	ЭтоСложнаяСкидка = Объект.СпособПредоставления = СпособПредоставленияРасширение 
						ИЛИ Объект.СпособПредоставления = СпособПредоставленияПодарок
						ИЛИ Объект.СпособПредоставления = СпособПредоставленияСообщение
						ИЛИ Объект.СпособПредоставления = СпособПредоставленияПромокод;
	ДоступностьУточнений = Не СуммаВДокументе И Не ЭтоСложнаяСкидка И НЕ ЭтоРучнаяСкидка;
	
	СтрокаРаздела = НайтиСтрокуРазделаПоИмениСтраницы("ГруппаУсловияПредоставления");
	СтрокаРаздела.ДоступностьРаздела = НЕ ЭтоРучнаяСкидка;
	
	СтрокаРаздела = НайтиСтрокуРазделаПоИмениСтраницы("ГруппаКонтрагенты");
	СтрокаРаздела.ДоступностьРаздела = НЕ ЭтоРучнаяСкидка;

	СтрокаРаздела = НайтиСтрокуРазделаПоИмениСтраницы("ГруппаСклады");
	СтрокаРаздела.ДоступностьРаздела = НЕ ЭтоРучнаяСкидка;

	СтрокаРаздела = НайтиСтрокуРазделаПоИмениСтраницы("Уточнения");
	СтрокаРаздела.ДоступностьРаздела = НЕ ЭтоРучнаяСкидка;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиСтрокуРазделаПоИмениСтраницы(ИмяСтраницы, УзелДерева = Неопределено)
	
	АнализируемаяСтрокаДерева = МенюРазделов;
	Если НЕ УзелДерева = Неопределено Тогда
		АнализируемаяСтрокаДерева = УзелДерева;
	КонецЕсли;
	Для Каждого ПодчиненнаяСтрока Из АнализируемаяСтрокаДерева.ПолучитьЭлементы() Цикл
		Результат = Неопределено;
		Если ПодчиненнаяСтрока.ИмяСтраницы = ИмяСтраницы Тогда
			Результат = ПодчиненнаяСтрока;
		Иначе
			Результат = НайтиСтрокуРазделаПоИмениСтраницы(ИмяСтраницы, ПодчиненнаяСтрока);
		КонецЕсли;	
		Если НЕ Результат = Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции


&НаКлиенте
Функция СледующийРаздел(ТекущийРаздел, Вперед = Истина, АнализироватьПодчиненные = Истина)
	
	
	Назад = НЕ Вперед;
	Результат = Неопределено;
	Если ТекущийРаздел = Неопределено Тогда
		Результат = ТекущийРаздел.ПолучитьЭлементы()[0];
	ИначеЕсли АнализироватьПодчиненные И Вперед Тогда
		ПодчиненныеРазделы = ТекущийРаздел.ПолучитьЭлементы();
		Если ПодчиненныеРазделы.Количество() Тогда
			Результат = ПодчиненныеРазделы[0];
		КонецЕсли;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		Родитель = ТекущийРаздел.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			Родитель = МенюРазделов;
		КонецЕсли;
		ОдноуровневыеРазделы = Родитель.ПолучитьЭлементы();
		ИндексТекущего = ОдноуровневыеРазделы.Индекс(ТекущийРаздел);
		ПродолжатьПоиск = Истина;
		Пока ПродолжатьПоиск Цикл
			СледующийРаздел = Неопределено;
			СледующийИндекс = 0;
			Если Вперед Тогда
				СледующийИндекс = ИндексТекущего + 1;
			Иначе
				СледующийИндекс = ИндексТекущего - 1;
			КонецЕсли;
			Если СледующийИндекс < ОдноуровневыеРазделы.Количество()
				И СледующийИндекс >= 0 Тогда 
				СледующийРаздел = ОдноуровневыеРазделы.Получить(СледующийИндекс);
			КонецЕсли;
			Если СледующийРаздел = Неопределено И Назад И НЕ Родитель = МенюРазделов Тогда
				СледующийРаздел = Родитель;
				ПродолжатьПоиск = Ложь;
				Прервать;
			ИначеЕсли СледующийРаздел = Неопределено Тогда
				Прервать;
			ИначеЕсли СледующийРаздел.СкрытьСтроку ИЛИ НЕ СледующийРаздел.ДоступностьРаздела Тогда
				ИндексТекущего = СледующийИндекс;
			Иначе
				Если Назад Тогда
					ПредыдущиеПодчиненные = СледующийРаздел.ПолучитьЭлементы();
					КоличествоПодчиненных = ПредыдущиеПодчиненные.Количество(); 
					ПочиненныйРаздел = Неопределено;
					Для Счетчик = 1 ПО КоличествоПодчиненных  Цикл
						ОбратныйИндекс = КоличествоПодчиненных - Счетчик;
						ПочиненныйРаздел = ПредыдущиеПодчиненные[ОбратныйИндекс];
						Если ПочиненныйРаздел.СкрытьСтроку ИЛИ НЕ ПочиненныйРаздел.ДоступностьРаздела Тогда
							Продолжить;
						КонецЕсли;
						ПродолжатьПоиск = Ложь;
						Прервать;
					КонецЦикла;
					Если НЕ ПродолжатьПоиск Тогда
						СледующийРаздел = ПочиненныйРаздел;
					КонецЕсли;
				КонецЕсли;
				ПродолжатьПоиск = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПродолжатьПоиск И НЕ Родитель = МенюРазделов Тогда 
			Результат = СледующийРаздел(Родитель, Вперед, Ложь);
		ИначеЕсли ПродолжатьПоиск Тогда
			Результат = Неопределено;
		Иначе
			Результат = СледующийРаздел;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции


&НаСервере
Процедура ДобавитьПодсказки()

	ПараметрыВажногоСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщения.ТипСообщения = "Информация";
	ПараметрыВажногоСообщения.КраткоеПредставление = "Подсказка расширения";
	ПараметрыВажногоСообщения.Родитель = "ОсновныеРеквизитыРасширение";
	ПараметрыВажногоСообщения.Скрываемый = Ложь;
	ПараметрыВажногоСообщения.Сообщение = НСтр("ru = 'Данный тип позволяет рассчитать скидки из любых данных вашей базы. 
		|Для этого необходимо создать расширение по шаблону. Если у вас нет опыта работы в конфигураторе, сформулируйте запрос и обратитесь в свою обслуживающую организацию.'");
	ПараметрыДействия = ОбщегоНазначения.ПараметрыДействияВажногоСообщения();
	ПараметрыДействия.Вставить("ИмяКоманды", "ОткрытьИнструкциюРасширение");
	ПараметрыДействия.Вставить("Обработчик", "ОткрытьИнструкциюРасширение");
	ПараметрыДействия.Вставить("Заголовок",  "Инструкция");
	
	ПараметрыВажногоСообщения.ПараметрыДействия = ПараметрыДействия;

	ОбщегоНазначения.ДобавитьВажноеСообщение(ЭтотОбъект, ПараметрыВажногоСообщения);
	
	ПараметрыВажногоСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщения.ТипСообщения = "Информация";
	ПараметрыВажногоСообщения.КраткоеПредставление = "Подсказка условий на строку";
	ПараметрыВажногоСообщения.Родитель = "ГруппаБаннерУсловияНаСтроку";
	ПараметрыВажногоСообщения.Идентификатор = "БаннерУсловияНаСтроку";
	ПараметрыВажногоСообщения.Скрываемый = Ложь;
	ПараметрыВажногоСообщения.ОбработчикЗакрытия = "Подключаемый_БаннерУсловияНаСтрокуОбработкаЗакрытия";
	ПараметрыВажногоСообщения.Сообщение = НСтр("ru = 'Ограничения действия скидки на строку позволяют активировать скидку только для отдельных строк документа'");
	
	ОбщегоНазначения.ДобавитьВажноеСообщение(ЭтотОбъект, ПараметрыВажногоСообщения);

	ПараметрыВажногоСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщения.ТипСообщения = "Информация";
	ПараметрыВажногоСообщения.КраткоеПредставление = "Подсказка условий на документ";
	ПараметрыВажногоСообщения.Родитель = "ГруппаБаннерУсловияНаДокумент";
	ПараметрыВажногоСообщения.Скрываемый = Ложь;
	ПараметрыВажногоСообщения.Сообщение = НСтр("ru = 'Ограничения действия скидки на документ означает, что скидка сработает на весь документ, при его соответствии условиям.'");
	
	ОбщегоНазначения.ДобавитьВажноеСообщение(ЭтотОбъект, ПараметрыВажногоСообщения);
    ОбщегоНазначения.ВывестиСтатусыИВажныеСообщенияНаФорму(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТЧУсловий()
	Объект.УсловияПредоставления.Очистить();
	Для Каждого СтрокаУсловия Из УсловияПредоставленияПоДокументу Цикл
		НовоеУсловие = Объект.УсловияПредоставления.Добавить();
		НовоеУсловие.УсловиеПредоставления = СтрокаУсловия.УсловиеПредоставления;
	КонецЦикла;
	Для Каждого СтрокаУсловия Из УсловияПредоставленияВСтроке Цикл
		НовоеУсловие = Объект.УсловияПредоставления.Добавить();
		НовоеУсловие.УсловиеПредоставления = СтрокаУсловия.УсловиеПредоставления;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьМассовуюРассылкуВыделенныхПромокодов(РассылкаСервиса = Ложь)
	
	ПараметрыРассылки = Новый Структура;
	ПараметрыРассылки.Вставить("СпособОтправки", ПредопределенноеЗначение("Перечисление.ВидыКаналовСвязи.Email"));
	ПараметрыРассылки.Вставить("ПредлагаемаяСкидка", Объект.Ссылка);
	
	ВыделенныеПромокоды = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Промокоды.ПолучитьСтрокиДляОбработки() Цикл
		ТекущаяСтрока = Элементы.Промокоды.ДанныеСтроки(Идентификатор);
		Если Не ТекущаяСтрока.Отправлен Тогда
			ВыделенныеПромокоды.Добавить(ТекущаяСтрока.Промокод);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыРассылки.Вставить("Промокоды", ВыделенныеПромокоды);
	ИмяФормыРассылки = "Документ.МассоваяРассылка.Форма.ФормаДокумента";
	
	Если РассылкаСервиса Тогда 
		ИмяФормыРассылки = "Документ.МассоваяРассылка.Форма.РассылкаСервиса";
	КонецЕсли;
	
	ОткрытьФорму(ИмяФормыРассылки, ПараметрыРассылки);
	 
КонецПроцедуры

// Процедура - обработчик события ПриИзменении элемента УсловияПредоставления формы.
//
&НаКлиенте
Процедура УсловияПредоставленияПриИзменении(Элемент)
	
	Модифицированность = Истина;
	ОбновитьТЧУсловий();
	ОбновитьОбщееКоличествоУсловий();
	ОбновитьАвтонаименование(Истина);
	ОбновитьВидимостьПромокодов();
	ПроверитьНаличиеУсловийНаВидОплаты();
	УстановитьДоступностьКратности();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИнструкциюРасширение(Команда = Неопределено)
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ИдентификаторАвтоматическойСкидки", Объект.ИдентификаторДляРасчетаВРасширении);
		ОткрытьФорму("ОбщаяФорма.ПомощникПодключенияПроцедурыРасширения", ПараметрыОткрытия, , , , , ,
			РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
КонецПроцедуры
#КонецОбласти

