	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(НовоеУсловноеОформление.Отбор, "Промокоды.ДействуетДо", ТекущаяДата, ВидСравненияКомпоновкиДанных.Меньше);
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(НовоеУсловноеОформление.Отбор, "Промокоды.ДействуетДо", ТекущаяДата, ВидСравненияКомпоновкиДанных.Заполнено);
	РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, "ПромокодыДоступно");
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Текст", НСтр("ru = 'Истек'"));
	
КонецПроцедуры

// Заполнить список выбора способ предоставления.
&НаСервере
Процедура ЗаполнитьСписокВыбораСпособПредоставления()
	Элементы.СпособПредоставления.СписокВыбора.Очистить();
	НовыйСписокВыбора = СписокВыбораСпособПредоставления();
	Для Каждого НовоеЗначениеСписка Из НовыйСписокВыбора Цикл
		Элементы.СпособПредоставления.СписокВыбора.Добавить(НовоеЗначениеСписка.Значение, 
			НовоеЗначениеСписка.Представление, 
			НовоеЗначениеСписка.Пометка, 
			НовоеЗначениеСписка.Картинка)
	КонецЦикла;

	Если НовыйСписокВыбора.НайтиПоЗначению(Объект.СпособПредоставления) = Неопределено Тогда
		Если ЗначениеЗаполнено(Объект.БонуснаяПрограмма) 
			И НЕ ЗначениеЗаполнено(Объект.СпособПредоставления) Тогда
			Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.ПроцентОтСуммыВВидеБонусныхБаллов");
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СпособПредоставления) 
			И НЕ ЗначениеЗаполнено(Объект.БонуснаяПрограмма)
			И НовыйСписокВыбора.НайтиПоЗначению(СпособПредоставленияПроцент) <> Неопределено Тогда
			Объект.СпособПредоставления = СпособПредоставленияПроцент;
		Иначе
			Объект.СпособПредоставления = НовыйСписокВыбора[0].Значение;
		КонецЕсли;
		СпособПредоставленияПриИзмененииСервер();
	КонецЕсли;
КонецПроцедуры

// Список выбора способ предоставления.
// 
// Возвращаемое значение:
//  СписокЗначений из ПеречислениеСсылка.СпособыПредоставленияСкидокНаценок, Неопределено - Список выбора способ предоставления
&НаСервере
Функция СписокВыбораСпособПредоставления()
	Результат = Новый СписокЗначений;
	СкидкиНаценкиСерверПереопределяемый.ОбъединенныйСписокСкидокИБонусов(Результат, Объект.ИспользоватьПриВозврате, ЭтоРучнаяСкидка);
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкиИзмененияКоличества()
	
	НастройкиКоличества = ДокументыУНФКлиентСервер.ПараметрыСбросаКоличества();
	ДокументыУНФ.ЗаполнитьНастройкиКоличества(НастройкиКоличества);
	Возврат НастройкиКоличества;
	
КонецФункции

&НаСервереБезКонтекста
Функция УсловияСодержатТребованияПромокода(УсловияПредоставленияНаФорме)
	МассивУсловий = УсловияПредоставленияНаФорме.ВыгрузитьКолонку("УсловиеПредоставления");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УсловияПредоставленияСкидокНаценок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УсловияПредоставленияСкидокНаценок КАК УсловияПредоставленияСкидокНаценок
	|ГДЕ
	|	УсловияПредоставленияСкидокНаценок.Ссылка В(&Условия)
	|	И УсловияПредоставленияСкидокНаценок.УсловиеПредоставления = Значение(Перечисление.УсловияПредоставленияСкидокНаценок.ЗаПромокод)";
	Запрос.УстановитьПараметр("Условия", МассивУсловий);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

