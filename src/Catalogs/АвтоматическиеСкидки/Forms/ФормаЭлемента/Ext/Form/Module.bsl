&НаКлиенте
Процедура УстановитьИдентификаторДляРасчетаВРасширенииКлиент()

	Если Не ЗначениеЗаполнено(Объект.ИдентификаторДляРасчетаВРасширении) Тогда

		АдаптированныйИдентификатор = СтрЗаменить(Новый УникальныйИдентификатор, "-", "_");
		Объект.ИдентификаторДляРасчетаВРасширении = АдаптированныйИдентификатор;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаДанныхИзВнешнегоИсточникаОбработкаРезультата(РезультатЗагрузки, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатЗагрузки) = Тип("Структура") Тогда
		
		Если ДополнительныеПараметры.Свойство("ПолноеИмяОбъектаЗаполнения") Тогда 
			ПолноеИмяОбъектаЗаполнения = ДополнительныеПараметры.ПолноеИмяОбъектаЗаполнения;
		Иначе    
			ПолноеИмяОбъектаЗаполнения = РезультатЗагрузки.НастройкиЗагрузкиДанных.ПолноеИмяОбъектаЗаполнения;
		КонецЕсли;
				
		Если РезультатЗагрузки.ОписаниеДействия = "ИзменитьСпособЗагрузкиДанныхИзВнешнегоИсточника" Тогда
		
			ЗагрузкаДанныхИзВнешнегоИсточника.ИзменитьСпособЗагрузкиДанныхИзВнешнегоИсточника(
				НастройкиЗагрузкиДанных.ИмяФормыЗагрузкиДанныхИзВнешнихИсточников);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузкаДанныхИзВнешнегоИсточникаОбработкаРезультата",
				ЭтотОбъект, НастройкиЗагрузкиДанных);
			ЗагрузкаДанныхИзВнешнегоИсточникаКлиент.ПоказатьФормуЗагрузкиДанныхИзВнешнегоИсточника(
				НастройкиЗагрузкиДанных, ОписаниеОповещения, ЭтотОбъект);
			
		ИначеЕсли РезультатЗагрузки.ОписаниеДействия = "ОбработатьПодготовленныеДанные" Тогда
			
			Если ПолноеИмяОбъектаЗаполнения = "Справочник.АвтоматическиеСкидки.ТабличнаяЧасть.НаборПодарков" Тогда
				
				ДлительнаяОперация = ОбработатьПодготовленныеДанныеНоменклатуры(РезультатЗагрузки);
				
				СтруктураПараметров = Новый Структура;
				Если РезультатЗагрузки.НастройкиЗагрузкиДанных.Свойство("ТекстОшибки") Тогда
					ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатЗагрузки.НастройкиЗагрузкиДанных.ТекстОшибки);
				КонецЕсли;
				
				ПроверитьНеобходимостьПодключенияОбработчикаОжиданияОбработкиНоменклатуры(ДлительнаяОперация, СтруктураПараметров);
			
			ИначеЕсли ПолноеИмяОбъектаЗаполнения = "Справочник.АвтоматическиеСкидки.ТабличнаяЧасть.НоменклатураГруппыЦеновыеГруппы" Тогда
				
				ДлительнаяОперация = ОбработатьПодготовленныеДанныеНоменклатуры(РезультатЗагрузки);
				
				СтруктураПараметров = Новый Структура;
				Если РезультатЗагрузки.НастройкиЗагрузкиДанных.Свойство("ТекстОшибки") Тогда
					ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатЗагрузки.НастройкиЗагрузкиДанных.ТекстОшибки);
				КонецЕсли;
				
				ПроверитьНеобходимостьПодключенияОбработчикаОжиданияОбработкиНоменклатуры(ДлительнаяОперация, СтруктураПараметров);
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНеобходимостьПодключенияОбработчикаОжиданияОбработкиНоменклатуры(ДлительнаяОперация, СтруктураПараметров = Неопределено)
	
	Если ДлительнаяОперация.Статус = "Выполнено" Тогда
		
		ПослеВыполненияФоновогоЗаданияОбработкиНоменклатуры(ДлительнаяОперация, СтруктураПараметров);
		
	Иначе
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеВыполненияФоновогоЗаданияОбработкиНоменклатуры", ЭтотОбъект);
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Идет загрузка данных.'");
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
		ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
		ПараметрыОжидания.ВыводитьСообщения = Истина;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполненияФоновогоЗаданияОбработкиНоменклатуры(Прогресс, ДополнительныеПараметры) Экспорт
	
	Если НЕ Прогресс = Неопределено Тогда
		ОбработатьПодготовленныеДанныеОтборПродажПоНоменклатуре(Прогресс.АдресРезультата);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПодготовленныеДанныеОтборПродажПоНоменклатуре(АдресРезультатаЗагрузки)
	
	НачатьТранзакцию();
	
	Попытка
		
		РезультатЗагрузки = ПолучитьИзВременногоХранилища(АдресРезультатаЗагрузки);
		ТаблицаСопоставленияДанных = РезультатЗагрузки.ТаблицаСопоставленияДанных;
		Если РезультатЗагрузки.НастройкиЗагрузкиДанных.ПолноеИмяОбъектаЗаполнения =
			"Справочник.АвтоматическиеСкидки.ТабличнаяЧасть.НаборПодарков" Тогда
			Для каждого СтрокаТаблицы Из ТаблицаСопоставленияДанных Цикл
				ЗагрузкаВПриложениеВозможна = СтрокаТаблицы[ЗагрузкаДанныхИзВнешнегоИсточника.ИмяСлужебногоПоляЗагрузкаВПриложениеВозможна()];
				Если ЗагрузкаВПриложениеВозможна Тогда
					НоваяСтрока = Объект.НаборПодарков.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли РезультатЗагрузки.НастройкиЗагрузкиДанных.ПолноеИмяОбъектаЗаполнения =
			"Справочник.АвтоматическиеСкидки.ТабличнаяЧасть.НоменклатураГруппыЦеновыеГруппы" Тогда
			Для каждого СтрокаТаблицы Из ТаблицаСопоставленияДанных Цикл
				ЗагрузкаВПриложениеВозможна = СтрокаТаблицы[ЗагрузкаДанныхИзВнешнегоИсточника.ИмяСлужебногоПоляЗагрузкаВПриложениеВозможна()];
				Если ЗагрузкаВПриложениеВозможна Тогда
					НоваяСтрока = Объект.НоменклатураГруппыЦеновыеГруппы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
					НоваяСтрока.ЗначениеУточнения = СтрокаТаблицы.Номенклатура;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ЗаписатьОшибкуВЖурналРегистрации(ИнформацияОбОшибке, НСтр("ru = 'Отбор продаж по номенклатуре'"));
		
	КонецПопытки;
	
	НоменклатураВДокументахСервер.ЗаполнитьПризнакиИспользованияХарактеристик(Объект);
	
КонецПроцедуры

&НаСервере
Функция ОбработатьПодготовленныеДанныеНоменклатуры(РезультатЗагрузки)
	
	ПараметрыВызоваСервера = Новый Структура;
	ПараметрыВызоваСервера.Вставить("НастройкиЗагрузкиДанных", РезультатЗагрузки.НастройкиЗагрузкиДанных);
	ПараметрыВызоваСервера.Вставить("ТаблицаСопоставленияДанных", ДанныеФормыВЗначение(РезультатЗагрузки.ТаблицаСопоставленияДанных, Тип("ТаблицаЗначений")));
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Подсистема ЗагрузкаДанныхИзВнешнегоИсточника: Выполнение серверного метода загрузки результата'");
	ПараметрыВыполнения.ЗапуститьНеВФоне    = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне      = Истина;	
	
	ИмяМетода = "Справочники.Номенклатура.ОбработатьПодготовленныеДанные";
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(ИмяМетода, ПараметрыВызоваСервера, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Процедура ЗаписатьОшибкуВЖурналРегистрации(ИнформацияОбОшибке, КонтекстОшибки)

	ИмяСобытия = НСтр("ru='Загрузка данных'", ОбщегоНазначения.КодОсновногоЯзыка());

	ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	Комментарий = СтрШаблон("%1%2%3", КонтекстОшибки, Символы.ПС, ПодробноеПредставлениеОшибки);

	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ВводНачальныхОстатков,
		, Комментарий);

КонецПроцедуры

&НаСервере
Процедура УстановитьИдентификаторДляРасчетаВРасширении()

	Если Не ЗначениеЗаполнено(Объект.ИдентификаторДляРасчетаВРасширении) Тогда

		АдаптированныйИдентификатор = СтрЗаменить(Новый УникальныйИдентификатор, "-", "_");
		Объект.ИдентификаторДляРасчетаВРасширении = АдаптированныйИдентификатор;

	КонецЕсли;

КонецПроцедуры

#Область ПроцедурыИФункцииОбщегоНазначения

&НаКлиенте
Процедура ВариантПредоставленияСкидкиПоПолучателямПриИзмененииЗавершение(РезультатОтвета, ДополнительныеПараметры) Экспорт

	Если РезультатОтвета <> КодВозвратаДиалога.Да Тогда
		Объект.ВариантОграниченияПоПолучателям = ВариантОграниченияПоКонтрагентамДоИзменения;
		Возврат;
	КонецЕсли;
	
	ВариантОграниченияПоКонтрагентамДоИзменения = Объект.ВариантОграниченияПоПолучателям;
	
	УправлениеВидимостьюНаСервере();
	
	Если ВариантОграниченияПоКонтрагентамДоИзменения = ВариантОграниченияПоКонтрагентам Тогда
		Объект.ПолучателиСкидкиСегменты.Очистить();
	Иначе
		Объект.ПолучателиСкидкиКонтрагенты.Очистить();
	КонецЕсли;
		
КонецПроцедуры

// Процедура обновляет наименование, если пользователь не менял его вручную.
//
&НаКлиенте
Процедура ОбновитьАвтонаименование(Обновить = Истина, УстановитьМодифицированность = Ложь)
	
	НаименованиеПоШаблону = СформироватьАвтоНаименованиеНаКлиенте();
	Если Не ЗначениеЗаполнено(Объект.Наименование) ИЛИ (Обновить И ИспользуетсяАвтоНаименование И Не НаименованиеИзмененоПользователем) Тогда
		Объект.Наименование = НаименованиеПоШаблону;
		ИспользуетсяАвтоНаименование = Истина;
		
		Если УстановитьМодифицированность Тогда
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция возвращает сформированное автонаименование.
//
&НаКлиенте
Функция СформироватьАвтоНаименованиеНаКлиенте()
	
	Элементы.Наименование.СписокВыбора.Очистить();
	
	СтрокаНаименования = "";
	
	ОбновитьПредставлениеОбластьДействия(Ложь);
	ОбновитьПредставлениеПреимущества();
	ОбновитьПредставлениеУсловий();
	
	Элементы.Наименование.СписокВыбора.Добавить(ПредставлениеПреимущества());
	Элементы.Наименование.СписокВыбора.Добавить(СтрШаблон("%1: %2", ПредставлениеПреимущества(), НРег(ПредставлениеОбластиДействия(Ложь))));
	Элементы.Наименование.СписокВыбора.Добавить(СтрШаблон("%1 %2", ПредставлениеПреимущества(), НРег(ПредставлениеУсловий())));
	СтрокаНаименования = СтрШаблон("%1: %2",ПредставлениеПреимущества(), НРег(ПредставлениеОбластиДействия(Истина)));
	Элементы.Наименование.СписокВыбора.Добавить(СтрокаНаименования);
	Возврат СтрокаНаименования;
                                           
КонецФункции

&НаКлиенте
Процедура ОбновитьПредставлениеОбластьДействия(ВключатьУсловия = Истина)
	ПредставлениеДействия = ПредставлениеОбластиДействия(ВключатьУсловия);
КонецПроцедуры
&НаКлиенте
Функция ПредставлениеОбластиДействия(ВключатьУсловия = Истина)
	
	//ПредставлениеДействия = "";
	Описание = "";
	ДействиеНеОграничено = Ложь;
	Если Недействителен Тогда
        Описание = НСтр("ru = 'Не действует'");
		ДействиеНеОграничено = Истина;
		Возврат Описание;
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаНачала) ИЛИ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Описание = ПредставлениеПериода(Объект.ДатаНачала, Объект.ДатаОкончания);
	Иначе
		Описание = НСтр("ru = 'Постоянно'");
	КонецЕсли;
	Если Объект.Назначение = НазначениеОпт Тогда
		КаналПродаж = НСтр("ru = 'в опте'");
		Описание = СтрШаблон("%1, %2", Описание, КаналПродаж);
	ИначеЕсли Объект.Назначение = НазначениеРозница Тогда
		КаналПродаж = НСтр("ru = 'в рознице'");
		Описание = СтрШаблон("%1, %2", Описание, КаналПродаж);
	КонецЕсли;
	Если Объект.ВремяПоДнямНедели.Количество() > 0 Тогда
		Расписание = НСтр("ru = 'по расписанию'");
		Описание = СтрШаблон("%1, %2", Описание, Расписание);
	КонецЕсли;
	КоличествоСкладов = Объект.ПолучателиСкидкиСклады.Количество();
	Если КоличествоСкладов > 0 Тогда
		Фильтр = СтрШаблон(НСтр("ru = 'в определенных точках продаж (%1)'"), КоличествоСкладов);
		Описание = СтрШаблон("%1, %2", Описание, Фильтр);
	КонецЕсли;
	КоличествоПокупателей = 0;
	Если Объект.ВариантОграниченияПоПолучателям = ПредопределенноеЗначение("Перечисление.ВариантыОграниченийСкидокПоКонтрагентам.ПоКонтрагентам") Тогда
		КоличествоПокупателей = Объект.ПолучателиСкидкиКонтрагенты.Количество();
		Если КоличествоПокупателей > 0 Тогда
			Фильтр = СтрШаблон(НСтр("ru = 'определенным покупателям (%1)'"), КоличествоСкладов);
			Описание = СтрШаблон("%1, %2", Описание, Фильтр);
		КонецЕсли;
	Иначе
		КоличествоПокупателей = Объект.ПолучателиСкидкиСегменты.Количество();
		Если КоличествоПокупателей > 0 Тогда
			Фильтр = СтрШаблон(НСтр("ru = 'определенным сегментам покупателей (%1)'"), КоличествоСкладов);
			Описание = СтрШаблон("%1, %2", Описание, Фильтр);
		КонецЕсли;
	КонецЕсли;

	Если ВключатьУсловия Тогда
		Фильтр = ПредставлениеУсловий();
		Если ДействиеНеОграничено Тогда
			Описание = СтрШаблон("%1", Фильтр);
		Иначе
			Описание = СтрШаблон("%1; %2", Описание, Фильтр);
		КонецЕсли;
	КонецЕсли;
	Возврат Описание;
	
КонецФункции

&НаКлиенте
Функция ПредставлениеПреимущества()
	СтрокаНаименования = "";
	Если Объект.СпособПредоставления = СпособПредоставленияПроцент Тогда
		
		СтрокаНаименования = "" + Объект.ЗначениеСкидкиНаценки + НСтр("ru = '%'");
		
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияСумма Тогда
		
		СтрокаНаименования = "" + Объект.ЗначениеСкидкиНаценки + " " + Объект.ВалютаПредоставления;
		
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияВидЦен Тогда
		
		СтрокаНаименования = "Вид цен - " + Объект.ВидЦен;
		
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияПроцентБонусами Тогда
		
		СтрокаНаименования = "" + Объект.ЗначениеСкидкиНаценки + НСтр("ru = '% баллами'");
		Если ЗначениеЗаполнено(Объект.БонуснаяПрограмма) Тогда
			СтрокаНаименования = СтрокаНаименования + " """ + Объект.БонуснаяПрограмма + """";
		КонецЕсли;
		
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияКоличествоБонусами Тогда
		
		СтрокаНаименования = "" + Объект.ЗначениеСкидкиНаценки + " " + НСтр("ru = 'баллов'");
		Если ЗначениеЗаполнено(Объект.БонуснаяПрограмма) Тогда
			СтрокаНаименования = СтрокаНаименования + " """ + Объект.БонуснаяПрограмма + """";
		КонецЕсли;
		
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияОкругление Тогда
		
		//@skip-check bsl-nstr-string-literal-format
		СтрокаНаименования = НСтр("ru = 'Округление до '") + Объект.ПорядокОкругления;
		Если Объект.ОбластьПредоставления = ПредопределенноеЗначение("Перечисление.ВариантыОбластейОграниченияСкидокНаценок.ВДокументе") Тогда
			СтрокаНаименования = СтрокаНаименования + НСтр("ru = ' в документе'");
		ИначеЕсли Объект.ОбластьПредоставления = ПредопределенноеЗначение("Перечисление.ВариантыОбластейОграниченияСкидокНаценок.ВСтроке") Тогда
			СтрокаНаименования = СтрокаНаименования + НСтр("ru = ' в строке'");
		КонецЕсли;
		
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияСообщение Тогда
		
		СтрокаНаименования = НСтр("ru = 'Сообщение кассиру'");
		
		Если Объект.МоментВыдачиСообщения = ПредопределенноеЗначение("Перечисление.ТочкиВыдачиСообщенияКассиру.ВМоментРасчетаСкидок") Тогда
			СтрокаНаименования = СтрокаНаименования + НСтр("ru = ' при расчете'");
		ИначеЕсли Объект.МоментВыдачиСообщения = ПредопределенноеЗначение("Перечисление.ТочкиВыдачиСообщенияКассиру.ПослеОформленияЧека") Тогда
			СтрокаНаименования = СтрокаНаименования + НСтр("ru = ' при оформлении'");
		КонецЕсли;
		
		Если Объект.ОбластьПредоставления = ПредопределенноеЗначение("Перечисление.ВариантыОбластейОграниченияСкидокНаценок.ВДокументе") Тогда
			СтрокаНаименования = СтрокаНаименования + НСтр("ru = ' в документе'");
		ИначеЕсли Объект.ОбластьПредоставления = ПредопределенноеЗначение("Перечисление.ВариантыОбластейОграниченияСкидокНаценок.ВСтроке") Тогда
			СтрокаНаименования = СтрокаНаименования + НСтр("ru = ' в строке'");
		КонецЕсли;

	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияПодарок Тогда
		
		СтрокаНаименования = НСтр("ru = 'Подарок'");
		
		Если Объект.ПодарокИзКорзиныПокупателя Тогда
			СтрокаНаименования = СтрокаНаименования + НСтр("ru = ' из корзины покупателя'");
		Иначе
			СтрокаНаименования = СтрокаНаименования + НСтр("ru = ' на кассе'");
		КонецЕсли; 
		
		Если Объект.ЛюбойПодарокИзСписка Тогда
			СтрокаНаименования = СтрокаНаименования + НСтр("ru = ' на выбор'");
		КонецЕсли;
				
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияПромокод Тогда

		СтрокаНаименования = НСтр("ru = 'Промокод на следующую покупку'");
		
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияРасширение Тогда

		СтрокаНаименования = НСтр("ru = 'Произвольная скидка'");
		
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияРасширение Тогда

		СтрокаНаименования = НСтр("ru = 'Сумма или процент скидки указывается вручную при продаже'");
		
	КонецЕсли;
	
	СуммаВДокументе = (Объект.СпособПредоставления = СпособПредоставленияСумма И Объект.ОбластьПредоставления = ОбластьВДокументе);
	Если Объект.НоменклатураГруппыЦеновыеГруппы.Количество() > 0 И НЕ СуммаВДокументе Тогда
		СтрокаНаименования = СтрокаНаименования + НСтр("ru = ', с уточнением'");
	КонецЕсли;
	
	Возврат СтрокаНаименования;

КонецФункции


&НаКлиенте
Процедура ОбновитьПредставлениеПреимущества()

	ПредставлениеПреимущества = ПредставлениеПреимущества();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредставлениеУсловий()
	ПредставлениеУсловий = ПредставлениеУсловий();
КонецПроцедуры

&НаКлиенте
Функция ПредставлениеУсловий()
	СтрокаНаименования = "";
	КоличествоУсловий = Объект.УсловияПредоставления.Количество();
	Если КоличествоУсловий = 0 Тогда
		Если Объект.ИспользоватьПриВозврате Тогда
			СтрокаНаименования = НСтр("ru = 'При любом возврате'");
		Иначе
			СтрокаНаименования = НСтр("ru = 'При любой продаже'");
		КонецЕсли;
	ИначеЕсли КоличествоУсловий = 1 Тогда
		Если Объект.ИспользоватьПриВозврате Тогда
			СтрокаНаименования = СтрШаблон(НСтр("ru = 'При возврате (%1)'"), Объект.УсловияПредоставления[0].УсловиеПредоставления);
		Иначе
			СтрокаНаименования = СтрШаблон(НСтр("ru = 'При продаже (%1)'"), Объект.УсловияПредоставления[0].УсловиеПредоставления);
		КонецЕсли;
	ИначеЕсли КоличествоУсловий > 1 Тогда
		Если Объект.ИспользоватьПриВозврате Тогда
			СтрокаНаименования = СтрШаблон(НСтр("ru = 'При возврате (условия: %1)'"), КоличествоУсловий);
		Иначе
			СтрокаНаименования = СтрШаблон(НСтр("ru = 'При продаже (условия: %1)'"), КоличествоУсловий);
		КонецЕсли;
	КонецЕсли;

	Возврат СтрокаНаименования;
КонецФункции

// Функция возвращает вариант совместного применения автоматических скидок актуальный для текущей скидки.
//
&НаСервереБезКонтекста
Функция ПолучитьТекущийВариантСовместногоПрименения(Родитель)

	Если Родитель.Пустая() Тогда
		Возврат Константы.ВариантыСовместногоПримененияСкидокНаценок.Получить();
	Иначе
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Родитель, "ВариантСовместногоПрименения");
	КонецЕсли;

КонецФункции // ПолучитьТекущийВариантСовместногоПриме()

&НаСервере
Процедура ОбновитьПризнакиЭтоГруппа()
	
	Если Объект.ВариантОграниченияПоНоменклатуре <> ПредопределенноеЗначение("Перечисление.ВариантыОграниченийСкидокПоНоменклатуре.ПоНоменклатуре") Тогда
		Возврат;
	КонецЕсли;
	
	МассивНоменклатуры = Объект.НоменклатураГруппыЦеновыеГруппы.Выгрузить(, "ЗначениеУточнения").ВыгрузитьКолонку("ЗначениеУточнения");
	Если МассивНоменклатуры.Количество()>0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&МассивНоменклатуры)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		ПараметрыНоменклатуры = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			ПараметрыНоменклатуры.Вставить(Выборка.Ссылка, Выборка.ЭтоГруппа);
		КонецЦикла; 
		
		Для каждого Стр Из Объект.НоменклатураГруппыЦеновыеГруппы Цикл
			Если НЕ ЗначениеЗаполнено(Стр.ЗначениеУточнения) ИЛИ ТипЗнч(Стр.ЗначениеУточнения) <> Тип("СправочникСсылка.Номенклатура") Тогда
				Стр.ЭтоГруппа = Ложь;
			Иначе
				Стр.ЭтоГруппа = ПараметрыНоменклатуры.Получить(Стр.ЗначениеУточнения);
			КонецЕсли;
		КонецЦикла; 
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииДляУправленияВнешнимВидомФормы

// Процедура управляет видимостью элементов в зависимости о варианта ограничения,
// способа и области предоставления скидки.
&НаСервере
Процедура УправлениеВидимостьюНаСервере()

	Если Объект.СпособПредоставления = СпособПредоставленияОкругление Тогда
		Элементы.ОсновныеРеквизитыСкидка.Видимость = Истина;
		Элементы.ГруппаСкидки.Видимость = Ложь;
		Элементы.ВидЦен.Видимость = Ложь;
		ТекстПодсказки = НСтр("ru = 'Округление корректирует размер автоматической скидки так, чтобы ""Всего"" документа/строки было округлено до заданного порядка, с учетом всех скидок и НДС строки/документа.'");		
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияВидЦен Тогда
		Элементы.ОсновныеРеквизитыСкидка.Видимость = Истина;
		Элементы.ГруппаСкидки.Видимость = Ложь;
		Элементы.ВидЦен.Видимость = Истина;
		ТекстПодсказки = НСтр("ru = 'Автоматическая скидка установит выбранный вид цен. Скидка составит разницу к текущей цене.'");
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияСообщение Тогда
		Элементы.ОсновныеРеквизитыСкидка.Видимость = Истина;
		Элементы.ГруппаСкидки.Видимость = Ложь;
		Элементы.ВидЦен.Видимость = Ложь;
		ТекстПодсказки = НСтр("ru = 'Кассиру будет выведено сообщение.'");
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияПодарок Тогда
		Элементы.ОсновныеРеквизитыСкидка.Видимость = Объект.УчитыватьПодарокКакПродажу;
		Элементы.ГруппаСкидки.Видимость = Ложь;
		Элементы.ВидЦен.Видимость = Ложь;
		ТекстПодсказки = НСтр("ru = 'Покупателю будет предоставлен подарок.'");
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияПромокод Тогда
		Элементы.ОсновныеРеквизитыСкидка.Видимость = Ложь;
		Элементы.ГруппаСкидки.Видимость = Ложь;
		Элементы.ВидЦен.Видимость = Ложь;
		Элементы.ОсновныеРеквизитыРасширение.Видимость = Ложь;
		ТекстПодсказки = НСтр("ru = 'Покупателю будет предоставлен промокод на следующую покупку.'");
	ИначеЕсли Объект.СпособПредоставления = СпособПредоставленияРасширение Тогда
		Элементы.ОсновныеРеквизитыСкидка.Видимость = Ложь;
		Элементы.ГруппаСкидки.Видимость = Ложь;
		Элементы.ВидЦен.Видимость = Ложь;
		ТекстПодсказки = НСтр("ru = 'Логика скидки будет определяться загруженным расширением.'");
	ИначеЕсли ЭтоРучнаяСкидка Тогда
		Элементы.ОсновныеРеквизитыСкидка.Видимость = Ложь;
		Элементы.ГруппаСкидки.Видимость = Ложь;
		Элементы.ВидЦен.Видимость = Ложь;
		ТекстПодсказки = НСтр("ru = 'Сумма ручной скидки вводится пользователем непосредственно в документе продажи.'");	
	Иначе	
		Элементы.ОсновныеРеквизитыСкидка.Видимость = Истина;
		Элементы.ГруппаСкидки.Видимость = Истина;
		Элементы.ВидЦен.Видимость = Ложь;
		ТекстПодсказки = "";
	КонецЕсли;
	Элементы.СпособПредоставления.Подсказка = ТекстПодсказки;
	
	ВидимостьСообщений = Объект.СпособПредоставления = СпособПредоставленияСообщение;
	Элементы.ОсновныеРеквизитыСообщение.Видимость = ВидимостьСообщений;
	Элементы.ТекстСообщения.Видимость = ВидимостьСообщений;
	
	
	ВидимостьПодарков = Объект.СпособПредоставления = СпособПредоставленияПодарок;
	Элементы.ОсновныеРеквизитыПодаркиСокращенный.Видимость = ВидимостьПодарков;
	Элементы.УчитыватьПодарокКакПродажу.Видимость = ВидимостьПодарков;
		
	ПоддержкаКратностиСкидки = СпособПоддерживаетКратность(Объект.СпособПредоставления);
	Элементы.ГруппаКратность.Видимость = ПоддержкаКратностиСкидки;

	ВидимостьПромокодов = Объект.СпособПредоставления = СпособПредоставленияПромокод;
	Элементы.ОсновныеРеквизитыПромокод.Видимость = ВидимостьПромокодов;
	
	ВидимостьРасширения = Объект.СпособПредоставления = СпособПредоставленияРасширение;
	Элементы.ОсновныеРеквизитыРасширение.Видимость = ВидимостьРасширения;
	
	ВидимостьОкруглений = Объект.СпособПредоставления = СпособПредоставленияОкругление;
	
	Элементы.ОсновныеРеквизитыОкругление.Видимость = ВидимостьОкруглений;
	Элементы.ЭтоОкруглениеБонусов.Видимость = ВидимостьОкруглений;
	
	ВидимостьБонусов = Объект.ЭтоПравилоНачисленияБонусов;
	Элементы.БонуснаяПрограмма.Видимость = ВидимостьБонусов;
	Элементы.ЗначениеСкидкиНаценки.Заголовок = ?(ВидимостьБонусов, НСтр("ru = 'Начисление'"), НСтр("ru = 'Скидка'"));
	Элементы.ГруппаСовместноеПрименение.Видимость = Не ВидимостьБонусов;
	Элементы.УменьшатьНаСуммуОплатыБаллами.Видимость = Объект.СпособПредоставления = СпособПредоставленияПроцент
		ИЛИ Объект.СпособПредоставления = СпособПредоставленияПроцентБонусами;
	
	Элементы.ОбластьПредоставления.Видимость = НЕ ВидимостьОкруглений 
		И НЕ ВидимостьСообщений 
		И Не ВидимостьБонусов 
		И НЕ ВидимостьПромокодов
		И НЕ ЭтоРучнаяСкидка;
	
	Если Объект.ВариантОграниченияПоНоменклатуре.Пустая() Тогда
		Объект.ВариантОграниченияПоНоменклатуре = ВариантОграниченияПоНоменклатуре;
	КонецЕсли;
	
	ВидимостьПодбораНоменклатурыУточнение = Ложь;
	Если Объект.ВариантОграниченияПоНоменклатуре = ВариантОграниченияПоНоменклатуре Тогда
		Элементы.НоменклатураГруппыЦеновыеГруппыЗначениеУточнения.Заголовок = НСтр("ru = 'Номенклатура'");
		Элементы.НоменклатураГруппыЦеновыеГруппыЗначениеУточнения.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
		
		Элементы.ДекорацияПодсказкаУточнения.Заголовок = НСтр("ru = 'Заполните уточнения, если требуется, чтобы у определенных товаров или групп товаров значение скидки отличалось от основного значения. Если список не заполнен, то для всех позиций номенклатуры используется основное значение скидки.'");
		
		Элементы.НоменклатураГруппыЦеновыеГруппыХарактеристика.Видимость = Истина;
		Элементы.НоменклатураГруппыЦеновыеГруппыДобавитьГруппу.Видимость = Истина;
		ВидимостьПодбораНоменклатурыУточнение = Истина;		
	ИначеЕсли Объект.ВариантОграниченияПоНоменклатуре = ВариантОграниченияПоКатегориям Тогда
		Элементы.НоменклатураГруппыЦеновыеГруппыЗначениеУточнения.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.КатегорииНоменклатуры");
		Элементы.НоменклатураГруппыЦеновыеГруппыЗначениеУточнения.Заголовок = НСтр("ru = 'Категория номенклатуры'");
		
		Элементы.ДекорацияПодсказкаУточнения.Заголовок = НСтр(
			"ru = 'Заполните уточнения, если требуется, чтобы у товаров определенных категорий значение скидки отличалось от основного значения. Если список не заполнен, то для всех категорий используется основное значение скидки.'");
		
		Элементы.НоменклатураГруппыЦеновыеГруппыХарактеристика.Видимость = Ложь;
		Элементы.НоменклатураГруппыЦеновыеГруппыДобавитьГруппу.Видимость = Истина;
	ИначеЕсли Объект.ВариантОграниченияПоНоменклатуре = ВариантОграниченияПоЦеновымГруппам Тогда
		Элементы.НоменклатураГруппыЦеновыеГруппыЗначениеУточнения.Заголовок = НСтр("ru = 'Ценовая группа'");
		Элементы.НоменклатураГруппыЦеновыеГруппыЗначениеУточнения.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ЦеновыеГруппы");
		
		Элементы.ДекорацияПодсказкаУточнения.Заголовок = НСтр("ru = 'Заполните уточнения, если требуется, чтобы у товаров определенных ценовых групп значение скидки отличалось от основного значения. Если список не заполнен, то для всех ценовых групп используется основное значение скидки.'");
		
		Элементы.НоменклатураГруппыЦеновыеГруппыХарактеристика.Видимость = Ложь;
		Элементы.НоменклатураГруппыЦеновыеГруппыДобавитьГруппу.Видимость = Ложь;
	ИначеЕсли Объект.ВариантОграниченияПоНоменклатуре = ВариантОграниченияПоСегментамНоменклатуры Тогда
		Элементы.НоменклатураГруппыЦеновыеГруппыЗначениеУточнения.Заголовок = НСтр("ru = 'Сегмент номенклатуры'");
		Элементы.НоменклатураГруппыЦеновыеГруппыЗначениеУточнения.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.СегментыНоменклатуры");	
		Элементы.ДекорацияПодсказкаУточнения.Заголовок =  НСтр("ru = 'Заполните уточнения, если требуется, чтобы у товаров определенных сегментов значение скидки отличалось от основного значения. Если список не заполнен, то для всех сегментов используется основное значение скидки.'");
		Элементы.НоменклатураГруппыЦеновыеГруппыХарактеристика.Видимость = Ложь;
		Элементы.НоменклатураГруппыЦеновыеГруппыДобавитьГруппу.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ВалютаПредоставления.Видимость = (Объект.СпособПредоставления = СпособПредоставленияСумма);
	Элементы.НоменклатураГруппыЦеновыеГруппыПодборУточнений.Видимость = ВидимостьПодбораНоменклатурыУточнение;
	
	Если Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.Округление") Тогда
		ЭтоСкидка = Ложь;
	ИначеЕсли ЭтоРучнаяСкидка Тогда
		ЭтоСкидка = Ложь;
	Иначе
		ЭтоСкидка = Истина;
	КонецЕсли;
	
	Элементы.ГруппаВремяПоДнямНедели.Доступность = НЕ ЭтоРучнаяСкидка;
	Элементы.ГруппаПериодДействия.Доступность = НЕ ЭтоРучнаяСкидка;
	Элементы.ГруппаСовместноеПрименение.Видимость = ЭтоСкидка;	
	Элементы.ИдентификаторДляРасчетаВРасширении.Видимость = Объект.СпособПредоставления = СпособПредоставленияРасширение;
	
	Если Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.Процент")
		ИЛИ Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.ПроцентОтСуммыВВидеБонусныхБаллов") Тогда
		Элементы.ЗначениеСкидкиНаценки.ФорматРедактирования = "ЧФ = 'Ч %'";
	ИначеЕсли Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.КоличествоБонусныхБаллов") Тогда
		Элементы.ЗначениеСкидкиНаценки.ФорматРедактирования = СтрШаблон("ЧФ = 'Ч %1'", НСтр("ru = 'баллы'"));
	ИначеЕсли Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.Сумма") Тогда
		ВалютыДоступны = ПолучитьФункциональнуюОпцию("УчетВалютныхОпераций");
		Если ВалютыДоступны Тогда
			Элементы.ЗначениеСкидкиНаценки.ФорматРедактирования = "";
		Иначе
			Элементы.ЗначениеСкидкиНаценки.ФорматРедактирования = СтрШаблон("ЧФ = 'Ч %1'", Объект.ВалютаПредоставления);
		КонецЕсли;
	Иначе
		Элементы.ЗначениеСкидкиНаценки.ФорматРедактирования = "";
	КонецЕсли;
	Если Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.Подарок") 
		И Объект.ПодарокИзКорзиныПокупателя Тогда
		// Устаревший способ настройки подарка из корзины
		Элементы.ОсновныеРеквизитыПодаркиУстарело.Видимость = Истина;
		Элементы.ОсновныеРеквизитыПодаркиСокращенный.Видимость = Ложь;
	Иначе
		Элементы.ОсновныеРеквизитыПодаркиУстарело.Видимость = Ложь;
	КонецЕсли;
	
	Если Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.Сумма")
		ИЛИ Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.КоличествоБонусныхБаллов") Тогда
		Элементы.ЗначениеСкидкиНаценки.Заголовок = "Сумма";
	Иначе
		Элементы.ЗначениеСкидкиНаценки.Заголовок = "Процент";
	КонецЕсли;
	
	Если Объект.ВариантОграниченияПоПолучателям = ВариантОграниченияПоКонтрагентам
		ИЛИ НЕ ЗначениеЗаполнено(Объект.ВариантОграниченияПоПолучателям) Тогда
		Элементы.СтраницыПолучателиСкидкиСегментыКонтрагенты.ТекущаяСтраница = 
			Элементы.ГруппаПолучателиКонтрагенты;
	ИначеЕсли Объект.ВариантОграниченияПоПолучателям = ВариантОграниченияПоСегментамКонтрагентов Тогда
		Элементы.СтраницыПолучателиСкидкиСегментыКонтрагенты.ТекущаяСтраница = 
			Элементы.ГруппаПолучателиСегменты;
	КонецЕсли;
	
	Если НЕ ИспользуютсяСегментыНоменклатуры Тогда
		СписокВыбораОграниченийПоНоменклатуре = Элементы.ВариантОграниченияПоНоменклатуре.СписокВыбора;
		ВариантПереключателя = 
			СписокВыбораОграниченийПоНоменклатуре.НайтиПоЗначению(ВариантОграниченияПоСегментамНоменклатуры);
		Если ВариантПереключателя <> Неопределено Тогда
			СписокВыбораОграниченийПоНоменклатуре.Удалить(ВариантПереключателя);
		КонецЕсли;
	КонецЕсли;
	ОбновитьВидимостьПромокодов();
	УстановитьДоступностьНазначения();

	ТолькоПродажа = СкидкаДоступнаТолькоПриПродаже(Объект.Назначение, Объект.СпособПредоставления)
		ИЛИ ЭтоРучнаяСкидка;
	Элементы.ИспользоватьПриПродаже.Доступность = НЕ ТолькоПродажа;
	Если ТолькоПродажа И Объект.ИспользоватьПриВозврате Тогда
		Объект.ИспользоватьПриВозврате = Ложь;
		ИспользоватьПриПродаже = НЕ Объект.ИспользоватьПриВозврате;
		ИспользоватьПриПродажеПриИзмененииНаСервере();
	КонецЕсли; 
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция СкидкаДоступнаТолькоПриПродаже(Назначение, СпособПредоставления)
	СпособыТолькоПриПродаже = СкидкиНаценкиСерверПереопределяемый.ПолучитьСписокЗначенийСпособовПредоставленияСкидкиТолькоПриПродаже();
	ТолькоПродажа = НЕ (СпособыТолькоПриПродаже.ВыгрузитьЗначения().Найти(СпособПредоставления) = Неопределено
		И Назначение = ПредопределенноеЗначение("Перечисление.НазначенияАвтоматическихСкидок.Розница"));
	Возврат ТолькоПродажа;
КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииДляУправленияВнешнимВидомФормы

// Процедура управляет возможными точками выдачи сообщения кассиру для способа предоставления скидки - сообщение.
//
&НаСервере
Процедура ОбновитьДоступностьТочекВыдачиСообщенийКассиру()
	ТекстПодсказки = "";
	
	ТочкаПослеОформления = ПредопределенноеЗначение("Перечисление.ТочкиВыдачиСообщенияКассиру.ПослеОформленияЧека");
	ТочкаПриРасчете = ПредопределенноеЗначение("Перечисление.ТочкиВыдачиСообщенияКассиру.ВМоментРасчетаСкидок");
	ТочкаПоУмолчанию = ТочкаПриРасчете;	
	ДополнительныеТочки = Новый Массив;
	Если Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.Сообщение") Тогда
		Если Объект.Назначение = Перечисления.НазначенияАвтоматическихСкидок.Розница Тогда
			ТочкаПоУмолчанию = ТочкаПослеОформления;
			ДополнительныеТочки.Добавить(ТочкаПриРасчете);
		Иначе         
			ТекстПодсказки = "В опте показ сообщений поддерживается только в момент расчета скидки";
		КонецЕсли;		
	ИначеЕсли Объект.СпособПредоставления = ПредопределенноеЗначение("Перечисление.СпособыПредоставленияСкидокНаценок.Подарок") Тогда
		ТочкаПоУмолчанию = ТочкаПослеОформления;
		ДополнительныеТочки.Добавить(ТочкаПриРасчете);
	КонецЕсли;
	
	ДоступныеТочкиВывода = Новый массив;
	ДоступныеТочкиВывода.Добавить(ТочкаПоУмолчанию);
	
	Для каждого ДополнительнаяТочка Из ДополнительныеТочки Цикл
		ДоступныеТочкиВывода.Добавить(ДополнительнаяТочка);
	КонецЦикла;

	Элементы.МоментВыдачиСообщения.Подсказка = ТекстПодсказки;
	Элементы.МоментВыдачиСообщения.СписокВыбора.Очистить();
	Элементы.МоментВыдачиСообщения.СписокВыбора.ЗагрузитьЗначения(ДоступныеТочкиВывода); 
	Если ДоступныеТочкиВывода.Найти(Объект.МоментВыдачиСообщения) = неопределено Тогда
		Объект.МоментВыдачиСообщения = ТочкаПоУмолчанию;
	КонецЕсли;
	ДоступностьВыбораТочки = Истина;
	Если ДоступныеТочкиВывода.Количество() = 1 Тогда 
		ДоступностьВыбораТочки = Ложь;
	КонецЕсли;
	Элементы.МоментВыдачиСообщения.Доступность = ДоступностьВыбораТочки;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьПромокодов()
	ТаблицаУсловий = УсловияПредоставленияВСтроке.Выгрузить();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(УсловияПредоставленияПоДокументу.Выгрузить(), ТаблицаУсловий);
	ТребуетсяПромокод = УсловияСодержатТребованияПромокода(ТаблицаУсловий);
	Элементы.ГруппаПромокоды.Видимость = ТребуетсяПромокод;
	
	Если ТребуетсяПромокод Тогда
 		СервисМассовойРассылки = МассовыеРассылкиИнтеграция.ПодключенныйСервис();
	   	ИспользоватьМассовыеРассылкиИнтеграция = ПолучитьФункциональнуюОпцию(
	   		"ИспользоватьМассовыеРассылкиИнтеграция")
			И ЗначениеЗаполнено(СервисМассовойРассылки);

		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ПромокодыОтправитьПромокодыСервис", "Видимость", ИспользоватьМассовыеРассылкиИнтеграция);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ПромокодыКонтекстноеМенюОтправитьПромокодыСервис", "Видимость",
			ИспользоватьМассовыеРассылкиИнтеграция);
		
		ПредставлениеСервиса = МассовыеРассылкиИнтеграция.ПредставлениеСервиса(СервисМассовойРассылки);
		Элементы.ПромокодыОтправитьПромокодыСервис.Заголовок = СтрШаблон(
			НСтр("ru='Отправить выделенные промокоды %1'"), ПредставлениеСервиса);
		Элементы.ПромокодыКонтекстноеМенюОтправитьПромокодыСервис.Заголовок = СтрШаблон(
			НСтр("ru='Отправить выделенные промокоды %1'"), ПредставлениеСервиса);
		
		Если НЕ ПравоДоступа("Редактирование", Метаданные.Документы.МассоваяРассылка) Тогда
			Элементы.ПромокодыОтправитьПромокоды.Видимость = Ложь;
			Элементы.ПромокодыОтправитьПромокодыСервис.Видимость = Ложь;
			Элементы.ПромокодыКонтекстноеМенюОтправитьПромокоды.Видимость = Ложь;
			Элементы.ПромокодыКонтекстноеМенюОтправитьПромокодыСервис.Видимость = Ложь;			
		КонецЕсли;
					
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаличиеУсловийНаВидОплаты()
	
	ВыбранныеУсловия = Объект.УсловияПредоставления.Выгрузить(, "УсловиеПредоставления").ВыгрузитьКолонку("УсловиеПредоставления");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ Различные
	|	УсловияПредоставленияСкидокНаценок.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УсловияПредоставленияСкидокНаценок КАК УсловияПредоставленияСкидокНаценок
	|ГДЕ
	|	УсловияПредоставленияСкидокНаценок.УсловиеПредоставления = ЗНАЧЕНИЕ(Перечисление.УсловияПредоставленияСкидокНаценок.ЗаВидОплаты)
	|	И УсловияПредоставленияСкидокНаценок.Ссылка В(&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", ВыбранныеУсловия);
	УсловияЗаВидОплаты = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");	
	ЕстьУсловияПоВидуОплаты = УсловияЗаВидОплаты.Количество() > 0;
	Если ЕстьУсловияПоВидуОплаты
		И (НЕ Объект.СпособПредоставления = СпособПредоставленияПроцент
			И НЕ Объект.СпособПредоставления = СпособПредоставленияСумма
			И НЕ Объект.СпособПредоставления = СпособПредоставленияОкругление
				ИЛИ Объект.ИспользоватьПриВозврате) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'При использовании условий на вид оплаты, можно предоставлять только скидку процентом, фиксированной суммой, или округление при продаже.
		|Условия за вид оплаты исключены из списка.'");
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();		
		МассивСтрокУсловийУдалять = Новый Массив;
		Для Каждого СтрокаУсловия Из Объект.УсловияПредоставления Цикл
			Если НЕ УсловияЗаВидОплаты.Найти(СтрокаУсловия.УсловиеПредоставления) = Неопределено Тогда
				МассивСтрокУсловийУдалять.Добавить(СтрокаУсловия);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаУсловия Из МассивСтрокУсловийУдалять Цикл
			Объект.УсловияПредоставления.Удалить(СтрокаУсловия);
		КонецЦикла;
		ЕстьУсловияПоВидуОплаты = Ложь;
	КонецЕсли;
	Если Не Объект.ЕстьУсловияПоВидуОплаты = ЕстьУсловияПоВидуОплаты Тогда
		Объект.ЕстьУсловияПоВидуОплаты = ЕстьУсловияПоВидуОплаты;
		// Обновить подсказку
		УправлениеВидимостьюНаСервере();
	КонецЕсли;
	УстановитьДоступностьНазначения();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьНазначения()
	НоваяДоступность = НЕ (Объект.ЕстьУсловияПоВидуОплаты
		И Объект.СпособПредоставления = СпособПредоставленияПроцент)
		И НЕ Объект.ИспользоватьПриВозврате;
	Если ЭтоРучнаяСкидка Тогда
		НоваяДоступность = Ложь;
	ИначеЕсли НЕ Элементы.Назначение.Доступность = НоваяДоступность Тогда
		Если Не НоваяДоступность 
			И Не Объект.Назначение = НазначениеРозница Тогда
			Объект.Назначение = НазначениеРозница;
			ТекущийЭлемент = Элементы.Назначение;
		КонецЕсли;
	КонецЕсли;
	Элементы.Назначение.Доступность = НоваяДоступность;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодсказкуОбластиПредоставления()

	ТекстПодсказкиРаспределенияСтоимостиПодарка = ТекстПодсказкиОбластиПримененияСкидки(Объект.ОбластьПредоставления);
	Элементы.ОбластьПредоставления.Подсказка = ТекстПодсказкиРаспределенияСтоимостиПодарка;

КонецПроцедуры

&НаСервере
Функция ТекстПодсказкиОбластиПримененияСкидки(ОбластьПредоставления)
	Если Объект.СпособПредоставления <> СпособПредоставленияПодарок Тогда
		ТекстПодсказкиРаспределенияСтоимостиПодарка = НСтр("ru = 'Определяет, является ли скидка общей для всех строк документа или предоставляется для каждой строки, где выполнились условия.'");
	ИначеЕсли ОбластьПредоставления = ПредопределенноеЗначение("Перечисление.ВариантыОбластейОграниченияСкидокНаценок.ВДокументе") Тогда
		ТекстПодсказкиРаспределенияСтоимостиПодарка = НСтр("ru = 'При добавлении подарка в документ, стоимость подарка будет пропорционально разделена в документе.'");
	Иначе
		ТекстПодсказкиРаспределенияСтоимостиПодарка = НСтр("ru = 'На строку с подарком будет применена скидка 100%.'");
	КонецЕсли;
    Возврат ТекстПодсказкиРаспределенияСтоимостиПодарка;
КонецФункции

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийКомандФормы

&НаКлиенте
Процедура ДобавитьГруппуНоменклатурыКатегорийЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		НоваяСтрока = Объект.НоменклатураГруппыЦеновыеГруппы.Добавить();
		НоваяСтрока.ЗначениеУточнения = РезультатЗакрытия;
		Элементы.НоменклатураГруппыЦеновыеГруппы.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		Если Объект.ВариантОграниченияПоНоменклатуре = ВариантОграниченияПоНоменклатуре Тогда
			НоваяСтрока.ЭтоГруппа = УправлениеНебольшойФирмойВызовСервера.ЗначениеРеквизитаОбъекта(РезультатЗакрытия, "ЭтоГруппа");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьГруппуКонтрагентовЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		НоваяСтрока = Объект.ПолучателиСкидкиКонтрагенты.Добавить();
		НоваяСтрока.Получатель = РезультатЗакрытия;
		Элементы.ПолучателиСкидки.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеНастроекПодарков()
	
	Если Объект.ОбластьПредоставления = ПредопределенноеЗначение("Перечисление.ВариантыОбластейОграниченияСкидокНаценок.ВДокументе") Тогда
		Элементы.СхемаВыдачиПодаркаНаКассеВЧек.Подсказка = НСтр("ru = 'Выданный подарок будет добавлен в чек покупателя со 100% скидкой, равномерно распределенной по документу'");
	Иначе
		Элементы.СхемаВыдачиПодаркаНаКассеВЧек.Подсказка = НСтр("ru = 'Выданный подарок будет добавлен в чек покупателя со 100% скидкой'");
	КонецЕсли;
	Элементы.СчетЗатратПодарка.Доступность = Не Объект.УчитыватьПодарокКакПродажу И Не Объект.ПодарокИзКорзиныПокупателя; 
		
КонецПроцедуры


&НаКлиенте
Процедура НаборПодарковПодтверждениеСбросаКоличестваЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ЗапрашиватьСбросКоличества = Результат.ЗапрашиватьСбросКоличества;
		Если НЕ ЗапрашиватьСбросКоличества Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Результат);
		КонецЕсли;
		Если Результат.СбрасыватьКоличество Тогда
			НовоеКоличество = Результат.НовоеКоличествоПриИзмененииНоменклатуры;
		Иначе
			НовоеКоличество = ДополнительныеПараметры.Количество;
		КонецЕсли;
	Иначе
		НовоеКоличество = ДополнительныеПараметры.Количество;
	КонецЕсли;
	
	НаборПодарковНоменклатураПриИзмененииПродолжить(ДополнительныеПараметры.Элемент, НовоеКоличество);
	
КонецПроцедуры

&НаКлиенте
Процедура НаборПодарковНоменклатураПриИзмененииПродолжить(Элемент, НовоеКоличество)

	СтрокаТабличнойЧасти = Элементы.НаборПодарков.ТекущиеДанные;
	
	СтруктураДанные = Новый Структура();
	СтруктураДанные.Вставить("Номенклатура", СтрокаТабличнойЧасти.Номенклатура);
	
	СтруктураДанные = ПолучитьДанныеНоменклатураПриИзменении(СтруктураДанные);
	
	СтрокаТабличнойЧасти.Характеристика = Неопределено;
	СтрокаТабличнойЧасти.ИспользоватьХарактеристики = СтруктураДанные.ИспользоватьХарактеристики;
	СтрокаТабличнойЧасти.ПроверятьЗаполнениеХарактеристики = СтруктураДанные.ПроверятьЗаполнениеХарактеристики;
	СтрокаТабличнойЧасти.ЗаполнениеХарактеристикиПроверено = Истина;
	
	СтрокаТабличнойЧасти.ЕдиницаИзмерения = СтруктураДанные.ЕдиницаИзмерения;
	СтрокаТабличнойЧасти.Количество = НовоеКоличество;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуГенерацииПромокодов()
	ПараметрыОткрытия = Новый Структура("СкидкаНаценка", Объект.Ссылка);
	ОткрытьФорму("Обработка.ГенерацияПромокодов.Форма.Форма", ПараметрыОткрытия, ЭтотОбъект); 
КонецПроцедуры

&НаСервере
Процедура ИспользоватьПриПродажеПриИзмененииНаСервере()
	ЗаполнитьСписокВыбораСпособПредоставления();
	ПроверитьНаличиеУсловийНаВидОплаты()
КонецПроцедуры

&НаКлиенте
Процедура НастроитьЭлементыФормы()
	//Элементы.Назначение.Доступность = НЕ Объект.ИспользоватьПриВозврате;
	УстановитьДоступностьНазначения();
	ТолькоПродажа = СкидкаДоступнаТолькоПриПродаже(Объект.Назначение, Объект.СпособПредоставления);
	Элементы.ИспользоватьПриПродаже.Доступность = НЕ ТолькоПродажа;
	УстановитьДоступностьКратности();
	Элементы.СчетЗатратПодаркаСокращенный.Доступность = НЕ Объект.УчитыватьПодарокКакПродажу;
	ОбновитьДоступностьСкидокВозврат();
	
КонецПроцедуры
#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Функция СпособПоддерживаетКратность(СпособПредоставления)
	СпособПодходит = СпособПредоставления = ПредопределенноеЗначение(
		"Перечисление.СпособыПредоставленияСкидокНаценок.Сумма") 
		Или СпособПредоставления = ПредопределенноеЗначение(
			"Перечисление.СпособыПредоставленияСкидокНаценок.Процент") 
		Или СпособПредоставления = ПредопределенноеЗначение(
			"Перечисление.СпособыПредоставленияСкидокНаценок.ВидЦен")
		Или СпособПредоставления = ПредопределенноеЗначение(
			"Перечисление.СпособыПредоставленияСкидокНаценок.КоличествоБонусныхБаллов") 
		Или СпособПредоставления = ПредопределенноеЗначение(
			"Перечисление.СпособыПредоставленияСкидокНаценок.ПроцентОтСуммыВВидеБонусныхБаллов") 
		Или СпособПредоставления = ПредопределенноеЗначение(
			"Перечисление.СпособыПредоставленияСкидокНаценок.Подарок");
	Возврат СпособПодходит;
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьКратности()
	
	ПовторениеДоступно = Ложь;
	
	СпособПодходит = СпособПоддерживаетКратность(Объект.СпособПредоставления);
	
	Если Объект.ИспользоватьРежимКратности И НЕ СпособПодходит Тогда
		Объект.ИспользоватьРежимКратности = Ложь;
	КонецЕсли;
	
 	Элементы.ГруппаКратность.Видимость = СпособПодходит;
	Элементы.ГруппаСтрокаКратности.Доступность = Объект.ИспользоватьРежимКратности;
	СписокУсловий = Новый Массив;
	Если СпособПодходит Тогда
		Для Каждого СтрокаУсловия ИЗ Объект.УсловияПредоставления Цикл
			СписокУсловий.Добавить(СтрокаУсловия.УсловиеПредоставления);
		КонецЦикла;
		ОписанияУсловийСКратностью = УсловияПоддерживающиеКратность(СписокУсловий);
		ПовторениеДоступно = ОписанияУсловийСКратностью.Количество() > 0;
		Если ПовторениеДоступно И Объект.КратноКоличествуУсловий Тогда
			ТекстОписанияУсловий = СтрСоединить(ОписанияУсловийСКратностью, " и ");
		Иначе
			ТекстОписанияУсловий = "";			
		КонецЕсли;
		ТекстКратныхУсловий = ТекстОписанияУсловий;
	КонецЕсли;
	ОбновитьКратность();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УсловияПоддерживающиеКратность(Условия)
	Результат = Новый Массив;
	
	МожноВывестиУсловий = 2;
	КоличествоНеВместившихсяУсловий = 0;
	Для Каждого Условие Из Условия Цикл
		ОписаниеКратностиУсловия = СкидкиНаценкиСервер.ОписаниеКратностиУсловия(Условие, Истина);				
		Если НЕ ОписаниеКратностиУсловия = Неопределено Тогда
			Если МожноВывестиУсловий >= 1 Тогда
				Результат.Добавить(ОписаниеКратностиУсловия);				
			Иначе
				КоличествоНеВместившихсяУсловий = КоличествоНеВместившихсяУсловий + 1;
			КонецЕсли;
			МожноВывестиУсловий = МожноВывестиУсловий - 1;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоНеВместившихсяУсловий > 0 Тогда
		Инд = Результат.ВГраница();
		Результат[Инд] = Результат[Инд] + СтрШаблон(" и еще %1", 
			ПолучитьСклоненияСтрокиПоЧислу("Условие",  КоличествоНеВместившихсяУсловий, "", "ЧС=Количественное", "ПД=Родительный; ПЧ=Число"));
	КонецЕсли;
	Возврат Результат;
КонецФУнкции

&НаКлиенте
Процедура КонвертироватьПодарокИзКорзиныНаКлиенте()
	
	Если Модифицированность Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Перед конвертацией, скидку необходимо записать.'"));
	ИначеЕсли Недействителен Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Конвертировать возможно только действующую скидку.'"));
	Иначе
		НоваяСкидка = КонвертироватьПодарокИзКорзиныНаСервере();
		ПоказатьЗначение(,НоваяСкидка);
		Объект.Действует = Ложь;
		Недействителен = Истина;
		Объект.Комментарий = СтрШаблон(НСтр("ru = 'Отключена в результате конвертации %1. Конвертацию выполнил %2'"), 
			ОбщегоНазначенияКлиент.ДатаСеанса(), 
			ПользователиКлиент.ТекущийПользователь());
		Записать();
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КонвертироватьПодарокИзКорзиныНаСервере()
	
	Результат = Неопределено;
	СтараяСкидка = РеквизитФормыВЗначение("Объект");
	НоваяСкидка = СтараяСкидка.Скопировать();
	НачатьТранзакцию();
	Попытка
		Справочники.АвтоматическиеСкидки.ЗаполнитьСконвертированныеНастройкиПодарокИзКорзиныПокупателя(СтараяСкидка, НоваяСкидка);
		НоваяСкидка.Записать();
		Результат = НоваяСкидка.Ссылка;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;
	Возврат Результат;
	
КонецФункции

