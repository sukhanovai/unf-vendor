	ОбновитьАвтонаименование(Истина);
	ПредставлениеНастроекПодарков();
	УстановитьДоступностьКратности();
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьМассовуюРассылку(РассылкаСервиса = Ложь)

	ПараметрыРассылки = Новый Структура;
	ПараметрыРассылки.Вставить("СпособОтправки", ПредопределенноеЗначение("Перечисление.ВидыКаналовСвязи.Email"));
	ПараметрыРассылки.Вставить("ПредлагаемаяСкидка", Объект.Ссылка);
	ИмяФормыРассылки = "Документ.МассоваяРассылка.Форма.ФормаДокумента";
	Если РассылкаСервиса Тогда
		ИмяФормыРассылки = "Документ.МассоваяРассылка.Форма.РассылкаСервиса";
	КонецЕсли;
	
	ОткрытьФорму(ИмяФормыРассылки, ПараметрыРассылки);
	 
КонецПроцедуры

&НаСервере
Процедура ОбновитьВалютуПредоставления()
	
	Если ЗначениеЗаполнено(Объект.ВидЦен) Тогда
		Объект.ВалютаПредоставления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидЦен, "ВалютаЦены");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СпособПредоставленияПриИзмененииСервер()
	
	ЭтоПравилоНачисленияБонусов =
		Объект.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.КоличествоБонусныхБаллов
		ИЛИ Объект.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.ПроцентОтСуммыВВидеБонусныхБаллов;
	
	Объект.ЭтоПравилоНачисленияБонусов = ЭтоПравилоНачисленияБонусов;
	Если НЕ ЭтоПравилоНачисленияБонусов Тогда
		Объект.БонуснаяПрограмма = Справочники.БонусныеПрограммы.ПустаяСсылка();
	КонецЕсли;
	
	ПроверитьНаличиеУсловийНаВидОплаты();
	УправлениеВидимостьюНаСервере();
	
	Если Объект.СпособПредоставления = СпособПредоставленияРасширение Тогда
		УстановитьИдентификаторДляРасчетаВРасширении();		
	КонецЕсли;
	
	Элементы.ИдентификаторДляРасчетаВРасширении.Видимость =
		Объект.СпособПредоставления = СпособПредоставленияРасширение;
	
	ОбновитьВалютуПредоставления();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОбщееКоличествоУсловий()
	КоличествоПокупатели = 0;
	Если Объект.ВариантОграниченияПоПолучателям = ПредопределенноеЗначение("Перечисление.ВариантыОграниченийСкидокПоКонтрагентам.ПоКонтрагентам") Тогда
		КоличествоПокупатели = КоличествоПокупатели + Объект.ПолучателиСкидкиКонтрагенты.Количество();
	Иначе
		КоличествоПокупатели = КоличествоПокупатели + Объект.ПолучателиСкидкиСегменты.Количество();
	КонецЕсли;
	КоличествоУсловийПокупатели = КоличествоПокупатели;
	КоличествоУсловийСклады = Объект.ПолучателиСкидкиСклады.Количество();
	КоличествоУсловийПоДокументу = УсловияПредоставленияПоДокументу.Количество();
	КоличествоУсловийПоСтроке = УсловияПредоставленияВСтроке.Количество();
	КоличествоУсловийВсего = КоличествоУсловийПоДокументу + 
		КоличествоУсловийПоСтроке;
		
	КоличествоНастроекДат = 0;
	Если ЗначениеЗаполнено(Объект.ДатаОкончания) ИЛИ ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		КоличествоНастроекДат = КоличествоНастроекДат + 1;
	КонецЕсли;
	Если НЕ Объект.Назначение = НазначениеВезде Тогда
		КоличествоНастроекДат = КоличествоНастроекДат + 1;
	КонецЕсли;
	КоличествоНастроекДат = КоличествоНастроекДат + Объект.ВремяПоДнямНедели.Количество();
	Для Каждого СтрокаМеню Из ВсеРазделыМеню() Цикл
		Если СтрокаМеню.ИмяСтраницы = "ГруппаОписаниеДействия" Тогда
			СтрокаМеню.КоличествоНастроек = Мин(10, КоличествоНастроекДат);
		ИначеЕсли СтрокаМеню.ИмяСтраницы = "Уточнения" Тогда
			СтрокаМеню.КоличествоНастроек = Мин(10, Объект.НоменклатураГруппыЦеновыеГруппы.Количество());
		ИначеЕсли СтрокаМеню.ИмяСтраницы = "ГруппаСклады" Тогда
			СтрокаМеню.КоличествоНастроек = Мин(10, КоличествоУсловийСклады);
		ИначеЕсли СтрокаМеню.ИмяСтраницы = "ГруппаКонтрагенты" Тогда
			СтрокаМеню.КоличествоНастроек = Мин(10, КоличествоУсловийПокупатели);
		ИначеЕсли СтрокаМеню.ИмяСтраницы = "ГруппаПодарок" Тогда
			СтрокаМеню.КоличествоНастроек = Мин(10, Объект.НаборПодарков.Количество());
		ИначеЕсли СтрокаМеню.ИмяСтраницы = "ГруппаУсловияПредоставления" Тогда
			СтрокаМеню.КоличествоНастроек = Мин(10, КоличествоУсловийВсего);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ВсеРазделыМеню(СтрокаРаздела = Неопределено)
	Результат = Новый Массив;
	ИсследуемаяСтрока = МенюРазделов;
	Если НЕ СтрокаРаздела = Неопределено Тогда
		ИсследуемаяСтрока = СтрокаРаздела;
	КонецЕсли;
	Для Каждого ПодчиненнаяСтрока Из ИсследуемаяСтрока.ПолучитьЭлементы() Цикл
		Результат.Добавить(ПодчиненнаяСтрока);
		РезультатВложенный = ВсеРазделыМеню(ПодчиненнаяСтрока);
		Для Каждого Вложеннаястрока Из РезультатВложенный Цикл
			Результат.Добавить(Вложеннаястрока);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьСкидокВозврат()
	
	ТолькоПродажа = СкидкаДоступнаТолькоПриПродаже(Объект.Назначение, Объект.СпособПредоставления);
	
	Элементы.ИспользоватьПриПродаже.Доступность = Не ТолькоПродажа;
	
	Если Объект.ИспользоватьПриВозврате И ТолькоПродажа Тогда
		Объект.ИспользоватьПриВозврате = Ложь;
		ИспользоватьПриПродаже = НЕ Объект.ИспользоватьПриВозврате;
		ИспользоватьПриПродажеПриИзмененииНаСервере();
	КонецЕсли;
	 
КонецПроцедуры

&НаСервере
Процедура РодительПриИзмененииНаСервере()
	
	ВариантСовместногоПрименения = ПолучитьТекущийВариантСовместногоПрименения(Объект.Родитель);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Родитель", "Подсказка", СтрШаблон(НСтр("ru = 'Совместное применение скидок: %1'",ВариантСовместногоПрименения)));
	
КонецПроцедуры

// Получает набор данных с сервера для процедуры НоменклатураПриИзменении.
//
// Возвращаемое значение:
//  - Структура - Значения зависимых от номенклатуры полей строки
&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатураПриИзменении(СтруктураДанные)
	
	// Наборы
	Если НЕ СтруктураДанные.Свойство("ЕдиницаИзмерения") Тогда
		ЕдИзмНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураДанные.Номенклатура,
			"ЕдиницаИзмерения");
		СтруктураДанные.Вставить("ЕдиницаИзмерения", ЕдИзмНоменклатуры);
	КонецЕсли;
	 
	Если НЕ СтруктураДанные.Свойство("Коэффициент") Тогда
		Если ТипЗнч(СтруктураДанные.ЕдиницаИзмерения) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
			ИмяРеквизита = "Коэффициент";
			КоэффициентЕдИзм = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураДанные.ЕдиницаИзмерения,
				ИмяРеквизита);
			СтруктураДанные.Вставить("Коэффициент", КоэффициентЕдИзм);
		Иначе
			СтруктураДанные.Вставить("Коэффициент", 1);
		КонецЕсли; 
	КонецЕсли;
	// Конец Наборы
	
	// Характеристики
	СтруктураДанные.Вставить("ИспользоватьХарактеристики", Ложь);
	СтруктураДанные.Вставить("ПроверятьЗаполнениеХарактеристики", Ложь);
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанные.Номенклатура,
		"ИспользоватьХарактеристики, ПроверятьЗаполнениеХарактеристики");
		
	Если ЗначениеЗаполнено(СтруктураДанные.Номенклатура)
		И РеквизитыНоменклатуры.ИспользоватьХарактеристики Тогда
			
		ЗначенияПоУмолчанию = НоменклатураВДокументахСервер.ЗначенияНоменклатурыПоУмолчанию(СтруктураДанные.Номенклатура);
		
		Если Не ЗначенияПоУмолчанию = Неопределено
			Тогда
			ХарактеристикаПоУмолчанию = ЗначенияПоУмолчанию;
		КонецЕсли;
		
		Если НЕ СтруктураДанные.Свойство("Характеристика") Тогда
			СтруктураДанные.Вставить("Характеристика",ХарактеристикаПоУмолчанию);
		Иначе
			СтруктураДанные.Характеристика = ?(ЗначениеЗаполнено(СтруктураДанные.Характеристика), СтруктураДанные.Характеристика, ХарактеристикаПоУмолчанию);
		КонецЕсли;
		
		СтруктураДанные.Вставить("ИспользоватьХарактеристики", Истина);
		СтруктураДанные.Вставить("ПроверятьЗаполнениеХарактеристики",
			РеквизитыНоменклатуры.ПроверятьЗаполнениеХарактеристики);
			
	КонецЕсли;
	// Конец Характеристики
	
	Возврат СтруктураДанные;
		
КонецФункции // ПолучитьДанныеНоменклатураПриИзменении()

&НаКлиенте
Процедура НастройкаСбросаКоличестваЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	НастройкиКоличества = ПолучитьНастройкиИзмененияКоличества();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиКоличества);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаПодбораНоменклатуры(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("АдресКорзиныВХранилище")
		И ЗначениеЗаполнено(Результат.АдресКорзиныВХранилище) Тогда
		ИмяТабличнойЧасти = "НаборПодарков";
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
			И ДополнительныеПараметры.Свойство("ИмяТабличнойЧасти") Тогда
			ИмяТабличнойЧасти = ДополнительныеПараметры.ИмяТабличнойЧасти;
		КонецЕсли;
		ПолучитьНоменклатуруИзХранилища(Результат.АдресКорзиныВХранилище, ИмяТабличнойЧасти);		
		ПредставлениеНастроекПодарков();
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - обработчик события ПриИзменении элемента ВариантОграниченияПоНоменклатуре (завершение после ответа на вопрос об удалении строк в ТЧ).
// 
// Параметры:
//  РезультатОтвета - КодВозвратаДиалога, Неопределено -  Результат ответа
//  ДополнительныеПараметры - Структура - Дополнительные параметры
&НаКлиенте
Процедура ВариантОграниченияПоНоменклатуреПриИзмененииЗавершение(РезультатОтвета, ДополнительныеПараметры) Экспорт

	Если РезультатОтвета <> КодВозвратаДиалога.Да Тогда
		Объект.ВариантОграниченияПоНоменклатуре = ВариантОграниченияПоНоменклатуреДоИзменения;
		Возврат;
	КонецЕсли;
	
	ВариантОграниченияПоНоменклатуреДоИзменения = Объект.ВариантОграниченияПоНоменклатуре;
	УправлениеВидимостьюНаСервере();
	Объект.НоменклатураГруппыЦеновыеГруппы.Очистить();
	
	ОбновитьАвтонаименование(Истина);
	
КонецПроцедуры

// Функция получает список товаров из временного хранилища
//
// Параметры:
//  АдресПодарковВХранилище - Строка - строка, содержащая электронные адреса
//  ИмяТабличнойЧасти - Строка - Имя табличной части, в которую необходимо поместить подарки
&НаСервере
Процедура ПолучитьНоменклатуруИзХранилища(АдресПодарковВХранилище, ИмяТабличнойЧасти)	
	
	ТаблицаДляЗагрузки = ПолучитьИзВременногоХранилища(АдресПодарковВХранилище);
	
	НоваяСтрока = Неопределено;
	
	Если ИмяТабличнойЧасти = "НоменклатураГруппыЦеновыеГруппы" Тогда
		ТаблицаДляЗагрузки.Колонки.Номенклатура.Имя = "ЗначениеУточнения";
	КонецЕсли;
	
	Для каждого СтрокаЗагрузки Из ТаблицаДляЗагрузки Цикл
		
		НоваяСтрока = Объект[ИмяТабличнойЧасти].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗагрузки);
		
		Если ИмяТабличнойЧасти = "НаборПодарков"
			И ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда

			ОбработатьДобавлениеСтрокиЗапасов(НоваяСтрока, ИмяТабличнойЧасти);
			
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры // ПолучитьЗапасыИзХранилища()	

&НаСервере
Процедура ОбработатьДобавлениеСтрокиЗапасов(НоваяСтрока, ИмяТабличнойЧасти = "Подарки")
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяСтрока.Номенклатура, 
		"ТипНоменклатуры, Вес, Объем, ЭтоНабор, СпособРасчетаЦеныНабора");
	
	СтруктураДанныеНоменклатуры = Новый Структура();
	СтруктураДанныеНоменклатуры.Вставить("Номенклатура", НоваяСтрока.Номенклатура);
	СтруктураДанныеНоменклатуры.Вставить("Характеристика", НоваяСтрока.Характеристика);

	СтруктураДанныеНоменклатуры.Вставить("ТипНоменклатуры", ЗначенияРеквизитов.ТипНоменклатуры);
	СтруктураДанныеНоменклатуры.Вставить("ЕдиницаИзмерения", НоваяСтрока.ЕдиницаИзмерения);
	СтруктураДанные = ПолучитьДанныеНоменклатураПриИзменении(СтруктураДанныеНоменклатуры);
		
	// Характеристики
	НоваяСтрока.ИспользоватьХарактеристики = СтруктураДанные.ИспользоватьХарактеристики;
	НоваяСтрока.ПроверятьЗаполнениеХарактеристики = СтруктураДанные.ПроверятьЗаполнениеХарактеристики;
	НоваяСтрока.ЗаполнениеХарактеристикиПроверено = Истина;
	
	Если СтруктураДанные.ИспользоватьХарактеристики
		Тогда
		НоваяСтрока.Характеристика = СтруктураДанные.Характеристика;
	КонецЕсли;
	// Конец Характеристики
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеФормы()
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(НовоеУсловноеОформление.Отбор, "Объект.НоменклатураГруппыЦеновыеГруппы.ЭтоГруппа", Истина, ВидСравненияКомпоновкиДанных.Равно);
