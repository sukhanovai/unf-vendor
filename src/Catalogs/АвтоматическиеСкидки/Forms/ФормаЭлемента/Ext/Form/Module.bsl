&НаСервере
Процедура РазделитьУсловияПоОбласти()
	УсловияПредоставленияВСтроке.Очистить();
	УсловияПредоставленияПоДокументу.Очистить();
	ВыбранныеУсловия = Объект.УсловияПредоставления.Выгрузить(,"УсловиеПредоставления").ВыгрузитьКолонку("УсловиеПредоставления");
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УсловияПредоставленияСкидокНаценок.Ссылка КАК Ссылка,
	|	УсловияПредоставленияСкидокНаценок.ОбластьОграничения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбластейОграниченияСкидокНаценок.ВСтроке) КАК УсловиеНаСтроку
	|ИЗ
	|	Справочник.УсловияПредоставленияСкидокНаценок КАК УсловияПредоставленияСкидокНаценок
	|Где УсловияПредоставленияСкидокНаценок.Ссылка В (&ВыбранныеУсловия)";
	Запрос.УстановитьПараметр("ВыбранныеУсловия",ВыбранныеУсловия);
	ВыбУсловия = Запрос.Выполнить().Выбрать();
	Пока ВыбУсловия.Следующий() Цикл
		Если ВыбУсловия.УсловиеНаСтроку Тогда
			СохраненноеУсловие = УсловияПредоставленияВСтроке.Добавить();
			СохраненноеУсловие.УсловиеПредоставления = ВыбУсловия.Ссылка;
		Иначе
			СохраненноеУсловие = УсловияПредоставленияПоДокументу.Добавить();
			СохраненноеУсловие.УсловиеПредоставления = ВыбУсловия.Ссылка;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

