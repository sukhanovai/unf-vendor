
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользуетсяБСП = ОбщегоНазначенияБПО.ИспользуетсяБСП();
	ЭтотОбъект.Элементы.СписокОтправить.Видимость = ИспользуетсяБСП;
	ЭтотОбъект.Элементы.СписокУдалить.Видимость   = ИспользуетсяБСП;
	
	РассылкаЭлектронныхЧековПереопределяемый.ПриСозданииСпискаОчереди(ЭтотОбъект);
	
	// Вызов БСП
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияБПО.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКоманды = ОбщегоНазначенияБПО.ОбщийМодуль("ПодключаемыеКоманды");
		МодульПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	// Конец Вызов БСП
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьСостояниеОтображения();
	
	РассылкаЭлектронныхЧековКлиентПереопределяемый.ПриОткрытииСпискаОчереди(ЭтотОбъект, Список);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// Вызов БСП
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияБПОКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияБПОКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	// Конец Вызов БСП
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриНаведении(Элемент, Строка, Поле)
	
	// Вызов БСП
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияБПОКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияБПОКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	// Конец Вызов БСП
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)
	
	ОтправитьНаСервере();
	ОповеститьОбИзменении(Тип("СправочникСсылка.ОчередьЭлектронныхЧековКОтправке"));
	
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	
	УдалитьНаСервере();
	ОповеститьОбИзменении(Тип("СправочникСсылка.ОчередьЭлектронныхЧековКОтправке"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьБезОшибок(Команда)
	
	УстановитьСостояниеОтображения();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОтправитьНаСервере()
	
	Ссылки = СсылкиВыделенныхСтрок();
	РассылкаЭлектронныхЧеков.ОтправитьСообщенияМассива(Ссылки);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьНаСервере()
	
	Ссылки = СсылкиВыделенныхСтрок();
	РассылкаЭлектронныхЧеков.УдалитьСообщенияМассива(Ссылки);
	
КонецПроцедуры

&НаСервере
Функция СсылкиВыделенныхСтрок()
	
	
	Ссылки = Новый Массив;
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		ДанныеСтроки = Новый Структура("Ссылка");
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, Элементы.Список.ТекущаяСтрока);
		Ссылки.Добавить(ДанныеСтроки.Ссылка);
		
	Иначе
		Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
			ДанныеСтроки = Новый Структура("Ссылка");
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, ВыделеннаяСтрока);
			Ссылки.Добавить(ДанныеСтроки.Ссылка);
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ссылки;
	
КонецФункции

&НаКлиенте
Процедура УстановитьСостояниеОтображения()
	
	УстановитьСостояниеДинамическогоСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеДинамическогоСписка()
	
	Если ОбщегоНазначенияБПОКлиент.ИспользуетсяБСП() Тогда
		
		// Вызов БСП
		МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначенияБПОКлиент.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
		МодульОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список, "ПроизошлаОшибкаПередачи", ОтборПоОшибкам, ВидСравненияКомпоновкиДанных.Равно, , ОтборПоОшибкам);
		// Конец Вызов БСП
		
	КонецЕсли;
		
КонецПроцедуры

