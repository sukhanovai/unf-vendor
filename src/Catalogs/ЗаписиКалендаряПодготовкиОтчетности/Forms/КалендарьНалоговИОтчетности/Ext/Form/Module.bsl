&НаКлиенте
Процедура СписокЗадачВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		СтруктураСобытия = Новый Структура("СобытиеКалендаря, СостояниеСобытия, Организация",
			ТекДанные.СобытиеКалендаря,
			ТекДанные.Состояние,
			ТекДанные.Организация);
		ИмяФормыЗадачи = ПолучитьИмяФормыПоЗадачеИСостоянию(ТекДанные.Задача, СтруктураСобытия);
		Если Не ПустаяСтрока(ИмяФормыЗадачи) Тогда  
			Если ИмяФормыЗадачи = "Обработка.ОбработкиНалоговИОтчетности.Форма.ОписанияЗадачИСтартВыполнения" Тогда
				СтруктураСобытия.Вставить("ЗаписьКалендаря", ТекДанные.Ссылка);
			КонецЕсли; 
			
			ОткрытьФорму(ИмяФормыЗадачи, СтруктураСобытия,ЭтотОбъект,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отчеты(Команда)
	
	ОтчетПоНалогам = НайтиОтчетПоНалогам();
	Если Не ЗначениеЗаполнено(ОтчетПоНалогам) Тогда
		Возврат;
	КонецЕсли;
	ПараметрыОткрытия = Новый Структура;
	ВариантыОтчетовКлиент.ОткрытьФормуОтчета(ЭтотОбъект, ОтчетПоНалогам, ПараметрыОткрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокЗадач(Команда)
	
	Если ЗапуститьОбновлениеДанныхНаСервере() Тогда
		
		ЖдатьЗавершенияФоновогоЗадания();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВАрхив(Команда)

	Для Каждого СтрокаДляОбработки Из Элементы.СписокЗадач.ПолучитьСтрокиДляОбработки() Цикл
		ТекущиеДанныеСтроки = Элементы.СписокЗадач.ДанныеСтроки(СтрокаДляОбработки);
		ПеренестиЗадачуВАрхивСервер(ТекущиеДанныеСтроки.Организация, ТекущиеДанныеСтроки.СобытиеКалендаря,
			ТекущиеДанныеСтроки.Ссылка);
	КонецЦикла;
	
	Элементы.СписокЗадач.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьВАктуальные(Команда)

	Для Каждого СтрокаДляОбработки Из Элементы.СписокЗадач.ПолучитьСтрокиДляОбработки() Цикл
		ТекущиеДанныеСтроки = Элементы.СписокЗадач.ДанныеСтроки(СтрокаДляОбработки);
		ВернутьЗадачуИзАрхиваСервер(ТекущиеДанныеСтроки.Организация, ТекущиеДанныеСтроки.СобытиеКалендаря,
			ТекущиеДанныеСтроки.Ссылка);
	КонецЦикла;
	
	Элементы.СписокЗадач.Обновить();
	
КонецПроцедуры

