Функция НайтиОтчетПоНалогам()
	Возврат Справочники.ВариантыОтчетов.НайтиПоНаименованию("Расчеты по налогам");
КонецФункции

&НаСервере
Процедура УстановитьОформленияБаннераОПереносеСроков() 
	
	Если ТекущаяДатаСеанса() > '20220101' И ТекущаяДатаСеанса() < '20230101' Тогда
		ВывестиБаннерПереносСроковУплатыНалогов();
	ИначеЕсли ТекущаяДатаСеанса() > '20230101' И ТекущаяДатаСеанса() < '20240101' Тогда
		ВывестиБаннерЕНП();
	Иначе
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ВывестиБаннерПереносСроковУплатыНалогов()

	СистемаНалогообложения = РегистрыСведений.СистемыНалогообложенияОрганизаций.ОпределитьСистемуНалогообложенияОрганизации(
		Организация, ТекущаяДатаСеанса());
	ПрименяетсяУСН = СистемаНалогообложения.ПрименяетсяАУСН;
	
	ПрименяетсяУСН = Истина;
	
	Если ПрименяетсяУСН Тогда
		КраткоеПредставлениеСообщения = НСтр("ru = 'Перенос сроков'");
		ТекстЗаголовка = НСтр("ru='Перенос сроков уплаты налогов в 2022 году'");
		ТекстСообщения= СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru='В некоторых регионах <a href=""ГиперссылкаПереносСроковВРегионах"">перенесены</a> сроки уплаты налогов, а также для ряда отраслей <a href = ""ГиперссылкаПереносСроковУСН"">продлены</a> сроки уплаты налога и аванса по УСН'"));
		
		ПараметрыСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
		ПараметрыСообщения.Заголовок = ТекстЗаголовка;
		ПараметрыСообщения.КраткоеПредставление = КраткоеПредставлениеСообщения;	
		ПараметрыСообщения.Сообщение = ТекстСообщения;
		ПараметрыСообщения.Обработчик = "Подключаемый_ПерейтиПоСсылкеИзБаннера";
		ПараметрыСообщения.ТипСообщения = "Предупреждение";
		ПараметрыСообщения.Скрываемый = Ложь;
		
		ОбщегоНазначения.ДобавитьВажноеСообщение(ЭтотОбъект, ПараметрыСообщения);		
	Иначе
		КраткоеПредставлениеСообщения = НСтр("ru = 'Перенос сроков'");
		ТекстЗаголовка = НСтр("ru='Перенос сроков уплаты налогов в 2022 году'");
		ТекстСообщения= СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru='В некоторых регионах <a href=""ГиперссылкаПереносСроковВРегионах"">перенесены</a> сроки уплаты налогов.'"));
		
		ПараметрыСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
		ПараметрыСообщения.Заголовок = ТекстЗаголовка;
		ПараметрыСообщения.КраткоеПредставление = КраткоеПредставлениеСообщения;	
		ПараметрыСообщения.Сообщение = ТекстСообщения;
		ПараметрыСообщения.Обработчик = "Подключаемый_ПерейтиПоСсылкеИзБаннера";
		ПараметрыСообщения.ТипСообщения = "Предупреждение";
		ПараметрыСообщения.Скрываемый = Ложь;
		
		ОбщегоНазначения.ДобавитьВажноеСообщение(ЭтотОбъект, ПараметрыСообщения);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ВывестиБаннерЕНП()

	КраткоеПредставлениеСообщения = НСтр("ru = 'Единый налоговый платеж'");
	ТекстЗаголовка = НСтр("ru='Единый налоговый платеж в 1С:УНФ'");
	ТекстСообщения= СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru='<a href=""ГиперссылкаСтатьяЕНП"">Читать</a> про состав, сроки отчетности и уплаты, порядок действий в 1С:УНФ.'"));
	
	ПараметрыСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыСообщения.Заголовок = ТекстЗаголовка;
	ПараметрыСообщения.КраткоеПредставление = КраткоеПредставлениеСообщения;	
	ПараметрыСообщения.Сообщение = ТекстСообщения;
	ПараметрыСообщения.Обработчик = "Подключаемый_ПерейтиПоСсылкеИзБаннера";
	ПараметрыСообщения.ТипСообщения = "Предупреждение";
	ПараметрыСообщения.Скрываемый = Ложь;
	
	ОбщегоНазначения.ДобавитьВажноеСообщение(ЭтотОбъект, ПараметрыСообщения);

КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Функция ГиперссылкаПереносСроковВРегионах()
	
	Возврат "https://its.1c.ru/docs/reshedule2022";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГиперссылкаПереносСроковУСН()
	
	Возврат "https://its.1c.ru/bmk/reschedule2022/usn";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГиперссылкаСтатьяЕНП()
	
	Возврат "https://v8.1c.ru/metod/article/edinyy-nalogovyy-platezh-s-1-yanvarya-2023-goda-chto-takoe-i-kak-platit-v-1s-unf.htm";
	
КонецФункции


&НаСервереБезКонтекста
Функция ИмяСвойстваУсловногоОформленияКолонкиЦветом(ЭтоВариантИнтерфейса85)
	
	ИмяСвойства = ?(ЭтоВариантИнтерфейса85, "ЦветОтметки", "ЦветФона");
	Возврат ИмяСвойства;
	
КонецФункции

&НаСервере
Процедура АдаптацияФормыТакси()
	
	Если ЭтоВариантИнтерфейса85 Тогда
		Возврат;
	КонецЕсли;

	Элементы.СписокЗадачКонтекстноеМенюПеренестиВЗавершенные.Отображение = ОтображениеКнопки.Текст;
	Элементы.СписокЗадачКонтекстноеМенюВернутьВАктуальные.Отображение = ОтображениеКнопки.Текст;

КонецПроцедуры

&НаСервере
Процедура АдаптацияФормыМобильныйКлиент()
	
	Если Не ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаНастоящее.РастягиватьПоГоризонтали = Истина;
	Элементы.ГруппаБудущее.РастягиватьПоГоризонтали = Истина;
	Элементы.ГруппаАрхив.РастягиватьПоГоризонтали = Истина;
	Элементы.Месяц.Ширина = 0;
	Элементы.Месяц.РастягиватьПоГоризонтали = Истина;
	Элементы.Год.РастягиватьПоГоризонтали = Истина;
	Элементы.ГодАрхив.РастягиватьПоГоризонтали = Истина;
	
	Элементы.Задача.АвтоМаксимальнаяШирина = Истина;
	Элементы.Организация.АвтоМаксимальнаяШирина = Истина;
	
КонецПроцедуры

#КонецОбласти

