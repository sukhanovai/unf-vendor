
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	
	ВывестиБаннеры();
	
	Если Объект.Ссылка.Пустая() Тогда
		ПриСозданииПриЧтенииНаСервере();
	КонецЕсли;
	
	Если Параметры.Свойство("НастройкаПроцессов") Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПроцессы;
	КонецЕсли;
	
	Если Параметры.Свойство("Страница")
		И НЕ ПустаяСтрока(Параметры.Страница)
		И НЕ Элементы.Найти(Параметры.Страница) = Неопределено Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы[Параметры.Страница];
	КонецЕсли;
	
	АдаптацияМобильныйКлиент();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	
	ПриСозданииПриЧтенииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ОбновитьСостояния();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_ВидыЗаказовПокупателей", Объект.Ссылка, ЭтотОбъект);
	ОбновитьПроцессы();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	СохранитьДанныеПроцессов(ТекущийОбъект);
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПорядокСостояний.Ссылка КАК Ссылка,
	|	ПорядокСостояний.НомерСтроки КАК НомерСтроки,
	|	ПорядокСостояний.Состояние КАК Состояние,
	|	СостоянияЗаказовПокупателей.ПометкаУдаления КАК ПометкаУдаления,
	|	СостоянияЗаказовПокупателей.Наименование КАК Наименование,
	|	СостоянияЗаказовПокупателей.Цвет КАК Цвет,
	|	СостоянияЗаказовПокупателей.Предопределенный КАК Предопределенный,
	|	СостоянияЗаказовПокупателей.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.ВидыЗаказовПокупателей.ПорядокСостояний КАК ПорядокСостояний
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СостоянияЗаказовПокупателей КАК СостоянияЗаказовПокупателей
	|		ПО ПорядокСостояний.Состояние = СостоянияЗаказовПокупателей.Ссылка
	|ГДЕ ПорядокСостояний.Ссылка = &ВидЗаказа";
	
	Запрос.УстановитьПараметр("ВидЗаказа", Объект.Ссылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Состояние Из Результат Цикл
		
		СостояниеВТаблице = Объект.ПорядокСостояний.НайтиСтроки(Новый Структура("Состояние", Состояние.Состояние));
		
		Для Каждого НайденноеСостояние Из СостояниеВТаблице Цикл
			
			Если Состояние.Цвет.Получить() <> Неопределено Тогда
				НайденноеСостояние.Цвет = Состояние.Цвет.Получить();
			КонецЕсли;
			
			НайденноеСостояние.ПометкаУдаления = Состояние.ПометкаУдаления;
			НайденноеСостояние.НаименованиеСостояния = Состояние.Наименование;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект, "Объект.Комментарий");
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьДоставкуПриИзменении(Элемент)
	
	Объект.НеИспользоватьДоставку = Не ВключитьДоставку;
	Модифицированность = Истина;
	
	Если Объект.НеИспользоватьДоставку Тогда
		Объект.СостояниеОжидаетОтгрузки = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.ПустаяСсылка");
		Объект.СостояниеОтгружен = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.ПустаяСсылка");
		Объект.СостояниеДоставлен = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.ПустаяСсылка");
	КонецЕсли;
	
	УстановитьФлагиМаршрутныеЛисты();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПорядокСостояний

&НаКлиенте
Процедура ПорядокСостоянийПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьДоступностьКоманд(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийПриНаведении(Элемент, Строка, Поле)
	
	Если Строка = Неопределено Тогда
		Если ТипЗнч(Элемент.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			Возврат;
		КонецЕсли;
		ДанныеСтроки = Элемент.ТекущиеДанные;
	ИначеЕсли ТипЗнч(Строка) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		Возврат;
	Иначе
		ДанныеСтроки = Объект.ПорядокСостояний.НайтиПоИдентификатору(Строка);
	КонецЕсли;
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьДоступностьКоманд(ДанныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Элемент.ТекущиеДанные <> Неопределено
		И Элемент.ТекущиеДанные.Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен")
		И Копирование Тогда
		Отказ = Истина;
		Возврат
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Или Не ЗначениеЗаполнено(ТекДанные.Состояние) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеВыделенныхСостояний = ДанныеВыделенныхСостояний();
	Для Каждого ДанныеСостояния Из ДанныеВыделенныхСостояний Цикл
		
		Если ДанныеСостояния.Состояние = Объект.СостояниеЗаявки Тогда
			ПредупреждениеОбИспользованииЗаявокДляСостояния(ДанныеСостояния.НаименованиеСостояния);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
	ОтветОтСервера = ПорядокСостоянийПередУдалениемНаСервере();
	Если ОтветОтСервера.ЕстьЗаявки Тогда
		ПредупреждениеОбИспользованииЗаявокДляСостояния(ОтветОтСервера.ПредставлениеСостояния);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ЗапрещеноИзменениеПорядка = Ложь;
	
	СтрокаПорядкаСостояний = Объект.ПорядокСостояний.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	Если СтрокаПорядкаСостояний <> Неопределено
		И СтрокаПорядкаСостояний.Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен") Тогда
		
		ЗапрещеноИзменениеПорядка = Истина;
	КонецЕсли;
	
	Если Не ЗапрещеноИзменениеПорядка И Строка <> Неопределено Тогда
		СтрокаПорядкаСостояний = Объект.ПорядокСостояний.НайтиПоИдентификатору(Строка);
		Если СтрокаПорядкаСостояний <> Неопределено
			И СтрокаПорядкаСостояний.Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен") Тогда
			
			ЗапрещеноИзменениеПорядка = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗапрещеноИзменениеПорядка Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийСостояниеОткрытие(Элемент, СтандартнаяОбработка)
	ТекущееСостояние = Элементы.ПорядокСостояний.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущееСостояние.Состояние) Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(,ТекущееСостояние.Состояние);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийПослеУдаления(Элемент)
	
	ДобавитьСостояниеЗавершен();
	ОбновитьПроцессы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийСостояниеАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ПорядокСостояний.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено И НЕ ЗначениеЗаполнено(ТекущаяСтрока.Состояние) Тогда
		ПараметрыПолученияДанных.Вставить("ТекущееНаименование", ТекущаяСтрока.НаименованиеСостояния);
	КонецЕсли;
	
	ПараметрыПолученияДанных.Вставить("ОбъектПолученияДанных", "СостоянияЗаказовПокупателей");
	РаботаСВидамиЗаказовКлиент.СостояниеАвтоПодбор(
	Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПорядокСостоянийСостояниеОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	ОбработатьИзменениеСостоянияВТаблице(ВыбранноеЗначение, Элемент.ТекстРедактирования, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийСостояниеОчистка(Элемент, СтандартнаяОбработка)
	
	ОбработатьИзменениеСостоянияВТаблице("", "", СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийЦветСостояниеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	РаботаСВидамиЗаказовКлиент.НачалоВыбораЦветаИзПорядкаСостояний(ЭтаФорма, "Цвет", СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийПриИзменении(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПорядокСостоянийПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийСостояниеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ОтображатьСостоянияЗаявок");
	ОткрытьФорму("Справочник.СостоянияЗаказовПокупателей.Форма.ФормаСписка",ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		
		ТекущаяСтрокаСостояния = Элементы.ПорядокСостояний.ТекущиеДанные;
		ИндексТекущейСтроки = Объект.ПорядокСостояний.Индекс(ТекущаяСтрокаСостояния);
		
		Если ИндексТекущейСтроки = Объект.ПорядокСостояний.Количество() - 1 Тогда
			Объект.ПорядокСостояний.Сдвинуть(ИндексТекущейСтроки, -1);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокСостоянийСостояниеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПорядокСостояний.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.ПустаяСсылка") Тогда
		ТекущиеДанные.Изменено = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПроцессы

&НаКлиенте
Процедура ПроцессыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент <> Элементы.ПроцессыНастройкаАссистента Или ТолькоПросмотрЗадач Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Процессы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработатьЗакрытиеФормыЗадачи", ЭтотОбъект);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторГруппы", ДанныеСтроки.ИдентификаторГруппыАссистента);
	ОткрытьФорму(ДанныеСтроки.ИмяФормыЗадачиАссистента, ПараметрыФормы, , , , , ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроцессыПриИзменении(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущаяКолонка = Элемент.ТекущийЭлемент;
	ТекущаяСтрока = Элемент.ТекущаяСтрока;
	Если ТекущиеДанные = Неопределено Или ТекущаяКолонка = Неопределено Или ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = ТекущаяКолонка.Имя;
	Если Не СтрНачинаетсяС(ИмяЭлемента, "ПроцессыИспользуетсяДляСостояния_") Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = Сред(ИмяЭлемента, СтрДлина("ПроцессыИспользуетсяДляСостояния_") + 1);
	Если ИмяЭлемента = Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно.Имя Тогда
		ЗначениеФлага = ТекущиеДанные.ИспользуетсяДляСостояния_ЗавершенУспешно;
	ИначеЕсли ИмяЭлемента = Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенОтменен.Имя Тогда
		ЗначениеФлага = ТекущиеДанные.ИспользуетсяДляСостояния_ЗавершенОтменен;
	Иначе
		ЗначениеФлага = ТекущиеДанные[ИмяРеквизитаКолонкиСостояния(, ИдентификаторСтроки, ЭтотОбъект)];
	КонецЕсли;
	
	Если ТекущиеДанные.ТипНастройки = "СостояниеОжидаетОтгрузки"
		Или ТекущиеДанные.ТипНастройки = "СостояниеОтгружен"
		Или ТекущиеДанные.ТипНастройки = "СостояниеДоставлен" Тогда
		
		ОбработатьИзменениеФлагаМаршрутныхЛистов(ТекущиеДанные, ИдентификаторСтроки, ЗначениеФлага);
		
	ИначеЕсли ТекущиеДанные.ТипНастройки = "ОбязательноЗаполнятьПолеПричинаОтменыТовара" Тогда
		
		ОбработатьИзменениеФлагаОбязательноЗаполнитьПричинуОтмены(ИмяЭлемента, ТекущаяСтрока, ЗначениеФлага);
		
	ИначеЕсли ТекущиеДанные.ТипНастройки = "ХранитьИсториюИзменений" Тогда
		
		ОбработатьИзменениеФлагаИсторияИзменений(ТекущиеДанные, ЗначениеФлага);
		
	ИначеЕсли ТекущиеДанные.ТипНастройки = "ЗапрещатьИзменениеДанныхПрошлыхПериодов" Тогда
		
		ОбработатьИзменениеФлагаДатыЗапретаИзменений(ИмяЭлемента, ТекущиеДанные);
		
	ИначеЕсли ТекущиеДанные.ТипНастройки = "ЗапрещатьЗавершениеНеотгруженныхЗаказов" Тогда
		
		ОбработатьИзменениеФлагаЗапретЗавершения();
		
	ИначеЕсли ТекущиеДанные.ТипНастройки = "Заявка" Тогда
		
		ОбработатьИзменениеФлагаЗаявки(ИмяЭлемента, ИдентификаторСтроки, ТекущаяСтрока, ЗначениеФлага);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

