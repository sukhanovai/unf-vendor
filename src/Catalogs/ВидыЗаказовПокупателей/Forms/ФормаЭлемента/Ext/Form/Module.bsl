Функция ЕстьЗаявкиВСостоянии(ВидЗаказа, Состояние)
	
	Возврат РаботаСЗаявками.ЕстьЗаказыВСостоянии(ВидЗаказа, Состояние, Истина);
	
КонецФункции

&НаСервере
Функция НажатиеФлагСостояниеЗаявкиНаСервере(Знач ЗаявкиБылиВключены, Знач ИндексСостояния)
	
	Результат = Новый Структура;
	Результат.Вставить("ИзменениеВозможно", Истина);
	Результат.Вставить("РезультатПроверки", Новый Структура);
	
	Ответ = РаботаСЗаявками.ПроверкаВозможностиИзмененияИспользованияЗаявокДляСостояния(
	ЗаявкиБылиВключены, Объект, ИндексСостояния);
	
	Если Не Ответ.ИзменениеВозможно Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Результат.РезультатПроверки, Ответ, Ложь);
		Результат.Вставить("ИзменениеВозможно", Ложь);
		Возврат Результат;
	КонецЕсли;
	
	Если ЗаявкиБылиВключены Тогда
		ИндексСостояния = ИндексСостояния - 1;
	КонецЕсли;
	
	КоличествоСостояний = Объект.ПорядокСостояний.Количество();
	КоличествоСостоянийЗавершения = 2;
	Если ИндексСостояния >= КоличествоСостояний - 1 Тогда
		ИндексСостояния = КоличествоСостояний - КоличествоСостоянийЗавершения;
	КонецЕсли;
	
	Если ИндексСостояния < 0 Тогда
		Состояние = Неопределено;
	Иначе
		Состояние = Объект.ПорядокСостояний[ИндексСостояния].Состояние;
	КонецЕсли;
	
	Объект.СостояниеЗаявки = Состояние;
	УстановитьФлагиСостояниеЗаявки();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеМетодыДляБыстройРаботы

&НаКлиентеНаСервереБезКонтекста
Функция ДействиеПоТипуНастройки(ТипНастройки, Форма)
	
	Возврат Форма.Процессы.НайтиСтроки(Новый Структура("ТипНастройки", ТипНастройки))[0];
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НомерСтрокиСостояния(Состояние, Форма)
	
	Состояния = Форма.Объект.ПорядокСостояний.НайтиСтроки(Новый Структура("Состояние", Состояние));
	Если Состояния.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Состояния[0].НомерСтроки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяРеквизитаКолонкиСостояния(Состояние = Неопределено, НомерСтроки = Неопределено, Форма)
	
	Если НомерСтроки = Неопределено Тогда
		
		НомерСтроки = НомерСтрокиСостояния(Состояние, Форма);
		Если НомерСтроки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтрШаблон("ИспользуетсяДляСостояния_%1", НомерСтроки);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьФлагПоДаннымСостояния(Действие, ЗначениеФлага, ДанныеСостояния, Форма)
	
	Если ДанныеСостояния.Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен") Тогда
		Действие.ИспользуетсяДляСостояния_ЗавершенУспешно = ЗначениеФлага;
		Действие.ИспользуетсяДляСостояния_ЗавершенОтменен = ЗначениеФлага;
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаКолонкиСостояния = ИмяРеквизитаКолонкиСостояния(ДанныеСостояния.Состояние, ДанныеСостояния.НомерСтроки, Форма);
	Если ИмяРеквизитаКолонкиСостояния = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Действие[ИмяРеквизитаКолонкиСостояния] = ЗначениеФлага;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьФлагПоСостоянию(Действие, ЗначениеФлага, Состояние, Форма)
	
	Если Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен") Тогда
		Действие.ИспользуетсяДляСостояния_ЗавершенУспешно = ЗначениеФлага;
		Действие.ИспользуетсяДляСостояния_ЗавершенОтменен = ЗначениеФлага;
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаКолонкиСостояния = ИмяРеквизитаКолонкиСостояния(Состояние, , Форма);
	Если ИмяРеквизитаКолонкиСостояния = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Действие[ИмяРеквизитаКолонкиСостояния] = ЗначениеФлага;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьФлагПоНомеруСтроки(Действие, ЗначениеФлага, НомерСтроки, Форма)
	
	ИмяРеквизитаКолонкиСостояния = ИмяРеквизитаКолонкиСостояния(, НомерСтроки, Форма);
	Если ИмяРеквизитаКолонкиСостояния = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Действие[ИмяРеквизитаКолонкиСостояния] = ЗначениеФлага;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВсеПредыдущиеФлаги(Действие, ЗначениеФлага, Форма, ИмяКолонки = Неопределено, Состояние = Неопределено, Включая = Истина)
	
	Если ИмяКолонки = Неопределено Тогда
		
		Если Состояние = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
			ИмяКолонки = Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно.Имя;
		Иначе
			
			НомерСтроки = НомерСтрокиСостояния(Состояние, ЭтотОбъект);
			Если НомерСтроки = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			ИмяКолонки = "ПроцессыИспользуетсяДляСостояния_" + НомерСтроки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого Колонка Из Элементы.Процессы.ПодчиненныеЭлементы Цикл
		
		Если Колонка = Элементы.ГруппаЗаголовков Тогда
			Продолжить;
		КонецЕсли;
		
		Если Колонка.Имя <> ИмяКолонки Или Колонка.Имя = ИмяКолонки И Включая Тогда
			
			НаименованиеПоля = Сред(Колонка.ПутьКДанным, СтрДлина("Процессы.") + 1);
			Действие[НаименованиеПоля] = ЗначениеФлага;
			
		КонецЕсли;
		
		Если Колонка.Имя = ИмяКолонки Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВсеПоследующиеФлаги(Действие, ЗначениеФлага, Форма, ИмяКолонки = Неопределено, Состояние = Неопределено, Включая = Истина)
	
	Если ИмяКолонки = Неопределено Тогда
		
		Если Состояние = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
			ИмяКолонки = Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно.Имя;
		Иначе
			
			НомерСтроки = НомерСтрокиСостояния(Состояние, ЭтотОбъект);
			Если НомерСтроки = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			ИмяКолонки = "ПроцессыИспользуетсяДляСостояния_" + НомерСтроки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НайденаТекущаяКолонка = Ложь;
	Для Каждого Колонка Из Элементы.Процессы.ПодчиненныеЭлементы Цикл
		
		Если Колонка.Имя = ИмяКолонки Тогда
			НайденаТекущаяКолонка = Истина;
		КонецЕсли;
		
		Если Не НайденаТекущаяКолонка Тогда
			Продолжить;
		КонецЕсли;
		
		Если Колонка.Имя <> ИмяКолонки Или Колонка.Имя = ИмяКолонки И Включая Тогда
			
			НаименованиеПоля = Сред(Колонка.ПутьКДанным, СтрДлина("Процессы.") + 1);
			Действие[НаименованиеПоля] = ЗначениеФлага;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеФлагаДействия(Действие, ДанныеСостояния, Форма)
	
	Если ДанныеСостояния.Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен") Тогда
		Возврат Действие.ИспользуетсяДляСостояния_ЗавершенУспешно;
	КонецЕсли;
	
	ИмяРеквизитаКолонкиСостояния = ИмяРеквизитаКолонкиСостояния(, ДанныеСостояния.НомерСтроки, Форма);
	Если ИмяРеквизитаКолонкиСостояния = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Действие[ИмяРеквизитаКолонкиСостояния];
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьФлагиДействий(Действия, ЗначениеФлага, Форма)
	
	Если ТипЗнч(Действия) = Тип("Массив") Тогда
		ДействияСписок = Действия;
	Иначе
		ДействияСписок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Действия);
	КонецЕсли;
	
	Для Каждого Действие Из ДействияСписок Цикл
		Для Каждого ДанныеСостояния Из Форма.Объект.ПорядокСостояний Цикл
			УстановитьФлагПоДаннымСостояния(Действие, ЗначениеФлага, ДанныеСостояния, Форма);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ПроцессыВида(ИмяТаблицы)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПроцессов(ИмяТаблицы);
	Запрос.УстановитьПараметр("ВидЗаказа", Объект.Ссылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаПроцессов(ИмяТаблицы)
	
	Если ИмяТаблицы = "ОбработкаПроверкиЗаполнения" Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПроцессыСостоянийЗаказов.Ссылка КАК Ссылка,
		|	ПроцессыОбработкаПроверкиЗаполнения.НомерСтроки КАК НомерСтроки,
		|	ПроцессыОбработкаПроверкиЗаполнения.Состояние КАК Состояние,
		|	ПроцессыОбработкаПроверкиЗаполнения.ИмяРеквизита КАК ИмяРеквизита,
		|	ПроцессыОбработкаПроверкиЗаполнения.ВариантЗавершения КАК ВариантЗавершения
		|ИЗ
		|	Справочник.ПроцессыСостоянийЗаказов КАК ПроцессыСостоянийЗаказов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПроцессыСостоянийЗаказов.ОбработкаПроверкиЗаполнения КАК ПроцессыОбработкаПроверкиЗаполнения
		|		ПО (ПроцессыСостоянийЗаказов.Ссылка = ПроцессыОбработкаПроверкиЗаполнения.Ссылка)
		|ГДЕ
		|	ПроцессыСостоянийЗаказов.ВидЗаказа = &ВидЗаказа
		|	И ПроцессыСостоянийЗаказов.Предмет = ""ЗаказПокупателя""";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПроцессыСостоянийЗаказов.Ссылка КАК Ссылка,
		|	ПроцессыОбработкаПроведения.НомерСтроки КАК НомерСтроки,
		|	ПроцессыОбработкаПроведения.Состояние КАК Состояние,
		|	ПроцессыОбработкаПроведения.ВариантЗавершения КАК ВариантЗавершения,
		|	ПроцессыОбработкаПроведения.Свойство КАК Свойство
		|ИЗ
		|	Справочник.ПроцессыСостоянийЗаказов КАК ПроцессыСостоянийЗаказов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПроцессыСостоянийЗаказов.ОбработкаПроведения КАК ПроцессыОбработкаПроведения
		|		ПО ПроцессыСостоянийЗаказов.Ссылка = ПроцессыОбработкаПроведения.Ссылка
		|ГДЕ
		|	ПроцессыСостоянийЗаказов.ВидЗаказа = &ВидЗаказа
		|	И ПроцессыСостоянийЗаказов.Предмет = ""ЗаказПокупателя""";
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

&НаСервере
Процедура АдаптацияМобильныйКлиент()
	
	Если Не ЭтоМобильныйКлиент Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	Элементы.СтраницаПроцессы.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(Объект.СостояниеЗаявки) Тогда
		
		Элементы.Баннер.Видимость = Истина;
		Элементы.ПорядокСостояний.ТолькоПросмотр = Истина;
		
		Элементы.ПорядокСостоянийДобавитьВсе.Доступность = Ложь;
		Элементы.КнопкиВверхВниз.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьГлобальныеНастройки()
	
	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();
	
	НесколькоВидовЗаказов = ПолучитьФункциональнуюОпцию("ИспользоватьВидыЗаказовПокупателей");
	ИспользоватьМаршрутныеЛисты = ПолучитьФункциональнуюОпцию("ИспользоватьМаршрутныеЛисты");
	ОтображатьЗадачиПроизводства = ПолучитьФункциональнуюОпцию("ИспользоватьПодсистемуПроизводство");
	ОтображатьЗадачиПоставщиков = ПолучитьФункциональнуюОпцию("ИспользоватьПодсистемуЗакупки");
	ОтображатьЗадачиCRM = ПолучитьФункциональнуюОпцию("ИспользоватьПодсистемуCRM");
	ИспользоватьПодсистемуРаботы =  ПолучитьФункциональнуюОпцию("ИспользоватьПодсистемуРаботы");
	ИспользоватьПроцессы = ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыСостояний");
	ЗаявкиДоступны = РаботаСЗаявками.ЗаявкиДоступны();
	ТолькоПросмотрЗадач = НЕ Пользователи.ЭтоПолноправныйПользователь();
	
	РазрешеноИзменениеСостояния = ПравоДоступа("Изменение", Метаданные.Справочники.СостоянияЗаказовПокупателей);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииПриЧтенииНаСервере()
	
	СохранитьГлобальныеНастройки();
	
	Если Не НесколькоВидовЗаказов И Объект.НеИспользоватьДоставку Тогда
		Объект.НеИспользоватьДоставку = Ложь;
	КонецЕсли;
	
	РаботаСВидамиЗаказов.ФормаЭлементаВидаЗаказаПриСозданииНаСервере(ЭтотОбъект);
	
	ОбновитьПроцессы();
	
	УправлениеФормой();
	
	УстановитьУсловноеОформлениеСостоянийВЦвет();
	СостоянияЗаказов.УстановитьУсловноеОформлениеСостоянияЗавершен(
	УсловноеОформление,
	Справочники.СостоянияЗаказовПокупателей.Завершен,
	"Объект.ПорядокСостояний.Состояние",
	"ПорядокСостояний");
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	Элементы.ПорядокСостоянийКонтекстноеМенюПометитьНаУдаление.Видимость = РазрешеноИзменениеСостояния;
	Элементы.ПорядокСостоянийПометитьНаУдаление.Видимость = РазрешеноИзменениеСостояния;
	Элементы.ПорядокСостоянийСостояние.КнопкаВыбора = НесколькоВидовЗаказов;
	
	Элементы.ВключитьДоставку.Видимость = ИспользоватьМаршрутныеЛисты;
	Элементы.СтраницаПроцессы.Видимость = ИспользоватьПроцессы;
	
	Элементы.ПроцессыНастройкаАссистента.Гиперссылка = Не ТолькоПросмотрЗадач;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиБаннеры()
	
	ПараметрыВажногоСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщения.Скрываемый = Ложь;
	ПараметрыВажногоСообщения.ТипСообщения = "Информация";
	ПараметрыВажногоСообщения.Сообщение = НСтр("ru = 'Изменение списка состояний недоступно на мобильном устройстве. Для изменения состояний войдите через браузер или настольное приложение'");
	ПараметрыВажногоСообщения.КраткоеПредставление = НСтр("ru = 'Недоступно в мобильном клиенте'");
	ОбщегоНазначения.ВставитьВажноеСообщение(ЭтотОбъект, ПараметрыВажногоСообщения, Элементы.Баннер);
	
	ОбщегоНазначения.ВывестиСтатусыИВажныеСообщенияНаФорму(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаОповещенияНаСервере(Знач ИмяСобытия, Знач Параметр)
	
	Если ИмяСобытия = "Запись_СостоянияЗаказовПокупателей" Тогда
		
		ЭтоСостояниеДляЗаявок = ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("ЭтоСостояниеДляЗаявок");
		
		Если ЭтоСостояниеДляЗаявок Тогда
			
			Объект.СостояниеЗаявки = Параметр.Ссылка;
			СтрокаТЗ = Объект.ПорядокСостояний.Вставить(0);
			СтрокаТЗ.Состояние = Объект.СостояниеЗаявки;
			
			Модифицированность = Ложь;
			Записать();
			
		КонецЕсли;
		
		ОбработатьЗаписьСостояния(Параметр);
		УстановитьУсловноеОформлениеСостоянийВЦвет();
		
		Если ЭтоСостояниеДляЗаявок Тогда
			ОбновитьПроцессы();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьЗаписьСостояния(ПараметрЗаписи)
	
	Если ТипЗнч(ПараметрЗаписи) = Тип("Структура") И Не ПараметрЗаписи.Свойство("Ссылка") Тогда
		Возврат;
	КонецЕсли;
	
	Состояние = ПараметрЗаписи.Ссылка;
	ДанныеСостояния = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Состояние, "Ссылка, Наименование, ПометкаУдаления, Цвет");
	
	Если ДанныеСостояния = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСостояния = Объект.ПорядокСостояний.НайтиСтроки(Новый Структура("Состояние", ДанныеСостояния.Ссылка));
	Для Каждого НайденноеСостояние Из НайденныеСостояния Цикл
		
		НайденноеСостояние.Состояние = ДанныеСостояния.Ссылка;
		НайденноеСостояние.ПометкаУдаления = ДанныеСостояния.ПометкаУдаления;
		
		Если ДанныеСостояния.Цвет <> Неопределено Тогда
			НайденноеСостояние.Цвет = ДанныеСостояния.Цвет.Получить();
		КонецЕсли;
		
		НайденноеСостояние.НаименованиеСостояния = ДанныеСостояния.Наименование;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояния()
	
	УдаляемыеСостояния = Новый Массив;
	Для Каждого Состояние Из Объект.ПорядокСостояний Цикл
		Если НЕ ЗначениеЗаполнено(Состояние.НаименованиеСостояния) Тогда
			УдаляемыеСостояния.Добавить(Состояние);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Состояние Из УдаляемыеСостояния Цикл
		Объект.ПорядокСостояний.Удалить(Состояние);
	КонецЦикла;
	
	Для Каждого Состояние Из Объект.ПорядокСостояний Цикл
		
		Если НЕ Состояние.Изменено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Если ЗначениеЗаполнено(Состояние.Состояние) Тогда
				СостояниеОбъект = Состояние.Состояние.ПолучитьОбъект();
				СостояниеОбъект.Заблокировать();
			Иначе
				СостояниеОбъект = Справочники.СостоянияЗаказовПокупателей.СоздатьЭлемент();
				СостояниеОбъект.Наименование = Состояние.НаименованиеСостояния;
			КонецЕсли;
		Исключение
			ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СостояниеОбъект);
		КонецПопытки;
		
		СостояниеОбъект.ПометкаУдаления = Состояние.ПометкаУдаления;
		СостояниеОбъект.Цвет = Новый ХранилищеЗначения(Состояние.Цвет);
		Попытка
			СостояниеОбъект.Записать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СостояниеОбъект);
		КонецПопытки;
		
		СостояниеОбъект.Разблокировать();
		Состояние.Состояние = СостояниеОбъект.Ссылка;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти