#Область СлужебныеПроцедурыИФункции

#Область ПорядокСостояний

&НаСервере
Процедура ПорядокСостоянийПриИзмененииНаСервере()
	
	СдвинутьСостояниеЗавершен();
	ОбновитьПроцессы();
	УстановитьЦветНовыхСостоянийПоУмолчанию();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЦветНовыхСостоянийПоУмолчанию()
	
	ЦветаИзменены = Ложь;
	Для Каждого ДанныеСостояния Из Объект.ПорядокСостояний Цикл
		
		Если Не ЗначениеЗаполнено(ДанныеСостояния.Состояние) И ДанныеСостояния.Цвет = ЧерныйЦвет Тогда
			
			ДанныеСостояния.Цвет = ЦветаПалитры.Серый;
			ЦветаИзменены = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЦветаИзменены Тогда
		УстановитьУсловноеОформлениеСостоянийВЦвет();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СдвинутьСостояниеЗавершен()
	
	СтрокиТЧ = Объект.ПорядокСостояний.НайтиСтроки(
	Новый Структура("Состояние", Справочники.СостоянияЗаказовПокупателей.Завершен));
	Если СтрокиТЧ.Количество() = 0 Тогда
		
		ДанныеСостояния = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Справочники.СостоянияЗаказовПокупателей.Завершен, "Представление,Цвет");
		
		СтрокаТЧ = Объект.ПорядокСостояний.Добавить();
		СтрокаТЧ.Состояние = Справочники.СостоянияЗаказовПокупателей.Завершен;
		СтрокаТЧ.НаименованиеСостояния = ДанныеСостояния.Представление;
		СтрокаТЧ.Цвет = ДанныеСостояния.Цвет;
		Возврат;
		
	КонецЕсли;
	
	ИндексСтроки = Объект.ПорядокСостояний.Индекс(СтрокиТЧ[0]);
	Объект.ПорядокСостояний.Сдвинуть(ИндексСтроки, Объект.ПорядокСостояний.Количество() - ИндексСтроки - 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСостоянияВТаблице(ВыбранноеЗначение, ТекстРедактирования, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ПорядокСостояний.ТекущиеДанные;
	ИндексСостояния = Объект.ПорядокСостояний.Индекс(ТекущиеДанные);
	
	Если Не Объект.Ссылка.Пустая() И ЗначениеЗаполнено(ТекущиеДанные.Состояние) Тогда
		
		Если ТекущиеДанные.Состояние = Объект.СостояниеЗаявки Тогда
			
			ПредупреждениеОбИспользованииЗаявокДляСостояния(ТекущиеДанные.НаименованиеСостояния);
			СтандартнаяОбработка = Ложь;
			Возврат;
			
		КонецЕсли;
		
		НомерСостоянияЗаявки = НомерСостояния(Объект.ПорядокСостояний, Объект.СостояниеЗаявки);
		Если ИндексСостояния + 1 <= НомерСостоянияЗаявки Тогда
			
			ЕстьЗаявки = ЕстьЗаявкиВСостоянии(Объект.Ссылка, ТекущиеДанные.Состояние);
			Если ЕстьЗаявки Тогда
				
				ПредупреждениеОбИспользованииЗаявокДляСостояния(ТекущиеДанные.НаименованиеСостояния);
				СтандартнаяОбработка = Ложь;
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьДанныеСостояния(ВыбранноеЗначение, ТекстРедактирования, ИндексСостояния, СтандартнаяОбработка);
	Если НЕ СтандартнаяОбработка Тогда
		Элементы.ПорядокСостояний.ЗакончитьРедактированиеСтроки(Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НомерСостояния(ПорядокСостояний, Состояние)
	
	Если Не ЗначениеЗаполнено(Состояние) Тогда
		Возврат 0;
	КонецЕсли;
	
	Список = ПорядокСостояний.НайтиСтроки(Новый Структура("Состояние", Состояние));
	Если Список.Количество() Тогда
		Возврат Список[0].НомерСтроки;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Функция ПорядокСостоянийПередУдалениемНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьЗаявки", Ложь);
	Результат.Вставить("ПредставлениеСостояния", "");
	
	Состояния = Новый Массив;
	ДанныеВыделенныхСостояний = ДанныеВыделенныхСостоянийНаСервере();
	Для Каждого ДанныеСостояния Из ДанныеВыделенныхСостояний Цикл
		Состояния.Добавить(ДанныеСостояния.Состояние);
	КонецЦикла;
	
	НаличиеЗаявок = РаботаСЗаявками.НаличиеЗаказовПоСостояниям(Объект.Ссылка, Состояния, Истина);
	Для Каждого КлючЗначение Из НаличиеЗаявок Цикл
		Если КлючЗначение.Значение.ЕстьЗаказ Тогда
			Результат.ЕстьЗаявки = Истина;
			Результат.ПредставлениеСостояния = КлючЗначение.Значение.Представление;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ДанныеВыделенныхСостояний()
	
	Результат = Новый Массив;
	
	Для Каждого Идентификатор Из Элементы.ПорядокСостояний.ПолучитьСтрокиДляОбработки() Цикл
		ДанныеСостояния = Объект.ПорядокСостояний.НайтиПоИдентификатору(Идентификатор);
		Результат.Добавить(ДанныеСостояния);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДанныеВыделенныхСостоянийНаСервере()
	
	Результат = Новый Массив;
	
	Для Каждого Идентификатор Из Элементы.ПорядокСостояний.ПолучитьСтрокиДляОбработки() Цикл
		ДанныеСостояния = Объект.ПорядокСостояний.НайтиПоИдентификатору(Идентификатор);
		Результат.Добавить(ДанныеСостояния);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьСостояниеЗавершен()
	
	Если Объект.ПорядокСостояний.Количество() = 0 Тогда
		НоваяСтрока = Объект.ПорядокСостояний.Добавить();
		ОбновитьДанныеСостояния(Справочники.СостоянияЗаказовПокупателей.Завершен, "", 0, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВсеНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияЗаказовПокупателей.Ссылка КАК Состояние,
		|	СостоянияЗаказовПокупателей.Наименование КАК Наименование,
		|	ВЫБОР
		|		КОГДА СостоянияЗаказовПокупателей.Ссылка = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Порядок,
		|	СостоянияЗаказовПокупателей.Цвет КАК Цвет
		|ИЗ
		|	Справочник.СостоянияЗаказовПокупателей КАК СостоянияЗаказовПокупателей
		|ГДЕ
		|	СостоянияЗаказовПокупателей.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	СостоянияЗаказовПокупателей.Наименование";
	
	Состояния = Запрос.Выполнить().Выгрузить();
	
	ИндексСостояния = 0;
	Для Каждого ДанныеСостояния Из Состояния Цикл
		
		СостояниеУжеВТаблице = Объект.ПорядокСостояний.НайтиСтроки(Новый Структура("Состояние", ДанныеСостояния.Состояние));
		Если СостояниеУжеВТаблице.Количество() <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НовоеСостояние = Объект.ПорядокСостояний.Вставить(ИндексСостояния);
		ИндексСостояния = ИндексСостояния + 1;
		НовоеСостояние.Состояние = ДанныеСостояния.Состояние;
		НовоеСостояние.НаименованиеСостояния = ДанныеСостояния.Наименование;
		НовоеСостояние.Цвет = ДанныеСостояния.Цвет.Получить();
		
	КонецЦикла;
	
	УстановитьУсловноеОформлениеСостоянийВЦвет();
	ОбновитьПроцессы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьСтрокуТЧ(Смещение)
	
	ТекущиеДанные = Элементы.ПорядокСостояний.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПорядка = Объект.ПорядокСостояний.НайтиПоИдентификатору(Элементы.ПорядокСостояний.ТекущаяСтрока);
	Если СтрокаПорядка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаПорядка.НомерСтроки + Смещение = 0
		Или СтрокаПорядка.НомерСтроки + Смещение > Объект.ПорядокСостояний.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Если Смещение > 0
		И Объект.ПорядокСостояний[СтрокаПорядка.НомерСтроки+Смещение-1].Состояние = 
		ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен")Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ПорядокСостояний.Сдвинуть(СтрокаПорядка.НомерСтроки-1, Смещение);
	УстановитьДоступностьКоманд(ТекущиеДанные);
	ОбновитьПроцессы();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКоманд(ДанныеСтроки)
	
	ЭтоПоследнееСостояние = Объект.ПорядокСостояний.Индекс(ДанныеСтроки) = Объект.ПорядокСостояний.Количество() - 1;
	СостояниеЗаполнено = ЗначениеЗаполнено(ДанныеСтроки.Состояние);
	ЭтоЗавершен = (ДанныеСтроки.Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен"));
	
	Элементы.ПорядокСостоянийПереместитьВниз.Доступность = Не ЭтоПоследнееСостояние;
	Элементы.ПорядокСостоянийПереместитьВверх.Доступность = Не ЭтоЗавершен;
	Элементы.ПорядокСостоянийКонтекстноеМенюПометитьНаУдаление.Доступность = Не ЭтоЗавершен И СостояниеЗаполнено;
	Элементы.ПорядокСостоянийКонтекстноеМенюУдалить.Доступность = Не (ЭтоЗавершен И ЭтоПоследнееСостояние);
	Элементы.ПорядокСостоянийПометитьНаУдаление.Доступность = Не ЭтоЗавершен И СостояниеЗаполнено;
	Элементы.ПорядокСостоянийУдалить.Доступность = Не (ЭтоЗавершен И ЭтоПоследнееСостояние);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСостояния(Ссылка, ТекстРедактирования, ИндексСостояния, СтандартнаяОбработка) 
	
	Если Ссылка = Справочники.СостоянияЗаказовПокупателей.ПустаяСсылка() Тогда
		Объект.ПорядокСостояний[ИндексСостояния].НаименованиеСостояния = ТекстРедактирования;
		Объект.ПорядокСостояний[ИндексСостояния].Изменено = Истина;
		Объект.ПорядокСостояний[ИндексСостояния].Состояние = Ссылка;
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
		
	ДанныеСостояния = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Ссылка, Наименование, ПометкаУдаления, Цвет");
	
	Если ДанныеСостояния = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ПорядокСостояний[ИндексСостояния].Состояние = ДанныеСостояния.Ссылка;
	Объект.ПорядокСостояний[ИндексСостояния].ПометкаУдаления = ДанныеСостояния.ПометкаУдаления;
	Если ДанныеСостояния.Цвет <> Неопределено Тогда
		Объект.ПорядокСостояний[ИндексСостояния].Цвет = ДанныеСостояния.Цвет.Получить();
	КонецЕсли;
	
	Объект.ПорядокСостояний[ИндексСостояния].НаименованиеСостояния = ДанныеСостояния.Наименование;
	УстановитьУсловноеОформлениеСостоянийВЦвет();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСостоянийВЦвет()
	
	УдаляемыеЭлементы = Новый Массив;
	
	Для Каждого ЭлементУсловногоОформления Из УсловноеОформление.Элементы Цикл
		Если ЭлементУсловногоОформления.ИдентификаторПользовательскойНастройки = "ЦветСостояния" Тогда
			УдаляемыеЭлементы.Добавить(ЭлементУсловногоОформления);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементУсловногоОформления Из УдаляемыеЭлементы Цикл
		УсловноеОформление.Элементы.Удалить(ЭлементУсловногоОформления);
	КонецЦикла;
	
	Если ЭтоИнтерфейсТакси Тогда
		СтильОформления = "ЦветТекста";
	Иначе
		СтильОформления = "ЦветОтметки";
	КонецЕсли;
	
	Для Каждого Состояние Из Объект.ПорядокСостояний Цикл
		
		ЦветСостояния = Состояние.Цвет;
		Если ТипЗнч(ЦветСостояния) <> Тип("Цвет") Тогда
			Если ЭтоИнтерфейсТакси Тогда
				Продолжить;
			Иначе
				ЦветСостояния = ЦветаПалитры.Серый;
			КонецЕсли;
		КонецЕсли;
		
		ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
		
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра(СтильОформления, ЦветСостояния);
		ЭлементУсловногоОформления.ИдентификаторПользовательскойНастройки = "ЦветСостояния";
		ЭлементУсловногоОформления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		ЭлементУсловногоОформления.Представление = НСтр("ru='Оформление в цвет состояния'");
		
		ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПорядокСостояний.НаименованиеСостояния");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Состояние.НаименованиеСостояния;
		
		Если ЭтоИнтерфейсТакси Тогда
			ОформляемоеПолеКД = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
			ОформляемоеПолеКД.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПорядокСостоянийНомерСтроки.Имя);
			ОформляемоеПолеКД.Использование = Истина;
			ОформляемоеПолеКД = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
			ОформляемоеПолеКД.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПорядокСостоянийСостояние.Имя);
			ОформляемоеПолеКД.Использование = Истина;
		КонецЕсли;
		ОформляемоеПолеКД = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПолеКД.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПорядокСостоянийЦветСостояния.Имя);
		ОформляемоеПолеКД.Использование = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораЦветаИзПорядкаСостоянийФрагмент(Цвет, СвойствоЦвета) Экспорт
	
	Если Цвет <> Неопределено И Цвет <> КодВозвратаДиалога.Отмена Тогда
		
		ДанныеТекущейСтроки = Элементы.ПорядокСостояний.ТекущиеДанные;
		Если ДанныеТекущейСтроки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ИндексСостояния = Объект.ПорядокСостояний.Индекс(ДанныеТекущейСтроки);
		ДанныеТекущейСтроки[СвойствоЦвета] = Цвет;
		ДанныеТекущейСтроки.Изменено = Истина;
		Модифицированность = Истина;
		УстановитьУсловноеОформлениеСостоянийВЦвет();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Процессы

#Область ОбновлениеПроцессов

&НаСервере
Процедура ОбновитьПроцессы()
	
	ОбновитьРеквизитыСостоянийПроцессов();
	ОбновитьЭлементыСостоянийПроцессов();
	ЗаполнитьСтатическийКонтентПроцессов();
	УстановитьУсловноеОформлениеНаПроцессы();
	УстановитьФлагиПроцессов();
	
	Элементы.Процессы.ТекущаяСтрока = Процессы[1].ПолучитьИдентификатор();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРеквизитыСостоянийПроцессов()
	
	ПоляТаблицы = ПолучитьРеквизиты("Процессы");
	
	ПутиУдаляемыхРеквизитов = Новый Массив;
	Для Каждого ПолеТаблицы Из ПоляТаблицы Цикл
		
		Имя = ПолеТаблицы.Имя;
		
		Если Имя <> "ЗаголовокНастройки"
			И Имя <> "ЭтоГруппа"
			И Имя <> "ИспользуетсяДляСостояния_ЗавершенУспешно"
			И Имя <> "ИспользуетсяДляСостояния_ЗавершенОтменен"
			И Имя <> "ТипНастройки"
			И Имя <> "НастройкаАссистента"
			И Имя <> "ИдентификаторГруппыАссистента"
			И Имя <> "ИмяФормыЗадачиАссистента" Тогда
			
			ПутиУдаляемыхРеквизитов.Добавить(СтрШаблон("%1.%2", ПолеТаблицы.Путь, Имя));
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого ДанныеСостояния Из Объект.ПорядокСостояний Цикл
		
		Если ДанныеСостояния.Состояние = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
			Продолжить;
		КонецЕсли;
		
		НовоеПоле = Новый РеквизитФормы(
		"ИспользуетсяДляСостояния_" + ДанныеСостояния.НомерСтроки,
		Новый ОписаниеТипов("Булево"),
		"Процессы",
		ДанныеСостояния.НаименованиеСостояния);
		
		ДобавляемыеРеквизиты.Добавить(НовоеПоле);
		
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты, ПутиУдаляемыхРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыСостоянийПроцессов()
	
	ЭлементыНаУдаление = Новый Массив;
	Для Каждого КолонкаТаблицы Из Элементы.Процессы.ПодчиненныеЭлементы Цикл
		
		Имя = КолонкаТаблицы.Имя;
		
		Если Имя <> Элементы.ГруппаЗаголовков.Имя
			И Имя <> Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно.Имя
			И Имя <> Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенОтменен.Имя Тогда
			
			ЭлементыНаУдаление.Добавить(КолонкаТаблицы);
			
		КонецЕсли;
		
	КонецЦикла;
	Для Каждого КолонкаТаблицы Из ЭлементыНаУдаление Цикл
		Элементы.Удалить(КолонкаТаблицы);
	КонецЦикла;
	
	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого ДанныеСостояния Из Объект.ПорядокСостояний Цикл
		
		Если ДанныеСостояния.Состояние = Справочники.СостоянияЗаказовПокупателей.Завершен Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьКДанным = "ИспользуетсяДляСостояния_" + ДанныеСостояния.НомерСтроки;
		
		КолонкаТаблицы = Элементы.Добавить("Процессы" + ПутьКДанным, Тип("ПолеФормы"), Элементы.Процессы);
		КолонкаТаблицы.Вид = ВидПоляФормы.ПолеФлажка;
		КолонкаТаблицы.ПутьКДанным = СтрШаблон("Процессы.%1", ПутьКДанным);
		
		Элементы.Переместить(КолонкаТаблицы, Элементы.Процессы, Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатическийКонтентПроцессов()
	
	Процессы.Очистить();
	
	Если ЗаявкиДоступны Тогда
		
		СтрокаТЗ = Процессы.Добавить();
		СтрокаТЗ.ЭтоГруппа = Истина;
		СтрокаТЗ.ТипНастройки = "РежимЗаказа";
		СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Режим заказа'");
