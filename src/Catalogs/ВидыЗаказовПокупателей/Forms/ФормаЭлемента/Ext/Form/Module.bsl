	СтрокаТЗ.ТипНастройки = "ХранитьИсториюИзменений";
	СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Хранить историю изменений (заказ покупателя, заказ-наряд)'");
	
	Если ИспользоватьМаршрутныеЛисты Тогда
		
		СтрокаТЗ = Процессы.Добавить();
		СтрокаТЗ.ЭтоГруппа = Истина;
		СтрокаТЗ.ТипНастройки = "МаршрутныеЛисты";
		СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Маршрутные листы'");
		СтрокаТЗ = Процессы.Добавить();
		СтрокаТЗ.ТипНастройки = "СостояниеОжидаетОтгрузки";
		СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Состояние ожидает отгрузки'");
		СтрокаТЗ = Процессы.Добавить();
		СтрокаТЗ.ТипНастройки = "СостояниеОтгружен";
		СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Состояние отгружен'");
		СтрокаТЗ = Процессы.Добавить();
		СтрокаТЗ.ТипНастройки = "СостояниеДоставлен";
		СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Состояние доставлен'");
		
	КонецЕсли;
	
	СтрокаТЗ = Процессы.Добавить();
	СтрокаТЗ.ЭтоГруппа = Истина;
	СтрокаТЗ.ТипНастройки = "ДашаОтправьОповещение";
