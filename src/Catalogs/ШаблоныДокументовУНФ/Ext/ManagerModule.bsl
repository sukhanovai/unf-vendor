#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает значения переданных реквизитов
//
// Параметры:
//  Ссылка - СправочникСсылка.ШаблоныДокументовУНФ - шаблон
//  Реквизиты - Строка - реквизиты через запятую
//  ТолькоИспользуемые - Булево - только используемые в шаблоне
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - реквизит
//   * Значение - ЛюбаяСсылка, Булево, Строка, Дата, Число - значение
//
Функция ЗначенияРеквизитов(Ссылка, Знач Реквизиты, ТолькоИспользуемые = Ложь) Экспорт
	
	Реквизиты = СтрРазделить(Реквизиты, ",", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныДокументовУНФЗначенияРеквизитов.Реквизит КАК Реквизит,
		|	ШаблоныДокументовУНФЗначенияРеквизитов.Значение КАК Значение
		|ИЗ
		|	Справочник.ШаблоныДокументовУНФ.ЗначенияРеквизитов КАК ШаблоныДокументовУНФЗначенияРеквизитов
		|ГДЕ
		|	ШаблоныДокументовУНФЗначенияРеквизитов.Ссылка = &Ссылка
		|	И ШаблоныДокументовУНФЗначенияРеквизитов.Реквизит В(&Реквизиты)
		|	И (НЕ &ТолькоИспользуемые
		|			ИЛИ &ТолькоИспользуемые
		|				И ШаблоныДокументовУНФЗначенияРеквизитов.Использование)";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Реквизиты", Реквизиты);
	Запрос.УстановитьПараметр("ТолькоИспользуемые", ТолькоИспользуемые);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Результат[Выборка.Реквизит] = Выборка.Значение;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли