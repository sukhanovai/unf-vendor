
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "НастройкиРМК") Тогда
		КопироватьДанныеФормы(Параметры.НастройкиРМК, НастройкиРМК);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	Закрыть(НастройкиРМК);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСклад(Команда)
	ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуВыбораСклада(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры
#КонецОбласти

#Область ПрограммныйИнтерфейс
// Процедура обрабатывает результат выбора склада
//
// Параметры:
//  Результат				 - ОпределяемыйТип.ТорговыйОбъектРМК - Выбранное значение склада.
//  ДополнительныеПараметры	 - Структура - Структура дополнительных параметров
//
&НаКлиенте
Процедура ВыборСкладаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстОшибки = НСтр("ru = ''");
	ДобавитьСкладВНастройку(Результат, ТекстОшибки);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьПредупреждение(,ТекстОшибки);
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьСкладВНастройку(ВыбранноеЗначение, ТекстОшибки)
	МассивНовыхСкладов = Новый Массив;
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	СтруктураНастроек.Вставить("ТекстОшибки", ТекстОшибки);
	ОбщегоНазначенияРМКПереопределяемый.ДобавитьСкладВСписокНастроек(НастройкиРМК.СтруктурныеЕдиницы.Выгрузить(), МассивНовыхСкладов, СтруктураНастроек);
	Для Каждого СтрокаМассива Из МассивНовыхСкладов Цикл
		НоваяСтрока = НастройкиРМК.СтруктурныеЕдиницы.Добавить();
		НоваяСтрока.СтруктурнаяЕдиница = СтрокаМассива;
	КонецЦикла;
	ТекстОшибки = СтруктураНастроек.ТекстОшибки;
КонецПроцедуры


#КонецОбласти

