&НаКлиенте
Процедура ПрисваиватьНомерКартыКНомеруТелефонаПриИзменении(Элемент)
	ПроверитьВзаимоисключенияГенерацииКодаКарты();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКомментарий(Команда)
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(
		Объект.Комментарий, ЭтотОбъект, "Объект.Комментарий");
КонецПроцедуры

&НаСервере
Процедура АдаптацияФормыТакси()

	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	Если ЭтоИнтерфейсТакси Тогда
		Элементы.Комментарий.КнопкаВыбора = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимГенерацииКодовПриИзменении(Элемент)
	ДоступнаГенерация = Объект.ТипКарты = ПредопределенноеЗначение("Перечисление.ТипыКарт.Штриховая") 
		Или Объект.ТипКарты = ПредопределенноеЗначение("Перечисление.ТипыКарт.Смешанная");
	Если НЕ ДоступнаГенерация И РежимГенерацииКодов = 1 Тогда
		ТекстСообщения = НСтр("ru = 'Генерация кода карты по шаблону штрихкода возможна только для карт с типом Штриховая или Смешанная.'");
		РежимГенерацииКодов = РежимГенерацииКодовДоИзменения;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "ТипКарты", "Объект.ТипКарты");
	ИначеЕсли НЕ Объект.ЭтоИменнаяКарта И РежимГенерацииКодов = 2 Тогда
		ТекстСообщения = НСтр("ru = 'Для использования номера телефона в качестве кода карты, требуется чтобы карта была именной.'");
		РежимГенерацииКодов = РежимГенерацииКодовДоИзменения;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "ЭтоИменнаяКарта", "Объект.ЭтоИменнаяКарта");
	КонецЕсли;
	РежимГенерацииКодовЗавершениеИзменения();
КонецПроцедуры

&НаКлиенте
Процедура РежимГенерацииКодовЗавершениеИзменения()
	Если РежимГенерацииКодов = 0 Тогда
		Объект.ГенерироватьНомер = Ложь;
		Объект.ПрисваиватьНомерКартыКНомеруТелефона = Ложь;
	ИначеЕсли РежимГенерацииКодов = 1 Тогда
		Объект.ГенерироватьНомер = Истина;
		Объект.ПрисваиватьНомерКартыКНомеруТелефона = Ложь;
	ИначеЕсли РежимГенерацииКодов = 2 Тогда
		Объект.ГенерироватьНомер = Ложь;
		Объект.ПрисваиватьНомерКартыКНомеруТелефона = Истина;
	КонецЕсли;
	УстановитьВидимостьГенерацииШтрихкода();
	РежимГенерацииКодовДоИзменения = РежимГенерацииКодов;
КонецПроцедуры
&НаСервере
Процедура ОбновитьРежимГенерацииПоДанным()
	Если Объект.ГенерироватьНомер = Ложь
		И Объект.ПрисваиватьНомерКартыКНомеруТелефона = Ложь Тогда
		РежимГенерацииКодов = 0;
	ИначеЕсли Объект.ГенерироватьНомер = Истина
		И Объект.ПрисваиватьНомерКартыКНомеруТелефона = Ложь Тогда
		РежимГенерацииКодов = 1
	ИначеЕсли Объект.ГенерироватьНомер = Ложь
		И Объект.ПрисваиватьНомерКартыКНомеруТелефона = Истина Тогда
		РежимГенерацииКодов = 2;		
	КонецЕсли;
	РежимГенерацииКодовДоИзменения = РежимГенерацииКодов;
КонецПроцедуры
