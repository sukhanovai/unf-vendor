#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВидыЗаказовПокупателей") Тогда
		Параметры.Вставить("ВидЗаказа", Справочники.ВидыЗаказовПокупателей.Основной);
	КонецЕсли;
	
	ДанныеВыбора = Новый СписокЗначений;
	Запрос = Новый Запрос;
	КоличествоЭлементов = 15;
	ДобавлятьПорядок = Истина;
	ИсключатьСостоянияЗаявок = Истина;
	
	Запрос.Текст = ТекстЗапросаПолученияДанныхВыбора(
	Параметры, Запрос, ДобавлятьПорядок, КоличествоЭлементов, ИсключатьСостоянияЗаявок);
	
	Выборка = Запрос.Выполнить().Выбрать();
	НомерПоПорядку = 0;
	ЖирныйШрифт = Новый Шрифт(, , Истина);
	ОбычныйШрифт = Новый Шрифт();
	
	Пока Выборка.Следующий() Цикл
		
		НомерПоПорядку = НомерПоПорядку + 1;
		
		КомпонентыФС = Новый Массив;
		Если ДобавлятьПорядок Тогда
			
			Если ИсключатьСостоянияЗаявок Тогда
				НомерСостояния = Выборка.НомерСтроки;
			Иначе
				НомерСостояния = НомерПоПорядку;
			КонецЕсли;
			
			КомпонентыФС.Добавить(Строка(НомерСостояния) + ". ");
			
		КонецЕсли;
		
		Если Выборка.Состояние = Завершен Тогда
			Шрифт = ЖирныйШрифт;
		Иначе
			Шрифт = ОбычныйШрифт;
		КонецЕсли;
		
		КомпонентыФС.Добавить(Новый ФорматированнаяСтрока(Выборка.Наименование, Шрифт));
		
		ПредставлениеСостояния = Новый ФорматированнаяСтрока(КомпонентыФС);
		ДанныеВыбора.Добавить(Выборка.Состояние, ПредставлениеСостояния);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаОбъекта" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Параметры.Свойство("РежимВыбора") И Параметры.РежимВыбора
			И Параметры.Свойство("ВидЗаказа") И ЗначениеЗаполнено(Параметры.ВидЗаказа) Тогда
				ВыбраннаяФорма = "Справочник.ВидыЗаказовПокупателей.Форма.ФормаСпискаЭтапов";
	Иначе
		ВыбраннаяФорма = "Справочник.СостоянияЗаказовПокупателей.Форма.ФормаСписка";
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаПолученияДанныхВыбора(
	Параметры, Запрос, ДобавлятьПорядок, КоличествоЭлементов, ИсключатьСостоянияЗаявок)
	
	ОтображатьСостоянияЗаявок = Параметры.Свойство("ОтображатьСостоянияЗаявок");
	
	Если Параметры.Свойство("АвтоПодбор") И Параметры.АвтоПодбор = Истина Тогда 
		
		ИсключатьСостоянияЗаявок = Не ОтображатьСостоянияЗаявок
		И РаботаСЗаявками.ЗаявкиИспользуются(, Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу);
		
		Если ИсключатьСостоянияЗаявок Тогда
			
			Результат = 
				"ВЫБРАТЬ
				|	ВидыЗаказовПокупателейПорядокСостояний.Состояние КАК Состояние,
				|	МАКСИМУМ(ВидыЗаказовПокупателейПорядокСостояний.НомерСтроки <= ВидыЗаказовПокупателей.НомерСостоянияЗаявки) КАК ЭтоСостояниеЗаявки
				|ПОМЕСТИТЬ втДоступныеСостоянияЗаказов
				|ИЗ
				|	Справочник.ВидыЗаказовПокупателей.ПорядокСостояний КАК ВидыЗаказовПокупателейПорядокСостояний
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗаказовПокупателей КАК ВидыЗаказовПокупателей
				|		ПО ВидыЗаказовПокупателейПорядокСостояний.Ссылка = ВидыЗаказовПокупателей.Ссылка
				|
				|СГРУППИРОВАТЬ ПО
				|	ВидыЗаказовПокупателейПорядокСостояний.Состояние
				|
				|ИМЕЮЩИЕ
				|	МАКСИМУМ(ВидыЗаказовПокупателейПорядокСостояний.НомерСтроки <= ВидыЗаказовПокупателей.НомерСостоянияЗаявки) = ЛОЖЬ
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ ПЕРВЫЕ 15
				|	СостоянияЗаказовПокупателей.Ссылка КАК Состояние,
				|	СостоянияЗаказовПокупателей.Наименование КАК Наименование,
				|	СостоянияЗаказовПокупателей.Цвет КАК Цвет
				|ИЗ
				|	Справочник.СостоянияЗаказовПокупателей КАК СостоянияЗаказовПокупателей
				|ГДЕ
				|	СостоянияЗаказовПокупателей.Наименование ПОДОБНО &Наименование
				|	И НЕ СостоянияЗаказовПокупателей.Ссылка = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
				|	И СостоянияЗаказовПокупателей.Ссылка В
				|			(ВЫБРАТЬ
				|				втДоступныеСостоянияЗаказов.Состояние КАК Состояние
				|			ИЗ
				|				втДоступныеСостоянияЗаказов КАК втДоступныеСостоянияЗаказов)
				|
				|УПОРЯДОЧИТЬ ПО
				|	Наименование";
			
		Иначе
			
			Результат = 
				"ВЫБРАТЬ ПЕРВЫЕ 15
				|	СостоянияЗаказовПокупателей.Ссылка КАК Состояние,
				|	СостоянияЗаказовПокупателей.Наименование КАК Наименование,
				|	СостоянияЗаказовПокупателей.Цвет КАК Цвет
				|ИЗ
				|	Справочник.СостоянияЗаказовПокупателей КАК СостоянияЗаказовПокупателей
				|ГДЕ
				|	СостоянияЗаказовПокупателей.Наименование ПОДОБНО &Наименование
				|	И НЕ СостоянияЗаказовПокупателей.Ссылка = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
				|
				|УПОРЯДОЧИТЬ ПО
				|	Наименование";
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Наименование", "%" + Параметры.СтрокаПоиска + "%");
		ДобавлятьПорядок = Ложь;
		
	ИначеЕсли Параметры.Свойство("ВидЗаказа") И ЗначениеЗаполнено(Параметры.ВидЗаказа) Тогда
		
		ИсключатьСостоянияЗаявок = Не ОтображатьСостоянияЗаявок
		И РаботаСЗаявками.ЗаявкиИспользуются(Параметры.ВидЗаказа);
		
		Если ИсключатьСостоянияЗаявок Тогда
			
			Результат = 
				"ВЫБРАТЬ ПЕРВЫЕ 15
				|	ВидыЗаказовПокупателейПорядокСостояний.Состояние КАК Состояние,
