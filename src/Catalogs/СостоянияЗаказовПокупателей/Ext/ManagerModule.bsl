#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

#Область ОбновлениеВерсииИБ

// Определяет настройки начального заполнения элементов.
//
// Параметры:
//  Настройки - Структура - настройки заполнения
//   * ПриНачальномЗаполненииЭлемента - Булево - Если Истина, то для каждого элемента будет
//      вызвана процедура индивидуального заполнения ПриНачальномЗаполненииЭлемента.
Процедура ПриНастройкеНачальногоЗаполненияЭлементов(Настройки) Экспорт
	
	Настройки.ПриНачальномЗаполненииЭлемента = Истина;
	
КонецПроцедуры

// Смотри также ОбновлениеИнформационнойБазыПереопределяемый.ПриНачальномЗаполненииЭлементов
// 
// Параметры:
//   КодыЯзыков - см. ОбновлениеИнформационнойБазыПереопределяемый.ПриНачальномЗаполненииЭлементов.КодыЯзыков
//   Элементы - см. ОбновлениеИнформационнойБазыПереопределяемый.ПриНачальномЗаполненииЭлементов.Элементы
//   ТабличныеЧасти - см. ОбновлениеИнформационнойБазыПереопределяемый.ПриНачальномЗаполненииЭлементов.ТабличныеЧасти
//
Процедура ПриНачальномЗаполненииЭлементов(КодыЯзыков, Элементы, ТабличныеЧасти) Экспорт
	
	Если Не НачальноеЗаполнениеЭлементовВыполнено() Тогда
		
		Элемент = Элементы.Добавить();
		Элемент.Наименование = СостоянияЗаказов.СостояниеНеОбработан();
		Элемент.Цвет = Новый ХранилищеЗначения(ЦветаПалитры.Синий);
		
		Элемент = Элементы.Добавить();
		Элемент.Наименование = СостоянияЗаказов.СостояниеВРаботе();
		Элемент.Цвет = Новый ХранилищеЗначения(ЦветаПалитры.Оранжевый);
		
		Элемент = Элементы.Добавить();
		Элемент.Наименование = СостоянияЗаказов.СостояниеВыставленСчет();
		Элемент.Цвет = Новый ХранилищеЗначения(ЦветаПалитры.Желтый);
		
		Элемент = Элементы.Добавить();
		Элемент.Наименование = СостоянияЗаказов.СостояниеНаВыполнении();
		Элемент.Цвет = Новый ХранилищеЗначения(ЦветаПалитры.Сиреневый);
		
	КонецЕсли;
	
	Элемент = Элементы.Добавить();
	Элемент.ИмяПредопределенныхДанных = "Завершен";
	Элемент.Наименование = СостоянияЗаказов.СостояниеЗавершен();
	Элемент.Цвет = Новый ХранилищеЗначения(ЦветаПалитры.Серый);
	
КонецПроцедуры

// Смотри также ОбновлениеИнформационнойБазыПереопределяемый.ПриНастройкеНачальногоЗаполненияЭлемента
//
// Параметры:
//  Объект                  - СправочникОбъект.ВидыКонтактнойИнформации - заполняемый объект.
//  Данные                  - СтрокаТаблицыЗначений - данные заполнения объекта.
//  ДополнительныеПараметры - Структура:
//   * ПредопределенныеДанные - ТаблицаЗначений - данные заполненные в процедуре ПриНачальномЗаполненииЭлементов.
//
Процедура ПриНачальномЗаполненииЭлемента(Объект, Данные, ДополнительныеПараметры) Экспорт
	
	Объект.УстановитьНовыйКод();
	
КонецПроцедуры

// Осветлить цвета и перенести в новый реквизит
// Версия 3.0.13
//
Процедура ОсветлитьЦветаПриОбновлении() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	СостоянияЗаказовПокупателей.Ссылка КАК Ссылка,
		|	СостоянияЗаказовПокупателей.Представление КАК Представление,
		|	СостоянияЗаказовПокупателей.Цвет КАК Цвет
		|ИЗ
		|	Справочник.СостоянияЗаказовПокупателей КАК СостоянияЗаказовПокупателей";
	
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			СостояниеОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если СостояниеОбъект = Неопределено Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			ЦветСостояния = СостояниеОбъект.Цвет.Получить();
			Если ТипЗнч(ЦветСостояния) <> Тип("Цвет") Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			НовыйЦвет = РаботаСЦветомСервер.ОсветленныйЦвет(ЦветСостояния.ПолучитьАбсолютный());
			НовыйЦвет = РаботаСЦветомСервер.ЯркийЦвет(НовыйЦвет);
			
			СостояниеОбъект.Заблокировать();
			СостояниеОбъект.Цвет = Новый ХранилищеЗначения(НовыйЦвет);
			СостояниеОбъект.УдалитьЦветСтарый = Новый ХранилищеЗначения(ЦветСостояния);
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(СостояниеОбъект);
			
			ЗафиксироватьТранзакцию();
			ОбъектовОбработано = ОбъектовОбработано + 1;
			
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстСообщения = НСтр("ru='Не удалось обработать объект ""%1"" по причине:
			|%2'", ОбщегоНазначения.КодОсновногоЯзыка());
			ТекстСообщения = СтрШаблон(ТекстСообщения, Выборка.Представление, ТекстОшибки);
			
			ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.СостоянияЗаказовПокупателей,
			Выборка.Ссылка,
			ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
	ТекстСообщения = НСтр(
	"ru='Процедура ОсветлитьЦветаПриОбновлении успешно обработала объектов - %1, проблемных объектов - %2'",
	ОбщегоНазначения.КодОсновногоЯзыка());
	ТекстСообщения = СтрШаблон(ТекстСообщения, ОбъектовОбработано, ПроблемныхОбъектов);
	
	ЗаписьЖурналаРегистрации(
	ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
	УровеньЖурналаРегистрации.Информация,
	Метаданные.Справочники.СостоянияЗаказовПокупателей, ,
	ТекстСообщения);
	
КонецПроцедуры

// Вернуть старые оттенки цветов
// Версия 3.0.13
//
Процедура ВернутьСтарыеЦветаТекста() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	СостоянияЗаказовПокупателей.Ссылка КАК Ссылка,
		|	СостоянияЗаказовПокупателей.Представление КАК Представление
		|ИЗ
		|	Справочник.СостоянияЗаказовПокупателей КАК СостоянияЗаказовПокупателей";
	
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			СостояниеОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если СостояниеОбъект = Неопределено Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
