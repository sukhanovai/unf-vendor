	ОформляемыеПоля = Новый Массив;
	ОформляемыеПоля.Добавить(Элементы.ПроцессыНастройкаАссистента.Имя);
	РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, ОформляемыеПоля);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Видимость", Ложь);
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
	НовоеУсловноеОформление.Отбор, "Процессы.НастройкаАссистента", , ВидСравненияКомпоновкиДанных.Заполнено);
	ОформляемыеПоля = Новый Массив;
	ОформляемыеПоля.Добавить(Элементы.ПроцессыЗаголовокНастройки.Имя);
	РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, ОформляемыеПоля);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Видимость", Ложь);
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
	НовоеУсловноеОформление.Отбор, "Процессы.НастройкаАссистента", , ВидСравненияКомпоновкиДанных.Заполнено);
	ОформляемыеПоля = Новый Массив;
	Для Каждого ПолеТаблицы Из Элементы.Процессы.ПодчиненныеЭлементы Цикл
		ОформляемыеПоля.Добавить(ПолеТаблицы.Имя);
	КонецЦикла;
	РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, ОформляемыеПоля);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Доступность", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеКорректировкиЗаказов()
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
	НовоеУсловноеОформление.Отбор, "Процессы.ТипНастройки", "ЗапрещатьЗавершениеНеотгруженныхЗаказов", ВидСравненияКомпоновкиДанных.Равно);
	ОформляемыеПоля = Новый Массив;
	Для Каждого ПолеТаблицы Из Элементы.Процессы.ПодчиненныеЭлементы Цикл
		Если ПолеТаблицы.Имя <> Элементы.ПроцессыЗаголовокНастройки.Имя
			И ПолеТаблицы.Имя <> Элементы.ПроцессыНастройкаАссистента.Имя
			И ПолеТаблицы.Имя <> Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно.Имя
			И ПолеТаблицы.Имя <> Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенОтменен.Имя Тогда
			ОформляемыеПоля.Добавить(ПолеТаблицы.Имя);
		КонецЕсли;
	КонецЦикла;
	РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, ОформляемыеПоля);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Доступность", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОбщихНастроекЗаказов()
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
	НовоеУсловноеОформление.Отбор, "Процессы.ТипНастройки", "ХранитьИсториюИзменений", ВидСравненияКомпоновкиДанных.Равно);
	ОформляемыеПоля = Новый Массив;
	ИндексПоля = 0;
	Для Каждого ПолеТаблицы Из Элементы.Процессы.ПодчиненныеЭлементы Цикл
		Если ПолеТаблицы.Имя <> Элементы.ПроцессыЗаголовокНастройки.Имя
			И ПолеТаблицы.Имя <> Элементы.ПроцессыНастройкаАссистента.Имя
			И ИндексПоля <> 1 Тогда
			ОформляемыеПоля.Добавить(ПолеТаблицы.Имя);
		КонецЕсли;
		ИндексПоля = ИндексПоля + 1;
	КонецЦикла;
	РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, ОформляемыеПоля);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Доступность", Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеФлаговПроцессов

Процедура УстановитьФлагиПроцессов()
	
	Если НЕ ИспользоватьПроцессы Тогда
		Возврат;
	КонецЕсли;
	
	Если ПорядокСостояний.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьФлагиАссистентУправления();
	УстановитьФлагиВерсионирования();
	УстановитьФлагиДатыЗапретаИзменений();
	УстановитьФлагиОбязательноеЗаполнениеПричины();
	УстановитьФлагиЗапретЗавершения();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФлагиАссистентУправления(ИдентификаторГруппы = Неопределено)
	
	ОтборПоГруппе = Ложь;
	Если ИдентификаторГруппы = Неопределено Тогда
		ОтборПоГруппе = Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗадачиАссистента.Ссылка КАК Ссылка,
	|	ЗадачиАссистента.Родитель.ИдентификаторГруппы КАК ИдентификаторГруппы,
	|	ЗадачиАссистента.Используется КАК Используется,
	|	ЗадачиАссистента.ТипПредмета КАК ТипПредмета
	|ПОМЕСТИТЬ ИспользуемыеЗадачиАссистента
	|ИЗ
	|	Справочник.ЗадачиАссистентаУправления КАК ЗадачиАссистента
	|ГДЕ
	|	(&ОтборПоГруппе
	|			ИЛИ ЗадачиАссистента.Родитель.ИдентификаторГруппы = &ИдентификаторГруппы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИспользуемыеЗадачиАссистента.ИдентификаторГруппы КАК ИдентификаторГруппы,
	|	ИспользуемыеЗадачиАссистента.Используется КАК Используется,
	|	ИспользуемыеЗадачиАссистента.ТипПредмета КАК ТипПредмета,
	|	ЗначениеЗаполнения.Ссылка КАК Ссылка,
	|	ЗначениеЗаполнения.Параметр КАК Параметр,
	|	ЗначениеЗаполнения.Значение КАК Значение
	|ИЗ
	|	ИспользуемыеЗадачиАссистента КАК ИспользуемыеЗадачиАссистента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗадачиАссистентаУправления.ЗначенияЗаполнения КАК ЗначениеЗаполнения
	|		ПО (ЗначениеЗаполнения.Ссылка = ИспользуемыеЗадачиАссистента.Ссылка)
	|ГДЕ
	|	(ЗначениеЗаполнения.Параметр = ""СостояниеЗаказа""
	|			ИЛИ ЗначениеЗаполнения.Параметр = ""СостояниеЗаказаПоставщику""
	|			ИЛИ ЗначениеЗаполнения.Параметр = ""ВариантЗавершения""
	|			ИЛИ ЗначениеЗаполнения.Параметр = ""ВариантЗавершенияЗаказаПоставщику"")
	|	И (ИспользуемыеЗадачиАссистента.ТипПредмета = ""ЗаказПоставщику""
	|			ИЛИ ИспользуемыеЗадачиАссистента.ТипПредмета = ""ЗаказПоставщикуЗаказНаПроизводство"")
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИспользуемыеЗадачиАссистента.ИдентификаторГруппы,
	|	ИспользуемыеЗадачиАссистента.Используется,
	|	ИспользуемыеЗадачиАссистента.ТипПредмета,
	|	ПараметрыУсловияЗадач.Ссылка,
	|	ПараметрыУсловияЗадач.Параметр,
	|	ПараметрыУсловияЗадач.Значение
	|ИЗ
	|	ИспользуемыеЗадачиАссистента КАК ИспользуемыеЗадачиАссистента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗадачиАссистентаУправления.ПараметрыУсловия КАК ПараметрыУсловияЗадач
	|		ПО (ПараметрыУсловияЗадач.Ссылка = ИспользуемыеЗадачиАссистента.Ссылка)
	|ГДЕ
	|	(ПараметрыУсловияЗадач.Параметр = ""СостояниеЗаказа""
	|			ИЛИ ПараметрыУсловияЗадач.Параметр = ""СостояниеЗаказаПоставщику""
	|			ИЛИ ПараметрыУсловияЗадач.Параметр = ""ВариантЗавершения""
	|			ИЛИ ПараметрыУсловияЗадач.Параметр = ""ВариантЗавершенияЗаказаПоставщику"")
	|	И (ИспользуемыеЗадачиАссистента.ТипПредмета = ""ЗаказПоставщику""
	|			ИЛИ ИспользуемыеЗадачиАссистента.ТипПредмета = ""ЗаказПоставщикуЗаказНаПроизводство"")";
	Запрос.УстановитьПараметр("ОтборПоГруппе", ОтборПоГруппе);
	Запрос.УстановитьПараметр("ИдентификаторГруппы", ИдентификаторГруппы);
	
	ТаблицаЗадач = Запрос.Выполнить().Выгрузить();
	ТаблицаЗадач.Колонки.Добавить("Состояние", Новый ОписаниеТипов("СправочникСсылка.СостоянияЗаказовПоставщикам, ПеречислениеСсылка.ВариантыЗавершенияЗаказа"));
	
	Для Каждого Строка Из ТаблицаЗадач Цикл
		
		СостояниеЗаказа = Строка.Значение.Получить();
		Строка.Состояние = СостояниеЗаказа;
		
		ДействияЗадачи = Процессы.НайтиСтроки(Новый Структура("ИдентификаторГруппыАссистента", Строка.ИдентификаторГруппы));
		Если ДействияЗадачи.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		УстановитьФлагиДействий(ДействияЗадачи, Ложь, ЭтотОбъект);
		
	КонецЦикла;
	
	Для Каждого Строка Из ТаблицаЗадач Цикл
		
		ДействияЗадачи = Процессы.НайтиСтроки(Новый Структура("ИдентификаторГруппыАссистента", Строка.ИдентификаторГруппы));
		Если ДействияЗадачи.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДействиеЗадачи = ДействияЗадачи[0];
		
		Если СтрНайти(Строка.Параметр, "СостояниеЗаказа") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если Строка.Состояние = Справочники.СостоянияЗаказовПоставщикам.Завершен Тогда
			
			ВариантЗавершенияУспешно = ТаблицаЗадач.НайтиСтроки(Новый Структура("Ссылка, Состояние", Строка.Ссылка, Перечисления.ВариантыЗавершенияЗаказа.Успешно));
			ВариантЗавершенияОтменен = ТаблицаЗадач.НайтиСтроки(Новый Структура("Ссылка, Состояние", Строка.Ссылка, Перечисления.ВариантыЗавершенияЗаказа.Отменен));
			
			Если ВариантЗавершенияУспешно.Количество() = 0 И ВариантЗавершенияОтменен.Количество() = 0 Тогда
				ДействиеЗадачи.ИспользуетсяДляСостояния_ЗавершенУспешно = Строка.Используется;
				Продолжить;
			КонецЕсли;
			
			Если ВариантЗавершенияУспешно.Количество() <> 0 Тогда
				ДействиеЗадачи.ИспользуетсяДляСостояния_ЗавершенУспешно = Строка.Используется;
			КонецЕсли;
			
			Если ВариантЗавершенияОтменен.Количество() <> 0 Тогда
				ДействиеЗадачи.ИспользуетсяДляСостояния_ЗавершенОтменен = Строка.Используется;
			КонецЕсли;
			
		Иначе
			
			УстановитьФлагПоСостоянию(ДействиеЗадачи, Строка.Используется, Строка.Состояние, ЭтотОбъект);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФлагиВерсионирования()
	
	Действие = ДействиеПоТипуНастройки("ХранитьИсториюИзменений", ЭтотОбъект);
	УстановитьФлагиДействий(Действие, Ложь, ЭтотОбъект);
	
	УстановитьПривилегированныйРежим(Истина);
	ИспользоватьВерсионированиеОбъектов = Константы.ИспользоватьВерсионированиеОбъектов.Получить();
	
	Если ИспользоватьВерсионированиеОбъектов Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиВерсионированияОбъектов.ТипОбъекта КАК ТипОбъекта,
		|	НастройкиВерсионированияОбъектов.Вариант КАК ВариантВерсионирования,
		|	НастройкиВерсионированияОбъектов.СрокХраненияВерсий КАК СрокХраненияВерсий
		|ИЗ
		|	РегистрСведений.НастройкиВерсионированияОбъектов КАК НастройкиВерсионированияОбъектов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
		|		ПО (ИдентификаторыОбъектовМетаданных.Ссылка = НастройкиВерсионированияОбъектов.ТипОбъекта)
		|ГДЕ
		|	ИдентификаторыОбъектовМетаданных.ПолноеИмя = ""Документ.ЗаказПоставщику""";
		
		Таблица = Запрос.Выполнить().Выгрузить();
		ИспользоватьВерсионированиеОбъектов = Таблица.Количество() <> 0
		И Таблица[0].ВариантВерсионирования <> Перечисления.ВариантыВерсионированияОбъектов.НеВерсионировать;
		
	КонецЕсли;
	
	Действие = ДействиеПоТипуНастройки("ХранитьИсториюИзменений", ЭтотОбъект);
	УстановитьФлагиДействий(Действие, ИспользоватьВерсионированиеОбъектов, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФлагиДатыЗапретаИзменений()
	
	Действие = ДействиеПоТипуНастройки("ЗапрещатьИзменениеДанныхПрошлыхПериодов", ЭтотОбъект);
	УстановитьФлагиДействий(Действие, Ложь, ЭтотОбъект);
	
	УстановитьПривилегированныйРежим(Истина);
	ДатыЗапретаВключены = Константы.ИспользоватьДатыЗапретаИзменения.Получить();
	
	Если Не ДатыЗапретаВключены Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДатыЗапретаИзменения.Раздел КАК Раздел,
	|	ДатыЗапретаИзменения.Объект КАК Объект,
	|	ДатыЗапретаИзменения.Пользователь КАК Пользователь,
	|	ДатыЗапретаИзменения.ДатаЗапрета КАК ДатаЗапрета,
	|	ДатыЗапретаИзменения.ОписаниеДатыЗапрета КАК ОписаниеДатыЗапрета,
	|	ДатыЗапретаИзменения.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
	|ГДЕ
	|	ДатыЗапретаИзменения.Раздел.Наименование = ""Заказы поставщиков""";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ДанныеСостояния Из ПорядокСостояний Цикл
		ЕстьНастройкаСостояния = Таблица.НайтиСтроки(Новый Структура("Объект", ДанныеСостояния.Состояние)).Количество();
		УстановитьФлагПоДаннымСостояния(Действие, ЕстьНастройкаСостояния, ДанныеСостояния, ЭтотОбъект);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФлагиОбязательноеЗаполнениеПричины()
	
	Действие = ДействиеПоТипуНастройки("ОбязательноЗаполнятьПолеПричинаОтменыТовара", ЭтотОбъект);
	УстановитьФлагиДействий(Действие, Ложь, ЭтотОбъект);
	
	ПроцессыВида = ПроцессыВида("ОбработкаПроверкиЗаполнения");
	Для Каждого ДанныеПроцесса Из ПроцессыВида Цикл
		
		Если ДанныеПроцесса.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно Тогда
			Действие.ИспользуетсяДляСостояния_ЗавершенУспешно = Истина;
		ИначеЕсли ДанныеПроцесса.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Отменен Тогда
			Действие.ИспользуетсяДляСостояния_ЗавершенОтменен = Истина;
		Иначе
			
			Для Каждого ДанныеСостояния Из ПорядокСостояний Цикл
				Если ДанныеПроцесса.Состояние = ДанныеСостояния.Состояние Тогда
					УстановитьФлагПоДаннымСостояния(Действие, Истина, ДанныеСостояния, ЭтотОбъект);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФлагиЗапретЗавершения()
	
	Действие = ДействиеПоТипуНастройки("ЗапрещатьЗавершениеНеотгруженныхЗаказов", ЭтотОбъект);
	УстановитьФлагиДействий(Действие, Ложь, ЭтотОбъект);
	
	ПроцессыВида = ПроцессыВида("ОбработкаПроведения");
	
	Отбор = Новый Структура("Состояние, ВариантЗавершения",
	Справочники.СостоянияЗаказовПоставщикам.Завершен, Перечисления.ВариантыЗавершенияЗаказа.Успешно);
	ЕстьНастройка = ПроцессыВида.НайтиСтроки(Отбор).Количество();
	Действие.ИспользуетсяДляСостояния_ЗавершенУспешно = ЕстьНастройка;
	
	Отбор = Новый Структура("Состояние, ВариантЗавершения",
	Справочники.СостоянияЗаказовПоставщикам.Завершен, Перечисления.ВариантыЗавершенияЗаказа.Отменен);
	ЕстьНастройка = ПроцессыВида.НайтиСтроки(Отбор).Количество();
	Действие.ИспользуетсяДляСостояния_ЗавершенОтменен = ЕстьНастройка;
	
КонецПроцедуры

#КонецОбласти

#Область ИзменениеФлаговПроцессов

&НаКлиенте
Процедура ОбработатьИзменениеФлагаОбязательноЗаполнитьПричинуОтмены(ИмяТекущейКолонки, ТекущаяСтрока, ЗначениеФлага)
	
	ИзмененыНастройкиОбязательностиЗаполнения = Истина;
	
	Если Не ЗначениеФлага Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьИзменениеФлагаОбязательноЗаполнитьПричинуОтменыНаСервере(ИмяТекущейКолонки, ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеФлагаОбязательноЗаполнитьПричинуОтменыНаСервере(ИмяТекущейКолонки, ТекущаяСтрока)
	
	Действие = Процессы.НайтиПоИдентификатору(ТекущаяСтрока);
	УстановитьВсеПоследующиеФлаги(Действие, Истина, ЭтотОбъект, ИмяТекущейКолонки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеФлагаИсторияИзменений(ТекущиеДанные, ЗначениеФлага)
	
	ИзмененыНастройкиВерсионирования = Истина;
	УстановитьФлагиДействий(ТекущиеДанные, ЗначениеФлага, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеФлагаДатыЗапретаИзменений(ИмяЭлемента, ТекущиеДанные)
	
	ИзмененыНастройкиДатыЗапретаИзменений = Истина;
	
	Если ИмяЭлемента = Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно.Имя Тогда
		ТекущиеДанные.ИспользуетсяДляСостояния_ЗавершенОтменен = ТекущиеДанные.ИспользуетсяДляСостояния_ЗавершенУспешно;
	ИначеЕсли ИмяЭлемента = Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенОтменен.Имя Тогда
		ТекущиеДанные.ИспользуетсяДляСостояния_ЗавершенУспешно = ТекущиеДанные.ИспользуетсяДляСостояния_ЗавершенОтменен;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеФлагаЗапретЗавершения()
	
	ИзмененыНастройкиЗапретаЗавершения = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СохранениеДанныхПроцессов

&НаСервере
Процедура СохранитьДанныеПроцессов()
	
	ЗаписатьНастройкиВерсионирования();
	ЗаписатьНастройкиДатыЗапрета();
	ЗаполнитьДанныеОбязательностиЗаполнения();
	ЗаполнитьДанныеЗапретаЗавершения();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиВерсионирования()
	
	Если НЕ ИзмененыНастройкиВерсионирования Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ИспользоватьВерсионированиеОбъектов = Константы.ИспользоватьВерсионированиеОбъектов.Получить();
	Если НЕ ИспользоватьВерсионированиеОбъектов Тогда
		Константы.ИспользоватьВерсионированиеОбъектов.Установить(Истина);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипОбъектаВерсионирования) Тогда
		ТипОбъектаВерсионирования = ТипОбъектаВерсионирования();
	КонецЕсли;
	
	Действие = ДействиеПоТипуНастройки("ХранитьИсториюИзменений", ЭтотОбъект);
	Если Действие.ИспользуетсяДляСостояния_ЗавершенУспешно Тогда
		ВариантВерсионирования = Перечисления.ВариантыВерсионированияОбъектов.ВерсионироватьПриПроведении;
	Иначе
		ВариантВерсионирования = Перечисления.ВариантыВерсионированияОбъектов.НеВерсионировать;
	КонецЕсли;
	
	ВерсионированиеОбъектов.ЗаписатьНастройкуВерсионированияПоОбъекту(
	ТипОбъектаВерсионирования, ВариантВерсионирования, Перечисления.СрокиХраненияВерсий.Бессрочно);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиДатыЗапрета()
	
	Если НЕ ИзмененыНастройкиДатыЗапретаИзменений Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ИспользоватьДатыЗапретаИзменения = Константы.ИспользоватьДатыЗапретаИзменения.Получить();
	Если НЕ ИспользоватьДатыЗапретаИзменения Тогда
		Константы.ИспользоватьДатыЗапретаИзменения.Установить(Истина);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДатыЗапретаИзменения.Раздел КАК Раздел,
	|	ДатыЗапретаИзменения.Объект КАК Объект,
	|	ДатыЗапретаИзменения.Пользователь КАК Пользователь,
	|	ДатыЗапретаИзменения.ДатаЗапрета КАК ДатаЗапрета,
	|	ДатыЗапретаИзменения.ОписаниеДатыЗапрета КАК ОписаниеДатыЗапрета,
	|	ДатыЗапретаИзменения.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения
	|ГДЕ
	|	ДатыЗапретаИзменения.Раздел.Наименование = ""Заказы поставщиков""";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	РазделДатыЗапрета = РазделДатыЗапрета();
	Действие = ДействиеПоТипуНастройки("ЗапрещатьИзменениеДанныхПрошлыхПериодов", ЭтотОбъект);
	
	Для Каждого ДанныеСостояния Из ПорядокСостояний Цикл
		
		Отбор = Новый Структура("Объект, Пользователь, ДатаЗапрета",
		ДанныеСостояния.Состояние, Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей, Дата('39991231'));
		ЗаписиВРегистре = Таблица.НайтиСтроки(Отбор);
		
		ЗначениеФлага = ЗначениеФлагаДействия(Действие, ДанныеСостояния, ЭтотОбъект);
		
		Если ЗаписиВРегистре.Количество() = 0 И ЗначениеФлага Тогда
			ЗаписатьДатуЗапретаСОписанием(
			РазделДатыЗапрета, ДанныеСостояния.Состояние, Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей, Дата('39991231'), , );
		КонецЕсли;
		
		Если ЗаписиВРегистре.Количество() <> 0 И Не ЗначениеФлага Тогда
			Запись = РегистрыСведений.ДатыЗапретаИзменения.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, ЗаписиВРегистре[0]);
			Запись.Удалить();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДатуЗапретаСОписанием(Знач Раздел, Знач Объект, Знач Пользователь, Знач ДатаЗапрета, Знач ВнутреннееОписаниеДатыЗапрета, Знач Комментарий)
	
	Если Не ЗначениеЗаполнено(ДатаЗапрета) Тогда
		ДатаЗапрета = '39991231';
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ДатыЗапретаИзменения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Раздел = Раздел;
	МенеджерЗаписи.Объект = Объект;
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.ДатаЗапрета = ДатаЗапрета;
	МенеджерЗаписи.ОписаниеДатыЗапрета = ВнутреннееОписаниеДатыЗапрета;
	МенеджерЗаписи.Комментарий = Комментарий;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОбязательностиЗаполнения()
	
	Если НЕ ИзмененыНастройкиОбязательностиЗаполнения Тогда
		Возврат;
	КонецЕсли;
	
	ПроцессыВида = ПроцессыВида("ОбработкаПроверкиЗаполнения");
	Если ПроцессыВида.Количество() = 0 Тогда
		ПроцессыВидаОбъект = Справочники.ПроцессыСостоянийЗаказов.СоздатьЭлемент();
		ПроцессыВидаОбъект.Предмет = "ЗаказПоставщику";
	Иначе
		ПроцессыВидаОбъект = ПроцессыВида[0].Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	СтрокиПричиныОтмены = ПроцессыВидаОбъект.ОбработкаПроверкиЗаполнения.НайтиСтроки(Новый Структура("ИмяРеквизита", "ОтмененныеЗапасы.ПричинаОтмены"));
	Для Каждого Строка Из СтрокиПричиныОтмены Цикл
		ПроцессыВидаОбъект.ОбработкаПроверкиЗаполнения.Удалить(Строка);
	КонецЦикла;
	
	Действие = ДействиеПоТипуНастройки("ОбязательноЗаполнятьПолеПричинаОтменыТовара", ЭтотОбъект);
	
	Для Каждого ДанныеСостояния Из ПорядокСостояний Цикл
		
		Если ДанныеСостояния.Состояние = Справочники.СостоянияЗаказовПоставщикам.Завершен Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Действие[ИмяРеквизитаКолонкиСостояния(, ДанныеСостояния.НомерСтроки, ЭтотОбъект)] Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьНастройкуОбязательностиЗаполнения(ПроцессыВидаОбъект, ДанныеСостояния.Состояние);
		
	КонецЦикла;
	
	Если Действие.ИспользуетсяДляСостояния_ЗавершенУспешно Тогда
		ДобавитьНастройкуОбязательностиЗаполнения(
		ПроцессыВидаОбъект, Справочники.СостоянияЗаказовПоставщикам.Завершен, Перечисления.ВариантыЗавершенияЗаказа.Успешно);
	КонецЕсли;
	Если Действие.ИспользуетсяДляСостояния_ЗавершенОтменен Тогда
		ДобавитьНастройкуОбязательностиЗаполнения(
		ПроцессыВидаОбъект, Справочники.СостоянияЗаказовПоставщикам.Завершен, Перечисления.ВариантыЗавершенияЗаказа.Отменен);
	КонецЕсли;
	
	ПроцессыВидаОбъект.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНастройкуОбязательностиЗаполнения(ПроцессыВидаОбъект, Состояние, ВариантЗавершения = Неопределено)
	
	НоваяПроверка = ПроцессыВидаОбъект.ОбработкаПроверкиЗаполнения.Добавить();
	НоваяПроверка.ИмяРеквизита = "ОтмененныеЗапасы.ПричинаОтмены";
	НоваяПроверка.Состояние = Состояние;
	
	Если ВариантЗавершения <> Неопределено Тогда
		НоваяПроверка.ВариантЗавершения = ВариантЗавершения;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеЗапретаЗавершения()
	
	Если НЕ ИзмененыНастройкиЗапретаЗавершения Тогда
		Возврат;
	КонецЕсли;
	
	ПроцессыВида = ПроцессыВида("ОбработкаПроведения");
	Если ПроцессыВида.Количество() = 0 Тогда
		ПроцессыВидаОбъект = Справочники.ПроцессыСостоянийЗаказов.СоздатьЭлемент();
		ПроцессыВидаОбъект.Предмет = "ЗаказПоставщику";
	Иначе
		ПроцессыВидаОбъект = ПроцессыВида[0].Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	СтрокиПричиныОтмены = ПроцессыВидаОбъект.ОбработкаПроведения.НайтиСтроки(Новый Структура("Свойство", "ПолностьюОтгружен"));
	Для Каждого Строка Из СтрокиПричиныОтмены Цикл
		ПроцессыВидаОбъект.ОбработкаПроведения.Удалить(Строка);
	КонецЦикла;
	
	Действие = ДействиеПоТипуНастройки("ЗапрещатьЗавершениеНеотгруженныхЗаказов", ЭтотОбъект);
	
	Если Действие.ИспользуетсяДляСостояния_ЗавершенУспешно Тогда
		ДобавитьНастройкуЗапретаЗавершения(
		ПроцессыВидаОбъект, Перечисления.ВариантыЗавершенияЗаказа.Успешно);
	КонецЕсли;
	Если Действие.ИспользуетсяДляСостояния_ЗавершенОтменен Тогда
		ДобавитьНастройкуЗапретаЗавершения(
		ПроцессыВидаОбъект, Перечисления.ВариантыЗавершенияЗаказа.Отменен);
	КонецЕсли;
	
	ПроцессыВидаОбъект.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНастройкуЗапретаЗавершения(ПроцессыВидаОбъект, ВариантЗавершения)
	
	НоваяПроверка = ПроцессыВидаОбъект.ОбработкаПроведения.Добавить();
	НоваяПроверка.Свойство = "ПолностьюОтгружен";
	НоваяПроверка.Состояние = Справочники.СостоянияЗаказовПоставщикам.Завершен;
	НоваяПроверка.ВариантЗавершения = ВариантЗавершения;
	
КонецПроцедуры

&НаСервере
Функция ТипОбъектаВерсионирования()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИдентификаторыОбъектовМетаданных.Ссылка КАК ТипОбъекта
	|ИЗ
	|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	|ГДЕ
	|	ИдентификаторыОбъектовМетаданных.ПолноеИмя = ""Документ.ЗаказПоставщику""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ТипОбъекта;
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция РазделДатыЗапрета()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РазделыДатыЗапретаИзменений.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.РазделыДатЗапретаИзменения КАК РазделыДатыЗапретаИзменений
	|ГДЕ
	|	РазделыДатыЗапретаИзменений.Наименование = ""Заказы поставщиков""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОтветНаВопрос(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Да Тогда 
		СохранитьДанныеПроцессов();
		Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область АссистентУправления

&НаКлиенте
Процедура ОбработатьЗакрытиеФормыЗадачи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьЗакрытиеФормыЗадачиСервер(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьЗакрытиеФормыЗадачиСервер(Результат)
	
	ИнформационнаяБазаПодключена = СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована();
	АссистентПодключен = АссистентУправления.Подключен();
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьФлагиАссистентУправления(Результат.ГруппаЗадач);
	
	Если НЕ ИнформационнаяБазаПодключена Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ АссистентПодключен Тогда
		Возврат;
	КонецЕсли;
	
	ОбсуждениеСоздано = АссистентУправления.ПолучитьОбсуждениеЖурналРаботыАссистента() <> Неопределено;
	
	Если НЕ ОбсуждениеСоздано Тогда
		Попытка
			СоздатьОбсуждение();
		Исключение
		КонецПопытки;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Результат.АвторИзменений) И Результат.НужноДобавитьВОбсуждение Тогда
		Попытка
			АссистентУправления.ОбновитьУчастниковЖурналРаботыАссистента(Результат.АвторИзменений);
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СоздатьОбсуждение()
	
	Если АссистентУправления.ПолучитьОбсуждениеЖурналРаботыАссистента() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АссистентУправления.СоздатьОбсуждениеЖурналРаботыАссистента();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеМетодыДляБыстройРаботы

&НаКлиентеНаСервереБезКонтекста
Функция ДействиеПоТипуНастройки(ТипНастройки, Форма)
	
	Возврат Форма.Процессы.НайтиСтроки(Новый Структура("ТипНастройки", ТипНастройки))[0];
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НомерСтрокиСостояния(Состояние, Форма)
	
	Состояния = Форма.ПорядокСостояний.НайтиСтроки(Новый Структура("Состояние", Состояние));
	Если Состояния.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Состояния[0].НомерСтроки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяРеквизитаКолонкиСостояния(Состояние = Неопределено, НомерСтроки = Неопределено, Форма)
	
	Если НомерСтроки = Неопределено Тогда
		
		НомерСтроки = НомерСтрокиСостояния(Состояние, Форма);
		Если НомерСтроки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтрШаблон("ИспользуетсяДляСостояния_%1", НомерСтроки);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьФлагПоДаннымСостояния(Действие, ЗначениеФлага, ДанныеСостояния, Форма)
	
	Если ДанныеСостояния.Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПоставщикам.Завершен") Тогда
		Действие.ИспользуетсяДляСостояния_ЗавершенУспешно = ЗначениеФлага;
		Действие.ИспользуетсяДляСостояния_ЗавершенОтменен = ЗначениеФлага;
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаКолонкиСостояния = ИмяРеквизитаКолонкиСостояния(ДанныеСостояния.Состояние, ДанныеСостояния.НомерСтроки, Форма);
	Если ИмяРеквизитаКолонкиСостояния = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Действие[ИмяРеквизитаКолонкиСостояния] = ЗначениеФлага;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьФлагПоСостоянию(Действие, ЗначениеФлага, Состояние, Форма)
	
	Если Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПоставщикам.Завершен") Тогда
		Действие.ИспользуетсяДляСостояния_ЗавершенУспешно = ЗначениеФлага;
		Действие.ИспользуетсяДляСостояния_ЗавершенОтменен = ЗначениеФлага;
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаКолонкиСостояния = ИмяРеквизитаКолонкиСостояния(Состояние, , Форма);
	Если ИмяРеквизитаКолонкиСостояния = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Действие[ИмяРеквизитаКолонкиСостояния] = ЗначениеФлага;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВсеПоследующиеФлаги(Действие, ЗначениеФлага, Форма, ИмяКолонки = Неопределено, Состояние = Неопределено, Включая = Истина)
	
	Если ИмяКолонки = Неопределено Тогда
		
		Если Состояние = Справочники.СостоянияЗаказовПоставщикам.Завершен Тогда
			ИмяКолонки = Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно.Имя;
		Иначе
			
			НомерСтроки = НомерСтрокиСостояния(Состояние, ЭтотОбъект);
			Если НомерСтроки = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			ИмяКолонки = "ПроцессыИспользуетсяДляСостояния_" + НомерСтроки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НайденаТекущаяКолонка = Ложь;
	Для Каждого Колонка Из Элементы.Процессы.ПодчиненныеЭлементы Цикл
		
		Если Колонка.Имя = ИмяКолонки Тогда
			НайденаТекущаяКолонка = Истина;
		КонецЕсли;
		
		Если Не НайденаТекущаяКолонка Тогда
			Продолжить;
		КонецЕсли;
		
		Если Колонка.Имя <> ИмяКолонки Или Колонка.Имя = ИмяКолонки И Включая Тогда
			
			НаименованиеПоля = Сред(Колонка.ПутьКДанным, СтрДлина("Процессы.") + 1);
			Действие[НаименованиеПоля] = ЗначениеФлага;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеФлагаДействия(Действие, ДанныеСостояния, Форма)
	
	Если ДанныеСостояния.Состояние = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПоставщикам.Завершен") Тогда
		Возврат Действие.ИспользуетсяДляСостояния_ЗавершенУспешно;
	КонецЕсли;
	
	ИмяРеквизитаКолонкиСостояния = ИмяРеквизитаКолонкиСостояния(, ДанныеСостояния.НомерСтроки, Форма);
	Если ИмяРеквизитаКолонкиСостояния = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Действие[ИмяРеквизитаКолонкиСостояния];
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьФлагиДействий(Действия, ЗначениеФлага, Форма)
	
	Если ТипЗнч(Действия) = Тип("Массив") Тогда
		ДействияСписок = Действия;
	Иначе
		ДействияСписок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Действия);
	КонецЕсли;
	
	Для Каждого Действие Из ДействияСписок Цикл
		Для Каждого ДанныеСостояния Из Форма.ПорядокСостояний Цикл
			УстановитьФлагПоДаннымСостояния(Действие, ЗначениеФлага, ДанныеСостояния, Форма);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ПроцессыВида(ИмяТаблицы)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПроцессов(ИмяТаблицы);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаПроцессов(ИмяТаблицы)
	
	Если ИмяТаблицы = "ОбработкаПроверкиЗаполнения" Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПроцессыСостоянийЗаказов.Ссылка КАК Ссылка,
		|	ПроцессыОбработкаПроверкиЗаполнения.НомерСтроки КАК НомерСтроки,
		|	ПроцессыОбработкаПроверкиЗаполнения.Состояние КАК Состояние,
		|	ПроцессыОбработкаПроверкиЗаполнения.ИмяРеквизита КАК ИмяРеквизита,
		|	ПроцессыОбработкаПроверкиЗаполнения.ВариантЗавершения КАК ВариантЗавершения
		|ИЗ
		|	Справочник.ПроцессыСостоянийЗаказов КАК ПроцессыСостоянийЗаказов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПроцессыСостоянийЗаказов.ОбработкаПроверкиЗаполнения КАК ПроцессыОбработкаПроверкиЗаполнения
		|		ПО ПроцессыСостоянийЗаказов.Ссылка = ПроцессыОбработкаПроверкиЗаполнения.Ссылка
		|ГДЕ
		|	ПроцессыСостоянийЗаказов.Предмет = ""ЗаказПоставщику""";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ПроцессыСостоянийЗаказов.Ссылка КАК Ссылка,
		|	ПроцессыОбработкаПроведения.НомерСтроки КАК НомерСтроки,
		|	ПроцессыОбработкаПроведения.Состояние КАК Состояние,
		|	ПроцессыОбработкаПроведения.ВариантЗавершения КАК ВариантЗавершения,
		|	ПроцессыОбработкаПроведения.Свойство КАК Свойство
		|ИЗ
		|	Справочник.ПроцессыСостоянийЗаказов КАК ПроцессыСостоянийЗаказов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПроцессыСостоянийЗаказов.ОбработкаПроведения КАК ПроцессыОбработкаПроведения
		|		ПО ПроцессыСостоянийЗаказов.Ссылка = ПроцессыОбработкаПроведения.Ссылка
		|ГДЕ
		|	ПроцессыСостоянийЗаказов.Предмет = ""ЗаказПоставщику""";
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиБиблиотек

