&НаСервере
Процедура УстановитьУсловноеОформлениеНаПроцессы()
	
	УстановитьУсловноеОформлениеГруппПроцессов();
	УстановитьУсловноеОформлениеНастроекАссистента();
	УстановитьУсловноеОформлениеКорректировкиЗаказов();
	УстановитьУсловноеОбщихНастроекЗаказов();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеГруппПроцессов()
	
	Если ЭтоИнтерфейсТакси Тогда
		ШрифтГруппы = Новый Шрифт(,,Истина);
	Иначе
		ШрифтГруппы = ШрифтыСтиля.ЗаголовокТретьегоУровня;
	КонецЕсли;
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
	НовоеУсловноеОформление.Отбор, "Процессы.ЭтоГруппа", Истина, ВидСравненияКомпоновкиДанных.Равно);
	ОформляемыеПоля = Новый Массив;
	Для Каждого ПолеТаблицы Из Элементы.Процессы.ПодчиненныеЭлементы Цикл
		ОформляемыеПоля.Добавить(ПолеТаблицы.Имя);
	КонецЦикла;
	РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, ОформляемыеПоля);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Видимость", Ложь);
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
	НовоеУсловноеОформление.Отбор, "Процессы.ЭтоГруппа", Истина, ВидСравненияКомпоновкиДанных.Равно);
	ОформляемыеПоля = Новый Массив;
	ОформляемыеПоля.Добавить(Элементы.ПроцессыЗаголовокНастройки.Имя);
	РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, ОформляемыеПоля);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Шрифт", ШрифтГруппы);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "ЦветФона", ЦветаПалитры.Серый);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Доступность", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеНастроекАссистента()
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
