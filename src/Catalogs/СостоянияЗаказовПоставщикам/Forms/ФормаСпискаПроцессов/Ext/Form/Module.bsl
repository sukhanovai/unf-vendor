
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	
	СостоянияЗаказов.УстановитьУсловноеОформлениеСостоянияЗавершен(
	СписокСостояний.КомпоновщикНастроек.Настройки.УсловноеОформление, ПредопределенноеЗначение(
	"Справочник.СостоянияЗаказовПоставщикам.Завершен"));
	
	ИспользоватьПроцессы = ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыСостояний");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
	"СтраницаПроцессы", 
	"Видимость", 
	ИспользоватьПроцессы);
	
	УстановитьУсловноеОформлениеПоЦветамСостоянийСервер();
	
	СписокСостояний.Порядок.Элементы.Очистить();
	
	Если Параметры.Свойство("НастройкаПроцессов") Тогда
		Элементы.СтраницыСостояний.ТекущаяСтраница = Элементы.СтраницаПроцессы;
	КонецЕсли;
	
	Порядок = СписокСостояний.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	Порядок.Использование = Истина;
	Порядок.Поле = Новый ПолеКомпоновкиДанных("РеквизитДопУпорядочивания");
	Порядок.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	
	Порядок = СписокСостояний.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	Порядок.Использование = Истина;
	Порядок.Поле = Новый ПолеКомпоновкиДанных("ЗавершенПоследним");
	Порядок.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	
	// Установим настройки формы для случая открытия в режиме выбора
	РежимВыбора = Неопределено;
	Параметры.Свойство("РежимВыбора", РежимВыбора);
	Если РежимВыбора = Неопределено Тогда
		РежимВыбора = Ложь;
	КонецЕсли;
	
	Элементы.Список.РежимВыбора = РежимВыбора;
	Элементы.Список.МножественныйВыбор = ?(Параметры.ЗакрыватьПриВыборе = Неопределено, Ложь, Не Параметры.ЗакрыватьПриВыборе);
	Если РежимВыбора Тогда
		КлючНазначенияИспользования = КлючНазначенияИспользования + "ВыборПодбор";
		РежимБлокировкиПриОткрытииОкна = РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца;
	Иначе
		КлючНазначенияИспользования = КлючНазначенияИспользования + "Список";
	КонецЕсли;
	
	ОбновитьПроцессы();
	
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	Массив = Новый Массив;
	Массив.Добавить(Метаданные.Справочники.СостоянияЗаказовПоставщикам);
	ПараметрыРазмещения.Вставить("Источники", Массив);
	ПараметрыРазмещения.Вставить("КоманднаяПанель", Элементы.Список.КоманднаяПанель);
	ПараметрыРазмещения.Вставить("ПрефиксГрупп", "Список");
	ПараметрыРазмещения.Вставить("ВладелецКоманд", Элементы.Список);
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	АдаптацияМобильныйКлиент();
	
	АдаптацияТакси();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_СостоянияЗаказовПоставщикам" Тогда
		ОбработкаОповещенияНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ОбработатьОтветНаВопрос", ЭтотОбъект);
	ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
	ПоказатьВопрос(ОписаниеОповещенияОЗакрытии, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаКоманд = Элементы.Найти("НастройкаПорядкаЭлементов");
	Если ГруппаКоманд <> Неопределено Тогда
		ГруппаКоманд.Доступность = 
		(Элементы.Список.ТекущаяСтрока <> ПредопределенноеЗначение("Справочник.СостоянияЗаказовПоставщикам.Завершен"));
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриНаведении(Элемент, Строка, Поле)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриИзменении(Элемент)
	
	СписокПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПроцессы

&НаКлиенте
Процедура ПроцессыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент <> Элементы.ПроцессыНастройкаАссистента Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Процессы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОбработатьЗакрытиеФормыЗадачи", ЭтотОбъект);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторГруппы", ДанныеСтроки.ИдентификаторГруппыАссистента);
	ОткрытьФорму(ДанныеСтроки.ИмяФормыЗадачиАссистента, ПараметрыФормы, , , , , ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроцессыПриИзменении(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущаяКолонка = Элемент.ТекущийЭлемент;
	ТекущаяСтрока = Элемент.ТекущаяСтрока;
	Если ТекущиеДанные = Неопределено Или ТекущаяКолонка = Неопределено Или ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = ТекущаяКолонка.Имя;
	Если Не СтрНачинаетсяС(ИмяЭлемента, "ПроцессыИспользуетсяДляСостояния_") Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтроки = Сред(ИмяЭлемента, СтрДлина("ПроцессыИспользуетсяДляСостояния_") + 1);
	Если ИмяЭлемента = Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно.Имя Тогда
		ЗначениеФлага = ТекущиеДанные.ИспользуетсяДляСостояния_ЗавершенУспешно;
	ИначеЕсли ИмяЭлемента = Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенОтменен.Имя Тогда
		ЗначениеФлага = ТекущиеДанные.ИспользуетсяДляСостояния_ЗавершенОтменен;
	Иначе
		ЗначениеФлага = ТекущиеДанные[ИмяРеквизитаКолонкиСостояния(, ИдентификаторСтроки, ЭтотОбъект)];
	КонецЕсли;
	
	Если ТекущиеДанные.ТипНастройки = "ОбязательноЗаполнятьПолеПричинаОтменыТовара" Тогда
		
		ОбработатьИзменениеФлагаОбязательноЗаполнитьПричинуОтмены(ИмяЭлемента, ТекущаяСтрока, ЗначениеФлага);
		
	ИначеЕсли ТекущиеДанные.ТипНастройки = "ХранитьИсториюИзменений" Тогда
		
		ОбработатьИзменениеФлагаИсторияИзменений(ТекущиеДанные, ЗначениеФлага);
		
	ИначеЕсли ТекущиеДанные.ТипНастройки = "ЗапрещатьИзменениеДанныхПрошлыхПериодов" Тогда
		
		ОбработатьИзменениеФлагаДатыЗапретаИзменений(ИмяЭлемента, ТекущиеДанные);
		
	ИначеЕсли ТекущиеДанные.ТипНастройки = "ЗапрещатьЗавершениеНеотгруженныхЗаказов" Тогда
		
		ОбработатьИзменениеФлагаЗапретЗавершения();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	Модифицированность = Ложь;
	СохранитьДанныеПроцессов();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Модифицированность = Ложь;
	СохранитьДанныеПроцессов();
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СписокСостояний

&НаСервере
Процедура СписокПриИзмененииНаСервере()
	
	ОбновитьПроцессы();
	УстановитьУсловноеОформлениеПоЦветамСостоянийСервер();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеПоЦветамСостоянийСервер()
	
	СостоянияЗаказов.УстановитьУсловноеОформлениеПоЦветамСостояний(
	СписокСостояний.КомпоновщикНастроек.Настройки.УсловноеОформление,
	Метаданные.Справочники.СостоянияЗаказовПоставщикам.ПолноеИмя(),
	"Ссылка",
	"Ссылка");
	
КонецПроцедуры

#КонецОбласти

#Область Процессы

#Область ОбновлениеПроцессов

&НаСервере
Процедура ОбновитьПроцессы()
	
	ЗаполнитьПорядокСостояний();
	
	ОбновитьРеквизитыСостоянийПроцессов();
	ОбновитьЭлементыСостоянийПроцессов();
	ЗаполнитьСтатическийКонтентПроцессов();
	УстановитьУсловноеОформлениеНаПроцессы();
	УстановитьФлагиПроцессов();
	
	Элементы.Процессы.ТекущаяСтрока = Процессы[1].ПолучитьИдентификатор();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПорядокСостояний()
	
	ПорядокСостояний.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СправочникСостоянияЗаказовПоставщикам.Ссылка КАК Состояние,
	|	СправочникСостоянияЗаказовПоставщикам.РеквизитДопУпорядочивания КАК НомерСтроки,
	|	СправочникСостоянияЗаказовПоставщикам.Наименование КАК НаименованиеСостояния
	|ИЗ
	|	Справочник.СостоянияЗаказовПоставщикам КАК СправочникСостоянияЗаказовПоставщикам
	|
	|УПОРЯДОЧИТЬ ПО
	|	СправочникСостоянияЗаказовПоставщикам.РеквизитДопУпорядочивания";
	
	ПорядокСостояний.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРеквизитыСостоянийПроцессов()
	
	ПоляТаблицы = ПолучитьРеквизиты("Процессы");
	
	ПутиУдаляемыхРеквизитов = Новый Массив;
	Для Каждого ПолеТаблицы Из ПоляТаблицы Цикл
		
		Имя = ПолеТаблицы.Имя;
		
		Если Имя <> "ЗаголовокНастройки"
			И Имя <> "ЭтоГруппа"
			И Имя <> "ИспользуетсяДляСостояния_ЗавершенУспешно"
			И Имя <> "ИспользуетсяДляСостояния_ЗавершенОтменен"
			И Имя <> "ТипНастройки"
			И Имя <> "НастройкаАссистента"
			И Имя <> "ИдентификаторГруппыАссистента"
			И Имя <> "ИмяФормыЗадачиАссистента" Тогда
			
			ПутиУдаляемыхРеквизитов.Добавить(СтрШаблон("%1.%2", ПолеТаблицы.Путь, Имя));
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого ДанныеСостояния Из ПорядокСостояний Цикл
		
		Если ДанныеСостояния.Состояние = Справочники.СостоянияЗаказовПоставщикам.Завершен Тогда
			Продолжить;
		КонецЕсли;
		
		НовоеПоле = Новый РеквизитФормы(
		"ИспользуетсяДляСостояния_" + ДанныеСостояния.НомерСтроки,
		Новый ОписаниеТипов("Булево"),
		"Процессы",
		ДанныеСостояния.НаименованиеСостояния);
		
		ДобавляемыеРеквизиты.Добавить(НовоеПоле);
		
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты, ПутиУдаляемыхРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыСостоянийПроцессов()
	
	ЭлементыНаУдаление = Новый Массив;
	Для Каждого КолонкаТаблицы Из Элементы.Процессы.ПодчиненныеЭлементы Цикл
		
		Имя = КолонкаТаблицы.Имя;
		
		Если Имя <> Элементы.ГруппаЗаголовков.Имя
			И Имя <> Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно.Имя
			И Имя <> Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенОтменен.Имя Тогда
			
			ЭлементыНаУдаление.Добавить(КолонкаТаблицы);
			
		КонецЕсли;
		
	КонецЦикла;
	Для Каждого КолонкаТаблицы Из ЭлементыНаУдаление Цикл
		Элементы.Удалить(КолонкаТаблицы);
	КонецЦикла;
	
	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого ДанныеСостояния Из ПорядокСостояний Цикл
		
		Если ДанныеСостояния.Состояние = Справочники.СостоянияЗаказовПоставщикам.Завершен Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьКДанным = "ИспользуетсяДляСостояния_" + ДанныеСостояния.НомерСтроки;
		
		КолонкаТаблицы = Элементы.Добавить("Процессы" + ПутьКДанным, Тип("ПолеФормы"), Элементы.Процессы);
		КолонкаТаблицы.Вид = ВидПоляФормы.ПолеФлажка;
		КолонкаТаблицы.ПутьКДанным = СтрШаблон("Процессы.%1", ПутьКДанным);
		
		Элементы.Переместить(КолонкаТаблицы, Элементы.Процессы, Элементы.ПроцессыИспользуетсяДляСостояния_ЗавершенУспешно);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатическийКонтентПроцессов()
	
	Процессы.Очистить();
	
	СтрокаТЗ = Процессы.Добавить();
	СтрокаТЗ.ЭтоГруппа = Истина;
	СтрокаТЗ.ТипНастройки = "КорректировкаЗаказа";
	СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Корректировка заказа'");
	СтрокаТЗ = Процессы.Добавить();
	СтрокаТЗ.ТипНастройки = "ОбязательноЗаполнятьПолеПричинаОтменыТовара";
	СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Обязательно заполнять поле ""Причина отмены товара""'");
	СтрокаТЗ = Процессы.Добавить();
	СтрокаТЗ.ТипНастройки = "ЗапрещатьЗавершениеНеотгруженныхЗаказов";
	СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Запрещать завершение непоставленных заказов'");
	
	СтрокаТЗ = Процессы.Добавить();
	СтрокаТЗ.ЭтоГруппа = Истина;
	СтрокаТЗ.ТипНастройки = "ОбщиеНастройкиДляВсехВидовЗаказа";
	СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Общие настройки'");
	СтрокаТЗ = Процессы.Добавить();
	СтрокаТЗ.ТипНастройки = "ЗапрещатьИзменениеДанныхПрошлыхПериодов";
	СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Запрещать изменение данных прошлых периодов'");
	СтрокаТЗ = Процессы.Добавить();
	СтрокаТЗ.ТипНастройки = "ХранитьИсториюИзменений";
	СтрокаТЗ.ЗаголовокНастройки = НСтр("ru = 'Хранить историю изменений'");
	
