		ИНАЧЕ Свойства.НаборСвойств.Родитель.Наименование + " (" + Свойства.НаборСвойств.Наименование + ")"
	КОНЕЦ КАК НаборСвойствГруппировка,
	Свойства.НаборСвойств,
	Свойства.ДополнительныеЗначенияИспользуются,
