	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникНастройкиИнтеграцииСИнтернетМагазином.Ссылка КАК Ссылка,
	СправочникНастройкиИнтеграцииСИнтернетМагазином.Наименование КАК Наименование,
	СправочникНастройкиИнтеграцииСИнтернетМагазином.ТипИсточникаИнтеграции КАК ТипИсточникаИнтеграции,
	СправочникНастройкиИнтеграцииСИнтернетМагазином.ТипСайта КАК ТипСайта,
	СостоянияОбменовИнтернетМагазинаВыгрузка.ДатаОкончания КАК ДатаВыгрузки,
	ВЫБОР
		КОГДА СостоянияОбменовИнтернетМагазинаВыгрузка.РезультатВыполненияОбмена = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.Выполнено)
			ТОГДА 0
		КОГДА СостоянияОбменовИнтернетМагазинаВыгрузка.РезультатВыполненияОбмена ЕСТЬ NULL
			Тогда 1
		КОГДА СостоянияОбменовИнтернетМагазинаВыгрузка.РезультатВыполненияОбмена = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.Предупреждение_СообщениеОбменаБылоРанееПринято)
			ТОГДА 1
		КОГДА СостоянияОбменовИнтернетМагазинаВыгрузка.РезультатВыполненияОбмена = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.ВыполненоСПредупреждениями)
			ТОГДА 1
		ИНАЧЕ 2
	КОНЕЦ КАК РезультатВыгрузки,
	СостоянияОбменовИнтернетМагазинаЗагрузка.ДатаОкончания КАК ДатаЗагрузки,
	ВЫБОР
		КОГДА СостоянияОбменовИнтернетМагазинаЗагрузка.РезультатВыполненияОбмена = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.Выполнено)
			ТОГДА 0
		КОГДА СостоянияОбменовИнтернетМагазинаЗагрузка.РезультатВыполненияОбмена ЕСТЬ NULL
			ТОГДА 1
		КОГДА СостоянияОбменовИнтернетМагазинаЗагрузка.РезультатВыполненияОбмена = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.Предупреждение_СообщениеОбменаБылоРанееПринято)
			ТОГДА 1
		КОГДА СостоянияОбменовИнтернетМагазинаЗагрузка.РезультатВыполненияОбмена = ЗНАЧЕНИЕ(Перечисление.РезультатыВыполненияОбмена.ВыполненоСПредупреждениями)
			ТОГДА 1
		ИНАЧЕ 2
	КОНЕЦ КАК РезультатЗагрузки,
	СостоянияУспешныхОбменовИнтернетМагазинаЗагрузка.ДатаОкончания КАК ДатаУспешнойЗагрузки,
	СостоянияУспешныхОбменовИнтернетМагазинаВыгрузка.ДатаОкончания КАК ДатаУспешнойВыгрузки
ИЗ
	Справочник.НастройкиИнтеграцииСИнтернетМагазином КАК СправочникНастройкиИнтеграцииСИнтернетМагазином
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОбменовИнтернетМагазина КАК СостоянияОбменовИнтернетМагазинаВыгрузка
		ПО СправочникНастройкиИнтеграцииСИнтернетМагазином.Ссылка = СостоянияОбменовИнтернетМагазинаВыгрузка.НастройкаИнтеграции
			И (СостоянияОбменовИнтернетМагазинаВыгрузка.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОбменовИнтернетМагазина КАК СостоянияОбменовИнтернетМагазинаЗагрузка
		ПО СправочникНастройкиИнтеграцииСИнтернетМагазином.Ссылка = СостоянияОбменовИнтернетМагазинаЗагрузка.НастройкаИнтеграции
			И (СостоянияОбменовИнтернетМагазинаЗагрузка.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияУспешныхОбменовИнтернетМагазина КАК СостоянияУспешныхОбменовИнтернетМагазинаЗагрузка
		ПО СправочникНастройкиИнтеграцииСИнтернетМагазином.Ссылка = СостоянияУспешныхОбменовИнтернетМагазинаЗагрузка.НастройкаИнтеграции
			И (СостоянияУспешныхОбменовИнтернетМагазинаЗагрузка.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ЗагрузкаДанных))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияУспешныхОбменовИнтернетМагазина КАК СостоянияУспешныхОбменовИнтернетМагазинаВыгрузка
		ПО СправочникНастройкиИнтеграцииСИнтернетМагазином.Ссылка = СостоянияУспешныхОбменовИнтернетМагазинаВыгрузка.НастройкаИнтеграции
			И (СостоянияУспешныхОбменовИнтернетМагазинаВыгрузка.ДействиеПриОбмене = ЗНАЧЕНИЕ(Перечисление.ДействияПриОбмене.ВыгрузкаДанных))</QueryText>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>СкладДляПодстановкиВЗаказы</dcssch:dataPath>
					<dcssch:field>СкладДляПодстановкиВЗаказы</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>КаталогВыгрузки</dcssch:dataPath>
					<dcssch:field>КаталогВыгрузки</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ДатаУспешнойЗагрузки</dcssch:dataPath>
					<dcssch:field>ДатаУспешнойЗагрузки</dcssch:field>
					<dcssch:title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Дата успешной загрузки</v8:content>
						</v8:item>
					</dcssch:title>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>Код</dcssch:dataPath>
					<dcssch:field>Код</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>КлючИнтеграции</dcssch:dataPath>
					<dcssch:field>КлючИнтеграции</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ПодчиненныеДокументы</dcssch:dataPath>
					<dcssch:field>ПодчиненныеДокументы</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>НастройкиВыгрузкиДопРеквизитовНоменклатуры</dcssch:dataPath>
					<dcssch:field>НастройкиВыгрузкиДопРеквизитовНоменклатуры</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ВыгружатьКартинки</dcssch:dataPath>
					<dcssch:field>ВыгружатьКартинки</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ВидЗаказа</dcssch:dataPath>
					<dcssch:field>ВидЗаказа</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ФайлЗагрузки</dcssch:dataPath>
					<dcssch:field>ФайлЗагрузки</dcssch:field>
