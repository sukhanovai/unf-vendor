
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	ПараметрыКонтактнойИнформации = УправлениеКонтактнойИнформацией.ПараметрыКонтактнойИнформации();
	ПараметрыКонтактнойИнформации.ИмяЭлементаДляРазмещения = Элементы.КонтактнаяИнформация.Имя;
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, Объект, ПараметрыКонтактнойИнформации);
	
	УстановитьПривилегированныйРежим(Истина);
	ПараметрыКонтактнойИнформации = УправлениеКонтактнойИнформацией.ПараметрыКонтактнойИнформации();
	ПараметрыКонтактнойИнформации.ИмяЭлементаДляРазмещения = Элементы.КонтактнаяИнформацияПокупателя.Имя;
	ПараметрыКонтактнойИнформации.РазрешитьДобавлениеПолей = Ложь;
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, Контрагент, ПараметрыКонтактнойИнформации);
	УстановитьПривилегированныйРежим(Ложь);
	Если Не ЗначениеЗаполнено(Контрагент) Или Не ЧтениеРазрешено(Контрагент) Тогда
		УдалитьКИПокупателя();
	КонецЕсли;
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = УправлениеСвойствамиУНФ.ЗаполнитьДополнительныеПараметры(Объект,
		"ДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	НаборСвойств_Справочник_Лиды = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Лиды");
	// Конец СтандартныеПодсистемы.Свойства
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаЗавершенияРаботы) Тогда
		ТекущийЭлемент = Элементы.НаименованиеКомпании;
	КонецЕсли;
	
	Параметры.Свойство("СопоставитьКонтактИАдресЭПВСобытияхПослеЗаписиОбъекта", СопоставитьКонтактИАдресЭПВСобытияхПослеЗаписиОбъекта);
	ТребуетсяОбновитьДанныеВыбораСостояния = Истина;
	
	УстановитьНастройкиКонтроляДублей();
	СозданКопированием = ЗначениеЗаполнено(Параметры.ЗначениеКопирования);
	
	Если Параметры.ЗначенияЗаполнения.Свойство("Контрагент") Тогда
		
		Контрагент = Параметры.ЗначенияЗаполнения.Контрагент;
		ПредыдущийКонтрагент = Контрагент;
		Объект.Вид = Перечисления.ВидыЛидов.ПовторноеОбращение;
		
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			
			Если ЭтоПовторныйЛидНаСервере() Тогда
				Контрагент = СвязанныйКонтрагент(Параметры.ЗначениеКопирования);
				ПредыдущийКонтрагент = Контрагент;
			КонецЕсли;
			
		КонецЕсли;
		
		ПриСозданииПриЧтенииНаСервере();
		
	КонецЕсли;
	
	ОбязательноЗаполнятьИсточникВЛидах = 
	РегистрыСведений.ОбязательностьЗаполненияРеквизитов.ОбязательностьЗаполненияРеквизита("Лид", "ИсточникПривлечения");
	
	Параметры.Свойство("ЗаписьПовторногоЛидаИзОбычногоСобытия", ЗаписьПовторногоЛидаИзОбычногоСобытия);
	Параметры.Свойство("СобытиеОснование", СобытиеОснование);
	
	СоздатьОбновитьКарточкиКИ();
	
	ОпределитьИнтерфейсПриСоздании();
	
	АдаптацияТакси();
	АдаптацияМобильныйКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
			
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЛидЗамененНаДубль Тогда
		РаботаСЛидамиКлиент.ОповеститьОбИзмененном(Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	// Обсуждения
	ОбсужденияУНФКлиент.ОбработкаОповещения(ИмяСобытия, Параметр, Источник, ЭтотОбъект, Объект.Ссылка);
	// Конец Обсуждения
	
	Если ТипЗнч(Параметр) = Тип("Массив") Тогда
		ЛидИзменен = (Параметр.Найти(Объект.Ссылка) <> Неопределено);
	ИначеЕсли ТипЗнч(Параметр) = Тип("СправочникСсылка.Лиды") Тогда
		ЛидИзменен = (Параметр = Объект.Ссылка);
	Иначе
		ЛидИзменен = Ложь;
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_КонтактЛидовКИ" И Параметр.Лид = Объект.Ссылка И ЗначениеЗаполнено(Параметр.Контакт) Тогда
		ЗаполнитьТаблицуКонтактнойИнформацииКонтактныхЛиц();
		Если НЕ Модифицированность Тогда
			Записать();
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия="Запись_СостоянияЛидов" Тогда
		ТребуетсяОбновитьДанныеВыбораСостояния = Истина;
	КонецЕсли;
	
	Если (ИмяСобытия = "Запись_Контрагент" Или ИмяСобытия = "Запись_КонтактноеЛицо") И ЭтоПовторныйЛид() Тогда
		Прочитать();
		СоздатьОбновитьКарточкиКИ();		
		Возврат;
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_ЗаказПокупателя" Или ИмяСобытия = "Запись_ЗаказНаряды" Тогда
		ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр);
	КонецЕсли;
	
	Если ИмяСобытия = РаботаСЛидамиКлиентСервер.КлючОповещения() И ЛидИзменен И Не ЛидИзмененНаФорме Тогда
		Прочитать();
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	ИмяЭлементаДляРазмещения = Элементы.КонтактнаяИнформация.Имя;
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект, ИмяЭлементаДляРазмещения);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	Контрагент = СвязанныйКонтрагент(ТекущийОбъект.Ссылка);
	ПредыдущийКонтрагент = Контрагент;
	СвязанныйКонтрагентПриОткрытии = Контрагент;
	
	СостояниеПередЗавершением = СостоянияЛидов.ПолучитьСостояниеЛидаПередЗавершением(
	ТекущийОбъект.Ссылка, Справочники.СостоянияЛидов.Завершен);
	Если СостояниеПередЗавершением = Неопределено Тогда
		ПредыдущееСостояние = ЗаполнениеОбъектовУНФ.ПолучитьСостояниеЛида();
	Иначе
		ПредыдущееСостояние = СостояниеПередЗавершением;
	КонецЕсли;
	Элементы.СостояниеЛидаРасширеннаяПодсказка.Заголовок = СтрШаблон(
	НСтр("ru='Предыдущее состояние: %1'"), ПредыдущееСостояние);
	
	ПриСозданииПриЧтенииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если СозданКопированием И Элементы.ФормаПроверитьЛидаНаДубли.Видимость Тогда
		
		Состояние(НСтр("ru='Проверка лида на дубли'"), 49);
		ПроверитьКонтрагентаНаДублиСервер();
		Состояние(НСтр("ru='Проверка лида на дубли'"), 100);
		
		ПоказатьСообщениеОДублях();
		
	КонецЕсли;
	
	Если Элементы.НаименованиеКомпании.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу
		Или Элементы.ПредставлениеВПрограмме.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу
		Или ДублиКИ.Количество() > 0 Тогда
		
		Если ЭтоПовторныйЛид() Тогда
			УдалитьЭлементыДублейКИ();
			Элементы.ПредставлениеВПрограмме.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
			Элементы.НаименованиеКомпании.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
		Иначе
			ПоказатьПредупреждениеОДублях();
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоПовторныйЛид() И Не ЗначениеЗаполнено(Объект.Наименование) Тогда
		Объект.Наименование = ЗначенияРеквизитовОбъектов(Контрагент, "Наименование");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	Если ТекущийОбъект.ЭтоНовый() Тогда
		ПараметрыЗаписи.Вставить("ЗаписьНового", Истина);
	КонецЕсли;
	
	ТегированиеОбъектов.ПередЗаписьюНаСервере(ЭтотОбъект,ТекущийОбъект);
	
	ОбработатьКонтактыЛидаПередЗаписьюНаСервере(ТекущийОбъект);
	
	Если ПроигнорированоСообщениеОДублях Тогда 
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ЭтоЗаписьДубля");
		ТекущийОбъект.ДополнительныеСвойства.Вставить("СообщениеОДублированииИнформации", СообщениеОДублированииИнформации);
	КонецЕсли;
	
	ПроигнорированоСообщениеОДублях = Ложь;
	СообщениеОДублированииИнформации = "";

	// Обсуждения
	ТекущийОбъект.ДополнительныеСвойства.Вставить("Модифицированность", Модифицированность);
	// Конец Обсуждения
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("Контрагент", Контрагент);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьДанныеКонтактныхЛиц(Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	ЗаписатьСобытиеОснование(ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.Свойство("ЗаписьНового") Тогда
		ОповеститьОЗаписиНового(Объект.Ссылка);
	КонецЕсли;
	
	РаботаСЛидамиКлиент.ОповеститьОбИзмененном(Объект.Ссылка);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	ЛидИзмененНаФорме = Истина;
	
	Если ЭтоПервичныйЛидНаСервере() Тогда
		ЗаполнитьИОбновитьКонтактныеЛица();
	КонецЕсли;
	СоздатьОбновитьКарточкиКИ();
	
	Элементы.СостояниеЛидаРасширеннаяПодсказка.Заголовок = СтрШаблон(
	НСтр("ru='Предыдущее состояние: %1'"),
	СостоянияЛидов.ПолучитьСостояниеЛидаПередЗавершением(
	ТекущийОбъект.Ссылка,
	Справочники.СостоянияЛидов.Завершен));
	
	Элементы.СостояниеЛидаРасширеннаяПодсказка.Заголовок = СтрШаблон(НСтр("ru='Предыдущее состояние: %1'"),
		СостоянияЛидов.ПолучитьСостояниеЛидаПередЗавершением(
			ТекущийОбъект.Ссылка,
			Справочники.СостоянияЛидов.Завершен));
	
	НужноОбновитьИнформациюПоКонтрагенту = ЭтоПовторныйЛидНаСервере()
	И Не ЗначениеЗаполнено(СвязанныйКонтрагентПриОткрытии);
	УправлениеФормой(НужноОбновитьИнформациюПоКонтрагенту);
	
	СвязанныйКонтрагентПриОткрытии = Контрагент;
	
	//Обсуждения
	ОбсужденияУНФ.ПослеЗаписиНаСервере(ТекущийОбъект);
	// Конец Обсуждения
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	РегистрыСведений.ОбязательностьЗаполненияРеквизитов.ПроверитьОбязательноеЗаполнениеИсточникаПривлеченияНаФорме(
	"Лид", Объект, Отказ);
	
	Если Не ЭтоПовторныйЛидНаСервере() Тогда        
		
		КИДопРеквизитов = ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.Выгрузить();
		МассивСтрокКИПокупателя =  ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.НайтиСтроки(
				Новый Структура("ИмяЭлементаДляРазмещения", "КонтактнаяИнформацияПокупателя"));
		Для Каждого Строка Из МассивСтрокКИПокупателя Цикл
			ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.Удалить(Строка);	
		КонецЦикла;		
			
		// СтандартныеПодсистемы.КонтактнаяИнформация
		УправлениеКонтактнойИнформацией.ОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, Объект, Отказ);
		// Конец СтандартныеПодсистемы.КонтактнаяИнформация
 		ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.Загрузить(КИДопРеквизитов);		
		
		ПроверитьЗаполнениеКонтактныхЛиц(Отказ);
		
		ПроверяемыйРеквизит = ПроверяемыеРеквизиты.Найти("Контрагент");
		Если ПроверяемыйРеквизит <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ПроверяемыйРеквизит);
		КонецЕсли;
		
	Иначе
