&НаСервере
Процедура УправлениеФормой(ОбновлятьИнформациюПоКонтрагенту = Истина)
	
	ОбновитьВидимостьИДоступностьЭлементов();
	ОбновитьЗаголовок();
	ОбновитьИнтерфейсГруппыРезультат();
	ОбновитьИнтерфейсГруппыЗаявок();
	ОбновитьИнтерфейсПоВидуЛида();
	
	Если ОбновлятьИнформациюПоКонтрагенту Тогда
		ОбновитьИнтерфейсПоКонтрагенту();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьИнтерфейсПриСоздании()
	
	ОбновитьОтображениеКнопокЗаявок();
	
	Элементы.Запись.Видимость = ПланироватьЗагрузкуРесурсовПредприятияЖурналЗаписи;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьИДоступностьЭлементов()
	
	МожноРедактировать = ПравоДоступа("Редактирование", Метаданные.Справочники.Лиды);
	ЭтоНекачественныйЛид = ЭтоНекачественныйЛид();
	ЛидПереведенВПокупателя = ЛидПереведенВПокупателя();
	ЛидЗавершен = ЭтоНекачественныйЛид Или ЛидПереведенВПокупателя;
	
	Если ЛидЗавершен Тогда
		Элементы.СостояниеЛида.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	Иначе
		Элементы.СостояниеЛида.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	КонецЕсли;
	
	ТолькоПросмотр = ЛидПереведенВПокупателя ИЛИ НЕ МожноРедактировать;
	
	Элементы.ОЛиде.ТолькоПросмотр = ЭтоНекачественныйЛид;
	Элементы.КонтактнаяИнформация.ТолькоПросмотр = ЭтоНекачественныйЛид;
	Элементы.КонтактнаяИнформацияПокупателяОбертка.ТолькоПросмотр = ЭтоНекачественныйЛид;
	Элементы.КолонкаСправа.ТолькоПросмотр = ЭтоНекачественныйЛид;
	Элементы.СтраницаДополнительно.ТолькоПросмотр = ЭтоНекачественныйЛид;
	Элементы.Комментарий.ТолькоПросмотр = ЭтоНекачественныйЛид;
	
	Элементы.ПодменюЗаявки.Доступность = Не ЛидЗавершен;
	
	Элементы.ПоказатьПомеченныеНаУдалениеКонтакты.Видимость = ЕстьУдаленныеКонтакты();
	Элементы.ФормаПроверитьЛидаНаДубли.Видимость = ПроверятьПредставлениеНаДубли ИЛИ ПроверятьАдресЭПНаДубли
	ИЛИ ПроверятьНомерТелефонаНаДубли ИЛИ ПроверятьЮрНазваниеНаДубли;
	
	Если ОбязательноЗаполнятьИсточникВЛидах Тогда
		Элементы.ИсточникПривлечения.АвтоОтметкаНезаполненного = Истина;
	КонецЕсли;
	
	Если ЛидЗавершен Тогда
		Элементы.Контрагент.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	Иначе
		Элементы.Контрагент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовок()
	
	Если Объект.Ссылка.Пустая() Тогда
		Заголовок = НСтр("ru = 'Лид (создание)'");
	ИначеЕсли ЭтоПовторныйЛидНаСервере() Тогда
		Заголовок = СтрШаблон(НСтр("ru = '%1 (Лид: Повторное обращение)'"), Объект.Ссылка);
	Иначе
		Заголовок = СтрШаблон(НСтр("ru = '%1 (Лид: Первичное обращение)'"), Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнтерфейсПоВидуЛида()
	
	ЭтоПовторныйЛид = ЭтоПовторныйЛидНаСервере();
	
	Элементы.СтраницаПовторноеОбращение.Видимость = ЭтоПовторныйЛид;
	Элементы.СтраницаПервичноеОбращение.Видимость = Не ЭтоПовторныйЛид;
	
	Элементы.ФормаПроверитьЛидаНаДубли.Видимость = Не ЭтоПовторныйЛид;
	Элементы.ГруппаКонтактыКонтрагентаОбертка.Видимость = ЭтоПовторныйЛид;
	Элементы.КонтактнаяИнформацияПокупателяОбертка.Видимость = ЭтоПовторныйЛид;
	Элементы.КонтактнаяИнформация.Видимость = Не ЭтоПовторныйЛид;
	Элементы.ГруппаКонтактыКомандыПервичный.Видимость = Не ЭтоПовторныйЛид;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнтерфейсПоКонтрагенту()
	
	ОбновитьКИПокупателя();
	ОбновитьСсылкуНаЛидовПокупателяВРаботе();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнтерфейсГруппыРезультат()
	
	ЭтоНекачественныйЛид = ЭтоНекачественныйЛид();
	ЛидПереведенВПокупателя = ЛидПереведенВПокупателя();
	ЛидЗавершен = ЭтоНекачественныйЛид ИЛИ ЛидПереведенВПокупателя;
	
	Если ЛидЗавершен Тогда
		
		Элементы.ГруппаЗавершенияРаботы.Заголовок = СтрШаблон(НСтр("ru='Работа с лидом завершена %1'"),
		Формат(Объект.ДатаЗавершенияРаботы,"ДЛФ=Д"));
		
	Иначе
		
		Элементы.ГруппаЗавершенияРаботы.Заголовок = НСтр("ru='Завершение работы с лидом'");
		
	КонецЕсли;
	
	Если ЛидПереведенВПокупателя Тогда
		
		УстановитьТекущуюСтраницуНаСервере(Элементы.СтраницыЗавершенияРаботы, Элементы.СтраницаКачественныйЛид);
		ОбновитьОтображениеРезультатаКачественногоЛида();
		
	ИначеЕсли ЭтоНекачественныйЛид Тогда
		
		УстановитьТекущуюСтраницуНаСервере(Элементы.СтраницыЗавершенияРаботы, Элементы.СтраницаНекачественныйЛид);
		ОбновитьОтображениеРезультатаНекачественногоЛида();
		
	Иначе
		
		Элементы.ГруппаЗавершенияРаботы.Видимость = Ложь;
		
	КонецЕсли;
	
	ОбновитьКнопкиПереводаКачественногоЛида();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнтерфейсГруппыЗаявок()
	
	ИспользуютсяЗаявкиДляЗаказовНаПродажу = ИспользованиеЗаявок.ЗаказНаПродажу;
	ИспользуютсяЗаявкиДляЗаказНарядов = ИспользованиеЗаявок.ЗаказНаряд;
	
	Если Не ИспользуютсяЗаявкиДляЗаказовНаПродажу И Не ИспользуютсяЗаявкиДляЗаказНарядов Тогда
		Элементы.ГруппаЗаявки.Видимость = Ложь;
		Возврат;
	Иначе
		Элементы.ГруппаЗаявки.Видимость = Истина;
	КонецЕсли;
	
	КоличестваЗаявок = РаботаСЗаявками.ДанныеКоличестваЗаявокЛида();
	
	Если ИспользуютсяЗаявкиДляЗаказовНаПродажу И ИспользуютсяЗаявкиДляЗаказНарядов Тогда
		
		КоличествоЗаявок = РаботаСЗаявками.КоличествоЗаявокЛида(Объект.Ссылка);
		КоличествоЗаявокЗаказовПокупателей = КоличествоЗаявок[Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу];
		КоличествоЗаявокЗаказНарядов = КоличествоЗаявок[Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд];
		
	ИначеЕсли ИспользуютсяЗаявкиДляЗаказовНаПродажу Тогда
		
		КоличествоЗаявокЗаказовПокупателей = РаботаСЗаявками.КоличествоЗаявокЛида(
		Объект.Ссылка, Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу);
		КоличествоЗаявокЗаказНарядов = КоличестваЗаявок;
		
	Иначе
		
		КоличествоЗаявокЗаказовПокупателей = КоличестваЗаявок;
		КоличествоЗаявокЗаказНарядов = РаботаСЗаявками.КоличествоЗаявокЛида(
		Объект.Ссылка, Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд);
		
	КонецЕсли;
	
	Элементы.ЗаявкиЗаказыПокупателей.Видимость = ИспользуютсяЗаявкиДляЗаказовНаПродажу;
	Элементы.ЗаявкиЗаказНаряды.Видимость = ИспользуютсяЗаявкиДляЗаказНарядов;
	
	Если ИспользуютсяЗаявкиДляЗаказовНаПродажу Тогда
		ЗаявкиЗаказыПокупателей = ЗаголовокПредставленияКоличестваЗаявок(КоличествоЗаявокЗаказовПокупателей);
	КонецЕсли;
	Если ИспользуютсяЗаявкиДляЗаказНарядов Тогда
		ЗаявкиЗаказНаряды = ЗаголовокПредставленияКоличестваЗаявок(КоличествоЗаявокЗаказНарядов);
	КонецЕсли;
	
	ПоказатьОтменуЗаявок =
	ЗначениеЗаполнено(Объект.ВариантЗавершения)
	И (КоличествоЗаявокЗаказовПокупателей.КоличествоЗаявокВРаботе
	Или КоличествоЗаявокЗаказНарядов.КоличествоЗаявокВРаботе);
	
	Элементы.ОтменитьВсеЗаявкиВРаботе.Видимость = ПоказатьОтменуЗаявок;
	
КонецПроцедуры

&НаСервере
Функция ЗаголовокПредставленияКоличестваЗаявок(КоличестваЗаявок)
	
	Если КоличестваЗаявок.КоличествоОтмененныхЗаявок Тогда
		
		ПредставлениеОтмененныхЗаявок = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';%1 отмененная;;%1 отмененных;%1 отмененных;%1 отмененных'"),
		КоличестваЗаявок.КоличествоОтмененныхЗаявок);
		
	КонецЕсли;
	
	Если КоличестваЗаявок.КоличествоЗаявокВРаботе И КоличестваЗаявок.КоличествоОтмененныхЗаявок Тогда
		Возврат СтрШаблон("%1 в работе, %2", КоличестваЗаявок.КоличествоЗаявокВРаботе, ПредставлениеОтмененныхЗаявок);
	ИначеЕсли КоличестваЗаявок.КоличествоЗаявокВРаботе Тогда
		Возврат СтрШаблон("%1 в работе", КоличестваЗаявок.КоличествоЗаявокВРаботе);
	ИначеЕсли КоличестваЗаявок.КоличествоОтмененныхЗаявок Тогда
		Возврат ПредставлениеОтмененныхЗаявок;
	Иначе
		Возврат НСтр("ru = 'Нет заявок в работе'");
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область РаботаСПовторнымОбращением

&НаСервере
Процедура ОбновитьСсылкуНаЛидовПокупателяВРаботе()
	
	Если ЗначениеЗаполнено(Контрагент) И ЧтениеРазрешено(Контрагент) Тогда
		Элементы.Контрагент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	Иначе
		Элементы.Контрагент.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
		Возврат;
	КонецЕсли;
	
	Элементы.Контрагент.РасширеннаяПодсказка.Заголовок = Справочники.Контрагенты.ПредставлениеЛидовКонтрагента(Контрагент);
	Если ПустаяСтрока(Элементы.Контрагент.РасширеннаяПодсказка.Заголовок) Тогда
		Элементы.Контрагент.РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Нет лидов'")
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКИПокупателя()

	Для Каждого Элемент Из Элементы.КонтактнаяИнформацияПокупателя.ПодчиненныеЭлементы Цикл
		Элемент.Видимость = Истина;
	КонецЦикла;
	
	ВидимостьКИПокупателя = Ложь;
	ВидимостьОтсутствияПокупателя = Ложь;
	ВидимостьНедоступностиПокупателя = Ложь;
	
	Если Не ЧтениеРазрешено(Контрагент) Тогда
		ВидимостьНедоступностиПокупателя = Истина;
		УдалитьКИПокупателя();
	ИначеЕсли Не ЗначениеЗаполнено(Контрагент) Тогда
		ВидимостьОтсутствияПокупателя = Истина;
		УдалитьКИПокупателя();
	Иначе
		
		ВидимостьКИПокупателя = Истина;
		
		УстановитьПривилегированныйРежим(Истина);
		// СтандартныеПодсистемы.КонтактнаяИнформация
		ИмяЭлементаДляРазмещения = Элементы.КонтактнаяИнформацияПокупателя.Имя;
		УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, Контрагент, ИмяЭлементаДляРазмещения);
		// Конец СтандартныеПодсистемы.КонтактнаяИнформация
		УстановитьПривилегированныйРежим(Ложь);
		
		ОбновитьКонтактыПокупателя();
		
	КонецЕсли;
	
	Элементы.КонтактнаяИнформацияПокупателя.Видимость = ВидимостьКИПокупателя;
	Элементы.ПокупательНеВыбран.Видимость = ВидимостьОтсутствияПокупателя;
	Элементы.ПокупательНеНайден.Видимость = ВидимостьНедоступностиПокупателя;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьКИПокупателя()
	
	Для Каждого Элемент Из Элементы.КонтактнаяИнформацияПокупателя.ПодчиненныеЭлементы Цикл
		Элемент.Видимость = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКонтактыПокупателя()
	
	ЗаполнитьТаблицуКонтактовПокупателя();
	ОбновитьКонтактыПокупателяНаФорме();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуКонтактовПокупателя()
	
	ДанныеКонтактныхЛицПокупателя.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СвязиКонтрагентКонтактСрезПервых.Контакт КАК Контакт,
		|	СвязиКонтрагентКонтактСрезПервых.Порядок КАК Порядок
		|ПОМЕСТИТЬ втПорядокКонтактовКонтрагента
		|ИЗ
		|	РегистрСведений.СвязиКонтрагентКонтакт.СрезПервых(, Контрагент = &Контрагент) КАК СвязиКонтрагентКонтактСрезПервых
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактныеЛица.Ссылка КАК КонтактноеЛицо,
		|	СвязиКонтрагентКонтакт.Контрагент КАК Владелец,
		|	СвязиКонтрагентКонтакт.Должность КАК Должность,
		|	КонтактныеЛица.Наименование КАК Наименование,
		|	втПорядокКонтактовКонтрагента.Порядок КАК РеквизитДопУпорядочивания
		|ПОМЕСТИТЬ втКонтакты
		|ИЗ
		|	РегистрСведений.СвязиКонтрагентКонтакт.СрезПоследних(, Контрагент = &Контрагент) КАК СвязиКонтрагентКонтакт
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПорядокКонтактовКонтрагента КАК втПорядокКонтактовКонтрагента
		|		ПО (втПорядокКонтактовКонтрагента.Контакт = СвязиКонтрагентКонтакт.Контакт)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛица КАК КонтактныеЛица
		|		ПО СвязиКонтрагентКонтакт.Контакт = КонтактныеЛица.Ссылка
		|ГДЕ
		|	КонтактныеЛица.Недействителен = ЛОЖЬ
		|	И СвязиКонтрагентКонтакт.СвязьНедействительна = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Контрагенты.КонтактноеЛицо КАК КонтактноеЛицо,
		|	Контрагенты.КонтактноеЛицоПодписант КАК КонтактноеЛицоПодписант
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втКонтакты.КонтактноеЛицо КАК КонтактноеЛицо,
		|	втКонтакты.Наименование КАК Наименование,
		|	втКонтакты.Должность КАК Должность
		|ИЗ
		|	втКонтакты КАК втКонтакты
		|
		|УПОРЯДОЧИТЬ ПО
		|	втКонтакты.РеквизитДопУпорядочивания,
		|	Наименование";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДанныхКонтрагента = РезультатыЗапроса[2].Выбрать();
	ВыборкаДанныхКонтрагента.Следующий();
	
	ВыборкаКонтактов = РезультатыЗапроса[3].Выбрать();
	Пока ВыборкаКонтактов.Следующий() Цикл
		
		СтрокаТЗ = ДанныеКонтактныхЛицПокупателя.Добавить();
		СтрокаТЗ.Ссылка = ВыборкаКонтактов.КонтактноеЛицо;
		СтрокаТЗ.КонтактноеЛицо = ВыборкаКонтактов.КонтактноеЛицо;
		СтрокаТЗ.Наименование = ВыборкаКонтактов.Наименование;
		СтрокаТЗ.Должность = ВыборкаКонтактов.Должность;
		СтрокаТЗ.Основной = (ВыборкаДанныхКонтрагента.КонтактноеЛицо = ВыборкаКонтактов.КонтактноеЛицо);
		СтрокаТЗ.Подписант = (ВыборкаДанныхКонтрагента.КонтактноеЛицоПодписант = ВыборкаКонтактов.КонтактноеЛицо);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКонтактыПокупателяНаФорме(Знач ИндексОбновляемогоКонтакта = Неопределено)
	
	КоличествоКонтактовПокупателя = ДанныеКонтактныхЛицПокупателя.Количество();
	
	Если КоличествоКонтактовПокупателя = 0 Тогда
		
		УстановитьТекущуюСтраницуНаСервере(Элементы.СтраницыКонтактыПокупателя, Элементы.СтраницаНетКонтактовПокупателя);
		Возврат;
		
	КонецЕсли;
	
	УстановитьТекущуюСтраницуНаСервере(Элементы.СтраницыКонтактыПокупателя, Элементы.СтраницаКонтактыПокупателя);
	
	Возврат;
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	ОбновитьИнтерфейсПоКонтрагенту();
	
	Если Не Элементы.ПеревестиЛида.Доступность Тогда
		ОбновитьКнопкиПереводаКачественногоЛида();
	КонецЕсли;
	
	СоздатьОбновитьКарточкиКИ();
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоПовторныйЛид()
	
	Возврат Объект.Вид = ПредопределенноеЗначение("Перечисление.ВидыЛидов.ПовторноеОбращение");
	
КонецФункции

&НаСервере
Функция ЭтоПовторныйЛидНаСервере()
	
	Возврат Объект.Вид = Перечисления.ВидыЛидов.ПовторноеОбращение;
	
КонецФункции

#КонецОбласти

#Область ПереводЛида

&НаСервере
Процедура ОбновитьОтображениеРезультатаКачественногоЛида()
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаЗавершенияРаботы.Видимость = Истина;
	Элементы.ГруппаЗавершенияРаботы.ЦветФона = ЦветаПалитры.Зеленый20УНФ;
	
	КонтрагентНС = ПолучитьНавигационнуюСсылку(Контрагент);
	Заказ = РегистрыСведений.СвязиКонтрагентЛид.ЗаказПоЛиду(Объект.Ссылка);
	ЕстьЗаказ = ЗначениеЗаполнено(Заказ);
	ПредставлениеКонтрагента = Строка(Контрагент);
	
	Если ЕстьЗаказ Тогда
		
		ЗаказНС = ПолучитьНавигационнуюСсылку(Заказ);
		ПредставлениеЗаказа = Строка(Заказ);
		ПредставлениеЗаказа = НРег(Сред(ПредставлениеЗаказа, 1, 1)) + Сред(ПредставлениеЗаказа, 2);
		
	КонецЕсли;
	
	Если ЭтоПервичныйЛидНаСервере() Тогда
		
		Если ЕстьЗаказ Тогда
			
			ЗаголовокРезультата = СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru = 'Качественный лид: переведен в покупателя <a href=""%1"">%2</a> и <a href=""%3"">%4</a>'"),
			КонтрагентНС, ПредставлениеКонтрагента,
			ЗаказНС, ПредставлениеЗаказа);
			
		Иначе
			
			ЗаголовокРезультата = СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru = 'Качественный лид: переведен в покупателя <a href=""%1"">%2</a>'"),
			КонтрагентНС, ПредставлениеКонтрагента);
			
		КонецЕсли;
		
		Элементы.ОтображениеПереводаКачественногоЛида.Заголовок = ЗаголовокРезультата;
		Элементы.ОтображениеПереводаКачественногоЛида1.Видимость = Ложь;
		
	Иначе
		
		Если ЕстьЗаказ Тогда
			
			ЗаголовокРезультата = СтроковыеФункции.ФорматированнаяСтрока(
			НСтр("ru = 'Переведен в <a href=""%1"">%2</a>'"),
			ЗаказНС, ПредставлениеЗаказа);
			
			Элементы.ОтображениеПереводаКачественногоЛида1.Заголовок = ЗаголовокРезультата;
			
		Иначе
			
			Элементы.ОтображениеПереводаКачественногоЛида1.Видимость = Ложь;
			
		КонецЕсли;
		
		Элементы.ОтображениеПереводаКачественногоЛида.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = 'Качественный лид от покупателя <a href=""%1"">%2</a>'"),
		КонтрагентНС, ПредставлениеКонтрагента);
		
	КонецЕсли;
	
	ПредставлениеЛидовКонтрагента = Справочники.Контрагенты.ПредставлениеЛидовКонтрагента(Контрагент);
	Если ПустаяСтрока(ПредставлениеЛидовКонтрагента) Тогда
		Элементы.ГруппаЛидыПокупателяКачественныйЛид.Видимость = Ложь;
	Иначе
		Элементы.ГруппаЛидыПокупателяКачественныйЛид.Видимость = Истина;
		ЛидыПокупателяКачественныйЛид = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = '<a href=""https://1c.ru"">%1</a>'"), ПредставлениеЛидовКонтрагента);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеРезультатаНекачественногоЛида()
	
	Элементы.ГруппаЗавершенияРаботы.Видимость = Истина;
	Элементы.ГруппаЗавершенияРаботы.ЦветФона = ЦветаПалитры.Красный20УНФ;
	
	Если ЭтоПервичныйЛидНаСервере() Тогда
		
		Элементы.ОтображениеПереводаНекачественногоЛида.Заголовок = НСтр("ru = 'Некачественный лид'");
		
	Иначе
		
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			Возврат;
		КонецЕсли;
		
		Элементы.ОтображениеПереводаНекачественногоЛида.Заголовок = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = 'Некачественный лид от <a href=""%1"">%2</a>'"),
		ПолучитьНавигационнуюСсылку(Контрагент), Строка(Контрагент));
		
	КонецЕсли;
	
	ПредставлениеЛидовКонтрагента = Справочники.Контрагенты.ПредставлениеЛидовКонтрагента(Контрагент);
	Если ПустаяСтрока(ПредставлениеЛидовКонтрагента) Тогда
		Элементы.ГруппаЛидыПокупателяНекачественныйЛид.Видимость = Ложь;
	Иначе
		Элементы.ГруппаЛидыПокупателяНекачественныйЛид.Видимость = Истина;
		ЛидыПокупателяНекачественныйЛид = СтроковыеФункции.ФорматированнаяСтрока(
		НСтр("ru = '<a href=""https://1c.ru"">%1</a>'"), ПредставлениеЛидовКонтрагента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПеревестиЛида(РезультатПеревода = Неопределено)
	
	Если ЭтоПовторныйЛид() И Не ЗначениеЗаполнено(Контрагент) Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(
		НСтр("ru = 'Поле ""Покупатель"" не заполнено.'"), ,
		"Контрагент");
		Возврат;
		
	КонецЕсли;
	
	Если РезультатПеревода = Неопределено Тогда
		Если ЭтоПовторныйЛид() Тогда
			РезультатПеревода = АктивныеКнопкиПереводаЛида.КнопкаПереводаПовторногоЛида;
		Иначе
			РезультатПеревода = АктивныеКнопкиПереводаЛида.КнопкаПереводаПервичногоЛида;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеЛида = Новый Структура("Ссылка,Вид", Объект.Ссылка, Объект.Вид);
	ОтветОтСервера = ПараметрыВопросаПередПереводомЛидаНаСервере(Объект.Ссылка);
	ПоложительныйОтвет = Ждать РаботаСЛидамиКлиент.ВопросПередПереводомЛидаАсинх(
	ДанныеЛида, РезультатПеревода, ОтветОтСервера.НаличиеЗаявок);
	Если Не ПоложительныйОтвет Тогда
		Возврат;
	КонецЕсли;
	
	ОтветОтСервера = ПеревестиЛидаНаСервере(РезультатПеревода);
	Если Не ЗначениеЗаполнено(ОтветОтСервера) Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСЛидамиКлиент.ОповеститьОбИзмененном(ОтветОтСервера.Лид);
	РаботаСЛидамиКлиент.ОткрытьРезультатПослеПереводаЛида(
	ОтветОтСервера.Лид, РезультатПеревода, ОтветОтСервера.Контрагент);
	
	Модифицированность = Ложь;
	Закрыть();
	
КонецПроцедуры

&НаСервере
Функция ПеревестиЛидаНаСервере(Знач РезультатПеревода)
	
	Если ЭтоПовторныйЛидНаСервере() Тогда
		Объект.Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Наименование");
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЛидОбъект = РеквизитФормыВЗначение("Объект");
	
	ТегированиеОбъектов.ПередЗаписьюНаСервере(ЭтотОбъект, ЛидОбъект);

	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ЛидОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	Если ЭтоПовторныйЛидНаСервере() Тогда
		АктивныеКнопкиПереводаЛида.КнопкаПереводаПовторногоЛида = РезультатПеревода;
	Иначе
		АктивныеКнопкиПереводаЛида.КнопкаПереводаПервичногоЛида = РезультатПеревода;
	КонецЕсли;
	
	РаботаСЛидами.СохранитьАктивныеКнопкиПереводаЛидаВХранилище(АктивныеКнопкиПереводаЛида);
	
	Возврат РаботаСЛидами.ПеревестиЛида(ЛидОбъект, Контрагент);
	
КонецФункции

&НаСервере
Процедура ПеревестиВНекачественныйЛидСервер()
	
	Если ЭтоПовторныйЛидНаСервере() Тогда
		Объект.Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Наименование");
	КонецЕсли;
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Записать();
	
	Объект.ДатаЗавершенияРаботы = ТекущаяДатаСеанса();
	Объект.ВариантЗавершения = Перечисления.ВариантЗавершенияРаботыСЛидом.НекачественныйЛид;
	Объект.СостояниеЛида = Справочники.СостоянияЛидов.Завершен;
	
	Элементы.СостояниеЛидаРасширеннаяПодсказка.Заголовок = СтрШаблон(НСтр("ru='Предыдущее состояние: %1'"),
	СостоянияЛидов.ПолучитьСостояниеЛидаПередЗавершением(Объект.Ссылка,
	Справочники.СостоянияЛидов.Завершен));
	
	Модифицированность = Истина;
	ОбновитьВидимостьИДоступностьЭлементов();
	ОбновитьИнтерфейсГруппыРезультат();
	ОбновитьИнтерфейсГруппыЗаявок();
	
КонецПроцедуры

&НаСервере
Процедура ВернутьВРаботуСервер()
	
	Объект.СостояниеЛида =  СостоянияЛидов.ПолучитьСостояниеЛидаПередЗавершением(
	Объект.Ссылка, Справочники.СостоянияЛидов.Завершен);
	
	Объект.ПричинаНеуспешногоЗавершенияРаботы = Неопределено;
	Объект.ВариантЗавершения = Неопределено;
	Объект.ДатаЗавершенияРаботы = Дата('00010101');
	Объект.ЗаметкиЗавершенияРаботы = Неопределено;
	
	ОбновитьВидимостьИДоступностьЭлементов();
	ОбновитьИнтерфейсГруппыРезультат();
	ОбновитьИнтерфейсГруппыЗаявок();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВопросПереводВНекачественного(Результат,ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ПеревестиВНекачественныйЛидСервер();
	
КонецПроцедуры

&НаСервере
Функция ЛидПереведенВПокупателя()
	
	Возврат ЗначениеЗаполнено(Объект.ДатаЗавершенияРаботы) 
	И Объект.ВариантЗавершения = Перечисления.ВариантЗавершенияРаботыСЛидом.ПереведенВПокупателя;
	
КонецФункции

&НаСервере
Функция ЭтоНекачественныйЛид()
	
	Возврат ЗначениеЗаполнено(Объект.ПричинаНеуспешногоЗавершенияРаботы)
	ИЛИ Объект.ВариантЗавершения = Перечисления.ВариантЗавершенияРаботыСЛидом.НекачественныйЛид;
	
КонецФункции

&НаСервере
Процедура ОбновитьКнопкиПереводаКачественногоЛида()
	
	ЭтоНекачественныйЛид = ЭтоНекачественныйЛид();
	ЛидПереведенВПокупателя = ЛидПереведенВПокупателя();
	ЛидЗавершен = ЭтоНекачественныйЛид ИЛИ ЛидПереведенВПокупателя;
	
	Если АктивныеКнопкиПереводаЛида = Неопределено Тогда
		АктивныеКнопкиПереводаЛида = РаботаСЛидами.АктивныеКнопкиПереводаЛидаИзХранилища();
	КонецЕсли;
	
	Элементы.ПеревестиЛида.Видимость = Не ЛидЗавершен;
	Элементы.ПодменюПереводаЛида.Видимость = Не ЛидЗавершен;
	Элементы.ФормаПеревестиВПокупателя.Видимость = Ложь;
	Элементы.ФормаПеревестиВЗаказПокупателя.Видимость = Ложь;
	Элементы.ФормаПеревестиВЗаказНаряд.Видимость = Ложь;
	
	Если ЭтоИнтерфейсТакси Тогда
		Элементы.ФормаПеревестиВПокупателя.Заголовок = НСтр("ru = 'Покупателя'");
		Элементы.ФормаПеревестиВЗаказПокупателя.Заголовок = НСтр("ru = 'Заказ покупателя'");
		Элементы.ФормаПеревестиВЗаказНаряд.Заголовок = НСтр("ru = 'Заказ-наряд'");
	КонецЕсли;
	
	Если ЭтоПовторныйЛидНаСервере() Тогда
		
		Если ИспользоватьПодсистемуРаботы Тогда
			
			Элементы.ПодменюПереводаЛида.Видимость = Не ЛидЗавершен;
			
			Элементы.ФормаПеревестиВЗаказПокупателя.Видимость = Истина;
			Элементы.ФормаПеревестиВЗаказНаряд.Видимость = Истина;
			
			Если ЭтоИнтерфейсТакси Тогда
				Элементы.ФормаПеревестиВЗаказПокупателя.Заголовок = НСтр("ru = 'Заказ покупателя'");
				Элементы.ФормаПеревестиВЗаказНаряд.Заголовок = НСтр("ru = 'Заказ-наряд'");
			Иначе
				Элементы.ФормаПеревестиВЗаказПокупателя.Заголовок = НСтр("ru = 'Перевести в заказ покупателя'");
				Элементы.ФормаПеревестиВЗаказНаряд.Заголовок = НСтр("ru = 'Перевести в заказ-наряд'");
			КонецЕсли;
			
			КнопкаПереводаПовторногоЛида = АктивныеКнопкиПереводаЛида.КнопкаПереводаПовторногоЛида;
			Если КнопкаПереводаПовторногоЛида = "ЗаказНаряд" Тогда
				ЗаголовокКнопкиПеревода = НСтр("ru = 'Перевести в заказ-наряд'");
				Элементы.ФормаПеревестиВЗаказНаряд.Видимость = Ложь;
			Иначе
				ЗаголовокКнопкиПеревода = НСтр("ru = 'Перевести в заказ покупателя'");
				Элементы.ФормаПеревестиВЗаказПокупателя.Видимость = Ложь;
			КонецЕсли;
			
		Иначе
			
			Элементы.ПодменюПереводаЛида.Видимость = Ложь;
			СписокВыбораПереводаЛида.Очистить();
			
			ЗаголовокКнопкиПеревода = НСтр("ru = 'Перевести в заказ покупателя'");
			
		КонецЕсли;
		
		КонтрагентДоступен = Не ЗначениеЗаполнено(Контрагент) Или ЧтениеРазрешено(Контрагент);
		
		Элементы.ПеревестиЛида.Доступность = КонтрагентДоступен И Не ТолькоПросмотр;
		Элементы.ПодменюПереводаЛида.Доступность = КонтрагентДоступен И Не ТолькоПросмотр;
		
	Иначе
		
		Элементы.ПодменюПереводаЛида.Видимость = Не ЛидЗавершен;
		
		Элементы.ФормаПеревестиВПокупателя.Видимость = Истина;
		Элементы.ФормаПеревестиВЗаказПокупателя.Видимость = Истина;
		Если ИспользоватьПодсистемуРаботы Тогда
			Элементы.ФормаПеревестиВЗаказНаряд.Видимость = Истина;
		КонецЕсли;
		
		Если ЭтоИнтерфейсТакси Тогда
			Элементы.ФормаПеревестиВПокупателя.Заголовок = НСтр("ru = 'Покупателя'");
			Элементы.ФормаПеревестиВЗаказПокупателя.Заголовок = НСтр("ru = 'Покупателя + заказ'");
			Элементы.ФормаПеревестиВЗаказНаряд.Заголовок = НСтр("ru = 'Покупателя + заказ-наряд'");
		Иначе
			Элементы.ФормаПеревестиВПокупателя.Заголовок = НСтр("ru = 'Перевести в покупателя'");
			Элементы.ФормаПеревестиВЗаказПокупателя.Заголовок = НСтр("ru = 'Перевести в покупателя + заказ'");
			Элементы.ФормаПеревестиВЗаказНаряд.Заголовок = НСтр("ru = 'Перевести в покупателя + заказ-наряд'");
		КонецЕсли;
		
		КнопкаПереводаПервичногоЛида = АктивныеКнопкиПереводаЛида.КнопкаПереводаПервичногоЛида;
		Если КнопкаПереводаПервичногоЛида = "ЗаказПокупателя" Тогда
			ЗаголовокКнопкиПеревода = НСтр("ru = 'Перевести в покупателя + заказ'");
			Элементы.ФормаПеревестиВЗаказПокупателя.Видимость = Ложь;
		ИначеЕсли КнопкаПереводаПервичногоЛида = "ЗаказНаряд" И ИспользоватьПодсистемуРаботы Тогда
			ЗаголовокКнопкиПеревода = НСтр("ru = 'Перевести в покупателя + заказ-наряд'");
			Элементы.ФормаПеревестиВЗаказНаряд.Видимость = Ложь;
		Иначе
			ЗаголовокКнопкиПеревода = НСтр("ru = 'Перевести в покупателя'");
			Элементы.ФормаПеревестиВПокупателя.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ПеревестиЛида.Заголовок = ЗаголовокКнопкиПеревода;
	
	Элементы.НекачественныйЛид.Видимость = Не ЛидЗавершен;
	Элементы.ВернутьВРаботу.Видимость = ЭтоНекачественныйЛид;
	
КонецПроцедуры

#КонецОбласти

#Область ОбщегоНазначения

&НаСервере
Процедура УстановитьТекущуюСтраницуНаСервере(ГруппаСтраницы, ГруппаСтраница)
	
	ГруппаСтраницы.ТекущаяСтраница = ГруппаСтраница;
	
	Для Каждого Страница Из ГруппаСтраницы.ПодчиненныеЭлементы Цикл
		Страница.Видимость = Ложь;
	КонецЦикла;
	
	ГруппаСтраница.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСобытиеОснование(ТекущийОбъект)
	
	Если Не ЗначениеЗаполнено(СобытиеОснование) Или Не ЗаписьПовторногоЛидаИзОбычногоСобытия Тогда
		Возврат;
	КонецЕсли;
	
	СобытиеОбъект = СобытиеОснование.ПолучитьОбъект();
	Если СобытиеОбъект.Участники.Количество() Тогда
		СобытиеОбъект.Участники[0].Контакт = ТекущийОбъект.Ссылка;
	КонецЕсли;
	
	СобытиеОбъект.Записать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначенияРеквизитовОбъектов(Знач Ссылка, Знач Реквизиты)
	
	Если СтрНайти(Реквизиты, ",") Тогда
		Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты);
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, Реквизиты);
	
КонецФункции

#КонецОбласти

#Область Заявки

&НаКлиенте
Процедура Заявка(ВидОперации)
	
	ОтветОтСервера = ЗаявкаНаСервере(ВидОперации);
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("Лид", Объект.Ссылка);
	ПараметрыМетода.Вставить("ВидОперации", ВидОперации);
	ПараметрыМетода.Вставить("ПроверитьЗаписьЛида");
	ПараметрыМетода.Вставить("Форма", ЭтотОбъект);
	ПараметрыМетода.Вставить("ЗаявкиИспользуются", ОтветОтСервера.ЗаявкиИспользуются);
	ПараметрыМетода.Вставить("ИспользоватьВидыЗаказов", ОтветОтСервера.ИспользоватьВидыЗаказов);
	ПараметрыМетода.Вставить("Модифицированность", Модифицированность);
	РаботаСЗаявкамиКлиент.СозданиеЗаявкиНаЛидаАсинх(ПараметрыМетода);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеВПрограммеПриИзменении()
	
	Если НЕ ПроверятьПредставлениеНаДубли Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СокрЛП(Объект.Наименование)) Тогда
		Элементы.ПредставлениеВПрограмме.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
		Возврат;
	КонецЕсли;
	
	НаименованиеДляПоискаДублей = НаименованиеДляПоискаДублей(Объект.Наименование);
	ПроверитьНаДубли("Наименование");
	
КонецПроцедуры

&НаКлиенте
Процедура ДублиПоПредставлениюНажатие()
	
	ПараметрыДублей = Новый Структура;
	
	ПараметрыДублей.Вставить("Наименование", НаименованиеДляПоискаДублей);
	ПараметрыДублей.Вставить("СсылкаНаРедактируемыйОбъект", Объект.Ссылка);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьЗакрытиеФормыСпискаДублей", ЭтотОбъект);
	ОткрытьФорму("Справочник.Лиды.Форма.ФормаВыбораДублей", ПараметрыДублей, ЭтотОбъект,,,,ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаявкиНажатие(ВидОперации)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ОтветОтПользователя = Ждать ВопросАсинх(
		НСтр("ru = 'Данные еще не записаны.
		|Переход к заявкам возможен только после записи данных.
		|Данные будут записаны.'"),
		РежимДиалогаВопрос.ОКОтмена);
		
		Если ОтветОтПользователя <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	РаботаСЛидамиКлиент.ОткрытьЗаявкиПоЛиду(Объект.Ссылка, ВидОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВсеЗаявкиВРаботеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Заявки = ОтменитьВсеЗаявкиВРаботеНаСервере(Результат);
	Если Заявки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Оповестить("Запись_ЗаказПокупателя", Заявки);
	Для Каждого Заявка Из Заявки Цикл
		ОповеститьОбИзменении(Заявка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОтменитьВсеЗаявкиВРаботеНаСервере(Знач ДанныеОтмены)
	
	Заявки = РаботаСЛидами.ОтменитьВсеЗаявкиЛидаВРаботе(Объект.Ссылка, ДанныеОтмены);
	ОбновитьИнтерфейсГруппыЗаявок();
	Возврат Заявки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыВопросаПередПереводомЛидаНаСервере(Знач Лид)
	
	Результат = Новый Структура;
	Результат.Вставить("НаличиеЗаявок", РаботаСЗаявками.НаличиеЗаявокВРаботеПоЛидуПоВидуОперации(Лид));
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаявкаНаСервере(Знач ВидОперации)
	
	Результат = Новый Структура;
	
	ЗаявкиИспользуются = РаботаСЗаявками.ЗаявкиИспользуются(, ВидОперации);
	Результат.Вставить("ЗаявкиИспользуются", ЗаявкиИспользуются);
	
	Если ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу Тогда
		ИспользоватьВидыЗаказов = ПолучитьФункциональнуюОпцию("ИспользоватьВидыЗаказовПокупателей");
	Иначе
		ИспользоватьВидыЗаказов = ПолучитьФункциональнуюОпцию("ИспользоватьВидыЗаказНарядов");
	КонецЕсли;
	
	Результат.Вставить("ИспользоватьВидыЗаказов", ИспользоватьВидыЗаказов);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьОтображениеКнопокЗаявок()
	
	Элементы.ПодменюЗаявки.Видимость = ИспользоватьПодсистемуРаботы;
	Элементы.ФормаЗаявкаЗаказПокупателяОтдельная.Видимость = Не ИспользоватьПодсистемуРаботы;
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеПредставления

&НаКлиенте
Процедура ОбработкаОповещенияВыбораНаименования(ЗначениеВыбора, ДопПараметры) Экспорт
	Объект.Наименование = ЗначениеВыбора.Значение;
КонецПроцедуры

#КонецОбласти

#Область Теги

&НаКлиенте
Процедура Подключаемый_ДобавитьВведенныйТегТекст()
	
	ДобавитьВведенныйТегСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДобавитьВведенныйТег()
	
	Если ДобавлениеТега = Ложь Тогда
		Возврат;
	КонецЕсли; 
	
	ДобавлениеТега = Ложь;
	ДобавитьВведенныйТегСервер();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВведенныйТегСервер()
	
	ТегированиеОбъектов.ДобавитьВведенныйТег(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область КонтактнаяИнформацияУНФ

&НаКлиенте
Процедура ОбработатьЗакрытиеФормыКонтактаЛида(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	ЗаполнитьТаблицуКонтактнойИнформацииКонтактныхЛиц();
	СоздатьОбновитьКарточкиКИ();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДанныеПанелиКонтактнойИнформацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Объект.Вид = ПредопределенноеЗначение("Перечисление.ВидыЛидов.ПервичноеОбращение") Тогда
		СтрокаКИ = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если СтрокаКИ.ТипОтображаемыхДанных = "КонтактноеЛицо" Тогда
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Ключ", СтрокаКИ.ВладелецКИ); 
			СтруктураПараметров.Вставить("БлокироватьВидимостьКодаВладельца", Истина); 
			Оповещение = Новый ОписаниеОповещения("ОбработатьЗакрытиеФормыКонтактаЛида", ЭтотОбъект);
			ОткрытьФорму("Справочник.КонтактыЛидов.Форма.ФормаЭлемента", СтруктураПараметров, ЭтотОбъект,,,, Оповещение);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	КонтактнаяИнформацияПанельУНФКлиент.ДанныеПанелиКонтактнойИнформацииВыбор(ЭтотОбъект, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтактКакСвязаться()
	
	Если КонтактКакСвязаться.ТипКИ = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
		ВидКИ = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыКонтактнойИнформации.EmailКомпанииЛида");
	ИначеЕсли КонтактКакСвязаться.ТипКИ = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
		ВидКИ = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыКонтактнойИнформации.ТелефонКомпанииЛида");
	КонецЕсли;
	Если ВидКИ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
		Объект.Наименование = КонтактКакСвязаться.Контакт;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.НаименованиеКомпании) Тогда
		Объект.НаименованиеКомпании = КонтактКакСвязаться.Контакт;
		ЗаполнитьСписокВыбораНаименования(ЭтотОбъект);
	КонецЕсли;
	
	ДанныеКИ = Новый Структура;
	ДанныеКИ.Вставить("Представление", КонтактКакСвязаться.КакСвязаться);
	ДанныеКИ.Вставить("Вид", ВидКИ);
	ДанныеКИ.Вставить("ИмяЭлементаДляРазмещения", Элементы.КонтактнаяИнформация.Имя);
	УправлениеКонтактнойИнформациейУНФ.ДобавитьКонтактнуюИнформациюНаФорму(ЭтотОбъект, Объект, ДанныеКИ);
	
	ПроверитьКонтрагентаНаДублиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияКонтактногоЛицаПриИзменении(Элемент)
	
	ОписаниеРеквизита = УправлениеКонтактнойИнформациейУНФКлиентСервер.ОписаниеРеквизитаКонтактнойИнформации(ЭтотОбъект, Элемент.Имя);
	Если ОписаниеРеквизита = Неопределено И СтрНачинаетсяС(НРег(Элемент.Имя), НРег("Комментарий")) Тогда
		ИмяЭлемента = Прав(Элемент.Имя, СтрДлина(Элемент.Имя) - СтрДлина("Комментарий"));
		ОписаниеРеквизита = УправлениеКонтактнойИнформациейУНФКлиентСервер.ОписаниеРеквизитаКонтактнойИнформации(ЭтотОбъект, ИмяЭлемента);
	КонецЕсли;
	
	Если ОписаниеРеквизита = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлементаДляРазмещения = ОписаниеРеквизита.ИмяЭлементаДляРазмещения;
	Если ИмяЭлементаДляРазмещения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(ИмяЭлементаДляРазмещения, "КонтактнаяИнформацияКонтакт_") = 0 Тогда
		// Поле контактной информации контрагента.
		Возврат;
	КонецЕсли;
	
	Индекс = СтрЗаменить(ИмяЭлементаДляРазмещения, "КонтактнаяИнформацияКонтакт_", "");
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Индекс) Тогда
		ДанныеКонтактныхЛиц[Число(Индекс)].Изменен = Истина;
	КонецЕсли;
	
	КонтактнаяИнформацияКонтактногоЛицаПриИзмененииСервер(Элемент.Имя, Индекс);
	
КонецПроцедуры

&НаСервере
Процедура КонтактнаяИнформацияКонтактногоЛицаПриИзмененииСервер(ИмяЭлемента, ИндексКЛ)
	
	ЭтоРедактированиеПоляКИ = Не СтрНачинаетсяС(НРег(ИмяЭлемента), НРег("Комментарий"));
	Если ЭтоРедактированиеПоляКИ Тогда
		
		ОписаниеКИ = УправлениеКонтактнойИнформациейУНФ.ОписаниеРеквизитаКонтактнойИнформации(ЭтотОбъект, ИмяЭлемента);
		
		ДанныеКИ = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеКИ);
		ИндексыКИ = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИндексКЛ);
		ПроверитьКИНаДубли(ДанныеКИ, ИндексыКИ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КонтактнаяИнформацияПриИзменении(ИмяЭлемента)
	
	ЭтоРедактированиеПоляКИ = Не СтрНачинаетсяС(НРег(ИмяЭлемента), НРег("Комментарий"));
	Если ЭтоРедактированиеПоляКИ Тогда
		
		ОписаниеКИ = УправлениеКонтактнойИнформациейУНФ.ОписаниеРеквизитаКонтактнойИнформации(ЭтотОбъект, ИмяЭлемента);
		
		ДанныеКИ = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеКИ);
		ИндексыКИ = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Неопределено);
		ПроверитьКИНаДубли(ДанныеКИ, ИндексыКИ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВопросДобавлениеКонтактов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Ок Тогда
		
		Записать();
		
		Возврат;
		
	ИначеЕсли Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КонтактыЛида

&НаСервере
Процедура СоздатьОбновитьКарточкиКИ() 

	ОсновнаяТаблицаСоздана = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ДанныеПанелиКонтактнойИнформации");
	Если ОсновнаяТаблицаСоздана = Ложь Тогда
		КонтактнаяИнформацияПанельУНФ.ПриСозданииНаСервере(ЭтотОбъект, "ГруппаКонтактыЛида",, Истина);
		
		НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
		ГруппаИли = РаботаСФормой.ДобавитьГруппуЭлементовОтбораКомпоновкиДанных(НовоеУсловноеОформление.Отбор, "ГруппаИЛИ");
	
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ГруппаИли, "ДанныеПанелиКонтактнойИнформации.ТипОтображаемыхДанных", "КонтактноеЛицо", ВидСравненияКомпоновкиДанных.Равно); 
		
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ГруппаИли, "ДанныеПанелиКонтактнойИнформации.ТипОтображаемыхДанных", "НетДанных", ВидСравненияКомпоновкиДанных.Равно); 
		
		ОформляемыеПоля = Новый Массив; 
		ОформляемыеПоля.Добавить("ДанныеПанелиКонтактнойИнформацииОтображениеТипаКИ");
		РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, ОформляемыеПоля);
		РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Видимость", Ложь);
		
	КонецЕсли;
	
	Элементы.ДанныеПанелиКонтактнойИнформации.ЧередованиеЦветовСтрок = Ложь;
	Элементы.ДанныеПанелиКонтактнойИнформации.ВертикальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.ИспользоватьВсегда;
	
	КоличествоКонтактовГруппа = 0;

	Если Объект.Вид = Перечисления.ВидыЛидов.ПервичноеОбращение Тогда
		Элементы.Переместить(Элементы.ДанныеПанелиКонтактнойИнформации, Элементы.ГруппаКонтактыЛида);
		ДанныеПанелиКИ = КонтактнаяИнформацияПанельУНФ.ДанныеПанелиКонтактнойИнформации(Объект.Ссылка); 
		
		ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Очистить();
		Для Каждого Строка Из ДанныеПанелиКИ Цикл     
			Если Строка.ВладелецКИ = Объект.Ссылка Тогда
				Продолжить;
			КонецЕсли; 
				
			Если ТипЗнч(Строка.ВладелецКИ) = Тип("СправочникСсылка.КонтактыЛидов") И ЗначениеЗаполнено(Строка.ВладелецКИ) Тогда			
				Пометка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.ВладелецКИ,"ПометкаУдаления");
				Если Пометка = Истина Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);  
			Если Строка.ТипОтображаемыхДанных = "КонтактноеЛицо" Тогда
				НоваяСтрока.ИндексПиктограммы = 3;
				КоличествоКонтактовГруппа = КоличествоКонтактовГруппа + 1;
			КонецЕсли;
		КонецЦикла;
		Элементы.ГруппаКонтактыЛида.Родитель.Заголовок = НСтр("ru = 'Контакты ('") + КоличествоКонтактовГруппа + ")";
		
	Иначе
		//Элементы.Переместить(Элементы.ДанныеПанелиКонтактнойИнформации, Элементы.ГруппаКонтактыКонтрагента); 
		Элементы.Переместить(Элементы.ДанныеПанелиКонтактнойИнформации, Элементы.ГруппаКонтактыЗаголовок); 
		ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Очистить();
		ДанныеПанелиКИ = КонтактнаяИнформацияПанельУНФ.ДанныеПанелиКонтактнойИнформации(Контрагент); 
		
		ОсновнойПодписант = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "КонтактноеЛицо, КонтактноеЛицоПодписант");
		МассивУникальныхВладельцев = Новый Массив;
		
		Для Каждого Строка Из ДанныеПанелиКИ Цикл     
			Если Строка.ВладелецКИ = Контрагент Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.ВладелецКИ) И МассивУникальныхВладельцев.Найти(Строка.ВладелецКИ) = Неопределено И Строка.ВладелецКИ <> Объект.Ссылка Тогда
				МассивУникальныхВладельцев.Добавить(Строка.ВладелецКИ);	
			КонецЕсли;
			
			НоваяСтрока = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);  
			Если Строка.ТипОтображаемыхДанных = "КонтактноеЛицо" Тогда
				Если НоваяСтрока.ВладелецКИ = ОсновнойПодписант.КонтактноеЛицо И НоваяСтрока.ВладелецКИ = ОсновнойПодписант.КонтактноеЛицоПодписант Тогда            
					НоваяСтрока.Отображение = НоваяСтрока.Отображение + " (основной, подписант)";	
				ИначеЕсли НоваяСтрока.ВладелецКИ = ОсновнойПодписант.КонтактноеЛицо Тогда    
					НоваяСтрока.Отображение = НоваяСтрока.Отображение + " (основной)";						
				ИначеЕсли НоваяСтрока.ВладелецКИ = ОсновнойПодписант.КонтактноеЛицоПодписант Тогда	
					НоваяСтрока.Отображение = НоваяСтрока.Отображение + " (подписант)";						
				КонецЕсли;
			КонецЕсли;
			Если Строка.ТипОтображаемыхДанных = "КонтактноеЛицо" Тогда
				НоваяСтрока.ИндексПиктограммы = 3;	
				КоличествоКонтактовГруппа = КоличествоКонтактовГруппа + 1;				
			КонецЕсли;			
		КонецЦикла; 
		Элементы.ГруппаКонтактыКонтрагента.Заголовок = НСтр("ru = 'Контакты покупателя ('") + КоличествоКонтактовГруппа + ")";
		Элементы.ГруппаКонтактыЗаголовок.Заголовок = НСтр("ru = 'Контакты покупателя ('") + КоличествоКонтактовГруппа + ")";
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СвязиКонтрагентКонтактСрезПоследних.Должность КАК Должность,
		|	СвязиКонтрагентКонтактСрезПоследних.Контакт КАК Контакт
		|ИЗ
		|	РегистрСведений.СвязиКонтрагентКонтакт.СрезПоследних(
		|			,
		|			Контрагент = &Контрагент
		|				И Контакт В (&МассивКонтактов)) КАК СвязиКонтрагентКонтактСрезПоследних";
		
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("МассивКонтактов", МассивУникальныхВладельцев);
		
		ВыборкаДолжность = Запрос.Выполнить().Выбрать();
		ЕстьДолжности = Ложь;
		Пока ВыборкаДолжность.Следующий() Цикл   
			Если ВыборкаДолжность.Должность = "" Тогда
				Продолжить;
			КонецЕсли;     
			СтрокиПорядокКИ = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.НайтиСтроки(
				Новый Структура("ТипОтображаемыхДанных, ВладелецКИ", "КонтактноеЛицо", ВыборкаДолжность.Контакт));
			Если СтрокиПорядокКИ.Количество() = 0 Тогда	   
				Продолжить;
			КонецЕсли;  

			СтрокаКИ = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Вставить(ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Индекс(СтрокиПорядокКИ[0]) + 1);  
			СтрокаКИ.ВладелецКИ = ВыборкаДолжность.Контакт;
			СтрокаКИ.ТипОтображаемыхДанных = "ЗначениеКИ";
			СтрокаКИ.Отображение = "Должность: " + ВыборкаДолжность.Должность;
			СтрокаКИ.ИндексПиктограммы = -1;
			
		КонецЦикла;
	КонецЕсли;

	Для Каждого Строка Из ЭтотОбъект.ДанныеПанелиКонтактнойИнформации Цикл
		Если Строка.ТипОтображаемыхДанных <> "КонтактноеЛицо" Тогда
			Если СтрНайти(Строка.Отображение, ": ") > 0 И Строка.ОтображениеТипаКИ = "" Тогда
				Строка.ОтображениеТипаКИ = Лев(Строка.Отображение, СтрНайти(Строка.Отображение, ":"));	
				Строка.Отображение = Сред(Строка.Отображение, СтрНайти(Строка.Отображение, ":") + 2);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;		
	
	Если КоличествоКонтактовГруппа = 0 И ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Количество() = 0 Тогда
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Отображение", НСтр("ru='<Нет контактных данных>'"));
		НоваяСтрока.Вставить("ИндексПиктограммы", -1);
		НоваяСтрока.Вставить("ТипОтображаемыхДанных", "НетДанных");
		НоваяСтрока.Вставить("ВладелецКИ", Неопределено);
		СтрокаНетКД = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНетКД, НоваяСтрока);
	КонецЕсли;
	
	Элементы.ПоказатьПомеченныеНаУдалениеКонтакты.Видимость = ЕстьУдаленныеКонтакты();
	
КонецПроцедуры

&НаСервере
Функция ЕстьУдаленныеКонтакты()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактыЛидов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтактыЛидов КАК КонтактыЛидов
	|ГДЕ
	|	КонтактыЛидов.ПометкаУдаления
	|	И Владелец = &ТекущийЛид";
	
	Запрос.УстановитьПараметр("ТекущийЛид", Объект.Ссылка);
	Результат = Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции

&НаСервере
Процедура ЗаписатьДанныеКонтактныхЛиц(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ПредыдущееЗначениеВида = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "Вид");
	
	Если ТекущийОбъект.Вид = Перечисления.ВидыЛидов.ПовторноеОбращение Тогда
		
		Если ПредыдущееЗначениеВида = Перечисления.ВидыЛидов.ПовторноеОбращение Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого ДанныеКЛ Из ДанныеКонтактныхЛиц Цикл
			
			Если Не ЗначениеЗаполнено(ДанныеКЛ.КонтактноеЛицо) Тогда
				Продолжить;
			КонецЕсли;
			
			РегистрыСведений.СвязиАдресатКонтактCRM.ОчиститьСвязи(ДанныеКЛ.КонтактноеЛицо);
			
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	Если ПредыдущееЗначениеВида = Перечисления.ВидыЛидов.ПовторноеОбращение Тогда
		
		Для Каждого ДанныеКЛ Из ДанныеКонтактныхЛиц Цикл
			
			Если Не ЗначениеЗаполнено(ДанныеКЛ.КонтактноеЛицо) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭлектроннаяПочтаУНФ.СвязатьКонтактCRMСАдресатами(ДанныеКЛ.КонтактноеЛицо.ПолучитьОбъект());
			
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого ДанныеКЛ Из ДанныеКонтактныхЛиц Цикл
		
		Если ПустаяСтрока(ДанныеКЛ.Наименование) Тогда
			УдалитьНезаполненныйКонтакт(ДанныеКЛ);
			Продолжить;
		КонецЕсли;
		
		Если НЕ ДанныеКЛ.Изменен Тогда
			Продолжить;
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Истина);
		
		Если ЗначениеЗаполнено(ДанныеКЛ.КонтактноеЛицо) Тогда
			КонтактноеЛицоОбъект = ДанныеКЛ.КонтактноеЛицо.ПолучитьОбъект();
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДанныеКЛ.КонтактноеЛицо) ИЛИ КонтактноеЛицоОбъект = Неопределено Тогда
			// Создание
			КонтактноеЛицоОбъект = Справочники.КонтактыЛидов.СоздатьЭлемент();
		КонецЕсли;
		
		КонтактноеЛицоОбъект.Владелец = ТекущийОбъект.Ссылка;
		// Внесение изменений
		ЗаполнитьЗначенияСвойств(КонтактноеЛицоОбъект, ДанныеКЛ, "Наименование");
		
		// Запись объекта
		КонтактноеЛицоОбъект.Записать();
		
		// Сохранение ссылки на созданный объект
		ДанныеКЛ.КонтактноеЛицо = КонтактноеЛицоОбъект.Ссылка;
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИОбновитьКонтактныеЛица()
	
	ЗаполнитьТаблицуКонтактнойИнформацииКонтактныхЛиц();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуКонтактнойИнформацииКонтактныхЛиц()
	
	ДанныеКонтактныхЛиц.Очистить();
	
	Отбор = Новый Структура("ПометкаУдаления");
	Упорядочивание = Новый Структура("Код,Наименование");
	КонтактныеЛица = Справочники.КонтактыЛидов.КонтактыЛида(Объект.Ссылка, Отбор, Упорядочивание);
	
	Для Каждого КонтактноеЛицо Из КонтактныеЛица Цикл
		
		ДанныеКЛ = ДанныеКонтактныхЛиц.Добавить();
		ДанныеКЛ.КонтактноеЛицо = КонтактноеЛицо.Ссылка;
		ЗаполнитьЗначенияСвойств(ДанныеКЛ, КонтактноеЛицо, "Ссылка,Наименование");
		
		Для Каждого КИ Из КонтактноеЛицо.КонтактнаяИнформация Цикл
			ДанныеКИ = ДанныеКЛ.КонтактнаяИнформация.Добавить();
			ЗаполнитьЗначенияСвойств(ДанныеКИ, КИ, "Вид,Тип,Представление,Значение");
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеКонтактныхЛиц(Отказ)
	
	// Проверка на заполненность ФИО контактного лица, если введена контактная информация
	Для Каждого ДанныеКонтактногоЛица Из ДанныеКонтактныхЛиц Цикл
		
		Если Не ПустаяСтрока(ДанныеКонтактногоЛица.Наименование) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРеквизита = "ДанныеКонтактныхЛиц[" + ДанныеКонтактныхЛиц.Индекс(ДанныеКонтактногоЛица) + "].Наименование";
		Для Каждого СтрокаТаблицы Из ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.НайтиСтроки(
				Новый Структура("ИмяЭлементаДляРазмещения",ДанныеКонтактногоЛица.ИмяЭлементаДляРазмещения)) Цикл   
			Если СтрНайти(СтрокаТаблицы.ИмяРеквизита, "КонтактнаяИнформацияКонтакт_") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Не ПустаяСтрока(СтрокаТаблицы.Значение) Или Не ПустаяСтрока(СтрокаТаблицы.Представление) Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'ФИО контакта не заполнено.'"),,,ИмяРеквизита, Отказ);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьНезаполненныйКонтакт(ДанныеКЛ)
	
	Если НЕ ЗначениеЗаполнено(ДанныеКЛ.КонтактноеЛицо) Тогда
		Возврат;
	КонецЕсли;
	
	КИНезаполнено = 0;
	Для Каждого ДанныеКИ Из ДанныеКЛ.КонтактнаяИнформация Цикл
		Если ЗначениеЗаполнено(ДанныеКИ.Значение) Тогда
			Продолжить;
		КонецЕсли;
		КИНезаполнено = КИНезаполнено + 1;
	КонецЦикла;
	
	Если КИНезаполнено <> ДанныеКЛ.КонтактнаяИнформация.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	КонтактноеЛицоОбъект = ДанныеКЛ.КонтактноеЛицо.ПолучитьОбъект();
	КонтактноеЛицоОбъект.ПометкаУдаления = Истина;	
	КонтактноеЛицоОбъект.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗакрытиеФормыКонтактов(Результат, ДополнительныеПараметры) Экспорт
	Прочитать();
	СоздатьОбновитьКарточкиКИ();
КонецПроцедуры

&НаСервере
Процедура ОбработатьКонтактыЛидаПередЗаписьюНаСервере(ТекущийОбъект)
	
	Если Не ЭтоПервичныйЛидНаСервере() Тогда
		Возврат;
	КонецЕсли;
	
	НомераТелефонов = Новый Массив;
	АдресаЭП = Новый Массив;
	
	Для Каждого СтрокаКЛ Из ДанныеКонтактныхЛиц Цикл
		Для Каждого СтрокаКИ Из СтрокаКЛ.КонтактнаяИнформация Цикл
			Если СтрокаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон И Не ПустаяСтрока(СтрокаКИ.Представление) Тогда
				НомераТелефонов.Добавить(СтрЗаменить(КонтактнаяИнформацияУНФ.ПреобразоватьТелефонДляПоиска(СтрокаКИ.Представление), "+", ""));
			КонецЕсли;
			Если СтрокаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты И Не ПустаяСтрока(СтрокаКИ.Представление) Тогда
				АдресаЭП.Добавить(СтрокаКИ.Представление);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("НомераТелефоновКонтактаЛида", НомераТелефонов);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("АдресаЭПКонтактовЛида", АдресаЭП);
	
	// Заполним информацию о записываемых контактных лицах для реквизита "ОсновныеСведения"
	ТаблицаКонтактнойИнформацииКонтактныхЛиц = КонтактнаяИнформацияУНФ.ПолучитьТаблицуКонтактнойИнформацииКонтактныхЛиц(ЭтотОбъект, Объект.Ссылка);
	ИндексКонтактногоЛица = 0;	   
	
	МассивСтрок = Новый Массив;
	Для Каждого ДанныеКЛ Из ДанныеКонтактныхЛиц Цикл
		
		Если ПустаяСтрока(ДанныеКЛ.Наименование) Тогда
			ИндексКонтактногоЛица = ИндексКонтактногоЛица + 1;			
			Продолжить;
		КонецЕсли;
		
		Если МассивСтрок.Количество() > 0 Тогда
			МассивСтрок.Добавить(Символы.ПС);
		КонецЕсли;
		
		МассивСтрок.Добавить(ДанныеКЛ.Наименование);
		
		Если ЗначениеЗаполнено(ДанныеКЛ.КонтактноеЛицо) Тогда
			СтрокиКонтактнойИнформации = ТаблицаКонтактнойИнформацииКонтактныхЛиц.НайтиСтроки(Новый Структура("КонтактноеЛицо", ДанныеКЛ.КонтактноеЛицо)); 
		Иначе
			СтрокиКонтактнойИнформации = ТаблицаКонтактнойИнформацииКонтактныхЛиц.НайтиСтроки(Новый Структура("ИндексКонтактногоЛица", 
					?(ИндексКонтактногоЛица = 0, "0", Формат(ИндексКонтактногоЛица, "ЧГ="))));
		КонецЕсли;      
		
		Для Каждого ДанныеКИ Из СтрокиКонтактнойИнформации Цикл
			Если ПустаяСтрока(ДанныеКИ.Представление) Тогда
				Продолжить;
			КонецЕсли;
			МассивСтрок.Добавить(ДанныеКИ.Представление);
		КонецЦикла;
		
		ИндексКонтактногоЛица = ИндексКонтактногоЛица + 1;

	КонецЦикла; 
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ОсновныеСведенияКонтактныхЛиц", МассивСтрок);
	
КонецПроцедуры

#КонецОбласти

#Область КонтрольДублей

&НаСервере
Процедура УстановитьНастройкиКонтроляДублей()
	
	Элементы.ПредставлениеВПрограмме.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	Элементы.НаименованиеКомпании.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	
	НастройкиКонтроляДублейЛиды = Константы.НастройкиКонтроляДублейЛиды.Получить().Получить();
	
	Если НастройкиКонтроляДублейЛиды <> Неопределено Тогда
		ПроверятьПредставлениеНаДубли = НастройкиКонтроляДублейЛиды.Получить("ПроверятьНаименование");
		ПроверятьЮрНазваниеНаДубли = НастройкиКонтроляДублейЛиды.Получить("ПроверятьЮрНазвание");
		ПроверятьНомерТелефонаНаДубли = НастройкиКонтроляДублейЛиды.Получить("ПроверятьТелефон");
		ПроверятьАдресЭПНаДубли = НастройкиКонтроляДублейЛиды.Получить("ПроверятьАдресЭП");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаДубли(Реквизит)
	
	Если Реквизит = "НаименованиеКомпании" Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.НаименованиеКомпании) Тогда
			Возврат;
		КонецЕсли;
		
		НаименованиеКомпанииДляПоискаДублей = НаименованиеДляПоискаДублей(
		ОрганизационноПравоваяФорма.НаименованиеБезОПФ);
		
	КонецЕсли;

	Если Реквизит = "Наименование" Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда
			Возврат;
		КонецЕсли;
		НаименованиеДляПоискаДублей = НаименованиеДляПоискаДублей(Объект.Наименование);
	КонецЕсли;
	
	ЗапросКонтрагенты = Новый Запрос;
	ЗапросКонтрагенты.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	(Контрагенты.НаименованиеПолное ПОДОБНО &Наименование
	|			ИЛИ Контрагенты.Наименование ПОДОБНО &Наименование)
	|	И НЕ Контрагенты.ЭтоГруппа";
	
	ЗапросКонтрагенты.УстановитьПараметр("Наименование", ЭтотОбъект[Реквизит + "ДляПоискаДублей"]);
	ЗапросКонтрагенты.УстановитьПараметр("Ссылка", Объект.Ссылка);
	УстановитьПривилегированныйРежим(Истина);
	Результат = ЗапросКонтрагенты.Выполнить();
			
	Если Результат.Пустой() Тогда
		
		ЗапросКонтакты = Новый Запрос;
		ЗапросКонтакты.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контакты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтактныеЛица КАК Контакты
		|ГДЕ
		|	Контакты.Наименование ПОДОБНО &Наименование
		|	И НЕ Контакты.ЭтоГруппа";
		
		ЗапросКонтакты.УстановитьПараметр("Наименование", ЭтотОбъект[Реквизит + "ДляПоискаДублей"]);
		Результат = ЗапросКонтакты.Выполнить();
		
		Если Результат.Пустой() Тогда
			
			ЗапросЛиды = Новый Запрос;
			ЗапросЛиды.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Лиды.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Лиды КАК Лиды
			|ГДЕ
			|	НЕ Лиды.Ссылка = &Ссылка
			|	И НЕ Лиды.ЭтоГруппа
			|	И Лиды.ВариантЗавершения <> ЗНАЧЕНИЕ(Перечисление.ВариантЗавершенияРаботыСЛидом.ПереведенВПокупателя)
			|	И Лиды.Вид <> ЗНАЧЕНИЕ(Перечисление.ВидыЛидов.ПовторноеОбращение)
			|	И (Лиды.Наименование ПОДОБНО &Наименование
			|			ИЛИ Лиды.НаименованиеКомпании ПОДОБНО &Наименование)";
			
			Если Реквизит = "Наименование" Тогда
				
				ЗапросЛиды.Текст = СтрЗаменить(ЗапросЛиды.Текст,
				"	И Лиды.Вид <> ЗНАЧЕНИЕ(Перечисление.ВидыЛидов.ПовторноеОбращение)
				|	И (Лиды.Наименование ПОДОБНО &Наименование
				|			ИЛИ Лиды.НаименованиеКомпании ПОДОБНО &Наименование)",
				"	И ВЫБОР
				|			КОГДА Лиды.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыЛидов.ПовторноеОбращение)
				|				ТОГДА Лиды.Наименование ПОДОБНО &Наименование
				|			ИНАЧЕ Лиды.Наименование ПОДОБНО &Наименование
				|					ИЛИ Лиды.НаименованиеКомпании ПОДОБНО &Наименование
				|		КОНЕЦ");
				
			КонецЕсли;
			
			ЗапросЛиды.УстановитьПараметр("Ссылка", Объект.Ссылка);
			ЗапросЛиды.УстановитьПараметр("Наименование", ЭтотОбъект[Реквизит + "ДляПоискаДублей"]);
			Результат = ЗапросЛиды.Выполнить();
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДублиНайдены = Не Результат.Пустой();
	Если ДублиНайдены Тогда
		ОтображениеПодсказкиЭлемента = ОтображениеПодсказки.ОтображатьСнизу;
	Иначе
		ОтображениеПодсказкиЭлемента = ОтображениеПодсказки.Нет;
	КонецЕсли;
	
	Если Реквизит = "НаименованиеКомпании" Тогда
		Элементы.НаименованиеКомпании.ОтображениеПодсказки = ОтображениеПодсказкиЭлемента;
	ИначеЕсли Реквизит = "Наименование" Тогда
		Элементы.ПредставлениеВПрограмме.ОтображениеПодсказки = ОтображениеПодсказкиЭлемента;
	Иначе
		Элементы["Дубли"+Реквизит].Видимость = ДублиНайдены;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаименованиеКонтактаНаДубли(ИндексыКЛ)
	
	Индекс = 0;
	КоличествоЭлементов = ИндексыКЛ.Количество();
	Пока Индекс < КоличествоЭлементов Цикл
		
		ИндексКЛ = ИндексыКЛ[Индекс];
		ПредставлениеКонтакта = ДанныеКонтактныхЛиц[ИндексКЛ].Наименование;
		
		Если НЕ ЗначениеЗаполнено(ПредставлениеКонтакта) Тогда
			ИндексыКЛ.Удалить(Индекс);
			КоличествоЭлементов = КоличествоЭлементов - 1;
			Продолжить;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Если КоличествоЭлементов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
