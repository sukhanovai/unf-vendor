&НаКлиенте
Асинх Процедура ДобавитьКонтактПервичный(Команда)
	
	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		ОтветОтПользователя = Ждать ВопросАсинх(
		НСтр("ru = 'Данные еще не записаны.
		|Продолжение добавления контактных лиц возможно только после записи данных.
		|Данные будут записаны'"),
		РежимДиалогаВопрос.ОКОтмена);
		
		Если ОтветОтПользователя <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;  
		
		Записать();
	КонецЕсли;  
	
	Если Модифицированность Или Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;  
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Владелец", Объект.Ссылка);
	СтруктураПараметров.Вставить("БлокироватьВидимостьКодаВладельца", Истина); 
	Оповещение = Новый ОписаниеОповещения("ОбработатьЗакрытиеФормыКонтактаЛида", ЭтотОбъект);
	ОткрытьФорму("Справочник.КонтактыЛидов.Форма.ФормаЭлемента", СтруктураПараметров, ЭтотОбъект,,,, Оповещение);
	
