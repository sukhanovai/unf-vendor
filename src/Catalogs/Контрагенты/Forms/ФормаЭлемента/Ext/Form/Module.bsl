			Элементы.РегистрационныйНомер1.ПодсказкаВвода	= НСтр("ru='Рег. номер в стране регистрации'");
			Элементы.РегистрационныйНомер1.ОграничениеТипа	= Новый ОписаниеТипов("Строка");
