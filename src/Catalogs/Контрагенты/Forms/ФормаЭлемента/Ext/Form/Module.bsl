			Элементы.РегистрационныйНомер.ОграничениеТипа	= Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(13));
			Элементы.РегистрационныйНомер1.Заголовок			= НСтр("ru = 'ОГРН'");
			Элементы.РегистрационныйНомер1.Подсказка			= НСтр("ru = 'Основной государственный регистрационный номер юридического лица'");
			Элементы.РегистрационныйНомер1.ПодсказкаВвода	= НСтр("ru = '13 цифр'");
