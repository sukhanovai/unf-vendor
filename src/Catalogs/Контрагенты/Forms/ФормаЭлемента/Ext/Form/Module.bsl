// ИнтернетПоддержкаПользователей.СПАРКРиски
//@skip-check module-unused-method
&НаКлиенте
Процедура Подключаемый_ОбновитьОтображениеИндексыСПАРК()
	ОбновитьОтображениеИндексыСПАРК();
КонецПроцедуры

// Обновляет отображение факторов риска СПАРК.
//
&НаКлиенте
Процедура Подключаемый_ОбновитьОтображениеФакторовРискаСПАРК()
	
	ОбновитьОтображениеФакторовРискаСПАРК();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеИндексыСПАРК()
	
	ВидКонтрагентаСПАРКРиски = СПАРКРискиКлиентСерверУНФ.ВидКонтрагентаСПАРКРиски(Объект.ВидКонтрагента);
	
	СПАРКРискиКлиент.ОтобразитьИндексыСПАРК(
	ИндексыСПАРКРиски,
	Объект,
	Объект.ИНН,
	ВидКонтрагентаСПАРКРиски,
	ЭтотОбъект,
	Новый Структура("ВариантОтображения", "Однострочный"));
	
	ЗаполнитьЗначенияСвойств(
	Элементы.КартинкаОжиданиеЗагрузкиИндексовСПАРКРиски1,
	Элементы.КартинкаОжиданиеЗагрузкиИндексовСПАРКРиски,
	"Видимость,Картинка,Подсказка");
	
	ЗаполнитьЗначенияСвойств(
	Элементы.ДекорацияИндексыСПАРКРиски1,
	Элементы.ДекорацияИндексыСПАРКРиски,
	"Видимость,Заголовок");
	
	СПАРКРискиКлиент.ОтобразитьИндексыСПАРК(
	ИндексыСПАРКРиски,
	Объект,
	Объект.ИНН,
	ВидКонтрагентаСПАРКРиски,
	ЭтотОбъект,
	Новый Структура("ВариантОтображения", "Многострочный"));
	
	ПоказатьСвоюПодсказку = Не Элементы.ДекорацияИндексыСПАРКРиски.Видимость И Не Элементы.КартинкаОжиданиеЗагрузкиИндексовСПАРКРиски.Видимость;
	Элементы.СвояПодсказка1СПАРКРиски.Видимость = ПоказатьСвоюПодсказку;
	Элементы.СвояПодсказка1СПАРКРиски1.Видимость = ПоказатьСвоюПодсказку;
	Элементы.ДекорацияЗаголовокСПАРКРиски.Видимость = ПоказатьСвоюПодсказку;
	
КонецПроцедуры 

// Обновляет отображение факторов риска СПАРК.
//
&НаКлиенте
Процедура ОбновитьОтображениеФакторовРискаСПАРК()
	
	ВидКонтрагентаСПАРКРиски = СПАРКРискиКлиентСерверУНФ.ВидКонтрагентаСПАРКРиски(Объект.ВидКонтрагента);
	ПараметрыОтображения = СПАРКРискиКлиентСервер.ПараметрыОтображенияДанныхСПАРК(); 
	СПАРКФакторыРискаКлиент.ОтобразитьФакторыРиска(
		ФакторыРискаСПАРК,
		Объект,
		Объект.ИНН,
		ЭтотОбъект,
		ПараметрыОтображения);
	
	ЗаполнитьЗначенияСвойств(
	Элементы.КартинкаОжиданиеЗагрузкиФакторовРиска1,
	Элементы.КартинкаОжиданиеЗагрузкиФакторовРиска,
	"Видимость,Картинка,Подсказка");
	
	ЗаполнитьЗначенияСвойств(
	Элементы.ДекорацияФакторыРиска1,
	Элементы.ДекорацияФакторыРиска,
	"Видимость,Заголовок");
	
	ПоказатьСвоюПодсказку = Не Элементы.ДекорацияФакторыРиска.Видимость И Не Элементы.КартинкаОжиданиеЗагрузкиФакторовРиска.Видимость;
	Элементы.СвояПодсказкаФакторовРиска.Видимость = ПоказатьСвоюПодсказку;
	Элементы.СвояПодсказкаФакторовРиска1.Видимость = ПоказатьСвоюПодсказку;
	Элементы.ДекорацияЗаголовокФакторыРиска.Видимость = ПоказатьСвоюПодсказку;
	Элементы.НазваниеГруппыУпрощеннойПодсказкиФакторыРиска.Видимость = ПоказатьСвоюПодсказку;
	
КонецПроцедуры

&НаСервере
Процедура СПАРКРискиПриСозданииНаСервере()
	
	ИспользоватьСпаркРиски = ПолучитьФункциональнуюОпцию("ИспользоватьСервисСПАРКРиски");
	Элементы.ГруппаИндексыСПАРКРиски.Видимость = ИспользоватьСпаркРиски;
	Элементы.Страница1СПАРКРиски.Видимость = ИспользоватьСпаркРиски;
	
	Если ИспользоватьСпаркРиски Тогда
		
		// ИнтернетПоддержкаПользователей.СПАРКРиски
		ВидКонтрагентаСПАРКРиски = СПАРКРискиКлиентСерверУНФ.ВидКонтрагентаСПАРКРиски(Объект.ВидКонтрагента);
		ПараметрыОтображения = СПАРКРискиКлиентСервер.ПараметрыОтображенияДанныхСПАРК();
		ПараметрыОтображения.ВариантОтображения = "Однострочный";
		
		СПАРКРиски.ПриСозданииНаСервере(
		ЭтотОбъект,
		Объект,
		Объект.Ссылка,
		ВидКонтрагентаСПАРКРиски,
		ПараметрыОтображения);
		
		ЗаполнитьЗначенияСвойств(
		Элементы.КартинкаОжиданиеЗагрузкиИндексовСПАРКРиски1,
		Элементы.КартинкаОжиданиеЗагрузкиИндексовСПАРКРиски,
		"Видимость,Картинка,Подсказка");
		
		ЗаполнитьЗначенияСвойств(
		Элементы.ДекорацияИндексыСПАРКРиски1,
		Элементы.ДекорацияИндексыСПАРКРиски,
		"Видимость,Заголовок");
		
		ЗаполнитьЗначенияСвойств(
		Элементы.КартинкаОжиданиеЗагрузкиФакторовРиска1,
		Элементы.КартинкаОжиданиеЗагрузкиФакторовРиска,
		"Видимость,Картинка,Подсказка");
		
		ЗаполнитьЗначенияСвойств(
		Элементы.ДекорацияФакторыРиска1,
		Элементы.ДекорацияФакторыРиска,
		"Видимость,Заголовок");
		
		ПараметрыОтображения.ВариантОтображения = "Многострочный";
		СПАРКРиски.ПриСозданииНаСервере(
		ЭтотОбъект,
		Объект,
		Объект.Ссылка,
		ВидКонтрагентаСПАРКРиски,
		ПараметрыОтображения);
		// Конец ИнтернетПоддержкаПользователей.СПАРКРиски
		
		ПоказатьСвоюПодсказку = Не Элементы.ДекорацияИндексыСПАРКРиски.Видимость И Не Элементы.КартинкаОжиданиеЗагрузкиИндексовСПАРКРиски.Видимость;
		Элементы.СвояПодсказка1СПАРКРиски.Видимость = ПоказатьСвоюПодсказку;
		Элементы.СвояПодсказка1СПАРКРиски1.Видимость = ПоказатьСвоюПодсказку;
		Элементы.ДекорацияЗаголовокСПАРКРиски.Видимость = ПоказатьСвоюПодсказку;
		
		ПоказатьСвоюПодсказкуФакторыРиска = Не Элементы.ДекорацияФакторыРиска.Видимость И Не Элементы.КартинкаОжиданиеЗагрузкиФакторовРиска.Видимость;
		Элементы.СвояПодсказкаФакторовРиска.Видимость = ПоказатьСвоюПодсказкуФакторыРиска;
		Элементы.СвояПодсказкаФакторовРиска1.Видимость = ПоказатьСвоюПодсказкуФакторыРиска;
		Элементы.ДекорацияЗаголовокФакторыРиска.Видимость = ПоказатьСвоюПодсказкуФакторыРиска;
		Элементы.НазваниеГруппыУпрощеннойПодсказкиФакторыРиска.Видимость = ПоказатьСвоюПодсказкуФакторыРиска;
				
		// Команды1СПАРКРиски
		СПАРКРиски.ДобавитьПодключаемыеКомандыКонтрагента(ЭтотОбъект, Объект, Элементы.Подменю1СПАРКРиски);
		// Конец Команды1СПАРКРиски
		
	КонецЕсли;
	
КонецПроцедуры
// Конец ИнтернетПоддержкаПользователей.СПАРКРиски

// Команды1СПАРКРиски
//@skip-check module-unused-method
