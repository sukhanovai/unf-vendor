&НаКлиенте
Процедура ОткрытьИсториюНаименования()
	
	ПараметрыФормы = Новый Структура(
	"ТекущееНаименованиеПолное, ИсторияНаименований, ТолькоПросмотр",
	Объект.НаименованиеПолное, Объект.ИсторияНаименований, ТолькоПросмотр);
