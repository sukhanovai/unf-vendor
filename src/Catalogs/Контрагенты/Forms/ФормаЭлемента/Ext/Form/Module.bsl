Процедура Подключаемый_ПродолжитьОбновлениеКонтактнойИнформации(Результат, ДополнительныеПараметры) Экспорт
	ОбновитьКонтактнуюИнформацию(Результат);
	Если Результат.Свойство("ИмяРеквизита") Тогда
		КонтактнаяИнформацияКонтактногоЛицаПриИзменении(Элементы[Результат.ИмяРеквизита]);
		КонтактнаяИнформацияПриИзменении(Результат.ИмяРеквизита);		
	КонецЕсли;
КонецПроцедуры
&НаСервере
Процедура ОбновитьКонтактнуюИнформацию(Результат)
	ИзменилиКонтактнуюИнформацию = Истина;
	Если Результат.Свойство("ИмяЭлементаДляРазмещения") Тогда
		ИмяЭлементаДляРазмещения = Результат.ИмяЭлементаДляРазмещения;
	Иначе
		ОписаниеКИ = УправлениеКонтактнойИнформациейУНФКлиентСервер.ОписаниеРеквизитаКонтактнойИнформации(ЭтотОбъект, Результат.ИмяРеквизита);
		ИмяЭлементаДляРазмещения = ОписаниеКИ.ИмяЭлементаДляРазмещения;
	КонецЕсли;
	Результат.Вставить("ПостфиксИмяРеквизита", ИмяЭлементаДляРазмещения);
	УправлениеКонтактнойИнформацией.ОбновитьКонтактнуюИнформацию(ЭтотОбъект, Объект, Результат);
	УправлениеКонтактнойИнформациейУНФ.ОбновитьКонтактнуюИнформацию(ЭтотОбъект, Объект, НастройкиПереопределенияКонтактнойИнформации(), Результат);
КонецПроцедуры
// Конец СтандартныеПодсистемы.КонтактнаяИнформация

#КонецОбласти

#Область КонтактнаяИнформацияУНФ

&НаСервере
Процедура СоздатьОбновитьКарточкиКИ()
	
	ОсновнаяТаблицаСоздана = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ДанныеПанелиКонтактнойИнформации");
	КоличествоКонтактовГруппа = 0;
	Если ОсновнаяТаблицаСоздана = Ложь Тогда
		КонтактнаяИнформацияПанельУНФ.ПриСозданииНаСервере(ЭтотОбъект, "КонтактнаяИнформацияТаблица_0");
		Элементы["КонтактнаяИнформацияТаблица_0"].РастягиватьПоВертикали = Истина;
    КонецЕсли;
   	Элементы.ВсеКонтакты.Видимость = Ложь;
	Элементы.ГруппаКомандаДобавления.Видимость = Ложь;
	Элементы.ДанныеПанелиКонтактнойИнформации.Видимость = Ложь;
	
	Если ЗаполнениеИзСвязанногоОбъекта = Ложь Тогда
  		КонтактнаяИнформацияПанельУНФ.ОбновитьДанныеПанели(ЭтотОбъект, Объект.Ссылка);
	Иначе	
		КоличествоКонтактовГруппа = 1;
	КонецЕсли;
	
	МассивУникальныхВладельцев = Новый Массив;

	МаксПорядок = 0;
	Для Каждого Строка Из ДанныеКонтактныхЛиц Цикл   
		СтрокиКЛ = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.НайтиСтроки(Новый Структура("ВладелецКИ", Строка.КонтактноеЛицо));
		Для Каждого СтрокаКЛ Из СтрокиКЛ Цикл
			СтрокаКЛ.ПолеСортировки = Строка.Порядок;
			Если СтрокаКЛ.ТипОтображаемыхДанных = "КонтактноеЛицо" Тогда      
				Если Строка.Основной = Истина И Строка.Подписант = Истина Тогда            
					СтрокаКЛ.Отображение = СтрокаКЛ.Отображение + " (основной, подписант)";	
				ИначеЕсли Строка.Основной = Истина Тогда    
					СтрокаКЛ.Отображение = СтрокаКЛ.Отображение + " (основной)";						
				ИначеЕсли Строка.Подписант = Истина Тогда	
					СтрокаКЛ.Отображение = СтрокаКЛ.Отображение + " (подписант)";						
				КонецЕсли;
			КонецЕсли;  
		КонецЦикла; 	
	КонецЦикла;
	
	Для Каждого Строка Из ЭтотОбъект.ДанныеПанелиКонтактнойИнформации Цикл
		
		Если ЗначениеЗаполнено(Строка.ВладелецКИ) И МассивУникальныхВладельцев.Найти(Строка.ВладелецКИ) = Неопределено И Строка.ВладелецКИ <> Объект.Ссылка Тогда
			МассивУникальныхВладельцев.Добавить(Строка.ВладелецКИ);	
			КоличествоКонтактовГруппа = КоличествоКонтактовГруппа + 1;
		КонецЕсли;
		Если Строка.ТипОтображаемыхДанных = "КонтактноеЛицо" И НЕ ЗаполнениеИзСвязанногоОбъекта Тогда
			Строка.ИндексПиктограммы = 5;       
		КонецЕсли;
		Если Строка.ВладелецКИ = Объект.Ссылка Тогда			
			Строка.ЭтоСсылка = Истина;
		КонецЕсли;

	КонецЦикла; 
	
	Если Не Объект.Ссылка.Пустая() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	СвязиКонтрагентКонтактСрезПоследних.Должность КАК Должность,
		|	СвязиКонтрагентКонтактСрезПоследних.Контакт КАК Контакт
		|ИЗ
		|	РегистрСведений.СвязиКонтрагентКонтакт.СрезПоследних(
		|			,
		|			Контрагент = &Контрагент
		|				И Контакт В (&МассивКонтактов)) КАК СвязиКонтрагентКонтактСрезПоследних";
		
		Запрос.УстановитьПараметр("Контрагент", Объект.Ссылка);
		Запрос.УстановитьПараметр("МассивКонтактов", МассивУникальныхВладельцев);
		
		ВыборкаДолжность = Запрос.Выполнить().Выбрать();
		ЕстьДолжности = Ложь;
		Пока ВыборкаДолжность.Следующий() Цикл   
			Если ВыборкаДолжность.Должность = "" Тогда
				Продолжить;
			КонецЕсли;     
			СтрокиПорядокКИ = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.НайтиСтроки(
				Новый Структура("ТипОтображаемыхДанных, ВладелецКИ", "КонтактноеЛицо", ВыборкаДолжность.Контакт));
			Если СтрокиПорядокКИ.Количество() = 0 Тогда	   
				Продолжить;
			КонецЕсли;  

			СтрокаКИ = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Вставить(ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Индекс(СтрокиПорядокКИ[0]) + 1);  
			СтрокаКИ.ВладелецКИ = ВыборкаДолжность.Контакт;
			СтрокаКИ.ТипОтображаемыхДанных = "ЗначениеКИ";
			СтрокаКИ.Отображение = "Должность: " + ВыборкаДолжность.Должность;
			СтрокаКИ.ИндексПиктограммы = 5;
			СтрокаКИ.ПолеСортировки = СтрокиПорядокКИ[0].ПолеСортировки;
			
			ЕстьДолжности = Истина;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПривязанныйКонтакт) Тогда
		
		СтрокиНетДанных = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.НайтиСтроки(Новый Структура("ТипОтображаемыхДанных","НетДанных"));
		Если СтрокиНетДанных.Количество() > 0 Тогда
			ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Удалить(СтрокиНетДанных[0]);	
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ПорядокТиповКИ.Тип КАК Тип,
		|	ПорядокТиповКИ.Вид КАК Вид,
		|	ПорядокТиповКИ.Порядок КАК Порядок
		|ПОМЕСТИТЬ втПорядокТиповКИ
		|ИЗ
		|	&ПорядокТиповКИ КАК ПорядокТиповКИ
		|;
		|ВЫБРАТЬ
		|	КонтактныеЛицаКонтактнаяИнформация.Ссылка КАК КонтактноеЛицо,
		|	КонтактныеЛицаКонтактнаяИнформация.Тип КАК Тип,
		|	КонтактныеЛицаКонтактнаяИнформация.Вид КАК Вид,
		|	КонтактныеЛицаКонтактнаяИнформация.Представление КАК Представление,
		|	КонтактныеЛицаКонтактнаяИнформация.Значение КАК Значение,
		|	ПРЕДСТАВЛЕНИЕ(КонтактныеЛицаКонтактнаяИнформация.Вид) КАК ПредставлениеВидаКИ
		|ИЗ
		|	Справочник.КонтактныеЛица.КонтактнаяИнформация КАК КонтактныеЛицаКонтактнаяИнформация
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПорядокТиповКИ КАК втПорядокТиповКИ
		|		ПО КонтактныеЛицаКонтактнаяИнформация.Тип = втПорядокТиповКИ.Тип
		|		И КонтактныеЛицаКонтактнаяИнформация.Вид = втПорядокТиповКИ.Вид
		|ГДЕ
		|	КонтактныеЛицаКонтактнаяИнформация.Ссылка = &Контакт
		|
		|УПОРЯДОЧИТЬ ПО
		|	втПорядокТиповКИ.Порядок,
		|	КонтактныеЛицаКонтактнаяИнформация.Вид.Наименование";
		//Запрос.УстановитьПараметр("ПорядокТиповКИ", КонтактнаяИнформацияУНФ.ПорядокТиповКИ());
		Запрос.УстановитьПараметр("ПорядокТиповКИ", КонтактнаяИнформацияУНФ.ПорядокТиповКИСправочник());
		Запрос.УстановитьПараметр("Контакт", ПривязанныйКонтакт);  
		ВыборкаКонтактнаяИнформация = Запрос.Выполнить().Выбрать();
		
		НоваяСтрока = Новый Структура;
		НоваяСтрока.Вставить("Отображение", Строка(ПривязанныйКонтакт));
		НоваяСтрока.Вставить("ИндексПиктограммы", -1);
		НоваяСтрока.Вставить("ТипОтображаемыхДанных", "КонтактноеЛицо");
		НоваяСтрока.Вставить("ВладелецКИ", ПривязанныйКонтакт);
		СтрокаКИ = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКИ,НоваяСтрока);
		КоличествоКонтактовГруппа = 1;
		Пока ВыборкаКонтактнаяИнформация.Следующий() Цикл
			НоваяСтрока = Новый Структура;
			НоваяСтрока.Вставить("Отображение", Строка(ВыборкаКонтактнаяИнформация.Вид) + ": " +ВыборкаКонтактнаяИнформация.Представление);
			НоваяСтрока.Вставить("ИндексПиктограммы", КонтактнаяИнформацияПанельУНФ.ИндексПиктограммыПоТипу(ВыборкаКонтактнаяИнформация.Тип));
			НоваяСтрока.Вставить("ТипОтображаемыхДанных", "ЗначениеКИ");
			НоваяСтрока.Вставить("ВладелецКИ", ПривязанныйКонтакт);
			НоваяСтрока.Вставить("ПредставлениеКИ", ВыборкаКонтактнаяИнформация.Представление);
			НоваяСтрока.Вставить("ТипКИ", ВыборкаКонтактнаяИнформация.Тип);
			СтрокаКИ = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКИ,НоваяСтрока); 
		КонецЦикла;		
	КонецЕсли;
	 
	Номер = 1;
	ИмяТекТаблицы = "ДанныеПанелиКонтактнойИнформации_" + Номер;
	Если ЭтотОбъект.Элементы.Найти("КонтактнаяИнформацияТаблица_" + Номер) = Неопределено Тогда
		ГруппаТаблица = ЭтотОбъект.Элементы.Добавить("КонтактнаяИнформацияТаблица_" + Номер,Тип("ГруппаФормы"), Элементы.ГруппаКонтактыТаблица);
		ГруппаТаблица.Вид = ВидГруппыФормы.ОбычнаяГруппа; 
		ГруппаТаблица.ОтображатьЗаголовок = Ложь;  
		ГруппаТаблица.РастягиватьПоВертикали = Истина;
		КонтактнаяИнформацияПанельУНФ.СоздатьЭлементТаблицаФормы(ЭтотОбъект, ИмяТекТаблицы,
		"КонтактнаяИнформацияТаблица_" + Номер,  "ДанныеПанелиКонтактнойИнформации", Истина);    
		КонтактнаяИнформацияПанельУНФ.УстановитьУсловноеОформление(ЭтотОбъект, "_" + Номер, Истина);
		
		Элементы[ИмяТекТаблицы].ВыделенныеСтроки.Очистить(); 
		Элементы[ИмяТекТаблицы].УстановитьДействие("ПриАктивизацииЯчейки", "СписокПриАктивизацииЯчейки"); 
		Элементы[ИмяТекТаблицы].ЧередованиеЦветовСтрок = Ложь;
		Элементы[ИмяТекТаблицы].ВертикальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.ИспользоватьВсегда;
		
		НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
		ГруппаИли = РаботаСФормой.ДобавитьГруппуЭлементовОтбораКомпоновкиДанных(НовоеУсловноеОформление.Отбор, "ГруппаИЛИ");
	
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ГруппаИли, "ДанныеПанелиКонтактнойИнформации.ТипОтображаемыхДанных", "КонтактноеЛицо", ВидСравненияКомпоновкиДанных.Равно); 
		
		РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(
			ГруппаИли, "ДанныеПанелиКонтактнойИнформации.ТипОтображаемыхДанных", "НетДанных", ВидСравненияКомпоновкиДанных.Равно); 
		
		ОформляемыеПоля = Новый Массив; 
		ОформляемыеПоля.Добавить(ИмяТекТаблицы + "ОтображениеТипаКИ");
		РаботаСФормой.ДобавитьОформляемыеПоля(НовоеУсловноеОформление, ОформляемыеПоля);
		РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Видимость", Ложь);
		
	КонецЕсли;
	
	Если ДанныеКонтактныхЛиц.Количество() = 0 И ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.НайтиСтроки(Новый Структура("ЭтоСсылка", Истина)).Количество() > 0 
		И НЕ ЗначениеЗаполнено(ПривязанныйКонтакт) Тогда
		НоваяСтрокаСтруктура = Новый Структура;
		НоваяСтрокаСтруктура.Вставить("Отображение", НСтр("ru='<Нет контактных данных>'"));
		НоваяСтрокаСтруктура.Вставить("ИндексПиктограммы", -1);
		НоваяСтрокаСтруктура.Вставить("ТипОтображаемыхДанных", "НетДанных");
		НоваяСтрокаСтруктура.Вставить("ВладелецКИ", Неопределено);
		СтрокаПустая = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПустая, НоваяСтрокаСтруктура);
	КонецЕсли;
	
	ЗаполнитьОтображениеТипаКИ();
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ЭтоСсылка", Ложь);
	Элементы[ИмяТекТаблицы].ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураПоиска); 
	Элементы.КонтактнаяИнформацияТаблица_1.Высота = 0;
	
	Элементы.ДанныеПанелиКонтактнойИнформации.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.ПоСодержимому;
	Если ЭтоИнтерфейсТакси = Ложь И Элементы.Найти("КонтактнаяИнформацияТаблица_1") <> Неопределено Тогда
		Элементы.КонтактнаяИнформацияТаблица_1.Высота = 26;
		Элементы.КонтактнаяИнформацияТаблица_1.Высота = 0;
		Элементы.Контакты.Высота = 0;
		Элементы.Контакты.РастягиватьПоВертикали = Истина;
	КонецЕсли;
	Элементы.Контакты.Заголовок = НСтр("ru = 'Контакты ('") + КоличествоКонтактовГруппа + ")";
	
	Если ЭтоИнтерфейсТакси Тогда
		
		Если Элементы.КонтактнаяИнформацияТаблица_1.ПодчиненныеЭлементы.Количество() 
			И ТипЗнч(Элементы.КонтактнаяИнформацияТаблица_1.ПодчиненныеЭлементы[0]) = Тип("ТаблицаФормы") Тогда
			
			ЭлементТаблицы = Элементы.КонтактнаяИнформацияТаблица_1.ПодчиненныеЭлементы[0];
			ЭлементТаблицы.ВысотаВСтрокахТаблицы = 10;
			ЭлементТаблицы.РастягиватьПоВертикали = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьОтображениеТипаКИ()

	ОсновнаяТаблицаСоздана = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ДанныеПанелиКонтактнойИнформации");
	Если ОсновнаяТаблицаСоздана = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ЭтотОбъект.ДанныеПанелиКонтактнойИнформации Цикл
		Если Строка.ТипОтображаемыхДанных <> "КонтактноеЛицо" Тогда
			Если СтрНайти(Строка.Отображение, ": ") > 0 И Строка.ОтображениеТипаКИ = "" Тогда
				Строка.ОтображениеТипаКИ = Лев(Строка.Отображение, СтрНайти(Строка.Отображение, ":"));	
				Строка.Отображение = Сред(Строка.Отображение, СтрНайти(Строка.Отображение, ":") + 2);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;		

КонецПроцедуры 

&НаКлиенте
Процедура ВыборДействийКонтакт(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ПорядокКЛ = ДополнительныеПараметры.ПорядокКЛ;
	КонтактноеЛицо = ДополнительныеПараметры.КонтактноеЛицо;
	ИндексКИ = ПорядокКЛ;
	Если Результат.Значение = "ИспользоватьКакОсновной" Тогда	 
		Если ИндексКИ < 0 Тогда
			Возврат;	
		КонецЕсли;
		ВыборИспользоватьКакОсновной(КонтактноеЛицо);   
		Модифицированность = Истина;  
		
	ИначеЕсли Результат.Значение = "ИспользоватьКакПодписанта" Тогда	 
		Если ИндексКИ < 0 Тогда
			Возврат;	
		КонецЕсли;
		ВыборИспользоватьКакПодписанта(КонтактноеЛицо);   
		Модифицированность = Истина;  
		
	ИначеЕсли Результат.Значение = "ИзменитьПорядок" Тогда
		ИзменитьПорядок(КонтактноеЛицо);   
		
	ИначеЕсли Результат.Значение = "РазорватьСвязь" Тогда	 
		Если ИндексКИ < 0 Тогда
			Возврат;	
		КонецЕсли;
		РазорватьСвязьКЛ(КонтактноеЛицо);    
		
	ИначеЕсли Результат.Значение = "Изменить" Тогда
		
		ЕстьИзменения = Ложь;
		Для Каждого СтрокаТЧ Из ДанныеКонтактныхЛиц Цикл
			Если СтрокаТЧ.Порядок = ПорядокКЛ Тогда
				ИндексВыбранногоКонтактногоЛица = ДанныеКонтактныхЛиц.Индекс(СтрокаТЧ);
			КонецЕсли;
			Если СтрокаТЧ.Изменен = Истина Тогда
				ЕстьИзменения = Истина;
			КонецЕсли;
		КонецЦикла;
		
		ВыбранноеКонтактноеЛицо = ДанныеКонтактныхЛиц[ИндексВыбранногоКонтактногоЛица].КонтактноеЛицо;
		
		Если ЕстьИзменения = Истина Тогда  
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Ключ", ВыбранноеКонтактноеЛицо);
			ПараметрыОткрытия.Вставить("ТекущийКонтрагент", Объект.Ссылка);
			Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("ЭтоДолжность") Тогда
				ПараметрыОткрытия.Вставить("ЭтоДолжность", Истина);
			КонецЕсли;
			Оповещение = Новый ОписаниеОповещения("ОбработатьВопросКонтрагентНеЗаписан", ЭтотОбъект,  ПараметрыОткрытия);
			ПоказатьВопрос(Оповещение, "Контактная информация была изменена." + Символы.ПС + "Необходимо записать карточку контрагента. Продолжить?", РежимДиалогаВопрос.ДаНет);
			Возврат;
		Иначе
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Ключ", ВыбранноеКонтактноеЛицо); 
			ПараметрыОткрытия.Вставить("ТекущийКонтрагент", Объект.Ссылка);			
			Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("ЭтоДолжность") Тогда
				ПараметрыОткрытия.Вставить("ЭтоДолжность", Истина);
			КонецЕсли;
			ОткрытьФорму("Справочник.КонтактныеЛица.Форма.ФормаЭлемента", ПараметрыОткрытия
				,ЭтотОбъект,,,, Новый ОписаниеОповещения("ОбработатьОбновлениеКИ", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
			
		КонецЕсли;       
		
		Возврат; 
		
	ИначеЕсли Результат.Значение = "ПоказатьВСписке" Тогда
		ВыборПоказатьВСписке(КонтактноеЛицо)	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПорядок(КонтактноеЛицо)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Контрагент", Объект.Ссылка);
	ПараметрыОткрытия.Вставить("СкрыватьИсторию", Истина);

	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаИзмененияПорядка", ПараметрыОткрытия
	,,,,, Новый ОписаниеОповещения("ОбработатьОбновлениеКИ", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

&НаСервере
Функция НастройкиПереопределенияКонтактнойИнформации()
	
	НастройкиПереопределения = УправлениеКонтактнойИнформациейУНФ.НастройкиПереопределения();
	НастройкиПереопределения.ИспользоватьСтандартнуюШирину = Ложь;
	Возврат НастройкиПереопределения;
	
КонецФункции

&НаКлиенте
Процедура КонтактнаяИнформацияКонтактногоЛицаПриИзменении(Элемент)
	
	ОписаниеРеквизита = УправлениеКонтактнойИнформациейУНФКлиентСервер.ОписаниеРеквизитаКонтактнойИнформации(ЭтотОбъект, Элемент.Имя);
	Если ОписаниеРеквизита = Неопределено И СтрНачинаетсяС(НРег(Элемент.Имя), НРег("Комментарий")) Тогда
		ИмяЭлемента = Прав(Элемент.Имя, СтрДлина(Элемент.Имя) - СтрДлина("Комментарий"));
		ОписаниеРеквизита = УправлениеКонтактнойИнформациейУНФКлиентСервер.ОписаниеРеквизитаКонтактнойИнформации(ЭтотОбъект, ИмяЭлемента);
	КонецЕсли;
	
	Если ОписаниеРеквизита = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлементаДляРазмещения = ОписаниеРеквизита.ИмяЭлементаДляРазмещения;
	Если ИмяЭлементаДляРазмещения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(ИмяЭлементаДляРазмещения, "КонтактнаяИнформацияКонтакт_") = 0 Тогда
		// Поле контактной информации контрагента.
		Возврат;
	КонецЕсли;
	
	Индекс = СтрЗаменить(ИмяЭлементаДляРазмещения, "КонтактнаяИнформацияКонтакт_", "");
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Индекс) Тогда
		ДанныеКонтактныхЛиц[Число(Индекс)].Изменен = Истина;
	КонецЕсли;
	
	КонтактнаяИнформацияКонтактногоЛицаПриИзмененииСервер(Элемент.Имя, Индекс);
	
КонецПроцедуры

&НаСервере
Процедура КонтактнаяИнформацияКонтактногоЛицаПриИзмененииСервер(ИмяЭлемента, ИндексКЛ)
	
	ЭтоРедактированиеПоляКИ = Не СтрНачинаетсяС(НРег(ИмяЭлемента), НРег("Комментарий"));
	Если ЭтоРедактированиеПоляКИ Тогда
		ОписаниеКИ = УправлениеКонтактнойИнформациейУНФ.ОписаниеРеквизитаКонтактнойИнформации(ЭтотОбъект, ИмяЭлемента);
		ПроверитьКИНаДубли(ОписаниеКИ, ИндексКЛ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КонтактнаяИнформацияПриИзменении(ИмяЭлемента)
	
	ЭтоРедактированиеПоляКИ = Не СтрНачинаетсяС(НРег(ИмяЭлемента), НРег("Комментарий"));
	Если ЭтоРедактированиеПоляКИ Тогда
		ОписаниеКИ = УправлениеКонтактнойИнформациейУНФ.ОписаниеРеквизитаКонтактнойИнформации(ЭтотОбъект, ИмяЭлемента);
		ПроверитьКИНаДубли(ОписаниеКИ);
	КонецЕсли;
	ИзменилиКонтактнуюИнформацию = Истина; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборИспользоватьКакОсновной(КонтактноеЛицо)
	
	Строки = ДанныеКонтактныхЛиц.НайтиСтроки(Новый Структура("КонтактноеЛицо", КонтактноеЛицо)); 
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИндексВыбранногоКонтактногоЛица = ДанныеКонтактныхЛиц.Индекс(Строки[0]);
	
	ОсновнойКонтакт = ДанныеКонтактныхЛиц.НайтиСтроки(Новый Структура("Основной", Истина));
	Если ОсновнойКонтакт.Количество() > 0 Тогда
		ОсновнойКонтакт[0].Основной = Ложь;
	КонецЕсли;	
	
	ДанныеКонтактныхЛиц[ИндексВыбранногоКонтактногоЛица].Основной = Истина;
	ДанныеКонтактныхЛиц[ИндексВыбранногоКонтактногоЛица].Изменен = Истина;
	
	Объект.КонтактноеЛицо = ДанныеКонтактныхЛиц[ИндексВыбранногоКонтактногоЛица].КонтактноеЛицо;
	ОпределитьОсновногоПодписанта();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборИспользоватьКакПодписанта(КонтактноеЛицо)

	Строки = ДанныеКонтактныхЛиц.НайтиСтроки(Новый Структура("КонтактноеЛицо", КонтактноеЛицо));
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИндексВыбранногоКонтактногоЛица = ДанныеКонтактныхЛиц.Индекс(Строки[0]);
	
	Подписант = ДанныеКонтактныхЛиц.НайтиСтроки(Новый Структура("Подписант", Истина));
	Если Подписант.Количество() > 0 Тогда
		Подписант[0].Подписант = Ложь;
	КонецЕсли;
	
	ДанныеКонтактныхЛиц[ИндексВыбранногоКонтактногоЛица].Подписант = Истина;
	ДанныеКонтактныхЛиц[ИндексВыбранногоКонтактногоЛица].Изменен = Истина;
	
	ОпределитьОсновногоПодписанта();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПоказатьВСписке(КонтактноеЛицо)
	
	ПараметрыСписка = Новый Структура;
	ПараметрыСписка.Вставить("Отбор", Новый Структура);
	ПараметрыСписка.Отбор.Вставить("Контрагент", Объект.Ссылка);
	ПараметрыСписка.Отбор.Вставить("ТекущийКонтакт", КонтактноеЛицо);
	
	ОткрытьФорму("Справочник.КонтактныеЛица.Форма.ФормаСписка", ПараметрыСписка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьОсновногоПодписанта()
	
	Для Каждого Строка Из ДанныеКонтактныхЛиц Цикл   
		СтрокиКЛ = ЭтотОбъект.ДанныеПанелиКонтактнойИнформации.НайтиСтроки(Новый Структура("ВладелецКИ", Строка.КонтактноеЛицо));
		Для Каждого СтрокаКЛ Из СтрокиКЛ Цикл 
			СтрокаКЛ.Отображение = СтрЗаменить(СтрокаКЛ.Отображение, " (основной, подписант)","");
			СтрокаКЛ.Отображение = СтрЗаменить(СтрокаКЛ.Отображение, " (основной)", "");
			СтрокаКЛ.Отображение = СтрЗаменить(СтрокаКЛ.Отображение, " (подписант)", "");
			Если СтрокаКЛ.ТипОтображаемыхДанных = "КонтактноеЛицо" Тогда      
				Если Строка.Основной = Истина И Строка.Подписант = Истина Тогда            
					СтрокаКЛ.Отображение = СтрокаКЛ.Отображение + " (основной, подписант)";	
				ИначеЕсли Строка.Основной = Истина Тогда    
					СтрокаКЛ.Отображение = СтрокаКЛ.Отображение + " (основной)";						
				ИначеЕсли Строка.Подписант = Истина Тогда	
					СтрокаКЛ.Отображение = СтрокаКЛ.Отображение + " (подписант)";						
				КонецЕсли;
			КонецЕсли;  
		КонецЦикла; 	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазорватьСвязьКЛ(КонтактноеЛицо)
	
	ДанныеКонтактногоЛица = ДанныеКонтактныхЛиц.НайтиСтроки(Новый Структура("КонтактноеЛицо", КонтактноеЛицо))[0];
	
	КонтактОсновноеКЛ = ДанныеКонтактногоЛица.КонтактноеЛицо = Объект.КонтактноеЛицо И ЗначениеЗаполнено(Объект.КонтактноеЛицо);
	КонтактПодписант = ДанныеКонтактногоЛица.КонтактноеЛицо = Объект.КонтактноеЛицоПодписант И ЗначениеЗаполнено(Объект.КонтактноеЛицоПодписант);
	Если НЕ КонтактОсновноеКЛ И НЕ КонтактПодписант И НЕ Модифицированность Тогда
		РазорватьСвязьКЛНаСервере(КонтактноеЛицо);
		Прочитать();		
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьВопросОсновноеКЛПодписантВыборКонтрагента", ЭтотОбъект, Новый Структура("КонтактноеЛицо", КонтактноеЛицо));
	ПроверитьКонтактНаОсновнойИПодписанта(ДанныеКонтактногоЛица, Оповещение);
	
КонецПроцедуры

&НаСервере
Процедура РазорватьСвязьКЛНаСервере(КонтактноеЛицо)
	
	ДанныеКонтактногоЛица = ДанныеКонтактныхЛиц.НайтиСтроки(Новый Структура("КонтактноеЛицо", КонтактноеЛицо))[0];
	
	ОсновнойКонтакт = ДанныеКонтактныхЛиц.НайтиСтроки(Новый Структура("Основной", Истина));
	Если ОсновнойКонтакт.Количество() > 0 И ОсновнойКонтакт[0].КонтактноеЛицо = КонтактноеЛицо Тогда
		ОсновнойКонтакт[0].Основной = Ложь;
		Объект.КонтактноеЛицо = Неопределено;  
		ДанныеКонтактныхЛиц.Удалить(ОсновнойКонтакт[0]);
		Если ОсновнойКонтакт[0].Подписант = Истина Тогда
			Объект.КонтактноеЛицоПодписант = Неопределено; 
		КонецЕсли;
	КонецЕсли; 
	
	Подписант = ДанныеКонтактныхЛиц.НайтиСтроки(Новый Структура("Подписант", Истина));
	Если Подписант.Количество() > 0 И Подписант[0].КонтактноеЛицо = КонтактноеЛицо Тогда
		Подписант[0].Подписант = Ложь;
		Объект.КонтактноеЛицоПодписант = Неопределено; 
		ДанныеКонтактныхЛиц.Удалить(Подписант[0]);
	КонецЕсли; 

	РегистрыСведений.СвязиКонтрагентКонтакт.УстановитьНедействительной(Объект.Ссылка, ДанныеКонтактногоЛица.КонтактноеЛицо);
	
	Записать();
	ЗаполнитьИОбновитьКонтактныеЛица();
	СоздатьОбновитьКарточкиКИ();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОбновлениеКИ(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		Прочитать();
	КонецЕсли;
	
	ЗаполнитьИОбновитьКонтактныеЛица();	
	ЗаполнитьТаблицуКонтактнойИнформацииКонтактныхЛиц();
 	СоздатьОбновитьКарточкиКИ();

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВопросКонтрагентНеЗаписан(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНовый = Объект.Ссылка.Пустая();
	Записать();                        
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;      
	
	ПереданаСтруктура = ТипЗнч(ДополнительныеПараметры) = Тип("Структура");	
	ПараметрыОткрытия = Новый Структура;
	Если ЭтоНовый = Истина ИЛИ (ПереданаСтруктура = Истина И ДополнительныеПараметры.Свойство("ЭтоДобавлениеКЛ")) Тогда
		ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", Новый Структура("Контрагент", Объект.Ссылка));	
	Иначе       
		Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;
		Если Не ДополнительныеПараметры.Свойство("Ключ") Тогда
			Возврат;
		КонецЕсли;
		ПараметрыОткрытия.Вставить("Ключ", ДополнительныеПараметры.Ключ);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.КонтактныеЛица.Форма.ФормаЭлемента", ПараметрыОткрытия
		,ЭтотОбъект,,,, Новый ОписаниеОповещения("ОбработатьОбновлениеКИ", ЭтотОбъект),  РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВопросКонтрагентНеЗаписанСвязь(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНовый = Объект.Ссылка.Пустая();
	Записать();                        
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОткрытиеИзФормыКонтрагента", Истина);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ОткрытьФорму("Справочник.КонтактныеЛица.ФормаСписка",ПараметрыФормы,ЭтотОбъект,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВопросОсновноеКЛПодписантВыборКонтрагента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		РазорватьСвязьКЛНаСервере(ДополнительныеПараметры.КонтактноеЛицо);
		Прочитать();				
	КонецЕсли;
	
КонецПроцедуры

//@skip-check module-unused-method
&НаКлиенте
Процедура Подключаемый_ДанныеПанелиКонтактнойИнформацииПриАктивизацииСтроки(Элемент)

