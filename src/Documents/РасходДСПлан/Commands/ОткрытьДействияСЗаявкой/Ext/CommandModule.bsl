
#Область ОбработчикиСобытий

&НаКлиенте
// Процедура обработки команды.
//
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	ПараметрыФормы = Новый Структура();
	
	Отбор = Новый Структура("ЗаявкаНаРасходДС", ПараметрКоманды);
	ПараметрыФормы.Вставить("Отбор", Отбор);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	ПараметрыФормы.Вставить("ФормаОткрытаИзЗаявки", Истина);
	
	ОткрытьФорму("РегистрСведений.ЭтапыСогласованияЗаявок.ФормаСписка", ПараметрыФормы,
																		ПараметрыВыполненияКоманды.Источник,
																		ПараметрыВыполненияКоманды.Уникальность,
																		ПараметрыВыполненияКоманды.Окно);
	
КонецПроцедуры

#КонецОбласти