Процедура ДатаПриИзмененииНаСервере(ДанныеДляИзмененияДаты)
	
	ДокументыУНФ.ДатаПриИзменении(ДанныеДляИзмененияДаты, ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ДокументыУНФ.ОрганизацияПриИзменении(ЭтотОбъект, Объект);
	УстановитьВидимостьВкладок();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьВкладок()
	
	СдаетсяОтчетность = Ложь;
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		СдаетсяОтчетность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ИспользуетсяОтчетность");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаНалоги",
		"Видимость", НЕ СдаетсяОтчетность);
	
	ОписаниеНалоги = ОписаниеРежимовПросмотра.Налоги;
	ЭлементНалоги = Элементы.РежимПросмотраСотрудники.СписокВыбора.НайтиПоЗначению(ОписаниеНалоги.СписокЗначение);
	Если СдаетсяОтчетность И ЭлементНалоги <> Неопределено Тогда
		Элементы.РежимПросмотраСотрудники.СписокВыбора.Удалить(ЭлементНалоги);
	КонецЕсли;
	Если НЕ СдаетсяОтчетность И ЭлементНалоги = Неопределено Тогда
		Элементы.РежимПросмотраСотрудники.СписокВыбора.Добавить(ОписаниеНалоги.СписокЗначение,
			ОписаниеНалоги.СписокПредставление);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОписаниеПереключенияРежимов()
	
	ОписаниеРежима = Новый Структура;
	ОписаниеРежима.Вставить("ИмяСтраницы", "");
	ОписаниеРежима.Вставить("ИмяТаблицыСотрудники", "");
	ОписаниеРежима.Вставить("Заголовок", "");
	ОписаниеРежима.Вставить("СписокЗначение", "");
	ОписаниеРежима.Вставить("СписокПредставление", "");
	ОписаниеРежима.Вставить("ОтображатьКоличествоНачисления", Истина);
	ОписаниеРежима.Вставить("ОтображатьКоличествоНалоги", Истина);
	
	ШаблонОписания = Новый ФиксированнаяСтруктура(ОписаниеРежима);
	
	Результат = Новый Структура;
	
	КлючСотрудники = "Сотрудники";
	Результат.Вставить(КлючСотрудники, Новый Структура(ШаблонОписания));
	Результат.Сотрудники.СписокЗначение = КлючСотрудники;
	Результат.Сотрудники.Заголовок = НСтр("ru = 'Сотрудники'");
	Результат.Сотрудники.СписокПредставление = Результат.Сотрудники.Заголовок;
	
	КлючНачисления = "НачисленияУдержания";
	Результат.Вставить(КлючНачисления, Новый Структура(ШаблонОписания));
	Результат.НачисленияУдержания.СписокЗначение = КлючНачисления;
	Результат.НачисленияУдержания.Заголовок = НСтр("ru = 'Начисления и удержания сотрудников'");
	Результат.НачисленияУдержания.Вставить("ОтображатьКоличествоНачисления", Ложь);
	
	КлючНалоги = "Налоги";
	Результат.Вставить(КлючНалоги, Новый Структура(ШаблонОписания));
	Результат.Налоги.СписокЗначение = "Налоги";
	Результат.Налоги.Заголовок = НСтр("ru = 'Налоги сотрудников'");
	Результат.Налоги.Вставить("ОтображатьКоличествоНалоги", Ложь);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьЭлементРежимПросмотра()
	ОбновитьОписаниеРежимов(ОписаниеРежимовПросмотра, РежимПросмотраСотрудники,
		Объект.НачисленияУдержания.Количество(), Объект.НалогиНаДоходы.Количество());
		
	ЭлементНачисления = Элементы.РежимПросмотраСотрудники.СписокВыбора.НайтиПоЗначению(
		ОписаниеРежимовПросмотра.НачисленияУдержания.СписокЗначение);
	Если ЭлементНачисления <> Неопределено Тогда
		ЭлементНачисления.Представление = ОписаниеРежимовПросмотра.НачисленияУдержания.СписокПредставление;
	КонецЕсли;
	
	ЭлементНалоги = Элементы.РежимПросмотраСотрудники.СписокВыбора.НайтиПоЗначению(
		ОписаниеРежимовПросмотра.Налоги.СписокЗначение);
	Если ЭлементНалоги <> Неопределено Тогда
		ЭлементНалоги.Представление = ОписаниеРежимовПросмотра.Налоги.СписокПредставление;
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОписаниеРежимов(ОписаниеРежимов, ТекущийРежим, КоличествоНачисления, КоличествоНалоги)
	
	ШаблонКоличество = "%1 (%2)";
	
	ТекущееОписание = ОписаниеРежимов[ТекущийРежим];
	
	ЗаголовокНачисления = ОписаниеРежимов.НачисленияУдержания.Заголовок;
	Если ТекущееОписание.ОтображатьКоличествоНачисления Тогда
		ЗаголовокНачисления = СтрШаблон(ШаблонКоличество, ЗаголовокНачисления, КоличествоНачисления);
	КонецЕсли;
	ОписаниеРежимов.НачисленияУдержания.СписокПредставление = ЗаголовокНачисления;
	
	ЗаголовокНалоги = ОписаниеРежимов.Налоги.Заголовок;
	Если ТекущееОписание.ОтображатьКоличествоНалоги Тогда
		ЗаголовокНалоги = СтрШаблон(ШаблонКоличество, ЗаголовокНалоги, КоличествоНалоги);
	КонецЕсли;
	ОписаниеРежимов.Налоги.СписокПредставление = ЗаголовокНалоги;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьОтображениеПодсказки(Элементы, Показать)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы,
		"ГруппаПодсказкаАссистента",
		"Видимость",
		Показать);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьПоляСумма()
	
	ТекущиеДанные = Элементы.НачисленияУдержания.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено
		И ЗначениеЗаполнено(ТекущиеДанные.ВидНачисленияУдержания) Тогда
		
		ТекущиеДанные.СуммаЗаблокирована = ПолучитьЗначениеБлокировкиСуммы(ТекущиеДанные.ВидНачисленияУдержания);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьЗначениеДополнительныхРеквизитовТабличныхЧастей()
	
	ЗаблокированныеНачисления = Новый Соответствие;
	
	Для Каждого СтрокаНачисленийУдержаний Из Объект.НачисленияУдержания Цикл
		
		ЗначениеБлокировки = ЗаблокированныеНачисления.Получить(СтрокаНачисленийУдержаний.ВидНачисленияУдержания);
		
		Если ЗначениеБлокировки = Неопределено Тогда
			Если ЗначениеЗаполнено(СтрокаНачисленийУдержаний.ВидНачисленияУдержания) Тогда
				ДанныеНачисления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
					СтрокаНачисленийУдержаний.ВидНачисленияУдержания, "Формула, Предопределенный");
				ЗначениеБлокировки = НЕ ЗначениеЗаполнено(ДанныеНачисления.Формула)
					ИЛИ ДанныеНачисления.Предопределенный;
			Иначе
				ЗначениеБлокировки = Истина;
			КонецЕсли;
			ЗаблокированныеНачисления.Вставить(СтрокаНачисленийУдержаний.ВидНачисленияУдержания, ЗначениеБлокировки);
		КонецЕсли; 
		
		Если ЗначениеБлокировки = Истина Тогда
			СтрокаНачисленийУдержаний.СуммаЗаблокирована = Истина;
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеФормы()
	
	УсловноеОформление.Элементы.Очистить();
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(НовоеУсловноеОформление.Отбор,
		"Объект.НачисленияУдержания.СуммаЗаблокирована", Истина);
	РаботаСФормой.ДобавитьОформляемоеПоле(НовоеУсловноеОформление, Элементы.НачисленияУдержанияСумма.Имя);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление,
		"ЦветТекста", ЦветаПалитры.ТекстВторостепеннойНадписиУНФ);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление,
		"Текст", НСтр("ru = '<Значение не требуется>'"));
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "ТолькоПросмотр", Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеБлокировкиСуммы(ВидНачисленияУдержания)
	
	Блокирован = Ложь;
	Если ВидНачисленияУдержания = Справочники.ВидыНачисленийИУдержаний.НалогНаДоходы
		ИЛИ ВидНачисленияУдержания = Справочники.ВидыНачисленийИУдержаний.ПогашениеЗаймаИзЗарплаты
		ИЛИ ВидНачисленияУдержания = Справочники.ВидыНачисленийИУдержаний.ПремияЗаПродажи Тогда
		
		Блокирован = Истина;
		
	КонецЕсли;
	
	Возврат Блокирован;
	
КонецФункции

