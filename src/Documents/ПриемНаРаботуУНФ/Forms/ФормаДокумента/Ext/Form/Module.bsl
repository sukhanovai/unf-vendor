
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ДатаДокумента = Объект.Дата;
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Компания = Константы.УчетПоКомпании.Компания(Объект.Организация);
	ВалютаПоУмолчанию = Константы.НациональнаяВалюта.Получить();
	
	ОписаниеРежимовПросмотра = ОписаниеПереключенияРежимов();
	ОписаниеРежимовПросмотра.Сотрудники.ИмяСтраницы = Элементы.СтраницаТолькоСотрудники.Имя;
	ОписаниеРежимовПросмотра.Сотрудники.ИмяТаблицыСотрудники = Элементы.Сотрудники.Имя;
	ОписаниеРежимовПросмотра.НачисленияУдержания.ИмяСтраницы = Элементы.СтраницаНачисленияУдержания.Имя;
	ОписаниеРежимовПросмотра.НачисленияУдержания.ИмяТаблицыСотрудники = Элементы.СотрудникиНачислений.Имя;
	ОписаниеРежимовПросмотра.Налоги.ИмяСтраницы = Элементы.СтраницаНалоги.Имя;
	ОписаниеРежимовПросмотра.Налоги.ИмяТаблицыСотрудники = Элементы.СотрудникиНалоги.Имя;
	
	ИмяТабличнойЧасти = ОписаниеРежимовПросмотра.Сотрудники.ИмяТаблицыСотрудники;
	РежимПросмотраСотрудники = ОписаниеРежимовПросмотра.Сотрудники.СписокЗначение;
	РежимПросмотраСотрудникиПредыдущий = РежимПросмотраСотрудники;
	ОбновитьОписаниеРежимов(ОписаниеРежимовПросмотра, РежимПросмотраСотрудники,
		Объект.НачисленияУдержания.Количество(), Объект.НалогиНаДоходы.Количество());
		
	Элементы.РежимПросмотраСотрудники.СписокВыбора.Очистить();
	Элементы.РежимПросмотраСотрудники.СписокВыбора.Добавить(ОписаниеРежимовПросмотра.Сотрудники.СписокЗначение,
		ОписаниеРежимовПросмотра.Сотрудники.СписокПредставление);
	Элементы.РежимПросмотраСотрудники.СписокВыбора.Добавить(ОписаниеРежимовПросмотра.НачисленияУдержания.СписокЗначение,
		ОписаниеРежимовПросмотра.НачисленияУдержания.СписокПредставление);
		
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьСовместительство") Тогда
		
		Если Элементы.Найти("СотрудникиСотрудникКод") <> Неопределено Тогда
			
			Элементы.СотрудникиСотрудникКод.Видимость = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗначениеНастройки = ПерсональныеНастройкиРУНФ.Прочитать("ОсновноеПодразделение");
	ОсновноеПодразделение = ?(ЗначениеЗаполнено(ЗначениеНастройки), ЗначениеНастройки,
		Справочники.СтруктурныеЕдиницы.ОсновноеПодразделение);
	
	УчетНалогов = ПолучитьФункциональнуюОпцию("ВестиУчетНалогаНаДоходыИВзносов");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТекущийСотрудникНалоги", "Видимость",
		УчетНалогов);
	
	ПечатьДокументовУНФ.УстановитьОтображениеПодменюПечати(Элементы.ПодменюПечать);
	
	ИзменитьОтображениеПодсказки(Элементы, Не ЗначениеЗаполнено(Объект.Ссылка) И ПолучитьФункциональнуюОпцию(
		"ИспользоватьОтчетность"));
	
	ОтчетыУНФ.ПриСозданииНаСервереФормыСвязанногоОбъекта(ЭтотОбъект); 
	
	УстановитьЗначениеДополнительныхРеквизитовТабличныхЧастей();
	
	УстановитьВидимостьВкладок();
	
	УстановитьУсловноеОформлениеФормы();
	
	ИспользоватьМногофирменныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоОрганизаций");
	Если Не ИспользоватьМногофирменныйУчет И ЗначениеЗаполнено(Объект.Организация) Тогда
		Элементы.Организация.Вид = ВидПоляФормы.ПолеНадписи;
		Элементы.Организация.Гиперссылка = Истина;
	КонецЕсли;
	
	АдаптацияФормыТакси();
	АдаптацияМобильныйКлиент();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// ОбратнаяСвязь
	ОбратнаяСвязь.ПередЗаписьюДокумента(Отказ, ТекущийОбъект, ПараметрыЗаписи.РежимЗаписи);
	// Конец ОбратнаяСвязь
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
	Оповестить("ИзменениеПоКадровомуУчету");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Запись_Организации" И Источник = Объект.Организация Тогда
		УстановитьВидимостьВкладок();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	УстановитьДоступностьПолейСуммы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ДанныеДляИзмененияДаты = ДокументыУНФКлиент.ДанныеДляИзмененияДаты(ЭтотОбъект, Объект);
	Если ДанныеДляИзмененияДаты.ДатаНеМенялась Тогда
		Возврат;
	КонецЕсли;
	
	ДатаПриИзмененииНаСервере(ДанныеДляИзмененияДаты);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПереходСЗВТДНажатие(Элемент)
	
	ОткрытьФорму("Документ.СведенияОТрудовойДеятельностиРаботниковСЗВ_ТД.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияРеквизитыПечатиНажатие(Элемент)
	
	ОткрытьФормуРеквизитыПечати();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЗакрытьПодсказкуНажатие(Элемент)
	
	ИзменитьОтображениеПодсказки(Элементы, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомментарийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект,
		"Объект.Комментарий");
		
КонецПроцедуры

&НаКлиенте
Процедура РежимПросмотраСотрудникиПриИзменении(Элемент)
	
	ОписаниеПредыдущее = ОписаниеРежимовПросмотра[РежимПросмотраСотрудникиПредыдущий];
	
	ТекущаяСтрока = Элементы[ОписаниеПредыдущее.ИмяТаблицыСотрудники].ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		Элементы.Сотрудники.ТекущаяСтрока = ТекущаяСтрока;
		Элементы.СотрудникиНачислений.ТекущаяСтрока = ТекущаяСтрока;
		Элементы.СотрудникиНалоги.ТекущаяСтрока = ТекущаяСтрока;
	КонецЕсли;
	РежимПросмотраСотрудникиПредыдущий = РежимПросмотраСотрудники;
	
	ОписаниеТекущее = ОписаниеРежимовПросмотра[РежимПросмотраСотрудники];
	Элементы.СтраницыСотрудники.ТекущаяСтраница = Элементы[ОписаниеТекущее.ИмяСтраницы];
	
	ОбновитьЭлементРежимПросмотра();
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыСотрудникиПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ОткрытыйРежим = "";
	Для Каждого Режим Из ОписаниеРежимовПросмотра Цикл
		Если ТекущаяСтраница.Имя = Режим.Значение.ИмяСтраницы Тогда
			ОткрытыйРежим = Режим.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ОткрытыйРежим) И ОткрытыйРежим <> РежимПросмотраСотрудники Тогда
		РежимПросмотраСотрудники = ОткрытыйРежим;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомментарийСвернутоНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияКомментария(Элемент.ТекстРедактирования, ЭтотОбъект,
		"Объект.Комментарий");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСотрудники

&НаКлиенте
Процедура СотрудникиПриАктивизацииСтроки(Элемент)
	
	ТабличныеЧастиУНФКлиент.УстановитьОтборНаПодчиненнуюТабличнуюЧасть(ЭтотОбъект, "НачисленияУдержания");
	ТабличныеЧастиУНФКлиент.УстановитьОтборНаПодчиненнуюТабличнуюЧасть(ЭтотОбъект, "НалогиНаДоходы");
	
КонецПроцедуры

&НаКлиенте
Процедура СотрудникиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ИмяТабличнойЧасти = "Сотрудники";	
	Если НоваяСтрока Тогда
		
		ТабличныеЧастиУНФКлиент.ДобавитьКлючСвязиВСтрокуТабличнойЧасти(ЭтотОбъект);
		ТабличныеЧастиУНФКлиент.УстановитьОтборНаПодчиненнуюТабличнуюЧасть(ЭтотОбъект, "НачисленияУдержания");
		ТабличныеЧастиУНФКлиент.УстановитьОтборНаПодчиненнуюТабличнуюЧасть(ЭтотОбъект, "НалогиНаДоходы");
		
		СтрокаТабличнойЧасти = Элементы.Сотрудники.ТекущиеДанные;
		Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтруктурнаяЕдиница) Тогда
			
			СтрокаТабличнойЧасти.СтруктурнаяЕдиница = ОсновноеПодразделение;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СотрудникиПередУдалением(Элемент, Отказ)

	ИмяТабличнойЧасти = "Сотрудники";
	Для Каждого ВыделеннаяСтрока Из Элементы.Сотрудники.ПолучитьСтрокиДляОбработки() Цикл
		ТекущиеДанныеСтроки = Элементы.Сотрудники.ДанныеСтроки(ВыделеннаяСтрока);
		ТабличныеЧастиУНФКлиент.УдалитьСтрокиПодчиненнойТабличнойЧасти(ЭтотОбъект, "НачисленияУдержания", Ложь,
			ТекущиеДанныеСтроки);
		ТабличныеЧастиУНФКлиент.УдалитьСтрокиПодчиненнойТабличнойЧасти(ЭтотОбъект, "НалогиНаДоходы", Ложь,
			ТекущиеДанныеСтроки);
	КонецЦикла;

	ОбновитьЭлементРежимПросмотра();
КонецПроцедуры

&НаКлиенте
Процедура СотрудникиСотрудникПриИзменении(Элемент)
	
	Элементы.Сотрудники.ТекущиеДанные.ЗанимаемыхСтавок = 1;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНачисленияУдержания

&НаКлиенте
Процедура НачисленияУдержанияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТабличныеЧастиУНФКлиент.ДобавитьКлючСвязиВСтрокуПодчиненнойТабличнойЧасти(ЭтотОбъект, Элемент.Имя);
		СтрокаТабличнойЧасти = Элементы.НачисленияУдержания.ТекущиеДанные;
		СтрокаТабличнойЧасти.Валюта = ВалютаПоУмолчанию;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачисленияУдержанияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
#Если МобильныйКлиент Тогда
	Если НеВыбранаСтрокаСотрудника(Элемент.Имя) Тогда
		Отказ = Истина;
	КонецЕсли; 
#Иначе	
	Если ТабличныеЧастиУНФКлиент.НеВыбранаСтрокаОсновнойТЧ(ЭтотОбъект, Элемент.Имя) Тогда
		Отказ = Истина;
	КонецЕсли; 
#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура НачисленияУдержанияВидНачисленияУдержанияПриИзменении(Элемент)
	
	ЗарплатаИПерсоналКлиент.СчетЗатратПоУмолчаниюВТекущуюСтроку(ЭтотОбъект);
	УстановитьДоступностьПоляСумма();
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияУдержанияСчетЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗарплатаИПерсоналКлиент.ПараметрыВыбораСчетаЗатрат(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНалогиНаДоходы

&НаКлиенте
Процедура НалогиНаДоходыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТабличныеЧастиУНФКлиент.ДобавитьКлючСвязиВСтрокуПодчиненнойТабличнойЧасти(ЭтотОбъект, Элемент.Имя);
		СтрокаТабличнойЧасти = Элементы.НалогиНаДоходы.ТекущиеДанные;
		СтрокаТабличнойЧасти.Валюта = ВалютаПоУмолчанию;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НалогиНаДоходыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
#Если МобильныйКлиент Тогда
	Если НеВыбранаСтрокаСотрудника(Элемент.Имя) Тогда
		Отказ = Истина;
	КонецЕсли; 
#Иначе	
	Если ТабличныеЧастиУНФКлиент.НеВыбранаСтрокаОсновнойТЧ(ЭтотОбъект, Элемент.Имя) Тогда
		Отказ = Истина;
	КонецЕсли; 
#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСотрудникиНачислений

&НаКлиенте
Процедура СотрудникиНачисленийПриАктивизацииСтроки(Элемент)
	ИмяТабличнойЧасти = Элементы.СотрудникиНачислений.Имя;
	ТабличныеЧастиУНФКлиент.УстановитьОтборНаПодчиненнуюТабличнуюЧасть(ЭтотОбъект, Элементы.НачисленияУдержания.Имя);
	
	Если ЭтоМобильныйКлиент И Элемент.ТекущиеДанные <> Неопределено Тогда
		Элементы.ГруппаТаблицаНачисления.Заголовок = СтрШаблон(НСтр("ru = 'Начисления и удержания сотрудника ""%1""'"),
			Элемент.ТекущиеДанные.Сотрудник);
	КонецЕсли;
	
КонецПроцедуры

