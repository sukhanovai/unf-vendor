#Область МобильныйКлиент

&НаСервере
Процедура АдаптацияМобильныйКлиент()
	
	Если Не ЭтоМобильныйКлиент Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.НастройкаОтображенияПредпросмотра.Видимость = Ложь;
	Элементы.НастройкаОтображенияПредпросмотра1.Видимость = Ложь;
	Элементы.СодержаниеПисьмаСнизуОтключениеВидимостиМК.Видимость = Ложь;
	Элементы.СодержаниеПисьмаСправаОтключениеВидимостиМК.Видимость = Ложь;
	
	Если Не ТипСобытия = Перечисления.ТипыСобытий.ЭлектронноеПисьмо Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ПочтовыеЯщики.Видимость = Ложь;
	Элементы.ПочтовыеЯщики.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
	
	Элементы.ГруппаГиперссылокСверхуМК.Видимость = Истина;
	НачальнаяПочтоваяПапка = ПочтовыеЯщики.ПолучитьЭлементы()[0];
	ТекущийПочтовыйЯщик = НачальнаяПочтоваяПапка.ПочтовыйЯщик;
	ТекущаяУчетнаяЗапись = НачальнаяПочтоваяПапка.УчетнаяЗапись;
	Элементы.ВыбратьПочтовуюПапкуМК.Заголовок = НачальнаяПочтоваяПапка.Наименование;
	Элементы.ВыбратьПочтовуюПапкуМК.Картинка = КартинкаВыбраннойПочтовойПапки();
	УстановитьОтборПоПочтовомуЯщикуНаСервере();
	
	Элементы.ГруппаПочтоваяСлужбаОтключениеВидимостиМК.Видимость = Ложь;
	
	Элементы.ГруппаБаннерыОшибкиЗагрузкиОтключениеВидимостиМК.Видимость = Ложь;
	
	Элементы.ПроверитьПочту.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанели;
	Элементы.Список.ВидТаблицыНаМобильномУстройстве = ВидТаблицыФормы.Список;
	Элементы.Список.ПоложениеУправленияПоиском = ПоложениеУправленияПоиском.Нет;
	Элементы.Список.ЗапросОбновления = СпособЗапросаОбновления.ПотянутьСверху;
	Элементы.Переместить(Элементы.СписокНачалоСобытия, Элементы.СтрокаДанныхМК1);
	Элементы.Переместить(Элементы.СписокСостояние, Элементы.СтрокаДанныхМК1);
	Элементы.Переместить(Элементы.СписокСписокУчастников, Элементы.СтрокаДанныхМК2);
	Элементы.Переместить(Элементы.ВажностьЭлектронноеПисьмо, Элементы.СтрокаДанныхМК2);
	Элементы.Переместить(Элементы.СписокТема, Элементы.СтрокаДанныхМК3);
	Элементы.Переместить(Элементы.ЕстьФайлыСписокПисем, Элементы.СтрокаДанныхМК3);
	Элементы.Переместить(Элементы.ГруппаВерхняяСтрокаКолонок, Элементы.КолонкаДанныхМК);
	
	Элементы.ПраваяПанель.ОтображатьКакКарточку = Ложь;
	Элементы.ПраваяПанель.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Авто;
	Элементы.ПраваяПанельСвернутая.Видимость = Ложь;
	Элементы.ПраваяПанельСтраницы.Видимость = Истина;
	Элементы.ПраваяПанельСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	Элементы.ПраваяПанельСтраницы.ТекущаяСтраница = Элементы.ФильтрыНастройкиИДопИнфо;
	Элементы.ГруппаОтступ.Видимость = Ложь;
	Элементы.ФильтрыНастройкиИДопИнфо.Видимость = Ложь;
	УстановитьОтображениеОткрытияФильтровМК();
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьПочтовуюПапкуНаСервере()
	
	Элементы.ГруппаГиперссылокСверхуМК.Видимость = Ложь;
	Элементы.ПочтовыеЯщики.Видимость = Истина;
	Элементы.ЦентральнаяПанель.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПочтовыеЯщикиВыборНаСервере(ВыбраннаяСтрока)
	
	ДанныеСтроки = ПочтовыеЯщики.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ТекущийПочтовыйЯщик = ДанныеСтроки.ПочтовыйЯщик;
	ТекущаяУчетнаяЗапись = ДанныеСтроки.УчетнаяЗапись;
	Элементы.ВыбратьПочтовуюПапкуМК.Заголовок = РаботаСОтборами.ПредставлениеВыбраннойГруппыВИерархии(ДанныеСтроки);
	Элементы.ВыбратьПочтовуюПапкуМК.Картинка = КартинкаВыбраннойПочтовойПапки();
	УстановитьОтборПоПочтовомуЯщикуНаСервере();
	
	Элементы.ПочтовыеЯщики.Видимость = Ложь;
	Элементы.ГруппаГиперссылокСверхуМК.Видимость = Истина;
	Элементы.ЦентральнаяПанель.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОткрытьФильтрыНаСервере()
	
	Элементы.ГруппаГиперссылокСверхуМК.Видимость = Ложь;
	Элементы.ЦентральнаяПанель.Видимость = Ложь;
	
	Элементы.ФильтрыНастройкиИДопИнфо.Видимость = Истина;
	Элементы.ПрименитьУстановкуФильтровМК.Видимость = Истина;
	Элементы.ПрименитьУстановкуФильтровМК.Важность = ВажностьКнопки.Главная;
	Элементы.ПрименитьУстановкуФильтровМК.АктивизироватьПоУмолчанию = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьУстановкуФильтровНаСервере()
	
	Элементы.ГруппаГиперссылокСверхуМК.Видимость = Истина;
	Элементы.ЦентральнаяПанель.Видимость = Истина;
	Элементы.ФильтрыНастройкиИДопИнфо.Видимость = Ложь;
	
	Элементы.ПрименитьУстановкуФильтровМК.Видимость = Ложь;
	Элементы.ПрименитьУстановкуФильтровМК.Важность = ВажностьКнопки.Обычная;
	Элементы.ПрименитьУстановкуФильтровМК.АктивизироватьПоУмолчанию = Ложь;
	УстановитьОтображениеОткрытияФильтровМК();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтображениеОткрытияФильтровМК()
	
	Если КоличествоФильтров Тогда
		Элементы.ОткрытьФильтрыМК.Отображение = ОтображениеКнопки.КартинкаИТекст;
		Элементы.ОткрытьФильтрыМК.Заголовок = СтрШаблон("(%1)", КоличествоФильтров);
	Иначе
		Элементы.ОткрытьФильтрыМК.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
КонецПроцедуры

