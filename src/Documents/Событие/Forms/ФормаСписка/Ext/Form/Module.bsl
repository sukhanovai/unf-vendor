
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();
	
	ВывестиБаннеры();
	
	АвторизованныйПользователь = Пользователи.АвторизованныйПользователь();
	УстановитьУсловноеОформление();
	УстановитьУсловноеОформлениеПоСостояниямСобытий();
	УстановитьУсловноеОформлениеОтмененныхСобытий();
	УстановитьОтборТекущиеДела();
	
	Если Параметры.Свойство("ТипСобытия") Тогда
		ТипСобытия = Параметры.ТипСобытия;
	КонецЕсли;
	
	//@skip-check optional-form-parameter-access
	Если Параметры.Свойство("ТипСобытия") И Параметры.ТипСобытия = Перечисления.ТипыСобытий.ЭлектронноеПисьмо Тогда
		ЗаполнитьПочтовыеЯщики();
		УстановитьОтборПоПочтовомуЯщикуНаСервере();
	КонецЕсли;
	
	//@skip-check unknown-form-parameter-access
	Если Параметры.Свойство("Контакт") И ЗначениеЗаполнено(Параметры.Контакт) Тогда
		КонтекстКонтакт = Параметры.Контакт;
	КонецЕсли;

	Если Параметры.Свойство("ПульсБизнеса") Тогда   
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'События: Пульс бизнеса'");
	КонецЕсли;
	
	ЛидыДоступны = РаботаСЛидами.ЛидыДоступны();
	Если Не ЛидыДоступны Тогда
		Список.Параметры.УстановитьЗначениеПараметра("НетДоступаКЛидам",Истина);
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("ОтборСпам", ОтборСпам);
	
	Если Элементы.СписокГруппаСоздатьОбертка.Видимость Тогда
		Элементы.СписокГруппаСоздатьОбертка.Видимость = ПравоДоступа("Добавление", Метаданные.Документы.Событие);
	КонецЕсли;
	
	УстановитьОтборПоКонтактам();
	
	//@skip-check unknown-form-parameter-access
	Если Параметры.Свойство("ДокументОснование") И ЗначениеЗаполнено(Параметры.ДокументОснование) Тогда
		УстановитьОтборПоДокументОснование(Параметры.ДокументОснование);
	КонецЕсли;
	
	КонтекстноеОткрытие = Параметры.Свойство("ТекущиеДела") Или Параметры.Свойство("Контакт") Или Параметры.Свойство("ДокументОснование") Или Параметры.Свойство("ПульсБизнеса");
	
	ЗаполнитьКомандыИзмененияСостояния();
	
	ПредставлениеПериода = РаботаСОтборамиКлиентСервер.ОбновитьПредставлениеПериода(ОтборПериод);
	
	// УНФ.ПанельКонтактнойИнформации
	КонтактнаяИнформацияПанельУНФ.ПриСозданииНаСервере(ЭтотОбъект, "КонтактнаяИнформация", "СписокКонтекстноеМеню");
	// Конец УНФ.ПанельКонтактнойИнформации
	
	ОтчетыУНФ.ПриСозданииНаСервереФормыСвязанногоОбъекта(ЭтотОбъект);
		
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Элементы.Список.РежимВыбора = Параметры.РежимВыбора;
	РежимОткрытияОкна = ?(Параметры.РежимВыбора,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца, РежимОткрытияОкнаФормы.Независимый);
	
	ПланироватьЗагрузкуРесурсовПредприятияЖурналЗаписи = ПолучитьФункциональнуюОпцию("ПланироватьЗагрузкуРесурсовПредприятияЖурналЗаписи");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Элементы, "ФормаСоздатьЗапись", "Видимость", ПланироватьЗагрузкуРесурсовПредприятияЖурналЗаписи);
	
	ПредпросмотрПриСозданииНаСервере();
	
	ВремяЗадержкиОбработчиковОжиданияПриАктивизацииСписка = 0.3;
	
	Если Параметры.Свойство("ТипСобытия") Тогда
		ОтборТипСобытия = Параметры.ТипСобытия;
	КонецЕсли;
	
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(Список);
	
	// УНФ.ОтборыСписка
	ИменаНетиповыхОтборов = "ОтборВходящееИсходящее,ОтборПропущенные,ОтборСпам";
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект);
	Если НЕ КонтекстноеОткрытие Тогда
		
		РаботаСОтборами.ВосстановитьНастройкиОтборов(
		ЭтотОбъект,
		Список, , ,
		Новый Структура("ОтборПериод", "НачалоСобытия"),
		ОтборТипСобытия, , , , , ,
		"Контакты,ГруппаРаботаСОтборами,ЗначокКонтакты",
		ТипСобытия = Перечисления.ТипыСобытий.ЭлектронноеПисьмо);
		
	Иначе
		РаботаСОтборами.ОпределитьОтображениеПравойПанели(ЭтотОбъект, , "Контакты,ГруппаРаботаСОтборами,ГруппаОтступ");
		РаботаСОтборамиКлиентСервер.УстановитьОтображениеКомандыСброситьВсеОтборы(ЭтотОбъект);
		РаботаСОтборами.СвернутьРазвернутьОтборыНаСервере(ЭтотОбъект, Ложь);
	КонецЕсли;
	// Конец УНФ.ОтборыСписка
	
	УправлениеФормойСервер(Истина);
	
	АдаптацияМобильныйКлиент();
	АдаптацияТакси();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнениеВремениОбработчиковОжидания();
	
	ОтобразитьПочтовыеЯщикиПриОткрытии();
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если НЕ ЗавершениеРаботы И НЕ КонтекстноеОткрытие Тогда
		//УНФ.ОтборыСписка
		СохранитьНастройкиОтборов();
		//Конец УНФ.ОтборыСписка
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_СостоянияСобытий" Тогда
		УстановитьУсловноеОформлениеПоСостояниямСобытий();
		ЗаполнитьКомандыИзмененияСостояния();
	ИначеЕсли ИмяСобытия = "Запись_Событие" Тогда		
		Элементы.Список.Обновить();
	КонецЕсли;
	
	Если ИмяСобытия = ЭлектроннаяПочтаУНФКлиентСервер.ИмяСобытияУчетнаяЗаписьОбновлена() Тогда
		Если НЕ ПочтовыеСлужбыПодключены Тогда
			НастроитьГруппуПочтоваяСлужба();
			НачатьПроверкуПочты(ЭлектроннаяПочтаУНФКлиентСервер.РежимЗагрузкиНовыеСообщения());
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "ОбновитьСеансовыеДанные" Тогда
		ОбработатьРезультатЗапросаТокена(Параметр, );
	КонецЕсли;
	
	ОбработкаОповещенияУчетныеЗаписи(ИмяСобытия, Параметр, Источник);
	ОбработкаОповещенияЗагруженыНовыеПисьма(ИмяСобытия, Параметр, Источник);
	
	НужноПоказатьСодержание =
	ИмяСобытия = "Запись_Контрагент"
	Или ИмяСобытия = "Запись_КонтактноеЛицо"
	Или ИмяСобытия = РаботаСЛидамиКлиентСервер.КлючОповещения()
	Или ИмяСобытия = "Запись_ЭлектронноеПисьмо"
	Или ИмяСобытия = "Запись_Событие";
	Если НужноПоказатьСодержание Тогда
		ПодключитьОбработчикОжидания("ПоказатьСодержаниеПисьмаОбработчик", 0.1, Истина);
	КонецЕсли;
	
	// УНФ.ПанельКонтактнойИнформации
	Если КонтактнаяИнформацияПанельУНФКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьПанельКонтактнойИнформацииСервер();
	КонецЕсли;
	// Конец УНФ.ПанельКонтактнойИнформации
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборКонтрагентОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ОтборКонтакты = Новый Массив;
	ОтборКонтакты.Добавить(ВыбранноеЗначение);
	
	ДополнитьОтборПоКонтрагентуЛидами(ОтборКонтакты, КонтекстКонтакт);
	ДополнитьОтборПоКонтрагентуКонтактами(ОтборКонтакты, ВыбранноеЗначение);
	ДополнитьОтборАдресатамиПисем(ОтборКонтакты, ВыбранноеЗначение);
	
	УстановитьМеткуИОтборСписка("ТЧУчастники.Контакт", Элемент.Родитель.Имя, ОтборКонтакты, Строка(ВыбранноеЗначение));
	
	ВыбранноеЗначение = Неопределено;
	
КонецПроцедуры

