	ПараметрыВФорму = Новый Структура;
	ПараметрыВФорму.Вставить("НастройкаСпискаСобытий", Истина);
	ОткрытьФорму("Документ.Событие.Форма.ФормаНастройкаСписка", ПараметрыВФорму, , , , , ОповещениеОЗакрытии);
	
КонецПроцедуры

