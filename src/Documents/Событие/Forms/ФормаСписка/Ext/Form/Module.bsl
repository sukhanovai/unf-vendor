&НаКлиенте
Процедура СписокПриАктивизацииСтрокиОбработчик()
	
	Если Элементы.Список.ТекущиеДанные = Неопределено
		Или ТипЗнч(Элементы.Список.ТекущаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = Элементы.Список.ТекущиеДанные.Ссылка;
	
	Если ЭтотОбъект.Предпросмотр_НужноЗаполнитьПредпросмотрПриАктивизацииСтрокиТаблицы Тогда
		НужноЗаполнитьПредпросмотрНаОснованииПисьма = НужноЗаполнитьПредпросмотрНаОснованииПисьма();
	Иначе
		НужноЗаполнитьПредпросмотрНаОснованииПисьма = Ложь;
	КонецЕсли;
	
	//@skip-check module-self-reference
	СписокПриАктивизацииСтрокиОбработчикНаСервере(
	Ссылка,
	НужноЗаполнитьПредпросмотрНаОснованииПисьма,
	ЭтотОбъект.КИ_НужноИзменитьДанныеПриАктивизацииСтрокиТаблицы,
	Элементы.Список.ТекущиеДанные.ЭтоСпам);
	
КонецПроцедуры

&НаСервере
Процедура СписокПриАктивизацииСтрокиОбработчикНаСервере(
	Знач Ссылка, Знач НужноЗаполнитьПредпросмотрНаОснованииПисьма, Знач НужноИзменитьКИ, ЭтоСпам)
	
	Если НужноЗаполнитьПредпросмотрНаОснованииПисьма Тогда
		ЗаполнитьПредпросмотрНаОсновеПисьма();
	КонецЕсли;
	
	Если НужноИзменитьКИ Тогда
		ОбновитьПанельКонтактнойИнформацииСервер();
	КонецЕсли;
	
	ОбновитьИнтерфейсКомандПоЗаявкам(Ссылка);
	
	Элементы.БаннерСпам.Видимость = ЭтоСпам И Не ЭтоМобильныйКлиент;
	
КонецПроцедуры

#КонецОбласти

#Область ИзменениеСостояний

&НаСервере
Процедура ЗаполнитьКомандыИзмененияСостояния()
	
	СостоянияДокументов.ЗаполнитьКомандыИзмененияСостояний(
	ЭтотОбъект, Элементы.СписокКонтекстноеМенюУстановитьСостояние, Истина, Элементы.Список);
	СостоянияДокументов.ЗаполнитьКомандыИзмененияСостояний(
	ЭтотОбъект, Элементы.СписокКонтекстноеМенюУстановитьСостояние1, Истина, Элементы.Список);
	
КонецПроцедуры

#КонецОбласти 

#Область УправлениеФормой

&НаСервере
Процедура УправлениеФормойСервер(ОткрытиеФормы = Ложь)
	
	РежимОткрытияСписка = "ОбщийСписок";
	ЭтоСписокПисем = Ложь;
	
	Если ЗначениеЗаполнено(Параметры.ТипСобытия) Тогда
		РежимОткрытияСписка = "СписокСОтборомПоТипу";
		Если Параметры.ТипСобытия = Перечисления.ТипыСобытий.ЭлектронноеПисьмо Тогда
			ЭтоСписокПисем = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("ЭтоСписокПисем", ЭтоСписокПисем);
	
	Если РежимОткрытияСписка = "ОбщийСписок" ИЛИ РежимОткрытияСписка = "СписокСОтборомПоТипу" Тогда
		Элементы.ГруппаПочтовыеПапки.Видимость = Ложь;
		Элементы.ГруппаКоманднаяПанель.Видимость = Истина;
		Элементы.ГруппаКоманднаяПанельФормы.Видимость = Истина;
		Элементы.ГруппаКоманднаяПанельЭлектронноеПисьмо.Видимость = Ложь;
		Элементы.ГруппаКоманднаяПанельФормыЭлектронноеПисьмо.Видимость = Ложь;
		ОпределитьОтображениеДополнительныхОтборов(Истина);
		Элементы.ФормаУчетныеЗаписи.Видимость = Ложь;
		Элементы.Список.ПутьКДаннымКартинкиСтроки = "Список.ИндексПиктограммы";
		Элементы.Непрочитанное.Видимость = Ложь;
		Элементы.СписокКонтекстноеМенюГруппаЭлектронноеПисьмо.Видимость = Ложь;
		Элементы.ЕстьФайлыСписокПисем.Видимость = Ложь;
	КонецЕсли;
	
	Если РежимОткрытияСписка = "СписокСОтборомПоТипу" Тогда
		Элементы.ГруппаПочтовыеПапки.Видимость = ЭтоСписокПисем;
		Элементы.ФормаУчетныеЗаписи.Видимость = ЭтоСписокПисем;
		Элементы.ГруппаКоманднаяПанель.Видимость = НЕ ЭтоСписокПисем;
		Элементы.ГруппаКоманднаяПанельФормы.Видимость = НЕ ЭтоСписокПисем;
		Элементы.ГруппаКоманднаяПанельЭлектронноеПисьмо.Видимость = ЭтоСписокПисем;
		Элементы.ГруппаКоманднаяПанельФормыЭлектронноеПисьмо.Видимость = ЭтоСписокПисем;
		Элементы.СписокКонтекстноеМенюГруппаЭлектронноеПисьмо.Видимость = ЭтоСписокПисем;
		ОпределитьОтображениеДополнительныхОтборов(Параметры.ТипСобытия <> Перечисления.ТипыСобытий.СообщениеSMS
		И Параметры.ТипСобытия <> Перечисления.ТипыСобытий.ЭлектронноеПисьмо);
		АвтоЗаголовок = Ложь;
		Элементы.ОтборТипСобытия.Видимость = Ложь;
		Элементы.СписокГруппаСоздатьОбертка.Видимость = Ложь;
		Элементы.ФормаГруппаСоздать.Видимость = Истина;
		УстановитьОтображениеГруппыПочтоваяСлужбаНаСервере(ЭтоСписокПисем);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список, "ТипСобытия", Параметры.ТипСобытия);
		Элементы.СписокОкончаниеСобытия.Видимость = НЕ ЭтоСписокПисем;
		
		Элементы.Непрочитанное.Видимость = ЭтоСписокПисем;
		
		Элементы.Проекты.Видимость = Не (Параметры.ТипСобытия = Перечисления.ТипыСобытий.СообщениеSMS
			ИЛИ Параметры.ТипСобытия = Перечисления.ТипыСобытий.ЭлектронноеПисьмо);
		
		Если Параметры.ТипСобытия = Перечисления.ТипыСобытий.ТелефонныйЗвонок Тогда
			Заголовок = НСтр("ru='События: телефонные звонки'");
		ИначеЕсли Параметры.ТипСобытия = Перечисления.ТипыСобытий.ЭлектронноеПисьмо Тогда
			Заголовок = НСтр("ru='Почта'");
		ИначеЕсли Параметры.ТипСобытия = Перечисления.ТипыСобытий.СообщениеSMS Тогда
			Заголовок = НСтр("ru='События: сообщения SMS'");
		ИначеЕсли Параметры.ТипСобытия = Перечисления.ТипыСобытий.ЛичнаяВстреча Тогда
			Заголовок = НСтр("ru='События: личные встречи'");
		ИначеЕсли Параметры.ТипСобытия = Перечисления.ТипыСобытий.Прочее Тогда
			Заголовок = НСтр("ru='События: прочие'");
		ИначеЕсли Параметры.ТипСобытия = Перечисления.ТипыСобытий.Запись Тогда
			Заголовок = НСтр("ru='События: запись'");
			Элементы.СписокТема.Видимость = Ложь;
			Элементы.ОтборВходящееИсходящее.Видимость = Ложь;
			Элементы.ОтборПроект.Видимость = Ложь;
		КонецЕсли;
		
		Элементы.Список.ПутьКДаннымКартинкиСтроки = "Список.ИндексПиктограммы";
		
		Если ЭтоСписокПисем Тогда
			
			Элементы.Переместить(Элементы.ГруппаВажныеКоманды, Элементы.ГруппаВажныеКомандыПисем);
			Элементы.Переместить(Элементы.СписокКонтекстноеМенюГруппаСтандартные, Элементы.ГруппаУстановкиСостоянияПисем);
			
			Если Не ЭтоИнтерфейсТакси Тогда
				// Нужно, чтобы в списке писем в видимой области в КП строки отображались другие команды
				Элементы.Переместить(
				Элементы.ГруппаКоманднаяПанельЭлектронноеПисьмо, Элементы.КоманднаяПанельСписка, Элементы.ГруппаКоманднаяПанель);
			КонецЕсли;
			
		КонецЕсли;
		
		Элементы.ПроверитьПочту.Видимость = Ложь;
		Элементы.ГруппаБаннерыОшибкиЗагрузки.Видимость = ЭтоСписокПисем;
		
	КонецЕсли;
	
	Если ЭтоСписокПисем Тогда
		
		Элементы.ЕстьФайлы.Видимость = Ложь;
		Элементы.ПодключитьУчетнуюЗапись.Видимость = ПравоДоступа("Добавление", 
			Метаданные.Справочники.УчетныеЗаписиЭлектроннойПочты);
		Элементы.Список.ПутьКДаннымКартинкиСтроки = "Список.КартинкаПисем";
		Элементы.СписокНачалоСобытия.Заголовок = НСтр("ru = 'Дата'");
		УстановитьНастройкиСпискаПисем();
		
	Иначе
		
		ОбновитьПоложениеПредпросмотра();
		
	КонецЕсли;
	
	НастроитьГруппуПочтоваяСлужба(ОткрытиеФормы);
	Элементы.ПроверитьПочту.Видимость = ПочтовыеСлужбыПодключены;
	ОбновитьОтображениеКомандСоздания(РежимОткрытияСписка, ЭтоСписокПисем);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнтерфейсКомандПоЗаявкам(Событие)
	
	ЗаголовокКомандыСозданияЗаказаПокупателя = НСтр("ru = 'Заказ покупателя'");
	ЗаголовокКомандыСозданияЗаказНаряда = НСтр("ru = 'Заказ-наряд'");
	
	ПервыйКонтактПисьма = Документы.Событие.ПервыйКонтакт(Событие);
	ПервыйКонтактЭтоЛид = (ТипЗнч(ПервыйКонтактПисьма) = Тип("СправочникСсылка.Лиды"));
	
	Если ПервыйКонтактЭтоЛид Тогда
		
		ИспользованиеЗаявок = РаботаСЗаявками.ИспользованиеЗаявокПоВидуОперации();
		
		Если ИспользованиеЗаявок[Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу] Тогда
			ЗаголовокКомандыСозданияЗаказаПокупателя = НСтр("ru = 'Заказ покупателя (заявка)'");
		КонецЕсли;
		Если ИспользованиеЗаявок[Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаряд] Тогда
			ЗаголовокКомандыСозданияЗаказНаряда = НСтр("ru = 'Заказ-наряд (заявка)'");
		КонецЕсли;
		
	КонецЕсли;
	
	КомандаСоздания = Элементы.Найти("ФормаДокументЗаказПокупателяСоздатьНаОсновании");
	Если КомандаСоздания <> Неопределено Тогда
		КомандаСоздания.Заголовок = ЗаголовокКомандыСозданияЗаказаПокупателя;
	КонецЕсли;
	КомандаСоздания = Элементы.Найти("ФормаДокументЗаказПокупателяСоздатьНаОсновании1");
	Если КомандаСоздания <> Неопределено Тогда
		КомандаСоздания.Заголовок = ЗаголовокКомандыСозданияЗаказаПокупателя;
	КонецЕсли;
	КомандаСоздания = Элементы.Найти("ФормаДокументСобытиеКомандаЗаказНарядСоздатьНаОсновании");
	Если КомандаСоздания <> Неопределено Тогда
		КомандаСоздания.Заголовок = ЗаголовокКомандыСозданияЗаказНаряда;
	КонецЕсли;
	КомандаСоздания = Элементы.Найти("ФормаДокументСобытиеКомандаЗаказНарядСоздатьНаОсновании1");
	Если КомандаСоздания <> Неопределено Тогда
		КомандаСоздания.Заголовок = ЗаголовокКомандыСозданияЗаказНаряда;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФормой()
	
	Элементы.Контрагенты.Видимость = НЕ ЗначениеЗаполнено(КонтекстКонтакт);
	
	Элементы.ОтборПропущенные.Видимость = ОтборТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.ТелефонныйЗвонок")
		И ОтборВходящееИсходящее = ПредопределенноеЗначение("Перечисление.ВходящееИсходящееСобытие.Входящее");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеКомандСоздания(РежимОткрытияСписка, ЭтоСписокПисем)
	
	ПоказыватьПодменюКомандСоздания = (РежимОткрытияСписка = "ОбщийСписок");
	ПоказыватьСтандартнуюКомандуСоздания = (РежимОткрытияСписка = "СписокСОтборомПоТипу" И Не ЭтоСписокПисем);
	ПоказыватьКомандуСозданияПисьма = ЭтоСписокПисем;
	
	Элементы.СписокСоздатьЛичнаяВстреча.Видимость = ПоказыватьПодменюКомандСоздания;
	Элементы.СписокСоздатьЭлектронноеПисьмо.Видимость = ПоказыватьПодменюКомандСоздания;
	Элементы.СписокСоздатьСообщениеSMS.Видимость = ПоказыватьПодменюКомандСоздания;
	Элементы.ФормаСоздатьЗапись.Видимость = ПоказыватьПодменюКомандСоздания И ПланироватьЗагрузкуРесурсовПредприятияЖурналЗаписи;
	Элементы.СписокСоздатьПрочее.Видимость = ПоказыватьПодменюКомандСоздания;
	Элементы.СписокСоздатьТелефонныйЗвонок.Видимость = ПоказыватьПодменюКомандСоздания;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Элементы, "ФормаСоздать", "Видимость", ПоказыватьСтандартнуюКомандуСоздания);
	Элементы.СоздатьЭлектронноеПисьмо.Видимость = ПоказыватьКомандуСозданияПисьма;
	Элементы.СоздатьЭлектронноеПисьмоТакси.Видимость = ПоказыватьКомандуСозданияПисьма;
	
КонецПроцедуры

#КонецОбласти

#Область ПанельКонтактнойИнформации

&НаСервере
Процедура ОбновитьПанельКонтактнойИнформацииСервер()
	
	Если НЕ ЗначениеЗаполнено(ТекущееСобытие) Тогда
		КонтактнаяИнформацияПанельУНФ.ОбновитьДанныеПанели(ЭтотОбъект, ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	Документ.Событие.Участники КАК СобытиеУчастники
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиАдресатКонтактCRM КАК СвязиАдресатКонтактCRM
	|		ПО (СвязиАдресатКонтактCRM.Адресат = СобытиеУчастники.Контакт)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО (СобытиеУчастники.Контакт = Контрагенты.Ссылка
	|				ИЛИ СвязиАдресатКонтактCRM.КонтактCRM = Контрагенты.Ссылка)
	|ГДЕ
	|	СобытиеУчастники.Ссылка = &Событие";
	
	Запрос.УстановитьПараметр("Событие", ТекущееСобытие);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТекущийВладелецКИ = Выборка.Контрагент;
	Иначе
		ТекущийВладелецКИ = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	КонтактнаяИнформацияПанельУНФ.ОбновитьДанныеПанели(ЭтотОбъект, ТекущийВладелецКИ);
	
КонецПроцедуры

//@skip-check module-unused-method
&НаКлиенте
Процедура Подключаемый_ДанныеПанелиКонтактнойИнформацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	КонтактнаяИнформацияПанельУНФКлиент.ДанныеПанелиКонтактнойИнформацииВыбор(ЭтотОбъект, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	
КонецПроцедуры

//@skip-check module-unused-method
&НаКлиенте
Процедура Подключаемый_ДанныеПанелиКонтактнойИнформацииПриАктивизацииСтроки(Элемент)
	
	КонтактнаяИнформацияПанельУНФКлиент.ДанныеПанелиКонтактнойИнформацииПриАктивизацииСтроки(ЭтотОбъект, Элемент);
	
КонецПроцедуры

//@skip-check module-unused-method
&НаКлиенте
Процедура Подключаемый_ДанныеПанелиКонтактнойИнформацииВыполнитьКоманду(Команда)
	
	КонтактнаяИнформацияПанельУНФКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, ТекущийВладелецКИ);
	
КонецПроцедуры
