		|	Событие.ВходящееИсходящееСобытие КАК ВходящееИсходящееСобытие
		|ИЗ
		|	Документ.Событие КАК Событие
		|ГДЕ
		|	Событие.Ссылка В(&События)";
	
	Запрос.УстановитьПараметр("События", События);
	ТаблицаСобытий = Запрос.Выполнить().Выгрузить();
