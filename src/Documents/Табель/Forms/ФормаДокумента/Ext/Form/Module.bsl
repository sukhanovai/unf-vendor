&НаСервереБезКонтекста
Функция ДанныеСотрудников(Знач Организация, Знач Подразделение, Знач ПериодРегистрации)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", Подразделение);
	Запрос.УстановитьПараметр("ДатаНачала",			ПериодРегистрации);
	
	ТекстЗапроса =
	"
	|ВЫБРАТЬ
	|	ДанныеУвольнения.Период КАК ДатаУвольнения,
	|	ДанныеУвольнения.Сотрудник КАК УволенныйСотрудник
	|ПОМЕСТИТЬ ДанныеУвольнения
	|ИЗ
	|	РегистрСведений.Сотрудники.СрезПоследних(
	|			КОНЕЦПЕРИОДА(&ДатаНачала, МЕСЯЦ),
	|			Организация = &Организация
	|				И СтруктурнаяЕдиница = ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|				И Должность = ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК ДанныеУвольнения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеУвольнения.УволенныйСотрудник КАК УволенныйСотрудник,
	|	МАКСИМУМ(УсловияРаботыДоУвольнения.Период) КАК ПериодЗаписиПередУвольнением
	|ПОМЕСТИТЬ ПериодЗаписиУсловийТрудаДоУвольнения
	|ИЗ
	|	ДанныеУвольнения КАК ДанныеУвольнения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Сотрудники КАК УсловияРаботыДоУвольнения
	|		ПО (УсловияРаботыДоУвольнения.Период <= ДанныеУвольнения.ДатаУвольнения)
	|			И ДанныеУвольнения.УволенныйСотрудник = УсловияРаботыДоУвольнения.Сотрудник
	|ГДЕ
	|	УсловияРаботыДоУвольнения.Период <= КОНЕЦПЕРИОДА(&ДатаНачала, МЕСЯЦ)
	|	И УсловияРаботыДоУвольнения.Организация = &Организация
	|	И УсловияРаботыДоУвольнения.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеУвольнения.УволенныйСотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеУвольнения.ДатаУвольнения КАК ДатаУвольнения,
	|	УсловияРаботыДоУвольнения.Организация КАК Организация,
	|	УсловияРаботыДоУвольнения.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	УсловияРаботыДоУвольнения.Должность КАК Должность,
	|	УсловияРаботыДоУвольнения.Сотрудник КАК Сотрудник,
	|	УсловияРаботыДоУвольнения.ЗанимаемыхСтавок КАК ЗанимаемыхСтавок,
	|	ИСТИНА КАК ЭтоУвольнение
	|ПОМЕСТИТЬ ДанныеУвольненияСДеталями
	|ИЗ
	|	ДанныеУвольнения КАК ДанныеУвольнения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПериодЗаписиУсловийТрудаДоУвольнения КАК ПериодЗаписиУсловийТрудаДоУвольнения
	|		ПО ДанныеУвольнения.УволенныйСотрудник = ПериодЗаписиУсловийТрудаДоУвольнения.УволенныйСотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Сотрудники КАК УсловияРаботыДоУвольнения
	|		ПО (ПериодЗаписиУсловийТрудаДоУвольнения.ПериодЗаписиПередУвольнением = УсловияРаботыДоУвольнения.Период)
	|			И (ПериодЗаписиУсловийТрудаДоУвольнения.УволенныйСотрудник = УсловияРаботыДоУвольнения.Сотрудник)
	|ГДЕ
	|	УсловияРаботыДоУвольнения.Организация = &Организация
	|	И УсловияРаботыДоУвольнения.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	УсловияРаботыДоУвольнения.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(СотрудникиСрезПоследних.Период) КАК Период,
	|	СотрудникиСрезПоследних.Организация КАК Организация,
	|	СотрудникиСрезПоследних.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ ПериодАктуальнойЗаписиПоСотрудникам
	|ИЗ
	|	РегистрСведений.Сотрудники.СрезПоследних(&ДатаНачала, Организация = &Организация) КАК СотрудникиСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	СотрудникиСрезПоследних.Организация,
	|	СотрудникиСрезПоследних.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПериодАктуальнойЗаписиПоСотрудникам.Период КАК П1,
	|	СотрудникиСрезПоследних.Период КАК Период,
	|	СотрудникиСрезПоследних.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	СотрудникиСрезПоследних.Сотрудник КАК Сотрудник,
	|	СотрудникиСрезПоследних.Должность КАК Должность,
	|	СотрудникиСрезПоследних.ЗанимаемыхСтавок КАК ЗанимаемыхСтавок,
	|	СотрудникиСрезПоследних.ГрафикРаботы КАК ГрафикРаботы
	|ПОМЕСТИТЬ ДанныеСотрудникаНаНачалоМесяца
	|ИЗ
	|	ПериодАктуальнойЗаписиПоСотрудникам КАК ПериодАктуальнойЗаписиПоСотрудникам
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Сотрудники.СрезПоследних(
	|				&ДатаНачала,
	|				Организация = &Организация
	|					И СтруктурнаяЕдиница = &СтруктурнаяЕдиница) КАК СотрудникиСрезПоследних
	|		ПО ПериодАктуальнойЗаписиПоСотрудникам.Период = СотрудникиСрезПоследних.Период
	|			И ПериодАктуальнойЗаписиПоСотрудникам.Сотрудник = СотрудникиСрезПоследних.Сотрудник
	|ГДЕ
	|	НЕ СотрудникиСрезПоследних.Сотрудник ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(КадровыеПеремещения.Период) КАК Период,
	|	КадровыеПеремещения.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	КадровыеПеремещения.Сотрудник КАК Сотрудник,
	|	КадровыеПеремещения.ЗанимаемыхСтавок КАК ЗанимаемыхСтавок
	|ПОМЕСТИТЬ ЗаписьКадровогоПеремещенияТекущегоПериода
	|ИЗ
	|	РегистрСведений.Сотрудники КАК КадровыеПеремещения,
	|	ДанныеСотрудникаНаНачалоМесяца КАК ДанныеСотрудникаНаНачалоМесяца
	|ГДЕ
	|	КадровыеПеремещения.Период МЕЖДУ &ДатаНачала И КОНЕЦПЕРИОДА(&ДатаНачала, МЕСЯЦ)
	|	И КадровыеПеремещения.Организация = &Организация
	|	И НЕ(КадровыеПеремещения.СтруктурнаяЕдиница В (ДанныеСотрудникаНаНачалоМесяца.СтруктурнаяЕдиница)
	|				И КадровыеПеремещения.Должность В (ДанныеСотрудникаНаНачалоМесяца.Должность))
	|	И КадровыеПеремещения.СтруктурнаяЕдиница <> ЗНАЧЕНИЕ(Справочник.СтруктурныеЕдиницы.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	КадровыеПеремещения.СтруктурнаяЕдиница,
	|	КадровыеПеремещения.Сотрудник,
	|	КадровыеПеремещения.ЗанимаемыхСтавок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДанныеСотрудникаНаНачалоМесяца.Период < &ДатаНачала
	|			ТОГДА &ДатаНачала
	|		ИНАЧЕ ДанныеСотрудникаНаНачалоМесяца.Период
	|	КОНЕЦ КАК Период,
	|	ДанныеСотрудникаНаНачалоМесяца.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ДанныеСотрудникаНаНачалоМесяца.Сотрудник КАК Сотрудник,
	|	ДанныеСотрудникаНаНачалоМесяца.Должность КАК Должность,
	|	ДанныеСотрудникаНаНачалоМесяца.ЗанимаемыхСтавок КАК ЗанимаемыхСтавок,
	|	ЛОЖЬ КАК ЭтоУвольнение
	|ПОМЕСТИТЬ УсловияОплатыТруда
	|ИЗ
	|	ДанныеСотрудникаНаНачалоМесяца КАК ДанныеСотрудникаНаНачалоМесяца
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сотрудники.Период,
	|	Сотрудники.СтруктурнаяЕдиница,
	|	Сотрудники.Сотрудник,
	|	Сотрудники.Должность,
	|	Сотрудники.ЗанимаемыхСтавок,
	|	ЛОЖЬ
	|ИЗ
	|	РегистрСведений.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Период МЕЖДУ &ДатаНачала И КОНЕЦПЕРИОДА(&ДатаНачала, МЕСЯЦ)
	|	И Сотрудники.Организация = &Организация
	|	И Сотрудники.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ДанныеУвольненияСДеталями.ДатаУвольнения,
	|	ДанныеУвольненияСДеталями.СтруктурнаяЕдиница,
	|	ДанныеУвольненияСДеталями.Сотрудник,
	|	ДанныеУвольненияСДеталями.Должность,
	|	ДанныеУвольненияСДеталями.ЗанимаемыхСтавок,
	|	ИСТИНА
	|ИЗ
	|	ДанныеУвольненияСДеталями КАК ДанныеУвольненияСДеталями
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УсловияОплатыТруда.Период КАК Период,
	|	УсловияОплатыТруда.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	УсловияОплатыТруда.Сотрудник КАК Сотрудник,
	|	УсловияОплатыТруда.ЗанимаемыхСтавок КАК ЗанимаемыхСтавок,
	|	УсловияОплатыТруда.ЭтоУвольнение КАК ЭтоУвольнение
	|ПОМЕСТИТЬ ПериодыУсловияОплатыТруда
	|ИЗ
	|	УсловияОплатыТруда КАК УсловияОплатыТруда
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗаписьКадровогоПеремещенияТекущегоПериода.Период,
	|	ЗаписьКадровогоПеремещенияТекущегоПериода.СтруктурнаяЕдиница,
	|	ЗаписьКадровогоПеремещенияТекущегоПериода.Сотрудник,
	|	ЗаписьКадровогоПеремещенияТекущегоПериода.ЗанимаемыхСтавок,
	|	ЛОЖЬ
	|ИЗ
	|	ЗаписьКадровогоПеремещенияТекущегоПериода КАК ЗаписьКадровогоПеремещенияТекущегоПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПериодыУсловияОплатыТруда.Период КАК ПериодДо,
	|	МАКСИМУМ(УсловияОплатыТруда.Период) КАК ПериодС,
	|	УсловияОплатыТруда.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ СовмещенныеПериоды
	|ИЗ
	|	УсловияОплатыТруда КАК УсловияОплатыТруда
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПериодыУсловияОплатыТруда КАК ПериодыУсловияОплатыТруда
	|		ПО УсловияОплатыТруда.Период < ПериодыУсловияОплатыТруда.Период
	|			И УсловияОплатыТруда.Сотрудник = ПериодыУсловияОплатыТруда.Сотрудник
	|
	|СГРУППИРОВАТЬ ПО
	|	ПериодыУсловияОплатыТруда.Период,
	|	УсловияОплатыТруда.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УсловияОплатыТруда.Период КАК Период,
	|	СовмещенныеПериоды.ПериодДо КАК ПериодДо,
	|	УсловияОплатыТруда.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	УсловияОплатыТруда.Сотрудник КАК Сотрудник,
	|	УсловияОплатыТруда.Должность КАК Должность,
	|	УсловияОплатыТруда.ЗанимаемыхСтавок КАК ЗанимаемыхСтавок,
	|	УсловияОплатыТруда.ЭтоУвольнение КАК ЭтоУвольнение
	|ПОМЕСТИТЬ ТаблицаСПолнымиДанными
	|ИЗ
	|	СовмещенныеПериоды КАК СовмещенныеПериоды
	|		ПОЛНОЕ СОЕДИНЕНИЕ УсловияОплатыТруда КАК УсловияОплатыТруда
	|		ПО СовмещенныеПериоды.ПериодС = УсловияОплатыТруда.Период
	|			И СовмещенныеПериоды.Сотрудник = УсловияОплатыТруда.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСПолнымиДанными.Период КАК Период,
	|	ТаблицаСПолнымиДанными.ПериодДо КАК ПериодДо,
	|	ТаблицаСПолнымиДанными.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ТаблицаСПолнымиДанными.Сотрудник КАК Сотрудник,
	|	ТаблицаСПолнымиДанными.Должность КАК Должность,
	|	ТаблицаСПолнымиДанными.ЗанимаемыхСтавок КАК ЗанимаемыхСтавок,
	|	ТаблицаСПолнымиДанными.ЭтоУвольнение КАК ЭтоУвольнение
	|ИЗ
	|	ТаблицаСПолнымиДанными КАК ТаблицаСПолнымиДанными
	|ГДЕ
	|	НЕ ТаблицаСПолнымиДанными.Сотрудник В
	|				(ВЫБРАТЬ
	|					ДанныеУвольненияСДеталями.Сотрудник
	|				ИЗ
	|					ДанныеУвольненияСДеталями КАК ДанныеУвольненияСДеталями
	|				ГДЕ
	|					ДанныеУвольненияСДеталями.ДатаУвольнения < &ДатаНачала)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаСПолнымиДанными.Сотрудник,
	|	ТаблицаСПолнымиДанными.Период";
	
	Запрос.Текст = ТекстЗапроса;
	ДеталиСотрудников = Запрос.Выполнить().Выгрузить();
	
	Возврат ДеталиСотрудников;
КонецФункции

// Процедура заполняет табличную часть сотрудниками подразделения по производственному календарю.
// Параметры:
// 	СтрокиДляОбновления - Массив из Число - массив идентификаторов строк, которые выделены пользователем
// 						- Неопределено - нужно обновить всю таблицу
//
&НаСервере
Процедура ЗаполнитьТабельПоПроизводственномуКалендарю(Знач СтрокиДляОбновления)

	ДанныеЗаполнения = ОбщиеДанныеЗаполненияОтработанногоВремени();
	Если СтрокиДляОбновления = Неопределено Тогда
		Объект.ОтработанноеВремяПоДням.Очистить();
		Объект.ОтработанноеВремяЗаПериод.Очистить();
		ЗаполнитьСтрокиСотрудниковПоПроизводственномуКалендарю(ДанныеЗаполнения);
	Иначе
		ОбновитьСтрокиСотрудниковПоПроизводственномуКалендарю(СтрокиДляОбновления, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабельПоГрафику(Знач СтрокиДляОбновления)
	
	ДанныеЗаполнения = ОбщиеДанныеЗаполненияОтработанногоВремени();
	ДанныеЗаполнения.ТаблицаРаботы  = ТаблицаГрафиковСотрудников(ДанныеЗаполнения.МассивСотрудников,
		Объект.ПериодРегистрации);

	ЗаполнитьТабельПоРаботе(СтрокиДляОбновления, ДанныеЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабельПоЕжедневнымОтчетам(Знач СтрокиДляОбновления)

	ДанныеЗаполнения = ОбщиеДанныеЗаполненияОтработанногоВремени();
	ДанныеЗаполнения.ТаблицаРаботы = ЕжедневныеОтчетыСотрудников(ДанныеЗаполнения.МассивСотрудников,
		Объект.ПериодРегистрации);
	ДанныеЗаполнения.УчитыватьКоличествоСтавок = Ложь;		

	ЗаполнитьТабельПоРаботе(СтрокиДляОбновления, ДанныеЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабельПоРаботе(СтрокиДляОбновления, ДанныеЗаполнения)

	ТаблицаОтклонений = ТаблицаОтклоненийОтГрафиков(ДанныеЗаполнения.МассивСотрудников, Объект.ПериодРегистрации);
	ДанныеЗаполнения.ТаблицаОтклонений = ТаблицаОтклонений;
	
	Если СтрокиДляОбновления = Неопределено Тогда
		Объект.ОтработанноеВремяПоДням.Очистить();
		Объект.ОтработанноеВремяЗаПериод.Очистить();
		ЗаполнитьСтрокиСотрудников(ДанныеЗаполнения);
	Иначе
		ОбновитьСтрокиСотрудников(СтрокиДляОбновления, ДанныеЗаполнения);
	КонецЕсли;

КонецПроцедуры

// Функция заполняет список доступных для выбора видов времени.
// Параметры:
// 	МассивОграничений - Массив из СправочникСсылка.ВидыРабочегоВремени - исключаемые виды времени
// 	
// Возвращаемое значение:
// 	- СписокЗначений из СправочникСсылка.ВидыРабочегоВремени 
//
&НаСервереБезКонтекста
Функция ПолучитьСписокВыбора(Знач МассивОграничений)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВидыРабочегоВремени.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыРабочегоВремени КАК ВидыРабочегоВремени
	|ГДЕ
	|	(НЕ ВидыРабочегоВремени.Ссылка В (&МассивОграничений))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыРабочегоВремени.Наименование");
	
	Запрос.УстановитьПараметр("МассивОграничений", МассивОграничений);
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокВыбора = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.Ссылка);	
	КонецЦикла; 
	
	Возврат СписокВыбора;
	
КонецФункции // ПолучитьСписокВыбора()

&НаСервереБезКонтекста
Функция ЕжедневныеОтчетыСотрудников(Знач МассивСотрудников, ПериодРегистрации)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ПериодРегистрации));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(ПериодРегистрации));
	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	ФактическоеРабочееВремяСотрудников.Сотрудник КАК Сотрудник,
	               |	ФактическоеРабочееВремяСотрудников.ДатаОтчета КАК Дата,
	               |	СУММА(ФактическоеРабочееВремяСотрудников.РабочееВремяСотрудников) КАК ЧасыРаботы
	               |ИЗ
	               |	РегистрНакопления.ФактическоеРабочееВремяСотрудников КАК ФактическоеРабочееВремяСотрудников
	               |ГДЕ
	               |	ФактическоеРабочееВремяСотрудников.ДатаОтчета МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ФактическоеРабочееВремяСотрудников.Сотрудник В (&МассивСотрудников)
	               |
	               |СГРУППИРОВАТЬ ПО
				   |	ФактическоеРабочееВремяСотрудников.Сотрудник,
	               |	ФактическоеРабочееВремяСотрудников.ДатаОтчета
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ФактическоеРабочееВремяСотрудников.ДатаОтчета";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ОбновитьСтрокиСотрудников(СтрокиДляОбновления, ДанныеЗаполнения)
	
	Если ДанныеЗаполнения.ТаблицаРаботы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ДанныеЗаполнения.ДеталиСотрудников Цикл
		
		Период = ПериодЗаполнения(СтрокаТаблицы);
		
		Для Каждого НомерСтроки Из СтрокиДляОбновления Цикл
			
			НайденнаяСтрока = Объект[ДанныеЗаполнения.ИмяТаблицы].НайтиПоИдентификатору(НомерСтроки);
			Если НайденнаяСтрока = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не СтрокаТаблицы.Сотрудник  = НайденнаяСтрока.Сотрудник Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьОтработанноеВремя(НайденнаяСтрока, СтрокаТаблицы, Период.Начало, Период.Окончание,
				ДанныеЗаполнения);
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиСотрудников(ДанныеЗаполнения)
	
	Если ДанныеЗаполнения.ТаблицаРаботы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ДанныеЗаполнения.ДеталиСотрудников Цикл
		
		Период = ПериодЗаполнения(СтрокаТаблицы);
		
		Если Объект.ПериодРегистрации > Период.Окончание Тогда
			Продолжить;
		КонецЕсли;

		ПараметрыОтбора = Новый Структура("Сотрудник", СтрокаТаблицы.Сотрудник);
		НайденныеСтроки = Объект[ДанныеЗаполнения.ИмяТаблицы].НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() Тогда
			НоваяСтрока = НайденныеСтроки[0];
		Иначе
			НоваяСтрока 			= Объект[ДанныеЗаполнения.ИмяТаблицы].Добавить();
			НоваяСтрока.Сотрудник 	= СтрокаТаблицы.Сотрудник;
			НоваяСтрока.Должность 	= СтрокаТаблицы.Должность;
		КонецЕсли;
		
		ЗаполнитьОтработанноеВремя(НоваяСтрока, СтрокаТаблицы, Период.Начало, Период.Окончание, ДанныеЗаполнения);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокиСотрудниковПоПроизводственномуКалендарю(СтрокиДляОбработки, ДанныеЗаполнения)
	
	ПроизводственныйКалендарь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Компания, "ПроизводственныйКалендарь");
	ВыборкаРабочихДней = ВыборкаДниПроизводственногоКалендаря(ПроизводственныйКалендарь, Объект.ПериодРегистрации);
	
	Для каждого СтрокаТаблицы Из ДанныеЗаполнения.ДеталиСотрудников Цикл
		
		Для Каждого НомерСтроки Из СтрокиДляОбработки Цикл
			
			НайденнаяСтрока = Объект[ДанныеЗаполнения.ИмяТаблицы].НайтиПоИдентификатору(НомерСтроки);
			
			Если Не СтрокаТаблицы.Сотрудник  = НайденнаяСтрока.Сотрудник Тогда
				Продолжить;
			КонецЕсли;
			
			Период = ПериодЗаполнения(СтрокаТаблицы);
			
			Если Объект.ПериодРегистрации > Период.Окончание Тогда
				Продолжить;
			КонецЕсли;
			
			ВыборкаРабочихДней.Сбросить();
			
			ЗаполнитьСтрокуТабеляПоПроизводственномуКалендарю(НайденнаяСтрока, СтрокаТаблицы, Период,
				ВыборкаРабочихДней, ДанныеЗаполнения);
			
		КонецЦикла;
			
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиСотрудниковПоПроизводственномуКалендарю(ДанныеЗаполнения)
	
	ПроизводственныйКалендарь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Компания, "ПроизводственныйКалендарь");
	ВыборкаРабочихДней = ВыборкаДниПроизводственногоКалендаря(ПроизводственныйКалендарь, Объект.ПериодРегистрации);
	
	Для Каждого СтрокаТаблицы Из ДанныеЗаполнения.ДеталиСотрудников Цикл
		
		Период = ПериодЗаполнения(СтрокаТаблицы);
		Если Объект.ПериодРегистрации > Период.Окончание Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура("Сотрудник", СтрокаТаблицы.Сотрудник);
		НайденныеСтроки = Объект[ДанныеЗаполнения.ИмяТаблицы].НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() Тогда
			НоваяСтрока = НайденныеСтроки[0];
		Иначе
			НоваяСтрока 			= Объект[ДанныеЗаполнения.ИмяТаблицы].Добавить();
			НоваяСтрока.Сотрудник 	= СтрокаТаблицы.Сотрудник;
			НоваяСтрока.Должность 	= СтрокаТаблицы.Должность;
		КонецЕсли;
		
		ЗаполнитьСтрокуТабеляПоПроизводственномуКалендарю(НоваяСтрока, СтрокаТаблицы, Период,
			ВыборкаРабочихДней, ДанныеЗаполнения);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуТабеляПоПроизводственномуКалендарю(СтрокаТабеля, ДанныеСотрудника, Период,
	ВыборкаРабочихДней, ДанныеЗаполнения)

	ЧасыРаботыПлан = 8;
	ВыборкаРабочихДней.Сбросить();
	
	Пока ВыборкаРабочихДней.Следующий() Цикл
		
		Если ВыборкаРабочихДней.ДатаГрафика > Период.Окончание Тогда
			Прервать;
		КонецЕсли;
		
		Если ВыборкаРабочихДней.ДатаГрафика < Период.Начало Тогда
			Продолжить;
		КонецЕсли;
			
		ЧасыРаботы = ЧасыРаботыПлан * ДанныеСотрудника.ЗанимаемыхСтавок;
		Если ВыборкаРабочихДней.Предпраздничный Тогда
			ЧасыРаботы = ЧасыРаботы	- Мин(ЧасыРаботы, 1); 
		КонецЕсли;
		
		Если ДанныеЗаполнения.ЗаполнятьПоДням Тогда
			День = День(ВыборкаРабочихДней.ДатаГрафика);
			ДобавитьЧасыВТабельПоДням(СтрокаТабеля, ДанныеЗаполнения.ВидыВремени, День, ЧасыРаботы);
		Иначе
			ДобавитьЧасыВТабельПериод(СтрокаТабеля, ДанныеЗаполнения.ВидыВремени, ЧасыРаботы);
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЧасыВТабельПериод(СтрокаТабеля, ВидыВремени, ЧасыРаботы)
	
	СтрокаТабеля.ВидВремени1 = ВидыВремени.Работа;
	СтрокаТабеля.Дней1 	= СтрокаТабеля.Дней1 + ?(ЧасыРаботы = 0, 0, 1);
	СтрокаТабеля.Часов1 = СтрокаТабеля.Часов1 + ЧасыРаботы;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЧасыВТабельПоДням(СтрокаТабеля, ВидыВремени, НомерДня, ЧасыРаботы)
	
	СтрокаТабеля["ПервыйВидВремени" + НомерДня]	= ?(ЧасыРаботы > 0, ВидыВремени.Работа, ВидыВремени.Отсутствие);
	СтрокаТабеля["ПервыйЧасы" + НомерДня] = ЧасыРаботы;
	
КонецПроцедуры

&НаСервере
Функция ПериодЗаполнения(ДанныеСотрудника)
	
	Результат = Новый Структура;
	Результат.Вставить("Начало", ДанныеСотрудника.Период);
	
	Если ЗначениеЗаполнено(ДанныеСотрудника.ПериодДо) Тогда
		Окончание = НачалоДня(ДанныеСотрудника.ПериодДо) - 1;
	ИначеЕсли ДанныеСотрудника.ЭтоУвольнение Тогда
		Окончание = ДанныеСотрудника.Период;
	Иначе
		Окончание = КонецМесяца(Объект.ПериодРегистрации);
	КонецЕсли;
	Результат.Вставить("Окончание", Окончание);
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ОбщиеДанныеЗаполненияОтработанногоВремени()

	Результат = Новый Структура;
	Результат.Вставить("ЗаполнятьПоДням", (Объект.СпособВводаДанных = Перечисления.СпособыВводаДанныхОВремени.ПоДням));
	ДеталиСотрудников = ДанныеСотрудников(Компания, Объект.СтруктурнаяЕдиница, Объект.ПериодРегистрации);
	Результат.Вставить("ДеталиСотрудников", ДеталиСотрудников);
	Результат.Вставить("МассивСотрудников", ДеталиСотрудников.ВыгрузитьКолонку("Сотрудник"));
	Результат.Вставить("ТаблицаРаботы", Неопределено);
	Результат.Вставить("ТаблицаОтклонений", Неопределено);
	
	ВидыВремени = Новый Структура;
	ВидыВремени.Вставить("Работа",
		ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыРабочегоВремени.Работа"));
	ВидыВремени.Вставить("Отсутствие",
		ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыРабочегоВремени.ПустаяСсылка"));
	Результат.Вставить("ВидыВремени", ВидыВремени);
	Результат.Вставить("УчитыватьКоличествоСтавок", Истина);
	
	Результат.Вставить("ИмяТаблицы", "ОтработанноеВремяЗаПериод");
	Если Результат.ЗаполнятьПоДням Тогда
		Результат.ИмяТаблицы = "ОтработанноеВремяПоДням";
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОтработанноеВремя(СтрокаТабеля, ДанныеСотрудника, НачалоПериода, ОкончаниеПериода, ОбщиеДанные)
	
	Если СтрокаТабеля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДеньНачало = ?(ЗначениеЗаполнено(НачалоПериода), День(НачалоПериода), 1);
	ДеньОкончание = ?(ЗначениеЗаполнено(ОкончаниеПериода), День(ОкончаниеПериода), День(Объект.ПериодРегистрации));
	ПериодРегистрации = Объект.ПериодРегистрации;
	
	Если НЕ ОбщиеДанные.ЗаполнятьПоДням Тогда
		СтрокаТабеля.ВидВремени1 = ОбщиеДанные.ВидыВремени.Работа;	
	КонецЕсли;
	
	КоличествоСтавок = ?(ОбщиеДанные.УчитыватьКоличествоСтавок, ДанныеСотрудника.ЗанимаемыхСтавок, 1);
	Для День = ДеньНачало По ДеньОкончание Цикл
		
		ДатаДня = Дата(Год(ПериодРегистрации), Месяц(ПериодРегистрации), День);
		ОтборСотрудника = Новый Структура("Сотрудник, Дата", ДанныеСотрудника.Сотрудник, ДатаДня);
				
		ЧасовРаботы = 0;
		НайденныеОтклонения = ОбщиеДанные.ТаблицаОтклонений.НайтиСтроки(ОтборСотрудника);
		Если НайденныеОтклонения.Количество() Тогда
			ЧасовРаботы = НайденныеОтклонения[0].ДлительностьОтклонения;
		Иначе
			ДеньРаботы = ОбщиеДанные.ТаблицаРаботы.НайтиСтроки(ОтборСотрудника);
			Если ДеньРаботы.Количество() Тогда
				ЧасовРаботы = ДеньРаботы[0].ЧасыРаботы;
			КонецЕсли;				
		КонецЕсли;
		ЧасовРаботы = ЧасовРаботы * КоличествоСтавок;
		
		Если ОбщиеДанные.ЗаполнятьПоДням Тогда
			ДобавитьЧасыВТабельПоДням(СтрокаТабеля, ОбщиеДанные.ВидыВремени, День, ЧасовРаботы);
		Иначе
			ДобавитьЧасыВТабельПериод(СтрокаТабеля, ОбщиеДанные.ВидыВремени, ЧасовРаботы);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРеквизитыПечати()
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьИзмененияРеквизитовПечати", ЭтотОбъект);
	ОткрытьФорму("Обработка.РеквизитыПечати.Форма.РеквизитыПечатиТабель", Новый Структура("КонтекстПечати", Объект),
		ЭтотОбъект, , , , ОписаниеОповещения);
		
КонецПроцедуры 

