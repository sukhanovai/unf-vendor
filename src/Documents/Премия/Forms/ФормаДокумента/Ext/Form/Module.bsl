	НачисленияПриОкончанииРедактированияНаСервере();
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ПересчитатьСотрудника(Элемент.ТекущиеДанные.Сотрудник);
	КонецЕсли;
	
	РассчитатьИтогНачислено(ЭтотОбъект);
	ОбновитьСтрокуСотрудника();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗависимыеНачисленияПередУдалением(Элемент, Отказ)

	СформироватьСписокОбновляемыхСотрудников("ЗависимыеНачисления", Элемент.ВыделенныеСтроки);

КонецПроцедуры

&НаКлиенте
Процедура ЗависимыеНачисленияПослеУдаления(Элемент) 
	
	ОбновитьНДФЛ();
	РассчитатьИтогНачислено(ЭтотОбъект);
	ОбновитьСтрокуСотрудника();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗависимыеНачисленияСотрудникПриИзменении(Элемент) Экспорт
	
	Если Элементы.ЗависимыеНачисления.ТекущиеДанные <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(Элементы.ЗависимыеНачисления.ТекущиеДанные.Сотрудник) Тогда
			
			Элементы.ЗависимыеНачисления.ТекущиеДанные.Подразделение = ПодразделениеСотрудника(Элементы.ЗависимыеНачисления.ТекущиеДанные.Сотрудник, Объект.ПериодРегистрации);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗависимыеНачисленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Сотрудники") Тогда
		ДобавляемыеСотрудники = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранноеЗначение);
	Иначе
		ДобавляемыеСотрудники = ВыбранноеЗначение;
	КонецЕсли;
	
	ДобавитьСотрудников(ДобавляемыеСотрудники);
	ЗаполнитьНДФЛНаКлиенте();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУдержания

&НаКлиенте
Процедура УдержанияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьНДФЛ();
	
	СформироватьСписокОбновляемыхФизическихЛиц("Удержания", Элемент.ВыделенныеСтроки, "Сотрудник");
	ОбновитьСтрокуСотрудника();
	
КонецПроцедуры

&НаКлиенте
Процедура УдержанияПередУдалением(Элемент, Отказ)

	СформироватьСписокОбновляемыхФизическихЛиц("Удержания", Элемент.ВыделенныеСтроки, "Сотрудник");
	
КонецПроцедуры

&НаКлиенте
Процедура УдержанияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	СформироватьСписокОбновляемыхФизическихЛиц("Удержания", Элементы.Удержания.ТекущаяСтрока, "Сотрудник");
	
КонецПроцедуры

&НаКлиенте
Процедура УдержанияПослеУдаления(Элемент)
	
	ОбновитьНДФЛ();
	ОбновитьСтрокуСотрудника();
	
КонецПроцедуры

&НаКлиенте
Процедура УдержанияУдержаниеПриИзменении(Элемент)
	
	ДанныеСтроки = Элементы.Удержания.ТекущиеДанные;
	Если ДанныеСтроки <> Неопределено Тогда
		ОбработатьИзменениеУдержания(ДанныеСтроки.Удержание, ДанныеСтроки.КатегорияУдержания, ДанныеСтроки.Контрагент);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбработатьИзменениеУдержания(Удержание, КатегорияУдержания, Контрагент)

	КатегорияУдержания = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Удержание, "КатегорияУдержания");
	Если КатегорияУдержания = Перечисления.КатегорииУдержаний.ДСВ Тогда
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;

КонецФункции 

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНДФЛ

&НаКлиенте
Процедура НДФЛПриАктивизацииСтроки(Элемент)
	
	УчетНДФЛКлиент.НДФЛПриАктивизацииСтроки(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура НДФЛПередУдалением(Элемент, Отказ)
	
	НДФЛВыделенныеСтроки = Новый Массив;
	Для Каждого ИдентификаторСтрок Из Элемент.ВыделенныеСтроки Цикл
		СтрокаНДФЛ = Объект.НДФЛ.НайтиПоИдентификатору(ИдентификаторСтрок);
		Если СтрокаНДФЛ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НДФЛВыделенныеСтроки.Добавить(СтрокаНДФЛ.ИдентификаторСтрокиНДФЛ);
	КонецЦикла;
	УчетНДФЛКлиент.НДФЛПередУдалением(ЭтаФорма, НДФЛВыделенныеСтроки, Отказ);
	СформироватьСписокОбновляемыхФизическихЛиц("НДФЛ", Элемент.ВыделенныеСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура НДФЛПослеУдаления(Элемент)
	
	УчетНДФЛКлиент.УдалитьПримененныеВычетыНаДетейИИмущественные(ЭтотОбъект);
	ОбновитьСтрокуСотрудника();

КонецПроцедуры

&НаКлиенте
Процедура НДФЛПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	УчетНДФЛКлиент.НДФЛПриОкончанииРедактирования(ЭтотОбъект);
	
	НДФЛПриОкончанииРедактированияНаСервере(Элемент.ВыделенныеСтроки);
	
КонецПроцедуры

&НаСервере
Процедура НДФЛПриОкончанииРедактированияНаСервере(Знач ВыделенныеСтроки)
	
	СформироватьСписокОбновляемыхФизическихЛиц("НДФЛ", ВыделенныеСтроки);
	ОбновитьСтрокуСотрудника();
	РассчитатьИтогиПоДокументу();
	
КонецПроцедуры

&НаКлиенте
Процедура НДФЛПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	УчетНДФЛКлиент.НДФЛПриНачалеРедактирования(ЭтотОбъект, Элементы.НДФЛ.ТекущиеДанные, НоваяСтрока, Копирование);
	СформироватьСписокОбновляемыхФизическихЛиц("НДФЛ", Элементы.НДФЛ.ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВычетыЛичныеПриИзменении(Элемент)
	
	УчетНДФЛКлиент.НДФЛПриОкончанииРедактирования(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПримененныеВычетыИмущественные

