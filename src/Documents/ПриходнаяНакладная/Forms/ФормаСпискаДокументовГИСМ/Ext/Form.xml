	<Attributes>
		<Attribute name="СписокВозвратыТоваровОтКлиентов" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список возвраты товаров от клиентов</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>СписокВозвратыТоваровОтКлиентов.Ref</Field>
				<Field>СписокВозвратыТоваровОтКлиентов.ДальнейшееДействиеГИСМ</Field>
				<Field>СписокВозвратыТоваровОтКлиентов.СтатусГИСМ</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументВозвратТоваровОтКлиента.Ссылка,
	ДокументВозвратТоваровОтКлиента.ПометкаУдаления,
	ДокументВозвратТоваровОтКлиента.Номер,
	ДокументВозвратТоваровОтКлиента.Дата,
	ДокументВозвратТоваровОтКлиента.Проведен,
	ДокументВозвратТоваровОтКлиента.Организация,
	ДокументВозвратТоваровОтКлиента.Контрагент,
	ДокументВозвратТоваровОтКлиента.СуммаДокумента,
	ДокументВозвратТоваровОтКлиента.СтруктурнаяЕдиница,
	ДокументВозвратТоваровОтКлиента.Подразделение,
	ДокументВозвратТоваровОтКлиента.Ответственный,
	ДокументВозвратТоваровОтКлиента.Комментарий,
	ДокументВозвратТоваровОтКлиента.ВидОперации,
	ДокументВозвратТоваровОтКлиента.ЧекККМ,
	ДокументВозвратТоваровОтКлиента.НомерВходящегоДокумента,
	ДокументВозвратТоваровОтКлиента.ДатаВходящегоДокумента,
	ДокументВозвратТоваровОтКлиента.Договор,
	ЕСТЬNULL(СтатусыИнформированияГИСМ.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИнформированияГИСМ.ПустаяСсылка)) КАК СтатусГИСМ,
	ВЫБОР 
		КОГДА ДокументВозвратТоваровОтКлиента.ЕстьМаркируемаяПродукцияГИСМ ТОГДА
			ЕСТЬNULL(СтатусыИнформированияГИСМ.ДальнейшееДействие, ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияПоВзаимодействиюГИСМ.ПустаяСсылка))
		ИНАЧЕ
			ЗНАЧЕНИЕ(Перечисление.ДальнейшиеДействияПоВзаимодействиюГИСМ.НеТребуется)
	КОНЕЦ КАК ДальнейшееДействиеГИСМ
	ИЗ
	Документ.ПриходнаяНакладная КАК ДокументВозвратТоваровОтКлиента
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыИнформированияГИСМ КАК СтатусыИнформированияГИСМ
			ПО СтатусыИнформированияГИСМ.Документ = ДокументВозвратТоваровОтКлиента.Ссылка}
ГДЕ 
	ДокументВозвратТоваровОтКлиента.ВидОперации = Значение(Перечисление.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя)
			</QueryText>
				<MainTable>Document.ПриходнаяНакладная</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
