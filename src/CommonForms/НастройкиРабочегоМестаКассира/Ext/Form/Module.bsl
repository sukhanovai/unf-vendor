	НастроитьЭлементыПодбораТоваров();
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКСтруктураПлиточногоИнтерфейсаПодбораПриИзменении(Элемент)
	
	НастройкиРМК.СтруктураПлиточногоИнтерфейсаПодбора = СтруктураПлиточногоИнтерфейсаПодбора;
	ПостроитьПредпросмотрПлиточногоИнтерфейса();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКСтруктураПлиточногоИнтерфейсаПодбораНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуВыбораПалитры();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКСтруктураПлиточногоИнтерфейсаПодбораОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуПалитры();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКСтруктураПлиточногоИнтерфейсаПодбораСоздание(Элемент, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(СтруктураПлиточногоИнтерфейсаПодбора) Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуПалитры();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКСтруктураБыстрыхТоваровПриИзменении(Элемент)
	
	ПостроитьПредпросмотрПлиточногоИнтерфейса();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКСтруктураБыстрыхТоваровНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуВыбораПалитры(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКСтруктураБыстрыхТоваровОткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФормуПалитры(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКСтруктураБыстрыхТоваровСоздание(Элемент, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(НастройкиРМК.СтруктураБыстрыхТоваров) Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуПалитры(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКРабочееМестоПриИзменении(Элемент)
	АктуализироватьЭлементыФормы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПрефиксИнформационнойБазыПриИзменении(Элемент)
	
	ФоновоеЗадание = ЗапуститьИзменениеПрефиксаИБВФоновомЗадании();
	
	Если ФоновоеЗадание <> Неопределено
		И ФоновоеЗадание.Статус = "Выполняется" Тогда
		
		УстановитьДоступностьЭлементаФормы(Элементы.ПрефиксИнформационнойБазы, Ложь);
		УстановитьВидимостьЭлементаФормы(Элементы.ДекорацияОжиданиеИзмененияПрефикса, Истина);
		
	КонецЕсли;
	
	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ВыводитьОкноОжидания = Ложь;
	
	Обработчик = Новый ОписаниеОповещения("ПослеИзмененияПрефикса", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ФоновоеЗадание, Обработчик, НастройкиОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(ВведеннаяСтрокаПоиска) Тогда
		Возврат;
	КонецЕсли;
	
	ВосстановитьИсходнуюВидимостьНастроек();
	ВыполнитьПоискНастройкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПоискНастройкиНаСервере()
	
	Результат = Новый Соответствие;
	
	Для Каждого СтрокаСловаря Из СловарьПоиска Цикл
		ПроцентСхожести = ПроцентСхожестиСтрок(
			ПолучитьНГраммыСтроки(ВведеннаяСтрокаПоиска),
			ПолучитьНГраммыСтроки(СтрокаСловаря.СтрокаПоиска));
		
		СловоПохожее = ПроцентСхожести >= 52;
		
		Если СловоПохожее Тогда
			Результат.Вставить(СтрокаСловаря.ИмяЭлемента);
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не найдено настроек, удовлетворяющих заданному поиску'"));
		Возврат;
	КонецЕсли;
	
	СкрытьВсеЭлементыСтраницНастроек();
	СтраницыСНастройками = ПоказатьНайденныеПоискомЭлементы(Результат);
	УстановитьВидимостьРазделовРекурсивно();
	

КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаОчистка(Элемент, СтандартнаяОбработка)
	ВосстановитьИсходнуюВидимостьНастроек();
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьСкидкуПроцентомПриИзменении(Элемент)
	Если ОтображатьСкидкуПроцентом Тогда
		НастройкиРМК.РежимОтображенияСкидки = 1;
	Иначе
		НастройкиРМК.РежимОтображенияСкидки = 0;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКНаименованиеПриИзменении(Элемент)
	ЗаполнитьЗаголовокФормы();
КонецПроцедуры

