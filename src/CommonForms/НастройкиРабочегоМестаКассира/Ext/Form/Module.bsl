#Область НастройкиВариантаИнтерфейса

&НаСервере
Процедура ПодготовитьНастройкиВариантаИнтерфейса()
	
	Элементы.НастройкиВариантаИнтерфейса.Видимость = Истина;
	
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();
	Элементы.ПользовательВариантаИнтерфейса.Видимость = ЭтоПолноправныйПользователь;
	
	Если НЕ ЭтоПолноправныйПользователь Тогда
		Элементы.ЗаписатьВариантИнтерфейсаПользователя.Заголовок = НСтр("ru='Записать'");
		Элементы.ЗаписатьВариантИнтерфейсаПользователя.РасширеннаяПодсказка.Заголовок = 
			НСтр("ru='Выбранные настройки применятся после перезапуска приложения.'");
	КонецЕсли;
		
	Элементы.ВариантИнтерфейса.СписокВыбора.Добавить("Такси", НСтр("ru = 'Интерфейс ""Такси""'"));
	Элементы.ВариантИнтерфейса.СписокВыбора.Добавить("Версия8_5", НСтр(
		"ru = 'Интерфейс ""Версия 8.5""'"));
	
	Элементы.ВариантМасштабаИнтерфейса85.СписокВыбора.Добавить("Обычный", НСтр("ru = 'Обычный'"));
	Элементы.ВариантМасштабаИнтерфейса85.СписокВыбора.Добавить("Компактный", НСтр("ru = 'Компактный'"));
	
	Элементы.ВариантТемыИнтерфейса85.СписокВыбора.Добавить("Светлая", НСтр("ru = 'Светлая'"));
	Элементы.ВариантТемыИнтерфейса85.СписокВыбора.Добавить("Темная", НСтр("ru = 'Темная'"));
	
	ЗаполнитьНастройкиВариантаИнтерфейса();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиВариантаИнтерфейса()
	
	ИмяПользователя = Неопределено;
	Если ЗначениеЗаполнено(ПользовательВариантаИнтерфейса) Тогда
		ИдентификаторПользователяИБ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПользовательВариантаИнтерфейса, "ИдентификаторПользователяИБ");
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(ИдентификаторПользователяИБ);
		ИмяПользователя = ПользовательИБ.Имя;
	КонецЕсли;
	
	НастройкиКлиентскогоПриложения = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(
		"Общее/НастройкиКлиентскогоПриложения", "",,, ИмяПользователя);
	
	Если НЕ НастройкиКлиентскогоПриложения = Неопределено Тогда
		Если НастройкиКлиентскогоПриложения.ВариантИнтерфейсаКлиентскогоПриложения
			= ВариантИнтерфейсаКлиентскогоПриложения.Такси Тогда
			ВариантИнтерфейса = "Такси";
		Иначе
			ВариантИнтерфейса = "Версия8_5";
		КонецЕсли;
		
		Если НастройкиРМК.УвеличенныйВариантМасштаба Тогда
			ВариантМасштабаИнтерфейса85 = "Обычный";
		Иначе
			ВариантМасштабаИнтерфейса85 = "Компактный";
		КонецЕсли;
		
		Если НастройкиКлиентскогоПриложения.ТемаКлиентскогоПриложения
			= ТемаКлиентскогоПриложения.Темная Тогда
			ВариантТемыИнтерфейса85 = "Темная";
		Иначе
			ВариантТемыИнтерфейса85 = "Светлая";
		КонецЕсли;
	Иначе
		НеобходимоСохранитьВариантИнтерфейса = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьНастроекВариантовИнтерфейса()
	
	Если ВариантИнтерфейса = "Такси" Тогда
		Элементы.НастройкиВариантаИнтерфейса83.Видимость = Истина;
		Элементы.НастройкиВариантаИнтерфейса85.Видимость = Ложь;
	Иначе
		Элементы.НастройкиВариантаИнтерфейса83.Видимость = Ложь;
		Элементы.НастройкиВариантаИнтерфейса85.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

&НаКлиенте
Процедура РезультатЗакрытияФормыНастройкиСМС(Результат, ДополнительныеПараметры) Экспорт
	ДоступностьГруппыСМС = Истина;
	РезультатЗакрытияФормыНастройкиСМССервер(ДоступностьГруппыСМС);
	НастроитьЭлементыГруппыСМС(ДоступностьГруппыСМС);
КонецПроцедуры

&НаКлиенте
Процедура ВопросСбросНастроекСвойствЭлементовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		НастройкиЭлементовФормыРМК.Очистить();
		УбратьИзмененныеСостоянияНастроек(ДеревоГорячиеКлавиши.ПолучитьЭлементы());
		ДанныеДляОтображенияЭлементов.СброситьНастройкиСвойствЭлементов_Доступность = Ложь;
		
		ОбновляемыеЭлементы = Новый Массив;
		ОбновляемыеЭлементы.Добавить(Элементы.СброситьНастройкиСвойствЭлементов);
		ОбновитьОтображениеФормыНастроек(ЭтотОбъект, ОбновляемыеЭлементы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиРМКИЗакрыть(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("НастройкаЗаписана", Ложь);
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Результат = СохранитьНастройкиРМКНаСервере();
		ИзмененияСохранены = Результат.ВыполненоУспешно;
		
		Если НЕ ИзмененияСохранены Тогда
			
			ПоказатьПредупреждение(, Результат.ТекстПредупрежденийОшибок,,
				НСтр("ru = 'Ошибка сохранения настроек РМК'"));
			
		КонецЕсли;
		
		ПараметрыОповещения.НастройкаЗаписана = ИзмененияСохранены;
		
	Иначе
		ЗакрыватьФормуБезКонтроляИзмененийНастроек = Истина;
	КонецЕсли;
	
	Оповестить("СохранениеНастроекРМК", ПараметрыОповещения);
	Модифицированность = Ложь;
	
	Если Открыта()
		И Элементы.СтраницыФормыНастроек.ТекущаяСтраница = Элементы.СтраницаОсновная Тогда
		Закрыть();
	Иначе
		АктуализироватьЭлементыФормы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСходСоСтрокиКупюрыЗавершение(ТекущаяСтрокаКупюры) Экспорт
	
	Элементы.НастройкиРМКВводНаличных.ТекущаяСтрока = ТекущаяСтрокаКупюры;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСходСоСтрокиГорячейКлавишиЗавершение(ТекущаяСтрокаГорячейКлавиши) Экспорт
	
	Элементы.ДеревоГорячиеКлавиши.ТекущаяСтрока = ТекущаяСтрокаГорячейКлавиши;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеНастроекЭлементаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		ПараметрыОбновления = Новый Структура();
		ПараметрыОбновления.Вставить("ВключитьКнопкуСброса", Ложь);
		ПараметрыОбновления.Вставить("СостояниеНастроек", ВозможныеСостоянияНастроек.НастройкиПоУмолчанию);
		ПараметрыОбновления.Вставить("ИмяЭлемента", Результат.ИмяЭлемента);
		ОтборСтрокНастроек = Новый Структура();
		ОтборСтрокНастроек.Вставить("ИмяЭлемента", Результат.ИмяЭлемента);
		СтрокиНастроекЭлементов = НастройкиЭлементовФормыРМК.НайтиСтроки(ОтборСтрокНастроек);
		Для Каждого ДанныеНастройки Из Результат.Настройки Цикл
			ОбновитьНастройкуЭлементаФормы(СтрокиНастроекЭлементов, ДанныеНастройки, ПараметрыОбновления);
		КонецЦикла;
		
		СтрокаКлавишиДерева = ДеревоГорячиеКлавиши.НайтиПоИдентификатору(ДополнительныеПараметры);
		СтрокаКлавишиДерева.СостояниеНастроек = ПараметрыОбновления.СостояниеНастроек;
		
		АктуализироватьДоступностьКнопкиСбросаНастроекЭлементов(ПараметрыОбновления.ВключитьКнопкуСброса);
		ОбновляемыеЭлементы = Новый Массив;
		ОбновляемыеЭлементы.Добавить(Элементы.СброситьНастройкиСвойствЭлементов);
		ОбновитьОтображениеФормыНастроек(ЭтотОбъект, ОбновляемыеЭлементы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДатаИзУниверсальнойДаты(Знач Значение, Делитель = 1000, ПриводитьКМестномуВремени = Истина) Экспорт
	
	Значение = '00010101' + Цел(Значение / Делитель);
	
	Если ПриводитьКМестномуВремени Тогда
		Возврат МестноеВремя(Значение);
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыборПродолжительностьЛогаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Продолжительность = ВыбранныйЭлемент.Значение;
	Если ДополнительныеПараметры.РежимПродления
		И ЗначениеЗаполнено(ПараметрыЛогирования.ОкончаниеЗаписи) Тогда
		ДатаОкончания = ДатаИзУниверсальнойДаты(ПараметрыЛогирования.ОкончаниеЗаписи);
		Если ДатаОкончания > ТекущаяДата() Тогда
			Продолжительность = Цел((КонецМинуты(ДатаОкончания) - КонецМинуты(ТекущаяДата())) / 60 + Продолжительность);
		КонецЕсли;
	КонецЕсли;
	
	ВключитьЛогированиеЗапросов(Продолжительность);
	ОбновитьПредставлениеЛогирования();
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеОповещенияВопросОчиститьЛогЗапросовЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьЛогЗапросов();
	ОбновитьПредставлениеЛогирования();
	
	ПоказатьОповещениеПользователя(НСтр("ru='Лог запросов очищен.'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРасписаниеОчисткиОпераций(РасписаниеЗадания, Контекст) Экспорт
	
	Если РасписаниеЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма[Контекст.ИмяРеквизита] = РасписаниеЗадания;
	ИмяРеквизитаМодификации = СтрШаблон("%1Изменено", Контекст.ИмяРеквизита);
	ЭтаФорма[ИмяРеквизитаМодификации] = Истина;
	ЭлементЗадания = Элементы[Контекст.ИмяЗадания];
	УстановитьТекстНадписиРегламентнойНастройки(ЭлементЗадания, РасписаниеЗадания);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСценарийЗавершение(Результат, ВыбранныйСценарий) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		УстановитьСценарийИспользования(ВыбранныйСценарий);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранФайл(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ВыбранныеФайлы[0];
	
	Если ДополнительныеПараметры.Свойство("ДляЗагрузки") И ДополнительныеПараметры.ДляЗагрузки Тогда
		
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЧтениеФайлаНастроекЗавершение", ЭтотОбъект);
		
		ФайлXML = Новый ТекстовыйДокумент;
		ФайлXML.НачатьЧтение(ОписаниеОповещения, ПутьКФайлу);
		
	Иначе
		
		РезультатВыполнения = СохранитьНастройкиРМКНаСервере();
		Если НЕ РезультатВыполнения.ВыполненоУспешно Тогда
			ПоказатьПредупреждение(, РезультатВыполнения.ТекстПредупрежденийОшибок);
		Иначе
		
			ТекстXML = НастройкиВФорматеXML(ДополнительныеПараметры);
			ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписьФайлаНастроекЗавершение", ЭтотОбъект);
		
			ФайлXML = Новый ТекстовыйДокумент;
			ФайлXML.УстановитьТекст(ТекстXML);
			ФайлXML.НачатьЗапись(ОписаниеОповещения, ПутьКФайлу);
		
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЧтениеФайлаНастроекЗавершение(Результат) Экспорт
	
	ПредыдущийСценарий = НастройкиРМК.СценарийИспользования;
	
	ЕстьОшибки = Ложь;
	ТекстXML = ФайлXML.ПолучитьТекст();
	ТекстОписанияОшибки = "";
	ЗагрузитьНастройкиИзXML(ТекстXML, ЕстьОшибки, ТекстОписанияОшибки);
	
	Если ЕстьОшибки Тогда
		
		Если ПустаяСтрока(ТекстОписанияОшибки) Тогда
			ТекстОписанияОшибки= НСтр("ru='При загрузке настроек произошли ошибки.
				|Подробнее см. в журнале регистрации.'");
		Иначе
			ТекстОписанияОшибки = СтрШаблон(НСтр("ru='%1
				|Подробнее см. в журнале регистрации.'"),
				ТекстОписанияОшибки);
		КонецЕсли;
		ПоказатьПредупреждение(, ТекстОписанияОшибки);
		
	Иначе
		
		СтруктураВлияющихНастроек = ШаблонВлияющихНастроек();
		
		ПоказатьПредупреждение(, НСтр("ru='Настройки успешно загружены.'"));
		НастроитьЭлементыФормыПослеЗагрузкиИзXMLНаСервере(ПредыдущийСценарий, СтруктураВлияющихНастроек);
		НастроитьДоступностьЭлементовВводаНаличных();
		УстановитьДоступностьЭлементовФормы();
		НастроитьЗначениеЭлементаЗакрытьПодбор(НастройкиРМК);
		ОбновитьОтображениеФормыНастроек(ЭтотОбъект);
		ЗапомнитьРеквизитыПалитры();
		ОбновитьИнтерфейс();
		ПостроитьПредпросмотрПлиточногоИнтерфейсаКлиент(СтруктураВлияющихНастроек);
		
	КонецЕсли;
	
	ФайлXML = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписьФайлаНастроекЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ПоказатьПредупреждение(, НСтр("ru='Настройки успешно выгружены.'"));
	
	ФайлXML = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура НСПКВерсияВКЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт 
	
	Если Не ТипЗнч(РезультатВыполнения) = Тип("Строка") Тогда
		ЭлектронныеСертификатыНСПККлиент.УстановитьКомпонентуИнтеграцииНСПК();
		
		ВерсияКомпонентыНСПК = РезультатВыполнения.Версия;
		ЗаголовокНСПК = НСтр("ru='Оплата электронным сертификатом, записанным на платежную карту МИР.'");
		Элементы.ГруппаОплатаНСПК.РасширеннаяПодсказка.Заголовок = ЗаголовокНСПК + Символы.ПС + СтрШаблон(
			НСтр("ru = 'Настройки подключения к сервису НСПК (v. %1)'"), ВерсияКомпонентыНСПК);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуПользователей(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	Элементы.КассирыДляВхода.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОчисткеРаспределения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		НастройкиРМК.РаспределениеНоменклатуры.Очистить();
		УстановитьВидимостьГруппКатегорий();
	Иначе
		НастройкиРМК.ГруппыКатегории = Число(Не Булево(НастройкиРМК.ГруппыКатегории));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНастройкиСкладов(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КопироватьДанныеФормы(Результат, НастройкиРМК);
КонецПроцедуры

#КонецОбласти

