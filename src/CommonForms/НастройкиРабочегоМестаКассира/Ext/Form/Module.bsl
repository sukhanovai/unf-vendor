&НаКлиенте
Процедура ПомощникНастройкиОбмена(Команда)
	ИмяПланаОбмена = "ОбменСУРМК";
	ИдентификаторНастройки = "";
	
	Если Команда.Имя = "ПомощникНастройкиОбмена" Тогда
		ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьПомощникНастройкиОбмена();
		Возврат;
	ИначеЕсли Команда.Имя = "ПомощникНастройкиОбменаУП" Тогда
		ИдентификаторНастройки = "ОбменУП";
	ИначеЕсли Команда.Имя = "ПомощникНастройкиОбменаКА" Тогда
		ИдентификаторНастройки = "ОбменКА";
	ИначеЕсли Команда.Имя = "ПомощникНастройкиОбменаУТ" Тогда
		ИдентификаторНастройки = "ОбменУТ";
	ИначеЕсли Команда.Имя = "ПомощникНастройкиОбменаЭРГО" Тогда
		ИдентификаторНастройки = "ОбменМаркировка";
	КонецЕсли;
	
	ОписаниеВариантаНастройки = ОписаниеВариантаНастройки(ИмяПланаОбмена, ИдентификаторНастройки);
	
	ПараметрыПомощника = Новый Структура;
	ПараметрыПомощника.Вставить("ИмяПланаОбмена",                     ИмяПланаОбмена);
	ПараметрыПомощника.Вставить("ИдентификаторНастройки",             ИдентификаторНастройки);
	ПараметрыПомощника.Вставить("ОписаниеВариантаНастройки",          ОписаниеВариантаНастройки);
	ПараметрыПомощника.Вставить("ОбменДаннымиСВнешнейСистемой",       Ложь);
	ПараметрыПомощника.Вставить("ПараметрыПодключенияВнешнейСистемы", Неопределено);
	ПараметрыПомощника.Вставить("НастройкаНовойСинхронизации");

	КлючУникальностиПомощника = ПараметрыПомощника.ИмяПланаОбмена + "_" + ПараметрыПомощника.ИдентификаторНастройки;
		
	ОткрытьФорму("Обработка.ПомощникСозданияОбменаДанными.Форма.НастройкаСинхронизации", ПараметрыПомощника, , КлючУникальностиПомощника);

КонецПроцедуры

