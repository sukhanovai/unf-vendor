&НаКлиенте
Процедура ЗначениеСкидкиПенсионерамПриИзменении(Элемент)
	
	Модифицированность = Истина;
	СкидкиПенсионерам = НастройкиРМК.СкидкиНаценки.НайтиСтроки(
		Новый Структура("Наименование", "СкидкаПенсионера"));
	
	Если ЗначениеСкидкиПенсионерам <> 0 И СкидкиПенсионерам.Количество() = 1 Тогда
		СкидкиПенсионерам[0].ЗначениеСкидкиНаценки = ЗначениеСкидкиПенсионерам;
	Иначе
		Для каждого СкидкаПенсионера Из СкидкиПенсионерам Цикл
			НастройкиРМК.СкидкиНаценки.Удалить(СкидкаПенсионера);
		КонецЦикла;
		Если ЗначениеСкидкиПенсионерам <> 0 Тогда
			НоваяСкидкаНаценка = НастройкиРМК.СкидкиНаценки.Добавить();
			НоваяСкидкаНаценка.Наименование = "СкидкаПенсионера";
			НоваяСкидкаНаценка.ЗначениеСкидкиНаценки = ЗначениеСкидкиПенсионерам;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

