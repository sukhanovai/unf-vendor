&НаКлиенте
Процедура ПеренумерацияДокументов(Команда)
	ПараметрыПеренумерации = Новый Структура;
	ПараметрыПеренумерации.Вставить("Организация", ОрганизацияПоУмолчаню());
	ПараметрыПеренумерации.Вставить("НачалоПериода", НачалоКвартала(ТекущаяДата()));
	ПараметрыПеренумерации.Вставить("КонецПериода",  КонецКвартала(ТекущаяДата()));
	ПараметрыПеренумерации.Вставить("ВидДокументов", Новый ОписаниеТипов("ДокументСсылка.СчетФактура"));

	ОткрытьФорму("Обработка.ПеренумерацияДокументов.Форма.Форма", ПараметрыПеренумерации);
КонецПроцедуры

Функция ОрганизацияПоУмолчаню()
	
	Возврат Справочники.Организации.ОрганизацияПоУмолчанию();
	
КонецФункции
