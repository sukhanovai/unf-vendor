&НаКлиенте
Процедура ЗаявлениеОВвозе(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Заявления о ввозе товаров'"));
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийВвозТоваровИзЕАЭС.ЗаявлениеОВвозе"));

	ОткрытьФорму("Документ.ЗаявлениеОВвозеТоваров.ФормаСписка", ПараметрыФормы,,"ФормаСписка_ЗаявлениеОВвозеТоваров");
	
КонецПроцедуры

