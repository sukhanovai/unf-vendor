#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	GooglePlay = "https://play.google.com/store/apps/details?id=com.e1c.mobile.documentscanner";
	QRcodeGooglePlay = ПоместитьВоВременноеХранилище(ДанныеQRКода(GooglePlay), УникальныйИдентификатор);
	
	AppStore = "https://apps.apple.com/ru/app/id1510823061";
	QRcodeAppStore = ПоместитьВоВременноеХранилище(ДанныеQRКода(AppStore), УникальныйИдентификатор);;

	RuStore = "https://www.rustore.ru/catalog/app/com.e1c.mobile.documentscanner";
	QRcodeRuStore = ПоместитьВоВременноеХранилище(ДанныеQRКода(RuStore), УникальныйИдентификатор);;

	МагазинПриложений = "GooglePlay";
	
	Если Параметры.НетЧеков Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНетЧеков;
		Заголовок = НСтр("ru = 'Нет чеков для загрузки'")
	КонецЕсли;
	
	Элементы.СтраницаНетЧеков.Видимость = Параметры.НетЧеков;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТипЗнч(ВладелецФормы) = Тип("ФормаКлиентскогоПриложения")
		И ВладелецФормы.ИмяФормы = "Документ.АвансовыйОтчет.Форма.ФормаДокумента" Тогда
		ТипДокумента = НСтр("ru = 'авансовый отчет'");
	Иначе
		ТипДокумента = НСтр("ru = 'расходы предпринимателя'");
	КонецЕсли;
	
	Подробнее = НСтр("ru = '<a href = ""https://portal.1c.ru/applications/1C-Document-Recognition"">Подробнее</a>'");
	СтрокаСТегами = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		Элементы.ДекорацияПодробнееГиперссылка.Заголовок, ТипДокумента, Подробнее);
	Элементы.ДекорацияПодробнееГиперссылка.Заголовок = СтроковыеФункцииКлиент.ФорматированнаяСтрока(СтрокаСТегами);
	
	Элементы.ДекорацияТекстНетЧеков2.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		Элементы.ДекорацияТекстНетЧеков2.Заголовок, ТипДокумента);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияОткрытьНастройки1ССканерДокументовНажатие(Элемент)
	
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(
		"e1cib/data/Справочник.МобильныеПриложенияРаспознаванияДокументов.Форма.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура МагазинПриложенийПриИзменении(Элемент)
	
	Элементы.ГруппаQRКоды.ТекущаяСтраница = Элементы["Группа" + МагазинПриложений];
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодключитьСервис(Команда)

	ПодключитьСервисНаСервере();
	
	ПерейтиПоНавигационнойСсылке("e1cib/command/ОбщаяКоманда.РаспознаваниеДокументовУНФ");
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодключитьСервисНаСервере()
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьРаспознаваниеДокументов") Тогда
		УстановитьПривилегированныйРежим(Истина);
		Константы.ИспользоватьРаспознаваниеДокументов.Установить(Истина);
	КонецЕсли;
	
КонецПроцедуры

#Область БизнесЛогика

&НаСервереБезКонтекста
Функция ДанныеQRКода(Данные)
	
	Возврат ГенерацияШтрихкода.ДанныеQRКода(Данные, 0, 350);
	
КонецФункции

#КонецОбласти

#КонецОбласти