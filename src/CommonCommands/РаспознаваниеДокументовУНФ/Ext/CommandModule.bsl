	Если ИнтернетПоддержкаПользователейКлиентСервер.ЭтоИнтерфейс85() Тогда
		ИмяФормы = "Документ.РаспознанныйДокумент.Форма.ФормаСписка85";
	Иначе
		ИмяФормы = "Документ.РаспознанныйДокумент.Форма.ФормаСписка";
