
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "МассивПользователей") Тогда
		НомерЭлемента = 0;
		Для Каждого СтрокаМассива Из Параметры.МассивПользователей Цикл
			НомерЭлемента = НомерЭлемента + 1;
			НоваяСтрока = СписокПользователей.Добавить();
			НоваяСтрока.НомерЭлемента = НомерЭлемента;
			НоваяСтрока.Видимость = Истина;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
		КонецЦикла;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ГруппаДоступа") Тогда
		ГруппаДоступа = Параметры.ГруппаДоступа;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "НастройкаСотрудника") Тогда
		НастройкаСотрудника = Параметры.НастройкаСотрудника;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "РежимПодбора") Тогда
		РежимПодбора = Параметры.РежимПодбора;
	КонецЕсли;
	
	Если РежимПодбора Тогда
		ЗаполнитьДанныеВРежимеВыбора();
	КонецЕсли;
	СоздатьЭлементыКассиров();
	Элементы.ПодобратьПользователей.Видимость = РежимПодбора;
	Элементы.СтрокаПоиска.Видимость = РежимПодбора;
	Элементы.ГруппаДоступа.Видимость = Не НастройкаСотрудника;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура СгенерироватьКод(Команда)
	ИмяКоманды = ТекущийЭлемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяКоманды, НСтр("ru = 'СгенерироватьКодСотрудника_'"), ""));
	
	СтрокиТаблицы = СписокПользователей.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	Если СтрокиТаблицы.Количество() > 0 Тогда
		НовыйКодСотрудника = НовыйКодДоступаКассираПоУмолчанию();
		УстановитьНастройкиКодаСотрудника(СтрокиТаблицы[0], НовыйКодСотрудника, НомерЭлемента);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьШтрихкода(Команда)
	ИмяКоманды = ТекущийЭлемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяКоманды, НСтр("ru = 'НапечататьКодСотрудника_'"), ""));
	
	СтрокиТаблицы = СписокПользователей.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	Если СтрокиТаблицы.Количество() > 0 Тогда
		ВывестиКодДоступаСотрудникаВТабличныйДокумент(СтрокиТаблицы[0].КодСотрудника, СтрокиТаблицы[0].Кассир);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	ЗаписатьНастройкиКассиров();
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПользователей(Команда)
	ЗаполнитьДанныеТаблицыПользователей();
	Элементы.ВыборПользователей.Видимость = Истина;
	Элементы.ГруппаКомандыГруппаДоступа.Видимость = Ложь;
	Элементы.ГруппаКомандыВыбор.Видимость = Истина;
	Элементы.СтраницыНастройкиПользователей.ТекущаяСтраница = Элементы.СтраницаВыбораПользователей;
	Элементы.ВыборПользователей.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПользователей(Команда)
	ВыбранныеЭлементы = Элементы.ВыборПользователей.ВыделенныеСтроки;
	ДобавитьПользователейВТаблицу(ВыбранныеЭлементы);
	Элементы.ВыборПользователей.ВыделенныеСтроки.Очистить();
	Элементы.ВыборПользователей.Видимость = Ложь;
	Элементы.ГруппаКомандыГруппаДоступа.Видимость = Истина;
	Элементы.ГруппаКомандыВыбор.Видимость = Ложь;
	Элементы.СтраницыНастройкиПользователей.ТекущаяСтраница = Элементы.СтраницаОсновная;
КонецПроцедуры

&НаКлиенте
Процедура ИсключитьПользователяИзГруппы(Команда)
	ИмяКоманды = ТекущийЭлемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяКоманды, НСтр("ru = 'ИсключитьПользователя_'"), ""));
	
	СтрокиТаблицы = СписокПользователей.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	Если СтрокиТаблицы.Количество() > 0 Тогда
		Для Каждого Строка Из СтрокиТаблицы Цикл
			СписокПользователей.Удалить(Строка);
			ИмяГруппыПользователь = СтрШаблон(НСтр("ru = 'ГруппаПользователь_%1'"), НомерЭлемента);
			ЭлементГруппа = Элементы.Найти(ИмяГруппыПользователь);
			Если НЕ ЭлементГруппа = Неопределено Тогда
				ЭлементГруппа.Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура Подключаемый_ПриИзмененииКассира(Элемент)
	ИмяЭлемента = Элемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяЭлемента, НСтр("ru = 'Кассир_'"), ""));
	ИмяРеквизитаКодСотрудника = СтрШаблон(НСтр("ru = 'КодСотрудника_%1'"), НомерЭлемента);
	ИмяКомандыКодСотрудника = СтрШаблон(НСтр("ru = 'СгенерироватьКодСотрудника_%1'"), НомерЭлемента);
	ИмяРеквизитаОтправлятьКод = СтрШаблон(НСтр("ru = 'ОтправитьКод_%1'"), НомерЭлемента);
	
	СтрокиТаблицы = СписокПользователей.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	Если СтрокиТаблицы.Количество() > 0 Тогда
		Если ЗначениеЗаполнено(ЭтотОбъект[ИмяЭлемента]) Тогда
			СтрокиТаблицы[0].Кассир = ЭтотОбъект[ИмяЭлемента];
			ЭлементКодСотрудника = Элементы.Найти(ИмяРеквизитаКодСотрудника);
			Если НЕ ЭлементКодСотрудника = Неопределено Тогда
				ЭлементКодСотрудника.Доступность = Истина;
			КонецЕсли;
			ЭлементКоманда = Элементы.Найти(ИмяКомандыКодСотрудника);
			Если НЕ ЭлементКоманда = Неопределено Тогда
				ЭлементКоманда.Доступность = Истина;
			КонецЕсли;
			
			ЭлементОтправлятьКод = Элементы.Найти(ИмяРеквизитаОтправлятьКод);
			Если НЕ ЭлементОтправлятьКод = Неопределено Тогда
				ЭлементОтправлятьКод.Доступность = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииКодСотрудника(Элемент)
	ИмяЭлемента = Элемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяЭлемента, НСтр("ru = 'КодСотрудника_'"), ""));
	СтрокиТаблицы = СписокПользователей.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	Если СтрокиТаблицы.Количество() > 0 Тогда
		УстановитьНастройкиКодаСотрудника(СтрокиТаблицы[0], ЭтотОбъект[ИмяЭлемента], НомерЭлемента);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииОтправлятьКод(Элемент)
	ИмяЭлемента = Элемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяЭлемента, НСтр("ru = 'ОтправитьКод_'"), ""));
	ИмяРеквизитаЭлектроннаяПочта = СтрШаблон(НСтр("ru = 'ЭлектроннаяПочта_%1'"), НомерЭлемента);
	СтрокиТаблицы = СписокПользователей.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	Если СтрокиТаблицы.Количество() > 0 Тогда
		СтрокиТаблицы[0].ОтправитьКод = ЭтотОбъект[ИмяЭлемента];
		ЭлементФормы = Элементы.Найти(ИмяРеквизитаЭлектроннаяПочта);
		Если НЕ ЭлементФормы = Неопределено Тогда
			ЭлементФормы.Видимость = СтрокиТаблицы[0].ОтправитьКод;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииЭлектроннаяПочта(Элемент)
	ИмяЭлемента = Элемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяЭлемента, НСтр("ru = 'ЭлектроннаяПочта_'"), ""));
	АдресЭлектроннойПочтыВалиден =
		ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(ЭтотОбъект[ИмяЭлемента]);
	
	Если АдресЭлектроннойПочтыВалиден Тогда
		СтрокиТаблицы = СписокПользователей.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
		Если СтрокиТаблицы.Количество() > 0 Тогда
			СтрокиТаблицы[0].ЭлектроннаяПочта = ЭтотОбъект[ИмяЭлемента];
		КонецЕсли;
	Иначе
		ТекстОповещения = НСтр("ru = 'Пожалуйста, проверьте корректность электронного адреса получателя кода доступа.'");
		ПоказатьПредупреждение(,ТекстОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)
	ОтобратьПользователейПоСтрокеПоискаНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаОчистка(Элемент, СтандартнаяОбработка)
	ОчиститьОтборыПользователей();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура СоздатьЭлементыКассиров()
	Для Каждого СтрокаПользователей Из СписокПользователей Цикл
		СоздатьЭлементыПользователей(СтрокаПользователей);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыПользователей(СтрокаПользователей)
	ИмяГруппыПользователь = СтрШаблон(НСтр("ru = 'ГруппаПользователь_%1'"), СтрокаПользователей.НомерЭлемента);
	
	Элемент = Элементы.Найти(ИмяГруппыПользователь);
	Если Не Элемент = Неопределено Тогда
		Элемент.Видимость = Истина;
		ЗаполнитьДанныеЭлементов(СтрокаПользователей);
		Возврат;
	КонецЕсли;
	
	НоваяГруппаКарточка = Элементы.Добавить(ИмяГруппыПользователь, Тип("ГруппаФормы"), Элементы.ГруппаСотрудники);
	НоваяГруппаКарточка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаКарточка.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаКарточка.ОтображатьЗаголовок = Ложь;
	НоваяГруппаКарточка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяГруппаКарточка.ОтображатьКакКарточку = Истина;
	НоваяГруппаКарточка.РастягиватьПоГоризонтали = Истина;
	
	ИмяГруппыПользовательГоризонтальная = СтрШаблон(НСтр("ru = 'ГруппаПользовательГоризонтальная_%1'"),
	СтрокаПользователей.НомерЭлемента);
	НоваяГруппаКарточкаГоризонтальная = Элементы.Добавить(ИмяГруппыПользовательГоризонтальная, Тип("ГруппаФормы"), НоваяГруппаКарточка);
	НоваяГруппаКарточкаГоризонтальная.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаКарточкаГоризонтальная.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаКарточкаГоризонтальная.ОтображатьЗаголовок = Ложь;
	НоваяГруппаКарточкаГоризонтальная.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ДобавляемыеРеквизиты = Новый Массив;
	ТипРеквизита = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ПользовательРМК.Тип);
	ИмяРеквизитаПользователь = СтрШаблон(НСтр("ru = 'Пользователь_%1'"), СтрокаПользователей.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаПользователь, ТипРеквизита);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ТипРеквизита = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.КассирРМК.Тип);
	ИмяРеквизитаКассир = СтрШаблон(НСтр("ru = 'Кассир_%1'"), СтрокаПользователей.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаКассир, ТипРеквизита);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ИмяРеквизитаКодСотрудника = СтрШаблон(НСтр("ru = 'КодСотрудника_%1'"), СтрокаПользователей.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаКодСотрудника, Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ИмяРеквизитаОтправлятьКод = СтрШаблон(НСтр("ru = 'ОтправитьКод_%1'"), СтрокаПользователей.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаОтправлятьКод, Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ИмяРеквизитаЭлектроннаяПочта = СтрШаблон(НСтр("ru = 'ЭлектроннаяПочта_%1'"), СтрокаПользователей.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаЭлектроннаяПочта, Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ЭтотОбъект.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаПользователь, Тип("ПолеФормы"), НоваяГруппаКарточкаГоризонтальная);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Пользователь'");
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаПользователь;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
	НовыйЭлемент.Видимость = Не НастройкаСотрудника;
	
	Если РежимПодбора Тогда
		ИмяДекорацииОтступ = СтрШаблон(НСтр("ru = 'ДекорацияОтступ_%1'"), СтрокаПользователей.НомерЭлемента);
		НовыйЭлемент = Элементы.Добавить(ИмяДекорацииОтступ, Тип("ДекорацияФормы"), НоваяГруппаКарточкаГоризонтальная);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
		
		ИмяКомандыУдалитьПользователя = СтрШаблон(НСтр("ru = 'ИсключитьПользователя_%1'"), СтрокаПользователей.НомерЭлемента);
		НовыйЭлемент = ЭтотОбъект.Элементы.Добавить(ИмяКомандыУдалитьПользователя, Тип("КнопкаФормы"), НоваяГруппаКарточкаГоризонтальная);
		НовыйЭлемент.Заголовок = НСтр("ru = 'Исключить из группы'");
		НовыйЭлемент.ИмяКоманды = НСтр("ru = 'ИсключитьПользователяИзГруппы'");
		НовыйЭлемент.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;
	
	ИмяГруппыКассирГоризонтальная = СтрШаблон(НСтр("ru = 'ГруппаКассирГоризонтальная_%1'"),
	СтрокаПользователей.НомерЭлемента);
	НоваяГруппаКарточкаГоризонтальная = Элементы.Добавить(ИмяГруппыКассирГоризонтальная, Тип("ГруппаФормы"), НоваяГруппаКарточка);
	НоваяГруппаКарточкаГоризонтальная.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаКарточкаГоризонтальная.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаКарточкаГоризонтальная.ОтображатьЗаголовок = Ложь;
	НоваяГруппаКарточкаГоризонтальная.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаКассир, Тип("ПолеФормы"), НоваяГруппаКарточкаГоризонтальная);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Кассир'");
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаКассир;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииКассира");
	
	ЭтотОбъект[ИмяРеквизитаПользователь] = СтрокаПользователей.Пользователь;
	ЭтотОбъект[ИмяРеквизитаКассир] = СтрокаПользователей.Кассир;
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаОтправлятьКод, Тип("ПолеФормы"), НоваяГруппаКарточкаГоризонтальная);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Отправить код по email'");
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаОтправлятьКод;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииОтправлятьКод");
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаКассир]) Тогда
		НовыйЭлемент.Доступность = Ложь;
	КонецЕсли;
	НовыйЭлемент.Видимость = Ложь;
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаЭлектроннаяПочта, Тип("ПолеФормы"), НоваяГруппаКарточка);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Email'");
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаЭлектроннаяПочта;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Видимость = Ложь;
	НовыйЭлемент.ПодсказкаВвода = НСтр("ru = 'mail@mail.ru'");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииЭлектроннаяПочта");
	
	ИмяГруппыКодСотрудника = СтрШаблон(НСтр("ru = 'ГруппаКодСотрудника_%1'"), СтрокаПользователей.НомерЭлемента);
	НоваяГруппаКодСотрудника = Элементы.Добавить(ИмяГруппыКодСотрудника, Тип("ГруппаФормы"), НоваяГруппаКарточка);
	НоваяГруппаКодСотрудника.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаКодСотрудника.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаКодСотрудника.ОтображатьЗаголовок = Ложь;
	НоваяГруппаКодСотрудника.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаКодСотрудника, Тип("ПолеФормы"), НоваяГруппаКодСотрудника);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Код сотрудника'");
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаКодСотрудника;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ПриИзмененииКодСотрудника");
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаКассир]) Тогда
		НовыйЭлемент.Доступность = Ложь;
	КонецЕсли;
	
	ЭтотОбъект[ИмяРеквизитаКодСотрудника] = СтрокаПользователей.КодСотрудника;
	
	ИмяГруппыКодСотрудникаКоманды = СтрШаблон(НСтр("ru = 'ГруппаКодСотрудникаКоманды_%1'"), СтрокаПользователей.НомерЭлемента);
	НоваяГруппаКодСотрудникаКоманды = Элементы.Добавить(ИмяГруппыКодСотрудникаКоманды, Тип("ГруппаФормы"), НоваяГруппаКодСотрудника);
	НоваяГруппаКодСотрудникаКоманды.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаКодСотрудникаКоманды.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаКодСотрудникаКоманды.ОтображатьЗаголовок = Ложь;
	НоваяГруппаКодСотрудникаКоманды.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ИмяКомандыКодСотрудника = СтрШаблон(НСтр("ru = 'СгенерироватьКодСотрудника_%1'"), СтрокаПользователей.НомерЭлемента);
	НовыйЭлемент = ЭтотОбъект.Элементы.Добавить(ИмяКомандыКодСотрудника, Тип("КнопкаФормы"), НоваяГруппаКодСотрудникаКоманды);
	НовыйЭлемент.Заголовок = НСтр("ru = 'Сгененировать код'");
	НовыйЭлемент.ИмяКоманды = НСтр("ru = 'СгенерироватьКод'");
	НовыйЭлемент.Отображение = ОтображениеКнопки.КартинкаИТекст;
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаКассир]) Тогда
		НовыйЭлемент.Доступность = Ложь;
	КонецЕсли;
	
	ИмяКомандыПечатьКода = СтрШаблон(НСтр("ru = 'НапечататьКодСотрудника_%1'"), СтрокаПользователей.НомерЭлемента);
	НовыйЭлемент = ЭтотОбъект.Элементы.Добавить(ИмяКомандыПечатьКода, Тип("КнопкаФормы"), НоваяГруппаКодСотрудникаКоманды);
	НовыйЭлемент.Заголовок = НСтр("ru = 'Напечатать код сотрудника'");
	НовыйЭлемент.ИмяКоманды = НСтр("ru = 'ПечатьШтрихкода'");
	НовыйЭлемент.Отображение = ОтображениеКнопки.Картинка;
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаКодСотрудника]) Тогда
		НовыйЭлемент.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеЭлементов(СтрокаПользователей)
	ИмяРеквизитаКодСотрудника = СтрШаблон(НСтр("ru = 'КодСотрудника_%1'"), СтрокаПользователей.НомерЭлемента);
	ИмяРеквизитаКассир = СтрШаблон(НСтр("ru = 'Кассир_%1'"), СтрокаПользователей.НомерЭлемента);
	ИмяКомандыКодСотрудника = СтрШаблон(НСтр("ru = 'СгенерироватьКодСотрудника_%1'"), СтрокаПользователей.НомерЭлемента);
	ИмяКомандыПечатьКода = СтрШаблон(НСтр("ru = 'НапечататьКодСотрудника_%1'"), СтрокаПользователей.НомерЭлемента);
	ИмяРеквизитаПользователь = СтрШаблон(НСтр("ru = 'Пользователь_%1'"), СтрокаПользователей.НомерЭлемента);
	
	ЭтотОбъект[ИмяРеквизитаПользователь] = СтрокаПользователей.Пользователь;
	ЭтотОбъект[ИмяРеквизитаКассир] = СтрокаПользователей.Кассир;
	ЭтотОбъект[ИмяРеквизитаКодСотрудника] = СтрокаПользователей.КодСотрудника;
	
	Элемент = Элементы.Найти(ИмяКомандыКодСотрудника);
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаКассир])
		И НЕ Элемент = Неопределено Тогда
		Элемент.Доступность = Ложь;
	КонецЕсли;
	
	Элемент = Элементы.Найти(ИмяКомандыКодСотрудника);
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаКассир])
		И НЕ Элемент = Неопределено Тогда
		Элемент.Доступность = Ложь;
	КонецЕсли;
	
	Элемент = Элементы.Найти(ИмяКомандыПечатьКода);
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаКодСотрудника])
		И НЕ Элемент = Неопределено Тогда
		Элемент.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйКодДоступаКассираПоУмолчанию()
	
	СлучайноеЧислоСтрокой = "";
	Генератор = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
	СлучайноеЧисло = Генератор.СлучайноеЧисло(0, 99999);
	
	Если СлучайноеЧисло < 10000 Тогда
		СлучайноеЧислоСтрокой = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Строка(СлучайноеЧисло), 5, "0");
	Иначе
		СлучайноеЧислоСтрокой = Формат(СлучайноеЧисло, "ЧГ=0");
	КонецЕсли;
	
	Возврат СлучайноеЧислоСтрокой;

КонецФункции

&НаСервере
Процедура СгенерироватьКодСотрудникаНаСервере(СтруктураСтроки)
	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьНовыйКодДоступаКассирДляВхода(СтруктураСтроки.НовыйКодСотрудника);
	ОбщегоНазначенияРМКПереопределяемый.УстановитьКодДоступаПомощникРМК(СтруктураСтроки.Кассир, СтруктураСтроки.Пользователь, 
		СтруктураСтроки.НовыйКодСотрудника);
	ИмяРеквизитаКодСотрудника = СтрШаблон(НСтр("ru = 'КодСотрудника_%1'"), СтруктураСтроки.НомерЭлемента);
	ЭтотОбъект[ИмяРеквизитаКодСотрудника] = СтруктураСтроки.НовыйКодСотрудника;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНастройкиКодаСотрудника(СтрокиТаблицы, НовыйКодСотрудника, НомерЭлемента)
	Если ЗначениеЗаполнено(НовыйКодСотрудника) Тогда
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("Кассир", СтрокиТаблицы.Кассир);
		СтруктураСтроки.Вставить("Пользователь", СтрокиТаблицы.Пользователь);
		СтруктураСтроки.Вставить("НомерЭлемента", НомерЭлемента);
		СтруктураСтроки.Вставить("НовыйКодСотрудника", НовыйКодСотрудника);
		СгенерироватьКодСотрудникаНаСервере(СтруктураСтроки);
		НовыйКодСотрудника = СтруктураСтроки.НовыйКодСотрудника;
	КонецЕсли;
	СтрокиТаблицы.КодСотрудника = НовыйКодСотрудника;
	
	ИмяКомандыПечатьКода = СтрШаблон(НСтр("ru = 'НапечататьКодСотрудника_%1'"), НомерЭлемента);
	ЭлементКоманда = Элементы.Найти(ИмяКомандыПечатьКода);
	Если НЕ ЭлементКоманда = Неопределено Тогда
		ЭлементКоманда.Доступность = ЗначениеЗаполнено(СтрокиТаблицы.КодСотрудника);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВывестиКодДоступаСотрудникаВТабличныйДокумент(КодКассира, Кассир)
	
	Если ЗначениеЗаполнено(КодКассира) Тогда
		
		Результат = КодДоступаКассираДляСохранения(КодКассира, Кассир);
		Результат.Показать();
		
	Иначе
		
		ПоказатьПредупреждение(,
		НСтр("ru = 'Невозможно сохранить несозданный код.
		|Пожалуйста, сформируйте новый код и попробуйте снова.'"));
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КодДоступаКассираДляСохранения(КодКассира, Кассир)
	
	Результат = Новый ТабличныйДокумент;
	Результат.Очистить();
	ОбщегоНазначенияРМКПереопределяемый.ПодготовитьКодДоступаПользователяДляСохранения(КодКассира,
		Строка(Кассир),
		Результат);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаписатьНастройкиКассиров()
	СтрукутраЗаписи = Новый Структура;
	СтрукутраЗаписи.Вставить("ГруппаДоступа", ГруппаДоступа);
	СтрукутраЗаписи.Вставить("УстанавливатьКод", Истина);
	СтрукутраЗаписи.Вставить("РежимПодбора", Истина);
	СтрукутраЗаписи.Вставить("ОтправлятьЭлектроннуюПочту", Истина);
	ОбщегоНазначенияРМКПереопределяемый.ЗаписатьНастройкиПользователей(СписокПользователей, СтрукутраЗаписи);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеВРежимеВыбора()
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьДанныеВРежимеВыбора(СписокПользователей, ГруппаДоступа);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеТаблицыПользователей()
	ОбщегоНазначенияРМКПереопределяемый.ОпределитьСписокПользователейПриСозданииНаСервере(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПользователейВТаблицу(ВыбранныеЭлементы)
	МассивВыбранныхПользователей = Новый Массив;
	Для Каждого ВыбранныйЭлемент Из ВыбранныеЭлементы Цикл
		МассивВыбранныхПользователей.Добавить(Элементы.ВыборПользователей.ДанныеСтроки(ВыбранныйЭлемент).Пользователь);
	КонецЦикла;
	ЗаполнитьДанныеПользователей(МассивВыбранныхПользователей);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПользователей(МассивВыбранныхПользователей)
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьДанныеПользователей(МассивВыбранныхПользователей, СписокПользователей);
	
	СписокНовыхЭлементов = СписокПользователей.НайтиСтроки(Новый Структура("НовыйЭлемент", Истина));
	Для Каждого СтрокаЭлемента Из СписокНовыхЭлементов Цикл
		СоздатьЭлементыПользователей(СтрокаЭлемента);
		СтрокаПользователя = СписокПользователей.НайтиПоИдентификатору(СтрокаЭлемента.ПолучитьИдентификатор());
		СтрокаПользователя.НовыйЭлемент = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьПользователейПоСтрокеПоискаНаКлиенте()
	СброситьОтборыПользователей();
	ОтобратьПользователейПоСтрокеПоиска();
	УстановитьВидимостьГруппы();
КонецПроцедуры

&НаСервере
Процедура ОтобратьПользователейПоСтрокеПоиска()
	СформированнаяСтрокаПоиска = "%" + СтрокаПоиска + "%";
	ОбщегоНазначенияРМКПереопределяемый.УстановитьОтборПользователейПоСтрокеПоиска(СписокПользователей, СформированнаяСтрокаПоиска);
КонецПроцедуры

&НаКлиенте
Процедура СброситьОтборыПользователей()
	Для Каждого СтрокаТаблицы Из СписокПользователей Цикл
		СтрокаТаблицы.Видимость = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьГруппы()
	Для Каждого СтрокаТаблицы Из СписокПользователей Цикл
		ИмяГруппыПользователь = СтрШаблон(НСтр("ru = 'ГруппаПользователь_%1'"), СтрокаТаблицы.НомерЭлемента);
		ЭлементГруппа = Элементы.Найти(ИмяГруппыПользователь);
		Если НЕ ЭлементГруппа = Неопределено Тогда
			ЭлементГруппа.Видимость = СтрокаТаблицы.Видимость;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтборыПользователей()
	СброситьОтборыПользователей();
	УстановитьВидимостьГруппы();
КонецПроцедуры

#КонецОбласти
