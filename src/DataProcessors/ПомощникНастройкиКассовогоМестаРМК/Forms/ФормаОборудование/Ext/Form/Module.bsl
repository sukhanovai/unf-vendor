
#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ТекущееРабочееМесто") Тогда
		ТекущееРабочееМесто = Параметры.ТекущееРабочееМесто;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "МассивКасс") Тогда
		Для Каждого СтрокаМассива Из Параметры.МассивКасс Цикл
			НоваяСтрока = ТаблицаКассыККМ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
		КонецЦикла;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "МассивЭквайринга") Тогда
		Для Каждого СтрокаМассива Из Параметры.МассивЭквайринга Цикл
			НоваяСтрока = ТаблицаЭквайринг.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
		КонецЦикла;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ОткрытиеОборудования")
		И Параметры.ОткрытиеОборудования Тогда
		ОткрытиеОборудования = Параметры.ОткрытиеОборудования;
		НомерЭлемента = 0;
		Для Каждого СтрокаОборудование Из Параметры.МассивНастройкиОборудования Цикл
			НомерЭлемента = НомерЭлемента + 1;
			НоваяСтрока = ТаблицаОборудование.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОборудование);
			НоваяСтрока.НомерЭлемента = НомерЭлемента;
		КонецЦикла;
		
		Элементы.СтраницыНастройки.ТекущаяСтраница = Элементы.СтраницаНастройки;
		Элементы.ЗаписатьНастройки.Важность = ВажностьКнопки.Главная;
		ЗаполнитьДанныеФормы();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "НастройкаККТ") Тогда
		НастройкаККТ = Параметры.НастройкаККТ;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "НастройкаЭквайринг") Тогда
		НастройкаЭквайринг = Параметры.НастройкаЭквайринг;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ОткрытиеОборудования Тогда
		ПереключательПриИзмененииНаКлиенте();
	ИначеЕсли НастройкаККТ
		Или НастройкаЭквайринг Тогда
		ПерейтиКСозданиюОборудованияКлиент();
	Иначе
		НастроитьЭлементыФормы();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ПараметрыОповещения = Новый Структура("ПодключенТерминал", ПодключенТерминал);
	Оповестить("ПодключениеОборудования", ПараметрыОповещения);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура БольшеНастроек(Команда)
	ОбработчикЗавершение = Новый ОписаниеОповещения("ВыполнитьНастройкуОборудованияЗавершение", ЭтотОбъект);
	ИмяРеквизитаОборудование = СтрШаблон(НСтр("ru = 'ПодключаемоеОборудование_%1'"), НомерСтраницы);
	Если ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаОборудование]) Тогда
		МенеджерОборудованияРМККлиент.ВыполнитьНастройкуОборудования(ЭтотОбъект[ИмяРеквизитаОборудование], ОбработчикЗавершение);
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Автонастройка(Команда)
	Оповещение = Новый ОписаниеОповещения("АвтонастройкаУстройстваЗавершение", ЭтотОбъект);
	ПараметрыУстройства = Новый Структура;
	СтрокиОборудования = ТаблицаОборудование.НайтиСтроки(Новый Структура("НомерЭлемента", НомерСтраницы));
	Если СтрокиОборудования.Количество() > 0 Тогда
		Для Каждого СтрокаПараметр Из СтрокиОборудования[0].ПараметрыСканера Цикл
			ПараметрыУстройства.Вставить(СтрокаПараметр.Представление, СтрокаПараметр.Значение);
		КонецЦикла;
		ИмяРеквизитаОборудование = СтрШаблон(НСтр("ru = 'ПодключаемоеОборудование_%1'"), НомерСтраницы);
		МенеджерОборудованияКлиент.НачатьАвтонастройкуУстройства(Оповещение, ЭтотОбъект[ИмяРеквизитаОборудование], ПараметрыУстройства);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНастройки(Команда)
	
	СтрокиОборудование = ТаблицаОборудование.НайтиСтроки(Новый Структура("НомерЭлемента", НомерСтраницы));
	ОборудованиеПодключено = Ложь;
	Если СтрокиОборудование.Количество() > 0 Тогда
		ОборудованиеПодключено = ЗначениеЗаполнено(СтрокиОборудование[0].ПодключаемоеОборудование);
	КонецЕсли;
	
	Если ОборудованиеПодключено Тогда
		ОбновнитьДанныеОборудованияНаКлиенте();
	Иначе
		СоздатьЭкземплярОборудования();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроизводительАтол(Команда)
	ИмяСтраницКасса = СтрШаблон(НСтр("ru = 'СтраницыКасса_%1'"), НомерСтраницы);
	ИмяСтраницаНастройкаККМ = СтрШаблон(НСтр("ru = 'СтраницаНастройкаККМ_%1'"), НомерСтраницы);
	
	ЭлементыСтраницы = Элементы.Найти(ИмяСтраницКасса);
	Если НЕ ЭлементыСтраницы = Неопределено Тогда
		ЭлементСтраница = Элементы.Найти(ИмяСтраницаНастройкаККМ);
		Если НЕ ЭлементыСтраницы = Неопределено Тогда
			ЭлементыСтраницы.ТекущаяСтраница = ЭлементСтраница;
		КонецЕсли;
	КонецЕсли;
	Производитель = НСтр("ru ='АТОЛ'");
	ЗаполнитьПараметрыКассы();
КонецПроцедуры

