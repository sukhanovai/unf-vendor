	ИмяРеквизитаДрайвер = СтрШаблон(НСтр("ru = 'ДрайверОборудования_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаДрайвер, ТипРеквизитаДрайвер);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизитаОборудование = СтрШаблон(НСтр("ru = 'ПодключаемоеОборудование_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаОборудование, ТипРеквизитаОборудование);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизитаЭквайринг = СтрШаблон(НСтр("ru = 'ЭквайринговыйТерминал_%1'"), СтрокаОборудование.НомерЭлемента);
