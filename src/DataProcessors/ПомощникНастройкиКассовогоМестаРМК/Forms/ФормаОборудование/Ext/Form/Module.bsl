	ИмяОповещения = "ОбновитьДанныеДрайверов";
	ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуВыбораДрайвера(ЭтотОбъект, ИмяОповещения);
КонецПроцедуры

