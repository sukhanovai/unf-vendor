	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяГруппа.РастягиватьПоГоризонтали = Истина;
	
	ТипРеквизитаСтрока = Новый ОписаниеТипов("Строка");
	ТипРеквизитаДрайвер = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ДрайверОборудованияРМК.Тип);
	ТипРеквизитаОборудование = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ПодключаемоеОборудованиеРМК.Тип);
	ТипРеквизитаТипПодключения = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ТипПодключенияОборудованияРМК.Тип);
	ТипРеквизитаОрганизация = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ОрганизацияРМК.Тип);
	ТипРеквизитаТипОборудования = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ТипыПодключаемогоОборудования.Тип);
	ТипРеквизитКассаККМ = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.КассаККМРМК.Тип);
	
	ДобавляемыеРеквизиты = Новый Массив;
	ИмяРеквизитаНаименование = СтрШаблон(НСтр("ru = 'Наименование_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаНаименование, ТипРеквизитаСтрока);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизитаДрайвер = СтрШаблон(НСтр("ru = 'ДрайверОборудования_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаДрайвер, ТипРеквизитаДрайвер);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизитаТипПодключения = СтрШаблон(НСтр("ru = 'ТипПодключения_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаТипПодключения, ТипРеквизитаТипПодключения);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизитаОборудование = СтрШаблон(НСтр("ru = 'ПодключаемоеОборудование_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаОборудование, ТипРеквизитаОборудование);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизитаКассаККМ = СтрШаблон(НСтр("ru = 'КассаККМ_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаКассаККМ, ТипРеквизитКассаККМ);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизитаТипОборудования = СтрШаблон(НСтр("ru = 'ТипОборудования_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаТипОборудования, ТипРеквизитаТипОборудования);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизитаОрганизация = СтрШаблон(НСтр("ru = 'Организация_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаОрганизация, ТипРеквизитаОрганизация);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ЭтотОбъект.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаТипПодключения, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеПереключателя;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Тип подключения'");
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаТипПодключения;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.ОтметкаОбязательногоЗаполнения = Истина;
	НовыйЭлемент.ВидПереключателя = ВидПереключателя.Тумблер;
	НовыйЭлемент.СписокВыбора.ЗагрузитьЗначения(МассивПодключенияОборудования);
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаОрганизация, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Организация'");
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаОрганизация;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.ОтметкаОбязательногоЗаполнения = Истина;
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаНаименование, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Наименование'");
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаНаименование;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.ОтметкаОбязательногоЗаполнения = Истина;
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаДрайвер, Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Драйвер'");
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаДрайвер;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.РежимВыбораИзСписка = Не ЗначениеЗаполнено(СтрокаОборудование.ДрайверОборудования);
	НовыйЭлемент.ОтметкаОбязательногоЗаполнения = Истина;
	НовыйЭлемент.КнопкаСоздания = Истина;
	НовыйЭлемент.Доступность = Не ЗначениеЗаполнено(СтрокаОборудование.ДрайверОборудования);
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ДрайверПриИзменении");
	НовыйЭлемент.УстановитьДействие("Создание", "Подключаемый_ПриСозданииДрайвер");
	
	ИмяГруппыБаннер = СтрШаблон(НСтр("ru = 'БаннерИнформация_%1'"), СтрокаОборудование.НомерЭлемента);
	НоваяГруппаБаннер = Элементы.Добавить(ИмяГруппыБаннер, Тип("ГруппаФормы"), НоваяГруппа);
	НоваяГруппаБаннер.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаБаннер.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаБаннер.ОтображатьЗаголовок = Ложь;
	НоваяГруппаБаннер.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НоваяГруппаБаннер.РастягиватьПоГоризонтали = Истина;
	НоваяГруппаБаннер.Видимость = Ложь;
	НоваяГруппаБаннер.ОтображатьКакКарточку = Истина;
	НоваяГруппаБаннер.ЦветФона = ЦветаПалитры.Голубой;
	
	ИмяГруппыКартинкаБаннер = СтрШаблон(НСтр("ru = 'КолонкаПодКартинкуИнформация_%1'"), СтрокаОборудование.НомерЭлемента);
	НоваяГруппаКартинкаБаннер = Элементы.Добавить(ИмяГруппыКартинкаБаннер, Тип("ГруппаФормы"), НоваяГруппаБаннер);
	НоваяГруппаКартинкаБаннер.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаКартинкаБаннер.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаКартинкаБаннер.ОтображатьЗаголовок = Ложь;
	НоваяГруппаКартинкаБаннер.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НоваяГруппаКартинкаБаннер.РастягиватьПоГоризонтали = Истина;
	
	ИмяРеквизитаДекорацияДрайвер = СтрШаблон(НСтр("ru = 'КартинкаБаннераИнформация_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаДекорацияДрайвер, Тип("ДекорацияФормы"),НоваяГруппаКартинкаБаннер);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Картинка;
	НовыйЭлемент.Картинка = БиблиотекаКартинок.Информация;
	
	ИмяГруппыДекорацияБаннер = СтрШаблон(НСтр("ru = 'КолонкаПодКонтентБаннераИнформация_%1'"), СтрокаОборудование.НомерЭлемента);
	НоваяГруппаДекорацияБаннер = Элементы.Добавить(ИмяГруппыДекорацияБаннер, Тип("ГруппаФормы"), НоваяГруппаБаннер);
	НоваяГруппаДекорацияБаннер.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаДекорацияБаннер.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаДекорацияБаннер.ОтображатьЗаголовок = Ложь;
	НоваяГруппаДекорацияБаннер.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НоваяГруппаДекорацияБаннер.РастягиватьПоГоризонтали = Истина;
	
	ИмяРеквизитаДекорацияДрайвер = СтрШаблон(НСтр("ru = 'ДекорацияДрайверСообщения_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаДекорацияДрайвер, Тип("ДекорацияФормы"),НоваяГруппаДекорацияБаннер);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок =  НСтр("ru = ''");
	
	Если МассивПодключенияОборудования.Количество() > 0 Тогда
		ЭтотОбъект[ИмяРеквизитаТипПодключения] = МассивПодключенияОборудования[0];
	КонецЕсли;
	ЭтотОбъект[ИмяРеквизитаОрганизация] = СтрокаОборудование.Организация;
	ЭтотОбъект[ИмяРеквизитаТипОборудования] = СтрокаОборудование.ТипОборудования;
	ЭтотОбъект[ИмяРеквизитаКассаККМ] = СтрокаОборудование.КассаККМ;
	Если ЗначениеЗаполнено(СтрокаОборудование.Наименование) Тогда
		ЭтотОбъект[ИмяРеквизитаНаименование] = СтрокаОборудование.Наименование;
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаОборудование.ДрайверОборудования) Тогда
		ЭтотОбъект[ИмяРеквизитаДрайвер] = СтрокаОборудование.ДрайверОборудования;
	КонецЕсли;
	ЭтотОбъект[ИмяРеквизитаОборудование] = СтрокаОборудование.ПодключаемоеОборудование;
КонецПроцедуры

&НаСервере
Процедура СоздатьСтраницыЭквайринг(СтрокаОборудование)
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	ИмяСтраницЭквайринг = СтрШаблон(НСтр("ru = 'СтраницыЭквайринг_%1'"), СтрокаОборудование.НомерЭлемента);
	НоваяСтраницаКассы = Элементы.Добавить(ИмяСтраницЭквайринг, Тип("ГруппаФормы"), Элементы.ГруппаЭлементыНастроек);
	НоваяСтраницаКассы.Вид = ВидГруппыФормы.Страницы;
	НоваяСтраницаКассы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	НоваяСтраницаКассы.Видимость = Истина;
	
	ИмяСтраницаВыборПроизводителя = СтрШаблон(НСтр("ru = 'СтраницаВыборПроизводителяЭквайринг_%1'"), СтрокаОборудование.НомерЭлемента);
	НоваяСтраница = Элементы.Добавить(ИмяСтраницаВыборПроизводителя, Тип("ГруппаФормы"), НоваяСтраницаКассы);
	НоваяСтраница.Вид = ВидГруппыФормы.Страница;
	
	ИмяГруппыПроизводитель = СтрШаблон(НСтр("ru = 'ГруппаПроизводитель_%1'"), СтрокаОборудование.НомерЭлемента);
	НоваяГруппа = Элементы.Добавить(ИмяГруппыПроизводитель, Тип("ГруппаФормы"), НоваяСтраница);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НоваяГруппа.РастягиватьПоГоризонтали = Истина;
	Если Не ЭтоИнтерфейс85 Тогда
		НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	
	ИмяПроизводительСбер = СтрШаблон(НСтр("ru = 'ПроизводительСбер_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйЭлемент = Элементы.Добавить(ИмяПроизводительСбер, Тип("КнопкаФормы"), НоваяГруппа);
	НовыйЭлемент.Заголовок = НСтр("ru = 'Сбер'");
	НовыйЭлемент.ИмяКоманды = НСтр("ru = 'ПроизводительСбер'");
	НовыйЭлемент.ОтображатьКакКарточку = Истина;
	НовыйЭлемент.ВысотаКартинки = 1;
	НовыйЭлемент.ВыравниваниеКартинкиИЗаголовкаКарточки = ВариантВыравниванияКартинкиИЗаголовкаКарточки.ГоризонтальноЦентрВертикальноЦентр;
	НовыйЭлемент.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
	Если Не ЭтоИнтерфейс85 Тогда
		НовыйЭлемент.Высота = 3;
		НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
	КонецЕсли;
	
	ИмяПроизводительВсе = СтрШаблон(НСтр("ru = 'ПроизводительВсе_%1'"), СтрокаОборудование.НомерЭлемента);
	НовыйЭлемент = Элементы.Добавить(ИмяПроизводительВсе, Тип("КнопкаФормы"), НоваяГруппа);
	ЗаголовокТерминалШаблон = НСтр("ru = 'Остальные %1 терминалы'");
	НовыйЭлемент.Заголовок = СтрШаблон(ЗаголовокТерминалШаблон, Символы.ПС);
	НовыйЭлемент.ИмяКоманды = НСтр("ru = 'ПроизводительВсеЭквайринг'");
	НовыйЭлемент.ОтображатьКакКарточку = Истина;
	НовыйЭлемент.ВысотаКартинки = 1;
	НовыйЭлемент.Высота = 3;
	НовыйЭлемент.Ширина = 12;
	НовыйЭлемент.ВыравниваниеКартинкиИЗаголовкаКарточки = ВариантВыравниванияКартинкиИЗаголовкаКарточки.ГоризонтальноЦентрВертикальноЦентр;
	НовыйЭлемент.Отображение = ОтображениеКнопки.КартинкаИТекст;
	Если Не ЭтоИнтерфейс85 Тогда
		НовыйЭлемент.Высота = 3;
		НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
		НовыйЭлемент.Заголовок = НСтр("ru = 'Остальные терминалы'");
	КонецЕсли;
	
	ИмяСтраницаНастройкаЭквайринг = СтрШаблон(НСтр("ru = 'СтраницаНастройкаЭквайринг_%1'"), СтрокаОборудование.НомерЭлемента);
	НоваяСтраница = Элементы.Добавить(ИмяСтраницаНастройкаЭквайринг, Тип("ГруппаФормы"), НоваяСтраницаКассы);
	НоваяСтраница.Вид = ВидГруппыФормы.Страница;
	
	ИмяГруппыНастройкаЭквайринг = СтрШаблон(НСтр("ru = 'ГруппаНастройкаЭквайринг_%1'"), СтрокаОборудование.НомерЭлемента);
	НоваяГруппа = Элементы.Добавить(ИмяГруппыНастройкаЭквайринг, Тип("ГруппаФормы"), НоваяСтраница);
