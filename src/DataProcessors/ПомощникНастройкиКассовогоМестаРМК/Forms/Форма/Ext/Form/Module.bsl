#Область ОписаниеПеременных

&НаКлиенте
Перем СоответствиеСтрокРазвернутая;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьНастройкиПомощникРМК(ЭтотОбъект);
	ЗаполнитьДанныеФормы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОткрытьПомощникНастройкиОбмена();
	ЗапускОбмена();
	СоответствиеСтрокРазвернутая = Новый Соответствие;
	ЗаполнитьСканерПриСтарте();
	НастроитьИспользованиеСервераЛояльности();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	ПерезаполнитьНастройки = Ложь;
	Если ИмяСобытия = "СохранениеНастроекРМК" Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметр, "НастройкаЗаписана")
			И Параметр.НастройкаЗаписана Тогда
			ПерезаполнитьНастройки = Истина;
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "РабочееМестоКассираУспешноНастроено" Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметр, "РабочееМестоКассираУспешноНастроено")
			И Параметр.РабочееМестоКассираУспешноНастроено Тогда
			ПерезаполнитьНастройки = Истина;
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ПодключениеОборудования" Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметр, "ПодключенТерминал")
			И Параметр.ПодключенТерминал Тогда
			НастройкиРМК.ИспользоватьОплатуПлатежнымиКартами = Истина;
		КонецЕсли;
		ЗаполнитьКарточкиКассыИЭквайринг();
		ПереключитьСтраницу();
	ИначеЕсли ИмяСобытия = "НастройкаПлатежныхСистем" Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметр, "ПлатежныеСистемыПодключены")
			И Параметр.ПлатежныеСистемыПодключены Тогда
			НастройкиРМК.ИспользоватьОплатуПлатежнымиСистемами = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ПерезаполнитьНастройки Тогда
		НастройкиИзменены = Ложь;
		ЗаполнитьНастройкуРабочегоМестаКассира();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ПомощникНастройкиОбмена(Команда)
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуНастройкиОбменаРезультат", ЭтотОбъект);
	ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуНастройкиОбмена(ОбработчикОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзНастройки(Команда)
	УдалитьСотрудникаИзДерева();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПользователя(Команда)
	ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуСозданияПользователь(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПользователейПоСотрудникам(Команда)
	ПараметрыОткрытияФормы = Новый Структура("ТорговыйОбъект", ТорговыйОбъект);
	ОбработчикЗакрытия = Новый ОписаниеОповещения("ОбновитьТаблицуПользователей", ЭтотОбъект);
	ОткрытьФорму("Обработка.ПомощникНастройкиКассовогоМестаРМК.Форма.СписокФизическихЛиц"
		,ПараметрыОткрытияФормы,ЭтотОбъект, ЭтотОбъект.УникальныйИдентификатор,,, ОбработчикЗакрытия, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройки(Команда)
	Элементы.ГруппаНастройкиВсплывающая.Показать();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьГруппуДоступа(Команда)
	ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуСозданияГруппыДоступа(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВНастройкуМножественный(Команда)
	ДобавитьПользователейВТаблицу();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОборудование(Команда)
	ПараметрыОткрытияФормы = Новый Структура;
	МассивКасс = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаКассККМ Цикл
		Если СтрокаТаблицы.КассаПодключена
			Или СтрокаТаблицы.ИспользоватьБезПодключенияОборудования Тогда
			Продолжить;
		КонецЕсли;
		МассивКасс.Добавить(Новый Структура("КассаККМ, Организация", СтрокаТаблицы.КассаККМ, СтрокаТаблицы.Организация));
	КонецЦикла;
	
	МассивЭквайринга = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаЭквайринговыйТерминал Цикл
		Если СтрокаТаблицы.ЭквайрингПодключен
			Или СтрокаТаблицы.ИспользоватьБезПодключенияОборудования Тогда
			Продолжить;
		КонецЕсли;
		МассивЭквайринга.Добавить(Новый Структура("ЭквайринговыйТерминал, Организация", СтрокаТаблицы.КассаККМ, СтрокаТаблицы.Организация));
	КонецЦикла;

	ПараметрыОткрытияФормы.Вставить("МассивКасс", МассивКасс);
	ПараметрыОткрытияФормы.Вставить("МассивЭквайринга", МассивЭквайринга);
	ПараметрыОткрытияФормы.Вставить("ТекущееРабочееМесто", ТекущееРабочееМесто);
	
	ОбработкаОповещения = Новый ОписаниеОповещения("ЗаполнитьПодключаемоеОборудование", ЭтотОбъект);
	ОткрытьФорму("Обработка.ПомощникНастройкиКассовогоМестаРМК.Форма.ФормаОборудование", ПараметрыОткрытияФормы, ЭтотОбъект,
			,,, ОбработкаОповещения, РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПлатежныеСистемы(Команда)
	НастроитьПлатежныеСистемыНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	ПроверитьПодключениеСерверЛояльности();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьРасписание(Команда)
	ДобавитьРасписаниеНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Сценарий обмена создан'"));
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПодключенияОбмена(Команда)
	ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуЗаписиРегистраСведенийОбменРМК(ЭтотОбъект, УзелОбмена);
КонецПроцедуры

&НаКлиенте
Процедура НастроитьСценарииОбменаДанными(Команда)
	ОбменДаннымиКлиент.ОбработкаКомандыНастроитьРасписаниеВыполненияОбмена(УзелОбмена, ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписаниеРегламентногоЗадания(Команда)
	// Если расписание не инициализировано в форме на сервере, то создаем новое.
	Если РасписаниеРегламентногоЗаданияВыгрузкаДанных = Неопределено Тогда
		
		РасписаниеРегламентногоЗаданияВыгрузкаДанных = Новый РасписаниеРегламентногоЗадания;
		
	КонецЕсли;
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеРегламентногоЗаданияВыгрузкаДанных);
	
	// Открываем диалог для редактирования Расписания.
	ОписаниеОповещения = Новый ОписаниеОповещения("РедактированиеРасписанияРегламентногоЗаданияЗавершение", ЭтотОбъект, Новый Структура("ВыгрузкаДанных", Истина));
	Диалог.Показать(ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРасписаниеРегламентногоЗагрузкаДанных(Команда)
	// Если расписание не инициализировано в форме на сервере, то создаем новое.
	Если РасписаниеРегламентногоЗаданияЗагрузкаДанных = Неопределено Тогда
		
		РасписаниеРегламентногоЗаданияЗагрузкаДанных = Новый РасписаниеРегламентногоЗадания;
		
	КонецЕсли;
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеРегламентногоЗаданияЗагрузкаДанных);
	
	// Открываем диалог для редактирования Расписания.
	ОписаниеОповещения = Новый ОписаниеОповещения("РедактированиеРасписанияРегламентногоЗаданияЗавершение", ЭтотОбъект, Новый Структура("ВыгрузкаДанных", Ложь));
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьКассу(Команда)
	ИмяЭлемента = ТекущийЭлемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяЭлемента, "ПодключитьКассу_", ""));
	
	СтрокиКассаККМ = ТаблицаКассККМ.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	Если СтрокиКассаККМ.Количество() > 0 Тогда
		МассивКасс = Новый Массив();
		
		СтруктураНастройки = Новый Структура;
		СтруктураНастройки.Вставить("КассаККМ", СтрокиКассаККМ[0].КассаККМ);
		СтруктураНастройки.Вставить("Организация", СтрокиКассаККМ[0].Организация);
		МассивКасс.Добавить(СтруктураНастройки);
		
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("МассивКасс", МассивКасс);
		ПараметрыОткрытияФормы.Вставить("ТекущееРабочееМесто", ТекущееРабочееМесто);
		ПараметрыОткрытияФормы.Вставить("НастройкаККТ", Истина);
		ОбработкаОповещения = Новый ОписаниеОповещения("ЗаполнитьПодключаемоеОборудование", ЭтотОбъект);
		ОткрытьФорму("Обработка.ПомощникНастройкиКассовогоМестаРМК.Форма.ФормаОборудование", ПараметрыОткрытияФормы, ЭтотОбъект,
			,,, ОбработкаОповещения, РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьЭквайринг(Команда)
	ИмяЭлемента = ТекущийЭлемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяЭлемента, "ПодключитьЭквайринг_", ""));
	
	СтрокиЭквайринг = ТаблицаЭквайринговыйТерминал.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	Если СтрокиЭквайринг.Количество() > 0 Тогда
		МассивЭкварйринг = Новый Массив();
		
		СтруктураНастройки = Новый Структура;
		СтруктураНастройки.Вставить("Эквайринг", СтрокиЭквайринг[0].ЭквайринговыйТерминал);
		СтруктураНастройки.Вставить("Организация", СтрокиЭквайринг[0].Организация);
		МассивЭкварйринг.Добавить(СтруктураНастройки);
		
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("МассивЭквайринга", МассивЭкварйринг);
		ПараметрыОткрытияФормы.Вставить("ТекущееРабочееМесто", ТекущееРабочееМесто);
		ПараметрыОткрытияФормы.Вставить("НастройкаЭквайринг", Истина);
		ОбработкаОповещения = Новый ОписаниеОповещения("ЗаполнитьПодключаемоеОборудование", ЭтотОбъект);
		ОткрытьФорму("Обработка.ПомощникНастройкиКассовогоМестаРМК.Форма.ФормаОборудование", ПараметрыОткрытияФормы, ЭтотОбъект,
			,,, ОбработкаОповещения, РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапускатьРМКПриВходе(Команда)
	
	ТекущаяСтрокаДерево = Элементы.ДеревоГруппДоступа.ТекущиеДанные;
	Если ТекущаяСтрокаДерево.Уровень <> 2 Тогда
		СообщениеПользователю = НСтр("ru = 'Настройка запуска не установлена не установлен. Активируйте строку с пользователем.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеПользователю);
		Возврат;
	КонецЕсли;
	ЗапускатьРМКПриСтартеНаСервере(ТекущаяСтрокаДерево.ЭлементДерева);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТорговыйОбъект(Команда)
	ТекущаяСтрокаДерево = Элементы.ДеревоГруппДоступа.ТекущиеДанные;
	Если ТекущаяСтрокаДерево.Уровень <> 2 Тогда
		СообщениеПользователю = НСтр("ru = 'Торговый объект не установлен. Активируйте строку с пользователем.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеПользователю);
		Возврат;
	КонецЕсли;
	Результат = Ложь;
	УстановитьТорговыйОбъектПользователя(ТекущаяСтрокаДерево.ЭлементДерева, Результат);
	
	Если Результат Тогда
		ЗаполнитьДеревоГруппыДоступа();
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ПереключательСтраницПриИзменении(Элемент)
	ПереключитьСтраницу();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СверятьСОФДНажатие(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	НомерЭлемента = Число(СтрЗаменить(НавигационнаяСсылкаФорматированнойСтроки, "ИнтеграцияСОФД_", ""));
	СтрокиКасс = ТаблицаКассККМ.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	
	Если СтрокиКасс.Количество() > 0 Тогда
		НастройкиПодключения = Новый Структура;
		НастройкиПодключения.Вставить("Касса", СтрокиКасс[0].КассаККМ);
		ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьПараметрыПодключенияСверятьСОФД(НастройкиПодключения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СверятьСОФДПриИзменении(Элемент)
	ИмяЭлемента = Элемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяЭлемента, "СверятьОФД_", ""));
	СтрокиКасс = ТаблицаКассККМ.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	
	Если СтрокиКасс.Количество() > 0 Тогда
		СтрукутураИзменяемыхРеквизитов = Новый Структура;
		СтрукутураИзменяемыхРеквизитов.Вставить("СверятьДанныеССервисомОФД", ЭтотОбъект[ИмяЭлемента]);
		СохранитьИзменениеКассыККМ(СтрокиКасс[0].КассаККМ, СтрукутураИзменяемыхРеквизитов);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТорговыйОбъектПриИзменении(Элемент)
	ИзменитьТорговыйОбъект();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ИспользоватьОборудованиеПриИзменении(Элемент)
	ИмяЭлемента = Элемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяЭлемента, "ИспользоватьБезПодключения_", ""));
	СтрокиКасс = ТаблицаКассККМ.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	
	Если СтрокиКасс.Количество() > 0 Тогда
		СтрукутураИзменяемыхРеквизитов = Новый Структура;
		СтрукутураИзменяемыхРеквизитов.Вставить("ИспользоватьБезПодключенияОборудования", ЭтотОбъект[ИмяЭлемента]);
		СтрокиКасс[0].ИспользоватьБезПодключенияОборудования = ЭтотОбъект[ИмяЭлемента];
		СохранитьИзменениеКассыККМ(СтрокиКасс[0].КассаККМ, СтрукутураИзменяемыхРеквизитов);
		
		ИмяРеквизитаПодключитьКассу = СтрШаблон(НСтр("ru = 'ПодключитьКассу_%1'"), НомерЭлемента);
		ЭлементФормы = Элементы.Найти(ИмяРеквизитаПодключитьКассу);
		Если НЕ ЭлементФормы = Неопределено Тогда
			ЭлементФормы.Видимость = Не СтрокиКасс[0].КассаПодключена
				И Не СтрокиКасс[0].ИспользоватьБезПодключенияОборудования;
			
		КонецЕсли;
		
		ИспользоватьБезПодключенияОборудования = СтрокиКасс[0].ИспользоватьБезПодключенияОборудования;
		ДекорацияСтатусИмя = СтрШаблон("ДекорацияСтатус_%1", НомерЭлемента);
		ЭлементФормыСтатус = Элементы.Найти(ДекорацияСтатусИмя);
		Если НЕ ЭлементФормыСтатус = Неопределено Тогда
			ЭлементФормыСтатус.Картинка = ?(ИспользоватьБезПодключенияОборудования, БиблиотекаКартинок.РМКЗеленыйКруг,
				БиблиотекаКартинок.РМККрасныйКруг);
		КонецЕсли;
		КарточкаСтатус = СтрШаблон("КарточкаДекорацииСтатуса_%1", НомерЭлемента);
		ЭлементКарточкаСтатус = Элементы.Найти(КарточкаСтатус);
		Если НЕ ЭлементКарточкаСтатус = Неопределено Тогда
			ЭлементКарточкаСтатус.ЦветФона = ?(ИспользоватьБезПодключенияОборудования, ЦветаФормы.БаннерЗеленыйРМК, ЦветаФормы.БаннерКрасныйРМК);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ИспользоватьОборудованиеЭквайрингПриИзменении(Элемент)
	ИмяЭлемента = Элемент.Имя;
	НомерЭлемента = Число(СтрЗаменить(ИмяЭлемента, "ИспользоватьБезПодключенияЭквайринг_", ""));
	СтрокиЭквайринг = ТаблицаЭквайринговыйТерминал.НайтиСтроки(Новый Структура("НомерЭлемента", НомерЭлемента));
	
	Если СтрокиЭквайринг.Количество() > 0 Тогда
		СтрукутураИзменяемыхРеквизитов = Новый Структура;
		СтрукутураИзменяемыхРеквизитов.Вставить("ИспользоватьБезПодключенияОборудования", ЭтотОбъект[ИмяЭлемента]);
		СохранитьИзменениеЭквайринговыйТерминал(СтрокиЭквайринг[0].ЭквайринговыйТерминал, СтрукутураИзменяемыхРеквизитов);
		СтрокиЭквайринг[0].ИспользоватьБезПодключенияОборудования = ЭтотОбъект[ИмяЭлемента];
		
		ИмяРеквизитаПодключитьЭквайринг = СтрШаблон(НСтр("ru = 'ПодключитьЭквайринг_%1'"), НомерЭлемента);
		ЭлементФормы = Элементы.Найти(ИмяРеквизитаПодключитьЭквайринг);
		Если НЕ ЭлементФормы = Неопределено Тогда
			ЭлементФормы.Видимость = Не СтрокиЭквайринг[0].ЭквайрингПодключен
				И Не СтрокиЭквайринг[0].ИспользоватьБезПодключенияОборудования;
		КонецЕсли;
		
		ИспользоватьБезПодключенияОборудования = СтрокиЭквайринг[0].ИспользоватьБезПодключенияОборудования;
		ДекорацияСтатусИмя = СтрШаблон("ДекорацияСтатусЭквайринг_%1", НомерЭлемента);
		ЭлементФормыСтатус = Элементы.Найти(ДекорацияСтатусИмя);
		Если НЕ ЭлементФормыСтатус = Неопределено Тогда
			ЭлементФормыСтатус.Картинка = ?(ИспользоватьБезПодключенияОборудования, БиблиотекаКартинок.РМКЗеленыйКруг,
				БиблиотекаКартинок.РМККрасныйКруг);
		КонецЕсли;
		КарточкаСтатус = СтрШаблон("КарточкаДекорацииСтатусаЭквайринг_%1", НомерЭлемента);
		ЭлементКарточкаСтатус = Элементы.Найти(КарточкаСтатус);
		Если НЕ ЭлементКарточкаСтатус = Неопределено Тогда
			ЭлементКарточкаСтатус.ЦветФона = ?(ИспользоватьБезПодключенияОборудования, ЦветаФормы.БаннерЗеленыйРМК, ЦветаФормы.БаннерКрасныйРМК);
		КонецЕсли;
	КонецЕсли;
	
	НастройкиРМК.ИспользоватьОплатуПлатежнымиКартами = ЭтотОбъект[ИмяЭлемента];
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиРМКИспользоватьСерверЛояльностиПолучательДанныхПриИзменении(Элемент)
	НастроитьИспользованиеСервераЛояльности();
	УстановитьИзмененностьНастроек();
