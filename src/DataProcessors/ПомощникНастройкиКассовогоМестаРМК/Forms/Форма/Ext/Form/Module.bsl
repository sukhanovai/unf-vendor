&НаКлиенте
Процедура ТекущееРабочееМестоПриИзменении(Элемент)
	ЗаполнитьНастройкуРабочегоМестаКассира();
	ЗаполнитьТаблицуОборудования();
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовДеревоГруппДоступа
&НаКлиенте
Процедура ДеревоГруппДоступаПередРазворачиванием(Элемент, Строка, Отказ)
	ТекущаяСтрока = ДеревоГруппДоступа.НайтиПоИдентификатору(Строка);
	Если ТекущаяСтрока <> Неопределено Тогда
		НайденноеЗначение = СоответствиеСтрокРазвернутая.Получить(ТекущаяСтрока.ЭлементДерева);
		
		Если НайденноеЗначение = Неопределено Тогда
			СоответствиеСтрокРазвернутая.Вставить(ТекущаяСтрока.ЭлементДерева, Строка);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоГруппДоступаПередСворачиванием(Элемент, Строка, Отказ)
	ТекущаяСтрока = ДеревоГруппДоступа.НайтиПоИдентификатору(Строка);
	Если ТекущаяСтрока <> Неопределено Тогда
		СоответствиеСтрокРазвернутая.Удалить(ТекущаяСтрока.ЭлементДерева);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоГруппДоступаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	СтруктураОткрытияФормы = Новый Структура;
	СтруктураОткрытияФормы.Вставить("ГруппаДоступа", Элемент.ТекущиеДанные.ГруппаДоступа);
	СтруктураОткрытияФормы.Вставить("РежимПодбора", Истина);
	ДобавитьПользователяВГруппуДоступаИПрисвоитьКод(СтруктураОткрытияФормы);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоГруппДоступаПриАктивизацииСтроки(Элемент)
	Если РаботаССотрудникамиРМК Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.ДеревоГруппДоступа.ТекущиеДанные;
	МассивСотрудников = Новый Массив;
	Если ТекущиеДанные.Уровень = 3 Тогда
		Элементы.СписокСотрудников.ТекущаяСтрока = ТекущиеДанные.ЭлементДерева;
		МассивСотрудников.Добавить(ТекущиеДанные.ЭлементДерева);
	ИначеЕсли ТекущиеДанные.Уровень = 2 Тогда
		СотрудникиСписок = ТекущиеДанные.ПолучитьЭлементы();
		Для Каждого СтрокаДерева Из СотрудникиСписок Цикл
			МассивСотрудников.Добавить(СтрокаДерева.ЭлементДерева);
		КонецЦикла;
	КонецЕсли;
	УстановитьТекстЗапросаТаблицаСотрудников(МассивСотрудников);
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицаОборудования

&НаКлиенте
Процедура ТаблицаОборудованиеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущаяСтрокаОборудование = Элемент.ТекущиеДанные;
	Если ТекущаяСтрокаОборудование.Уровень = 1 Тогда
		ТекстПредупреждения = НСтр("ru = 'Необходимо выбрать оборудование'");
		ПоказатьПредупреждение(,ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	МассивНастройкиОборудования = Новый Массив;
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("ПодключаемоеОборудование", ТекущаяСтрокаОборудование.ПодключенноеОборудование);
	МассивНастройкиОборудования.Добавить(СтруктураНастройки);
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("МассивНастройкиОборудования", МассивНастройкиОборудования);
	ПараметрыОткрытияФормы.Вставить("ТекущееРабочееМесто", ТекущееРабочееМесто);
	ПараметрыОткрытияФормы.Вставить("ОткрытиеОборудования", Истина);
	
	ОткрытьФорму("Обработка.ПомощникНастройкиКассовогоМестаРМК.Форма.ФормаОборудование", ПараметрыОткрытияФормы, ЭтотОбъект,
		,,,, РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовСписокСотрудников

&НаКлиенте
Процедура СписокСотрудниковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если РаботаССотрудникамиРМК Тогда
		ПроверкаИСозданиеПерсональногоКода();
	Иначе
		ОткрытьФормуСозданияКодаДоступа();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличныйДокументФинал

&НаКлиенте
Процедура ТабличныйДокументФиналВыбор(Элемент, Область, СтандартнаяОбработка)
	Если Область.Имя = "Подсказка" Тогда
		Элементы.СтраницыПомощникаКассовогоМеста.ТекущаяСтраница = Элементы.СтраницаТипыОборудования;
		МассивСтраниц = СписокСтраниц.НайтиСтроки(Новый Структура("ИмяСтраницы", Элементы.СтраницаТипыОборудования.Имя));
		Если МассивСтраниц.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ПереключательСтраниц = МассивСтраниц[0].НомерСтраницы;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПервоначальноеЗаполнение
&НаСервере
Процедура ЗаполнитьДанныеФормы()
	Интерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	ЦветаФормы = ОбщегоНазначенияРМК.ЦветаФормыРМК();
	УстановитьУсловноеОформление();
	ПараметрыВалюты = ОбщегоНазначенияРМК.ПараметрыНациональнойВалюты();
	ВалютаУчета = ПараметрыВалюты.Наименование;
	ТекущееРабочееМесто = МенеджерОборудованияРМК.РабочееМестоКлиента();
	СоздатьГруппыКассККМ();
	
	ЗаполнитьДанныеСтраницыОбмена();
	
	ЗаполнитьИменаСтраниц();
	СоздатьСтраницыПереключатели();
	ПереключательСтраниц = 1;
	
	СоздатьЭкземплярСканераШтрихкода();
	ЗаполнитьТаблицуОборудования();
	ЗаполнитьНастройкуРабочегоМестаКассира();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСтраницыТорговыйОбъект()
	
	ТекстЗапроса = НСтр("ru = ''");
	ДанныеЗаполнены = Ложь;
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьТорговыйОбъект(ТорговыйОбъект, ДанныеЗаполнены);
	Если ДанныеЗаполнены Тогда
		ЗаполнитьКарточкиКассыИЭквайринг();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКарточкиКассыИЭквайринг()
	ТаблицаКассККМ.Очистить();
	ТаблицаЭквайринговыйТерминал.Очистить();
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьДанныеКассККМИЭквайринг(ТаблицаКассККМ, ТаблицаЭквайринговыйТерминал, ТорговыйОбъект);
	Для Каждого СтрокаКасса Из ТаблицаКассККМ Цикл
		ЗаполнитьКарточкиКассККМ(СтрокаКасса);
	КонецЦикла;
		
	Для Каждого СтрокаЭквайринг Из ТаблицаЭквайринговыйТерминал Цикл
		ЗаполнитьКарточкиЭквайринг(СтрокаЭквайринг);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИменаСтраниц()
	НомерСтраницы = 0;
	Для Каждого Элемент Из Элементы.СтраницыПомощникаКассовогоМеста.ПодчиненныеЭлементы Цикл
		Если Элемент.Вид = ВидГруппыФормы.Страница
			И Элемент.Видимость Тогда
			НомерСтраницы = НомерСтраницы + 1;
			НоваяСтрока = СписокСтраниц.Добавить();
			НоваяСтрока.ИмяСтраницы = Элемент.Имя;
			НоваяСтрока.НомерСтраницы = НомерСтраницы;
			НоваяСтрока.Представление = Элемент.Заголовок;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СоздатьСтраницыПереключатели()
	
	Для Каждого СтрокаТаблицы Из СписокСтраниц Цикл
		Элементы.ПереключательСтраниц.СписокВыбора.Добавить(СтрокаТаблицы.НомерСтраницы, СтрокаТаблицы.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУзлыОбмена()

	Результат = Новый Массив;
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьУзлыОбменаРМК(Результат);
	
	Если ЗначениеЗаполнено(Результат) Тогда
		УзелОбмена = Результат[0];
		ЗаполнитьДанныеРасписанияПоУмолчанию();
		РазделениеВключено = ОбщегоНазначения.РазделениеВключено();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеРасписанияПоУмолчанию()
	
	СтруктураДанныхРасписания = Новый Структура;
	СтруктураДанныхРасписания.Вставить("ВидТранспортаОбмена", Неопределено);
	СтруктураДанныхРасписания.Вставить("РасписаниеРегламентногоЗадания", Неопределено);
	
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьРасписаниеПоУмолчаниюОбменРМК(УзелОбмена, СтруктураДанныхРасписания);
	ИдентификаторТранспортаВыгрузкаДанных = СтруктураДанныхРасписания.ВидТранспортаОбмена;
	ИспользоватьРегламентноеЗаданиеВыгрузкаДанных = Истина;
	ШаблонЗаголовкаРасписания = НСтр("ru = '%1 %2'");
	ПредставлениеРасписания = Строка(СтруктураДанныхРасписания.РасписаниеРегламентногоЗадания);
	Если ПредставлениеРасписания = Строка(Новый РасписаниеРегламентногоЗадания) Тогда	
		ПредставлениеРасписания = НСтр("ru = 'Расписание не задано'");
	Иначе
		ЗаголовкаРасписания = НСтр("ru = 'Расписание'");
	КонецЕсли;
	РасписаниеРегламентногоЗаданияВыгрузкаДанных = СтруктураДанныхРасписания.РасписаниеРегламентногоЗадания;
	Элементы.НастроитьРасписаниеРегламентногоЗадания.Заголовок = СтрШаблон(ШаблонЗаголовкаРасписания, ЗаголовкаРасписания, ПредставлениеРасписания);
	
	ИдентификаторТранспортаЗагрузкаДанных = СтруктураДанныхРасписания.ВидТранспортаОбмена;
	ИспользоватьРегламентноеЗаданиеЗагрузкаДанных = Истина;
	ПредставлениеРасписания = Строка(СтруктураДанныхРасписания.РасписаниеРегламентногоЗадания);
	Если ПредставлениеРасписания = Строка(Новый РасписаниеРегламентногоЗадания) Тогда	
		ПредставлениеРасписания = НСтр("ru = 'Расписание не задано'");
	КонецЕсли;
	РасписаниеРегламентногоЗаданияЗагрузкаДанных = СтруктураДанныхРасписания.РасписаниеРегламентногоЗадания;
	Элементы.НастроитьРасписаниеРегламентногоЗагрузкаДанных.Заголовок = СтрШаблон(ШаблонЗаголовкаРасписания, ЗаголовкаРасписания, ПредставлениеРасписания);
	
	РегламентноеЗаданиеРавноОтправке = Истина;
	Элементы.ГруппаПолучениеСообщений.Доступность = Ложь;
	
	СписокВыбора = Новый Структура;
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьСписокВыбораТранспортаОбмена(УзелОбмена, СписокВыбора);
	Элементы.ИдентификаторТранспортаЗагрузкаДанных.СписокВыбора.Очистить();
	Элементы.ИдентификаторТранспортаВыгрузкаДанных.СписокВыбора.Очистить();
	Для Каждого Элемент Из СписокВыбора Цикл
		Элементы.ИдентификаторТранспортаЗагрузкаДанных.СписокВыбора.Добавить(Элемент.Ключ, Элемент.Значение);
		Элементы.ИдентификаторТранспортаВыгрузкаДанных.СписокВыбора.Добавить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПомощникНастройкиОбменаСуществует()
	
	ИмяКлассаМетаданных = "Обработки";
	ИмяОбработки = "ПомощникНастройкиОбмена";
	Возврат МетаданныеСуществуют(ИмяКлассаМетаданных, ИмяОбработки);
	
КонецФункции

&НаСервереБезКонтекста
Функция МетаданныеСуществуют(ИмяКлассаМетаданныхВоМножественномЧисле, ИмяМетаданных)
	
	Результат = Ложь;
	Попытка
		
		КоллекцияМетаданных = Метаданные[ИмяКлассаМетаданныхВоМножественномЧисле];
		Результат = КоллекцияМетаданных.Найти(ИмяМетаданных) <> Неопределено;
		
	Исключение
		
		Результат = Ложь;
		ЗаписьЖурналаРегистрации( НСтр("ru = 'Попытка обращения к несуществующим метаданным'",
			ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Предупреждение,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеСтраницыОбмена()
	ЗаполнитьДанныеСтраницыТорговыйОбъект();
	ЗаполнитьУзлыОбмена();
	ПомощникНастройкиОбменаСуществует = ПомощникНастройкиОбменаСуществует();
	ОбменНастроен = ОбщегоНазначенияРМК.НастройкаСинхронизацииДанныхСуществует();
	
	ДоступныЭлементы = НЕ ОбменНастроен Или НЕ ДанныеЗаполнены Или ДоступноРасписание;
	УстановитьВидимостьЭлементаФормы(Элементы.СтраницаНастройкиОбмена, ДоступныЭлементы);
	Если НЕ ДоступныЭлементы Тогда
		ВыполнятьПервоначальныйОбмен = Ложь;
	КонецЕсли;
	ВыполнятьПервоначальныйОбмен = ВыполнятьПервоначальныйОбмен И НЕ ДанныеЗаполнены;
	УстановитьВидимостьЭлементаФормы(Элементы.ГруппаНастройкаОбмена, НЕ ОбменНастроен И ПомощникНастройкиОбменаСуществует);
	УстановитьВидимостьЭлементаФормы(Элементы.ГруппаРасписаниеОбмена, ОбменНастроен И ДоступноРасписание);
	УстановитьВидимостьЭлементаФормы(Элементы.ГруппаУправлениемРасписаниемОбмена, ОбменНастроен И ДоступноРасписание);
	УстановитьВидимостьЭлементаФормы(Элементы.ГруппаЗагрузкаДанных, НЕ ДанныеЗаполнены И ОбменНастроен);
	УстановитьДоступностьЭлементаФормы(Элементы.ГруппаПереключательСтраниц, ОбменНастроен И ДанныеЗаполнены);
	
	Если ОбменНастроен И ДанныеЗаполнены Тогда
		ЗаполнитьТаблицуСотрудников();
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементаФормы(Элемент, Видимость)
	Элемент.Видимость = Видимость;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементаФормы(Элемент, Доступность)
	Элемент.Доступность = Доступность;
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементыОформления = УсловноеОформление.Элементы;
	ЭлементыОформления.Очистить();
	ЭлементОформления = ЭлементыОформления.Добавить();
	Элемент = ЭлементыОформления.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоГруппДоступа.Имя);
	
	ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Элементы.ДеревоГруппДоступаУровень.ПутьКДанным);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = 1;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтОбычныйПолужирныйРМК);
	
	Элемент = ЭлементыОформления.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаОборудование.Имя);
	
	ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Элементы.ТаблицаОборудованиеУровень.ПутьКДанным);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = 1;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтОбычныйПолужирныйРМК);
	
	Элемент = ЭлементыОформления.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокСотрудников.Имя);
	
	ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Элементы.СписокСотрудниковАктивен.ПутьКДанным);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтОбычныйПолужирныйРМК);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКарточкиКассККМ(СтруктураСозданияКарточки)
	
	ИмяРеквизитаКассаККМ = СтрШаблон(НСтр("ru = 'КассаККМ_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ИмяРеквизитаОрганизация = СтрШаблон(НСтр("ru = 'Организация_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ИмяРеквизитаОстатокВКассе = СтрШаблон(НСтр("ru = 'ОстатокВКассе_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ИмяРеквизитаСверятьОФД = СтрШаблон(НСтр("ru = 'СверятьОФД_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ИмяРеквизитаИспользоватьОборудование = СтрШаблон(НСтр("ru = 'ИспользоватьБезПодключения_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	
	ЭтотОбъект[ИмяРеквизитаКассаККМ] = СтруктураСозданияКарточки.КассаККМ;
	ЭтотОбъект[ИмяРеквизитаОрганизация] = СтруктураСозданияКарточки.Организация;
	ОстатокВКассе = СтрШаблон(НСтр("ru = '%1 %2'"), Формат(СтруктураСозданияКарточки.ОстатокВКассе, "ЧДЦ=2; ЧН=0.00"), ВалютаУчета);
	ЭтотОбъект[ИмяРеквизитаОстатокВКассе] = ОстатокВКассе;
	ЭтотОбъект[ИмяРеквизитаСверятьОФД] = СтруктураСозданияКарточки.СверятьДанныеССервисомОФД;
	ЭтотОбъект[ИмяРеквизитаИспользоватьОборудование] = СтруктураСозданияКарточки.ИспользоватьБезПодключенияОборудования;
	
	ИмяГруппыКассаККМ = СтрШаблон(НСтр("ru = 'ГруппаКассаККМ_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ЭлементФормы = Элементы.Найти(ИмяГруппыКассаККМ);
	Если НЕ ЭлементФормы = Неопределено Тогда
		ЭлементФормы.Видимость = Истина;
		Если НЕ СтруктураСозданияКарточки.КассаПодключена
			И НЕ СтруктураСозданияКарточки.ИспользоватьБезПодключенияОборудования Тогда
			Возврат;
		КонецЕсли;
		
		ДекорацияСтатусИмя = СтрШаблон("ДекорацияСтатус_%1", СтруктураСозданияКарточки.НомерЭлемента);
		ЭлементФормыСтатус = Элементы.Найти(ДекорацияСтатусИмя);
		Если НЕ ЭлементФормыСтатус = Неопределено Тогда
			ЭлементФормыСтатус.Картинка = БиблиотекаКартинок.РМКЗеленыйКруг;
		КонецЕсли;
		КарточкаСтатус = СтрШаблон("КарточкаДекорацииСтатуса_%1", СтруктураСозданияКарточки.НомерЭлемента);
		ЭлементКарточкаСтатус = Элементы.Найти(КарточкаСтатус);
		Если НЕ ЭлементКарточкаСтатус = Неопределено Тогда
			ЭлементКарточкаСтатус.ЦветФона = ЦветаФормы.БаннерЗеленыйРМК;
		КонецЕсли;
	КонецЕсли;
	
	ИмяРеквизитаИспользоватьОборудование = СтрШаблон(НСтр("ru = 'ИспользоватьБезПодключения_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ЭлементФормы = Элементы.Найти(ИмяРеквизитаИспользоватьОборудование);
	Если НЕ ЭлементФормы = Неопределено Тогда
		ЭлементФормы.Доступность = Не СтруктураСозданияКарточки.КассаПодключена;
	КонецЕсли;
	
	ИмяРеквизитаПодключитьКассу = СтрШаблон(НСтр("ru = 'ПодключитьКассу_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ЭлементФормы = Элементы.Найти(ИмяРеквизитаПодключитьКассу);
	Если НЕ ЭлементФормы = Неопределено Тогда
		ЭлементФормы.Видимость = Не СтруктураСозданияКарточки.КассаПодключена
			И Не СтруктураСозданияКарточки.ИспользоватьБезПодключенияОборудования;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКарточкиЭквайринг(СтруктураСозданияКарточки)
	
	ИмяРеквизитаЭквайринговыйТерминал = СтрШаблон(НСтр("ru = 'ЭквайринговыйТерминал_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ИмяРеквизитаОрганизацияЭквайринг = СтрШаблон(НСтр("ru = 'ОрганизацияЭквайринг_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ИмяРеквизитаИспользоватьОборудованиеЭквайринг = СтрШаблон(НСтр("ru = 'ИспользоватьБезПодключенияЭквайринг_%1'"),
		СтруктураСозданияКарточки.НомерЭлемента);
	ИмяРеквизитаКассаККМЭквайринг = СтрШаблон(НСтр("ru = 'КассаККМЭквайринг_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	
	ЭтотОбъект[ИмяРеквизитаЭквайринговыйТерминал] = СтруктураСозданияКарточки.ЭквайринговыйТерминал;
	ЭтотОбъект[ИмяРеквизитаОрганизацияЭквайринг] = СтруктураСозданияКарточки.Организация;
	ЭтотОбъект[ИмяРеквизитаИспользоватьОборудованиеЭквайринг] = СтруктураСозданияКарточки.ИспользоватьБезПодключенияОборудования;
	ЭтотОбъект[ИмяРеквизитаКассаККМЭквайринг] = СтруктураСозданияКарточки.КассаККМ;
	
	ИмяГруппыЭквайринг = СтрШаблон(НСтр("ru = 'ГруппаЭквайринг_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ЭлементФормы = Элементы.Найти(ИмяГруппыЭквайринг);
	Если НЕ ЭлементФормы = Неопределено Тогда
		ЭлементФормы.Видимость = Истина;
		Если НЕ СтруктураСозданияКарточки.ЭквайрингПодключен
			И НЕ СтруктураСозданияКарточки.ИспользоватьБезПодключенияОборудования Тогда
			Возврат;
		КонецЕсли;
		
		ДекорацияСтатусИмя = СтрШаблон("ДекорацияСтатусЭквайринг_%1", СтруктураСозданияКарточки.НомерЭлемента);
		ЭлементФормыСтатус = Элементы.Найти(ДекорацияСтатусИмя);
		Если НЕ ЭлементФормыСтатус = Неопределено Тогда
			ЭлементФормыСтатус.Картинка = БиблиотекаКартинок.РМКЗеленыйКруг;
		КонецЕсли;
		КарточкаСтатус = СтрШаблон("КарточкаДекорацииСтатусаЭквайринг_%1", СтруктураСозданияКарточки.НомерЭлемента);
		ЭлементКарточкаСтатус = Элементы.Найти(КарточкаСтатус);
		Если НЕ ЭлементКарточкаСтатус = Неопределено Тогда
			ЭлементКарточкаСтатус.ЦветФона = ЦветаФормы.БаннерЗеленыйРМК;
		КонецЕсли;
	КонецЕсли;
	
	ИмяРеквизитаПодключитьЭквайринг = СтрШаблон(НСтр("ru = 'ПодключитьЭквайринг_%1'"), СтруктураСозданияКарточки.НомерЭлемента);
	ЭлементФормы = Элементы.Найти(ИмяРеквизитаПодключитьЭквайринг);
	Если НЕ ЭлементФормы = Неопределено Тогда
		ЭлементФормы.Видимость = Не СтруктураСозданияКарточки.ЭквайрингПодключен
			И Не СтруктураСозданияКарточки.ИспользоватьБезПодключенияОборудования;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьГруппыКассККМ()
	НомерПоПорядку = 0;
	Для НомерЭлемента = 1 По 3 Цикл
		НомерПоПорядку = НомерПоПорядку + 1;
		
		ИмяГруппыКассаККМ = СтрШаблон(НСтр("ru = 'ГруппаКассаККМ_%1'"), НомерПоПорядку);
		НоваяГруппаКарточка = Элементы.Добавить(ИмяГруппыКассаККМ, Тип("ГруппаФормы"), Элементы.ГруппаРядКассыККМ);
		НоваяГруппаКарточка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		НоваяГруппаКарточка.Отображение = ОтображениеОбычнойГруппы.Нет;
		НоваяГруппаКарточка.ОтображатьЗаголовок = Ложь;
		НоваяГруппаКарточка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		НоваяГруппаКарточка.ОтображатьКакКарточку = Истина;
		НоваяГруппаКарточка.РастягиватьПоГоризонтали = Истина;
		НоваяГруппаКарточка.Видимость = Ложь;
		
		ДобавляемыеРеквизиты = Новый Массив;
		ТипРеквизита = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.КассаККМРМК.Тип);
