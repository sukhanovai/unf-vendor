&НаКлиенте
Процедура ПодключитьАссистента()
	
	Если АссистентПодключен Тогда
		Возврат;
	КонецЕсли;

	ПодключитьАссистентаНаСервере();
	АссистентУправленияКлиент.Подключить();
	
КонецПроцедуры

&НаСервере
Процедура ПодключитьАссистентаНаСервере()
	
	Если АссистентПодключен Тогда
		Возврат;
	КонецЕсли;
	
	АссистентУправления.Подключить();
	
	АссистентПодключен = АссистентУправления.Подключен();
	
	УправлениеФормой();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакиВРаботе(ИдентификаторГруппы = Неопределено)
	
	ОтборПоГруппе = Ложь;
	
	Если ИдентификаторГруппы = Неопределено Тогда
		ОтборПоГруппе = Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗадачиАссистента.Родитель КАК Родитель,
	|	ЗадачиАссистента.Используется КАК Используется
	|ПОМЕСТИТЬ ИспользуемыеГруппыЗадач
	|ИЗ
	|	Справочник.ЗадачиАссистентаУправления КАК ЗадачиАссистента
	|ГДЕ
	|	ЗадачиАссистента.ПометкаУдаления = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗадачиАссистента.Родитель,
	|	ЗадачиАссистента.Используется
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗадачиАссистента.ИдентификаторГруппы КАК ИдентификаторГруппы,
	|	ИспользуемыеГруппыЗадач.Используется КАК Используется
	|ИЗ
	|	ИспользуемыеГруппыЗадач КАК ИспользуемыеГруппыЗадач
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗадачиАссистентаУправления КАК ЗадачиАссистента
	|		ПО ИспользуемыеГруппыЗадач.Родитель = ЗадачиАссистента.Ссылка
	|ГДЕ
	|	(&ОтборПоГруппе
	|			ИЛИ ЗадачиАссистента.ИдентификаторГруппы = &ИдентификаторГруппы)";
	
	Запрос.УстановитьПараметр("ОтборПоГруппе", ОтборПоГруппе);
	Запрос.УстановитьПараметр("ИдентификаторГруппы", ИдентификаторГруппы);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		
		ЭлементВРаботе = Элементы.Найти("ВРаботе_"+Выборка.ИдентификаторГруппы);
		
		Если ЭлементВРаботе = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЭлементВРаботе.Видимость = Выборка.Используется;
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПриОплате" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзмениСостояниеПриОплате.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОплате85Цвет;	
			Иначе
				Элементы.КартинкаИзмениСостояниеПриОплате.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОплате85ЧБ;	
			КонецЕсли;
			Продолжить;				
		КонецЕсли;
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПриОтгрузке" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзменениеСостоянияОтгрузка.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОтгрузке85Цвет;	
			Иначе
				Элементы.КартинкаИзменениеСостоянияОтгрузка.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОтгрузке85ЧБ;	
			КонецЕсли;
			Продолжить;				
		КонецЕсли;
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПриОплатеИОтгрузке" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзменениеСостоянияОплатаИОтгрузка.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОплатеИОтгрузке85Цвет;	
			Иначе
				Элементы.КартинкаИзменениеСостоянияОплатаИОтгрузка.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОплатеИОтгрузке85ЧБ;	
			КонецЕсли;
			Продолжить;				
		КонецЕсли;
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПокупателяПоСостояниюЗаказовПоставщикам" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзмениСостояниеЗаказПокупателяЗаказПоставщику.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеЗакупки85Цвет;	
			Иначе
				Элементы.КартинкаИзмениСостояниеЗаказПокупателяЗаказПоставщику.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеЗакупки85ЧБ;	
			КонецЕсли;
			Продолжить;				
		КонецЕсли;
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПокупателяПоСостояниюЗаказовНаПроизводство" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзмениСостояниеЗаказПокупателяЗаказНаПроизводство.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПроизводство85Цвет;	
			Иначе
				Элементы.КартинкаИзмениСостояниеЗаказПокупателяЗаказНаПроизводство.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПроизводство85ЧБ;	
			КонецЕсли; 
			Продолжить;				
		КонецЕсли;
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПокупателяПоСостояниюЗаказовПоставщикамИНаПроизводство" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзмениСостояниеЗаказПокупателяЗаказПоставщикуИНаПроизводство.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПроизводствоИЗакупки85Цвет;	
			Иначе
				Элементы.КартинкаИзмениСостояниеЗаказПокупателяЗаказПоставщикуИНаПроизводство.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПроизводствоИЗакупки85ЧБ;	
			КонецЕсли;
			Продолжить;				
		КонецЕсли;
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПоставщикуПриОплате" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзмениСостояниеЗаказПоставщикуПриОплате.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОплате85Цвет;	
			Иначе
				Элементы.КартинкаИзмениСостояниеЗаказПоставщикуПриОплате.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОплате85ЧБ;	
			КонецЕсли;
			Продолжить;				
		КонецЕсли;                
		            
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПоставщикуПриПоставке" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзменениеСостоянияПоставка.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОтгрузке85Цвет;	
			Иначе
				Элементы.КартинкаИзменениеСостоянияПоставка.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОтгрузке85ЧБ;	
			КонецЕсли;
			Продолжить;				
		КонецЕсли;
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПоставщикуПриОплатеИПоставке" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзменениеСостоянияОплатаИПоставка.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОплатеИОтгрузке85Цвет;	
			Иначе
				Элементы.КартинкаИзменениеСостоянияОплатаИПоставка.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПриОплатеИОтгрузке85ЧБ;	
			КонецЕсли; 
			Продолжить;				
		КонецЕсли;      
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаПоставщикуПоСостояниюЗаказовПокупателей" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзменениеСостоянияЗаказПоставщикуЗаказПокупателя.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПродажи85Цвет;	
			Иначе
				Элементы.КартинкаИзменениеСостоянияЗаказПоставщикуЗаказПокупателя.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПродажи85ЧБ;	
			КонецЕсли;
			Продолжить;	
		КонецЕсли;   
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаНаПроизводствоПриВыполнении" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзмениСостояниеЗаказаНаПроизводствоПриВыполнении.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПроизводство85Цвет;	
			Иначе
				Элементы.КартинкаИзмениСостояниеЗаказаНаПроизводствоПриВыполнении.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПроизводство85ЧБ;	
			КонецЕсли;
			Продолжить;						
		КонецЕсли;   
		
		Если Выборка.ИдентификаторГруппы = "ИзменениеСостоянияЗаказаНаПроизводствоПоСостояниюЗаказовПокупателей" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаИзменениеСостоянияЗаказНаПроизводствоЗаказПокупателя.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПродажи85Цвет;	
			Иначе
				Элементы.КартинкаИзменениеСостоянияЗаказНаПроизводствоЗаказПокупателя.Картинка = БиблиотекаКартинок.АссистентУправленияИзменитьСостояниеПродажи85ЧБ;	
			КонецЕсли;  
			Продолжить;						
		КонецЕсли;                
		            
		Если Выборка.ИдентификаторГруппы = "ОповещениеПользователяПриОплатеЗаказа" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаОповещениеПользователяПриОплатеЗаказа.Картинка = БиблиотекаКартинок.АссистентУправленияСообщениеПриОплатеЗаказа85Цвет;	
			Иначе
				Элементы.КартинкаОповещениеПользователяПриОплатеЗаказа.Картинка = БиблиотекаКартинок.АссистентУправленияСообщениеПриОплатеЗаказа85ЧБ;	
			КонецЕсли;
			Продолжить;						
		КонецЕсли; 
		
		Если Выборка.ИдентификаторГруппы = "ОповещениеПользователяПриОтгрузкеЗаказа" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаОповещениеПользователяПриОтгрузкеЗаказа.Картинка = БиблиотекаКартинок.АссистентУправленияСообщениеПриОтгрузкеЗаказа85Цвет;	
			Иначе
				Элементы.КартинкаОповещениеПользователяПриОтгрузкеЗаказа.Картинка = БиблиотекаКартинок.АссистентУправленияСообщениеПриОтгрузкеЗаказа85ЧБ;	
			КонецЕсли;
			Продолжить;						
		КонецЕсли;      
		
		Если Выборка.ИдентификаторГруппы = "ОповещениеПользователяПриОтгрузкеИОплатеЗаказа" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаОповещениеПользователяПриОтгрузкеОплатеЗаказа.Картинка = БиблиотекаКартинок.АссистентУправленияСообщениеПриОтгрузкеИОплате85Цвет;	
			Иначе
				Элементы.КартинкаОповещениеПользователяПриОтгрузкеОплатеЗаказа.Картинка = БиблиотекаКартинок.АссистентУправленияСообщениеПриОтгрузкеИОплате85ЧБ;	
			КонецЕсли;
			Продолжить;						
		КонецЕсли;  
		
		Если Выборка.ИдентификаторГруппы = "ОповещениеЗаказуПокупателяПоСостояниюЗаказовПоставщикам" Тогда
			Если Выборка.Используется = Истина Тогда    
				Элементы.КартинкаОповещениеЗаказаПокупателяПоЗаказамПоставщикам.Картинка = БиблиотекаКартинок.АссистентУправленияСообщениеЗакупки85Цвет;	
			Иначе
				Элементы.КартинкаОповещениеЗаказаПокупателяПоЗаказамПоставщикам.Картинка = БиблиотекаКартинок.АссистентУправленияСообщениеЗакупки85ЧБ;	
			КонецЕсли; 
			Продолжить;						
		КонецЕсли;   
		
		Если Выборка.ИдентификаторГруппы = "ОповещениеЗаказуПокупателяПоСостояниюЗаказовНаПроизводство" Тогда
			Если Выборка.Используется = Истина Тогда    
