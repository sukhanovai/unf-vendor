#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация = Параметры.Организация;
	ОтчетныйПериод = Параметры.ОтчетныйПериод;

	МаксимальнаяСуммаВзноса = Цел(Параметры.МаксимальнаяСуммаВзноса);
	УменьшеноРанее = Параметры.УменьшеноРанее;
	СуммаВзносаДляУменьшенияПСН = Параметры.ВыбраннаяСуммаВзноса;
	ИспользоватьВсюСумму = Параметры.СуммаВзносаСкорректирована;
	
	ВзносПоЕдиномуТарифу = Параметры.ВзносПоЕдиномуТарифу;
	ВзносСДоходов = Параметры.ВзносСдоходов;
	ВзносСДоходовПредыдущийГод = Параметры.ВзносСДоходовПредыдущийГод;
	ВзносСДоходовТекущийГод = Параметры.ВзносСДоходовТекущийГод;
	ДоляДоходовПоПатенту = Параметры.ДоляДоходовПоПатенту;
	ВзносыИспользованныеДляУСН = Параметры.ВзносыИспользованныеДляУСН;  
	СобытиеВзносПоЕдиномуТарифу = Параметры.СобытиеВзносПоЕдиномуТарифу;
	СобытиеВзносСДоходов = Параметры.СобытиеВзносСДоходов;
	
	Элементы.СуммаВзносаДляУменьшенияПСН.Доступность = ИспользоватьВсюСумму;
	
	ЗаполнитьТаблицуРезультатРасчета();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВзносПоЕдиномуТарифуНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ЗначениеЗаполнено(СобытиеВзносПоЕдиномуТарифу) Тогда
		Результат = РегламентированнаяОтчетностьУСНКлиент.ОбработатьСобытиеКалендаря(
		Организация, СобытиеВзносПоЕдиномуТарифу);

		ПараметрыФормы = Новый Структура("Организация,СобытиеКалендаря", Организация, СобытиеВзносПоЕдиномуТарифу);
		ОткрытьФорму(Результат.ИмяФормыРезультата, ПараметрыФормы, ЭтотОбъект, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВзносСДоходовТекущийГодНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ЗначениеЗаполнено(СобытиеВзносСДоходов) Тогда
		Результат = РегламентированнаяОтчетностьУСНКлиент.ОбработатьСобытиеКалендаря(
		Организация, СобытиеВзносСДоходов);

		ПараметрыФормы = Новый Структура("Организация,СобытиеКалендаря", Организация, СобытиеВзносСДоходов);
		ОткрытьФорму(Результат.ИмяФормыРезультата, ПараметрыФормы, ЭтотОбъект, , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьВсюСуммуПриИзменении(Элемент)
	
	Если Не ИспользоватьВсюСумму Тогда
		СуммаВзносаДляУменьшенияПСН = МаксимальнаяСуммаВзноса;
		Элементы.ДекорацияОшибка.Видимость = Ложь;  
	КонецЕсли;
	Модифицированность = Истина;
	
	Элементы.СуммаВзносаДляУменьшенияПСН.Доступность = ИспользоватьВсюСумму;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПроверитьВведеннуюСумму();
	Если УказанаНеПравильнаяСумма Тогда
		//ТекущийЭлемент = Элементы.СуммаВзносаДляУменьшенияПСН;
		Возврат;
	КонецЕсли;
	
	ЗаписатьИЗакрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьВведеннуюСумму()

	Если Цел(СуммаВзносаДляУменьшенияПСН) > МаксимальнаяСуммаВзноса Тогда
		Элементы.ДекорацияОшибка.Заголовок = НСтр("ru ='Сумма не может быть больше суммы взносов.'");
		УказанаНеПравильнаяСумма = Истина;
	ИначеЕсли Цел(СуммаВзносаДляУменьшенияПСН) < УменьшеноРанее Тогда
		Элементы.ДекорацияОшибка.Заголовок = НСтр("ru ='Сумма не может быть меньше, чем уменьшено ранее.'");
		УказанаНеПравильнаяСумма = Истина;
	Иначе
		УказанаНеПравильнаяСумма = Ложь;
	КонецЕсли;
	Элементы.ДекорацияОшибка.Видимость = УказанаНеПравильнаяСумма;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть()

	Если ЗаписатьДанные() Тогда
		
		Если Модифицированность Тогда
			ПараметрыОповещения = Новый Структура;
			ПараметрыОповещения.Вставить("Организация", Организация);
			ПараметрыОповещения.Вставить("Период", ОтчетныйПериод);
				
			Оповестить("Запись_УменьшениеПСННаФиксированныеВзносы", ПараметрыОповещения, ЭтотОбъект);
		КонецЕсли;

		Модифицированность = Ложь;
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьДанные()
	
	Если Не Модифицированность Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если МаксимальнаяСуммаВзноса <> СуммаВзносаДляУменьшенияПСН Тогда
		МенеджерЗаписи = РегистрыСведений.УменьшениеНалогаНаВзносыПодлежащиеУплате.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = НачалоКвартала(КонецГода(ОтчетныйПериод));
		МенеджерЗаписи.Организация = Организация;
		МенеджерЗаписи.Сумма = СуммаВзносаДляУменьшенияПСН;
		МенеджерЗаписи.ДеятельностьНаПатенте = Истина;
		МенеджерЗаписи.Записать(Истина);
	ИначеЕсли Не ИспользоватьВсюСумму Тогда
		ОчиститьЗаписиРегистра();
	Иначе
		Модифицированность = Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ОчиститьЗаписиРегистра()
	
	СуммаВзносаДляУменьшенияПСН = МаксимальнаяСуммаВзноса;
	
	МенеджерЗаписи = РегистрыСведений.УменьшениеНалогаНаВзносыПодлежащиеУплате.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = НачалоКвартала(КонецГода(ОтчетныйПериод));
	МенеджерЗаписи.Организация = Организация;
	МенеджерЗаписи.ДеятельностьНаПатенте = Истина;
	МенеджерЗаписи.Удалить();
	
КонецПроцедуры

#Область Интерфейс85
Процедура ЗаполнитьТаблицуРезультатРасчета() 
	
	// Взносы    
	//ДобавитьСтрокуВТаблицуРасчеты("Доля доходов по патенту'", ДоляДоходовПоПатенту , ДоляДоходовПоПатенту); 
	    
    ДобавитьСтрокуВТаблицуРасчеты("Остаток за прошлый год", ВзносСДоходовПредыдущийГод, ВзносСДоходовПредыдущийГод); 
	ДобавитьСтрокуВТаблицуРасчеты("Единый тариф", ВзносПоЕдиномуТарифу, ВзносПоЕдиномуТарифу); 
	ДобавитьСтрокуВТаблицуРасчеты("С доходов", ВзносСДоходовТекущийГод, ВзносСДоходовТекущийГод);   
	
	СуммаВзносаРасчетная = Цел((ВзносПоЕдиномуТарифу + ВзносСДоходов) * ДоляДоходовПоПатенту / 100);
	ФорматЧиселВПояснении = НСтр("ru = 'ЧДЦ=0; ЧН=0; ЧГ=3,0'");
	
	Если СуммаВзносаРасчетная > МаксимальнаяСуммаВзноса И ВзносыИспользованныеДляУСН <> 0 Тогда
		ОсновнойТекст = НСтр("ru = 'Всего = Остаток за прошлый год" +  Символы.ПС + "Единый тариф + " + Символы.ПС + "С доходов - Использовано для УСН'");
		ДополнительныйТекст = СтрШаблон("%1 + %2 +" + Символы.ПС + " %3 - %4",
			Формат(ВзносСДоходовПредыдущийГод, ФорматЧиселВПояснении),
			Формат(ВзносПоЕдиномуТарифу, ФорматЧиселВПояснении),
			Формат(ВзносСДоходовТекущийГод, ФорматЧиселВПояснении),
			Формат(ВзносыИспользованныеДляУСН, ФорматЧиселВПояснении));   
	Иначе
		Если ДоляДоходовПоПатенту < 100 Тогда
			ОсновнойТекст = НСтр("ru = 'Всего = (Остаток за прошлый год " + Символы.ПС + "+ Единый тариф + С доходов) " + Символы.ПС + " * Доля доходов по патенту'");
			ДополнительныйТекст = СтрШаблон("(%1 + %2 "+ Символы.ПС + "+ %3) * %4%%",
				Формат(ВзносСДоходовПредыдущийГод, ФорматЧиселВПояснении),
				Формат(ВзносПоЕдиномуТарифу, ФорматЧиселВПояснении),
				Формат(ВзносСДоходовТекущийГод, ФорматЧиселВПояснении),
				Формат(ДоляДоходовПоПатенту, НСтр("ru = 'ЧДЦ=2; ЧН=0; ЧГ=3,0'")));
		Иначе
			ОсновнойТекст = НСтр("ru = 'Всего = Остаток за прошлый год + Единый тариф + С доходов'");
			ДополнительныйТекст = СтрШаблон("%1 + %2 + %3",
				Формат(ВзносСДоходовПредыдущийГод, ФорматЧиселВПояснении),
				Формат(ВзносПоЕдиномуТарифу, ФорматЧиселВПояснении),
				Формат(ВзносСДоходовТекущийГод, ФорматЧиселВПояснении));
		КонецЕсли;
	КонецЕсли;
																		
	ДобавитьСтрокуВТаблицуРасчеты(ОсновнойТекст, ДополнительныйТекст, МаксимальнаяСуммаВзноса);
	
	СимволRUB = Справочники.Валюты.НайтиПоКоду("643").СимвольноеПредставление;
	Элементы.ТаблицаРасчетыГруппа.Заголовок = 
	"Расчеты, " + СимволRUB;  
	Элементы.ТаблицаРасчетыРезультат.Заголовок = 
	"Результат, " + СимволRUB; 
	
КонецПроцедуры

Процедура ДобавитьСтрокуВТаблицуРасчеты(Описание, Расчеты, Результат)
	
	СтрокаРезультата = ТаблицаРасчеты.Добавить();  
	СтрокаРезультата.Описание = СокрЛП(Строка(Описание));
	СтрокаРезультата.Расчеты = СокрЛП(Строка(Формат(Расчеты, "ЧДЦ=2; ЧН=")));  
    СтрокаРезультата.Результат = Результат;
	
КонецПроцедуры 

&НаКлиенте
Процедура ТаблицаРасчетыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Элемент.ТекущиеДанные.Описание = "Единый тариф" Тогда
		ВзносПоЕдиномуТарифуНажатие(Элемент, СтандартнаяОбработка);
	ИначеЕсли Элемент.ТекущиеДанные.Описание = "С доходов" Тогда
		ВзносСДоходовТекущийГодНажатие(Элемент, СтандартнаяОбработка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти