#КонецОбласти

&НаКлиенте
Процедура УправлениеКоманднойПанелиФормы()	
	
	ИмяСтраницы = Элементы.СтраницаДекларация.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "ОтчетЕФС_1" Тогда
		Элементы.НавигацияНачало.Видимость = Истина;   
		Элементы.НавигацияОкончание.Видимость = Ложь;
		Элементы.НавигацияОзнакомится.Видимость = Ложь;   
		Элементы.НавигацияЗадачаПроверена.Видимость = Ложь;
	ИначеЕсли ИмяСтраницы = "ЗадачаВыполненаЕФС_1" Тогда
		Элементы.НавигацияНачало.Видимость = Ложь;   
		Элементы.НавигацияОкончание.Видимость = Истина;
		Элементы.НавигацияОзнакомится.Видимость = Ложь;   
		Элементы.НавигацияЗадачаПроверена.Видимость = Ложь;
		
		Элементы.Закрыть.КнопкаПоУмолчанию = Истина;
		Элементы.Закрыть.Важность = ВажностьКнопки.Главная;
		
	ИначеЕсли ИмяСтраницы = "ЗадачаОзнакомитьсяЕФС_1" Тогда
		Элементы.НавигацияНачало.Видимость = Ложь;   
		Элементы.НавигацияОкончание.Видимость = Ложь;
		Элементы.НавигацияОзнакомится.Видимость = Истина;   
		Элементы.НавигацияЗадачаПроверена.Видимость = Ложь;
	ИначеЕсли ИмяСтраницы = "ЗадачаПроверенаЕФС_1" Тогда
		Элементы.НавигацияНачало.Видимость = Ложь;   
		Элементы.НавигацияОкончание.Видимость = Ложь;
		Элементы.НавигацияОзнакомится.Видимость = Ложь;   
		Элементы.НавигацияЗадачаПроверена.Видимость = Истина;		
		Элементы.Далее.КнопкаПоУмолчанию = Истина;
		Элементы.Далее.Важность = ВажностьКнопки.Главная;

	Иначе
		Элементы.НавигацияНачало.Видимость = Ложь;   
		Элементы.НавигацияОкончание.Видимость = Ложь;
		Элементы.НавигацияОзнакомится.Видимость = Ложь;   
		Элементы.НавигацияЗадачаПроверена.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры


