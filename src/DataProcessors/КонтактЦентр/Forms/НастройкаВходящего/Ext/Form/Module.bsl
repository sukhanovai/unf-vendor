&НаСервере
Функция ИзменитьПорядокЗаписей(Запись, Порядок, НаправлениеИзменения)
	
	ТекущаяКолонка = Запись;
	ПредыдущаяКолонка = ПредыдущаяКолонка(Порядок + НаправлениеИзменения);
	
	Если НЕ ЗначениеЗаполнено(ПредыдущаяКолонка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПорядокПредыдущейКолонки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПредыдущаяКолонка, "Порядок");
	Если ПорядокПредыдущейКолонки = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		
		ТекущаяКолонкаОбъект    = ТекущаяКолонка.ПолучитьОбъект();
		ТекущаяКолонкаОбъект.Заблокировать();
		ПредыдущаяКолонкаОбъект = ПредыдущаяКолонка.ПолучитьОбъект();
		ПредыдущаяКолонкаОбъект.Заблокировать();
		ПредыдущаяКолонкаОбъект.Порядок = ТекущаяКолонкаОбъект.Порядок;
		ТекущаяКолонкаОбъект.Порядок = ТекущаяКолонкаОбъект.Порядок + НаправлениеИзменения;
		
		ТекущаяКолонкаОбъект.Записать();
		ТекущаяКолонкаОбъект.Разблокировать();
		ПредыдущаяКолонкаОбъект.Записать();
		ПредыдущаяКолонкаОбъект.Разблокировать();
		
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПредыдущаяКолонка(Порядок)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КолонкиКалендарейСотрудников.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КолонкиКалендарейСотрудников КАК КолонкиКалендарейСотрудников
	|ГДЕ
	|	КолонкиКалендарейСотрудников.Порядок = &Порядок И КолонкиКалендарейСотрудников.Владелец = &ТекущаяДоска";
	
	Запрос.УстановитьПараметр("Порядок", Порядок);
	Запрос.УстановитьПараметр("ТекущаяДоска", ТекущаяДоска);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Справочники.КолонкиКалендарейСотрудников.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура НастройкаКаналовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	УправлениеФормой();
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	ВидСписок    = 0;
	ВидКанбан    = 1;
	ВидКалендарь = 2;
	
	Если ВидКонтактЦентра = ВидСписок ИЛИ ВидКонтактЦентра = ВидКанбан Тогда
		Элементы.ГруппаСтраницыНастроек.ТекущаяСтраница = Элементы.ГруппаВходящее;
	ИначеЕсли ВидКонтактЦентра = ВидКалендарь Тогда
		Элементы.ГруппаСтраницыНастроек.ТекущаяСтраница = Элементы.ГруппаКалендарь;
	Иначе
		Элементы.ГруппаСтраницыНастроек.ТекущаяСтраница = Элементы.ГруппаДоски;
	КонецЕсли;
	
	РазрешеноПодключатьКаналы = Пользователи.ЭтоПолноправныйПользователь();
	
	УстановитьПривилегированныйРежим(Истина);
	Подключено_Телефония = КонтактЦентр.ПодключенаТелефония();
	Подключено_Почта     = КонтактЦентр.ПодключенаПочта();
	Подключено_КабинетКлиента = КонтактЦентр.ПодключенКабинетКлиента();
	Подключено_Телеграм = КонтактЦентр.ПодключенТелеграм();
	Подключено_ВКонтакте = КонтактЦентр.ПодключенВКонтакте();
	УстановитьПривилегированныйРежим(Ложь);

	УстановитьПризнакиПодключенияКаналов();

	МассивГрупп = Новый Массив;
	МассивГрупп.Добавить("Телефония");
	МассивГрупп.Добавить("Почта");
	МассивГрупп.Добавить("Телеграм");
	МассивГрупп.Добавить("ВКонтакте");
	МассивГрупп.Добавить("КабинетКлиента");
	
	Если ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85() <> Истина Тогда
		Для Каждого ГруппаОбертка Из МассивГрупп Цикл
			Элементы[ГруппаОбертка].ЦветФона = ЦветаПалитры.Серый;
			Элементы["Группа" + ГруппаОбертка].ЦветФона = ЦветаПалитры.БелыйУНФ;
			Элементы["Команда" + ГруппаОбертка].Видимость = Истина;
			Элементы["Декорация" + ГруппаОбертка].Видимость = Ложь;
		КонецЦикла;
	Иначе
		Для Каждого ГруппаОбертка Из МассивГрупп Цикл
			Элементы["Команда" + ГруппаОбертка].Видимость = Ложь;
			Элементы["Декорация" + ГруппаОбертка].Видимость = Истина;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакиПодключенияКаналов()
	
	Реквизиты = ПолучитьРеквизиты();
	Для Каждого Реквизит Из Реквизиты Цикл
		Если СтрНайти(Реквизит.Имя, "Подключено") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Канал = Прав(Реквизит.Имя, СтрДлина(Реквизит.Имя) - СтрНайти(Реквизит.Имя, "_"));
		//Элементы["ВРаботе_" + Канал].Видимость = ЭтотОбъект[Реквизит.Имя];
		Если Канал = "Телефония" Тогда
			Если ЭтотОбъект[Реквизит.Имя] = Истина Тогда
				Элементы.КартинкаТелефония.Картинка = БиблиотекаКартинок.КонтактЦентрТелефония85Цвет;
			Иначе
				Элементы.КартинкаТелефония.Картинка = БиблиотекаКартинок.КонтактЦентрТелефония85ЧБ;
			КонецЕсли;   
			Продолжить;
		КонецЕсли;
		Если Канал = "Почта" Тогда
			Если ЭтотОбъект[Реквизит.Имя] = Истина Тогда
				Элементы.КартинкаПочта.Картинка = БиблиотекаКартинок.КонтактЦентрПочта85Цвет;
			Иначе
				Элементы.КартинкаПочта.Картинка = БиблиотекаКартинок.КонтактЦентрПочта85ЧБ;
			КонецЕсли;   
			Продолжить;
		КонецЕсли;
		Если Канал = "Телеграм" Тогда
			Если ЭтотОбъект[Реквизит.Имя] = Истина Тогда
				Элементы.КартинкаТелеграм.Картинка = БиблиотекаКартинок.КонтактЦентрТелеграм85Цвет;
			Иначе
				Элементы.КартинкаТелеграм.Картинка = БиблиотекаКартинок.КонтактЦентрТелеграм85ЧБ;
			КонецЕсли;   
			Продолжить;
		КонецЕсли;
		Если Канал = "ВКонтакте" Тогда
			Если ЭтотОбъект[Реквизит.Имя] = Истина Тогда
				Элементы.КартинкаВКонтакте.Картинка = БиблиотекаКартинок.КонтактЦентрВконтакте85Цвет;
			Иначе
				Элементы.КартинкаВКонтакте.Картинка = БиблиотекаКартинок.КонтактЦентрВКонтакте85ЧБ;
			КонецЕсли;   
			Продолжить;
		КонецЕсли;
		Если Канал = "КабинетКлиента" Тогда
			Если ЭтотОбъект[Реквизит.Имя] = Истина Тогда
				Элементы.КартинкаКабинетКлиента.Картинка = БиблиотекаКартинок.КабинетКлиентаИконка;
			Иначе
				Элементы.КартинкаКабинетКлиента.Картинка = БиблиотекаКартинок.КабинетКлиентаИконка85ЧБ;
			КонецЕсли;   
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПерваяКолонка()
	Возврат Справочники.КолонкиКалендарейСотрудников.КолонкаНеобработанное(ТекущаяДоска);
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформлениеСписка()
	
	ПерваяКолонкаКалендаря = ПерваяКолонка();
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(НовоеУсловноеОформление.Отбор, 
		"КолонкиТекущейДоски.Ссылка", 
		ПерваяКолонкаКалендаря, 
		ВидСравненияКомпоновкиДанных.Равно);
	РаботаСФормой.ДобавитьОформляемоеПоле(НовоеУсловноеОформление, Элементы["КолонкиТекущейДоскиНаименование"].Имя);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "Шрифт", ШрифтыСтиля.ЗаголовокЧетвертогоУровня);
	
	НовоеУсловноеОформление = УсловноеОформление.Элементы.Добавить();
	РаботаСФормой.ДобавитьЭлементОтбораКомпоновкиДанных(НовоеУсловноеОформление.Отбор, 
		"КолонкиТекущейДоски.Ссылка", 
		ПерваяКолонкаКалендаря, 
		ВидСравненияКомпоновкиДанных.Равно);
	РаботаСФормой.ДобавитьОформляемоеПоле(НовоеУсловноеОформление, Элементы["КолонкиТекущейДоскиНаименование"].Имя);
	РаботаСФормой.ДобавитьЭлементУсловногоОформления(НовоеУсловноеОформление, "ЦветТекста", ЦветаПалитры.Серый);
	
КонецПроцедуры

