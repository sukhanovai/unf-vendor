
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВыполнитьПроверкуПравДоступа("СохранениеДанныхПользователя", Метаданные);
	
	Элементы.ВариантИнтерфейса.СписокВыбора.Добавить("Такси", НСтр("ru = 'Интерфейс ""Такси""'"));
	Элементы.ВариантИнтерфейса.СписокВыбора.Добавить("Версия8_5", НСтр(
		"ru = 'Интерфейс ""Версия 8.5""'"));
	
	НастройкиКлиентскогоПриложения = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(
		"Общее/НастройкиКлиентскогоПриложения", "");
	Если НастройкиКлиентскогоПриложения.ВариантИнтерфейсаКлиентскогоПриложения
		= ВариантИнтерфейсаКлиентскогоПриложения.Версия8_5 Тогда
		ВариантИнтерфейса = "Версия8_5";
	Иначе
		ВариантИнтерфейса = "Такси";
	КонецЕсли;
	
	ТекущийВариантИнтерфейса = ВариантИнтерфейса;
	
	Элементы.ВариантИнтерфейса.Подсказка = "";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантИнтерфейсаПриИзменении(Элемент)
	
	ТекущийИнтерфейс85 = ТекущийВариантИнтерфейса = "Версия8_5";
	
	Если ТекущийИнтерфейс85 И ВариантИнтерфейса = "Такси"
		Или Не ТекущийИнтерфейс85 И ВариантИнтерфейса = "Версия8_5" Тогда
		ТекстПодсказки = НСтр("ru = 'Выбранный интерфейс будет включен после перезапуска приложения'");
		Элементы.ФормаЗаписать.Доступность = Истина;
		Элементы.ПерезапуститьПриложение.Доступность = Истина;
	Иначе
		ТекстПодсказки = "";
		Модифицированность = Ложь;
		Элементы.ФормаЗаписать.Доступность = Ложь;
		Элементы.ПерезапуститьПриложение.Доступность = Ложь;
	КонецЕсли;
	
	Элементы.ВариантИнтерфейса.Подсказка = ТекстПодсказки;
	
	Если ОпросУжеПроизведен() Тогда
		Возврат;
	КонецЕсли;
	
	Если ВариантИнтерфейса = "Такси" И ТекущийИнтерфейс85 Тогда
		ОткрытьФорму("Обработка.ПерсональныеНастройки.Форма.ВозвратНаТакси");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерезапуститьПриложение(Команда)
	
	СохранитьНастройки();
	ЗавершитьРаботуСистемы(Ложь, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНастройку(Команда)
	
	СохранитьНастройки();
	СтрокаЗаголовка = НСтр("ru = 'Запись настроек'");
	СтрокаПояснения = НСтр("ru = 'Вариант интерфейса сохранен'");
	ПоказатьОповещениеПользователя(СтрокаЗаголовка, , СтрокаПояснения);
	Модифицированность = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СохранитьНастройки()
	
	ТекущийИнтерфейс85 = ТекущийВариантИнтерфейса = "Версия8_5";
	Если ТекущийИнтерфейс85 И ВариантИнтерфейса = "Такси"
		Или Не ТекущийИнтерфейс85 И ВариантИнтерфейса = "Версия8_5" Тогда
		ЗафиксироватьПереключениеИнтерфейса(ТекущийИнтерфейс85, ВариантИнтерфейса);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗафиксироватьПереключениеИнтерфейса(ТекущийИнтерфейс85, ВариантИнтерфейса)
	
	НастройкиКлиентскогоПриложения = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(
		"Общее/НастройкиКлиентскогоПриложения", "");
	НастройкиКлиентскогоПриложения.ВариантИнтерфейсаКлиентскогоПриложения = ВариантИнтерфейсаКлиентскогоПриложения[ВариантИнтерфейса];
	
	Если Не ТекущийИнтерфейс85 И ВариантИнтерфейса = "Версия8_5" Тогда
		НастройкиКлиентскогоПриложения.ВариантОткрытияОконКлиентскогоПриложения = ВариантОткрытияОконКлиентскогоПриложения.ОткрыватьДанныеВоВкладках;
	КонецЕсли;
	
	ОбщегоНазначения.ХранилищеСистемныхНастроекСохранить("Общее/НастройкиКлиентскогоПриложения", "",
		НастройкиКлиентскогоПриложения);

	УстановитьПривилегированныйРежим(Истина);
	
	Пользователь = Пользователи.АвторизованныйПользователь();
	ДатаВремяПредыдущегоПереключения = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИсторияПереключенияИнтерфейса.Пользователь КАК Пользователь,
	|	ИсторияПереключенияИнтерфейса.ДатаПереключения КАК ДатаПереключения,
	|	ИсторияПереключенияИнтерфейса.ЭтоВозвратНаТакси КАК ЭтоВозвратНаТакси
	|ИЗ
	|	РегистрСведений.ИсторияПереключенияИнтерфейса КАК ИсторияПереключенияИнтерфейса
	|ГДЕ
	|	ИсторияПереключенияИнтерфейса.Пользователь = &Пользователь
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПереключения УБЫВ";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДатаВремяПредыдущегоПереключения = Выборка.ДатаПереключения;
	КонецЦикла;
	
	ТекущаяДатаВремя = ТекущаяДатаСеанса();
	
	Если ЗначениеЗаполнено(ДатаВремяПредыдущегоПереключения) Тогда
		ВремяРаботыДоПереключения = Окр((ТекущаяДатаВремя - ДатаВремяПредыдущегоПереключения) / 60, 0);
	Иначе
		ВремяРаботыДоПереключения = 0;
	КонецЕсли;
	
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	ВерсияПлатформы = ИнформацияОСистеме.ВерсияПриложения;
	ВерсияПриложения = Метаданные.Версия;
	
	ЗаписьРегистра = РегистрыСведений.ИсторияПереключенияИнтерфейса.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Пользователь = Пользователи.АвторизованныйПользователь();
	ЗаписьРегистра.ДатаПереключения = ТекущаяДатаВремя;
	ЗаписьРегистра.ЭтоВозвратНаТакси = ТекущийИнтерфейс85;
	ЗаписьРегистра.ВремяРаботыНаИнтерфейсеВМинутах = ВремяРаботыДоПереключения;
	ЗаписьРегистра.ВерсияПлатформы = ВерсияПлатформы;
	ЗаписьРегистра.ВерсияКонфигурации = ВерсияПриложения;
	ЗаписьРегистра.Записать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпросУжеПроизведен()
	
	СохраненнаяНастройка = ХранилищеСистемныхНастроек.Загрузить("Обработка.ПерсональныеНастройки.Форма.ВозвратНаТакси",
		"ВыполненаКомандаОтправить");
	
	Если СохраненнаяНастройка = Неопределено Тогда
		СохраненнаяНастройка = Ложь;
	КонецЕсли;
	
	Возврат СохраненнаяНастройка;
	
КонецФункции

#КонецОбласти