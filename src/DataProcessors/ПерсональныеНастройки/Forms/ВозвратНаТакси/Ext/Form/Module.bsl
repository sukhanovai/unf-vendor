
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)
	
	ПараметрыЭкранов = ПолучитьИнформациюЭкрановКлиента();
	ПервыйЭкран = ПараметрыЭкранов[0];
	ШаблонРазрешениеПервогоЭкрана = "%1x%2x%3";
	РазрешениеПервогоЭкрана = СтрШаблон(ШаблонРазрешениеПервогоЭкрана, ПервыйЭкран.Ширина, ПервыйЭкран.Высота,
		ПервыйЭкран.DPI);
	РазрешениеПервогоЭкрана = СтрЗаменить(РазрешениеПервогоЭкрана, Символы.НПП, "");
	ПараметрыИнтерфейса = ПолучитьПараметрыИнтерфейса();
	ОтправитьОбращение(РазрешениеПервогоЭкрана, ПараметрыИнтерфейса);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьПараметрыИнтерфейса()
	
	Настройки = ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиКлиентскогоПриложения");
	ПТемаКлиентскогоПриложения = Настройки.ТемаКлиентскогоПриложения;
	ПВариантОтображенияОсновногоОкнаКлиентскогоПриложения = Настройки.ВариантОтображенияОсновногоОкнаКлиентскогоПриложения;
	ПВариантОткрытияОконКлиентскогоПриложения = Настройки.ВариантОткрытияОконКлиентскогоПриложения;
	ПВариантМасштабаКлиентскогоПриложения = Настройки.ВариантМасштабаКлиентскогоПриложения;

	Результат = Новый Структура;
	Результат.Вставить("ТемаКлиентскогоПриложения", ПТемаКлиентскогоПриложения);
	Результат.Вставить("ВариантОтображенияОсновногоОкнаКлиентскогоПриложения",
		ПВариантОтображенияОсновногоОкнаКлиентскогоПриложения);
	Результат.Вставить("ВариантОткрытияОконКлиентскогоПриложения", ПВариантОткрытияОконКлиентскогоПриложения);
	Результат.Вставить("ВариантМасштабаКлиентскогоПриложения", ПВариантМасштабаКлиентскогоПриложения);

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьОбращение(РазрешениеЭкрана, ПараметрыИнтерфейса)
	
	ШаблонСообщения = ШаблонСообщенияВПоддержку();
	ТекстСообщения = СтрШаблон(ШаблонСообщения, 
						Оценка,
						Пояснение,
						РазрешениеЭкрана,
						ПараметрыИнтерфейса.ВариантОтображенияОсновногоОкнаКлиентскогоПриложения,
						ПараметрыИнтерфейса.ВариантОткрытияОконКлиентскогоПриложения,
						ПараметрыИнтерфейса.ВариантМасштабаКлиентскогоПриложения,
						ПараметрыИнтерфейса.ТемаКлиентскогоПриложения,
						КлиентскоеПриложение.ТипПриложения());
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.СообщенияВСлужбуТехническойПоддержки") Тогда
		
		МодульСообщенияВСлужбуТехническойПоддержкиКлиентСервер =
			ОбщегоНазначенияКлиент.ОбщийМодуль("СообщенияВСлужбуТехническойПоддержкиКлиентСервер");
		ДанныеСообщения = МодульСообщенияВСлужбуТехническойПоддержкиКлиентСервер.ДанныеСообщения();
		ДанныеСообщения.Получатель = "v8";
		ДанныеСообщения.Тема       = НСтр("ru = '1С:УНФ. Обратная связь по интерфейсу 8.5'");
		ДанныеСообщения.Сообщение  = ТекстСообщения;
		ДанныеСообщения.ИспользоватьСтандартныйШаблон = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ОтправитьСообщениеЗавершение", ЭтотОбъект);
		
		МодульСообщенияВСлужбуТехническойПоддержкиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль(
			"СообщенияВСлужбуТехническойПоддержкиКлиент");
		МодульСообщенияВСлужбуТехническойПоддержкиКлиент.ОтправитьСообщение(
			ДанныеСообщения, , , Оповещение);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ШаблонСообщенияВПоддержку()
	
	ТекстСообщения = НСтр("ru = 'Благодарим Вас за уделенное время и предоставленную информацию. Просим не менять тему и текст сообщения. Это нужно для оценки качества и улучшения нового интерфейса.
	|
	|Пожалуйста, прокрутите страницу до конца и нажмите кнопку ""Отправить"".
	|
	|----- Обратная связь -----
	|Насколько легко Вам было выполнять привычные задачи в новом интерфейсе?: %1
	|Расскажите, пожалуйста, с какими трудностями Вы столкнулись? %2
	|
	|Техническая информация:
	| Разрешение монитора: %3
	| Вариант отображения основного окна: %4
	| Вариант открытия окна: %5
	| Вариант масштаба: %6
	| Тема: %7
	| Тип клиентского приложения: %8'");
	
	Возврат ТекстСообщения;
	
КонецФункции

&НаСервере
Процедура СохранитьВызовКоманды()
	
	ХранилищеСистемныхНастроек.Сохранить("Обработка.ПерсональныеНастройки.Форма.ВозвратНаТакси",
		"ВыполненаКомандаОтправить", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("КодОшибки") И ПустаяСтрока(Результат.КодОшибки) Тогда
		СохранитьВызовКоманды();
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекстСообщения", Результат.СообщениеОбОшибке);
		ОткрытьФорму("ОбщаяФорма.ОшибкаСообщенияВСлужбуТехническойПоддержки", ПараметрыФормы);
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти