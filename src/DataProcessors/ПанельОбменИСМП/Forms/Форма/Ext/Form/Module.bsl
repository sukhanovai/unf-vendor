		Метаданные.Документы.ВыводИзОборотаИСМП,
		НСтр("ru='Вывод из оборота'"),
		Метаданные.ОпределяемыеТипы.ОснованиеВыводаИзОборотаИСМП.Тип.Типы()[0] <> Тип("Строка"),  // Оформите
		Истина,  // Отработайте
		Истина); // Ожидайте
	
	ДобавитьДокумент(
		ТаблицаДокументы,
		Метаданные.Документы.ВозвратВОборотИСМП,
		НСтр("ru='Возврат в оборот'"),
		Метаданные.ОпределяемыеТипы.ОснованиеВозвратВОборотИСМП.Тип.Типы()[0] <> Тип("Строка"),  // Оформите
		Истина,  // Отработайте
		Истина); // Ожидайте
	
	УчитываемыеВидыМаркируемойПродукции = ОбщегоНазначенияИСМПКлиентСерверПовтИсп.УчитываемыеВидыМаркируемойПродукции();
	ВключенУчетМеха = ШтрихкодированиеОбщегоНазначенияИС.ПрисутствуетПродукцияИзНатуральногоМеха(УчитываемыеВидыМаркируемойПродукции);
	
	ДобавитьДокумент(
		ТаблицаДокументы,
		Метаданные.Документы.ОтгрузкаТоваровИСМП,
		?(ВключенУчетМеха, НСтр("ru='Отгрузка'"), НСтр("ru='Отгрузка (ЕАЭС)'")),
		Истина,  // Оформите
		Истина,  // Отработайте
		Истина); // Ожидайте
		
	ДобавитьДокумент(
		ТаблицаДокументы,
		Метаданные.Документы.ПеремещениеМеждуМОДИСМП,
		НСтр("ru = 'Перемещения между МОД'"),
		Истина,  // Оформите
		Истина,  // Отработайте
		Истина); // Ожидайте
	
	ДобавитьДокумент(
		ТаблицаДокументы,
		Метаданные.Документы.ПриемкаТоваровИСМП,
		?(ВключенУчетМеха, НСтр("ru='Приемка'"), НСтр("ru='Приемка (ЕАЭС)'")),
		Истина,  // Оформите
		Истина,  // Отработайте
		Истина); // Ожидайте
	
	ДобавитьДокумент(
		ТаблицаДокументы,
		Метаданные.Документы.РазрешениеНаОтгрузкуИСМП,
		НСтр("ru='Разрешения на отгрузку'"),
		Метаданные.ОпределяемыеТипы.ОснованиеРазрешениеНаОтгрузкуИСМП.Тип.Типы()[0] <> Тип("Строка"),  // Оформите
		Истина,  // Отработайте
		Истина); // Ожидайте
	
	ДобавитьДокумент(
		ТаблицаДокументы,
		Метаданные.Документы.ПодключениеКегаКОборудованиюРозливаИСМП,
		СокрЛП(СтрЗаменить(ОбщегоНазначенияИСПовтИсп.ПредставленияВскрытыхПотребительскихУпаковок("ИСМП").ЗаголовокСписка, "ИС МП", "")),
		Ложь,    // Оформите
		Истина,  // Отработайте
		Истина); // Ожидайте
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организации",              Организации);
	Запрос.УстановитьПараметр("БезОтбораПоОрганизации",   Организации.Количество() = 0);
	Запрос.УстановитьПараметр("Ответственный",            ?(ЗначениеЗаполнено(Ответственный), Ответственный, Неопределено));
	Запрос.УстановитьПараметр("БезОтбораПоОтветственным", НЕ ЗначениеЗаполнено(Ответственный));
	
	Для Каждого ТекЭлемент Из ТаблицаДокументы Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.ИмяЭлемента) Тогда
			ИмяТекЭлемента = ТекЭлемент.ИмяЭлемента;
		Иначе
			ИмяТекЭлемента = ИмяЭлементаПоМетаданным(ТекЭлемент.Метаданные);
		КонецЕсли;
		
		Если НЕ ТекЭлемент.ЕстьПравоЧтение Тогда
			Элементы["Группа" + ИмяТекЭлемента].Видимость = Ложь;
			Продолжить;
		КонецЕсли;
		
		МетаРеквизитОснование = ИнтеграцияИС.РеквизитДокументОснованиеДокументаИС(ТекЭлемент.Метаданные);
		
		Если МетаРеквизитОснование = Неопределено Тогда
			Запрос.УстановитьПараметр("ПустойДокументОснование", Неопределено);
		Иначе
			Запрос.УстановитьПараметр("ПустойДокументОснование", 
				ИнтеграцияИС.МассивПустыхЗначенийСоставногоТипа(МетаРеквизитОснование.Тип));
		КонецЕсли;
		
		// Сформируем текст запроса выборки количества документов для каждого действия.
		ТекстыЗапроса = Новый СписокЗначений;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("Оформите",
			Новый Структура("Представление, Доступно",
				НСтр("ru='оформите'"),
				ТекЭлемент.ЕстьПравоДобавление));
		Если Не ТекЭлемент.Оформите Тогда
			СтруктураДействий.Оформите.Вставить("СкрытьЭлемент");
		КонецЕсли;
		СтруктураДействий.Вставить("Отработайте",
			Новый Структура("Представление, Доступно",
				НСтр("ru='отработайте'"),
				ТекЭлемент.ЕстьПравоРедактирование));
		СтруктураДействий.Вставить("Ожидайте",
			Новый Структура("Представление, Доступно",
				НСтр("ru='ожидайте'"),
				ТекЭлемент.ЕстьПравоЧтение));
		
		Если ТекЭлемент.Оформите Тогда
			ТекстыЗапроса.Добавить(
				ТекстЗапросаОформите(ТекЭлемент.Метаданные),
				ИмяТекЭлемента + "Оформите");
		КонецЕсли;
		
		Если ТекЭлемент.Отработайте Тогда
			ТекстыЗапроса.Добавить(
				ТекстЗапросаОтработайте(ТекЭлемент.Метаданные, ТекЭлемент.ТекстОтборДокументов),
				ИмяТекЭлемента + "Отработайте");
		КонецЕсли;
		
		Если ТекЭлемент.Ожидайте Тогда
			ТекстыЗапроса.Добавить(
				ТекстЗапросаОжидайте(ТекЭлемент.Метаданные, ТекЭлемент.ТекстОтборДокументов),
				ИмяТекЭлемента + "Ожидайте");
		КонецЕсли;
		
		// Получим запросом количество документов.
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ТекЭлемент.Метаданные.ПолноеИмя());
		Запрос.УстановитьПараметр("ВсеТребующиеОжидания", МенеджерДокумента.ВсеТребующиеОжидания());
		Запрос.УстановитьПараметр("ВсеТребующиеДействия", МенеджерДокумента.ВсеТребующиеДействия());
		
		РезультатыЗапроса = ОбщегоНазначенияИС.ВыполнитьПакетЗапросов(Запрос, ТекстыЗапроса);
		
		// Обновим тексты надписей действий с документом.
		Для Каждого КлючИЗначение Из СтруктураДействий Цикл
			
			ЭлементНадписи = Элементы.Найти("Открыть" + ИмяТекЭлемента + КлючИЗначение.Ключ);
			
			Если ЭлементНадписи = Неопределено Тогда
				// Такое действие для документа не предусмотрено.
			ИначеЕсли КлючИЗначение.Значение.Свойство("СкрытьЭлемент") Тогда
				// Не определены соответствующие операции
				ЭлементНадписи.Видимость = Ложь;
				Элементы[ЭлементНадписи.Имя + "Декорация"].Заголовок = " ";
			ИначеЕсли Не ТекЭлемент[КлючИЗначение.Ключ] Тогда
				СобытияФормИС.ВывестиПоказатель(
					0,
					ЭлементНадписи,
					КлючИЗначение.Значение.Представление,
					КлючИЗначение.Значение.Доступно);
			Иначе
				СобытияФормИС.ВывестиПоказатель(
					РезультатыЗапроса[ИмяТекЭлемента + КлючИЗначение.Ключ].Выбрать(),
					ЭлементНадписи,
					КлючИЗначение.Значение.Представление,
					КлючИЗначение.Значение.Доступно);
			КонецЕсли;
			
		КонецЦикла;
		
		// Обновим текст надписи самого документа.
		СобытияФормИС.ВывестиПоказатель(
			1,
			Элементы["Открыть" + ИмяТекЭлемента],
			ТекЭлемент.Заголовок,
			Истина,
			Ложь,
			Истина);
		
	КонецЦикла;
	
	СохранитьНастройкиФормы();
	
КонецПроцедуры

&НаСервере
Функция ИмяЭлементаПоМетаданным(МетаданныеЭлемента)
	
	Если МетаданныеЭлемента.Имя = Метаданные.Документы.ПодключениеКегаКОборудованиюРозливаИСМП.Имя Тогда
		Возврат Метаданные.РегистрыСведений.ВскрытыеПотребительскиеУпаковкиИС.Имя;
	Иначе
		Возврат МетаданныеЭлемента.Имя;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ОтобразитьСостояниеОбмена()
	
	РезультатыЗапроса = ИнтеграцияИСМП.СостояниеОбмена(Организации);
	
	ПерваяПроблема                      = Неопределено;
	ПерваяПроблемаФорматированнаяСтрока = Неопределено;
	ТекстПодсказкиФорматированнаяСтрока = Неопределено;
	
	ЕщеПроблемы    = 0;
		
	ЭтоИнтерфейс85 = ОбщегоНазначенияИСКлиентСерверПовтИсп.ЭтоИнтерфейс85();
	Суффикс = "";
	Если Не ЭтоИнтерфейс85 Тогда
		Суффикс = "Такси";
	КонецЕсли;
	
	Элементы[СтрШаблон("%1%2%3", "НадписьСостояниеОбмена", Суффикс, "РасширеннаяПодсказка")].Заголовок = "";

	ТребуетсяНастройкаТоварныхГрупп = ОбщегоНазначенияИСМПКлиентСерверПовтИсп.УчитываемыеВидыМаркируемойПродукции().Количество() = 0;
	Если ТребуетсяНастройкаТоварныхГрупп Тогда
		
		Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].ТекущаяСтраница = Элементы[СтрШаблон("%1%2", "СостояниеОбменаКрасный",Суффикс)];
		
		Если ЭтоИнтерфейс85 Тогда
			Элементы[СтрШаблон("%1%2", "НадписьСостояниеОбмена",Суффикс)].Заголовок = Новый ФорматированнаяСтрока(
				НСтр("ru='Настройте товарные группы и загрузите номенклатуру'"),,,,
				"НастройкаПодключенияУТМ");
		Иначе
			Элементы[СтрШаблон("%1%2", "НадписьСостояниеОбмена",Суффикс)].Заголовок = Новый ФорматированнаяСтрока(
				НСтр("ru='Настройте товарные группы и загрузите номенклатуру'"),,
				ЦветаСтиля.ЦветТекстаТребуетВниманияГосИС,,
				"НастройкаПодключенияУТМ");
			КонецЕсли;
		
		Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].Видимость = Истина;
		Элементы[СтрШаблон("%1%2", "НадписьСостояниеОбмена",Суффикс)].Видимость         = Истина;
		
		Если ЭтоИнтерфейс85 Тогда
			УстановитьУсловноеОформлениеГруппыСостояниеОбменаНаСервере();
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	ВозможныеПроблемыПроверкаГИСМТ     = СоответствиеТребованиямГИСМТ.ВозможныеПроблемыОбмена();
	
	Приоритеты            = ВозможныеПроблемыПроверкаГИСМТ.Приоритет;
	ИдентификаторыПроблем = ВозможныеПроблемыПроверкаГИСМТ.Идентификаторы;
	Представления         = ВозможныеПроблемыПроверкаГИСМТ.Представления;
	
	Для Каждого Приоритет Из Приоритеты Цикл
		ИдентификаторПроблемы = ИдентификаторыПроблем[Приоритет];
		
		Проблемы = РезультатыЗапроса[ИдентификаторПроблемы].Выбрать();
		ОписаниеПроблемы = Представления.Получить(ИдентификаторПроблемы);
		
		Если Проблемы.Количество() > 0 Тогда
			Если ПерваяПроблема <> Неопределено Тогда
				ЕщеПроблемы = ЕщеПроблемы + 1;
			Иначе
				Проблемы.Следующий();
				
				ПерваяПроблема = СтрШаблон(
					ОписаниеПроблемы,
					Проблемы.Количество);
				ПерваяПроблемаФорматированнаяСтрока = Новый ФорматированнаяСтрока(
					ПерваяПроблема,,,,
					ИдентификаторПроблемы);
				
				Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].ТекущаяСтраница = Элементы[СтрШаблон("%1%2", "СостояниеОбменаКрасный",Суффикс)];
			КонецЕсли;
		КонецЕсли;
			
	КонецЦикла;
	
	Если Не СтандартныеПодсистемыСервер.ЭтоБазоваяВерсияКонфигурации()
		И Не ОбщегоНазначения.РазделениеВключено()
		И Не ИнтеграцияИС.ХранитьФайлыВТомахНаДиске() Тогда
		Если ПерваяПроблема <> Неопределено Тогда
			ЕщеПроблемы = ЕщеПроблемы + 1;
		Иначе
			ПерваяПроблема = НСтр("ru='Рекомендуется настроить хранение файлов в томах на диске'");
			ПерваяПроблемаФорматированнаяСтрока = Новый ФорматированнаяСтрока(
				ПерваяПроблема,,,,
				"ХранитьФайлыВТомахНаДиске");
			Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].ТекущаяСтраница = Элементы[СтрШаблон("%1%2", "СостояниеОбменаЖелтый",Суффикс)];
			
			ТекстПодсказки = Новый Массив;
			ТекстПодсказки = НСтр("ru='Файлы обмена могут занимать значительный объем данных в базе.
			|Для уменьшения объема базы данных, файлы необходимо хранить в томах на диске.'");
			
			Если Не ПравоДоступаНастройкиРаботыСФайлами() Тогда
				ТекстПодсказки = ТекстПодсказки + Символы.ПС
					+ НСтр("ru='У Вас недостачно прав для выполнения данной операции, обратитесь к администратору.'");
			КонецЕсли;
			ТекстПодсказкиФорматированнаяСтрока = ТекстПодсказки;
			
		КонецЕсли;
	КонецЕсли;
	
	Проблемы = РезультатыЗапроса["ЕстьСообщенияОжидающиеОтправки"].Выбрать();
	Если Проблемы.Количество() > 0 Тогда
		
		Если ПерваяПроблема <> Неопределено Тогда
			ЕщеПроблемы = ЕщеПроблемы + 1;
		Иначе
			Проблемы.Следующий();
			ПерваяПроблема = СтрШаблон(
				НСтр("ru = 'Есть сообщения (%1), ожидающие отправки в ИС МП. Выполните обмен.'"),
				Проблемы.КоличествоСообщений);
			ПерваяПроблемаФорматированнаяСтрока = Новый ФорматированнаяСтрока(
				СтрШаблон(
					НСтр("ru = 'Есть сообщения (%1), ожидающие отправки в ИС МП.'"),
					Проблемы.КоличествоСообщений),,,,
				"ЕстьСообщенияОжидающиеОтправки");
			Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].ТекущаяСтраница = Элементы[СтрШаблон("%1%2", "СостояниеОбменаИнформация",Суффикс)];
			ТекстПодсказки = Новый Массив;
			ТекстПодсказки.Добавить(
				Новый ФорматированнаяСтрока(
					НСтр("ru = 'Не все подготовленные для отправки сообщения доставлены в ИС МП. Рекомендуется'")));
			ТекстПодсказки.Добавить(" ");
			ТекстПодсказки.Добавить(
				Новый ФорматированнаяСтрока(
					Нстр("ru='выполнить обмен'"),,,, "ВыполнитьОбмен"));
			ТекстПодсказки.Добавить(".");
			
			ТекстПодсказкиФорматированнаяСтрока = Новый ФорматированнаяСтрока(ТекстПодсказки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ИдентификаторыИПредставлениеПроблемыНастроитьРегЗадание = ИдентификаторыИПредставлениеПроблемыНастроитьРегЗадание();
	Для Каждого ЭлементКоллекции Из ИдентификаторыИПредставлениеПроблемыНастроитьРегЗадание Цикл
		
		Проблемы = РезультатыЗапроса[ЭлементКоллекции.Ключ].Выбрать();
		
		Если Проблемы.Количество() = 0 Тогда
			
			Если ПерваяПроблема <> Неопределено Тогда
				ЕщеПроблемы = ЕщеПроблемы + 1;
			Иначе
				
				ПерваяПроблема = ЭлементКоллекции.Значение;
				ПерваяПроблемаФорматированнаяСтрока = Новый ФорматированнаяСтрока(
					ПерваяПроблема,,,,
					ЭлементКоллекции.Ключ);
				
				Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].ТекущаяСтраница
					= Элементы[СтрШаблон("%1%2", "СостояниеОбменаЖелтый",Суффикс)];
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИдентификаторыИПредставлениеПроблемыПрочиеНастройки = ИдентификаторыИПредставлениеПроблемыПрочиеНастройки();
	Для Каждого ЭлементКоллекции Из ИдентификаторыИПредставлениеПроблемыПрочиеНастройки Цикл
		
		Проблемы = РезультатыЗапроса[ЭлементКоллекции.Ключ].Выбрать();
		
		Если Проблемы.Количество() > 0 Тогда
			
			Если ПерваяПроблема <> Неопределено Тогда
				ЕщеПроблемы = ЕщеПроблемы + 1;
			Иначе
				
				ПерваяПроблема = ЭлементКоллекции.Значение;
				ПерваяПроблемаФорматированнаяСтрока = Новый ФорматированнаяСтрока(
					ПерваяПроблема,,,,
					ЭлементКоллекции.Ключ);
				Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].ТекущаяСтраница
					= Элементы[СтрШаблон("%1%2", "СостояниеОбменаЖелтый",Суффикс)];
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Проблемы = РезультатыЗапроса["СведенияОбОтклоненияхОжидающиеДействия"].Выбрать();
	Если Проблемы.Количество() > 0 Тогда
		Если ПерваяПроблема <> Неопределено Тогда
			ЕщеПроблемы = ЕщеПроблемы + 1;
		Иначе
			Проблемы.Следующий();
			ПерваяПроблема = СтрШаблон(
				НСтр("ru='Есть отчеты ИС МП (%1), ожидающие обработки сведений об отклонениях.'"),
				Проблемы.КоличествоДокументов);
			
			ПерваяПроблемаФорматированнаяСтрока = Новый ФорматированнаяСтрока(
				ПерваяПроблема,,,,
				"СведенияОбОтклоненияхОжидающиеДействия");
			
			Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].ТекущаяСтраница = Элементы[СтрШаблон("%1%2", "СостояниеОбменаЖелтый",Суффикс)];
		КонецЕсли;
	КонецЕсли;
	
	Если ПерваяПроблема <> Неопределено Тогда
		
		Если ЕщеПроблемы > 0 Тогда
			ТекстЗаголовка = СтрШаблон(НСтр("ru='%1 ( + еще %2 )'"), ПерваяПроблема, ЕщеПроблемы);
			Элементы[СтрШаблон("%1%2", "НадписьСостояниеОбмена",Суффикс)].Заголовок = Новый ФорматированнаяСтрока(
				ТекстЗаголовка,,,,
				"ОткрытьПанельСостоянияОбмена");
		Иначе
			Элементы[СтрШаблон("%1%2", "НадписьСостояниеОбмена",Суффикс)].Заголовок = ПерваяПроблемаФорматированнаяСтрока;
			Если ТекстПодсказкиФорматированнаяСтрока <> Неопределено Тогда
				Элементы[СтрШаблон("%1%2", "НадписьСостояниеОбмена",Суффикс)].ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
				Элементы[СтрШаблон("%1%2%3", "НадписьСостояниеОбмена", Суффикс, "РасширеннаяПодсказка")].Заголовок =
					ТекстПодсказкиФорматированнаяСтрока;
			КонецЕсли;
		КонецЕсли;
		
		Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].Видимость = Истина;
		Элементы[СтрШаблон("%1%2", "НадписьСостояниеОбмена",Суффикс)].Видимость         = Истина;
		
		УстановитьУсловноеОформлениеГруппыСостояниеОбменаНаСервере();
		
	Иначе
		Элементы[СтрШаблон("%1%2", "ГруппаДекорацияСостояниеОбмена",Суффикс)].Видимость = Ложь;
		Элементы[СтрШаблон("%1%2", "НадписьСостояниеОбмена",Суффикс)].Видимость         = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДокумент(Таблица, ОбъектМетаданных, Заголовок, Оформите, Отработайте, Ожидайте,
	ИмяЭлементаФормы = "", ТекстОтборДокументов = "")
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Метаданные  = ОбъектМетаданных;
	НоваяСтрока.Заголовок   = Заголовок;
	
	ОпцияВключена = ИнтеграцияИСМППовтИсп.ОбъектМетаданныхДоступен(ОбъектМетаданных.ПолноеИмя());
	
	НоваяСтрока.ЕстьПравоЧтение         = ОпцияВключена И ПравоДоступа("Чтение",         ОбъектМетаданных);
	НоваяСтрока.ЕстьПравоДобавление     = ОпцияВключена И ПравоДоступа("Добавление",     ОбъектМетаданных);
	НоваяСтрока.ЕстьПравоРедактирование = ОпцияВключена И ПравоДоступа("Редактирование", ОбъектМетаданных);
	
	НоваяСтрока.Оформите      = Оформите;
	НоваяСтрока.Отработайте   = Отработайте;
	НоваяСтрока.Ожидайте      = Ожидайте;
	НоваяСтрока.ИмяЭлемента   = ИмяЭлементаФормы;
	НоваяСтрока.ТекстОтборДокументов = ТекстОтборДокументов;
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапросаОтработайте(МетаданныеДокументаИСМП, ДополнительныйОтбор = "")
	
	ТекстЗапроса = ТекстЗапросаКоличестваДокументовПоДальнейшемуДействию(
		МетаданныеДокументаИСМП,
		"&ВсеТребующиеДействия",
		ДополнительныйОтбор);
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаОжидайте(МетаданныеДокументаИСМП, ДополнительныйОтбор = "")
	
	ТекстЗапроса = ТекстЗапросаКоличестваДокументовПоДальнейшемуДействию(
		МетаданныеДокументаИСМП,
		"&ВсеТребующиеОжидания",
		ДополнительныйОтбор);
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаОформите(МетаданныеДокументаИСМП)
	
	ТипыДокументаОснования     = ИнтеграцияИС.РеквизитДокументОснованиеДокументаИС(МетаданныеДокументаИСМП).Тип.Типы();
	СтрокиСоединенияДокументов = Новый Массив;
	СтрокиОтбораДокументов     = Новый Массив;
	
	Для Каждого ТипОснования Из ТипыДокументаОснования Цикл
		
		МетаданныеОснования = Метаданные.НайтиПоТипу(ТипОснования);
		
		Если МетаданныеОснования = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ПравоДоступа("Чтение", МетаданныеОснования) Тогда
			Продолжить;
		КонецЕсли;
		
		// Добавим соединение с документом-основанием для RLS.
		СтрокиСоединенияДокументов.Добавить("	ЛЕВОЕ СОЕДИНЕНИЕ Документ." + МетаданныеОснования.Имя + " КАК Документ" + МетаданныеОснования.Имя + "
			|		ПО Статусы.Основание = Документ" + МетаданныеОснования.Имя + ".Ссылка");
		
		СтрокиОтбораДокументов.Добавить("Документ" + МетаданныеОснования.Имя + ".Ссылка ЕСТЬ НЕ NULL");
		
	КонецЦикла;
	
	Если СтрокиОтбораДокументов.Количество() = 0 Тогда
		
		// Нет ни одного доступного документа-основания.
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	0 КАК КоличествоДокументов";
		
	Иначе
		
		ТекстСоединения = СтрСоединить(СтрокиСоединенияДокументов, Символы.ПС);
		ТекстОтбора 	= " И (" + СтрСоединить(СтрокиОтбораДокументов, Символы.ПС + "		ИЛИ ") + ")";
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Статусы.Основание) КАК КоличествоДокументов
		|ИЗ
		|	РегистрСведений.СтатусыОформленияДокументовИСМП КАК Статусы
		|%2
		|ГДЕ
		|	Статусы.Документ = ЗНАЧЕНИЕ(Документ.%1.ПустаяСсылка)
		|	И Статусы.СтатусОформления В
		|		(ЗНАЧЕНИЕ(Перечисление.СтатусыОформленияДокументовГосИС.НеОформлено),
		|		 ЗНАЧЕНИЕ(Перечисление.СтатусыОформленияДокументовГосИС.ОформленоЧастично),
		|		 ЗНАЧЕНИЕ(Перечисление.СтатусыОформленияДокументовГосИС.ЕстьОшибкиОформления),
		|		 ЗНАЧЕНИЕ(Перечисление.СтатусыОформленияДокументовГосИС.ТребуетсяСопоставлениеНоменклатуры))
		|	И НЕ Статусы.Архивный
		|	И (&БезОтбораПоОрганизации  ИЛИ Статусы.Контрагент В(&Организации))
		|	%3";
		
		ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ТекстЗапроса,
			МетаданныеДокументаИСМП.Имя,
			ТекстСоединения,
			ТекстОтбора);
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаКоличестваДокументовПоДальнейшемуДействию(МетаданныеДокументаИСМП, ОтборДействия, ДополнительныйОтбор)
	
	МетаРеквизитОснование = ИнтеграцияИС.РеквизитДокументОснованиеДокументаИС(МетаданныеДокументаИСМП);
	
	ТекстСоединения = "";
	ТекстОтбора     = "";
	
	Если МетаРеквизитОснование <> Неопределено Тогда
		
		ТипыДокументаОснования     = МетаРеквизитОснование.Тип.Типы();
		СтрокиСоединенияДокументов = Новый Массив;
		СтрокиОтбораДокументов     = Новый Массив;
		ДокументИмеетОснования     = Ложь;
		
		Для Каждого ТипОснования Из ТипыДокументаОснования Цикл
			
			МетаданныеОснования = Метаданные.НайтиПоТипу(ТипОснования);
			
			Если МетаданныеОснования = Неопределено Тогда
				Продолжить
			ИначеЕсли Не Метаданные.Документы.Содержит(МетаданныеОснования) Тогда
				Продолжить;
			Иначе
				ДокументИмеетОснования = Истина;
			КонецЕсли;
			Если НЕ ПравоДоступа("Чтение", МетаданныеОснования) Тогда
				Продолжить;
			КонецЕсли;
			
			// Добавим соединение с документом-основанием для RLS.
			СтрокиСоединенияДокументов.Добавить(
				"	ЛЕВОЕ СОЕДИНЕНИЕ Документ." + МетаданныеОснования.Имя + " КАК Документ" + МетаданныеОснования.Имя + "
				|		ПО ДокументИСМП.ДокументОснование = Документ" + МетаданныеОснования.Имя + ".Ссылка");
			
			СтрокиОтбораДокументов.Добавить("Документ" + МетаданныеОснования.Имя + ".Ссылка ЕСТЬ НЕ NULL");
			
		КонецЦикла;
		
		Если ДокументИмеетОснования Тогда
			
			Если СтрокиОтбораДокументов.Количество() = 0 Тогда
				ТекстСоединения = "";
			Иначе
				ТекстСоединения = СтрСоединить(СтрокиСоединенияДокументов, Символы.ПС);
			КонецЕсли;
			
			СтрокиОтбораДокументов.Добавить("ДокументИСМП.ДокументОснование В (&ПустойДокументОснование)");
			ТекстОтбора = " И (" + СтрСоединить(СтрокиОтбораДокументов, Символы.ПС + "		ИЛИ ") + ")";
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО (РАЗЛИЧНЫЕ СтатусыДокументовИСМП.Документ) КАК КоличествоДокументов
	|ИЗ
	|	РегистрСведений.СтатусыДокументовИСМП КАК СтатусыДокументовИСМП
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.%1 КАК ДокументИСМП
	|		ПО СтатусыДокументовИСМП.Документ = ДокументИСМП.Ссылка
	|%2
	|ГДЕ
	|	СтатусыДокументовИСМП.ДальнейшееДействие1 В (%3)
	|	И НЕ ДокументИСМП.ПометкаУдаления
	|	И (&БезОтбораПоОрганизации ИЛИ ДокументИСМП.Организация В(&Организации))
	|	И (&БезОтбораПоОтветственным ИЛИ ДокументИСМП.Ответственный = &Ответственный)
	|	%4
	|	%5";
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ТекстЗапроса,
		МетаданныеДокументаИСМП.Имя,
		ТекстСоединения,
		ОтборДействия,
		ТекстОтбора,
		ДополнительныйОтбор);
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаКлиенте
Процедура ЗапуститьРасчетПроблем()
	
	ОбработатьРезультатЗапускаРасчетаПроблем(
		ИнтеграцияИСМПВызовСервера.ЗапуститьРасчетПроблем(УникальныйИдентификатор));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатЗапускаРасчетаПроблем(Результат) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
		ПараметрыОжидания.ТекстСообщения             = НСтр("ru='Выполняется расчет проблем'");
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
		ПараметрыОжидания.ВыводитьОкноОжидания       = Ложь;
		ПараметрыОжидания.ВыводитьСообщения          = Ложь;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(
			Результат,
			Новый ОписаниеОповещения("ПослеЗавершенияРасчетаПроблем", ЭтотОбъект),
			ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗавершенияРасчетаПроблем(Результат, ДополнительныеПараметрыДлительнойОперации) Экспорт
	
	Если Результат = Неопределено Тогда // отменено пользователем
		Если ДополнительныеПараметрыДлительнойОперации.ОповещениеПриЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметрыДлительнойОперации.ОповещениеПриЗавершении);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Результат.Сообщения <> Неопределено Тогда
		Для Каждого СообщениеПользователю Из Результат.Сообщения Цикл
			СообщениеПользователю.Сообщить();
		КонецЦикла;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		РезультатВыполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		
		Если ЗначениеЗаполнено(РезультатВыполнения.ТекстОшибки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатВыполнения.ТекстОшибки);
		ИначеЕсли РезультатВыполнения.ЕстьИзменения Тогда
			ОтобразитьСостояниеОбмена();
		КонецЕсли;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДокументыЭДО

&НаСервере
Функция ПараметрыОтбораВходящиеКОтработке()
	
	МодульЭДО = ОбщегоНазначения.ОбщийМодуль("ОбменСКонтрагентамиКлиентСервер");
	ПараметрыОтбора = МодульЭДО.ПараметрыОтбораТекущихДелЭДО();
	ПараметрыОтбора.РежимОтображения = МодульЭДО.РежимыОтображенияТекущихДелЭДО().КИсполнению;
	ПараметрыОтбора.Раздел           = МодульЭДО.РазделыТекущихДелЭДО().Входящие;
	
	Если ЗначениеЗаполнено(Организации) Тогда
		НовыйЭлементОтбора = МодульЭДО.НовыйЭлементОтбораТекущихДелЭДО("Организация", ВидСравненияКомпоновкиДанных.ВСписке, Организации);
		ПараметрыОтбора.ОтборВходящихЭлектронныхДокументов.Добавить(НовыйЭлементОтбора);
	КонецЕсли;
	
	НовыйЭлементОтбора = МодульЭДО.НовыйЭлементОтбораТекущихДелЭДО("СодержитМаркируемыеТовары", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ПараметрыОтбора.ОтборВходящихЭлектронныхДокументов.Добавить(НовыйЭлементОтбора);
	
	Возврат ПараметрыОтбора;

КонецФункции

&НаСервере
Функция ПараметрыОтбораВходящиеОжидание()
	
	МодульЭДО = ОбщегоНазначения.ОбщийМодуль("ОбменСКонтрагентамиКлиентСервер");
	ПараметрыОтбора = МодульЭДО.ПараметрыОтбораТекущихДелЭДО();
	ПараметрыОтбора.РежимОтображения = МодульЭДО.РежимыОтображенияТекущихДелЭДО().МоиДокументы;
	ПараметрыОтбора.Раздел           = МодульЭДО.РазделыТекущихДелЭДО().НаКонтролеВходящие;
	
	Если ЗначениеЗаполнено(Организации) Тогда
		НовыйЭлементОтбора = МодульЭДО.НовыйЭлементОтбораТекущихДелЭДО("Организация", ВидСравненияКомпоновкиДанных.ВСписке, Организации);
		ПараметрыОтбора.ОтборВходящихЭлектронныхДокументов.Добавить(НовыйЭлементОтбора);
	КонецЕсли;
	
	НовыйЭлементОтбора = МодульЭДО.НовыйЭлементОтбораТекущихДелЭДО("СодержитМаркируемыеТовары", ВидСравненияКомпоновкиДанных.Равно, Истина);
