
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПредставлениеПериода = РаботаСОтборамиКлиентСервер.ОбновитьПредставлениеПериода(ОтборПериод);
	
	ЗаполнитьРеквизиты();
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	
	Если ЭтоИнтерфейс85 Тогда
		КомандаСнятьФлажки = Команды.Найти("СнятьФлажки");
		КомандаСнятьФлажки.Картинка = БиблиотекаКартинок.СнятьФлажки;
		КомандаСнятьФлажки = Команды.Найти("УстановитьФлажки");
		КомандаСнятьФлажки.Картинка = БиблиотекаКартинок.УстановитьФлажки;
	Иначе
		Элементы.ИндексФильтры.Видимость = Ложь;
		Элементы.ИндексФильтрыТакси.Видимость = Истина;
		Элементы.УстановитьФлажки.Видимость = Ложь;
		Элементы.ДанныеИсточникаДенежныйПотокУстановитьФлажки.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СкрытьПоля();
	
	УстановитьВидимостьПоБюджету();
	ПересчитатьКоэффициентСдвигаПериода();
	УстановитьДопустимыеПериодичности();
	ОбновитьДоступностьКнопкиПереноса();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаДоходыРасходы Тогда
		ВыбранныйОтчет = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхОтчетов.ДоходыРасходы");
	Иначе
		ВыбранныйОтчет = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхОтчетов.ДенежныйПоток");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначокФильтрыНажатие(Элемент)
	
	СвернутьРазвернутьПанельОтборов();
	
КонецПроцедуры

