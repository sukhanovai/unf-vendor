		Элементы.ИсточникДанныхПланаПродаж.ПодсказкаВвода = НСтр("ru='План продаж будет выбран по сценарию'");
	КонецЕсли;
	
	УстановитьМеткуИОтбор("СценарийПланирования", Элемент.Родитель.Имя, ВыбранноеЗначение);
	ОбновитьТаблицу();
	
