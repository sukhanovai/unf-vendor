&НаКлиенте
Процедура ИзменитьСуммуДенежныйПоток(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьСуммуЗавершение", ЭтотОбъект);
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("Процент", Объект.Процент);
	ОткрытьФорму("Обработка.ЗаполнениеБюджета.Форма.ФормаИзмененияСуммы",
				ПараметрыОткрытияФормы,,,,,
				ОписаниеОповещения,
				РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
	
КонецПроцедуры

