&НаКлиенте
Процедура Обновить(Команда)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДоходыРасходы;
	
	ОбновитьТаблицу();
	
	ОбновитьКоличествоВыбранныхСтрок();
	ОбновитьДоступностьКнопкиПереноса();
	
