
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьПараметрыФормы();
	
	Если Не ЗначениеЗаполнено(ИсточникДанных) Тогда
		УстановитьИсточникДанныхПоУмолчанию();
	КонецЕсли;
		
	ЕстьПодсистемаРаботаСНоменклатурой = 
		ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.РаботаСНоменклатурой");
		
	ЗагрузкаДанныхИзСервиса = 
		ИсточникДанных = ТорговыеПредложенияСлужебныйКлиентСервер.ИсточникиДанныхТорговогоПредложения().Сервис;
		
	ЗагрузитьКарточкуТорговогоПредложенияВФоне();
	
	ЧитатьДанныеИзКорзины = ЗагрузкаДанныхИзСервиса;
	Если ЧитатьДанныеИзКорзины Тогда
		ЗапуститьЧтениеКорзины();
	КонецЕсли;

	ПроверятьНаличиеОшибокПредупреждений = Не ЗагрузкаДанныхИзСервиса;
	Если ПроверятьНаличиеОшибокПредупреждений Тогда
		ПозицияТорговогоПредложенияДляДиагностики = ПозицияТорговогоПредложенияДляДиагностики();
		ПроверитьНаличиеОшибокПредупрежденийНаСервере(ПозицияТорговогоПредложенияДляДиагностики, ЕстьПредупреждения);
		ПоказатьСкрытьКнопкуПредупреждений(Элементы, ЕстьПредупреждения);
	КонецЕсли;
	
	УстановитьНастройкиОформленияФормы();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОжидатьЗавершенияФоновогоЗаданияЗагрузкиКарточки();
	ОжидатьЗавершенияЧтенияКорзины();
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ТорговыеПредложения_ИзменитьКоличествоВЗаказе"
		И Параметр.ИдентификаторЗаказа = ИдентификаторЗаказа
		И Параметр.Идентификатор = Идентификатор
		И Источник <> ЭтотОбъект Тогда
				
		Параметр.Свойство("Количество", КоличествоВКорзине);
		КоличествоВКорзинеДоИнтерактивногоИзменения = КоличествоВКорзине;
				
	ИначеЕсли ИмяСобытия = "ТорговыеПредложения_УдалитьИзЗаказа"
		И Параметр.ИдентификаторЗаказа = ИдентификаторЗаказа
		И Источник <> ЭтотОбъект Тогда
			
		ИдентификаторыПредложений = Новый Массив;
		Параметр.Свойство("ИдентификаторыПредложений", ИдентификаторыПредложений);
		Если Не ЗначениеЗаполнено(ИдентификаторыПредложений)
			Или ИдентификаторыПредложений.Найти(Идентификатор) = Неопределено Тогда
			Возврат;
		КонецЕсли;

		КоличествоВКорзине = 0;
		КоличествоВКорзинеДоИнтерактивногоИзменения = 0;
		
	ИначеЕсли ИмяСобытия = "ТорговыеПредложения_ПеречитатьДанныеКорзины" Тогда
		
		ПеречитатьДанныеКорзиныИзХранилища(Параметр.АдресДанныхКорзины);
	
	ИначеЕсли ИмяСобытия = "ТорговыеПредложения_ОбновлениеСостоянийТорговыхПредложений" 
		И Источник <> ЭтотОбъект Тогда
			
		Если Не ТребуетсяОбновитьДанныеКарточкиПослеДиагностики(Параметр) Тогда
			Возврат;
		КонецЕсли;
		
		ЗагрузитьКарточкуТорговогоПредложенияВФоне(); 
		ОжидатьЗавершенияФоновогоЗаданияЗагрузкиКарточки();
		
		ПроверитьНаличиеОшибокПредупрежденийНаСервере(ПозицияТорговогоПредложенияДляДиагностики, ЕстьПредупреждения);
		ПоказатьСкрытьКнопкуПредупреждений(Элементы, ЕстьПредупреждения);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ЧитатьДанныеИзКорзины Тогда
		НастроитьВидимостьЭлементовИКомандУправленияКорзиной(Элементы, КоличествоВКорзине);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Подключаемый_АдресПредварительногоИзображенияНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОбработатьНажатиеПредварительногоПросмотра(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура АдресКартинкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

#Если Не ВебКлиент Тогда
	
	Если Не ПустаяСтрока(АдресКартинки) И ЭтоАдресВременногоХранилища(АдресКартинки) Тогда
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("АдресВХранилище", АдресКартинки);
		ЭлементСписка = КэшИзображений.НайтиСтроки(ПараметрыОтбора);

		ФайловаяСистемаКлиент.ОткрытьФайл(АдресКартинки, , ЭлементСписка[0].РасширениеФайла);

	КонецЕсли;
	
#КонецЕсли
		
КонецПроцедуры

&НаКлиенте
Процедура КатегорияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОчиститьСообщения();
	
	ПараметрыОткрытия = ПараметрыОткрытияФормыПоиска();
	ПараметрыОткрытия.ИдентификаторКатегории = ИдентификаторКатегории;
	Оповестить("ТорговыеПредложения_ПоискПоОтборам_Обновить", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеНоменклатурыСервисаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОчиститьСообщения();

	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ИдентификаторНоменклатуры", ИдентификаторНоменклатурыСервиса);
	ПараметрыОткрытия.Вставить("ИдентификаторХарактеристики", ИдентификаторХарактеристикиСервиса);

	// Открытие формы если существует подсистема РаботаСНоменклатурой
	Модуль = ОбщегоНазначенияКлиент.ОбщийМодуль("РаботаСНоменклатуройКлиент");
	Модуль.ОткрытьФормуКарточкиНоменклатуры(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыОткрытия), ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура КоличествоВКорзинеРегулирование(Элемент, Направление, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
	КоличествоВКорзинеОбработкаРегулирования(Направление);
	
	Если КоличествоВКорзине = 0 
		Или ТорговыеПредложенияКлиент.КоличествоВведеноКорректно(
		КоличествоВКорзине, МинимальноеКоличество, КратностьУпаковкиЧислом) Тогда
		ОбработатьИзмененияКоличестваВКорзине();
	Иначе
		КоличествоВКорзине = КоличествоВКорзинеДоИнтерактивногоИзменения;
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура КоличествоВКорзинеПриИзменении(Элемент)
	
	Если КоличествоВКорзине = 0 
		Или ТорговыеПредложенияКлиент.КоличествоВведеноКорректно(
		КоличествоВКорзине, МинимальноеКоличество, КратностьУпаковкиЧислом) Тогда
		ОбработатьИзмененияКоличестваВКорзине();
	Иначе
		КоличествоВКорзине = КоличествоВКорзинеДоИнтерактивногоИзменения;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеКонтрагентаГиперссылкаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОчиститьСообщения();

	ПараметрыОткрытия = БизнесСетьКлиентСервер.ОписаниеИдентификацииОрганизацииКонтрагентов();
	ПараметрыОткрытия.ИНН = ИННКонтрагента;
	ПараметрыОткрытия.КПП = КППКонтрагента;
	БизнесСетьСлужебныйКлиент.ОткрытьПрофильУчастника(ПараметрыОткрытия);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьВКорзину(Команда)
	
	Если КоличествоВКорзине = 0 Тогда
		КоличествоВКорзине = Макс(МинимальноеКоличество, КратностьУпаковкиЧислом);
	КонецЕсли;
	КоличествоВКорзинеДоИнтерактивногоИзменения = КоличествоВКорзине;
	
	ДобавитьТоварИзменитьКоличество();
	
КонецПроцедуры

&НаКлиенте
Процедура СледующаяКартинка(Команда)
	ПереключитьИзображение(1);
КонецПроцедуры

&НаКлиенте
Процедура ПредыдущаяКартинка(Команда)
	ПереключитьИзображение(-1);
КонецПроцедуры 

&НаКлиенте
Процедура ПерейтиВКорзину(Команда)
	ОчиститьСообщения();
	ТорговыеПредложенияКлиент.ОткрытьФормуКорзины(Организация, , , Идентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ПовторитьТекущуюДлительнуюОперацию(Команда)
	
	ЗагрузитьКарточкуТорговогоПредложенияВФоне(); 
	ОжидатьЗавершенияФоновогоЗаданияЗагрузкиКарточки();

	Если ЧитатьДанныеИзКорзины Тогда
		ЗапуститьЧтениеКорзины();
		ОжидатьЗавершенияЧтенияКорзины();
	КонецЕсли;

	Если ПроверятьНаличиеОшибокПредупреждений Тогда
		ПозицияТорговогоПредложенияДляДиагностики = ПозицияТорговогоПредложенияДляДиагностики();
		ПроверитьНаличиеОшибокПредупрежденийНаСервере(ПозицияТорговогоПредложенияДляДиагностики, ЕстьПредупреждения);
		ПоказатьСкрытьКнопкуПредупреждений(Элементы, ЕстьПредупреждения);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьЖурналРегистрации(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Данные", НаименованиеФоновогоЗаданияПолучениеДанных);
	
	ЖурналРегистрацииКлиент.ОткрытьЖурналРегистрации(ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КопироватьОписание(Команда)
	ТорговыеПредложенияСлужебныйКлиент.ПоместитьТекстВБуфераОбмена(ОписаниеТовара);
КонецПроцедуры  

&НаКлиенте
Процедура КопироватьДополнительноеОписание(Команда)
	ТорговыеПредложенияСлужебныйКлиент.ПоместитьТекстВБуфераОбмена(ДополнительноеОписание);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждения(Команда)
		
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ПрайсЛист", ПрайсЛист);
	ПараметрыОткрытияФормы.Вставить("ТребуетсяВыполнитьПроверкуДанных", Ложь);
	
	ПозицияТорговогоПредложенияДляДиагностикиВМассиве = 
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПозицияТорговогоПредложенияДляДиагностики);
	ПараметрыОткрытияФормы.Вставить("ПозицииТорговыхПредложений", ПозицияТорговогоПредложенияДляДиагностикиВМассиве);
		
	ТорговыеПредложенияКлиент.ОткрытьФормуДиагностикиТорговыхПредложений(ПараметрыОткрытияФормы, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

#Область РаботаСКорзиной

#Область ЧтениеКорзины

&НаСервере
Процедура ЗапуститьЧтениеКорзины()
	
	ОтобразитьСтраницуДлительнойОперацииКорзины();
	АдресКорзины = ТорговыеПредложенияСлужебный.АдресКорзиныИзЛокальногоХранилища();

	ПараметрыМетода = Новый Структура;
	
	ПараметрыМетода.Вставить("Организация", Организация);
	ПараметрыМетода.Вставить("АдресКорзины", АдресКорзины);
	
	ФоновоеЗаданиеЧтениеКорзины = ТорговыеПредложенияСлужебный.СоздатьПрочитатьКорзинуВФоне(
		ПараметрыМетода, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОжидатьЗавершенияЧтенияКорзины()
	
	Если Не ЗначениеЗаполнено(ФоновоеЗаданиеЧтениеКорзины) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ВыводитьСообщения    = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ЧтениеКорзиныЗавершение", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ФоновоеЗаданиеЧтениеКорзины, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ЧтениеКорзиныЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ПеречитатьДанныеКорзиныИзХранилища(Результат.АдресРезультата); 
		
КонецПроцедуры

&НаСервере
Процедура ПеречитатьДанныеКорзиныИзХранилища(Знач АдресДанныхКорзиныВХранилище)
	
	ОтобразитьСтраницуДлительнойОперацииКорзины();

	КоличествоВКорзине = 0;
	КоличествоВКорзинеДоИнтерактивногоИзменения = 0;
	АдресКомандыИзменитьКоличество = "";
	АдресКомандыУдалить = "";

	Если Не ЗначениеЗаполнено(АдресДанныхКорзиныВХранилище) Тогда
		АдресКорзины = "";
		ОтобразитьСтраницуРезультатаКорзины();
		Возврат;
	КонецЕсли;
	
	ДанныеСервиса = ПолучитьИзВременногоХранилища(АдресДанныхКорзиныВХранилище);
	
	Если Не ЗначениеЗаполнено(ДанныеСервиса) Тогда
		АдресКорзины = "";
		ОтобразитьСтраницуРезультатаКорзины();
		Возврат;
	КонецЕсли;
	
	ДанныеКорзины = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеСервиса, "ДанныеКорзины");
	
	Если Не ЗначениеЗаполнено(ДанныеКорзины) Тогда
		АдресКорзины = "";
		ОтобразитьСтраницуРезультатаКорзины();
		Возврат;
	КонецЕсли;
	
	АдресКорзины = ДанныеКорзины.АдресКорзины;
	АдресКомандыДобавить = ДанныеКорзины.АдресаКоманд.ДобавитьТовар;

	Для каждого Заказ Из ДанныеКорзины.Заказы Цикл 
		
		НайденнаяСтрокаТовара = Заказ.Товары.Найти(Идентификатор, "Идентификатор");
		Если НайденнаяСтрокаТовара <> Неопределено Тогда
			КоличествоВКорзине = НайденнаяСтрокаТовара.Количество;
			АдресКомандыИзменитьКоличество = НайденнаяСтрокаТовара.АдресаКоманд.УстановитьКоличество;
			АдресКомандыУдалить = НайденнаяСтрокаТовара.АдресаКоманд.УдалитьТовар;
			Прервать;
		КонецЕсли;
	
	КонецЦикла; 
	
	КоличествоВКорзинеДоИнтерактивногоИзменения = КоличествоВКорзине;
	
	ОтобразитьСтраницуРезультатаКорзины();
		
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура КоличествоВКорзинеОбработкаРегулирования(Направление)
			
	ОстатокОтДеления = КоличествоВКорзине % КратностьУпаковкиЧислом;
	
	Если Направление = 1 Тогда
		Количество = КоличествоВКорзине + (КратностьУпаковкиЧислом - ОстатокОтДеления);
		КоличествоВКорзине = Макс(МинимальноеКоличество, Количество);
	Иначе
		Если КоличествоВКорзине = МинимальноеКоличество Тогда
			КоличествоВКорзине = 0;
		Иначе
			КоличествоВКорзине = КоличествоВКорзине 
				- (?(ОстатокОтДеления = 0, КратностьУпаковкиЧислом, ОстатокОтДеления));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Процедура СоздатьКорзину(Знач Организация, АдресКорзины, АдресКомандыДобавитьТовар)
	ТорговыеПредложенияСлужебный.СоздатьКорзинуИЗаполнитьКоманды(Организация, АдресКорзины, АдресКомандыДобавитьТовар);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзмененияКоличестваВКорзине()
	
	КоличествоВКорзинеДоИнтерактивногоИзменения = КоличествоВКорзине;
	Если КоличествоВКорзине > 0 Тогда
		ПодключитьОбработчикОжидания("ДобавитьТоварИзменитьКоличество", 0.5, Истина);
	Иначе
		ПодключитьОбработчикОжидания("УдалитьТоварИзКорзины", 0.5, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТоварИзменитьКоличество()
	
	Если Не ЗначениеЗаполнено(АдресКорзины) Тогда
		
		СоздатьКорзину(Организация, АдресКорзины, АдресКомандыДобавить);
		
		Если Не ЗначениеЗаполнено(АдресКорзины) Или Не ЗначениеЗаполнено(АдресКомандыДобавить) Тогда
			Шаблон = НСтр("ru = 'Ошибка при создании корзины. Подробности в журнале регистрации.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(Шаблон);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВыполненияДействияНадТоваром", ЭтотОбъект);
	
	ПараметрыРаботыСТоваром = ТорговыеПредложенияКлиент.ОписаниеПараметровРаботыСТоваромКорзины();
	ПараметрыРаботыСТоваром.ИдентификаторТорговогоПредложения = Идентификатор;
	ПараметрыРаботыСТоваром.Организация                       = Организация;
	ПараметрыРаботыСТоваром.АдресКомандыДобавить              = АдресКомандыДобавить;
	ПараметрыРаботыСТоваром.АдресКомандыИзменитьКоличество    = АдресКомандыИзменитьКоличество;
	ПараметрыРаботыСТоваром.Количество                        = КоличествоВКорзине;
	ПараметрыРаботыСТоваром.ПрочитатьКорзину                  = Истина;
	ПараметрыРаботыСТоваром.АдресКорзины                      = АдресКорзины;

	ТорговыеПредложенияКлиент.ВыполнитьДействиеСТоваромКорзины(ПараметрыРаботыСТоваром, ЭтотОбъект, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьТоварИзКорзины()
	
	ПараметрыОповещения = Новый Структура("Идентификатор", Идентификатор);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыполненияДействияНадТоваром", ЭтотОбъект, ПараметрыОповещения);
	
	ПараметрыРаботыСТоваром = ТорговыеПредложенияКлиент.ОписаниеПараметровРаботыСТоваромКорзины();
	
	ПараметрыРаботыСТоваром.Организация         = Организация;
	ПараметрыРаботыСТоваром.АдресКомандыУдалить = АдресКомандыУдалить;
	ПараметрыРаботыСТоваром.АдресКорзины        = АдресКорзины;
	ПараметрыРаботыСТоваром.ВидОперации         = "Удаление";
	ПараметрыРаботыСТоваром.ПрочитатьКорзину    = Истина;
	
	ТорговыеПредложенияКлиент.ВыполнитьДействиеСТоваромКорзины(ПараметрыРаботыСТоваром, ЭтотОбъект, Оповещение);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВыполненияДействияНадТоваром(Результат, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
		
	Если Не ЭтоАдресВременногоХранилища(Результат.АдресРезультата) Тогда
		Возврат;
	КонецЕсли;

	Если Не ДействиеНадТоваромВыполнено(Результат.АдресРезультата) Тогда
		Возврат;
	КонецЕсли;

	ТорговыеПредложенияКлиент.ОповеститьОбИзмененииКорзины(Результат.АдресРезультата, ЭтотОбъект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДействиеНадТоваромВыполнено(Знач АдресРезультата)
	
	РезультатыДействияНадТоваром = ПолучитьИзВременногоХранилища(АдресРезультата);
	Ошибка = РезультатыДействияНадТоваром.Ошибка;
	Если Ошибка <> Неопределено Тогда
		Если Не ПустаяСтрока(Ошибка.ТекстОшибкиСервиса) Тогда
			ОбщегоНазначения.СообщитьПользователю(Ошибка.ТекстОшибкиСервиса);
		ИначеЕсли Не ПустаяСтрока(Ошибка.ТекстОшибки) Тогда
			ОбщегоНазначения.СообщитьПользователю(Ошибка.ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	
	Результат = Не  РезультатыДействияНадТоваром.Отказ;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область РаботаСИзображениями  

&НаСервере
Процедура СформироватьЭлементыИзображений()
	
	ДобавитьЭлементыПредварительныхИзображений();
	УстановитьОформлениеПредварительныхИзображений(Элементы, ИндексТекущегоИзображения, 
		ИндексСледующегоИзображения, НастройкиОформленияПредварительныхИзображений);
		
	ПоказатьИзображение(АдресКартинки, КэшИзображений, ИндексСледующегоИзображения);

КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыПредварительныхИзображений()
	
	КоличествоИзображений = КэшИзображений.Количество();
	Если КоличествоИзображений = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ВысотаПредварительныхИзображений = 2;
	Для Счетчик = 1 По КоличествоИзображений Цикл
		
		ИмяЭлемента = СтрШаблон("%1%2", ИмяЭлементаПредварительногоИзображения(), Счетчик);
		НайденныйЭлемент = Элементы.Найти(ИмяЭлемента); 
		Если НайденныйЭлемент <> Неопределено Тогда
			НайденныйЭлемент.Видимость = Счетчик <= КоличествоВидимыхПредварительныхИзображений;
			Продолжить;
		КонецЕсли;
		
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Элементы.ГруппаПредварительныеИзображения);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеКартинки;
		НовыйЭлемент.ПутьКДанным = СтрШаблон("КэшИзображений[%1].АдресВХранилище", Счетчик - 1);
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		НовыйЭлемент.Гиперссылка = Истина;
		НовыйЭлемент.Высота = ВысотаПредварительныхИзображений;
		НовыйЭлемент.РастягиватьПоВертикали = Ложь;
		НовыйЭлемент.РазмерКартинки = РазмерКартинки.АвтоРазмерБезУчетаМасштаба;
		НовыйЭлемент.ТекстНевыбраннойКартинки = НСтр("ru = 'Нет изображения'", ОбщегоНазначения.КодОсновногоЯзыка());
		НовыйЭлемент.Шрифт = ШрифтыСтиля.ПодзаголовокПервогоУровня;
		НовыйЭлемент.УстановитьДействие("Нажатие", "Подключаемый_АдресПредварительногоИзображенияНажатие");
 		НовыйЭлемент.Видимость = Счетчик <= КоличествоВидимыхПредварительныхИзображений;

	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКоличествоВидимыхПредварительныхИзображений()
	
	КоличествоИзображений = КэшИзображений.Количество();
	КоличествоВидимыхПредварительныхИзображений = 4;
	
	Если КоличествоИзображений > КоличествоВидимыхПредварительныхИзображений Тогда
		КоличествоВидимыхПредварительныхИзображений = КоличествоВидимыхПредварительныхИзображений - 1;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНажатиеПредварительногоПросмотра(Элемент)
	
	ПорядковыйНомерПредварительногоИзображения = ПорядковыйНомерПредварительногоИзображения(Элемент);
	ИндексСледующегоИзображения = Макс(ПорядковыйНомерПредварительногоИзображения - 1, 0);
	
	Если ИндексСледующегоИзображения = ИндексТекущегоИзображения Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьИзображение(АдресКартинки, КэшИзображений, ИндексСледующегоИзображения);
	
	УстановитьОформлениеПредварительныхИзображений(Элементы, ИндексТекущегоИзображения, 
		ИндексСледующегоИзображения, НастройкиОформленияПредварительныхИзображений);
	
	ИндексТекущегоИзображения = ИндексСледующегоИзображения;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПорядковыйНомерПредварительногоИзображения(Элемент)

	НомерПредварительногоИзображенияСтрокой = СтрЗаменить(Элемент.Имя, ИмяЭлементаПредварительногоИзображения(), "");
	НомерПредварительногоИзображения = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(НомерПредварительногоИзображенияСтрокой);
	
	Возврат НомерПредварительногоИзображения;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьИзображение(АдресКартинки, КэшИзображений, ИндексИзображения)
	
	Если ИндексИзображения > КэшИзображений.Количество() - 1 Тогда
		Возврат;
	КонецЕсли;
	
	АдресКартинки = КэшИзображений[ИндексИзображения].АдресВХранилище;
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Функция ИмяЭлементаПредварительногоИзображения()
	Возврат "АдресПредварительногоИзображения";	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОформлениеПредварительныхИзображений(Элементы, 
	ИндексТекущегоИзображения, ИндексСледующегоИзображения, НастройкиОформления)
	
	ИмяЭлементаБезНомера = ИмяЭлементаПредварительногоИзображения(); 
		
	// Снять "рамку" предыдущему выделенному элементу
	ИмяВыделенногоЭлемента = СтрШаблон("%1%2", ИмяЭлементаБезНомера, ИндексТекущегоИзображения + 1);
	Для каждого ЭлементНастроек Из НастройкиОформления.ТекущийВыделенныйЭлемент Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ИмяВыделенногоЭлемента, ЭлементНастроек.Ключ, ЭлементНастроек.Значение);
	КонецЦикла;
	
	// Установить "рамку" новому выделенному элементу 
	ИмяСледующегоЭлемента = СтрШаблон("%1%2", ИмяЭлементаБезНомера, ИндексСледующегоИзображения + 1);
	Для каждого ЭлементНастроек Из НастройкиОформления.НовыйВыделенныйЭлемент Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ИмяСледующегоЭлемента, ЭлементНастроек.Ключ, ЭлементНастроек.Значение);
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьИзображение(Направление)
	
	НомераВидимыхПредварительныхИзображений = Новый Массив;
	Для каждого Элемент Из Элементы.ГруппаПредварительныеИзображения.ПодчиненныеЭлементы Цикл
		Если Элемент.Видимость Тогда
			НомераВидимыхПредварительныхИзображений.Добавить(ПорядковыйНомерПредварительногоИзображения(Элемент));
		КонецЕсли;
	КонецЦикла;
	
	Если Направление > 0 Тогда 
		
		НомерЭлементаДляСнятияВидимости = НомераВидимыхПредварительныхИзображений[0];
		НомерЭлементаДляУстановкиВидимости = 
			НомераВидимыхПредварительныхИзображений[НомераВидимыхПредварительныхИзображений.ВГраница()] + 1;	
		ИмяКнопкиДляУстановкиДоступности = "ПредыдущаяКартинка";

		// Снимаем доступность кнопки СледующаяКартинка, если достигли конца коллекции
		Если НомерЭлементаДляУстановкиВидимости = КэшИзображений.Количество() Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "СледующаяКартинка", "Доступность", Ложь);
		КонецЕсли;
		
	Иначе
		
		НомерЭлементаДляСнятияВидимости = 
			НомераВидимыхПредварительныхИзображений[НомераВидимыхПредварительныхИзображений.ВГраница()];
		НомерЭлементаДляУстановкиВидимости = НомераВидимыхПредварительныхИзображений[0] - 1;	
        ИмяКнопкиДляУстановкиДоступности = "СледующаяКартинка";

		// Снимаем доступность кнопки ПредыдущаяКартинка, если достигли конца коллекции
		Если НомерЭлементаДляУстановкиВидимости = 1 Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ПредыдущаяКартинка", "Доступность", Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
	// Получаем имя элемента для снятия видимости
	ИмяЭлементаДляСнятияВидимости = СтрШаблон("%1%2", 
		ИмяЭлементаПредварительногоИзображения(), 
		НомерЭлементаДляСнятияВидимости);

	// Снимаем видимость элемента
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, ИмяЭлементаДляСнятияВидимости, "Видимость", Ложь);		

	// Получаем имя элемента для показа
	ИмяЭлементаДляУстановкиВидимости = СтрШаблон("%1%2", 
		ИмяЭлементаПредварительногоИзображения(), 
		НомерЭлементаДляУстановкиВидимости);
			
	// Устанавливаем видимость следующего элемента
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, ИмяЭлементаДляУстановкиВидимости, "Видимость", Истина); 

	// Устанавливаем доступность кнопки
	Если Не ОбщегоНазначенияКлиентСервер.ЗначениеСвойстваЭлементаФормы(
				Элементы, ИмяКнопкиДляУстановкиДоступности, "Доступность") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы, ИмяКнопкиДляУстановкиДоступности, "Доступность", Истина);
	КонецЕсли;
		
КонецПроцедуры 

#КонецОбласти

#Область ОформлениеФормы

&НаСервере
Процедура УстановитьНастройкиОформленияФормы()
	УстановитьОтображениеПримечания();
	УстановитьНастройкиОформленияПредварительныхИзображений();
	УстановитьДоступностьКарточкиКорзины();
КонецПроцедуры

&НаСервере
Процедура УстановитьОтображениеПримечания()

	Если Не ЧитатьДанныеИзКорзины Тогда
		ДобавитьПримечание();
		ОбщегоНазначения.ВывестиСтатусыИВажныеСообщенияНаФорму(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкиОформленияПредварительныхИзображений()

	НастройкиОформленияПредварительныхИзображений = Новый Структура;
	
	НастройкиДляТекущегоВыделенногоЭлемента = Новый Структура;
	НастройкиДляТекущегоВыделенногоЭлемента.Вставить(
		"ОтображениеФона", ОтображениеФонаКартинки.НеОтображать);
	НастройкиОформленияПредварительныхИзображений.Вставить(
		"ТекущийВыделенныйЭлемент", НастройкиДляТекущегоВыделенногоЭлемента);
	
	НастройкиДляНовогоВыделенногоЭлемента = Новый Структура;
	НастройкиДляНовогоВыделенногоЭлемента.Вставить(
		"ОтображениеФона", ОтображениеФонаКартинки.ОтображатьИНеУвеличиватьРазмер);
	НастройкиОформленияПредварительныхИзображений.Вставить(
		"НовыйВыделенныйЭлемент", НастройкиДляНовогоВыделенногоЭлемента);

КонецПроцедуры 

&НаСервере
Процедура УстановитьДоступностьКарточкиКорзины()
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаКорзина", "Доступность", ЧитатьДанныеИзКорзины);
КонецПроцедуры

&НаСервере 
Процедура ДобавитьПримечание()
	
	КраткоеПредставление = НСтр("ru = 'Примечание'", ОбщегоНазначения.КодОсновногоЯзыка());
		
	Сообщение =
		НСтр("ru = 'Карточка торгового предложения отображается идентично тому, как она отображается покупателю'",
		ОбщегоНазначения.КодОсновногоЯзыка());
		
	ПараметрыСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыСообщения.ТипСообщения = "Информация";
	ПараметрыСообщения.Идентификатор = ИдентификаторПримечания();
	ПараметрыСообщения.КраткоеПредставление = КраткоеПредставление;
	ПараметрыСообщения.Сообщение = Сообщение;
	ПараметрыСообщения.Скрываемый = Истина;
	ПараметрыСообщения.ОбработчикЗакрытия = "Подключаемый_УдалитьПримечание";
	
	ОбщегоНазначения.ДобавитьВажноеСообщение(
		ЭтотОбъект,
		ПараметрыСообщения);
		
КонецПроцедуры

