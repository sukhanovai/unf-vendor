&НаСервере
Процедура ЗагрузитьКарточкуТорговогоПредложенияВФоне()

	ОтобразитьСтраницуДлительнойОперации();

	Если ФоновоеЗаданиеЗагрузкиКарточки <> Неопределено Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(ФоновоеЗаданиеЗагрузкиКарточки.ИдентификаторЗадания);
		ФоновоеЗаданиеЗагрузкиКарточки.ИдентификаторЗадания = Неопределено;
	КонецЕсли;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = 
		НСтр("ru = '1С:Бизнес-сеть. Чтение торгового предложения.'", ОбщегоНазначения.КодОсновногоЯзыка());
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Организация", Организация);
	ПараметрыПроцедуры.Вставить("Идентификатор", Идентификатор);
	ПараметрыПроцедуры.Вставить("Валюта", Валюта);
	ПараметрыПроцедуры.Вставить("Номенклатура", Номенклатура);
	ПараметрыПроцедуры.Вставить("Характеристика", Характеристика);
	ПараметрыПроцедуры.Вставить("ИсточникДанных", ИсточникДанных);
	ПараметрыПроцедуры.Вставить("ПрайсЛист", ПрайсЛист);
	ПараметрыПроцедуры.Вставить("Упаковка", Упаковка);
	
	НаименованиеФоновогоЗаданияПолучениеДанных = ПараметрыВыполнения.НаименованиеФоновогоЗадания;
	
	ФоновоеЗаданиеЗагрузкиКарточки = ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"ТорговыеПредложенияСлужебный.ДанныеТорговогоПредложенияДляВыводаВКарточку",
		ПараметрыПроцедуры);

КонецПроцедуры

&НаКлиенте
Процедура ОжидатьЗавершенияФоновогоЗаданияЗагрузкиКарточки()

	Если ФоновоеЗаданиеЗагрузкиКарточки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ФоновоеЗаданиеЗагрузкиКарточки.Статус = "Выполнено" Тогда
		ОбновитьКарточкуТорговогоПредложения(ФоновоеЗаданиеЗагрузкиКарточки, Неопределено);
	ИначеЕсли ФоновоеЗаданиеЗагрузкиКарточки.Статус = "Выполняется" Тогда
		// Инициализация обработчик ожидания завершения.
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Чтение торгового предложения.'");
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ПараметрыОжидания.ОповещениеПользователя.Показать = Ложь;
		ПараметрыОжидания.ВыводитьСообщения = Истина;
		ПараметрыОжидания.Вставить("ИдентификаторЗадания", ФоновоеЗаданиеЗагрузкиКарточки.ИдентификаторЗадания);
		
		ОповещениеЗавершенияЗагрузки = Новый ОписаниеОповещения("ОбновитьКарточкуТорговогоПредложения",
			ЭтотОбъект, ФоновоеЗаданиеЗагрузкиКарточки);
			
		ДлительныеОперацииКлиент.ОжидатьЗавершение(
			ФоновоеЗаданиеЗагрузкиКарточки, ОповещениеЗавершенияЗагрузки, ПараметрыОжидания);
			
	ИначеЕсли ФоновоеЗаданиеЗагрузкиКарточки.Статус = "Ошибка" Тогда
		ОтобразитьСтраницуОшибки(Элементы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКарточкуТорговогоПредложения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		ОтобразитьСтраницуОшибки(Элементы);	
		Возврат;
	КонецЕсли;
	
	Если Результат.Сообщения.Количество() > 0 Тогда
		Для Каждого Сообщение Из Результат.Сообщения Цикл
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьКарточкуТорговогоПредложенияНаСервере(Результат.АдресРезультата);
	
	Если ЭтоВзрослаяКатегория
		И КэшИзображений.Количество() > 0 Тогда
		
		ИмяПроцедуры = "ВопросПоказатьИзображениеВзрослойКатегории";
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения(ИмяПроцедуры, ЭтотОбъект);
		ТорговыеПредложенияСлужебныйКлиент.ПользователюБольше18Лет(ЭтотОбъект, ОписаниеОповещенияОЗавершении);
		
	КонецЕсли;		

КонецПроцедуры 

&НаСервере
Процедура ОбновитьКарточкуТорговогоПредложенияНаСервере(АдресРезультата)
	
	ПараметрыВывода = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если Не ЗначениеЗаполнено(ПараметрыВывода) Тогда
		ОтобразитьСтраницуОшибки(Элементы);	
		Возврат;
	КонецЕсли;
	
	ИсключаяСвойства = "Свойства, РегионыДоставки, АдресаСамовывоза, Штрихкоды, ДополнительноеОписание";
	
	// Заполнить данные
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыВывода, , ИсключаяСвойства);
	ЗаполнитьЗаголовок(ПараметрыВывода);
	ЗаполнитьНаименование(ПараметрыВывода);
	ЗаполнитьКатегорию(ПараметрыВывода);
	ЗаполнитьОписание(ПараметрыВывода);
	ЗаполнитьПредставлениеЦен(ПараметрыВывода);
	ЗаполнитьМатрицуЦен(ПараметрыВывода);
	ЗаполнитьСвойстваТорговогоПредложения(ПараметрыВывода);
	ЗаполнитьРегионыДоставки(ПараметрыВывода);
    ЗаполнитьАдресаСамовывоза(ПараметрыВывода);
	ЗаполнитьШтрихкоды(ПараметрыВывода); 
	ЗаполнитьКратностьУпаковки(ПараметрыВывода);
	ВычислитьМинимальноеКоличествоДляЗаказа(); 
	ЗаполнитьПредставлениеНДСКорзина(ПараметрыВывода);
	
	ИндексТекущегоИзображения = 0;
	ИндексСледующегоИзображения = 0;
	ЭтоВзрослаяКатегория = Ложь;
	
	ЗагрузитьИзображения(ПараметрыВывода.ДанныеИзображений);
	УстановитьКоличествоВидимыхПредварительныхИзображений();
	
	Если ЗначениеЗаполнено(ПараметрыВывода.РодительскиеКатегории)
		И ТорговыеПредложенияСлужебный.ЕстьВзрослаяКатегорияСредиРодительских(
			ПараметрыВывода.РодительскиеКатегории) Тогда 
		ЭтоВзрослаяКатегория = Истина;
	Иначе
		СформироватьЭлементыИзображений();
	КонецЕсли;
	
	НастроитьВидимостьЭлементов();
	ОтобразитьСтраницуЗаполненнойКарточки();

КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьЭлементов()
			
	// Команды управления изображением
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, 
		"ПредыдущаяКартинка", 
		"Видимость", 
		КэшИзображений.Количество() > КоличествоВидимыхПредварительныхИзображений);
			
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, 
		"СледующаяКартинка", 
		"Видимость", 
		КэшИзображений.Количество() > КоличествоВидимыхПредварительныхИзображений);
				
	// Артикул
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "Артикул", "Видимость", Не ПустаяСтрока(Артикул));
	
	// Категория
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "Категория", "Видимость", Не ПустаяСтрока(Категория));
	
	// 1С:Номенклатура
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "ПредставлениеНоменклатурыСервиса", "Видимость", Не ПустаяСтрока(ПредставлениеНоменклатурыСервиса));
		
	// Цена до скидки
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "ЦенаДоСкидки", "Видимость", Не ПустаяСтрока(ЦенаДоСкидкиПредставление));
	
	// Описание
	ЕстьОписаниеТовара = Не ПустаяСтрока(ОписаниеТовара);
	ЕстьДополнительноеОписание = Не ПустаяСтрока(ДополнительноеОписание);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "СтраницаОписание", "Видимость", ЕстьОписаниеТовара Или ЕстьДополнительноеОписание);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "ГруппаОписание", "Видимость", ЕстьОписаниеТовара);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "ГруппаДополнительноеОписание", "Видимость", ЕстьДополнительноеОписание);
		
	// Матрица цен
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "СтраницаМатрицаЦен", "Видимость", Цены.Количество() > 1);
		
	// Информация о поставщике
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "ТелефонКонтрагента", "Видимость", Не ПустаяСтрока(ТелефонКонтрагента));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "СайтКонтрагента", "Видимость", Не ПустаяСтрока(СайтКонтрагента));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "ЭлектроннаяПочтаКонтрагента", "Видимость", Не ПустаяСтрока(ЭлектроннаяПочтаКонтрагента));
	
	// Контактная информация
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "ГруппаКонтактнаяИнформацияИмя", "Видимость", Не ПустаяСтрока(ПредставлениеКонтакта));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "ГруппаКонтактнаяИнформацияТелефон", "Видимость", Не ПустаяСтрока(Телефон));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "ГруппаКонтактнаяИнформацияЭлектроннаяПочта", "Видимость", Не ПустаяСтрока(ЭлектроннаяПочта));
	
	// Свойства
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "СтраницаСвойства", "Видимость", Свойства.Количество() > 0);
		
	// Доставка
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "СтраницаДоставка", "Видимость", РегионыДоставки.Количество() > 0);
		
	// Самовывоз
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "СтраницаСамовывоз", "Видимость", АдресаСамовывоза.Количество() > 0);
		
	// Штрихкоды
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	 	Элементы, "СтраницаШтрихкоды", "Видимость", Штрихкоды.Количество() > 0);
		
	// Элементы управления корзиной
	НастроитьВидимостьЭлементовИКомандУправленияКорзиной(Элементы, КоличествоВКорзине);	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьЭлементовИКомандУправленияКорзиной(Элементы, КоличествоВКорзине)
	
	ЕстьТоварВКорзине = КоличествоВКорзине > 0;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДобавитьВКорзину", "Видимость", Не ЕстьТоварВКорзине);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "КоличествоВКорзине", "Видимость", ЕстьТоварВКорзине); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "УдалитьИзКорзины", "Видимость", ЕстьТоварВКорзине); 
	
КонецПроцедуры 

&НаКлиенте
Процедура ВопросПоказатьИзображениеВзрослойКатегории(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Значение = КодВозвратаДиалога.Да Тогда
		СформироватьЭлементыИзображений();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаголовок(ПараметрыВывода)
	
	Заголовок = СтрЗаменить(ПараметрыВывода.Заголовок, Символы.ПС, " ");
	Если ПустаяСтрока(Заголовок) Тогда 
		ПараметрыВывода.Заголовок = СтрШаблон(
			НСтр("ru = '%1, %2 (Торговое предложение)'", ОбщегоНазначения.КодОсновногоЯзыка()),
			ПараметрыВывода.Наименование,
			ПараметрыВывода.НаименованиеКонтрагента);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьНаименование(ПараметрыВывода)

	Если ЗначениеЗаполнено(ПараметрыВывода.Наименование) Тогда
		Наименование = ПараметрыВывода.Наименование;
	ИначеЕсли ЗначениеЗаполнено(ПараметрыВывода.Заголовок) Тогда
		Наименование = ПараметрыВывода.Заголовок;
	ИначеЕсли ЗначениеЗаполнено(ПараметрыВывода.ПредставлениеНоменклатурыСервиса) Тогда
		Наименование = СтрШаблон("%1%2", 
			ПараметрыВывода.ПредставлениеНоменклатурыСервиса, 
			?(ЗначениеЗаполнено(ПараметрыВывода.ПредставлениеХарактеристикиСервиса), 
				СтрШаблон(", %1", ПараметрыВывода.ПредставлениеХарактеристикиСервиса), 
				""));
	Иначе
		Наименование = НСтр("ru = 'не заполнено'", ОбщегоНазначения.КодОсновногоЯзыка());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзображения(ДанныеИзображений)
	
	КэшИзображений.Очистить();
	
	Если Не ЗначениеЗаполнено(ДанныеИзображений) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеИзображения Из ДанныеИзображений Цикл
		
		АдресВХранилище = ПоместитьВоВременноеХранилище(ДанныеИзображения.Значение, УникальныйИдентификатор);
		
		НоваяСтрокаКэшаИзображений = КэшИзображений.Добавить();
		НоваяСтрокаКэшаИзображений.АдресВХранилище = АдресВХранилище;
		НоваяСтрокаКэшаИзображений.РасширениеФайла = 
			ОбщегоНазначенияКлиентСервер.ПолучитьРасширениеИмениФайла(ДанныеИзображения.Представление);
			
	КонецЦикла;
				
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКатегорию(ПараметрыВывода)
	
	Если ЗначениеЗаполнено(ПараметрыВывода.ПредставлениеКатегории)
		И ЕстьПодсистемаРаботаСНоменклатурой Тогда
		Категория = ПараметрыВывода.ПредставлениеКатегории; 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписание(ПараметрыВывода)

	// Если есть описания номенклатуры из сервиса 1С:Номенклатура - используется оно, 
	// в обратном случае выводится описание номенклатуры поставщика.
	Если ЗначениеЗаполнено(ПараметрыВывода.ОписаниеНоменклатурыСервиса)
		И ЕстьПодсистемаРаботаСНоменклатурой Тогда
		ОписаниеТовара = ПараметрыВывода.ОписаниеНоменклатурыСервиса
	Иначе
		ОписаниеТовара = ПараметрыВывода.Описание;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияОписаниеТовара", "Заголовок", ОписаниеТовара);
	
	Если Не ПустаяСтрока(ПараметрыВывода.ДополнительноеОписание)
		И ПараметрыВывода.ДополнительноеОписание <> ПараметрыВывода.Описание Тогда
		ДополнительноеОписание = ПараметрыВывода.ДополнительноеОписание;	
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДекорацияДополнительноеОписание", "Заголовок", ДополнительноеОписание);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеЦен(ПараметрыВывода)

	ЦенаПредставление = ПараметрыВывода.ЦенаПубликацииСтрокой;
	Если ПустаяСтрока(ЦенаПредставление) Тогда
		ЦенаПредставление = НСтр("ru = 'По запросу'", ОбщегоНазначения.КодОсновногоЯзыка());
	КонецЕсли;
	
	// Цена до скидки.
	Если ПараметрыВывода.МатрицаЦен <> Неопределено 
		И ПараметрыВывода.МатрицаЦен.Количество() > 0 Тогда
		
		ЦенаДоСкидки = ПараметрыВывода.МатрицаЦен[0].ЦенаДоСкидки;
		Если ЗначениеЗаполнено(ЦенаДоСкидки) Тогда
			ЦенаДоСкидкиПредставление = СтрШаблон(
					"%1 %2", 
					ЦенаДоСкидки, 
					ПараметрыВывода.ВалютаПубликации);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатрицуЦен(ПараметрыВывода)
	
	Цены.Очистить();
	
	Если ПараметрыВывода.МатрицаЦен = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЦеныДляОтображения = Новый Массив;
	Для каждого ЭлементКоллекции Из ПараметрыВывода.МатрицаЦен Цикл
		
		Если ЭлементКоллекции.Цена = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЦеныДляОтображения.Добавить(ЭлементКоллекции);
		
	КонецЦикла;
	
	Если ЦеныДляОтображения.Количество() < 1  Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ЭлементКоллекции Из ЦеныДляОтображения Цикл 
		
		НоваяСтрокаЦен = Цены.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрокаЦен, ЭлементКоллекции);
				
		ПредставлениеКоличества = СтрШаблон(НСтр("ru = 'От %1 %2.'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			ЭлементКоллекции.Количество, ПараметрыВывода.КраткоеПредставлениеЕдиницыИзмерения);
		
		ПредставлениеЦены = СтрШаблон(НСтр("ru = '%1 %2'"), 
			ЭлементКоллекции.Цена, ПараметрыВывода.ВалютаПубликации);
		
		НоваяСтрокаЦен.КоличествоПредставление   = ПредставлениеКоличества;
		НоваяСтрокаЦен.ЦенаПредставление         = ПредставлениеЦены;
		
		Если ЗначениеЗаполнено(ЭлементКоллекции.ЦенаДоСкидки) Тогда
			
			ПредставлениеЦеныДоСкидки = СтрШаблон(НСтр("ru = '%1 %2'"), 
				ЭлементКоллекции.ЦенаДоСкидки, ПараметрыВывода.ВалютаПубликации);
			
			НоваяСтрокаЦен.ЦенаДоСкидкиПредставление = ПредставлениеЦеныДоСкидки;
			
		КонецЕсли;
					
	КонецЦикла;	
		
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСвойстваТорговогоПредложения(ПараметрыВывода)
	
	Свойства.Очистить();
	
	Если ПараметрыВывода.Свойства = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ЭлементКоллекции Из ПараметрыВывода.Свойства Цикл
		ЗаполнитьЗначенияСвойств(Свойства.Добавить(), ЭлементКоллекции);
	КонецЦикла;
		
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьРегионыДоставки(ПараметрыВывода) 
	
	РегионыДоставки.Очистить();
	
	Если ПараметрыВывода.РегионыДоставки = Неопределено
		Или Не ЗначениеЗаполнено(ПараметрыВывода.РегионыДоставки) Тогда
		Возврат;
	КонецЕсли;
		
	Для каждого ЭлементКоллекции Из ПараметрыВывода.РегионыДоставки Цикл 
		НоваяСтрокаРегионыДоставки = РегионыДоставки.Добавить();
		НоваяСтрокаРегионыДоставки.АдресДоставки = ЭлементКоллекции.Представление;
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьАдресаСамовывоза(ПараметрыВывода) 
	
	АдресаСамовывоза.Очистить();
	
	Если ПараметрыВывода.АдресаСамовывоза = Неопределено
		Или Не ЗначениеЗаполнено(ПараметрыВывода.АдресаСамовывоза) Тогда
		Возврат;
	КонецЕсли;
		
	Для каждого ЭлементКоллекции Из ПараметрыВывода.АдресаСамовывоза Цикл 
		НоваяСтрокаАдресСамовывоза = АдресаСамовывоза.Добавить();
		НоваяСтрокаАдресСамовывоза.АдресСамовывоза = ЭлементКоллекции.Представление;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьШтрихкоды(ПараметрыВывода)
	
	Штрихкоды.Очистить();
	
	Если Не ЗначениеЗаполнено(ПараметрыВывода.Штрихкоды) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ЭлементКоллекции Из ПараметрыВывода.Штрихкоды Цикл
		НоваяСтрокаШтрихкода = Штрихкоды.Добавить();
		НоваяСтрокаШтрихкода.Штрихкод = СокрЛП(ЭлементКоллекции); 
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКратностьУпаковки(ПараметрыВывода)

	КратностьУпаковкиЧислом = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ПараметрыВывода.КратностьУпаковки);
	Если КратностьУпаковкиЧислом = 0 Тогда
		КратностьУпаковкиЧислом = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВычислитьМинимальноеКоличествоДляЗаказа()
	
	МинимальноеКоличество = Макс(1, КратностьУпаковкиЧислом); 
	
	Если МинимальнаяСуммаЗаказаЧислом = 0 
		Или ЦенаПубликации = 0 Тогда
		Возврат;	
	КонецЕсли;

	МинимальноеКоличество = Цел(МинимальнаяСуммаЗаказаЧислом/ЦенаПубликации); 
	Пока МинимальноеКоличество % КратностьУпаковкиЧислом <> 0 Цикл
		МинимальноеКоличество = МинимальноеКоличество + 1;	
	КонецЦикла;
			
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПредставлениеНДСКорзина(ПараметрыВывода)
	
	ПредставлениеНДСКорзина = СтрШаблон(
		НСтр("ru = 'НДС %1'", ОбщегоНазначения.КодОсновногоЯзыка()), 
		ПараметрыВывода.ИнформацияНДС);
	МассивСтрок = СтрРазделить(ПредставлениеНДСКорзина, ",", Ложь);
	ПредставлениеНДСКорзина = СтрСоединить(МассивСтрок, Символы.ПС);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "НадписьНДСКорзина", "Заголовок", ПредставлениеНДСКорзина); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьИсточникДанныхПоУмолчанию()
	ИсточникДанных = ТорговыеПредложенияСлужебныйКлиентСервер.ИсточникиДанныхТорговогоПредложения().Сервис;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПараметрыФормы()
	
	Идентификатор = Параметры.Идентификатор;
	Параметры.Свойство("ИдентификаторЗаказа", ИдентификаторЗаказа);
	Параметры.Свойство("Организация", Организация);
	Параметры.Свойство("Валюта", Валюта);
	Параметры.Свойство("ИсточникДанных", ИсточникДанных);
	Параметры.Свойство("ПрайсЛист", ПрайсЛист);
	Параметры.Свойство("Упаковка", Упаковка);
	Параметры.Свойство("Номенклатура", Номенклатура);
	Параметры.Свойство("Характеристика", Характеристика);
	
КонецПроцедуры

&НаСервере
Функция ПозицияТорговогоПредложенияЕстьВПараметрахОповещения(ПараметрыОповещения)
	
	Результат = Ложь;
	
	КонтрольнаяСуммаТекущейПозицииТорговогоПредложения = 
		ОбщегоНазначения.КонтрольнаяСуммаСтрокой(ПозицияТорговогоПредложенияДляДиагностики);
	
	ОбновленныеПозицииТорговыхПредложений = 
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОповещения, "ПозицииТорговыхПредложений");
	Если ОбновленныеПозицииТорговыхПредложений <> Неопределено Тогда
		Для Каждого ОбновленнаяПозиция Из ОбновленныеПозицииТорговыхПредложений Цикл
			КонтрольнаяСуммаОбновленнойПозиции = ОбщегоНазначения.КонтрольнаяСуммаСтрокой(ОбновленнаяПозиция);
			Если КонтрольнаяСуммаОбновленнойПозиции = КонтрольнаяСуммаТекущейПозицииТорговогоПредложения Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Не Результат Тогда
		ОбновленныйПрайсЛист = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОповещения, "ПрайсЛист");
		Если ОбновленныйПрайсЛист = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		Если ОбновленныйПрайсЛист = ПозицияТорговогоПредложенияДляДиагностики.ПрайсЛист Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ТребуетсяОбновитьДанныеКарточкиПослеДиагностики(ПараметрыОповещения)
	
	Результат = Ложь;
	
	Если ПараметрыОповещения = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВыполненаПроверкаДанных = 
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыОповещения, "ВыполненаПроверкаДанных", Ложь);
		
	Если Не ВыполненаПроверкаДанных Тогда
		Возврат Результат;
	КонецЕсли;

	Если Не ПозицияТорговогоПредложенияЕстьВПараметрахОповещения(ПараметрыОповещения) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Истина;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти