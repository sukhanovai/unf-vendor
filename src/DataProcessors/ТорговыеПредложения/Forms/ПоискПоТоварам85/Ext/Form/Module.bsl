
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НавигационнаяСсылка = СтрШаблон("e1cib/app/%1", ИмяФормы);
	
	УстановитьУсловноеОформление();
	
	Если Не ТорговыеПредложения.ПравоПоискаТорговыхПредложений(Истина) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Параметры.ПараметрыКоманды <> Неопределено Тогда
		ЗаполнитьПоКонтексту(Параметры.ПараметрыКоманды);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		ТорговыеПредложенияПереопределяемый.ПолучитьВалютуРегламентированногоУчета(Валюта);
	КонецЕсли;
	Элементы.ИзменитьВалютуПоиска.Заголовок = СтрШаблон(НСтр("ru = '%1'"), Валюта);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Параметры.Свойство("Организация", Организация);
	КонецЕсли;
	
	// Заполнение сохраненными настройками.
	НастройкиПоискаПоТоварам = ТорговыеПредложения.СохраненныеНастройкиПоискаПоТоварам();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиПоискаПоТоварам);
	
	ИдентификаторЗаказа = УникальныйИдентификатор;
	
	ОбновитьНадписьПодобраноТоваров(ЭтотОбъект);
	
	ИмяСправочника = ОбщегоНазначенияБЭД.ИмяПрикладногоСправочника("Номенклатура");
	ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + ИмяСправочника);
	Элементы.СписокНоменклатура.ОграничениеТипа = ОграничениеТипа;
	
	ИмяСправочника = ОбщегоНазначенияБЭД.ИмяПрикладногоСправочника("ХарактеристикиНоменклатуры");
	ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка." + ИмяСправочника);
	Элементы.СписокХарактеристика.ОграничениеТипа = ОграничениеТипа;
	Элементы.СписокХарактеристика.Видимость = ТорговыеПредложения.НастройкиПодсистемы().ИспользоватьХарактеристики;
	
	ИмяСправочникаЕдиницыИзмерения = ОбщегоНазначенияБЭД.ИмяПрикладногоСправочника("ЕдиницыИзмерения");
	ОграничениеТипаИмяСправочникаЕдиницыИзмерения = Новый ОписаниеТипов("Строка, СправочникСсылка." + ИмяСправочникаЕдиницыИзмерения);
	Элементы.СписокНоменклатураЕдиницаИзмерения.ОграничениеТипа = ОграничениеТипаИмяСправочникаЕдиницыИзмерения;
	Элементы.СписокУпаковка.ОграничениеТипа = ОграничениеТипаИмяСправочникаЕдиницыИзмерения;
	
	// Проверка владельца упаковки.
	Если Метаданные.Справочники[ИмяСправочникаЕдиницыИзмерения].Владельцы.Количество() Тогда
		НовыйМассив = Новый Массив;
		Для каждого ВладелецУпаковки Из Метаданные.Справочники[ИмяСправочникаЕдиницыИзмерения].Владельцы Цикл
			НовыйМассив.Добавить(Новый СвязьПараметраВыбора(ВладелецУпаковки.Имя, "Элементы.Список.ТекущиеДанные.Номенклатура"));
		КонецЦикла;
		НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);
		Элементы.СписокУпаковка.СвязиПараметровВыбора = НовыеСвязи;
	КонецЕсли;
	
	БизнесСеть.ЗаполнитьРегионыПоиска(
		"ТорговыеПредложения",
		Организация,
		РегионПоиска, 
		Элементы.ФормаВыборРегиона.Заголовок, 
		ИдентификаторыРегионов);

	ТорговыеПредложенияПереопределяемый.ПриСозданииНаСервере(ЭтотОбъект);
	
	УстановитьВидимостьДоступность(); 
	
	ЗаполнитьИменаКолонокПредложенийПоставщиков();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	ДополнительныеПараметры = Новый Структура("ИмяФормы");
	ЗаполнитьЗначенияСвойств(ДополнительныеПараметры, ИсточникВыбора);
	ОбработкаВыбораНаСервере(ВыбранноеЗначение, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ТорговыеПредложения_ИзменитьКоличествоВЗаказе"
		И Параметр.ИдентификаторЗаказа = ИдентификаторЗаказа Тогда 
		
		Отбор = Новый Структура("Идентификатор", Параметр.Идентификатор);
		НайденныеСтрокиПредложенийПоставщиков = ПредложенияПоставщиков.НайтиСтроки(Отбор);
		Если НайденныеСтрокиПредложенийПоставщиков.Количество() = 0 Тогда 
			Возврат;
		КонецЕсли;
		
		СтрокаПредложенияПоставщика = НайденныеСтрокиПредложенийПоставщиков[0];
		УстановитьВыбранноеПредложение(СтрокаПредложенияПоставщика, Истина);
		ПересчитатьСводныеДанные();
		
	ИначеЕсли ИмяСобытия = "ТорговыеПредложения_УдалитьИзЗаказа"
		И Параметр.ИдентификаторЗаказа = ИдентификаторЗаказа Тогда
				
		Для каждого Идентификатор Из Параметр.ИдентификаторыПредложений Цикл 

			Отбор = Новый Структура("Идентификатор", Идентификатор);
			НайденныеСтрокиПредложенийПоставщиков = ПредложенияПоставщиков.НайтиСтроки(Отбор);
			Если НайденныеСтрокиПредложенийПоставщиков.Количество() = 0 Тогда 
				Продолжить;
			КонецЕсли;
			
			СтрокаПредложенияПоставщика = НайденныеСтрокиПредложенийПоставщиков[0];
			УстановитьВыбранноеПредложение(СтрокаПредложенияПоставщика, Ложь);
			
		КонецЦикла;
		
		ПересчитатьСводныеДанные();
		
	ИначеЕсли ИмяСобытия = "ТорговыеПредложения_ОтправленыЗаказыТоваров"
		И Параметр.Свойство("ИдентификаторЗаказа")
		И Параметр.ИдентификаторЗаказа = ИдентификаторЗаказа Тогда
		
		// Очистка товаров.
		СписокУдаляемыхСтрок = Новый Массив;
		Для каждого СтрокаСписка Из Список Цикл
			Если СтрокаСписка.Пометка Тогда
				СписокУдаляемыхСтрок.Добавить(СтрокаСписка);
			КонецЕсли;
		КонецЦикла;
		
		Для каждого СтрокаСписка Из СписокУдаляемыхСтрок Цикл
			Список.Удалить(Список.Индекс(СтрокаСписка));
		КонецЦикла;
		ОчиститьСводнуюИнформациюПоПредложениям();
		
		ПересчитатьСводныеДанные();
		
	ИначеЕсли ИмяСобытия = "КопированиеСтрокВБуферОбмена" ИЛИ ИмяСобытия = "ПодборПроизведен" Тогда
		
		ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр)
	
	ТорговыеПредложенияПереопределяемый.ОбработатьОповещение(ИмяСобытия, Параметр, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Список.Количество() Тогда
		НайтиТорговыеПредложения();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КомандаПодсказкиНажатие(Элемент)
	
	// Приглашение поставщиков в сервис.
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РежимПриглашения", "Поставщики");
	ПараметрыОткрытия.Вставить("Организация", Организация);
	ОчиститьСообщения();
	ОткрытьФорму("Обработка.БизнесСеть.Форма.ОтправкаПриглашенийКонтрагентам", ПараметрыОткрытия);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОчиститьСообщения();
	
	Если Поле.Имя = "СписокКоличество" Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные; 
	Если ПустаяСтрока(ТекущиеДанные.Идентификатор) Тогда
		Возврат;
	КонецЕсли;
		
	ПараметрыОткрытия = ТорговыеПредложенияКлиент.НовыеПараметрыОткрытияФормыТорговогоПредложения();
	ПараметрыОткрытия.Идентификатор = ТекущиеДанные.Идентификатор;
	ПараметрыОткрытия.Валюта = Валюта;
	ПараметрыОткрытия.ИдентификаторЗаказа = ИдентификаторЗаказа;
	ПараметрыОткрытия.Номенклатура = ТекущиеДанные.Номенклатура;
	ПараметрыОткрытия.Характеристика = ТекущиеДанные.Характеристика;
	ТорговыеПредложенияКлиент.ОткрытьТорговоеПредложение(ПараметрыОткрытия, ЭтотОбъект, ТекущиеДанные.Идентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ПредложенияПоставщиков.ОтборСтрок = 
		Новый ФиксированнаяСтруктура("ИдентификаторСтрокиСписка, Отображать", ТекущиеДанные.ИдентификаторСтроки, Истина);
	
	СформироватьСводнуюИнформациюПоПредложениямТовара();
	
	Если ВсегоПредложений = 0 Тогда
		ТекущаяСтраницаПредложений = Элементы.СтраницаНеНайденыПредложения;
	Иначе
		ТекущаяСтраницаПредложений = Элементы.СтраницаСписокПредложений;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СтраницыПредложенияПоставщиков", "ТекущаяСтраница", ТекущаяСтраницаПредложений);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПослеУдаления(Элемент)
	
	Контрагенты.Очистить();
	НайтиТорговыеПредложения();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, РеквизитыНоменклатуры(ТекущиеДанные.Номенклатура));
		Контрагенты.Очистить();
		АвтовыборПоСценарию("СнятьПометки");
		НайтиТорговыеПредложения();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторКонтрагента) Тогда
		Возврат;
	КонецЕсли;
		
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.ЦенаПредложения;
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Пометка = Ложь;
	КонецЕсли;
	
	ВыбраннаяСтрокаПредложения = СтрокаПредложенийПоИдентификаторуСтрокиСписка(ТекущиеДанные.ИдентификаторСтроки);
	УстановитьВыбранноеПредложение(ВыбраннаяСтрокаПредложения, ТекущиеДанные.Пометка);
	ПересчитатьСводныеДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриИзменении(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторСтроки) Тогда
		ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоставщики

&НаКлиенте
Процедура ПоставщикиПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Контрагенты.ТекущиеДанные;
	Отбор = Новый Структура("ИдентификаторКонтрагента", ТекущиеДанные.Идентификатор);
	ПредложенияПоставщика = ПредложенияПоставщиков.НайтиСтроки(Отбор);
	Для каждого СтрокаПредложения Из ПредложенияПоставщика Цикл
		СтрокаПредложения.Отображать = ТекущиеДанные.Пометка;
	КонецЦикла;
		
КонецПроцедуры 

&НаКлиенте
Процедура КонтрагентыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
    ТекущиеДанные = Элемент.ТекущиеДанные; 
	
	ПараметрыОткрытия = БизнесСетьКлиентСервер.ОписаниеИдентификацииОрганизацииКонтрагентов();
	ПараметрыОткрытия.ИНН = ТекущиеДанные.ИНН;
	ПараметрыОткрытия.КПП = ТекущиеДанные.КПП;
	БизнесСетьСлужебныйКлиент.ОткрытьПрофильУчастника(ПараметрыОткрытия);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПредложенияПоставщиков

&НаКлиенте
Процедура ПредложенияПоставщиковПометкаПриИзменении(Элемент)
	
    ТекущиеДанные = Элементы.ПредложенияПоставщиков.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	УстановитьВыбранноеПредложение(ТекущиеДанные, ТекущиеДанные.Пометка);
	ПересчитатьСводныеДанные();
	
КонецПроцедуры
	
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиПредложения(Команда)
	
	НайтиТорговыеПредложения();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОтправитьЗаказы(Команда)
	
	ОткрытьФормуОформленияЗаказов();
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьВыбранные(Команда)
	
	Пометка = Не Элементы.ФормаСкрытьВыбранные.Пометка;
	Элементы.ФормаСкрытьВыбранные.Пометка = Пометка;
	
	УстановитьОтборПоНеобработанным(Пометка);
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоставщиков(Команда)
	
	Пометка = Не Элементы.ФормаСкрытьПоставщиков.Пометка;
	Элементы.ФормаСкрытьПоставщиков.Пометка = Пометка;
	Элементы.ГруппаОхватыПоставщиков.Видимость = Не Пометка;

КонецПроцедуры

&НаКлиенте
Процедура АвтоподборПоМинимальнойЦене(Команда)
	
	АвтовыборПоСценарию("Цена");
	
КонецПроцедуры

&НаКлиенте
Процедура АвтоподборПоСрокам(Команда)
	
	АвтовыборПоСценарию("СрокПоставки");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИсходящиеДокументы(Команда)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РежимИсходящихДокументов", Истина);
	ОчиститьСообщения();
	ОткрытьФорму("Обработка.БизнесСеть.Форма.ДокументыОбмена", ПараметрыОткрытия);

КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	АвтовыборПоСценарию("СнятьПометки");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборРегиона(Команда)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("РегионРежимОтбора",   РегионПоиска.РежимОтбора);
	ПараметрыОткрытия.Вставить("РегионПредставление", РегионПоиска.Представление);
	ПараметрыОткрытия.Вставить("РегионЗначенияПолей", РегионПоиска.ЗначенияПолей);
	ПараметрыОткрытия.Вставить("Организация",         Организация);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборРегионаЗавершение", ЭтотОбъект);
	
	ОчиститьСообщения();
	
	ОткрытьФорму("Обработка.ТорговыеПредложения.Форма.ВыборРегионаПоиска", 
		ПараметрыОткрытия, 
		ЭтотОбъект,,,, 
		ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПереопределяемаяКоманда(Команда)
	
	ТорговыеПредложенияКлиентПереопределяемый.ОбработатьКомандуФормы(ЭтотОбъект, Команда);
	ОбновитьНадписьПодобраноТоваров(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьПоиск(Команда)
	
	Обработчик = Новый ОписаниеОповещения("НастройкаПоискаПоТоварамЗавершение", ЭтотОбъект);
	ОткрытьФорму("Обработка.ТорговыеПредложения.Форма.НастройкаПоискаПоТоварам",,,,,, Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВалютуПоиска(Команда)
	
	Если Список.НайтиСтроки(Новый Структура("Пометка", Истина)).Количество() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ИзменитьВалютуПоискаПродолжение", ЭтотОбъект),
			НСтр("ru = 'При изменении валюты, будут удалены подобранные товары и выполнен новый поиск торговых предложений.'"),
			РежимДиалогаВопрос.ОКОтмена);
	Иначе
		ИзменитьВалютуПоискаПродолжение(КодВозвратаДиалога.ОК, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьПредложенияВсехПоставщиков(Команда)
	
	Для каждого СтрокаКонтрагента Из Контрагенты Цикл
		СтрокаКонтрагента.Пометка = Истина;
	КонецЦикла;
	
  	Для каждого СтрокаПредложения Из ПредложенияПоставщиков Цикл
		СтрокаПредложения.Отображать = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СкрыватьПредложенияВсехПоставщиков(Команда)
	
	Для каждого СтрокаКонтрагента Из Контрагенты Цикл
		СтрокаКонтрагента.Пометка = Ложь;
	КонецЦикла;

	Для каждого СтрокаПредложения Из ПредложенияПоставщиков Цикл
		СтрокаПредложения.Отображать = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПредложенияНаФормеПоиска(Команда)
	ОбработатьОткрытиеПредложенийНаФормеПоиска();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастройкаПоискаПоТоварамЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Результат, "НастройкиИзменены", Ложь) Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Результат);
		
		// Сброс количество предложений, загруженных ранее
		Для каждого ЭлементКоллекции Из Список Цикл
			ЭлементКоллекции.КоличествоПредложений = 0;
		КонецЦикла;
		ОчиститьСводнуюИнформациюПоПредложениям();
		
		НайтиТорговыеПредложения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиТорговыеПредложенияВФоне(Знач ИдентификаторФормы, Отказ)
	
	Контрагенты.Очистить();
	
	ПараметрыЗапроса = ТорговыеПредложенияСлужебный.НовыеПараметрыПоискаТорговыхПредложенийПоСписку();
	ЗаполнитьПараметрыЗапроса(ПараметрыЗапроса, Отказ);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = 
		НСтр("ru = '1С:Бизнес-сеть. Поиск торговых предложений по списку.'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ТорговыеПредложенияСлужебный.ПоискТорговыхПредложенийПоСпискуВФоне",
		ПараметрыЗапроса,
		ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПараметрыЗапроса(ПараметрыЗапроса, Отказ)
	
	ПараметрыЗапроса.Организация = Организация;
	ПараметрыЗапроса.КоличествоКонтрагентов = ОграничениеТорговыхПредложений;
	ПараметрыЗапроса.ОтклонениеЦены = ПревышениеМинимальнойЦены;
	ПараметрыЗапроса.СрокОтгрузки = МаксимальныйСрокПоставки;
	ПараметрыЗапроса.Валюта = Валюта;
	
	Товары = РеквизитФормыВЗначение("Список");
	Если ПоискПоНоменклатуреСервиса Тогда
		ТорговыеПредложенияСлужебный.ПолучитьИдентификаторыНоменклатурыСервиса(Товары);
	КонецЕсли;
	
	ТорговыеПредложенияПереопределяемый.ДобавитьСлужебныеКолонкиТовары(Товары, ПоискПоШтрихКоду);
	
	НомераСтрокПоиска.Очистить(); // Соответствие номеров строк поиска и номеров строк списка.
	Для каждого СтрокаСписка Из Товары Цикл
		
		ПоискЗаполнен = Ложь;
		НоваяСтрока = ПараметрыЗапроса.Товары.Добавить();
		
		Если ПоискПоНаименованию И ПоискПоХарактеристике И ЗначениеЗаполнено(СтрокаСписка.Характеристика) Тогда
			НоваяСтрока.Наименование = Строка(СтрокаСписка.Номенклатура) + ?(ПустаяСтрока(СтрокаСписка.Характеристика), "", " ")
				+ Строка(СтрокаСписка.Характеристика);
			ПоискЗаполнен = Истина;
		ИначеЕсли ПоискПоНаименованию Тогда
			
			НоваяСтрока.Наименование = Строка(СтрокаСписка.Номенклатура);
			
			Если НЕ ПустаяСтрока(НоваяСтрока.Наименование) Тогда
				ПоискЗаполнен = Истина;
			КонецЕсли; 
			
		КонецЕсли;
		
		Если ПоискПоАртикулу И ЗначениеЗаполнено(СтрокаСписка.Артикул) Тогда
			НоваяСтрока.Артикулы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаСписка.Артикул);
			ПоискЗаполнен = Истина;
		КонецЕсли;
		
		Если ПоискПоШтрихКоду Тогда
			СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Упаковка",
				СтрокаСписка.Номенклатура, СтрокаСписка.Характеристика, СтрокаСписка.Упаковка);
			СтрокаШтрихкоды = Товары.НайтиСтроки(СтруктураПоиска);
			Если СтрокаШтрихкоды.Количество() = 1 И ЗначениеЗаполнено(СтрокаШтрихкоды[0].Штрихкоды) Тогда
				НоваяСтрока.Штрихкоды = СтрокаШтрихкоды[0].Штрихкоды;
				ПоискЗаполнен = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ПоискПоНоменклатуреСервиса И ЗначениеЗаполнено(СтрокаСписка.ИдентификаторНоменклатурыСервиса) Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСписка, "ИдентификаторНоменклатурыСервиса, ИдентификаторХарактеристикиСервиса");
			ПоискЗаполнен = Истина;
		КонецЕсли;
		
		Если ПоискЗаполнен Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСписка,	"ЕдиницаИзмерения, Количество");
			СтрокаИдентификаторовПоиска = НомераСтрокПоиска.Добавить();
			СтрокаИдентификаторовПоиска.НомерСтрокиСписка = Товары.Индекс(СтрокаСписка);
			СтрокаИдентификаторовПоиска.НомерСтрокиПоиска = ПараметрыЗапроса.Товары.Количество() - 1;
		Иначе
			ПараметрыЗапроса.Товары.Удалить(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПараметрыЗапроса.Товары.Количество() = 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// Регионы.
	Если (ЗначениеЗаполнено(РегионПоиска) И РегионПоиска.РежимОтбора <> 0)
		И ИдентификаторыРегионов.Количество() Тогда
		
		ЗначениеИдентификаторыРегионов =РеквизитФормыВЗначение("ИдентификаторыРегионов", Тип("ТаблицаЗначений"));
		Для каждого ЭлементКоллекции Из ЗначениеИдентификаторыРегионов Цикл
			Если ЭлементКоллекции.ДляСамовывоза	ИЛИ ЭлементКоллекции.ДляДоставки Тогда
				НастройкиРегионов = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ЭлементКоллекции);
				ПараметрыЗапроса.РегионыПоиска.Добавить(НастройкиРегионов);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Товары, "Список");
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиТорговыеПредложенияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Отказ = Ложь;
	
	ТорговыеПредложенияКлиент.ОбработатьОшибкиФоновогоЗадания(Результат, Отказ);
	
	Если Не Отказ И Результат <> Неопределено И Результат.Статус = "Выполнено" Тогда
		
		Если ЗначениеЗаполнено(Результат.АдресРезультата) 
			И ЭтоАдресВременногоХранилища(Результат.АдресРезультата)
			И ИдентификаторЗадания = ДополнительныеПараметры.ИдентификаторЗадания Тогда
			
			ЗагрузитьРезультатыПоиска(Результат.АдресРезультата);
			
			Если Контрагенты.Количество() = 0 Тогда
				
				ПоказатьДиалогОшибкиПоиска();
				
			КонецЕсли;
			
			УстановитьОтборПоНеобработанным();
			
		КонецЕсли;
		
		ИдентификаторЗадания = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРезультатыПоиска(АдресРезультата)
			
	Результат = БизнесСеть.ПолучитьУдалитьИзВременногоХранилища(АдресРезультата); 
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ОчиститьТаблицы();
	
	// Заполнить данные статистики по строкам заказа
	Для каждого СтрокаСтатистики Из Результат.Статистика Цикл
		СтрокаСписка = Список.Получить(СтрокаСтатистики.НомерСтроки);
		ЗаполнитьСтатистикуПоСтрокеСписка(СтрокаСписка, СтрокаСтатистики);
	КонецЦикла;
	
	// Заполнить данные контрагентов, по которым есть предложения 
	Для каждого СтрокаТаблицыКонтрагентов Из Результат.Контрагенты Цикл
		
		ЗаполнитьНовуюСтрокуКонтрагентов(Контрагенты.Добавить(), СтрокаТаблицыКонтрагентов);
				
		Для каждого ЭлементНайденныхСтрок Из СтрокаТаблицыКонтрагентов.НайденныеСтроки Цикл
			
			Если ЭлементНайденныхСтрок.Товары.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			ОтборСтрокПоиска = Новый Структура("НомерСтрокиПоиска", ЭлементНайденныхСтрок.НомерСтроки);
			НайденныеНомераСтрокПоиска = НомераСтрокПоиска.НайтиСтроки(ОтборСтрокПоиска);
			Если НайденныеНомераСтрокПоиска.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			ЭлементНомеровСтрокПоиска = НайденныеНомераСтрокПоиска[0];
			
			СтрокаСписка = Список[ЭлементНомеровСтрокПоиска.НомерСтрокиСписка];
			СтрокаТоваров = ЭлементНайденныхСтрок.Товары[0]; 
			
			// Заполнить предложения для строки заказа
			ЗаполнитьПредложенияСтроки(ЭлементНайденныхСтрок.Товары, СтрокаСписка);
			
			Если Не ЗначениеЗаполнено(СтрокаСписка.ПоставщикПредложения) Тогда
				// Заполнить выбранное предложение для строки заказа
				ЗаполнитьВыбранноеПредложение(СтрокаСписка, СтрокаТоваров, МаксимальныйСрокПоставки, ПревышениеМинимальнойЦены); 
			КонецЕсли;

		КонецЦикла;
	
	КонецЦикла;
	
   	АвтовыборПоСценарию("Цена");
	
КонецПроцедуры 

&НаСервере
Процедура ОчиститьТаблицы()
	Контрагенты.Очистить();
	ПредложенияПоставщиков.Очистить();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатистикуПоСтрокеСписка(СтрокаСписка, СтрокаСтатистики)
	
	Если ЗначениеЗаполнено(СтрокаСтатистики.МинимальнаяЦена) Тогда
		СтрокаСписка.МинимальнаяЦена = СтрокаСтатистики.МинимальнаяЦена  / 100;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаСтатистики.МаксимальнаяЦена) Тогда
		СтрокаСписка.МаксимальнаяЦена = СтрокаСтатистики.МаксимальнаяЦена / 100;
	КонецЕсли;
	
	СтрокаСписка.КоличествоПредложений    = СтрокаСтатистики.КоличествоПредложений;
	СтрокаСписка.МинимальныйСрокПоставки  = СтрокаСтатистики.МинимальныйСрокПоставки;
	СтрокаСписка.МаксимальныйСрокПоставки = СтрокаСтатистики.МаксимальныйСрокПоставки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНовуюСтрокуКонтрагентов(НоваяСтрока, ДанныеЗаполнения)
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения);
	
	НоваяСтрока.Идентификатор = ДанныеЗаполнения.ИдентификаторКонтрагента;		
	НоваяСтрока.ИНН = ДанныеЗаполнения.ИННКонтрагента;
	НоваяСтрока.КПП = ДанныеЗаполнения.КППКонтрагента;
	НоваяСтрока.Наименование = ДанныеЗаполнения.НаименованиеКонтрагента;
	НоваяСтрока.Пометка = Истина; 

КонецПроцедуры 

&НаКлиенте
Процедура УстановитьВыбранноеПредложение(СтрокаПредложений, ЗначениеПометки)
	
	СтрокаПредложений.Пометка = ЗначениеПометки;
	
	ИдентификаторТекущейСтроки = СтрокаПредложений.ПолучитьИдентификатор();
	ОтборПредложенийСтроки = Новый Структура("ИдентификаторСтрокиСписка", СтрокаПредложений.ИдентификаторСтрокиСписка);
	НайденныеСтрокиПредложений = ПредложенияПоставщиков.НайтиСтроки(ОтборПредложенийСтроки);
	
	Для каждого СтрокаПредложения Из НайденныеСтрокиПредложений Цикл
		
		Если СтрокаПредложения.ПолучитьИдентификатор() <> ИдентификаторТекущейСтроки Тогда
			СтрокаПредложения.Пометка = Ложь;
			Продолжить;	
		КонецЕсли;
		
		ОтборТекущейСтрокиСписка = Новый Структура("ИдентификаторСтроки", СтрокаПредложений.ИдентификаторСтрокиСписка);
		СтрокаСписка = Список.НайтиСтроки(ОтборТекущейСтрокиСписка)[0];
		Если СтрокаПредложений.Пометка
			И КоличествоСоответствуетКратностиУпаковки(СтрокаСписка, СтрокаПредложения) Тогда
			ЗаполнитьВыбранноеПредложение(СтрокаСписка, СтрокаПредложения, МаксимальныйСрокПоставки, ПревышениеМинимальнойЦены);
		Иначе
			СтрокаПредложений.Пометка = Ложь;
			ОтменитьВыбранноеПредложениеДляСтроки(СтрокаСписка);
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Функция КоличествоСоответствуетКратностиУпаковки(СтрокаСписка, СтрокаПредложения, ВыводитьСообщение = Истина)
	
	Результат = СтрокаСписка.Количество % СтрокаПредложения.КратностьУпаковки = 0;
	
	Если Не Результат
		И ВыводитьСообщение Тогда
		
		ШаблонСообщения = 
			НСтр("ru = 'Количество товара ""%1"" для заказа у ""%2"" должно быть кратно %3.'");
			
		НаименованиеПозиции = Строка(СтрокаСписка.Номенклатура);
		Если ЗначениеЗаполнено(СтрокаСписка.Характеристика) Тогда
			НаименованиеПозиции = СтрШаблон("%1, %2", НаименованиеПозиции, СтрокаСписка.Характеристика);
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(
			ШаблонСообщения, 
			НаименованиеПозиции,
			СтрокаПредложения.НаименованиеКонтрагента,
			СтрокаПредложения.КратностьУпаковки);
		
		#Если Сервер Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		#Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		#КонецЕсли
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьВыбранноеПредложение(СтрокаСписка, 
	СтрокаТоваров, МаксимальныйСрокПоставки, ПревышениеМинимальнойЦены) 
	
	СтрокаСписка.Пометка = Истина;
	СтрокаСписка.ПоставщикПредложения = СтрокаТоваров.НаименованиеКонтрагента;
	СтрокаСписка.ЦенаПредложения = СтрокаТоваров.Цена;
	СтрокаСписка.СрокПоставкиПредложения = СтрокаТоваров.СрокПоставки;
	СтрокаСписка.Идентификатор = СтрокаТоваров.Идентификатор;
	СтрокаСписка.ИдентификаторКонтрагента = СтрокаТоваров.ИдентификаторКонтрагента;
	СтрокаСписка.КратностьУпаковки = СтрокаТоваров.КратностьУпаковки;
	
	СтрокаСписка.ЭтоПредложениеСЛучшейЦеной = 
		ЗначениеЗаполнено(СтрокаТоваров.Цена)
		И СтрокаТоваров.Цена < СтрокаСписка.МинимальнаяЦена * (1 + ПревышениеМинимальнойЦены/100);
	
	СтрокаСписка.ЭтоПредложениеСЛучшимСрокомПоставки = 
		ЗначениеЗаполнено(СтрокаТоваров.СрокПоставки)
		И СтрокаСписка.СрокПоставкиПредложения <= МаксимальныйСрокПоставки;
		
	СтрокаСписка.Сумма = СтрокаСписка.Количество * СтрокаСписка.ЦенаПредложения;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОтменитьВыбранноеПредложениеДляСтроки(СтрокаСписка)
	
	СтрокаСписка.Пометка = Ложь;
	СтрокаСписка.ПоставщикПредложения = "";
	СтрокаСписка.ЦенаПредложения = 0;
	СтрокаСписка.СрокПоставкиПредложения = Неопределено;
	СтрокаСписка.Идентификатор = "";
	СтрокаСписка.ИдентификаторКонтрагента = "";
	СтрокаСписка.ЭтоПредложениеСЛучшейЦеной = Ложь;
	СтрокаСписка.ЭтоПредложениеСЛучшимСрокомПоставки = Ложь;
	СтрокаСписка.Сумма = 0;
	СтрокаСписка.КратностьУпаковки = 0;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредложенияСтроки(Предложения, СтрокаСписка) 
		
	Для каждого СтрокаПредложения Из Предложения Цикл
		
		НоваяСтрокаПредложения = ПредложенияПоставщиков.Добавить();
		НоваяСтрокаПредложения.ИдентификаторСтрокиСписка = СтрокаСписка.ИдентификаторСтроки; 
		НоваяСтрокаПредложения.Идентификатор = СтрокаПредложения.Идентификатор;
		НоваяСтрокаПредложения.ИдентификаторКонтрагента = СтрокаПредложения.ИдентификаторКонтрагента;
		НоваяСтрокаПредложения.НаименованиеКонтрагента = СтрокаПредложения.НаименованиеКонтрагента;
		НоваяСтрокаПредложения.Цена = СтрокаПредложения.Цена;
		НоваяСтрокаПредложения.СрокПоставки = СтрокаПредложения.СрокПоставки;
		НоваяСтрокаПредложения.Отображать = Истина;
		НоваяСтрокаПредложения.КратностьУпаковки = СтрокаПредложения.КратностьУпаковки;

		Если ЗначениеЗаполнено(СтрокаПредложения.Цена) Тогда
			НоваяСтрокаПредложения.ЭтоПредложениеСЛучшейЦеной =
				СтрокаПредложения.Цена < СтрокаСписка.МинимальнаяЦена * (1 + ПревышениеМинимальнойЦены/100);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаПредложения.СрокПоставки) Тогда
			НоваяСтрокаПредложения.ЭтоПредложениеСЛучшимСрокомПоставки = 
				СтрокаПредложения.СрокПоставки <= МаксимальныйСрокПоставки;
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьНадписьПодобраноТоваров(Форма)
	
	ВыбранныеСтроки = Форма.Список.НайтиСтроки(Новый Структура("Пометка", Истина));
	КоличествоТоваров = ВыбранныеСтроки.Количество();
	Форма.СуммаВсего = Форма.Список.Итог("Сумма");
	
	Если КоличествоТоваров = 0 Тогда
		Форма.НадписьПодобраноТоваров = НСтр("ru = 'Отсутствуют товары для заказа'");
	ИначеЕсли Форма.СуммаВсего <> 0 Тогда
		Форма.НадписьПодобраноТоваров = СтрШаблон(НСтр("ru = 'Подобрано предложений для %1 поз. из %2 на сумму %3 %4'"),
			КоличествоТоваров, Форма.Список.Количество(), Форма.СуммаВсего, Форма.Валюта);
	Иначе // Для суммы = 0.
		Форма.НадписьПодобраноТоваров = СтрШаблон(НСтр("ru = 'Подобрано предложений для %1 поз. из %2'"),
			КоличествоТоваров, Форма.Список.Количество());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСводныеДанные()
	
	СуммаВсего = Список.Итог("Сумма");
	ОбновитьНадписьПодобраноТоваров(ЭтотОбъект);
	ОбновитьПоказателиПоставщиков(Контрагенты, ПредложенияПоставщиков);
 	УстановитьОтборПоНеобработанным();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОформленияЗаказов(РежимЗапросаЦен = Ложь)
	
	ВыбранныеСтроки = Список.НайтиСтроки(Новый Структура("Пометка", Истина));
	
	Если Не ЗначениеЗаполнено(ВыбранныеСтроки) Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Необходимо выбрать позиции'"));
		Возврат;
	КонецЕсли;
	
	ДанныеПредложений = Новый Массив;
	
	Для Каждого СтрокаСписка Из ВыбранныеСтроки Цикл
		
		Если Не СтрокаСписка.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаСписка.Количество = 0 Тогда
			ПоказатьПредупреждение( , НСтр("ru = 'Не указано количество потребности'"));
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(СтрокаСписка.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыПредложения = ТорговыеПредложенияСлужебныйКлиент.НовыйПараметрыПредложения();
		ПараметрыПредложения.ИдентификаторПредложения = СтрокаСписка.Идентификатор;
		ПараметрыПредложения.Количество = СтрокаСписка.Количество;
		ПараметрыПредложения.Наименование = Строка(СтрокаСписка.Номенклатура);
		ДанныеПредложений.Добавить(ПараметрыПредложения);
		
	КонецЦикла;
	
	СоздатьКорзинуДобавитьТовары(ДанныеПредложений);
	
КонецПроцедуры

// Создать корзину добавить товары.
// 
// Параметры:
//  ДанныеПредложений - Массив Из см. ТорговыеПредложенияСлужебныйКлиент.НовыйПараметрыПредложения
//
&НаКлиенте
Процедура СоздатьКорзинуДобавитьТовары(ДанныеПредложений)
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеСозданияКорзиныИДобавленияТовара", ЭтотОбъект);
	
	ДлительнаяОперация = ТорговыеПредложенияВызовСервера.СоздатьКорзинуДобавитьТоварВФоне(
		Организация, ДанныеПредложений, УникальныйИдентификатор);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ВыводитьСообщения    = Истина;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Формирование корзины'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияКорзиныИДобавленияТовара(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда 
		Возврат;
	КонецЕсли;
		
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоАдресВременногоХранилища(Результат.АдресРезультата) Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	РезультатыДобавленияПредложений = РезультатыДобавленияПредложений(Результат.АдресРезультата);
	
	ОткрытьФормуКорзины = РезультатыДобавленияПредложений.ЕстьДобавленныеПредложения
		И Не РезультатыДобавленияПредложений.ЕстьОшибкиДобавленияПредложений;

	Если РезультатыДобавленияПредложений.ЕстьДобавленныеПредложения Тогда
		ТорговыеПредложенияКлиент.ОповеститьОбИзмененииКорзины(Результат.АдресРезультата, ЭтотОбъект);
	КонецЕсли;
	
	Если РезультатыДобавленияПредложений.ЕстьОшибкиДобавленияПредложений Тогда
		
		ОбработатьОшибкиСтрокСписка(РезультатыДобавленияПредложений.ОшибкиДобавленияПредложений);
		
		Если РезультатыДобавленияПредложений.ЕстьДобавленныеПредложения Тогда
			ЗадатьВопросПередОткрытиемКорзины();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОткрытьФормуКорзины Тогда
		ТорговыеПредложенияКлиент.ОткрытьФормуКорзины(Организация);
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РезультатыДобавленияПредложений(Знач АдресРезультата)
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьДобавленныеПредложения", Ложь);
	Результат.Вставить("ЕстьОшибкиДобавленияПредложений", Ложь);
	Результат.Вставить("ОшибкиДобавленияПредложений", Новый Массив);
	
	РезультатыОперации = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Результат.ЕстьДобавленныеПредложения = РезультатыОперации.ЕстьДобавленныеПредложения;
	Результат.ЕстьОшибкиДобавленияПредложений = РезультатыОперации.ЕстьОшибкиДобавленияПредложений;
	Результат.ОшибкиДобавленияПредложений = РезультатыОперации.ОшибкиДобавленияПредложений;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОшибкиСтрокСписка(Ошибки)

	ОбработанныеОшибкиПредложений = Новый Массив;
	Для Каждого Ошибка Из Ошибки Цикл
		
		ИдентификаторПредложения = Ошибка.ИдентификаторПредложения;
		
		Если Не ПустаяСтрока(Ошибка.ТекстОшибкиСервиса) Тогда
			ТекстСообщения = Ошибка.ТекстОшибкиСервиса;
		ИначеЕсли Не ПустаяСтрока(Ошибка.ТекстОшибки) Тогда
			ТекстСообщения = Ошибка.ТекстОшибки;
		Иначе
			ТекстСообщения = "";
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстСообщения) 
			И ОбработанныеОшибкиПредложений.Найти(ИдентификаторПредложения) = Неопределено Тогда
			ВывестиСообщениеДляСтрокиСписка(ТекстСообщения, ИдентификаторПредложения); 
			ОбработанныеОшибкиПредложений.Добавить(ИдентификаторПредложения);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщениеДляСтрокиСписка(Знач ТекстСообщения, ИдентификаторПредложения)
		
	ОтборСтрокСписка = Новый Структура("Идентификатор", ИдентификаторПредложения);
	НайденныеСтрокиСписка = Список.НайтиСтроки(ОтборСтрокСписка);
	Если НайденныеСтрокиСписка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	СтрокаСписка = НайденныеСтрокиСписка[0];
	НаименованиеПоставщика = СтрокаСписка.ПоставщикПредложения;
	
	ДополнениеТекстаСообщения = 
		СтрШаблон(
			НСтр("ru = 'Предложение от ""%1"" для товара ""%2""'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()), 
			НаименованиеПоставщика, 
			СтрокаСписка.Номенклатура);
	
	ТекстСообщения = СтрШаблон("%1%2%3", ТекстСообщения, Символы.ПС, ДополнениеТекстаСообщения);
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);

КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросПередОткрытиемКорзины()
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбОткрытииКорзины", ЭтотОбъект, Параметры);
	ТекстВопроса = НСтр("ru = 'Некоторые предложения недоступны для оформления. Открыть корзину?'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбОткрытииКорзины(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТорговыеПредложенияКлиент.ОткрытьФормуКорзины(Организация);
	
КонецПроцедуры

&НаСервере
Процедура АвтовыборПоСценарию(Режим)
	
	Для каждого СтрокаСписка Из Список Цикл
		
		ОтборПредложенийСтроки = Новый Структура("ИдентификаторСтрокиСписка", СтрокаСписка.ИдентификаторСтроки);
		НайденныеСтрокиПредложенийСтрокиСписка = ПредложенияПоставщиков.НайтиСтроки(ОтборПредложенийСтроки);
		
		Если НайденныеСтрокиПредложенийСтрокиСписка.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого СтрокаПредложения Из НайденныеСтрокиПредложенийСтрокиСписка Цикл
		    СтрокаПредложения.Пометка = Ложь;
		КонецЦикла;

		ПредложенияСтрокиСписка = ПредложенияПоставщиков.Выгрузить(НайденныеСтрокиПредложенийСтрокиСписка); 

		Если Режим = "Цена" Тогда
			ПредложенияСтрокиСписка.Сортировать("Цена");
		ИначеЕсли Режим = "СрокПоставки" Тогда
			ПредложенияСтрокиСписка.Сортировать("СрокПоставки");
		Иначе
			ОтменитьВыбранноеПредложениеДляСтроки(СтрокаСписка);
			Продолжить;
		КонецЕсли; 
		
		ОтборЦелевойСтроки = Новый Структура("Идентификатор, ИдентификаторСтрокиСписка");
		ЗаполнитьЗначенияСвойств(ОтборЦелевойСтроки, ПредложенияСтрокиСписка[0]);
		НайденныеПредложения = ПредложенияПоставщиков.НайтиСтроки(ОтборЦелевойСтроки);
		
		ЦелеваяСтрокаПредложения = Неопределено;
		ВыводитьСообщениеОКратности = Ложь;
		Для Каждого СтрокаНайденногоПредложения Из НайденныеПредложения Цикл
			Если КоличествоСоответствуетКратностиУпаковки(
				СтрокаСписка, СтрокаНайденногоПредложения, ВыводитьСообщениеОКратности) Тогда
				ЦелеваяСтрокаПредложения = СтрокаНайденногоПредложения;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЦелеваяСтрокаПредложения = Неопределено Тогда
			ОтменитьВыбранноеПредложениеДляСтроки(СтрокаСписка);
			Продолжить;
		КонецЕсли;
		
		ЦелеваяСтрокаПредложения.Пометка = Истина;
		
		ЗаполнитьВыбранноеПредложение(
			СтрокаСписка, ЦелеваяСтрокаПредложения, МаксимальныйСрокПоставки, ПревышениеМинимальнойЦены);
			
	КонецЦикла;
	
	СуммаВсего = Список.Итог("Сумма");
	ОбновитьНадписьПодобраноТоваров(ЭтотОбъект);
	ОбновитьПоказателиПоставщиков(Контрагенты, ПредложенияПоставщиков);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПоказателиПоставщиков(Контрагенты, ПредложенияПоставщиков)
	
	Для каждого СтрокаПоставщики Из Контрагенты Цикл
		
		ОтборПредложенийКонтрагента = Новый Структура("ИдентификаторКонтрагента", СтрокаПоставщики.Идентификатор);
		ПредложенияПоставщика = ПредложенияПоставщиков.НайтиСтроки(ОтборПредложенийКонтрагента);
		
		СтрокаПоставщики.Охват = ПредложенияПоставщика.Количество();
		КЗаказу = 0;
		Для каждого ПредложениеПоставщика Из ПредложенияПоставщика Цикл
			Если ПредложениеПоставщика.Пометка Тогда
				КЗаказу = КЗаказу + 1;
			КонецЕсли;	
		КонецЦикла;
		СтрокаПоставщики.КЗаказу = КЗаказу;
		
	КонецЦикла;

КонецПроцедуры
	
&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено)
	
	ТорговыеПредложенияПереопределяемый.ОбработатьВыбор(ЭтотОбъект, ВыбранноеЗначение, ДополнительныеПараметры);
	ОбновитьНадписьПодобраноТоваров(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоКонтексту(ПараметрыКоманды)
	
	ТаблицаТовары = РеквизитФормыВЗначение("Список", Тип("ТаблицаЗначений"));
	
	КонтекстИсточника = Неопределено;
	ТорговыеПредложенияПереопределяемый.СвойстваКонтекстаДокументовДляПоискаПредложений(ПараметрыКоманды, КонтекстИсточника, ТаблицаТовары);
	Если КонтекстИсточника <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, КонтекстИсточника);
	КонецЕсли;
	ТорговыеПредложенияСлужебный.ЗаполнитьСведенияОНоменклатуре(ТаблицаТовары, "ЕдиницаИзмерения, Упаковка");
	
	Для каждого СтрокаТовары Из ТаблицаТовары Цикл
		СтрокаТовары.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТаблицаТовары, "Список");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыНоменклатуры(Знач Номенклатура)
	
	Реквизиты = ТорговыеПредложенияСлужебный.СведенияОНоменклатуре(Номенклатура);
	
	// Очистка данных.
	Реквизиты.Вставить("МаксимальнаяЦена",         0);
	Реквизиты.Вставить("МинимальнаяЦена",          0);
	Реквизиты.Вставить("МаксимальныйСрокПоставки", 0);
	Реквизиты.Вставить("МинимальныйСрокПоставки",  0);
	Реквизиты.Вставить("Сумма",                    0);
	Реквизиты.Вставить("Идентификатор", "");
	Реквизиты.Вставить("ИдентификаторКонтрагента", "");
	Реквизиты.Вставить("Пометка",                  Ложь);
	Реквизиты.Вставить("КоличествоПредложений",    0);
	Реквизиты.Вставить("Количество",               1);
	
	Возврат Реквизиты;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Переопределяемое условное оформление (например, для единиц измерения).
	ТорговыеПредложенияПереопределяемый.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтотОбъект, "СписокНоменклатураЕдиницаИзмерения", "Список.Упаковка");
	
	ТекстПоЗапросу = НСтр("ru = 'по запросу'", ОбщегоНазначения.КодОсновногоЯзыка());
	ТекстВНаличии = НСтр("ru = 'в наличии'", ОбщегоНазначения.КодОсновногоЯзыка());

