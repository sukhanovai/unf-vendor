
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Параметры.Основание) Тогда
		ВызватьИсключение НСтр("ru='Не выбрано основание.'");
	КонецЕсли;
	
	Объект.Основание = Параметры.Основание;
	
	ПроверитьДоступностьОбсужденийНаСервере();
	
	ИспользуетсяРаботаССобытиями = ПолучитьФункциональнуюОпцию("ИспользоватьПодсистемуCRM")
		И ЭлектроннаяПочтаУНФ.ИспользуетсяРаботаССобытиями() И ПравоДоступа("Добавление", Метаданные.Документы.Событие);
		
	Элементы.ГруппаРежимЗапланировать.Видимость = ИспользуетсяРаботаССобытиями;

	Если ИспользуетсяРаботаССобытиями Тогда
		
		// СтандартныеПодсистемы.НапоминанияПользователя
		ПараметрыРазмещения = НапоминанияПользователя.ПараметрыРазмещения();
		ПараметрыРазмещения.Группа = Элементы.ГруппаПараметрыНапоминания;
		ПараметрыРазмещения.ИмяРеквизитаСДатойСобытия = "НачалоСобытия";
		НапоминанияПользователя.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
		// Конец СтандартныеПодсистемы.НапоминанияПользователя
		
		КалендарьСотрудника = ПерсональныеНастройкиРУНФ.Прочитать("ОсновнойКалендарь"); 

	КонецЕсли;
	
	ИспользованиеНапоминанийРазрешено = ПолучитьФункциональнуюОпцию("ИспользоватьНапоминанияПользователя") 
		И ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.НапоминанияПользователя);
		
	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();
	Элементы.ДатаНачалаВремя.КнопкаВыпадающегоСписка    = Не ЭтоМобильныйКлиент;
	Элементы.ДатаОкончанияВремя.КнопкаВыпадающегоСписка = Не ЭтоМобильныйКлиент;

	ВывестиБаннеры();
	
	ЭтоВариантИнтерфейса85 = ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();	
	АдаптацияФормыТакси();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПереключитьНаСтраницу(Элементы.СтраницаОсновная);
	
	ПроверитьДоступностьВидеоконференцийНаКлиенте();
	ЗаполнитьМаксимальноеКоличествоУчастников();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если УстановленРежимСозданияНаСервере() Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ПроверяемыеРеквизиты, "КалендарьСотрудника");
		ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ПроверяемыеРеквизиты, "ДатаНачалаДата");
		ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(ПроверяемыеРеквизиты, "ДатаОкончанияДата");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИспользуетсяРаботаССобытиями Тогда
		// СтандартныеПодсистемы.НапоминанияПользователя
		НапоминанияПользователяКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
		// Конец СтандартныеПодсистемы.НапоминанияПользователя
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// СтандартныеПодсистемы.НапоминанияПользователя
&НаКлиенте
Процедура Подключаемый_ПриИзмененииНастройкиНапоминания(Элемент)
	
	НапоминанияПользователяКлиент.ПриИзмененииНастройкиНапоминания(Элемент, ЭтотОбъект);	
	УстановитьНапоминаниеНаСервере();
	
	Модифицированность = Ложь;
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.НапоминанияПользователя

&НаКлиенте
Процедура Подключаемый_ПодключитьОбсуждения(Команда, НавигационнаяСсылка = Неопределено,
	СтандартнаяОбработка = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	ПодключитьОбсуждения();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьДействиеИнформационногоСообщения(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено,
	СтандартнаяОбработка = Неопределено)
	
	ОбщегоНазначенияКлиент.ОбработатьДействиеИнформационногоСообщения(ЭтотОбъект, ЭлементИлиКоманда, НавигационнаяСсылка,
		СтандартнаяОбработка);
		
КонецПроцедуры

&НаКлиенте
Процедура ГруппаРежимСоздатьНажатие(Элемент)
	
	СоздатьВидеовстречу();
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаРежимЗапланироватьНажатие(Элемент)
	
	ЗапланироватьВидеовстречу();
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.НапоминанияПользователя

&НаКлиенте
Процедура ТемаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Справочник.ТемыСобытий.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТемаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Объект.Тема = ВыбранноеЗначение;
		Если УстановленРежимПланированияНаКлиенте() Тогда
			ЗаполнитьСодержание(ВыбранноеЗначение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаДатаПриИзменении(Элемент)
	
	УправлениеНебольшойФирмойКлиент.ПересчитатьДатуОкончания(ЭтотОбъект, "ДатаНачала", "ДатаОкончания");
	СформироватьПредставлениеПродолжительности(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияДатаПриИзменении(Элемент)
	
	СформироватьПредставлениеПродолжительности(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаВремяПриИзменении(Элемент)
	
	УправлениеНебольшойФирмойКлиент.ПересчитатьДатуОкончания(ЭтотОбъект, "ДатаНачала", "ДатаОкончания");
	СформироватьПредставлениеПродолжительности(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаВремяОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	ВыбранноеЗначение = НачалоДня(Объект.ДатаНачала) + (ВыбранноеЗначение - НачалоДня(ВыбранноеЗначение));
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияВремяПриИзменении(Элемент)

	СформироватьПредставлениеПродолжительности(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияВремяОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
	
	ВыбранноеЗначение = НачалоДня(Объект.ДатаОкончания) + (ВыбранноеЗначение - НачалоДня(ВыбранноеЗначение));
	
КонецПроцедуры

&НаКлиенте
Процедура СобытиеНажатие(Элемент, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура("Ключ", Объект.Ссылка);
	ОписаниеОповещения = Новый ОписаниеОповещения("СобытиеНажатиеЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Документ.Событие.ФормаОбъекта", ПараметрыОткрытия, , , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)

	УправлениеНебольшойФирмойКлиент.ПересчитатьДатуОкончания(ЭтотОбъект, "ДатаНачала", "ДатаОкончания");
	СформироватьПредставлениеПродолжительности(ЭтотОбъект);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СекундВЧасе = 3600;
	Объект.ДатаНачала = Объект.ДатаНачала + Направление * СекундВЧасе;
	УправлениеНебольшойФирмойКлиент.ПересчитатьДатуОкончания(ЭтотОбъект, "ДатаНачала", "ДатаОкончания");
		
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СекундВЧасе = 3600;
	Объект.ДатаОкончания = Объект.ДатаОкончания + Направление * СекундВЧасе;
	УправлениеНебольшойФирмойКлиент.ПересчитатьДатуОкончания(ЭтотОбъект, "ДатаНачала", "ДатаОкончания");
	
	СформироватьПредставлениеПродолжительности(ЭтотОбъект);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	
	СформироватьПредставлениеПродолжительности(ЭтотОбъект);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Создать(Команда)

	Если ВстречаСоздана Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Или Не ДатыЗаполненыКорректно() Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеВидеовстречи = ОписаниеВидеовстречи();
	Результат = ВидеовстречиКлиент.СоздатьВидеовстречу(ОписаниеВидеовстречи);
	
	Если Результат.Отказ Тогда
		ПоказатьПредупреждение(, Результат.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ОбработатьРезультатСоздания(Результат);
	СформироватьТекстПриглашения();

	Если УстановленРежимПланированияНаКлиенте() Тогда
		Оповестить("Запись_Событие");
		Оповестить("Запись_ИсточникЗаписейКалендаряСотрудника");
	КонецЕсли;
		
	ПереключитьНаСтраницу(Элементы.СтраницаГотово);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключиться(Команда)

	ИдентификаторОбсуждения = Новый ИдентификаторОбсужденияСистемыВзаимодействия(Объект.ИдентификаторОбсуждения);
	ИдентификаторыУчастников = ИдентификаторыУчастниковОбсуждения(ИдентификаторОбсуждения);
	
	Участники = Новый КоллекцияИдентификаторовПользователейСистемыВзаимодействия;
	Для Каждого ИдентификаторУчастника Из ИдентификаторыУчастников Цикл
		Участник = Новый ИдентификаторПользователяСистемыВзаимодействия(ИдентификаторУчастника);
		Участники.Добавить(Участник);
	КонецЦикла;
	
	СистемаВзаимодействия.НачатьВидеоконференцию(, Участники, ИдентификаторОбсуждения, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбсуждение(Команда)
	
	Если Не ПустаяСтрока(Объект.АдресОбсуждения) Тогда
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(Объект.АдресОбсуждения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоделитьсяTelegram(Команда)

	ПерейтиПоНавигационнойСсылке(СтрокаОтправитьTelegram());

КонецПроцедуры

&НаКлиенте
Процедура ПоделитьсяWhatsApp(Команда)

	ПерейтиПоНавигационнойСсылке(СтрокаОтправитьWhatsApp());
	
КонецПроцедуры

&НаКлиенте
Процедура ПоделитьсяВПисьме(Команда)

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьУчастниковПоОснованиюЗавершение", ЭтотОбъект);
	
	Если УстановленРежимПланированияНаКлиенте() И ТипЗнч(Объект.Основание) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		ОснованияВидеовстречи = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Основание);
		Получатели = ЭлектроннаяПочтаУНФВызовСервера.ПодготовленныеЭлектронныеАдресаПолучателей(ОснованияВидеовстречи);
			
		ПараметрыПодбора = Новый Структура("Получатели, ПропуститьВыборФорматаВложений", Получатели, Истина);
		ОткрытьФорму("ОбщаяФорма.ПодготовкаНовогоПисьма", ПараметрыПодбора, ЭтотОбъект , , , , ОписаниеОповещения);
		
		Возврат;
		
	КонецЕсли;
	
	ДанныеОповещения = Новый Структура("Получатели", Неопределено);
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, ДанныеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьТекстПриглашенияВБуфер(Команда)
	
	ПоместитьВБуферОбмена(ТекстПриглашения);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСозданиеВидеовстречи(Команда)

	СоздатьВидеовстречу();
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПланированиеВидеовстречи(Команда)
	
	ЗапланироватьВидеовстречу();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура АдаптацияФормыТакси()
	
	Если ЭтоВариантИнтерфейса85 Тогда
		Возврат;
	КонецЕсли;

	Элементы.ДатаНачала.Видимость    = Ложь;
	Элементы.ДатаОкончания.Видимость = Ложь;
	
	ИменаПолейДатыТакси = "ДатаНачалаДата,ДатаНачалаВремя,ДатаОкончанияДата,ДатаОкончанияВремя,"
		+ "ДекорацияОтступШапка,ДекорацияОтступПодвал,ДекорацияОтсупПромежуток";
	ИменаПолей = СтрРазделить(ИменаПолейДатыТакси, ",", Ложь);
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Элементы[ИмяПоля].Видимость = Истина;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВывестиБаннеры()

	ПараметрыВажногоСообщенияДоступ = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщенияДоступ.Скрываемый = Ложь;
	ПараметрыВажногоСообщенияДоступ.ТипСообщения = "Ошибка";
	ПараметрыВажногоСообщенияДоступ.КраткоеПредставление = НСтр("ru = 'Внешний доступ'");
	ПараметрыВажногоСообщенияДоступ.Сообщение =
		НСтр("ru='Сервер системы взаимодействия не поддерживает внешний доступ. Обратитесь к системному администратору.'");

	ОбщегоНазначения.ВставитьВажноеСообщение(ЭтотОбъект, ПараметрыВажногоСообщенияДоступ,
		Элементы.ПанельСообщенийНеПоддерживаетсяВнешнийДоступ.Имя);
		
	ПараметрыВажногоСообщенияВидеозвонки = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщенияВидеозвонки.Скрываемый = Ложь;
	ПараметрыВажногоСообщенияВидеозвонки.ТипСообщения = "Ошибка";
	ПараметрыВажногоСообщенияВидеозвонки.Сообщение =
		НСтр("ru='Приложение на устройстве не поддерживает видеозвонки. Обратитесь к системному администратору.'");
	ПараметрыВажногоСообщенияВидеозвонки.КраткоеПредставление = НСтр("ru = 'Видеозвонки'");
	
	ОбщегоНазначения.ВставитьВажноеСообщение(ЭтотОбъект, ПараметрыВажногоСообщенияВидеозвонки,
		Элементы.ПанельСообщенийНеПоддерживаютсяВидеозвонки.Имя);
		
	ПараметрыВажногоСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщения.Скрываемый = Ложь;
	ПараметрыВажногоСообщения.ТипСообщения = "Предупреждение";
	ПараметрыВажногоСообщения.Сообщение = НСтр("ru = 'Обсуждения не подключены.'");
	ПараметрыВажногоСообщения.КраткоеПредставление = НСтр("ru = 'Обсуждения'");
	
	ПараметрыДействия = ОбщегоНазначения.ПараметрыДействияВажногоСообщения();
	ПараметрыДействия.ИмяКоманды = "ПодключитьОбсуждения";
	ПараметрыДействия.Обработчик = "Подключаемый_ПодключитьОбсуждения";
	ПараметрыДействия.Заголовок = НСтр("ru = 'Подключить'");
	ПараметрыВажногоСообщения.ПараметрыДействия = ПараметрыДействия;
	
	ОбщегоНазначения.ВставитьВажноеСообщение(ЭтотОбъект, ПараметрыВажногоСообщения,
		Элементы.ПанельСообщенийОбсужденияНеПодключены.Имя);
	
	ОбщегоНазначения.ВывестиСтатусыИВажныеСообщенияНаФорму(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОбсуждения()

	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьДоступностьОбсужденийНаКлиенте", ЭтотОбъект);
	ОткрытьФорму("Обработка.ПанельАдминистрированияИнтеграцийУНФ.Форма.ЧатИнтеграцияСМессенджерами", , , , , ,
		ОписаниеОповещения);
	
КонецПроцедуры
&НаКлиенте
Процедура СоздатьВидеовстречу()
	УстановитьРежимНаКлиенте(РежимСоздания());
	ПереключитьНаСтраницу(Элементы.СтраницаПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ЗапланироватьВидеовстречу()
	
	УстановитьРежимНаКлиенте(РежимПланирования());
	ПереключитьНаСтраницу(Элементы.СтраницаПараметры);
	
	ТекущийЭлемент = Элементы.ДатаНачалаВремя;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьНаСтраницу(Страница)
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Страница;
	
	Для Каждого СтраницаГруппы Из Элементы.ГруппаСтраницы.ПодчиненныеЭлементы Цикл
		СтраницаГруппы.Видимость = Ложь;
	КонецЦикла;

	Страница.Видимость = Истина;

	Если Страница = Элементы.СтраницаОсновная Тогда
		
		Элементы.ГруппаКомандОсновное.Видимость = Истина;
		Элементы.ОткрытьОбсуждение.Видимость    = Ложь;
		Элементы.Поделиться.Видимость           = Ложь;
		Элементы.Подключиться.Видимость         = Ложь;
		Элементы.Создать.Видимость              = Ложь;
		Элементы.ГруппаИнформацияОКоличествеУчастников.Видимость = Ложь;
		
	ИначеЕсли Страница = Элементы.СтраницаПараметры Тогда
		
		Элементы.Создать.Видимость                  = Истина;
		Элементы.ДекорацияОтсупПромежуток.Видимость = Ложь;
		Элементы.ДекорацияОтступШапка.Видимость     = Ложь;
		Элементы.ДекорацияОтступПодвал.Видимость    = Ложь;
		
	ИначеЕсли Страница = Элементы.СтраницаГотово Тогда
		
		Элементы.СтраницаПараметры.Видимость = Ложь;
		Элементы.ОткрытьОбсуждение.Видимость = Истина;
		Элементы.Поделиться.Видимость        = Истина;
		Элементы.Подключиться.Видимость      = Истина;
		Элементы.Создать.Видимость           = Ложь;
		
		Элементы.ДекорацияОтсупПромежуток.Видимость = Ложь;
		Элементы.ДекорацияОтступШапка.Видимость     = Ложь;
		Элементы.ДекорацияОтступПодвал.Видимость    = Ложь;
		
		Элементы.ГруппаИнформацияОКоличествеУчастников.Видимость = Ложь;
		Элементы.СкопироватьТекстПриглашенияВБуфер.Видимость = СредстваБуфераОбмена.ИспользованиеДоступно();
		
		ЭтоВариантИнтерфейса85 = ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
		Если ЭтоВариантИнтерфейса85 Тогда
			Элементы.Создать.Важность      = ВажностьКнопки.Обычная;
			Элементы.Подключиться.Важность = ВажностьКнопки.Главная;
		Иначе
			Элементы.Создать.КнопкаПоУмолчанию      = Ложь;
			Элементы.Подключиться.КнопкаПоУмолчанию = Истина;
			
			Если Режим = РежимПланирования() Тогда
				Элементы.ТекстПриглашения.Высота = 5;
				Элементы.ТекстПриглашения.МаксимальнаяВысота = 5;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ОписаниеВидеовстречи()
	
	ОписаниеВидеовстречи = ВидеовстречиКлиентСервер.ОписаниеВидеовстречи();
	
	Если УстановленРежимПланированияНаКлиенте() Тогда
		
		ОписаниеВидеовстречи.СоздатьСобытие = Истина;
		ОписаниеВидеовстречи.КалендарьСотрудника = КалендарьСотрудника;
		ЗаполнитьЗначенияСвойств(ОписаниеВидеовстречи, Объект, "ДатаНачала, ДатаОкончания");
		
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.Тема) Тогда
		ШаблонТемы = НСтр("ru='Встреча от %1'");
		Объект.Тема = СтрШаблон(ШаблонТемы, Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОписаниеВидеовстречи, Объект, "Основание, Содержание, Тема");
	
	Возврат ОписаниеВидеовстречи;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатСоздания(Результат)
	
	ЗаполнитьЗначенияСвойств(Объект, Результат, "АдресОбсуждения, ВнешнийАдресОбсуждения, ИдентификаторОбсуждения");
	
	Если Результат.СобытиеСоздано Тогда
		Объект.Ссылка = Результат.ДокументСобытия;
	КонецЕсли;
	
	ВстречаСоздана = Результат.ОбсуждениеСоздано;
	
	Элементы.Подключиться.Видимость = Истина;
	Элементы.Создать.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТекстПриглашения()
	
	Если УстановленРежимПланированияНаКлиенте() Тогда
		ШаблонПриглашения = НСтр("ru='Добрый день. Вам отправлено приглашение на видеовстречу %1 в %2.
			|
			|Адрес подключения: %3'");
		ТекстПриглашения = СтрШаблон(ШаблонПриглашения, Формат(Объект.ДатаНачала, "ДФ='dd.MM.yyyy'"), 
			Формат(Объект.ДатаНачала, "ДФ='HH:mm'"), Объект.АдресОбсуждения);
	Иначе
		ШаблонПриглашения = НСтр("ru='Добрый день. Вам отправлено приглашение на видеовстречу.
			|
			|Адрес подключения: %1'");
		ТекстПриглашения = СтрШаблон(ШаблонПриглашения, Объект.АдресОбсуждения);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ПоместитьВБуферОбмена(Текст)
	
	ПомещаемыеДанные = Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, Текст);
	Результат = Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ПомещаемыеДанные);

	Если Результат Тогда
		ПоказатьОповещениеПользователя(НСтр("ru='Приглашение'"), , НСтр("ru='Текст приглашения скопирован.'"),
			БиблиотекаКартинок.ДиалогИнформация);
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru='Приглашение'"), , НСтр("ru='Не удалось скопировать текст приглашения.'"),
		БиблиотекаКартинок.ДиалогИнформация);
	КонецЕсли;
	
КонецПроцедуры

#Область Обсуждения

&НаКлиенте
Процедура ПроверитьДоступностьВидеоконференцийНаКлиенте()
	
	Если Не ОбсужденияДоступны Или Не ПоддерживаетсяВнешнийДоступ Тогда
		Возврат;
	КонецЕсли;

	ВидеоконференцииДоступны = СистемаВзаимодействия.ПоддерживаютсяВидеоконференции();

	Если Не ВидеоконференцииДоступны Тогда
		Элементы.ПанельСообщенийНеПоддерживаютсяВидеозвонки.Видимость = Истина;
		Элементы.СтраницаОсновная.Доступность = Ложь;
		Возврат;
	КонецЕсли;

	ЗаполнитьМаксимальноеКоличествоУчастников();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДоступностьОбсужденийНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	ДоступностьФункционала = ПроверитьДоступностьНаСервере();
	ОбсужденияДоступны = ДоступностьФункционала.ОбсужденияДоступны;
	ПоддерживаетсяВнешнийДоступ = ДоступностьФункционала.ПоддерживаетсяВнешнийДоступ;
	
	УстановитьДоступностьВыбораРежима(Элементы.ПанельСообщенийОбсужденияНеПодключены.Видимость,
		Элементы.ПанельСообщенийНеПоддерживаетсяВнешнийДоступ.Видимость,
		Элементы.СтраницаОсновная.Доступность, ДоступностьФункционала);
	
	Если ДоступностьФункционала.ОбсужденияДоступны И ДоступностьФункционала.ПоддерживаетсяВнешнийДоступ Тогда
		ПроверитьДоступностьВидеоконференцийНаКлиенте();
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПроверитьДоступностьОбсужденийНаСервере()
	
	ДоступностьФункционала = ПроверитьДоступностьНаСервере();
	ОбсужденияДоступны = ДоступностьФункционала.ОбсужденияДоступны;
	ПоддерживаетсяВнешнийДоступ = ДоступностьФункционала.ПоддерживаетсяВнешнийДоступ;
	УстановитьДоступностьВыбораРежима(Элементы.ПанельСообщенийОбсужденияНеПодключены.Видимость,
		Элементы.ПанельСообщенийНеПоддерживаетсяВнешнийДоступ.Видимость,
		Элементы.СтраницаОсновная.Доступность, ДоступностьФункционала);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьВыбораРежима(ВидимостьПанелиСообщенийОбсуждения, ВидимостьПанелиСообщенийДоступа,
	ДоступностьОсновнойСтраницы, РезультатПроверки)
	
	ВидимостьПанелиСообщенийОбсуждения = Ложь;
	ВидимостьПанелиСообщенийДоступа = Ложь;
	ДоступностьОсновнойСтраницы = Истина;
	
	Если Не РезультатПроверки.ОбсужденияДоступны Тогда
		ВидимостьПанелиСообщенийОбсуждения = Истина;
		ДоступностьОсновнойСтраницы        = Ложь;
	ИначеЕсли Не РезультатПроверки.ПоддерживаетсяВнешнийДоступ Тогда
		ВидимостьПанелиСообщенийДоступа = Истина;
		ДоступностьОсновнойСтраницы     = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьДоступностьНаСервере()
	
	Результат = Новый Структура("ОбсужденияДоступны, ПоддерживаетсяВнешнийДоступ", Истина, Истина);
	
	Попытка
		Результат.ОбсужденияДоступны          = Обсуждения.СистемаВзаимодействийПодключена();
		Результат.ПоддерживаетсяВнешнийДоступ = Результат.ОбсужденияДоступны
			И СистемаВзаимодействия.ПоддерживаетсяВнешнийДоступ();
	Исключение
		ИмяСобытия = ВидеовстречиКлиентСервер.НаименованиеСобытияЖурналаРегистрации();
		ОписаниеОшибки = ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			ОписаниеОшибки);
			
		Результат.ОбсужденияДоступны = Ложь;
		Возврат Результат; 
	КонецПопытки;
	
	Возврат Результат;
		
КонецФункции

&НаКлиенте
Процедура ЗаполнитьМаксимальноеКоличествоУчастников()
	
	Если Не ОбсужденияДоступны Или Не ВидеоконференцииДоступны Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальноеКоличествоУчастников = СистемаВзаимодействия.ПолучитьМаксимальноеКоличествоУчастниковВидеоконференции();
	Элементы.ДекорацияКоличествоУчастников.Заголовок = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
		НСтр("ru='Максимальное количество участников: %1'"), МаксимальноеКоличествоУчастников);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИдентификаторыУчастниковОбсуждения(ИдентификаторОбсуждения)
		
	Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(ИдентификаторОбсуждения);
	
	Если Обсуждение = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Обсуждение не найдено.'");
	КонецЕсли;
	
	ИдентификаторыУчастников = Новый Массив;
	Для Каждого Участник Из Обсуждение.Участники Цикл
		ИдентификаторыУчастников.Добавить(Участник);
	КонецЦикла;
	
	Возврат ИдентификаторыУчастников;
	
КонецФункции

#КонецОбласти

#Область Режимы

&НаКлиенте
Процедура УстановитьРеквизитыПоРежиму()
	
	Если УстановленРежимПланированияНаКлиенте() Тогда
		
		#Если НЕ МобильныйКлиент Тогда
			
		СобытияУНФКлиентСервер.ЗаполнитьСписокВыбораВремени(Элементы.ДатаНачалаВремя);
		СобытияУНФКлиентСервер.ЗаполнитьСписокВыбораВремени(Элементы.ДатаОкончанияВремя);
		
		#КонецЕсли

		СекундВ15Мин 		= 900;
		Продолжительность 	= 1800;
		
		ДатаНаМомент = ОбщегоНазначенияКлиент.ДатаСеанса();
		СекундСНачалаДня = ДатаНаМомент - НачалоДня(ДатаНаМомент);
		
		ДатаНачалаДата = НачалоДня(ДатаНаМомент);
		ДатаНачалаВремя = Дата(1, 1, 1) + Цел(СекундСНачалаДня / СекундВ15Мин) * СекундВ15Мин + СекундВ15Мин;
		
		Объект.ДатаНачала = ДатаНачалаДата + (ДатаНачалаВремя - Дата(1, 1, 1));
		
		НачалоСобытияПередИзменением = Объект.ДатаНачала;
		
		Объект.ДатаОкончания = Объект.ДатаНачала + Продолжительность;
		ДатаОкончанияДата = Объект.ДатаОкончания;
		ДатаОкончанияВремя = Объект.ДатаОкончания;
		
		СформироватьПредставлениеПродолжительности(ЭтотОбъект);
		
	ИначеЕсли УстановленРежимСозданияНаКлиенте() Тогда
		
		Объект.ДатаНачала = ОбщегоНазначенияКлиент.ДатаСеанса();
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовПоРежиму()
	
	Элементы.ГруппаИнформацияОКоличествеУчастников.Видимость = Истина;

	ИменаЭлементов = "Основание,ГруппаДата,ГруппаНапоминания,КалендарьСотрудника,Содержание,Событие";
	ИменаЭлементов = СтрРазделить(ИменаЭлементов, ",");
	
	ЗначениеВидимости = ?(УстановленРежимПланированияНаКлиенте(), Истина, Ложь);
	
	Если УстановленРежимПланированияНаКлиенте() Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(ИменаЭлементов, "ГруппаНапоминания");
		Элементы.ГруппаНапоминания.Видимость = ИспользованиеНапоминанийРазрешено;
	КонецЕсли;
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяЭлемента, 
			"Видимость", ЗначениеВидимости);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимНаКлиенте(УстанавливаемыйРежим)
	
	Режим = УстанавливаемыйРежим;
	
	УстановитьРеквизитыПоРежиму();
	УстановитьВидимостьЭлементовПоРежиму();
	
КонецПроцедуры

&НаКлиенте
Функция УстановленРежимПланированияНаКлиенте()
	
	Возврат ТекущийРежимНаКлиенте() = РежимПланирования();
	
КонецФункции

&НаКлиенте
Функция УстановленРежимСозданияНаКлиенте()

	Возврат ТекущийРежимНаКлиенте() = РежимСоздания();

КонецФункции

&НаСервере
Функция УстановленРежимСозданияНаСервере()

	Возврат ТекущийРежимНаСервере() = РежимСоздания();

КонецФункции

&НаКлиенте
Функция ТекущийРежимНаКлиенте()
	
	Возврат Режим;
	
КонецФункции

&НаСервере
Функция ТекущийРежимНаСервере()
	
	Возврат Режим;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РежимСоздания()
	
	Возврат "Создание";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РежимПланирования()
	
	Возврат "Планирование";
	
КонецФункции

#КонецОбласти

#Область ТемаИСодержание

&НаКлиенте
Процедура ЗаполнитьСодержание(Тема)
	
	Если Не ПустаяСтрока(Объект.Содержание) Тогда
		
		ТекстВопроса = НСтр("ru = 'Заполнить содержание по выбранной теме?'");
		ДополнительныеПараметры = Новый Структура("ТемаСобытия", Тема);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьСодержаниеСобытияЗавершение", ЭтотОбъект,
			ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	Объект.Содержание = СодержаниеСобытияНаСервере(Тема);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСодержаниеСобытияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Содержание = СодержаниеСобытияНаСервере(ДополнительныеПараметры.ТемаСобытия);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СодержаниеСобытияНаСервере(Знач Тема)
	
	ИмяРеквизитаСодержание = "Содержание";
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Тема, ИмяРеквизитаСодержание);
	
КонецФункции

#КонецОбласти

#Область ДатаИПродолжительность

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьПредставлениеПродолжительности(Форма)
	
	ПрефиксПродолжительности = СтрШаблон(НСтр("ru='Длительность:%1'"), Символы.НПП);
	СобытияУНФКлиентСервер.СформироватьПредставлениеПродолжительности(Форма, "ПредставлениеПродолжительности",
		Форма.Объект.ДатаНачала, Форма.Объект.ДатаОкончания, ПрефиксПродолжительности);
		
	Если Не Форма.ЭтоВариантИнтерфейса85 Тогда
		ПолеФормыСПодсказкой = Форма.Элементы.ДатаОкончанияДата;
	Иначе
		ПолеФормыСПодсказкой = Форма.Элементы.ДатаОкончания;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.ПредставлениеПродолжительности) Тогда
		ПолеФормыСПодсказкой.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		ПолеФормыСПодсказкой.Подсказка = Форма.ПредставлениеПродолжительности;
	Иначе
		ПолеФормыСПодсказкой.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДатыЗаполненыКорректно()
	
	Результат = Истина;
	
	Если УстановленРежимСозданияНаКлиенте() Тогда
		Возврат Результат;
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Дата начала не заполнена.'"), , "ДатаНачалаДата", , Результат);
	ИначеЕсли Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Дата окончание не заполнена.'"), , "ДатаОкончанияДата", , Результат);
	ИначеЕсли Объект.ДатаНачала > Объект.ДатаОкончания Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Дата начала не может быть больше даты окончания'"), , "ДатаНачалаДата", , Результат);
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОтправкаПриглашения

&НаКлиенте
Процедура ЗаполнитьУчастниковПоОснованиюЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Или Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Получатели = Результат.Получатели;
	
	ПараметрыОтправки = РаботаСПочтовымиСообщениямиКлиент.ПараметрыОтправкиПисьма();

	ПараметрыОтправки.Получатель = Получатели;
	ПараметрыОтправки.Тема       = Объект.Тема;
	ПараметрыОтправки.Текст      = ТекстПисьмаHTML();
	
	Если УстановленРежимПланированияНаКлиенте() И Не Объект.Ссылка.Пустая() Тогда
		ПараметрыОтправки.Предмет = Объект.Ссылка;
	КонецЕсли;
	
	РаботаСПочтовымиСообщениямиКлиент.СоздатьНовоеПисьмо(ПараметрыОтправки)
	
КонецПроцедуры

&НаКлиенте
Функция ТекстПисьмаHTML()
	
	ДатаВстречи = Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy");
	ВремяВстречи = Формат(Объект.ДатаНачала, "ДФ=HH:mm");
	
	ШаблонТекстаПисьмаБезДаты = НСтр("ru='<!DOCTYPE html>
	|<html>
	|<head>
	|<meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" />
	|<meta http-equiv=""X-UA-Compatible"" content=""IE=Edge"" />
	|<meta name=""format-detection"" content=""telephone=no"" />
	|</head>
	|<body>
	|<p>Добрый день.</p>
	|<br>
	|<p>Вам отправлено приглашение на видеовстречу.</p>
	|<br>
	|<p>Адрес подключения:</p>
	|<a href=""%1"">%1</a>
	|
	|</body>
	|</html>'");
	
	ШаблонТекстаПисьмаСДатой = НСтр("ru='<!DOCTYPE html>
	|<html>
	|<head>
	|<meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"" />
	|<meta http-equiv=""X-UA-Compatible"" content=""IE=Edge"" />
	|<meta name=""format-detection"" content=""telephone=no"" />
	|</head>
	|<body>
	|<p>Добрый день.</p>
	|<br>
	|<p>Вам отправлено приглашение на видеовстречу %1 в %2.</p>
	|<br>
	|<p>Адрес подключения:</p>
	|<a href=""%3"">%3</a>
	|
	|</body>
	|</html>'");
	
	Если УстановленРежимПланированияНаКлиенте() Тогда
		ТекстПисьма = СтрШаблон(ШаблонТекстаПисьмаСДатой, ДатаВстречи, ВремяВстречи, Объект.АдресОбсуждения);
	Иначе
		ТекстПисьма = СтрШаблон(ШаблонТекстаПисьмаБезДаты, Объект.АдресОбсуждения);
	КонецЕсли;

	Возврат ТекстПисьма;

КонецФункции

&НаКлиенте
Функция СтрокаОтправитьTelegram()

	ШаблонОтправкиTelegram = "https://t.me/share/url?url=%1&text=%2";
	Результат = СтрШаблон(ШаблонОтправкиTelegram, Объект.ВнешнийАдресОбсуждения, СтрокаОтправкиВМессенджер());
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция СтрокаОтправитьWhatsApp()
	
	ШаблонОтправкиWhatsApp = "https://api.whatsapp.com/send/?text=%1&type=custom_url&app_absent=0";
	Результат =  СтрШаблон(ШаблонОтправкиWhatsApp, СтрокаОтправкиВМессенджер());

	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СтрокаОтправкиВМессенджер()

	ДобавлятьДату = УстановленРежимПланированияНаКлиенте();
	
	ШаблонСтроки = НСтр("ru='Добрый день. Вам отправлено приглашение на видеовстречу. Адрес подключения: %1'");
	ШаблонСтрокиДата = НСтр("ru='Добрый день. Вам отправлено приглашение на видеовстречу %1 в %2. Адрес подключения: %3'");

	Если ДобавлятьДату Тогда
		СтрокаОтправки = СтрШаблон(ШаблонСтрокиДата, Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy"),
			Формат(Объект.ДатаНачала, "ДФ=HH:mm"), Объект.ВнешнийАдресОбсуждения);
	Иначе
		СтрокаОтправки = СтрШаблон(ШаблонСтроки,  Объект.ВнешнийАдресОбсуждения);
	КонецЕсли;

	Возврат СтрокаОтправки;
	
КонецФункции

#КонецОбласти

#Область Напоминание

&НаКлиенте
Процедура СобытиеНажатиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьДанныеНапоминанияНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеНапоминанияНаСервере()

	ИмяПоляНапоминатьОСобытии = НапоминанияПользователяКлиентСервер.ИмяПоляНапоминатьОСобытии();
	ИмяПоляИнтервалВремениНапоминания = НапоминанияПользователяКлиентСервер.ИмяПоляИнтервалВремениНапоминания();
	
	НастройкиНапоминания = НапоминанияПользователяКлиентСервер.НастройкиНапоминанияВФорме(ЭтотОбъект);
	Если НастройкиНапоминания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НапоминанияПоПредмету = НапоминанияПользователя.НайтиНапоминания(Объект.Ссылка);
	Если Не НапоминанияПоПредмету.Количество() Тогда
		
		ЭтотОбъект[ИмяПоляНапоминатьОСобытии] = Ложь;
		
		Если Не НастройкиНапоминания.ДобавлятьФлажок Тогда
			ЭтотОбъект[ИмяПоляИнтервалВремениНапоминания] = НапоминанияПользователяКлиентСервер.ПредставлениеПеречисленияНеНапоминать();
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;

	ДанныеСобытия = Новый Структура("Ссылка", Объект.Ссылка);

	// СтандартныеПодсистемы.НапоминанияПользователя
	НапоминанияПользователя.ПриЧтенииНаСервере(ЭтотОбъект, ДанныеСобытия);
	// Конец СтандартныеПодсистемы.НапоминанияПользователя
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНапоминаниеНаСервере()

	ДанныеСобытия = Новый Структура("Ссылка", Объект.Ссылка);
	
	// СтандартныеПодсистемы.НапоминанияПользователя
	НапоминанияПользователя.ПриЗаписиНаСервере(ЭтотОбъект, Ложь, ДанныеСобытия, Новый Структура);
	// Конец СтандартныеПодсистемы.НапоминанияПользователя
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти