
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияРМКПереопределяемый.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
	Если Параметры.Свойство("ТорговыйОбъект") Тогда
		ТорговыйОбъект = Параметры.ТорговыйОбъект;
	КонецЕсли;
	
	Если Параметры.Свойство("ВыборСклада") Тогда
		Заголовок = НСтр("ru = 'Выбор склада'");
		Элементы.СписокДанныеСтроки.Заголовок = НСтр("ru = 'Склады'");
		ОбщегоНазначенияРМКПереопределяемый.СформироватьЗапросСкладыДляРучногоВыбора(ЭтотОбъект);
	ИначеЕсли Параметры.Свойство("ВыборЯчейки") Тогда
		Заголовок = НСтр("ru = 'Выбор ячейки'");
		Элементы.СписокДанныеСтроки.Заголовок = НСтр("ru = 'Ячейки'");
		Склад = Параметры.Склад;
		ОбщегоНазначенияРМКПереопределяемый.СформироватьЗапросЯчейкиДляРучногоВыбора(ЭтотОбъект);
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
		Элементы.Переместить(Элементы.Выбрать, Элементы.ГруппаПоискТовара,
			Элементы.СписокОбновить);
		Ширина = 52;
	КонецЕсли;
	
	СоздатьЭлементыНастроекКаталога();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьОтображениеКаталогаПриОткрытии();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ПриЗакрытииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#Область СобытияНастройкиКаталога

&НаКлиенте
Процедура НастройкаКаталогаДанныеСтрокиПоУмолчаниюПриИзменении(Элемент)
	
	НастроитьБыстрыйОтбор(Список.КомпоновщикНастроек, "ПоУмолчанию", НастройкаКаталогаДанныеСтрокиПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаОстаткиВНаличииПриИзменении(Элемент)
	
	НастроитьБыстрыйОтбор(Список.КомпоновщикНастроек, "Доступно", НастройкаКаталогаОстаткиВНаличии);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаВыключательПоляПриИзменении(Элемент)
	
	ИменаСтраниц = Новый Массив;
	ИменаСтраниц.Добавить("ИспользоватьПоискПоСтроке");
	ИменаСтраниц.Добавить("Видимость");
	
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		ИмяПоляКаталога = СтрокаПоля.ИмяПоля;
		Для Каждого ИмяСтраницы Из ИменаСтраниц Цикл
			ИмяРеквизита = "НастройкаКаталога" + ИмяСтраницы + "_" + ИмяПоляКаталога;
			СтрокаПоля[ИмяСтраницы] = ЭтотОбъект[ИмяРеквизита];
		КонецЦикла;
	КонецЦикла;
	
	НомерПоля = СтрЗаменить(Элемент.Имя,"НастройкаКаталога", "");
	ИмяПоляИНастройка = СтрРазделить(НомерПоля, "_");
	
	СтруктураОтбора = Новый Структура("ИмяПоля", ИмяПоляИНастройка[1]);
	СтрокиПолей = НастройкаКаталогаНастройкиПолей.НайтиСтроки(СтруктураОтбора);
	Если СтрокиПолей.Количество() > 0 Тогда
		СтрокаПоля = СтрокиПолей[0];
		ИмяПоля = СтрокаПоля.ИмяПоля;
		ИмяНастройки = ИмяПоляИНастройка[0];
		
		ТекущееЗначение = СтрокаПоля[ИмяНастройки];
		ИменаПолей = Новый Массив;
		ИменаПолей.Добавить(ИмяПоля);
		Если ИмяНастройки = "Видимость" Тогда
			НастроитьВидимостьПолейКаталога(ИменаПолей, СтрокаПоля.Видимость);
			Если СтрокаПоля.ИспользоватьПоискПоСтроке Тогда
				НастроитьИспользованиеПоискаПолейКаталога(ИменаПолей, СтрокаПоля.Видимость);
			КонецЕсли;
		ИначеЕсли ИмяНастройки = "ИспользоватьПоискПоСтроке" Тогда
			НастроитьИспользованиеПоискаПолейКаталога(ИменаПолей, СтрокаПоля.ИспользоватьПоискПоСтроке);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЗафиксироватьВыбор();
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	Если НЕ Элементы.Выбрать.Доступность Тогда
		Элементы.Выбрать.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	ЗафиксироватьВыбор();
	
КонецПроцедуры

#Область КомандыНастройкиКаталога

&НаКлиенте
Процедура НастройкаКаталогаОткрытьНастройки(Команда)
	Элементы.ГруппаНастройкиКаталогаВсплывающая.Показать();
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаСброситьОтбор(Команда)
	СброситьНастройкиКаталога(Истина);
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаПоУмолчанию(Команда)
	
	НастройкаКаталогаВключитьВидимостьВсехПолей();
	НастройкаКаталогаВключитьВсеПоляПоиска();
	ВосстановитьПорядокКолонокКаталога();
	СброситьНастройкиКаталога(Истина, Истина);
	
	ИменаСтраниц = Новый Массив;
	ИменаСтраниц.Добавить("ИспользоватьПоискПоСтроке");
	ИменаСтраниц.Добавить("Видимость");
	
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		ИмяПоляКаталога = СтрокаПоля.ИмяПоля;
		Для Каждого ИмяСтраницы Из ИменаСтраниц Цикл
			ИмяРеквизита = "НастройкаКаталога" + ИмяСтраницы + "_" + ИмяПоляКаталога;
			ЭтотОбъект[ИмяРеквизита] = СтрокаПоля[ИмяСтраницы];
		КонецЦикла;
	КонецЦикла;
	
	Элементы.ГруппаНастройкиКаталогаВсплывающая.Скрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаЗакрыть(Команда)
	Элементы.ГруппаНастройкиКаталогаВсплывающая.Скрыть();
КонецПроцедуры

&НаКлиенте
Процедура КомандаНастройкаКаталогаПорядок(Команда)
	
	НомерПоля = СтрЗаменить(Команда.Имя, "НастройкаКаталогаПорядок_", "");
	Направление = ?(Сред(НомерПоля, 2) = "Вниз", 1, -1);
	НомерПоля = Лев(НомерПоля, 1);
	СтруктураОтбора = Новый Структура("Порядок", Число(НомерПоля));
	СтрокиПолей = НастройкаКаталогаНастройкиПолей.НайтиСтроки(СтруктураОтбора);
	
	Если СтрокиПолей.Количество() > 0 Тогда
		СтрокаПоля = СтрокиПолей[0];
		ИмяПоля = СтрокаПоля.ИмяПоля;
		ТекущееЗначение = СтрокаПоля["Порядок"];
		НастройкаКаталогаНастройкиПолей.Сдвинуть(ТекущееЗначение, Направление);
		ОбновитьНаименованиеКнопокПолейНастроекКаталога();
	КонецЕсли;
	
	РасставитьКолонкиКаталога();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗафиксироватьВыбор()
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	ПереопределенВыбор = Ложь;
	ОбщегоНазначенияРМККлиентПереопределяемый.ЗафиксироватьВыборСкладаЯчейки(ЭтотОбъект, ПереопределенВыбор);
	
	Если НЕ ПереопределенВыбор Тогда
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("ДанныеСтроки", ТекущиеДанные.ДанныеСтроки);
		
		Закрыть(СтруктураСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементаФормы(Элемент, Знач Видимость)
	Элемент.Видимость = Видимость;
КонецПроцедуры

&НаСервере
Процедура ПриЗакрытииНаСервере()
	ОбщегоНазначенияРМКПереопределяемый.ПриЗакрытииНаСервереФормыВыбораСкладЯчейка(ЭтотОбъект);
КонецПроцедуры

#Область НастройкиКаталога

&НаСервере
Процедура СоздатьЭлементыНастроекКаталога()
	
	Если ИспользоватьНастройкиКаталога Тогда
		УстановитьВидимостьЭлементаФормы(Элементы.НастройкаКаталогаОткрытьНастройки, Истина);
	Иначе
		УстановитьВидимостьЭлементаФормы(Элементы.НастройкаКаталогаОткрытьНастройки, Ложь);
		Возврат;
	КонецЕсли;
	
	НастроитьОтображениеОстатков();
	Если НастройкаКаталогаСбрасыватьОтбор Тогда
		СброситьНастройкиКаталога(Истина);
	КонецЕсли;
	
	НастройкаКаталогаИменаПолей.Очистить();
	КолонкиСписка = Элементы.Список.ПодчиненныеЭлементы;
	Для Каждого КолонкаСписка Из КолонкиСписка Цикл
		Если Не КолонкаСписка.Видимость Тогда
			Продолжить;
		КонецЕсли;
		Если КолонкаСписка.Вид = ВидГруппыФормы.ГруппаКолонок Тогда
			Для Каждого КолонкаГруппы Из КолонкаСписка.ПодчиненныеЭлементы Цикл
				Если КолонкаГруппы.Видимость И ЗначениеЗаполнено(КолонкаГруппы.ПутьКДанным) Тогда
					ИмяКолонки = СтрЗаменить(КолонкаГруппы.ПутьКДанным, "Список.", "");
					НастройкаКаталогаИменаПолей.Добавить(ИмяКолонки, КолонкаГруппы.Заголовок);
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если ЗначениеЗаполнено(КолонкаСписка.ПутьКДанным) Тогда	
				ИмяКолонки = СтрЗаменить(КолонкаСписка.ПутьКДанным, "Список.", "");
				НастройкаКаталогаИменаПолей.Добавить(ИмяКолонки, КолонкаСписка.Заголовок);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ИменаСтраниц = Новый Массив;
	ИменаСтраниц.Добавить("ИспользоватьПоискПоСтроке");
	ИменаСтраниц.Добавить("Порядок");
	ИменаСтраниц.Добавить("Видимость");
	
	Для Каждого ИмяСтраницы Из ИменаСтраниц Цикл
		
		СтраницаЭлементов = Элементы["НастройкаКаталога" + ИмяСтраницы];
		
		НомПП = 0;
		ДобавляемыеРеквизиты = Новый Массив;
		Для Каждого ИмяПоляКаталога Из НастройкаКаталогаИменаПолей Цикл
			ИмяРеквизита = "НастройкаКаталога" + ИмяСтраницы + "_" + ИмяПоляКаталога.Значение;
			НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Булево"));
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		КонецЦикла;
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		Для Каждого ИмяПоляКаталога Из НастройкаКаталогаИменаПолей Цикл
			Если ИмяСтраницы = "Порядок" Тогда
				
				ИмяЭлемента = "НастройкаКаталога" + ИмяСтраницы + "_" + НомПП;
				ЭлементГруппа = Элементы.Добавить(ИмяЭлемента + "Группа", Тип("ГруппаФормы"), СтраницаЭлементов);
				ЭлементГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
				ЭлементГруппа.ОтображатьЗаголовок = Ложь;
				
				ИмяКоманды = ИмяЭлемента + "Вниз";
				КомандаПорядок = Команды.Добавить(ИмяКоманды);
				КомандаПорядок.Действие = "КомандаНастройкаКаталогаПорядок";
				КомандаПорядок.Картинка = БиблиотекаКартинок.ПереместитьВниз;
				КомандаПорядок.Отображение = ОтображениеКнопки.Картинка;
				
				ЭлементКнопкаПорядокВниз = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементГруппа);
				ЭлементКнопкаПорядокВниз.ИмяКоманды = ИмяКоманды;
				ЭлементКнопкаПорядокВниз.Важность = ВажностьКнопки.Дополнительная;
				
				ИмяКоманды = ИмяЭлемента + "Вверх";
				КомандаПорядок = Команды.Добавить(ИмяКоманды);
				КомандаПорядок.Действие = "КомандаНастройкаКаталогаПорядок";
				КомандаПорядок.Картинка = БиблиотекаКартинок.ПереместитьВверх;
				КомандаПорядок.Отображение = ОтображениеКнопки.Картинка;
				
				ЭлементКнопкаПорядокВверх = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементГруппа);
				ЭлементКнопкаПорядокВверх.ИмяКоманды = ИмяКоманды;
				ЭлементКнопкаПорядокВверх.Важность = ВажностьКнопки.Дополнительная;
				
				Если НомПП = 0 Тогда
					ЭлементКнопкаПорядокВверх.Доступность = Ложь;
				КонецЕсли;
				
				ЭлементНадпись = Элементы.Добавить(ИмяЭлемента + "Надпись" , Тип("ДекорацияФормы"), ЭлементГруппа);
				ЭлементНадпись.Вид = ВидДекорацииФормы.Надпись;
				ЭлементНадпись.Заголовок = ИмяПоляКаталога.Представление;
				ЭлементНадпись.Ширина = 16;
				НомПП = НомПП + 1;
				
			Иначе
				
				ИмяРеквизита = "НастройкаКаталога" + ИмяСтраницы + "_" + ИмяПоляКаталога.Значение;
				ЭлементВыключатель = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), СтраницаЭлементов);
				ЭлементВыключатель.Вид = ВидПоляФормы.ПолеФлажка;
				ЭлементВыключатель.ВидФлажка = ВидФлажка.Выключатель;
				ЭлементВыключатель.ПутьКДанным = ИмяРеквизита;
				ЭлементВыключатель.Заголовок = ИмяПоляКаталога.Представление;
				ЭлементВыключатель.УстановитьДействие("ПриИзменении", "НастройкаКаталогаВыключательПоляПриИзменении");
				
				Если ИмяСтраницы = "ИспользоватьПоискПоСтроке"
					И ИмяПоляКаталога.Значение = "ПоУмолчанию" Тогда
					ЭлементВыключатель.Доступность = Ложь;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		Если ИмяСтраницы = "Порядок" Тогда
			ЭлементКнопкаПорядокВниз.Доступность = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтображениеКаталогаПриОткрытии()
	
	Если НЕ ИспользоватьНастройкиКаталога Тогда
		Возврат;
	КонецЕсли;
	
	АктуализироватьТаблицуНастроекПолейКатолога();
	НастроитьПоляКаталогаПриОткрытии();
	Если НЕ НастройкаКаталогаСбрасыватьОтбор Тогда
		НастроитьБыстрыеОтборы();
	КонецЕсли;
	
	ИменаСтраниц = Новый Массив;
	ИменаСтраниц.Добавить("ИспользоватьПоискПоСтроке");
	ИменаСтраниц.Добавить("Видимость");
	
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		ИмяПоляКаталога = СтрокаПоля.ИмяПоля;
		Для Каждого ИмяСтраницы Из ИменаСтраниц Цикл
			ИмяРеквизита = "НастройкаКаталога" + ИмяСтраницы + "_" + ИмяПоляКаталога;
			ЭтотОбъект[ИмяРеквизита] = СтрокаПоля[ИмяСтраницы];
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОтображениеОстатков()
	
	Если НЕ ОтображатьОстаток Тогда
		
		ИмяПоляДоступно = "Доступно";
		ОтключитьОтборы(ИмяПоляДоступно);
		
		ЭлементыПользовательскихНастроек = Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
		ПорядокКомпоновкиДанных = Неопределено;
		Для Каждого СтрокаНастройки Из ЭлементыПользовательскихНастроек Цикл
			Если ТипЗнч(СтрокаНастройки) = Тип("ПорядокКомпоновкиДанных") Тогда
				ПорядокКомпоновкиДанных = СтрокаНастройки.Элементы;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПорядокКомпоновкиДанных <> Неопределено Тогда
			Для Каждого ЭлементПорядка Из ПорядокКомпоновкиДанных Цикл
				ЭлементПорядка.Использование = Ложь;
			КонецЦикла;
		КонецЕсли;
		
		ПолеСписка = Список.Поля.Найти(ИмяПоляДоступно);
		Если ПолеСписка <> Неопределено Тогда
			ПолеСписка.ОграничениеИспользования.Условие = Истина;
			ПолеСписка.ОграничениеИспользования.Порядок = Истина;
			ПолеСписка.ОграничениеИспользованияРеквизитов.Условие = Истина;
			ПолеСписка.ОграничениеИспользованияРеквизитов.Порядок = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьВидимостьЭлементаФормы(Элементы.СписокДоступно, ОтображатьОстаток);
	УстановитьВидимостьЭлементаФормы(Элементы.НастройкаКаталогаОстаткиВНаличии, ОтображатьОстаток);
	
КонецПроцедуры

&НаКлиенте
Процедура АктуализироватьТаблицуНастроекПолейКатолога()
	
	СтрокиДляУдаления = Новый Массив;
	СоставКолонокКаталогаИзменен = Ложь;
	
	Для Каждого ИмяПоляКаталога Из НастройкаКаталогаИменаПолей Цикл
		
		ИмяКолонки = ИмяПоляКаталога.Значение;
		Отбор = Новый Структура("ИмяПоля", ИмяКолонки);
		СтрокиПолей = НастройкаКаталогаНастройкиПолей.НайтиСтроки(Отбор);
		
		Если СтрокиПолей.Количество() = 0 Тогда
			СтрокаПоля = НастройкаКаталогаНастройкиПолей.Добавить();
			СтрокаПоля.ИмяПоля = ИмяКолонки;
			СтрокаПоля.ИспользоватьПоискПоСтроке = Истина;
			СтрокаПоля.Видимость = Истина;
			СоставКолонокКаталогаИзменен = Истина;
		Иначе
			СтрокаПоляСопоставлена = Ложь;
			Для Каждого СтрокаПоля Из СтрокиПолей Цикл
				Если СтрокаПоляСопоставлена Тогда
					СтрокиДляУдаления.Добавить(СтрокаПоля);
				Иначе
					СтрокаПоляСопоставлена = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		Если НастройкаКаталогаИменаПолей.НайтиПоЗначению(СтрокаПоля.ИмяПоля) = Неопределено Тогда
			СтрокиДляУдаления.Добавить(СтрокаПоля);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл
		НастройкаКаталогаНастройкиПолей.Удалить(СтрокаДляУдаления);
		СоставКолонокКаталогаИзменен = Истина;
	КонецЦикла;
	
	Если СоставКолонокКаталогаИзменен Тогда
		НомерКолонки = 0;
		Для Каждого ИмяПоляКаталога Из НастройкаКаталогаИменаПолей Цикл
			ИмяКолонки = ИмяПоляКаталога.Значение;
			Отбор = Новый Структура("ИмяПоля", ИмяКолонки);
			СтрокиПолей = НастройкаКаталогаНастройкиПолей.НайтиСтроки(Отбор);
			Если СтрокиПолей.Количество() > 0 Тогда
				СтрокаПоля = СтрокиПолей[0];
				СтрокаПоля.Порядок = НомерКолонки;
			КонецЕсли;
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
	КонецЕсли;
	
	НастройкаКаталогаНастройкиПолей.Сортировать("Порядок");
	ОбновитьНаименованиеКнопокПолейНастроекКаталога();
	
	Если Не СоставКолонокКаталогаИзменен Тогда
		РасставитьКолонки = Ложь;
		НомерКолонки = 0;
		Для Каждого ИмяПоляКаталога Из НастройкаКаталогаИменаПолей Цикл
			ИмяКолонки = ИмяПоляКаталога.Значение;
			СтрокаПоля = НастройкаКаталогаНастройкиПолей[НомерКолонки];
			Если Не ИмяКолонки = СтрокаПоля.ИмяПоля Тогда
				РасставитьКолонки = Истина;
			КонецЕсли;
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
		
		Если РасставитьКолонки Тогда
			РасставитьКолонкиКаталога();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьПоляКаталогаПриОткрытии()
	
	ИменаПолейСкрытияВидимости = Новый Массив;
	ИменаПолейИсключенияПоиска = Новый Массив;
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		Если Не СтрокаПоля.Видимость Тогда
			ИменаПолейСкрытияВидимости.Добавить(СтрокаПоля.ИмяПоля);
		КонецЕсли;
		Если Не СтрокаПоля.ИспользоватьПоискПоСтроке Или Не СтрокаПоля.Видимость Тогда
			ИменаПолейИсключенияПоиска.Добавить(СтрокаПоля.ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	Если ИменаПолейСкрытияВидимости.Количество() > 0 Тогда
		НастроитьВидимостьПолейКаталога(ИменаПолейСкрытияВидимости, Ложь);
	КонецЕсли;
	
	Если ИменаПолейИсключенияПоиска.Количество() > 0 Тогда
		НастроитьИспользованиеПоискаПолейКаталога(ИменаПолейИсключенияПоиска, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьБыстрыеОтборы()
	
	Если Элементы.НастройкаКаталогаДанныеСтрокиПоУмолчанию.Видимость
		И ОтборАктивен(Список.КомпоновщикНастроек.Настройки.Отбор, "ПоУмолчанию") Тогда
		
		НастройкаКаталогаДанныеСтрокиПоУмолчанию = Истина;
	КонецЕсли;
	
	Если Элементы.НастройкаКаталогаОстаткиВНаличии.Видимость
		И ОтборАктивен(Список.КомпоновщикНастроек.Настройки.Отбор, "Доступно") Тогда
		
		НастройкаКаталогаОстаткиВНаличии = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьПолейКаталога(Знач ИменаПолей, Знач Видимость)
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Элементы["Список" + ИмяПоля].Видимость = Видимость;
		Если ИмяПоля <> "ПоУмолчанию" Тогда
			Элементы["НастройкаКаталогаИспользоватьПоискПоСтроке_" + ИмяПоля].Доступность = Видимость;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьИспользованиеПоискаПолейКаталога(Знач ИменаПолей, Знач ИспользоватьПоиск)
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ОграничениеПоиска = Не ИспользоватьПоиск;
		ПолеСписка = Список.Поля.Найти(ИмяПоля);
		Если Не ПолеСписка = Неопределено Тогда
			ПолеСписка.ОграничениеИспользования.Условие = ОграничениеПоиска;
			ПолеСписка.ОграничениеИспользованияРеквизитов.Условие = ОграничениеПоиска;
			Если ОграничениеПоиска Тогда
				ОтключитьОтборы(ИмяПоля);
			ИначеЕсли ИмяПоля = "ПоУмолчанию" Тогда
				Элементы.НастройкаКаталогаДанныеСтрокиПоУмолчанию.Доступность = Истина;
			ИначеЕсли ИмяПоля = "Доступно" Тогда
				Элементы.НастройкаКаталогаОстаткиВНаличии.Доступность = Истина;
			Иначе
				// Действие не требуется.
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаВключитьВидимостьВсехПолей()
	
	ИменаПолей = Новый Массив;
	ИменаПолейПоиска = Новый Массив;
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		Если Не СтрокаПоля.Видимость Тогда
			СтрокаПоля.Видимость = Не СтрокаПоля.Видимость;
			ИменаПолей.Добавить(СтрокаПоля.ИмяПоля);
			Если СтрокаПоля.ИспользоватьПоискПоСтроке Тогда
				ИменаПолейПоиска.Добавить(СтрокаПоля.ИмяПоля);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ИменаПолей.Количество() > 0 Тогда
		НастроитьВидимостьПолейКаталога(ИменаПолей, Истина);
	КонецЕсли;
	
	Если ИменаПолейПоиска.Количество() > 0 Тогда
		НастроитьИспользованиеПоискаПолейКаталога(ИменаПолейПоиска, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаВключитьВсеПоляПоиска()
	
	ИменаПолей = Новый Массив;
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		Если Не СтрокаПоля.ИспользоватьПоискПоСтроке И СтрокаПоля.Видимость Тогда
			СтрокаПоля.ИспользоватьПоискПоСтроке = Не СтрокаПоля.ИспользоватьПоискПоСтроке;
			ИменаПолей.Добавить(СтрокаПоля.ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	Если ИменаПолей.Количество() > 0 Тогда
		НастроитьИспользованиеПоискаПолейКаталога(ИменаПолей, Истина);
	КонецЕсли;
	
	Элементы.НастройкаКаталогаДанныеСтрокиПоУмолчанию.Доступность = Истина;
	Элементы.НастройкаКаталогаОстаткиВНаличии.Доступность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СброситьНастройкиКаталога(Знач СброситьОтбор = Ложь, Знач СброситьПорядок = Ложь)
	
	ЭлементыПользовательскихНастроек = Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	Для Каждого СтрокаНастройки Из ЭлементыПользовательскихНастроек Цикл
		Если СброситьОтбор И ТипЗнч(СтрокаНастройки) = Тип("ОтборКомпоновкиДанных") Тогда
			СтрокаНастройки.Элементы.Очистить();
		КонецЕсли;
		Если СброситьПорядок И ТипЗнч(СтрокаНастройки) = Тип("ПорядокКомпоновкиДанных") Тогда
			СтрокаНастройки.Элементы.Очистить();
		КонецЕсли;
	КонецЦикла;
	
	Если СброситьОтбор Тогда
		Если Элементы.НастройкаКаталогаДанныеСтрокиПоУмолчанию.Видимость
			И ОтборАктивен(Список.КомпоновщикНастроек.Настройки.Отбор, "ПоУмолчанию") Тогда
			
			НастройкаКаталогаДанныеСтрокиПоУмолчанию = Ложь;
			НастроитьБыстрыйОтбор(Список.КомпоновщикНастроек, "ПоУмолчанию", Ложь);
		КонецЕсли;
		Если Элементы.НастройкаКаталогаОстаткиВНаличии.Видимость
			И ОтборАктивен(Список.КомпоновщикНастроек.Настройки.Отбор, "Доступно") Тогда
			
			НастройкаКаталогаОстаткиВНаличии = Ложь;
			НастроитьБыстрыйОтбор(Список.КомпоновщикНастроек, "Доступно", Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОтборАктивен(Знач ОтборыПоиска, Знач ИмяПоля)
	
	ОтборАктивен = Ложь;
	Отборы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(ОтборыПоиска, ИмяПоля);
	Если Отборы.Количество() Тогда
		ОтборАктивен = Отборы[0].Использование;
	КонецЕсли;
	
	Возврат ОтборАктивен;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьБыстрыйОтбор(КомпоновщикНастроек, Знач ИмяОтбора, Знач Использование)
	
	Если ИмяОтбора = "ПоУмолчанию" Тогда
		ПравоеЗначение = Истина;
		ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Равно;
	ИначеЕсли ИмяОтбора = "Доступно" Тогда
		ПравоеЗначение = 0;
		ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Больше;
	Иначе
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(КомпоновщикНастроек.Настройки.Отбор,
		ИмяОтбора, ПравоеЗначение, ВидСравненияОтбора, , Использование);
	
КонецПроцедуры

&НаСервере
Процедура ОтключитьОтборы(Знач ИмяПоля)
	
	ПользовательскиеОтборы = Неопределено;
	
	ЭлементыПользовательскихНастроек = Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	Для Каждого СтрокаНастройки Из ЭлементыПользовательскихНастроек Цикл
		Если ТипЗнч(СтрокаНастройки) = Тип("ОтборКомпоновкиДанных") Тогда
			ПользовательскиеОтборы = СтрокаНастройки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ПользовательскиеОтборы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеОтбора = Новый ПолеКомпоновкиДанных(ИмяПоля);
	АктивныеОтборы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(ПользовательскиеОтборы, ИмяПоля);
	
	Для Каждого АктивныйОтбор Из АктивныеОтборы Цикл
		Если АктивныйОтбор.ЛевоеЗначение = ПолеОтбора Тогда
			АктивныйОтбор.Использование = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ПолеФлажкаОтбора = Неопределено;
	Если ИмяПоля = "ПоУмолчанию" Тогда
		ПолеФлажкаОтбора = Элементы.НастройкаКаталогаДанныеСтрокиПоУмолчанию;
		ФлагОтбора = НастройкаКаталогаДанныеСтрокиПоУмолчанию;
	ИначеЕсли ИмяПоля = "Доступно" Тогда
		ПолеФлажкаОтбора = Элементы.НастройкаКаталогаОстаткиВНаличии;
		ФлагОтбора = НастройкаКаталогаОстаткиВНаличии;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если НЕ ПолеФлажкаОтбора.Видимость Тогда
		Возврат;
	КонецЕсли;
		
	ПолеФлажкаОтбора.Доступность = Ложь;
	ОтборАктивен = ОтборАктивен(Список.КомпоновщикНастроек.Настройки.Отбор, ИмяПоля);
	Если ОтборАктивен Тогда
		ФлагОтбора = Ложь;
		НастроитьБыстрыйОтбор(Список.КомпоновщикНастроек, ИмяПоля, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНаименованиеКнопокПолейНастроекКаталога()
	
	ИндексСтроки = 0;
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		СтрокаПоля.Порядок = ИндексСтроки;
		Элементы["НастройкаКаталогаПорядок_" + ИндексСтроки + "Надпись"].Заголовок =
			НастройкаКаталогаИменаПолей.НайтиПоЗначению(СтрокаПоля.ИмяПоля).Представление;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РасставитьКолонкиКаталога()
	
	Для Каждого СтрокаНастройкиПоля Из НастройкаКаталогаНастройкиПолей Цикл
		КолонкаКаталога = Элементы["Список" + СтрокаНастройкиПоля.ИмяПоля];
		Элементы.Переместить(КолонкаКаталога, Элементы.Список);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьПорядокКолонокКаталога()
	
	НомерКолонки = 0;
	Для Каждого ИмяПоляКаталога Из НастройкаКаталогаИменаПолей Цикл
		ИмяКолонки = ИмяПоляКаталога.Значение;
		Отбор = Новый Структура("ИмяПоля", ИмяКолонки);
		СтрокиПолей = НастройкаКаталогаНастройкиПолей.НайтиСтроки(Отбор);
		Если СтрокиПолей.Количество() > 0 Тогда
			СтрокаПоля = СтрокиПолей[0];
			СтрокаПоля.Порядок = НомерКолонки;
		КонецЕсли;
		НомерКолонки = НомерКолонки + 1;
