Процедура ОтветНетАвтономнаяКасса(ПараметрыОперации)
	
	ДополнительныеПараметры = Неопределено;
	МенеджерОборудованияРМККлиент.ПараметрыВыполненияОперацииНаАвтономнойККТ(ДополнительныеПараметры);
	
	Если ПараметрыОперации.Команда = "CheckFiscalization" Тогда
		ДополнительныеПараметры.ПараметрыОперации = ПараметрыОперации.ОбщиеПараметры;
		ДополнительныеПараметры.Команда = ПараметрыОперации.Команда;
		ДополнительныеПараметры.ОповещениеПриЗавершении = Неопределено;
		ДополнительныеПараметры.ИспользуетсяОчередьПробития = Истина;
		ДополнительныеПараметры.ИдентификаторКлиента = УникальныйИдентификатор;
		ПодключитьОбработчикОжидания("ПроверитьСтатусЧекаНаКлиенте", 1, Истина); 
	ИначеЕсли ПараметрыОперации.Команда = "Encash" Тогда
		ДополнительныеПараметры.ПараметрыОперации = ПараметрыОперации.ОбщиеПараметры;
		ДополнительныеПараметры.Команда = ПараметрыОперации.Команда;
		ДополнительныеПараметры.ОповещениеПриЗавершении = Новый ОписаниеОповещения("ВыполнитьОперациюВнесениеЗавершение", ЭтотОбъект);
		ДополнительныеПараметры.ИспользуетсяОчередьПробития = Ложь;
		ДополнительныеПараметры.ИдентификаторКлиента = УникальныйИдентификатор;
	КонецЕсли;
		
	МенеджерОборудованияРМККлиент.ВыполнитьКомандуЗавершениеАвтономнойККТ(КодВозвратаДиалога.Нет, ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область СообщениеОбОшибке

&НаКлиенте
Процедура ЗакрытиеФормыВзаимодействияСОборудованием(Результат, ДополнительныеПараметры) Экспорт
	
	ПовторноеПробитие = Ложь;
	
	Если Результат = Неопределено Тогда
		СброитьФлагиПереходаКОплате();
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ТерминалОплатаПодтверждена") Тогда
		ОтветДаТерминал();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ТерминалОплатаОтклонена") Тогда
		РежимРаботыСЧеком = РежимыРаботыСЧеком.ВводТоваров;
		ИнтерфейсРМКСлужебныйКлиентСервер.НастроитьДоступностьЭлементовФормыПриПереключенииРежима(ЭтотОбъект, Ложь);
		СброитьФлагиПереходаКОплате();
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "АвтономнаяККТОплатаПодтверждена") Тогда
		ОтветДаАвтономнаяКасса(ДополнительныеПараметры);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "АвтономнаяККТОплатаОтклонена") Тогда
		ОтветНетАвтономнаяКасса(ДополнительныеПараметры);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ОтменитьОплатуКартой") Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "НеобходимоПодтверждениеОперации") Тогда
			ОтменитьОплатуПодтверждениеПрав();
		Иначе
			ОтменитьОплатуПодтверждениеПравПродолжение();
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ПовторитьПробитие") Тогда
		ПовторноеПробитие = Истина;
		НачатьПечатьЧека();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ОтложитьЧек") Тогда
		ОтложитьЧекНаКлиенте();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ПовторитьФискальнуюОперацию") Тогда
		ПовторитьОперациюПакетнойФискализацииКлиент();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "УдалитьЧек") Тогда
		УдалитьЧекНаКлиенте();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ВыполнитьСторноПоКарте") Тогда
		ВыполнитьСторноПоКарте();
	КонецЕсли;
	СброитьФлагиПереходаКОплате();
	
КонецПроцедуры

&НаКлиенте
Процедура СброитьФлагиПереходаКОплате()
	
	ПроцессПереходаКОплате = Ложь;
	РежимТихойОплаты = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ВыборСерии
&НаКлиенте
Процедура УказатьСериюНаКлиенте(ТекущаяСтрока = Неопределено)
	
	СкрытьЦифровуюПанельДляВводаСуммПриНеобходимости();
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		Если ТекущаяСтрока = Неопределено Тогда
			ТекстПредупреждения = НСтр("ru = 'Не выбрана строка для указания серии.'");
			ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстПредупреждения);
			ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
			ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ТекущийТоварИдентификатор = ТекущаяСтрока.ПолучитьИдентификатор();
	
	Если ТекущаяОперация = "" И РежимКассыСамообслуживания Тогда
		
		ПараметрыТекущейОперации = Новый Структура;
		ПараметрыТекущейОперации.Вставить("ИдентификаторСтроки", ТекущаяСтрока.ПолучитьИдентификатор());
		
		НеобходимоеПраво = "ПравоВыбораСерииРМК";
		ТекущаяОперация = "ВыборСерииРМК";
		ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОбщая);
		ПредложитьЗаменитьПраваКассира(НеобходимоеПраво);
		Если Не Элементы.ГруппаОперации.Видимость Тогда
			ИнтерфейсРМКСлужебныйКлиентСервер.УстановитьВидимостьГруппыОперации(Элементы);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	МассивСерий = Новый Массив;
	ЗаполнитьДанныеВыбораСерий(МассивСерий);
	
	ПравоРедактироватьНоменклатуру = НЕ СписокРолейПользователя.НайтиПоЗначению("ПравоУдалитьЧекРМК") = ПравоРедактироватьНоменклатуру;
	
	Если МассивСерий.Количество() = 0
		И (Не РазрешитьСозданиеСерий Или НЕ ПравоРедактироватьНоменклатуру Или ТекущаяСтрока.ПроверятьЗаполнениеСерий) Тогда
		Если ЗначениеЗаполнено(НаименованиеПользователяПриЗапросеПрав) Тогда
			НаправлениеОбращения = НаименованиеПользователяПриЗапросеПрав;
		Иначе
			НаправлениеОбращения = НСтр("ru = 'администратору'");
		КонецЕсли;
		ТекстПредупреждения = СтрШаблон(НСтр("ru = 'У номенклатуры %1 нет серий для выбора.'"),
			ТекущаяСтрока.ПредставлениеНоменклатураХарактеристика) + Символы.ПС + СтрШаблон(НСтр("ru = 'Обратитесь к %1.'"), НаправлениеОбращения);
		ТекстЗаголовка = НСтр("ru = 'Выбор серии'");
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстПредупреждения, ТекстЗаголовка);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		Возврат;
	КонецЕсли;
	
	Если СерииНеВыгружаются Тогда
		ВыбраннаяСерия = ТекущаяСтрока.ИдентификаторСерий;
	Иначе
		ВыбраннаяСерия = ТекущаяСтрока.Серия;
	КонецЕсли;
	
	ДанныеНоменклатуры = Новый Структура;
	ДанныеНоменклатуры.Вставить("ПредставлениеНоменклатуры", ТекущаяСтрока.ПредставлениеНоменклатураХарактеристика);
	ДанныеНоменклатуры.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
	ДанныеНоменклатуры.Вставить("ЭтоПодарочныйСертификат", ТекущаяСтрока.ЭтоПодарочныйСертификат);
	ДанныеНоменклатуры.Вставить("ПроверятьЗаполнениеСерий",ТекущаяСтрока.ПроверятьЗаполнениеСерий);
	ДанныеНоменклатуры.Вставить("ПравоРедактироватьНоменклатуру",ПравоРедактироватьНоменклатуру);
	ОткрытьФормуВводаШтрихкодаСерии(МассивСерий, ДанныеНоменклатуры, ВыбраннаяСерия);
	
	ОчиститьОчередьШтрихкодов();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеВыбораСерий(МассивСерий)
	
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ТекущийТоварИдентификатор);
	
	Если СерииНеВыгружаются Тогда
		ЗаполнитьДанныеСерийЧерезСерверЛояльности(ТекущаяСтрока, МассивСерий);
	Иначе
		ЗаполнитьДанныеСерий(ТекущаяСтрока, МассивСерий);
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСерийЧерезСерверЛояльности(ТекущаяСтрока, МассивСерий)
	
	МассивУжеДобавленныхСерий = Объект.Товары.Выгрузить().ВыгрузитьКолонку("ИдентификаторСерий");
	СтрокаМассива = МассивУжеДобавленныхСерий.Найти(ТекущаяСтрока.ИдентификаторСерий);
	Если НЕ СтрокаМассива = Неопределено Тогда
		МассивУжеДобавленныхСерий.Удалить(СтрокаМассива);
	КонецЕсли;
	
	СтруктураСтроки = Новый Структура;
	СтруктураСтроки.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
	СтруктураСтроки.Вставить("Характеристика", ТекущаяСтрока.Характеристика);
	
	ПараметрыЗапросаСерий = Новый Структура;
	ПараметрыЗапросаСерий.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
	ПараметрыЗапросаСерий.Вставить("ВидОперации", Объект.ВидОперации);
	ПараметрыЗапросаСерий.Вставить("ТекущаяНастройкаРМК", ТекущаяНастройкаРМК);
	
	ОбщегоНазначенияРМК.ЗаполнитьСписокВыбораСерийНоменклатурыБСЛ(СтруктураСтроки, МассивСерий, МассивУжеДобавленныхСерий, ПараметрыЗапросаСерий);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСерий(ТекущаяСтрока, МассивСерий)
	
	МассивУжеДобавленныхСерий = Объект.Товары.Выгрузить().ВыгрузитьКолонку("Серия");
	СтрокаМассива = МассивУжеДобавленныхСерий.Найти(ТекущаяСтрока.Серия);
	Если НЕ СтрокаМассива = Неопределено Тогда
		МассивУжеДобавленныхСерий.Удалить(СтрокаМассива);
	КонецЕсли;
	
	ПараметрыЗапросаСерий = Новый Структура;
	ПараметрыЗапросаСерий.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
	ПараметрыЗапросаСерий.Вставить("Характеристика", ТекущаяСтрока.Характеристика);
	ПараметрыЗапросаСерий.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
	ПараметрыЗапросаСерий.Вставить("ВидОперации", Объект.ВидОперации);
	
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьСписокВыбораСерийНоменклатуры(
		ПараметрыЗапросаСерий,
		МассивСерий,
		МассивУжеДобавленныхСерий);
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВводаШтрихкодаСерии(МассивСерий, ДанныеНоменклатуры, ВыбраннаяСерия)
	Если РежимВводаСерии Тогда
		Возврат;
	КонецЕсли;
	РежимВводаСерии = Истина;
	ПараметрыОткрытия = ПараметрыФормыВводаШтрихкода();
	ПараметрыОткрытия.ВыборСерии = Истина;
	ПараметрыОткрытия.Заголовок = ДанныеНоменклатуры.ПредставлениеНоменклатуры;
	ПараметрыОткрытия.МассивЗначений = МассивСерий;
	ПараметрыОткрытия.ВыбранноеЗначение = ВыбраннаяСерия;
	ПараметрыОткрытия.Номенклатура = ДанныеНоменклатуры.Номенклатура;
	ПараметрыОткрытия.МожноВводитьПустоеЗначение = НЕ ДанныеНоменклатуры.ПроверятьЗаполнениеСерий;
	ПараметрыОткрытия.СкрытьКомандуСоздатьСерии = Не РазрешитьСозданиеСерий Или ДанныеНоменклатуры.ЭтоПодарочныйСертификат
		Или ДанныеНоменклатуры.ПроверятьЗаполнениеСерий Или НЕ ДанныеНоменклатуры.ПравоРедактироватьНоменклатуру;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("МассивСерий", МассивСерий);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьРезультатПоискаСерии", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВводаШтрихкода", ПараметрыОткрытия, Этотобъект, , , ,
		ОписаниеОповещения, РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСерии()
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ЭтоОперацияПродажа = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации);
	
	Если СерииНеВыгружаются Тогда
		ВыбраннаяСерия = ТекущаяСтрока.ИдентификаторСерий;
	Иначе
		ВыбраннаяСерия = ТекущаяСтрока.Серия;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыбраннаяСерия)
		И ТекущаяСтрока.ТипНоменклатуры = ОбщегоНазначенияРМККлиент.ТипНоменклатурыПодарочныйСертификат() И ЭтоОперацияПродажа Тогда
		СерияПродана = ПроверитьСериюПодарочногоСертификата(ВыбраннаяСерия);
		Если СерияПродана Тогда
			
			ТекущаяСтрока.ИдентификаторСерий = НСтр("ru = ''");
			ТекущаяСтрока.Серия = Неопределено;
			ТекущаяСтрока.СерияПредставление = НСтр("ru = ''");
			
			Если ЗначениеЗаполнено(НаименованиеПользователяПриЗапросеПрав) Тогда
				НаправлениеОбращения = НаименованиеПользователяПриЗапросеПрав;
			Иначе
				НаправлениеОбращения = НСтр("ru = 'администратору'");
			КонецЕсли;
			ТекстЗаголовка = НСтр("ru = 'Продажа подарочного сертификата'");
			ТекстОшибки = НСтр("ru = 'Подарочный сертификат с данным номером уже был реализован ранее.'") +
				Символы.ПС + СтрШаблон(НСтр("ru = 'Обратитесь к %1.'"), НаправлениеОбращения);
			ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстОшибки, ТекстЗаголовка);
			ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
			ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОтменитьСкидки();
	
	ЦенаСерии = 0;
	ЗаполнитьЦенуСерии(ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Характеристика, ВыбраннаяСерия, ЦенаСерии);
	Если ЦенаСерии > 0
		И ЦенаСерии <> ТекущаяСтрока.Цена Тогда
		ТекущийТоварЦенаИзКарточки = ЦенаСерии;
		ЦенаИзКарточкиПриИзмененииЗавершение(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
	
	Если ЭтоЗаменаТоваров Тогда
		НастроитьДоступностьПробитьЧек();
	Иначе
		ИнтерфейсРМКСлужебныйКлиент.НастроитьДоступностьРежимаОплаты(ЭтотОбъект);
	КонецЕсли;
	
	УточнитьДанныеДляСтрокиПриВыбореСерииИПартии();
	ОбщегоНазначенияРМККлиентСервер.УстановитьНомерКартинкиСтрокиТовара(ТекущаяСтрока);
	НастроитьКомандуУказатьСерии(ТекущаяСтрока);
	Если ИспользоватьУточненияПринадлежностиЗапасов Тогда
		ЗаполнитьОрганизаюКомитентаПоУточнению(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СерияТекущейСтрокиНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	УказатьСериюНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьУправляемуюСкидку(Команда)
	ОткрытьФормуДобавленияУправляемойСкидки();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПодарок(Команда)
	ДополнительныеПараметры = Новый Структура("ПерейтиКОплате", Ложь);
	ОткрытьФормуВыдачиПодарка(ДополнительныеПараметры);
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуВыдачиПодарка(ДополнительныеПараметры = Неопределено)
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура("ПерейтиКОплате", Истина);
	КонецЕсли;
	Если НЕ СкидкиРассчитаны Тогда 
		РассчитатьСкидкиКлиент();
	КонецЕсли;
	ОповещениеПродолжения = Новый ОписаниеОповещения(
		"ПрименитьВыданныеПодарки",
		ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыДляОткрытия = Новый Структура;
	ПараметрыДляОткрытия.Вставить("ТекущаяНастройкаРМК", ТекущаяНастройкаРМК);
	ПараметрыДляОткрытия.Вставить("Кассир", Объект.Кассир);
	ПараметрыДляОткрытия.Вставить("Организация", Объект.Организация);
	ПараметрыДляОткрытия.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
	ПараметрыДляОткрытия.Вставить("ЭтоПродажа", ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации));
	АдресОписания = ОписаниеВариантовПодарков();
	ПараметрыДляОткрытия.Вставить("АдресСостоянияПодарков", АдресОписания);
	
	
	РежимОткрытия = РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца;
	ОткрытьФорму("ОбщаяФорма.РМКФормаВыдачиПодарка", ПараметрыДляОткрытия,ЭтотОбъект,,,,ОповещениеПродолжения,РежимОткрытия);

КонецПроцедуры

&НаСервере
Функция ОписаниеВариантовПодарков()
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаПодаркиБезВыбора", ТаблицаПодаркиБезВыбора.Выгрузить());
	Результат.Вставить("ТаблицаПодаркиНаВыбор", ТаблицаПодаркиНаВыбор.Выгрузить());
	ТаблицаРанееВыданныхПодарков = ТаблицаПодарков.Выгрузить();
	СтрокиВыданныхПодарков = Объект.Товары.НайтиСтроки(Новый Структура("Подарок", Истина));
	Для Каждого ПодарокВЧеке Из СтрокиВыданныхПодарков Цикл
		ВыданныйПодарок = ТаблицаРанееВыданныхПодарков.Добавить();
		ЗаполнитьЗначенияСвойств(ВыданныйПодарок, ПодарокВЧеке);
	КонецЦикла;
	Результат.Вставить("ТаблицаРанееВыданныеПодарки", ТаблицаРанееВыданныхПодарков);
	АдресРезультата = ПоместитьВоВременноеХранилище(Результат);
	Возврат АдресРезультата;
КонецФункции

&НаКлиенте
Процедура ПрименитьВыданныеПодарки(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	НуженПереходКОплате = ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
		И ДополнительныеПараметры.Свойство("ПерейтиКОплате")
		И ДополнительныеПараметры.ПерейтиКОплате;
	Если Не Результат = Неопределено Тогда
		
		СкидкиРасчитаныДоВыдачиПодарка = СкидкиРассчитаны;
		ПрименитьВыданныеПодаркиНаСервере(Результат);
		ПодаркиКВыдаче = ТаблицаПодарков.НайтиСтроки(Новый Структура("ОтказОтВыдачиПодарка", Ложь));
		Для Каждого СтрокаПодарка Из ПодаркиКВыдаче Цикл
			ОбработатьВыдачуПодарка(СтрокаПодарка);
		КонецЦикла;
		ТаблицаПодарковОчиститьВременныеСтроки(ТаблицаПодарков);
		Если СкидкиРасчитаныДоВыдачиПодарка Тогда
			ПерераспределитьСкидкиЗаПодарки();
			СкидкиРассчитаны = Истина;
		КонецЕсли;
		Если НуженПереходКОплате Тогда
			ПереходКОплатеПослеВыдачиПодарков();
		КонецЕсли;
		
	КонецЕсли;
	ЭтоВозвратПродажи = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	Если ЭтоВозвратПродажи И Не НуженПереходКОплате Тогда
		ИнтерфейсРМКСлужебныйКлиент.ЗаполнитьКэшДанныхОплатВозврата(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПерераспределитьСкидкиЗаПодарки()
	
	ТаблицаСкидокНаценокИзЗапроса = ТаблицаСкидкиНаценки.Выгрузить();
	ТаблицаПодарковИзЗапроса = ТаблицаПодарков.Выгрузить();
	СтрокиТоваровПодарков = Объект.Товары.НайтиСтроки(Новый Структура("Подарок", Истина));
	Для Каждого РанееВыданныйПодарок Из СтрокиТоваровПодарков Цикл
		Подарок = ТаблицаПодарковИзЗапроса.Добавить();
		ЗаполнитьЗначенияСвойств(Подарок, РанееВыданныйПодарок);
		Подарок.Сумма = РанееВыданныйПодарок.СуммаБезСкидки;
	КонецЦикла;
	ОбщегоНазначенияРМКПереопределяемый.ОбработатьТаблицуПодарков(ЭтотОбъект, Объект.Товары, ТаблицаПодарковИзЗапроса, ТаблицаСкидокНаценокИзЗапроса); 
	ТаблицаСкидкиНаценки.Загрузить(ТаблицаСкидокНаценокИзЗапроса);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ТаблицаПодарковОчиститьВременныеСтроки(ТаблицаПодарков)
	СтрокиНеОтказ = ТаблицаПодарков.НайтиСтроки(Новый Структура("ОтказОтВыдачиПодарка", Ложь));
	Для Каждого СтрокаУдалить Из СтрокиНеОтказ Цикл
		ТаблицаПодарков.Удалить(СтрокаУдалить);
	КонецЦикла;
КонецПроцедуры 

&НаСервере
Процедура ПрименитьВыданныеПодаркиНаСервере(ОписаниеРезультатаВыдачиПодарков)
	НеобходимоПересчитатьСкидки = Ложь;
	//ТаблицаПодарковОчиститьВременныеСтроки(ТаблицаПодарков);
	ТаблицаПодаркиБезВыбора.Очистить();
	ТаблицаПодаркиНаВыбор.Очистить();
	Если ОписаниеРезультатаВыдачиПодарков.Свойство("АдресТаблицыВыданныхПодарков") Тогда
		ВыданныеПодарки = ПолучитьИзВременногоХранилища(ОписаниеРезультатаВыдачиПодарков.АдресТаблицыВыданныхПодарков);
		ОтборСтрок = Новый Структура("ВыданРанее", Ложь);
		ПодаркиНужноДобавитьВЧек = ВыданныеПодарки.НайтиСтроки(ОтборСтрок);
		Для Каждого СтрокаПодарка Из ПодаркиНужноДобавитьВЧек Цикл
			ВыданныйПодарок = ТаблицаПодарков.Добавить();
			ЗаполнитьЗначенияСвойств(ВыданныйПодарок, СтрокаПодарка);
		КонецЦикла;
	КонецЕсли;
	Если ОписаниеРезультатаВыдачиПодарков.Свойство("АдресТаблицыОтказаОтПодарков") Тогда
		ПодаркиОтказ = ПолучитьИзВременногоХранилища(ОписаниеРезультатаВыдачиПодарков.АдресТаблицыОтказаОтПодарков);
		ОтборСтрок = Новый Структура("ВыданРанее", Истина);
		ПодаркиНужноУдалитьИзЧека = ПодаркиОтказ.НайтиСтроки(ОтборСтрок);
		Для Каждого СтрокаПодарка Из ПодаркиНужноУдалитьИзЧека Цикл
			//ОбработатьВыборПодарка(СтрокаПодарка);
			ОтборСтрокиТовара = Новый Структура("ИдентификаторСтроки", СтрокаПодарка.ИдентификаторСтроки);
			СтрокиПодарковОтменить = Объект.Товары.НайтиСтроки(ОтборСтрокиТовара);
			Для Каждого СтрокаОтменить Из СтрокиПодарковОтменить Цикл
				ОбщегоНазначенияРМККлиентСервер.УдалитьСтрокуТовара(ЭтаФорма, СтрокаОтменить, Объект.Товары);
			КонецЦикла;
			ТребуетсяПересчетСкидок = Истина;
		КонецЦикла;
		ОтборСтрок = Новый Структура("ВыданРанее", Ложь);
		ПодаркиЗафиксироватьОтказ = ПодаркиОтказ.НайтиСтроки(ОтборСтрок);
		Для Каждого СтрокаПодарка Из ПодаркиЗафиксироватьОтказ Цикл
			СтрокаПодаркаОтказ = ТаблицаПодарков.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПодаркаОтказ, СтрокаПодарка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПодробностиСкидок(Команда)
	//ПоказатьРассчитанныеСкидкиНаЧек();
	ПереключитьРежимНаПоказСкидок(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУправляемуюСкидкуНаСтроку(СтрокаСкидки)
	
	ИдентификаторСтроки = СтрокаСкидки.ИдентификаторСтроки;
	СкидкаНаценка = ?(ТипЗнч(СтрокаСкидки.СкидкаНаценка) = Тип("Строка"),
		СтрокаСкидки.СкидкаНаценка, Строка(СтрокаСкидки.СкидкаНаценка.УникальныйИдентификатор()));
	СтрокиУправляемыхСкидок = ТаблицаУправляемыхСкидок.НайтиСтроки(Новый Структура("ИдентификаторСкидки", СкидкаНаценка));
	ИдентификаторСкидки = Неопределено;
	ОбластьДействия = "На строку";
	Если СтрокиУправляемыхСкидок.Количество() Тогда
		ОписаниеУправляемойСкидки = СтрокиУправляемыхСкидок[0];
		ИдентификаторСкидки = ОписаниеУправляемойСкидки.ИдентификаторСкидки;
		ОбластьДействия = ОписаниеУправляемойСкидки.ОбластьДействия;
	КонецЕсли;
	Если ОбластьДействия = "На документ" Тогда 
		ИдентификаторСтроки = "";
	КонецЕсли;
	Отбор = Новый Структура("ИдентификаторСтроки, ИдентификаторСкидки", ИдентификаторСтроки, ИдентификаторСкидки);
	СтрокиУправляемыхСкидок = ТаблицаВыбранныхУправляемыхСкидок.НайтиСтроки(Отбор);
	БылоЧтоУдалять = Ложь;
	Для Каждого СтрокаСкидки Из СтрокиУправляемыхСкидок Цикл
		БылоЧтоУдалять = Истина;
		УдалитьУправляемуюСкидку(СтрокаСкидки.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	Если БылоЧтоУдалять Тогда
		Если НЕ РаботаВРежимеМедленногоСоединения Тогда
			РассчитатьСкидкиКлиент();
		Иначе
			ТребуетсяПересчетСкидок = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

