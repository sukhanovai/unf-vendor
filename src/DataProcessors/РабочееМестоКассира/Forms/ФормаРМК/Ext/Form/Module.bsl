&НаКлиенте
Процедура ОткрытьПоискКлиента(ВыборКонтрагента = Ложь, СозданиеКарты = Ложь,
	РедактированиеКарты = Ложь, ШтрихкодДляПоиска = Неопределено,  РежимПредоплаты = Ложь)
	
	Если Не ИспользоватьДисконтныеКарты
		И Не РежимТихойОплаты Тогда
		ОткрытьФормуВыбораКонтрагента();
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = ИнтерфейсРМКСлужебныйКлиентСервер.ПараметрыФормыВводаПокупателя();
	ЗаполнитьЗначенияСвойств(ПараметрыОткрытия, ЭтотОбъект,
		"ЗапоминатьНомерКартыЛояльности, ТекущаяНастройкаРМК, КодВалютыЦены, РазрешитьЗаменуДисконтнойКарты, ПодключенаОблачнаяККТ");
	ПараметрыОткрытия.СуммаДокумента = СуммаКОплате;
	ПараметрыОткрытия.ОстатокБалловНаКарте = КоличествоБонусов;
	ПараметрыОткрытия.Контрагент = Объект.Контрагент;
	ПараметрыОткрытия.ДисконтнаяКарта = Объект.ДисконтнаяКарта;
	ПараметрыОткрытия.ПараметрыКартыЛояльности = ПараметрыКартыЛояльности;
	ПараметрыОткрытия.ЭтоРаботаСАвансом = ЭтоРаботаСАвансом();
	ПараметрыОткрытия.ИспользоватьДисконтныеКарты = ИспользоватьДисконтныеКарты;
	ПараметрыОткрытия.ЭлектронныйЧек = ПодключенаОблачнаяККТ Или (Не ПечататьБумажныйЧек И (РежимТихойОплаты Или ЗначениеЗаполнено(Объект.ЗаказПокупателя)));
	Если НЕ ШтрихкодДляПоиска = Неопределено Тогда
		ПараметрыОткрытия.ШтрихкодДляПоиска = ШтрихкодДляПоиска;
	КонецЕсли;
	Если СозданиеКарты Тогда
		ПараметрыОткрытия.ВидСоздаваемойКарты = НоваяКартаВидКарты;
		ПараметрыОткрытия.НомерСоздаваемойКарты = НоваяКартаНомер;
	КонецЕсли;
	Если ВыборКонтрагента Тогда
		ПараметрыОткрытия.ЗаголовокФормы = НСтр("ru = 'Выбор покупателя'");
		ПараметрыОткрытия.РежимВыбораКонтрагента = Истина;
	КонецЕсли;
	ПараметрыОткрытия.ПродолжатьБезКарты = ПроцессПереходаКОплате Или РежимТихойОплаты;
	ПараметрыОткрытия.ТорговыйОбъект = Объект.ТорговыйОбъект;
	ПараметрыОткрытия.Организация = Объект.Организация;
	ПараметрыОткрытия.Вставить("УвеличенныйВариантМасштаба", УвеличенныйВариантМасштаба);
	ПараметрыОткрытия.ТаблицаВидыКарт = ТаблицаВидыКарт;
	ОбщегоНазначенияРМККлиентПереопределяемый.ДополнитьПараметрыОткрытияФормыВыбораПокупателя(ЭтотОбъект, ПараметрыОткрытия);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимПредоплаты", РежимПредоплаты);
	ОбработкаОповещения = Новый ОписаниеОповещения("ВыборКартыИлиПокупателя",
		ЭтотОбъект, ДополнительныеПараметры);

	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВыбораПокупателя85",
		ПараметрыОткрытия, ЭтотОбъект,,,, ОбработкаОповещения, РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца,
		РежимОтображенияОкнаФормы.ВДиалоговомОкне);
		
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюРеквизитовКарты() Экспорт
	
	ПокупательУказан = ИнтерфейсРМКСлужебныйКлиентСервер.ДанныеЛояльностиЗаполнены(ЭтотОбъект);
	ИзменитьКартинкуВводПокупателяБезКонтекста(ЭтотОбъект);
	УстановитьВидимостьЭлементаФормы(Элементы.ИнформацияОБаллах, ИспользоватьОплатуБонусами И ВведенаБонуснаяКарта);
	УстановитьВидимостьЭлементаФормы(Элементы.КоличествоБонусовВКарточке, ВведенаБонуснаяКарта И ИспользоватьОплатуБонусами);
	УстановитьВидимостьЭлементаФормы(Элементы.ОтменитьВводКартыКрестик, ПокупательУказан);
	УстановитьВидимостьЭлементаФормы(Элементы.ДанныеКартыКлиента, ПокупательУказан);
	Если ПокупательУказан Тогда
		Элементы.ВвестиДанныеПокупателя.Отображение = ОтображениеКнопки.Картинка;
	Иначе
		Элементы.ВвестиДанныеПокупателя.Отображение = ОтображениеКнопки.КартинкаИТекст;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКартыИлиПокупателя(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Если ПроцессПереходаКОплате
			Или РежимТихойОплаты Тогда
			ОтказОтОплатыБонусами = Истина;
		КонецЕсли;
		Если ПриемАванса Или ЭтоЗачетАванса Или ЭтоОплатаРассрочки
			Или ДополнительныеПараметры.РежимПредоплаты Тогда
			ВводитьПокупателя = НЕ ЗначениеЗаполнено(Объект.Контрагент)
				И ОбщегоНазначенияРМККлиент.ЗапрещенаПредоплатаБезКонтрагента();
			Если ВводитьПокупателя Тогда
				УдалитьЧекНаКлиенте();
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("ОтказОтВводаКарты")
		И Результат.ОтказОтВводаКарты Тогда
		ОтказОтОплатыБонусами = Истина;
		Если Результат.Свойство("Контрагент") Тогда
			Объект.Контрагент = Результат.Контрагент;
			КонтрагентВыбран = Истина;
		КонецЕсли;
		РазблокироватьОбъектСервераЛояльности("clientbonuses");
		ЗаполнитьФормуПоДисконтнойКарте();
		УправлениеВидимостьюРеквизитовКарты();
		НастроитьВидКнопкиОплатыВПлиткеСУчетомВозврата();
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("ОтменитьВводыКарты")
		И Результат.ОтменитьВводыКарты Тогда
		ОтменитьВводКартыКлиент(Истина);
		НастроитьВидКнопкиОплатыВПлиткеСУчетомВозврата();
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ХочуБумажныйЧек") Тогда
		ОтправкаЧекаТелефон = Результат.ОтправкаЧекаТелефон;
		ОтправкаЧекаПочта = Результат.ОтправкаЧекаПочта;
		ХочуБумажныйЧек = Результат.ХочуБумажныйЧек;
		ОтказОтОплатыБонусами = Истина;
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") Тогда
		ОбновитьДанныеЛояльности(Результат, ДополнительныеПараметры);
		НастроитьВидКнопкиОплатыВПлиткеСУчетомВозврата();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Контрагент) И Объект.Товары.Количество() = 0
		И ОбщегоНазначенияРМККлиент.ЗапрещенаПредоплатаБезКонтрагента() Тогда
			Если ЭтоЗачетАванса Тогда
				ОбщегоНазначенияРМККлиентПереопределяемый.ВыбратьДокументРасчета(ЭтотОбъект);
			ИначеЕсли ЭтоОплатаРассрочки Тогда
				ВыбратьДокументОплатыРассрочки();
			КонецЕсли;
	КонецЕсли;
	
	Если Не ХочуБумажныйЧек Тогда
		УстановитьЗаголовокКомандыПробитьЧек();
	КонецЕсли;
	
	Если РежимТихойОплаты
		И Результат = Неопределено Тогда
		РежимРаботыСЧеком = РежимыРаботыСЧеком.ВводТоваров;
		ИнтерфейсРМКСлужебныйКлиентСервер.НастроитьДоступностьЭлементовФормыПриПереключенииРежима(ЭтотОбъект, Ложь);
		СброитьФлагиПереходаКОплате();
		Возврат;
	КонецЕсли;
	
	Если ПроцессПереходаКОплате ИЛИ РежимТихойОплаты Тогда
		Если ТаблицаПодаркиБезВыбора.Количество() ИЛИ ТаблицаПодаркиНаВыбор.Количество() Тогда
			ОткрытьФормуВыдачиПодарка();
		Иначе
			ПереходКОплатеПослеВыдачиПодарков();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеЛояльности(Результат, ДополнительныеПараметры)
	
	ОтменитьВводКартыКлиент(Ложь);
	ЗавершениеОбработкиВыбораДисконтнойКарты(Результат, ДополнительныеПараметры);
	УправлениеВидимостьюРеквизитовКарты();
	Если КоличествоБонусов > 0 Тогда
		РассчитыватьБонусы = Истина;
	КонецЕсли;
	РассчитатьСкидкиКлиент();
	ПроверитьПодтверждениеОплатыБонусами();
	ВывестиДанныеКартыЛояльности();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодтверждениеОплатыБонусами()
	НастройкиПодтвержденияБонусов.ПодтверждениеНеТребуется =  Ложь;
	НастройкиПодтвержденияБонусов.СуммаБонусовМеньшеНастройки = Ложь;
	НастройкиПодтвержденияБонусов.ОплатаБонусовПодтверждена = Ложь;
	
	ОтображатьСМС = Истина;
	Если НЕ ОтправлятьSMSКодПриПродаже = ПредопределенноеЗначение("Перечисление.ВариантыОтправкиSMSПриПродаже.ПриОплатеБаллами")
		Или БонусыДоступноКОплате <= 0 Тогда
		НастройкиПодтвержденияБонусов.ПодтверждениеНеТребуется = Истина;
		ОтображатьСМС = Ложь;
	КонецЕсли;
	НастроитьПодтверждениеБонусов(НастройкиПодтвержденияБонусов.ПодтверждениеНеТребуется);
КонецПроцедуры

&НаКлиенте
Процедура НастроитьПодтверждениеБонусов(ОплатаПодтверждена)
	ОтображатьСтраницуСМС = ОтправлятьSMSКодПриПродаже = ПредопределенноеЗначение("Перечисление.ВариантыОтправкиSMSПриПродаже.ПриОплатеБаллами");
	УстановитьВидимостьЭлементаФормы(Элементы.СтраницыПодтвержденияСМС, ОтображатьСтраницуСМС);
	Если ОплатаПодтверждена Тогда
		Элементы.СтраницыПодтвержденияСМС.ТекущаяСтраница = Элементы.СтраницаСМСПодтверждена;
	Иначе
		Элементы.СтраницыПодтвержденияСМС.ТекущаяСтраница = Элементы.СтраницаПодтвердитьСМС;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСертификат(Команда)
	УдалитьСертификатНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОборажениеРучнойСкидкиПроценом()
	СтрокаЧека = Объект.Товары.Получить(ТекущийТоварИндексСтроки);
	
	Если СтрокаЧека = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СкидкиРазрешены = (Не СтрокаЧека.ЗапретРучныхСкидок);
	Если СкидкиРазрешены И СтрокаЧека.РассчитанаСкидка И СтрокаЧека.ОтображаетсяСкидкаСуммой Тогда
		
		ТекущийТоварСкидка = СтрокаЧека.СуммаСкидкиНаценки / СтрокаЧека.СуммаБезСкидки * 100;
		Если ТекущийТоварСкидка < 0 Тогда
			ТекущийТоварСкидка = - ТекущийТоварСкидка;
		КонецЕсли;
		
		СтрокаЧека.ПроцентСкидкиНаценки = ТекущийТоварСкидка;
		СтрокаЧека.ОтображаетсяСкидкаПроцентом = Истина;
		СтрокаЧека.ОтображаетсяСкидкаСуммой = Не СтрокаЧека.ОтображаетсяСкидкаПроцентом;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОборажениеРучнойСкидкиСуммой()
	СтрокаЧека = Объект.Товары.Получить(ТекущийТоварИндексСтроки);
	
	Если СтрокаЧека = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СкидкиРазрешены = (Не СтрокаЧека.ЗапретРучныхСкидок);
	Если СкидкиРазрешены И СтрокаЧека.РассчитанаСкидка И СтрокаЧека.ОтображаетсяСкидкаПроцентом Тогда
		
		ТекущийТоварСкидка = СтрокаЧека.СуммаСкидкиНаценки;
		Если ТекущийТоварСкидка < 0 Тогда
			ТекущийТоварСкидка = - ТекущийТоварСкидка;
		КонецЕсли;
		СтрокаЧека.СуммаСкидкиНаценки = ТекущийТоварСкидка;
		СтрокаЧека.ПроцентСкидкиНаценки = 0;
		
		СтрокаЧека.ОтображаетсяСкидкаСуммой = Истина;
		СтрокаЧека.ОтображаетсяСкидкаПроцентом = Не СтрокаЧека.ОтображаетсяСкидкаСуммой;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуДобавленияУправляемойСкидки()
	Если Объект.Товары.Количество() > 0 Тогда
		ДополнительныеПараметры = Новый Структура("ОбластьДействия", "На документ");

		Если СкидкиРассчитаны И ВопросПоРасчетуСкидок Тогда
			ЗадатьВопросПоРасчетуСкидок("УправляемыеСкидкиЗавершение", ДополнительныеПараметры);
		Иначе
			УправляемыеСкидкиЗавершение(КодВозвратаДиалога.Да, ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПереходКОплатеПослеВыдачиПодарков()
	
	Если РежимТихойОплаты Тогда
		Если БонусыДоступноКОплате > 0 Тогда
			Если ТипОплаты = "Наличные" Тогда
				ОткрытьФормуВводаСуммыНаличныхИБонусов();
			ИначеЕсли ТипОплаты = "СБП" Тогда
				ОткрытьФормуВводаСуммыСБПИБонусов();
			Иначе
				ОткрытьФормуВводаСуммыКартойИБонусов();
			КонецЕсли;
		Иначе
			Если ТипОплаты = "Наличные" Тогда
				ОткрытьФормуВводаСуммыНаличных();
			ИначеЕсли ТипОплаты = "СБП" Тогда
				ОплатитьСБПВТихомРежимеНаКлиенте();
			Иначе
				ОплатитьКартойВТихомРежимеНаКлиенте();
			КонецЕсли;
		КонецЕсли;
		
	Иначе

		ВыполнитьПереходКОплатеПослеПроверки();
		Если БонусыДоступноКОплате > 0 
			И СуммаОплаченоБонусами = 0 
			И НЕ ОтказОтОплатыБонусами Тогда
			ОткрытьФормуВводаСуммыБаллов();
		КонецЕсли;

	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПродажаПоЗаказуПредоплата(Команда)
	ПродажаПоЗаказуКлиент(Истина);
	СкрытьГруппуРежим();
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОтправитьСообщениеОПомощи(Команда)
	
	ПараметрыСообщения = МенеджерОборудованияРМККлиент.ПараметрыОтправкиСообщенияОбОшибке();
	ПараметрыСообщения.Вставить("Тема", "");
	ПараметрыСообщения.Вставить("ТекстОшибки", НСтр("ru = 'Нужна помощь по работе РМК'"));
	ПараметрыСообщения.Вставить("ИдентификаторОборудования", "Все");

	РезультатОперации = Ждать МенеджерОборудованияРМККлиент.ОтправитьСообщениеОбОшибкеАсинх(ПараметрыСообщения);
	Если РезультатОперации.КодОшибки = "НеИспользуется" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Для отправки сообщения в службу поддержки необходимо подключить Интернет-поддержку пользователя.'"));
	ИначеЕсли Не ПустаяСтрока(РезультатОперации.КодОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОперации.СообщениеОбОшибке);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогВыбораУпрСкидки()
	
	ДополнительныеПараметры = Новый Структура("ОбластьДействия", "На строку");
	УправляемыеСкидкиЗавершение(КодВозвратаДиалога.Да, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЧекИзОперацииВозврат(Команда)
	
	УдалитьЧекНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиДанныеКартыЛояльности()
	ДанныеЗаполнены = ИнтерфейсРМКСлужебныйКлиентСервер.ДанныеЛояльностиЗаполнены(ЭтотОбъект);
	Если ДанныеЗаполнены И ИспользоватьДисплейПокупателя
		И Не РежимКассыСамообслуживания Тогда
		ЗаполнитьДанныеОКартеЛояльностиВДисплейПокупателя();
		НачатьОтображениеИнформацииНаДисплейПокупателя(ТипыОперацийДисплеяПокупателя.Информация);
	КонецЕсли;
	УстановитьДоступностьЭлементаФормы(Элементы.ГруппаВидОплатыБонусы, ИспользоватьОплатуБонусами И БонусыДоступноКОплате>0);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеОКартеЛояльностиВДисплейПокупателя()
	ИнформацияОКартеЛояльности = НСтр("ru = 'Информация о карте:'");
	
	ШаблонДваПараметра = НСтр("ru = '%1 %2'");
	ШаблонТриПараметра = НСтр("ru = '%1 %2 %3'");
	
	Если ЗначениеЗаполнено(НайденнаяКартаНомер) Тогда
		ТекстНомерКарты = СтрШаблон(ШаблонДваПараметра,НСтр("ru = 'Карта:'"), НайденнаяКартаНомер);
		ДобавитьТекстИнформацииОПокупателе(ИнформацияОКартеЛояльности, ТекстНомерКарты);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденнаяКартаТелефон) Тогда
		ПредставлениеНомера = СтрШаблон(ШаблонДваПараметра,НСтр("ru = '*'"), Прав(НайденнаяКартаТелефон,4));
		ТекстНомерТелефона = СтрШаблон(ШаблонДваПараметра, НСтр("ru = 'Телефон:'"), ПредставлениеНомера);
		ДобавитьТекстИнформацииОПокупателе(ИнформацияОКартеЛояльности, ТекстНомерТелефона);
	КонецЕсли;
	
	ФорматЧисла = "ЧДЦ=2; ЧН=0,00; ЧРГ='''";
	Если ЗначениеЗаполнено(НайденнаяКартаСуммаПродаж) Тогда
		ТекстСуммаПродаж = СтрШаблон(ШаблонТриПараметра, НСтр("ru = 'Сумма продаж:'"), Формат(СуммаПродаж, ФорматЧисла), ПредставлениеВалюты);
		ДобавитьТекстИнформацииОПокупателе(ИнформацияОКартеЛояльности, ТекстСуммаПродаж);
	КонецЕсли;
	
	Если ИспользоватьОплатуБонусами Тогда
		ТекстСуммаБонусов = СтрШаблон(ШаблонДваПараметра, НСтр("ru = 'Остаток бонусов:'"), Формат(КоличествоБонусов, ФорматЧисла));
		ДобавитьТекстИнформацииОПокупателе(ИнформацияОКартеЛояльности, ТекстСуммаБонусов);
		ТекстСуммаБонусов = СтрШаблон(ШаблонТриПараметра,НСтр("ru = 'Доступно:'"), Формат(БонусыДоступноКОплате, ФорматЧисла), ПредставлениеВалюты);
		ДобавитьТекстИнформацииОПокупателе(ИнформацияОКартеЛояльности, ТекстСуммаБонусов);
	КонецЕсли;
	
	ДанныеКПередачеВДисплейПокупателя.Информация = ИнформацияОКартеЛояльности;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекстИнформацииОПокупателе(ИнформацияОКартеЛояльности, ТекстОтображения)
	ШаблонТекста = НСтр("ru = '%1%2%3'");
	ИнформацияОКартеЛояльности = СтрШаблон(ШаблонТекста,ИнформацияОКартеЛояльности,Символы.ПС,ТекстОтображения);
КонецПроцедуры

&НаКлиенте
Процедура СкидкаПенсионера(Команда)
	
	РассчитатьСкидкуПенсионерам();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьСтатусПокупателя(Команда)
	
	Если Не ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера Тогда
		ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОбщая);
		ИнтерфейсРМКСлужебныйКлиентСервер.УстановитьВидимостьГруппыОперации(Элементы);
		УстановитьДоступностьЭлементаФормы(Элементы.ГруппаОперации, Истина);
		НастроитьЭлементыФормы(Элементы.СтраницаОбщая, Истина);
	КонецЕсли;
	
	ПокупательПенсионер = Истина;
	РассчитатьСкидкуПенсионерам();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораКонтрагента()
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыборПокупателя", ЭтотОбъект);
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ОписаниеОповещенияОЗакрытии", ОповещениеОЗакрытии);
	
	СтандартнаяОбработка = Истина;
	ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуВыбораКонтрагента(СтруктураПараметров, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		ПараметрыФормыВыбора = Новый Структура;
		ПараметрыФормыВыбора.Вставить("ИсключитьФизЛиц", ЭтоРаботаСАвансом());
		ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВыбораПокупателя", ПараметрыФормыВыбора, ЭтотОбъект,,,,
			ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца,РежимОтображенияОкнаФормы.ВОсновномОкне);
			
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыборПокупателя(Результат, ДополнительныеПараметры) Экспорт
	Если НЕ Результат = Неопределено Тогда
		ОтказОтОплатыБонусами = Истина;
		Объект.Контрагент = Результат;
		КонтрагентВыбран = Истина;
		ЗаполнитьФормуПоДисконтнойКарте();
		УправлениеВидимостьюРеквизитовКарты();
		НастроитьВидКнопкиОплатыВПлиткеСУчетомВозврата();
		УстановитьЗаголовокКомандыПробитьЧек();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПрограммаЛояльности

&НаКлиенте
Процедура СписатьРазблокироватьБонусныеБаллы()
	
	Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
		
		Если ЗначениеЗаполнено(СуммаОплаченоБонусами) И СписатьБаллыПоВладельцу Тогда
			
			СписатьБонусыТаблицыВыбранныхКарт();
			
		ИначеЕсли ЗначениеЗаполнено(СуммаОплаченоБонусами) Тогда
		
			ЗначенияПараметровМетода = ПараметрыМетодовБонуснойПодсистемы();
			ЗначенияПараметровМетода.Вставить("BonusesCount", Строка(СуммаОплаченоБонусами));
			
			Если СписокНастроекСервераЛояльности.НайтиПоЗначению("ИспользоватьНовыеМетоды_3_0_11") <> Неопределено Тогда
				ИмяРесурса = "writeoffclientbonuses3_0";
			ИначеЕсли ИспользоватьНовыйМетодСЛ Тогда
				ИмяРесурса = "writeoffclientbonusesnew";
			Иначе
				ИмяРесурса = "writeoffclientbonuses";
			КонецЕсли;
			
			ПараметрыВыполненияЗапроса = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыЗапросаСписатьБонусыКлиента(ПараметрыПодключенияКСерверуЛояльности,
				ЗначенияПараметровМетода, ИмяРесурса);
			
			Результат = СерверЛояльностиПолучательДанныхКлиентСервер.ВыполнитьЗапросКСерверуЛояльности(ПараметрыВыполненияЗапроса);
			
			ОшибкаСписания = Ложь;
			СтрокаОтвета = Результат.ДанныеОтвета;
			СообщениеОбОшибке = НСтр("ru = ''");
			Если НЕ СтрНачинаетсяС(СокрЛ(СтрокаОтвета), "{")
				И Не СтрокаОтвета = НСтр("ru = 'Бонусы успешно списаны'") Тогда
				ОшибкаСписания = Истина;
			КонецЕсли;
			
			ДанныеОтвета = Неопределено;
			СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаОтвета, ДанныеОтвета);
			Если НЕ ДанныеОтвета = Неопределено Тогда
				ОшибкаСписания = ДанныеОтвета.Error;
			КонецЕсли;
			
			Если НЕ ОшибкаСписания Тогда
				
				Если ОжидаемоеКоличествоЧеков < 1 Тогда
					ОчиститьДанныеКартыЛояльности();
				КонецЕсли;
				
			Иначе
				РазблокироватьОбъектСервераЛояльности("clientbonuses");
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(КоличествоБонусов) Тогда
			
			РазблокироватьОбъектСервераЛояльности("clientbonuses");
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуОплатыБонусами(СтруктураОтложенногоПоказаПредупреждения = Неопределено, ОплатитьБонусами = Ложь)
	
	ЭтоВозврат = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	
	ПересчетЛокально = (ОтсутствуетДокументОснованиеНаСервере Или Не ПолучатьСкидкиДокументаОснованияССервера);
	Если ПересчетЛокально // Скидки будут получены с сервера в готовом виде 
		И ЭтоВозврат ИЛИ (ЗначениеЗаполнено(Объект.ЗаказПокупателя) И Не СкидкиРассчитаны) Тогда
		
		СуммаСкидкиОплатыБонусом = 0;
		Для Каждого Строка Из Объект.Товары Цикл
			Если Не Строка.СуммаСкидкиОплатыБонусомЧекаПродажи = 0
				ИЛИ Не Строка.СуммаАвтоматическойСкидкиЧекаПродажи = 0
				ИЛИ Не Строка.СуммаСкидкиНаценкиЧекаПродажи = 0 Тогда
				СуммаСкидкиСтроки = Строка.СуммаАвтоматическойСкидки;
				Строка.СуммаСкидкиОплатыБонусом =
					Строка.СуммаСкидкиОплатыБонусомЧекаПродажи / Строка.СуммаБезСкидкиЧекаПродажи * Строка.СуммаБезСкидки;
				Строка.СуммаАвтоматическойСкидки =
					Строка.СуммаАвтоматическойСкидкиЧекаПродажи / Строка.СуммаБезСкидкиЧекаПродажи * Строка.СуммаБезСкидки;
				Строка.СуммаСкидкиНаценки =
					Строка.СуммаСкидкиНаценкиЧекаПродажи / Строка.СуммаБезСкидкиЧекаПродажи * Строка.СуммаБезСкидки;
				Если СкидкиРассчитаны И ЭтоВозврат Тогда
					Строка.СуммаАвтоматическойСкидки = Строка.СуммаАвтоматическойСкидки + СуммаСкидкиСтроки;
				КонецЕсли;
				Строка.СуммаСкидокОбщая = Строка.СуммаСкидкиОплатыБонусом + Строка.СуммаАвтоматическойСкидки + Строка.СуммаСкидкиНаценкиЧекаПродажи;
				ПересчитатьСуммы(Строка);
				СуммаСкидкиОплатыБонусом = СуммаСкидкиОплатыБонусом + Строка.СуммаСкидкиОплатыБонусом;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЭтоВозвратБезОснования Тогда
			СуммаОплаченоБонусами = СуммаСкидкиОплатыБонусом;
		КонецЕсли;
	КонецЕсли;
	Если ПересчетЛокально И ЭтоВозврат И Не ЭтоВозвратБезОснования Тогда
		ПересчитатьКэшСкидкиНаценки();
	КонецЕсли;
	
	Если ЭтоВозврат Тогда
		РаспределитьСуммуБонусовПоДисконтнымКартамПриВозврате();
		Возврат;
	КонецЕсли;
	
	Если РассчитыватьБонусы Тогда
		
		Курс = ?(КурсБонусов = 0, 1, КурсБонусов);
		
		СуммаПоЧеку = СуммаИтого + СуммаОплаченоБонусами;
		
		ОстатокПревышаетЛимит = Истина;
		Если КоличествоБонусовОграничение > 0
			И КоличествоБонусовОграничение > КоличествоБонусов Тогда
			ОстатокПревышаетЛимит = Ложь;
		КонецЕсли;
		
		Ограничениепрограммы = СуммаПоЧеку;
		Если НЕ ОстатокПревышаетЛимит Тогда
			Ограничениепрограммы = 0;
		ИначеЕсли ТаблицаСуммМаксимальнойОплатыБонусами.Количество() Тогда
			Ограничениепрограммы = ТаблицаСуммМаксимальнойОплатыБонусами.Итог("Сумма");
		Иначе
			Ограничениепрограммы = Окр(СуммаПоЧеку * ПроцентОплатыБонусами / 100, 2);
		КонецЕсли;
		СуммаРанееПринятойОплатыБаллами = 0;
		ОбщегоНазначенияРМККлиентПереопределяемый.ЗаполнитьСуммуПредоплатыБонусами(ЭтотОбъект, СуммаРанееПринятойОплатыБаллами);
		ОстатокБалловВДенежномВыражении = КоличествоБонусов * Курс - СуммаРанееПринятойОплатыБаллами;
		БонусыДоступноКОплате = Мин(СуммаПоЧеку, Ограничениепрограммы, ОстатокБалловВДенежномВыражении);
		
		// Обновить информацию на форме о том, сколько бонусов можно потратить
		ПроцентОплатыБонусами = ?(СуммаПоЧеку = 0, 0, БонусыДоступноКОплате * 100 / СуммаПоЧеку);
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Бонусами можно оплатить до %1%% от суммы чека'"), ПроцентОплатыБонусами);
		Если НЕ ОстатокПревышаетЛимит Тогда
			ТекстСообщения = ТекстСообщения + ТекстПодсказкиОграничениеОплатыБалламиМинимальныйОстаток(Истина, КоличествоБонусовОграничение);
		КонецЕсли;
		
		// Обновить данные в строках товара о том, сколько составляет скидка-оплата бонусами за каждый товар
		Если СуммаОплаченоБонусами > БонусыДоступноКОплате Тогда
			СуммаОплаченоБонусами = БонусыДоступноКОплате;
		КонецЕсли;
		Если ОплатитьБонусами
			И НЕ (БонусыВведеныВТихойОплате = Истина) Тогда
			ОсталосьОплатитьЗаТовар = ИнтерфейсРМКСлужебныйКлиент.ПолучитьОставшуюсяСуммуОплатыПоЧеку(ЭтотОбъект);
			СуммаОплаченоБонусами = Мин(БонусыДоступноКОплате, ОсталосьОплатитьЗаТовар);
		КонецЕсли;
		РаспределитьБонусыПоТоварам(СтруктураОтложенногоПоказаПредупреждения);
		ОбнулитьСуммыОплат = Ложь;
		ПересчитатьИтогиТабличнойЧастиТовары(ОбнулитьСуммыОплат);
		НастроитьЭлементыВидаОплатыБонусами(БонусыДоступноКОплате);
		
	КонецЕсли;
	
	СуммаБонусовКНачислению = ТаблицаБонусныеБаллы.Итог("КоличествоБонусныхБаллов");
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДанныеКартыЛояльности()
	
	ПустаяСтрока = НСтр("ru = ''");
	
	НайденнаяКартаДатаРождения		= ПустаяСтрока;
	НайденнаяКартаНомер				= ПустаяСтрока;
	НайденнаяКартаПочта				= ПустаяСтрока;
	НайденнаяКартаТелефон			= ПустаяСтрока;
	НайденнаяКартаФИО				= ПустаяСтрока;
	НайденнаяКартаСуммаПродаж		= ПустаяСтрока;
	
	СписатьБаллыПоВладельцу = Ложь;
	ВведенаБонуснаяКарта = Ложь;
	ТаблицаВыбранныхКарт.Очистить();
	ПроцентБонуснойПрограммы = 0;
	БонуснаяПрограмма = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПримененныеБонусы(ОчиститьДанныеКартыЛояльностиПокупателя = Истина)
	
	ОтменитьОкругление();
	
	СуммаИтого = СуммаИтого + СуммаОплаченоБонусами;
	СуммаОплаченоБонусами = 0;
	ПараметрыПересчета = СтруктураПараметровПересчетаСуммОплаты();
	ПараметрыПересчета.ПоКомандеОплатитьВсюСуммуБонусами = Истина;
	РассчитатьСуммыОплатыПриРедактировании(ПараметрыПересчета);
	
	НастроитьДоступностьПробитьЧек();
	Сдача = 0;
	ЭтоОплатаВстречнымПредоставлением = Ложь;
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		
		СтрокаТовары.Сумма = СтрокаТовары.Сумма + СтрокаТовары.СуммаСкидкиОплатыБонусом;
		СтрокаТовары.СуммаСкидкиОплатыБонусом = 0;
		РассчитатьСуммуВСтрокеТабличнойЧасти(СтрокаТовары.ПолучитьИдентификатор());
		
	КонецЦикла;
	
	Если ОчиститьДанныеКартыЛояльностиПокупателя Тогда
		
		ОчиститьДанныеКартыЛояльности();
		ОчиститьДанныеПокупателя();
		
	КонецЕсли;
	АктуализироватьИзменениеЭтапаРаботыСЧекомПриИзмененииОплаты();
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыМетодовБонуснойПодсистемы(ЭтоСозданиеНовойКарты = Ложь)
	
	СтатичныеПараметры	= СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыМетодовБонуснойПодсистемы();
	ПрефиксПоля = ?(ЭтоСозданиеНовойКарты, "НоваяКарта", "НайденнаяКарта");
	
	Если ЭтоСозданиеНовойКарты Тогда 
		СтатичныеПараметры.Вставить("Client", ЭтотОбъект[ПрефиксПоля + "ФИО"]);
	КонецЕсли;
	
	СтатичныеПараметры.ClientCardTypeUID = НоваяКартаВидКарты;
	ДанныеКарты = ДанныеВидаКарты(НоваяКартаВидКарты);
	СтатичныеПараметры.GenerateNumber = ДанныеКарты.ГенерироватьНомер;
	
	Если ИнтерфейсРМКСлужебныйКлиентСервер.ПолученИдентификаторКартыЛояльности(ПараметрыКартыЛояльности) Тогда
		СтатичныеПараметры.Email		= "";
		СтатичныеПараметры.ClientCardID = ПараметрыКартыЛояльности.КодКарты;
		СтатичныеПараметры.Phone		= "";
		СтатичныеПараметры.DateOfBirth 	= ПараметрыКартыЛояльности.ДатаРождения;
		СтатичныеПараметры.CardGUID 	= ПараметрыКартыЛояльности.ИдентификаторКарты;
	Иначе
		СтатичныеПараметры.Email			= ЭтотОбъект[ПрефиксПоля + "Почта"];
		СтатичныеПараметры.ClientCardID		= ЭтотОбъект[ПрефиксПоля + "Номер"];
		СтатичныеПараметры.Phone			= ЭтотОбъект[ПрефиксПоля + "Телефон"];
		ТекстДаты = ЭтотОбъект[ПрефиксПоля + "ДатаРождения"];
		СтатичныеПараметры.DateOfBirth
			= ИнтерфейсРМКСлужебныйКлиентСервер.ПреобразоватьДатуИзСтроковогоПредставления(ТекстДаты);
		СтатичныеПараметры.CardGUID 	= Строка(Объект.ДисконтнаяКарта.УникальныйИдентификатор());
	КонецЕсли;
	СтатичныеПараметры.Store 			= Строка(Объект.ТорговыйОбъект.УникальныйИдентификатор());
	СтатичныеПараметры.Promocode		= ВведенныйПромокод;
	СтатичныеПараметры.Currency			= КодВалютыЦены;
	СтатичныеПараметры.Replacement		= Ложь;
	
	Возврат СтатичныеПараметры;
	
КонецФункции

&НаКлиенте
Функция ПреобразованнаяСтрокаПоискаТелефонаНаСервереЛояльности(ШтрихкодПоиска)
	
	НачалоСтроки = "";
	Если Лев(ШтрихкодПоиска, 1) = "%" Тогда
		НачалоСтроки = "*";
	КонецЕсли;
	ШтрихкодТолькоЦифры = ИнтерфейсРМКСлужебныйКлиентСервер.ТолькоЦифры(ШтрихкодПоиска);
	
	Возврат СтрШаблон("%1%2", НачалоСтроки, ШтрихкодТолькоЦифры);
	
КонецФункции

&НаКлиенте
Функция ПараметрыМетодаНайтиКартуКлиента(СтруктураПараметровКлиента)
	
	ШтрихкодПоиска = СтруктураПараметровКлиента.ПараметрыШтрихкода.ШтрихкодОригинал;
	ФильтрПоиска = СтруктураПараметровКлиента.ПараметрыШтрихкода.ФильтрПоискаПоШтрихкоду;
	
	ПараметрыПоискаКарт = СерверЛояльностиПолучательДанныхКлиентСервер.СтруктураПараметровНайтиКартуКлиента();
	Если ФильтрПоиска.Свойство("УникальныйИдентификаторКарты") Тогда
		ПараметрыПоискаКарт.CardGUID = ШтрихкодПоиска;
	КонецЕсли;
	Если ФильтрПоиска.Свойство("ИнформационныеКарты") Тогда
		ПараметрыПоискаКарт.ClientCardID = ШтрихкодПоиска;
	КонецЕсли;
	Если ФильтрПоиска.Свойство("УникальныйИдентификаторВладельцаКарты") Тогда
		ПараметрыПоискаКарт.ClientGUID = ШтрихкодПоиска;
	КонецЕсли;
	Если ФильтрПоиска.Свойство("ШаблонАдресЭПСЛ") Тогда
		ПараметрыПоискаКарт.Email = ШтрихкодПоиска;
	КонецЕсли;
	Если ФильтрПоиска.Свойство("ШаблонНомерТелефонаСЛ") Или ФильтрПоиска.Свойство("ПоследниеЦифрыТелефонаСЛ") Тогда
		ПараметрыПоискаКарт.Phone = ПреобразованнаяСтрокаПоискаТелефонаНаСервереЛояльности(ШтрихкодПоиска);
	КонецЕсли;
	Если ЕстьСвойство(ФильтрПоиска, "ФИОВладельцаКарты") Тогда
		ПараметрыПоискаКарт.ClientID = ШтрихкодПоиска;
	КонецЕсли;
	ВыборКлиента = Ложь;
	Если СтруктураПараметровКлиента.Свойство("ВыборКлиента") Тогда
		ВыборКлиента = СтруктураПараметровКлиента.ВыборКлиента;
	КонецЕсли;
	ПараметрыПоискаКарт.BlockBonuses = ?(ИспользоватьОплатуБонусами, "1", "0");

	Возврат ПараметрыПоискаКарт;
	
КонецФункции

&НаКлиенте
Процедура РазблокироватьОбъектСервераЛояльности(ТипОбъекта = "clientbonuses")
	
	Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
		
		ЗначенияПараметровМетода = ПараметрыМетодовБонуснойПодсистемы();
		
		Если ТипОбъекта = "clientbonuses" Тогда
			Если СуммаОплаченоБонусами <= 0 И КоличествоБонусов <= 0 Тогда
				Возврат;
			Иначе
				РазблокироватьБонусыКартыСерверЛояльности(ЗначенияПараметровМетода);
			КонецЕсли;
		КонецЕсли;
		
		Если ТипОбъекта = "promocode" Тогда
			ПредъявленныеПромокоды = ТаблицаПримененныхПромокодов.НайтиСтроки(Новый Структура("ЭтоАктивацияПромокода", Ложь));
			Если ПредъявленныеПромокоды.Количество() = 0 И НЕ ЗначениеЗаполнено(ВведенныйПромокод) Тогда
				Возврат;
			Иначе
				Если СписокНастроекСервераЛояльности.НайтиПоЗначению("ИспользоватьНовыеМетоды_3_0_11") <> Неопределено Тогда
					ИмяРесурса = "unlockpromocode3_0";
				ИначеЕсли ИспользоватьНовыйМетодСЛ Тогда
					ИмяРесурса = "unlockpromocodenew";
				Иначе
					ИмяРесурса = "unlockpromocode";
				КонецЕсли;
					
				ПараметрыВыполненияЗапроса = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыЗапросаРазблокироватьПромокод(ПараметрыПодключенияКСерверуЛояльности,
						ЗначенияПараметровМетода, ИмяРесурса);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ТипОбъекта = "clientbonuses" Тогда
			Результат = СерверЛояльностиПолучательДанныхКлиентСервер.ВыполнитьЗапросКСерверуЛояльности(ПараметрыВыполненияЗапроса);
		КонецЕсли;
			
		Если ТипОбъекта = "promocode" Тогда
			ОбработатьОтветРазблокироватьПромокод(Результат);
		КонецЕсли;
				
	Иначе
		
		ПараметрыОбъекта = Новый Структура;
		ПараметрыОбъекта.Вставить("ДисконтнаяКарта", Объект.ДисконтнаяКарта);
		ПараметрыОбъекта.Вставить("Промокод", ВведенныйПромокод);
		ОбщегоНазначенияРМККлиентПереопределяемый.РазблокироватьОбъектСервераЛояльности(ТипОбъекта, ПараметрыОбъекта);
		
	КонецЕсли;
	
	Если ТипОбъекта = "clientbonuses"
		И (СписатьБаллыПоВладельцу) Тогда
		
		РазблокироватьБонусыТаблицыВыбранныхКарт();
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуОплатыСертификатами(СуммаИтогоОсталосьОплатить, СуммаБезОкругления)
	
	Если ЗначениеЗаполнено(ВыбраннаяОрганизация) И ЗначениеЗаполнено(ВыбраннаяСистемаНалогообложения) Тогда
		СтруктураОтбораСНО = Новый Структура("Организация, СистемаНалогообложения", ВыбраннаяОрганизация, ВыбраннаяСистемаНалогообложения);
		СтрокиПодарочныхСертификатов = ТаблицаПодарочныхСертификатов.НайтиСтроки(СтруктураОтбораСНО);
		
		ОплаченоСертификатами = 0;
		Для Каждого СтрокаПодарочныхСертификатов Из СтрокиПодарочныхСертификатов Цикл
			ОплаченоСертификатами = ОплаченоСертификатами + СтрокаПодарочныхСертификатов.СуммаСертификата;
			ИмяРеквизитаСуммаСертификата = СтрШаблон(НСтр("ru = 'СуммаОплаченоСертификатом_%1'"), СтрокаПодарочныхСертификатов.УникальныйИдентификатор);
			ЭтотОбъект[ИмяРеквизитаСуммаСертификата] = СтрокаПодарочныхСертификатов.СуммаСертификата;
		КонецЦикла;
		СуммаОплаченоСертификатами = ОплаченоСертификатами;
	Иначе
		СуммаОплаченоСертификатами = ТаблицаПодарочныхСертификатов.Итог("СуммаСертификата");
	КонецЕсли;	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИспользованиеСерий(Номенклатура)
	
	Результат = Ложь;
	ОбщегоНазначенияРМКПереопределяемый.ОпределитьИспользованиеСерий(Номенклатура, Результат);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОпределитьИспользованиеАвтоматическихСкидок()
	
	Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
		
		ВключеноИспользованиеАвтоматическихСкидок = ИспользоватьАвтоматическиеСкидки;
		
	Иначе
		
		ИспользуютсяАвтоСкидки = Ложь;
		ОбщегоНазначенияРМККлиентПереопределяемый.ЗаполнитьПризнакИспользованияАвтоматическихСкидок(ИспользуютсяАвтоСкидки);
		ВключеноИспользованиеАвтоматическихСкидок = ИспользуютсяАвтоСкидки;
		
	КонецЕсли;
	ИспользоватьАвтоматическиеСкидки = ВключеноИспользованиеАвтоматическихСкидок И НЕ ЭтоЗаменаТоваров;
	
	Если РежимКассыСамообслуживания Тогда
		ОпределитьИспользованиеАвтоматическихСкидокКСО();
	Иначе
		
		ПоказыватьКнопкиСкидок = ИспользоватьАвтоматическиеСкидки И НЕ РежимКассыСамообслуживания;
		ПоказыватьКнопкуСкидкиНаЧек = ПоказыватьКнопкиСкидок Или ДопускаетсяПрименениеСкидок;
		ПоказыватьГруппуСкидок = ИспользоватьАвтоматическиеСкидки Или МаксимальныйПроцентРучнойНаценки > 0
			Или МаксимальныйПроцентРучнойСкидки > 0;
		
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаКнопкиРасчетаСкидок, ИспользоватьАвтоматическиеСкидки И Не ПолныйРасчетСкидок);
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаСкидка, ПоказыватьГруппуСкидок);
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаСуммаБезСкидок, ПоказыватьГруппуСкидок);
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаСуммаСдачи, ПоказыватьГруппуСкидок);
		УстановитьВидимостьЭлементаФормы(Элементы.СтраницаБаннер, ПоказыватьГруппуСкидок);
		УстановитьДоступностьЭлементаФормы(Элементы.ОтменаРасчетаСкидок, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РассчитатьАвтоматическиеСкидкиНаСервере()
	
	РезультатВыполненияРасчета = Новый Структура;
	РезультатВыполненияРасчета.Вставить("ЕстьОшибки", Ложь);
	РезультатВыполненияРасчета.Вставить("ТекстОшибки", "");
	РезультатВыполненияРасчета.Вставить("ИндексСтрокиПередПересчетом", -1);
	РезультатВыполненияРасчета.Вставить("ВыполнитьЛокальныйРасчет", Ложь);
	РезультатВыполненияРасчета.Вставить("ТекстОповещения", "");
	
	Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
		ОбщегоНазначенияРМК.РассчитатьАвтоматическиеСкидки(ЭтотОбъект, РезультатВыполненияРасчета);
		Если Не СерверЛояльностиНедоступен
			И РезультатВыполненияРасчета.ВыполнитьЛокальныйРасчет Тогда
			СерверЛояльностиНедоступен = Истина;
			ТекстОповещения = НСтр("ru = 'Расчет скидок выполняется локально.'");
			РезультатВыполненияРасчета.ТекстОповещения = ТекстОповещения;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьКартинкуНедоступенСерверЛояльности();
	
	Если (НЕ ИспользоватьСерверЛояльностиПолучательДанных
		Или РезультатВыполненияРасчета.ВыполнитьЛокальныйРасчет) Тогда
		РезультатВыполненияРасчета.ЕстьОшибки = Ложь;
		РезультатВыполненияРасчета.ТекстОшибки = "";
		ОбщегоНазначенияРМКПереопределяемый.РассчитатьАвтоматическиеСкидки(ЭтотОбъект, РезультатВыполненияРасчета);
	КонецЕсли;
	
	РезультатВыполненияРасчета.ИндексСтрокиПередПересчетом = ТекущийТоварИндексСтроки;
	
	Если (РежимРаботыСЧеком = РежимыРаботыСЧеком.ПереходКОплате И ВыдаватьПодарокНаКассе)
			Или Не РежимКассыСамообслуживания Тогда
		ПрименитьПодарки();
	КонецЕсли;
	
	Если РежимПоказаСкидок Тогда
		ЗаполнитьАвтоматическиеСкидкиНаСервере();
	КонецЕсли;
	
	Возврат РезультатВыполненияРасчета;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСкидкиКлиент(ОткрыватьФормуВыбораПодарков = Ложь, ПринудительныйПересчет = Ложь)
	
	ПродолжитьРасчетСкидок = Истина;
	Если Не ДальнейшийРасчетДоступен
		И Не СерверЛояльностиНедоступен Тогда
		ПроверитьСоединениеСервераЛояльности(ПродолжитьРасчетСкидок);
	КонецЕсли;
		
	ПродолжитьВыполнениеОтложенногоМетода = Истина;
	Если ИспользоватьАвтоматическиеСкидки
		И ПродолжитьРасчетСкидок Тогда
		
		ОчиститьТаблицыУправленияСкидок();
		Если (ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации) И НЕ ЭтоЗаменаТоваров)
			ИЛИ ПолучатьСкидкиДокументаОснованияССервера Тогда
			ОтменитьСкидки(, ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации));
			
			СтруктураПримененияСкидок = Новый Структура;
			СтруктураПримененияСкидок.Вставить("ОткрыватьФормуВыбораПодарков", ОткрыватьФормуВыбораПодарков);
			СтруктураПримененияСкидок.Вставить("ПринудительныйПересчет", ПринудительныйПересчет);
			РассчитатьИПрименитьАвтоматическиеСкидкиПриПродаже(ПродолжитьВыполнениеОтложенногоМетода,
					СтруктураПримененияСкидок);
		ИначеЕсли (ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации) 
				И ИспользоватьАвтоматическиеСкидкиПриВозврате) 
				ИЛИ ЭтоЗаменаТоваров Тогда
			ОтменитьСкидки(, Истина);
			РассчитатьИПрименитьАвтоматическиеСкидкиПриВозврате(ПродолжитьВыполнениеОтложенногоМетода);
		КонецЕсли;
		СформироватьЗаголовокКнопокРассчитатьСкидки();
		
		Если СкорректированыРучныеСкидки Тогда
			ВывестиСообщениеСкорректированыРучныеСкидки();
		КонецЕсли;
		УправлениеВидимостьюРеквизитовКарты();
		ПереключитьРежимНаПоказСкидок();
	КонецЕсли;
	
	Если ПродолжитьВыполнениеОтложенногоМетода 
		И ЗначениеЗаполнено(ИмяМетода) 
		И НЕ ПринудительныйПересчет Тогда
		
		ВыполнитьОтложенныйМетод();
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПрименитьАвтоматическиеСкидкиПриПродаже(БылСохраненТолькоНомер, СтруктураПримененияСкидок)
	
	ПолученаКарта = ЗначениеЗаполнено(Объект.ДисконтнаяКарта)
		Или ИнтерфейсРМКСлужебныйКлиентСервер.ПолученИдентификаторКартыЛояльности(ПараметрыКартыЛояльности);
	Если ПолученаКарта И БылСохраненТолькоНомер Тогда
		ЗавершитьВводШтрихкодаНайденаКарта(КодВозвратаДиалога.Нет, Ложь);
	КонецЕсли;
	
	ОткрыватьФормуВыбораПодарков = СтруктураПримененияСкидок.ОткрыватьФормуВыбораПодарков;
	ПринудительныйПересчет = СтруктураПримененияСкидок.ПринудительныйПересчет;
	СкидкиРассчитаны = Истина;
	ОтразитьСработавшиеПромокодыНаКлиенте();
	ПроверитьПрименениеУправляемыхСкидокКлиент();
	ПересчитатьСуммыТаблицыТоваров(Ложь);
	РассчитатьСуммуОплатыБонусами();
	РассчитатьСуммыОплаты();
	ДоступностьОтменыСкидки = Объект.Товары.Итог("СуммаСкидокОбщая") <> 0;
	УстановитьДоступностьЭлементаФормы(Элементы.ОтменаРасчетаСкидок, ДоступностьОтменыСкидки);
	ТребуетсяПересчетСкидок = Ложь;
	ВывестиСообщения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьАвтоматическиеСкидкиПриВозврате()
	
	СкидкиРассчитаны = Истина;
	ПересчитатьСуммыТаблицыТоваров(Ложь);
	РассчитатьСуммуОплатыБонусами();
	РассчитатьСуммыОплаты();
	ДоступностьОтменыСкидки = Объект.Товары.Итог("СуммаСкидокОбщая") <> 0;
	УстановитьДоступностьЭлементаФормы(Элементы.ОтменаРасчетаСкидок, ДоступностьОтменыСкидки);
	ТребуетсяПересчетСкидок = Ложь;
	ВывестиСообщения();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИПрименитьАвтоматическиеСкидкиПриПродаже(ПродолжитьВыполнениеОтложенногоМетода, СтруктураПримененияСкидок)
	
	БылСохраненТолькоНомер = (Не ЗначениеЗаполнено(Объект.ДисконтнаяКарта))
		И ИнтерфейсРМКСлужебныйКлиентСервер.СохраненТолькоНомерКартыЛояльности(ПараметрыКартыЛояльности);
	РезультатРасчета = РассчитатьАвтоматическиеСкидкиНаСервере();
	
	Если Не ПустаяСтрока(РезультатРасчета.ТекстОповещения) Тогда
		ПоказатьОповещениеПользователя(РезультатРасчета.ТекстОповещения);
	КонецЕсли;
	
	Если РезультатРасчета.ЕстьОшибки Тогда
		Если Не РежимКассыСамообслуживания Тогда
			ПродолжитьВыполнениеОтложенногоМетода = Ложь;
			ПоказатьОшибкуРасчетаСкидок(Истина, РезультатРасчета.ТекстОшибки);
		КонецЕсли;
	ИначеЕсли ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации)
		И НЕ ПолучатьСкидкиДокументаОснованияССервера Тогда
			// Такое возможно если на сервере нет чека продажи, и получить скидки из документа-основания не удалось
			// В этом случае, сервер вернет только скидки - дисконт при возврате. 
			// А скидки, которые применялись при продаже изначально, нужно получать на стороне РМК. 
		ПрименитьАвтоматическиеСкидкиПриВозврате();
		ОбновитьРежимСкидокПоДокументуОснованию();
	Иначе
		ПрименитьАвтоматическиеСкидкиПриПродаже(БылСохраненТолькоНомер,СтруктураПримененияСкидок);
		
		КоличествоСтрок = Объект.Товары.Количество();
		ИзменитьАктивациюСтроки = РежимРаботыСЧеком = РежимыРаботыСЧеком.ВводТоваров
			И КоличествоСтрок - 1 >= РезультатРасчета.ИндексСтрокиПередПересчетом;
		Если РезультатРасчета.ИндексСтрокиПередПересчетом >= 0
			И ИзменитьАктивациюСтроки Тогда
			СтрокаТоваров = Объект.Товары.Получить(РезультатРасчета.ИндексСтрокиПередПересчетом);
			ИдентификаторСтроки = СтрокаТоваров.ПолучитьИдентификатор();
			Если НЕ ТекущийТоварИдентификатор = ИдентификаторСтроки Тогда
				Элементы.Товары.ТекущаяСтрока = ИдентификаторСтроки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИПрименитьАвтоматическиеСкидкиПриВозврате(ПродолжитьВыполнениеОтложенногоМетода)
	
	РезультатРасчета = РассчитатьАвтоматическиеСкидкиНаСервере();
	
	Если Не ПустаяСтрока(РезультатРасчета.ТекстОповещения) Тогда
		ПоказатьОповещениеПользователя(РезультатРасчета.ТекстОповещения);
	КонецЕсли;
	
	Если РезультатРасчета.ЕстьОшибки Тогда
		ПродолжитьВыполнениеОтложенногоМетода = Ложь;
		ПоказатьОшибкуРасчетаСкидок(Истина, РезультатРасчета.ТекстОшибки);
	Иначе
		ПрименитьАвтоматическиеСкидкиПриВозврате();
	КонецЕсли;
	УстановитьАктивностьСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПрименениеУправляемыхСкидокКлиент()
	
	НеСработавшиеУправляемыеСкидки = Новый Массив();
	Для Каждого УправляемаяСкидка Из ТаблицаВыбранныхУправляемыхСкидок Цикл
		ОтборСкидок = Новый Структура("СкидкаНаценка",
			?(ТипЗнч(УправляемаяСкидка.СкидкаНаценка) = Тип("Строка"), УправляемаяСкидка.ИдентификаторСкидки, УправляемаяСкидка.СкидкаНаценка));
		Если ЗначениеЗаполнено(УправляемаяСкидка.ИдентификаторСтроки) Тогда
			ОтборСкидок.Вставить("ИдентификаторСтроки", УправляемаяСкидка.ИдентификаторСтроки);
		КонецЕсли;
		СработавшиеСкидки = ТаблицаСкидкиНаценки.НайтиСтроки(ОтборСкидок);
		Если СработавшиеСкидки.Количество() = 0 И НЕ УправляемаяСкидка.ЭтоПравилоНачисленияБонусов Тогда
			НеСработавшиеУправляемыеСкидки.Добавить(УправляемаяСкидка);
		КонецЕсли;
	КонецЦикла;
	СкидокНеСработало = НеСработавшиеУправляемыеСкидки.Количество();
	Если СкидокНеСработало > 0 Тогда
		ТекстЗаголовка = НСтр("ru = 'Некоторые управляемые скидки не применены.'");
		КраткоеОписаниеСкидок = "";
		ПодробноеОписаниеСкидок = "";
		Если СкидокНеСработало = 1 Тогда
			КраткоеОписаниеСкидок = Строка(НеСработавшиеУправляемыеСкидки[0].СкидкаНаценка);
		Иначе 
			КраткоеОписаниеСкидок = Строка(СкидокНеСработало) + НСтр("ru=' шт.'");
			ПереносСтроки = ";
			|";
			ПодробноеОписаниеСкидок = НСтр("ru = 'Не сработавшие скидки:'");
			Для Каждого НеСработавшаяСкидка Из НеСработавшиеУправляемыеСкидки Цикл
				ПодробноеОписаниеСкидок = СтрШаблон(НРег("%1%2"), ПереносСтроки, НеСработавшаяСкидка.СкидкаНаценка)
			КонецЦикла;
		КонецЕсли;
		ТекстПояснения = СтрШаблон(НСтр("ru='Управляемые скидки не сработали (%1). 
			|Возможно, скидки содержат дополнительные условия, которые не выполнены в данном чеке.%2'"),
			КраткоеОписаниеСкидок, ПодробноеОписаниеСкидок);
			
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстПояснения, ТекстЗаголовка);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщения(ПослеОформленияЧека = Ложь)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПослеОформленияЧека", ПослеОформленияЧека);
	МассивСообщений = ТаблицаСообщений.НайтиСтроки(Отбор);
	ТекстЗаголовка = НСтр("ru = 'Маркетинговое сообщение.'");
	Для Каждого Сообщение Из МассивСообщений Цикл
		ТаблицаСообщений.Удалить(Сообщение);
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(Сообщение.ТекстСообщения, ТекстЗаголовка);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьСкидки(ОтменитьРучныеСкидки = Ложь, ЭтоВозврат = Ложь)
	
	СкидкиРассчитаны = Ложь;
	ЦветФонаНеактивнойКнопки = ЦветаФормы.Авто;
	Если Не ЭтоВозврат ИЛИ ПолучатьСкидкиДокументаОснованияССервера Тогда
		Если Не ЭтоВозврат Тогда
			ТаблицаСкидкиНаценки.Очистить();
			ТаблицаБонусныеБаллы.Очистить();
			ТаблицаБонусныеБаллыЧекаПродажи.Очистить();
		КонецЕсли;
	Иначе
		МассивСтрокКУдалению = Новый Массив;
		Для Каждого СтрокаТаблицы Из ТаблицаСкидкиНаценки Цикл
			Если СтрокаТаблицы.ПриВозврате Тогда
				МассивСтрокКУдалению.Добавить(СтрокаТаблицы);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
			ТаблицаСкидкиНаценки.Удалить(СтрокаКУдалению);
		КонецЦикла;
	КонецЕсли;
	СуммаПотенциальныхБонусовКНачислению = 0;
	
	ОтменитьОкругление();
	
	СтрокиКОтмене = Объект.Товары.НайтиСтроки(Новый Структура("Подарок", Ложь));
	
	Для Каждого СтрокаТовар Из СтрокиКОтмене Цикл
		
		Если СтрокаТовар.Подарок Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОтменитьРучныеСкидки Тогда
			
			СтрокаТовар.СуммаСкидкиНаценки = 0;
			СтрокаТовар.ПроцентСкидкиНаценки = 0;
			СтрокаТовар.РассчитанаСкидка = Ложь;
			
			СтрокаТовар.СуммаСкидкиПенсионерам = 0;
			СтрокаТовар.ПроцентСкидкиПенсионерам = 0;
			
			ЗначениеСкидкиНаЧек = 0;
			ПримененаСкидкаНаЧек = Ложь;
			
		КонецЕсли;
		
		Если Не ЭтоВозврат Или ЭтоВозвратАванса
			Или СтрокаТовар.ЭтоПодарочныйСертификат 
			ИЛИ ПолучатьСкидкиДокументаОснованияССервера
			И НЕ СтрокаТовар.ТоварКЗамене Тогда
			СтрокаТовар.СуммаАвтоматическойСкидки = 0;
			СтрокаТовар.ПроцентАвтоматическойСкидки = 0;
		Иначе
			СтрокаТовар.СуммаАвтоматическойСкидки = СтрокаТовар.СуммаАвтоматическойСкидкиЧекаПродажи;
			СтрокаТовар.ПроцентАвтоматическойСкидки = ?(СтрокаТовар.СуммаБезСкидки = 0, 0, СтрокаТовар.СуммаАвтоматическойСкидкиЧекаПродажи/СтрокаТовар.СуммаБезСкидки * 100);
		КонецЕсли;
		
		ПересчитатьСуммы(СтрокаТовар);
		
	КонецЦикла;
	
	Если ОтменитьРучныеСкидки Тогда
		УстановитьДоступностьЭлементаФормы(Элементы.ЗначениеСкидкиНаЧек, НЕ СкидкиРассчитаны);
		Если ОтображаетсяСкидкаПроцентомНаЧек Тогда
			Элементы.СкидкаНаЧекПроцентом.ЦветФона = ЦветФонаНеактивнойКнопки;
		ИначеЕсли ОтображаетсяСкидкаСуммойНаЧек Тогда
			Элементы.СкидкаНаЧекСуммой.ЦветФона = ЦветФонаНеактивнойКнопки;
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущийТоварСкидка <> 0 И ОтменитьРучныеСкидки Тогда
		
		ТекущийТоварСкидка = 0;
		
	КонецЕсли;
	ПересчитатьИтогиТабличнойЧастиТовары(Ложь);
	РассчитатьСуммыОплаты();
	
	ОтразитьСработавшиеПромокодыНаКлиенте();
	
	УстановитьДоступностьЭлементаФормы(Элементы.ОтменаРасчетаСкидок, СкидкиРассчитаны);
	ТребуетсяПересчетСкидок = Ложь;
	ОчиститьТаблицыУправленияСкидок();
	СформироватьЗаголовокКнопокРассчитатьСкидки();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьТоварЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	
	СуммаДляРегистрации = Объект.Товары.Итог("Сумма");
	СтрокаТовар = Объект.Товары.Получить(ТекущийТоварИндексСтроки);
	ЭтоПодарок = СтрокаТовар.Подарок;
	Если СкидкиРассчитаны Тогда
		ЭтоВозврат = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
		ОтменитьСкидки(, ЭтоВозврат);
		Если ЭтоПодарок Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Строка = Объект.Товары.Получить(ТекущийТоварИндексСтроки);
	
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВозможноЗакрытьСессиюРегистрацииМарок = ККМПоддерживаетПроверкуКодовМаркировки
		И ЗначениеЗаполнено(Строка.КодМаркировки)
		И ЗначениеЗаполнено(ИдентификаторТекущейСессииПроверкиМарок)
		И ВозможноЗакрытьСессиюРегистрацииМарок();
		
	Если ВозможноЗакрытьСессиюРегистрацииМарок Тогда
		ЗакрытьСессиюРегистрацииМарок();
	КонецЕсли;
	
	УдалитьСтрокуТовара(ЭтотОбъект, Строка, Объект.Товары);
	Если ДоступнаПивнаяПалитра
		И ЗначениеЗаполнено(Строка.КодМаркировки)
		И ЗначениеЗаполнено(Строка.КодыМаркировкиПоДаннымИБ) Тогда
		ПараметрыКрана = Новый Структура;
		ПараметрыКрана.Вставить("Номенклатура", Строка.Номенклатура);
		ПараметрыКрана.Вставить("ИмяЭлемента", Строка.ПредставлениеКодАртикул);
		
		ОстатокПиваПоСтроке = ОстатокПиваПоКрануСУчетомЧека(ПараметрыКрана, Объект.Товары, Строка);
		ЗаполнитьОпорныеДанныеКранаНаКлиенте(ПараметрыКрана, ОстатокПиваПоСтроке);
		ЗаполнитьДанныеКнопкиКрана(ДанныеКнопокПлиток, ПараметрыКрана);
	КонецЕсли;
	ЗакрытьБаннерПриНеобходимости();
	ОграничитьДоступностьЭлементовПриОжиданииМарки(Ложь);
	ЗаполнитьОжидаемоеКоличествоЧеков();
	
	ОбновитьИнформациюНаДисплееПокупателя(ТипыОперацийДисплеяПокупателя.УдалениеТовара);
	
	Если Объект.Товары.Количество() = 0 Тогда
		
		Если ЗначениеЗаполнено(ОтложенныйЧек) Тогда
			АннулироватьЧек(ОтложенныйЧек);
		КонецЕсли;
		
		ПереключатьсяВРежимПлитки = ОсновнойПодборПлиточный;
		РазблокироватьОбъектСервераЛояльности("clientbonuses");
		СписатьРазблокироватьПодарочныеСертификаты();
		ИнициализироватьИнтерфейсРабочегоМестаКассира();
		
		Если РегистрироватьДействияКассира(ЭтотОбъект) Тогда
			ПараметрыОперации = ИнтерфейсРМКСлужебныйКлиентСервер.ПодготовитьПараметрыОперацииНаРабочемМестеКассира(ЭтотОбъект);
			ПараметрыОперации.РегистрируемаяОперация
				= ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ОперацииРабочегоМестаКассира.УдалениеЧека");
			ПараметрыОперации.Сумма = СуммаДляРегистрации;
			ЗаписатьОперациюНаРабочемМестеКассира(ПараметрыОперации);
		КонецЕсли;
		
	Иначе
		ПересчитатьСуммыПослеУдаленияСтроки();
	КонецЕсли;
	ОбработатьИзменениеТаблицыТоваровНаКлиенте();
	Если РежимРаботыСЧеком = РежимыРаботыСЧеком.ВозвратКоррекция Тогда
		ЗаполнитьТаблицуЧековКПробитию();
		ПересчитатьОбщиеИтоги();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенаИзКарточкиПриИзмененииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЦенаИзКарточкиПриИзмененииПродолжение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьДанныеПриИзмененииКоличестваЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Свойство("УвеличитьКоличество") Тогда
		УвеличитьКоличество = ДополнительныеПараметры.УвеличитьКоличество;
	Иначе
		УвеличитьКоличество = Ложь;
	КонецЕсли;
	Дельта = ДополнительныеПараметры.Дельта;
	
	ТекущаяСтрока = Объект.Товары.Получить(ТекущийТоварИндексСтроки);
	
	Если Результат = КодВозвратаДиалога.Нет 
		ИЛИ (НЕ ТекущаяСтрока = Неопределено И ТекущаяСтрока.ТоварКЗамене) Тогда
		ТекущийТоварКоличество = ТекущаяСтрока.Количество;
		Возврат;
	КонецЕсли;
	
	Если ПримененыСкидки() Тогда
		ЭтоВозврат = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
		ОтменитьСкидки(, ЭтоВозврат);
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.ЭтоНабор Тогда
		ИзменитьКоличествоНабора(ТекущаяСтрока, УвеличитьКоличество);
		ВыполнитьПроверкиИОбработатьКонтрольПродажПриУвеличенииКоличества(ТекущаяСтрока, УвеличитьКоличество);
		Возврат;
	ИначеЕсли ТекущаяСтрока.Весовой Тогда
		ИзменитьКоличествоВесовогоТовара(ТекущаяСтрока, УвеличитьКоличество);
		ОбновитьДоступностьКнопкиУменьшенияКоличества(ТекущаяСтрока);
		ВыполнитьПроверкиИОбработатьКонтрольПродажПриУвеличенииКоличества(ТекущаяСтрока, УвеличитьКоличество);
		Возврат;
	КонецЕсли;
	
	Если УвеличитьКоличество Тогда
		ТекущийТоварКоличество = ТекущийТоварКоличество + Дельта;
		Если Дельта = 1 Или ТекущийТоварКоличество > 1 Тогда
			ТекущийТоварКоличество = Цел(ТекущийТоварКоличество);
		КонецЕсли;
		
		Если ДоступнаПивнаяПалитра И ТекущаяСтрока.ПоштучноеВыбытие
			И ТекущаяСтрока.ПоддерживаетсяПодключениеКОборудованиюРозлива Тогда
				ОбработатьИзменениеКоличестваДляПлиткиКрана(ТекущаяСтрока, УвеличитьКоличество);
		КонецЕсли;
		
		СкорректироватьТекущееКоличество(ТекущаяСтрока);
		ОбработатьИзменениеКоличестваНеВесовогоТовара(ТекущаяСтрока);
		ВыполнитьПроверкиИОбработатьКонтрольПродажПриИзмененииСтроки(ТекущаяСтрока);
	Иначе
		Если ТекущийТоварКоличество > Дельта Тогда
			Если Дельта = 1 И ТекущийТоварКоличество > Цел(ТекущийТоварКоличество) Тогда
				ТекущийТоварКоличество = Цел(ТекущийТоварКоличество);
			Иначе
				ТекущийТоварКоличество = ТекущийТоварКоличество - Дельта;
			КонецЕсли;
			Если ДоступнаПивнаяПалитра И  ТекущаяСтрока.ПоштучноеВыбытие
				И ТекущаяСтрока.ПоддерживаетсяПодключениеКОборудованиюРозлива Тогда
					ОбработатьИзменениеКоличестваДляПлиткиКрана(ТекущаяСтрока, УвеличитьКоличество);
			КонецЕсли;
				
			СкорректироватьТекущееКоличество(ТекущаяСтрока);
			ОбработатьИзменениеКоличестваНеВесовогоТовара(ТекущаяСтрока);
		КонецЕсли;
	КонецЕсли;
	ОбновитьДоступностьКнопкиУменьшенияКоличества(ТекущаяСтрока);
	Если РежимРаботыСЧеком = РежимыРаботыСЧеком.ВозвратКоррекция Тогда
		ЗаполнитьТаблицуЧековКПробитию();
		ПересчитатьОбщиеИтоги();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкиИОбработатьКонтрольПродажПриУвеличенииКоличества(СтрокаИзменения, КоличествоУвеличено)
	
	Если КоличествоУвеличено Тогда
		ВыполнитьПроверкиИОбработатьКонтрольПродажПриИзмененииСтроки(СтрокаИзменения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКаталогЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьАвтоматическиеСкидки И СкидкиРассчитаны Тогда
		ОтменитьСкидки();
	КонецЕсли;
	
	Если ИспользоватьНовыйПодборТоваров Тогда
		
//		РежимВыбораПодарка = Ложь;
		РежимВыбораПодарочногоСертификата = Ложь;
		ОткрытьКаталогКлиент();
		
		ПодключитьОбработчикОжидания("УстановитьФокусНаПоискТоваров", 0.1, Истина);
		
	Иначе
		ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуПодбораТоваров(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФокусНаПоискТоваров()
	
	Если Не (РежимВыбораПодарочногоСертификата Или РежимВыбораХарактеристики) Тогда
		ТекущийЭлемент = Элементы.ДополнениеСтрокаПоиска;
	Иначе
		ТекущийЭлемент = Элементы.ДополнениеДополнительнаяСтрокаПоиска;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкидкаНаЧекЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьАвтоматическиеСкидки И СкидкиРассчитаны Тогда
		ОтменитьСкидки();
	КонецЕсли;
	
	Активность = Ложь;
	НастроитьИнтерфейсУправленияЧеком(Элементы.ГруппаСкидкиНаЧек, Активность);
	ТекущийЭлемент = Элементы.ЗначениеСкидкиНаЧек;
	
КонецПроцедуры

&НаКлиенте
Процедура СкидкаТекущийТоварПроцентЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьАвтоматическиеСкидки И СкидкиРассчитаны Тогда
		ОтменитьСкидки();
	КонецЕсли;
	
	ТекущиеДанные = Объект.Товары.Получить(ТекущийТоварИндексСтроки);
	
	Если Не ТекущиеДанные = Неопределено Тогда
		
		Если ЭтоСоставляющаяНабора(ТекущиеДанные) Тогда
			
			СоставНабора = СоставНабораПоЭлементуНабора(ТекущиеДанные, Объект.Товары);
			
			Если СоставНабора.Количество() = Объект.Товары.Количество() Тогда
				Позиции = Объект.Товары;
			Иначе
				Позиции = СоставНабора;
			КонецЕсли;
			
			РассчитатьРучнуюСкидкуПроцентомНаПозиции(Позиции, ЗначениеСкидкиНаСтроку);
			
		Иначе
			РучнаяСкидкаПроцентомПоСтроке(ТекущиеДанные);
		КонецЕсли;
		
	КонецЕсли;
	Если ВыполнитьПересчетАвтоматическихСкидок Тогда
		ВыполнитьПересчетСкидок();
	Иначе
		ПерезаполнитьТаблицуСкидок();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкидкаТекущийТоварСуммаЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьАвтоматическиеСкидки И СкидкиРассчитаны Тогда
		ОтменитьСкидки();
	КонецЕсли;
	
	ТекущиеДанные = Объект.Товары.Получить(ТекущийТоварИндексСтроки);
	
	Если Не ТекущиеДанные = Неопределено Тогда
		
		Если ЭтоСоставляющаяНабора(ТекущиеДанные) Тогда
			
			СоставНабора = СоставНабораПоЭлементуНабора(ТекущиеДанные, Объект.Товары);
			
			Если СоставНабора.Количество() = Объект.Товары.Количество() Тогда
				Позиции = Объект.Товары;
			Иначе
				Позиции = СоставНабора;
			КонецЕсли;
			
			ЭтоРасчетСкидкиНаНабор = Истина;
			РассчитатьРучнуюСкидкуСуммойНаПозиции(Позиции, ЗначениеСкидкиНаСтроку);
			
		Иначе
			РучнаяСкидкаСуммойПоСтроке(ТекущиеДанные);
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущиеДанные = Объект.Товары.Получить(ТекущийТоварИндексСтроки);
	Если ВыполнитьПересчетАвтоматическихСкидок Тогда
		ВыполнитьПересчетСкидок();
	Иначе
		ПерезаполнитьТаблицуСкидок();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОплатаНаличнымиЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
