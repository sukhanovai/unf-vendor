&НаКлиенте
Процедура ОбработатьИзменениеСуммыБонусов()
	Если НЕ ЗначениеЗаполнено(БонусыДоступноКОплате) Тогда
		СуммаОплаченоБонусами = 0;
	ИначеЕсли СуммаОплаченоБонусами > БонусыДоступноКОплате Тогда
		СуммаОплаченоБонусами = БонусыДоступноКОплате;
	КонецЕсли;
	
	Если Объект.Товары.Итог("СуммаСкидкиОплатыБонусом") > 0 Тогда
		
		НоваяСуммаОплатыБонусами		= СуммаОплаченоБонусами;
		ОчиститьДанныеКартыПокупателя	= Ложь;
		ОтменитьПримененныеБонусы(ОчиститьДанныеКартыПокупателя);
		СуммаОплаченоБонусами = НоваяСуммаОплатыБонусами;
		
	КонецЕсли;
	
	ОбнулятьСуммыОплат = Ложь;
	
	РаспределитьБонусыПоТоварам();
	ЗаполнитьТаблицуЧековКПробитию();
	ПересчитатьИтогиТабличнойЧастиТовары(ОбнулятьСуммыОплат);
	
	ЭтоОперацияВозврат = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	
	ПараметрыПересчета							= СтруктураПараметровПересчетаСуммОплаты();
	ПараметрыПересчета.ПриИзмененииБНОплаты		= СуммаОплаченоБН > 0;
	ПараметрыПересчета.ПересчитыватьОкругление	= НЕ ЭтоОперацияВозврат;
	ПараметрыПересчета.ПоКомандеОплатитьВсюСуммуБонусами = СуммаОплаченоБонусами > 0
		И (СуммаОплаченоБонусами = БонусыДоступноКОплате) И СуммаКОплате = 0;
		
	Если РежимТихойОплаты Тогда
		// Тихая оплата уже произошла, пересчет скидок вызывать не следует, т.к. изменение суммы чека после оплаты недопустимо.
		РассчитатьСуммыОплаты();
		ЗаполнитьВведенныеОплаты(ПараметрыПересчета);
		ЗаполнитьТаблицуЧековКПробитию();

	ИначеЕсли (СуммаОплаченоБН > 0 ИЛИ СуммаОплаченоНал > 0
		ИЛИ СуммаОплаченоВРассрочку > 0 ИЛИ СуммаОплаченоЗачетАванса > 0) Тогда
		
			
		РассчитатьСуммыОплатыПриРедактировании(ПараметрыПересчета);
		
	Иначе
		// Сумма примененных бонусов может повлиять на скидки по виду оплаты, или на сумму скидки процентом
		ОткрыватьФормуВыбораПодарков = Ложь;
		РассчитатьСкидкиКлиент(ОткрыватьФормуВыбораПодарков);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасчетРучныхСкидокНаДокумент()
	Если Объект.Товары.Количество() > 0 Тогда
		Если СкидкиРассчитаны И НЕ ПолныйРасчетСкидок И ВопросПоРасчетуСкидок Тогда
			ЗадатьВопросПоРасчетуСкидок("ВыполнитьРасчетРучныхСкидокНаДокументЗавершение");
		Иначе
			ВыполнитьРасчетРучныхСкидокНаДокументЗавершение(КодВозвратаДиалога.Да);
		КонецЕсли;
	Иначе
		ЗначениеСкидкиНаЧек = 0;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасчетРучныхСкидокНаДокументЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		ЗначениеСкидкиНаЧек = 0;
		Возврат;
	КонецЕсли;
	
	ЭтоСкидкаПенсионера = Ложь;
	Если ДополнительныеПараметры <> Неопределено
		И ДополнительныеПараметры.Свойство("ЭтоСкидкаПенсионера") Тогда
		ЭтоСкидкаПенсионера = Истина;
	КонецЕсли;
	
	Если ИспользоватьАвтоматическиеСкидки И СкидкиРассчитаны Тогда
		ОтменитьСкидки();
	КонецЕсли;
	Позиции = Объект.Товары;
	
	Если СкидкиНаЧекСкидкаПереключатель = 0 Тогда
		РассчитатьРучнуюСкидкуПроцентомНаПозиции(Позиции, ЗначениеСкидкиНаценки, ЭтоСкидкаПенсионера);
	Иначе
		РассчитатьРучнуюСкидкуСуммойНаПозиции(Позиции, ЗначениеСкидкиНаценки);
	КонецЕсли;
	
	Если ВыполнитьПересчетАвтоматическихСкидок Тогда
		ВыполнитьПересчетСкидок();
	Иначе
		ПерезаполнитьТаблицуСкидок();
	КонецЕсли;
КонецПроцедуры

