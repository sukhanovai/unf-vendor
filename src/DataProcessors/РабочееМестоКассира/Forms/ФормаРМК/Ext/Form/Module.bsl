&НаКлиенте
Функция НайтиФормуПоИмени(ИмяПроверяемойФормы)
	
	РезультатФункции = Неопределено;
	ОткрытыеОкна = ПолучитьОкна();
	Счт = 0;
	Пока Счт < ОткрытыеОкна.Количество() И РезультатФункции = Неопределено Цикл
		ТекущееОкно = ОткрытыеОкна.Получить(Счт);
		Если ТекущееОкно.Содержимое.Количество() > 0 Тогда
			ФормаОкна = ТекущееОкно.Содержимое[0];
			Если ТипЗнч(ФормаОкна) = Тип("ФормаКлиентскогоПриложения") И ФормаОкна.ИмяФормы = ИмяПроверяемойФормы Тогда
				РезультатФункции = ФормаОкна;
			КонецЕсли;
		КонецЕсли;
		Счт = Счт + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьКнопкиУменьшенияКоличества(ТекущаяСтрока)
	
	Дельта = ОпределитьШагИзмененияКоличества(Ложь);
	ДоступностьУменьшения = УменьшениеКоличестваТовараВозможно(Дельта);
	
	Если РежимКассыСамообслуживания Тогда
		УстановитьДоступностьЭлементаФормы(Элементы.КнопкаТоварУменьшитьКоличествоКСО,
			ДоступностьУменьшения И Не ТекущаяСтрока.Весовой);
		Если Не ЗакрыватьПодборПриВыбореТовара Тогда
			УстановитьДоступностьЭлементаФормы(Элементы.КнопкаТоварУменьшитьКоличествоВПлиткеКСО,
				ДоступностьУменьшения И Не ТекущаяСтрока.Весовой);
		КонецЕсли;
	Иначе
		УстановитьДоступностьЭлементаФормы(Элементы.ТекущийТоварУменьшитьКоличество, ДоступностьУменьшения);
		УстановитьДоступностьЭлементаФормы(Элементы.ТекущийТоварУменьшитьКоличествоИзВозврата, ДоступностьУменьшения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаВводаМаркиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	КодМаркировкиДоОчистки = "";
	Если Не ДополнительныеПараметры = Неопределено Тогда
		Если ДополнительныеПараметры.Свойство("КодМаркировкиДоОчистки") Тогда
			КодМаркировкиДоОчистки = ДополнительныеПараметры.КодМаркировкиДоОчистки;
		КонецЕсли;
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		
		Если ЗначениеЗаполнено(КодМаркировкиДоОчистки) Тогда
			ВыборКодаМаркировки = КодМаркировкиДоОчистки;
			ВыбратьКодМаркировкиДляТекущейСтроки();
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Результат.УдалитьТовар Тогда
		УдалитьТоварНаКлиенте();
	ИначеЕсли Результат.ДобавитьБезМарки Тогда
		ДобавитьТоварБезМарки();
	ИначеЕсли ЗначениеЗаполнено(Результат.КодМаркировки) Тогда
		ВыборКодаМаркировки = Результат.КодМаркировки;
		ВыбратьКодМаркировкиДляТекущейСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводШтрихкодаМРЦНекорректна(ПараметрыДляОбработкиШтрихкода)
	
	ТекстЗаголовка = НСтр("ru='Товар не может быть продан.'");
	ТекстСообщения = СтрШаблон(НСтр("ru='МРЦ из контрольной марки меньше ЕМРЦ.'"));
	
	ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ТекстЗаголовка);
	ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
	ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиВозрастаMAX(РезультатВызова, ДополнительныеПараметры) Экспорт
	
	ТипыРезультатаПроверки = МенеджерОборудованияКлиент.ТипРезультатаПроверкиВозрастаВМакс();
	
	Если РезультатВызова.Результат = ТипыРезультатаПроверки.ВозрастПодтвержден Тогда
		ПодтвердитьВозраст(Команды.ПодтвердитьВозраст);
	ИначеЕсли РезультатВызова.Результат = ТипыРезультатаПроверки.ПозватьСотрудника Тогда
		ТекущаяСтрокаОграничения = РезультатКонтроляПродаж.ОграниченияПродаж[0];
		ТекущаяСтрокаОграничения.ПодтверждениеЧерезMAX = Ложь;
		ПереключитьНаСтраницуПодтвержденияВозраста(ТекущаяСтрокаОграничения);
	ИначеЕсли РезультатВызова.Результат = ТипыРезультатаПроверки.Отмена Тогда
		ОпровергнутьВозраст(Команды.ОпровергнутьВозраст);
	ИначеЕсли РезультатВызова.Результат = ТипыРезультатаПроверки.Ошибка Тогда
		ОпровергнутьВозраст(Команды.ОпровергнутьВозраст);
		ТекстЗаголовка = НСтр("ru = 'Проверка возраста MAX.'");
		ТекстОшибки = РезультатВызова.ОписаниеОшибки;
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстОшибки, ТекстЗаголовка);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = РезультатВызова.КодОтвета = 400;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
	КонецЕсли;
	ОбновитьИнформациюНаДисплееПокупателя(ТипыОперацийДисплеяПокупателя.СписокТоваров);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОбработкуСтатусовТСПИоТ() Экспорт
	
	ОбщегоНазначенияРМККлиент.ЗапуститьОбработкуСтатусовТСПИоТ(ТаблицаКассККМОрганизаций, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьТаблицуПлатежныхКартИУдалитьРеквизиты()
	
	Если КоличествоДополнительныхКарт = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоДополнительныхКарт Цикл
		Если ИспользоватьОплатуНесколькимиКартами И ИндексСтроки > 0 Тогда
			УдалитьРеквизитыОплатыКартой(Строка(ИндексСтроки));
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	ВосстановитьЭлементыОплатыКартой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВосстановитьЭлементыОплатыКартой(Форма)
	
	Элементы = Форма.Элементы;
	
	Форма.ТаблицаОплатКартой.Очистить();
	Форма.СуммаОплаченоБН_0 = 0;
	Форма.КоличествоДополнительныхКарт = 0;
	УстановитьДоступностьЭлементаФормы(Элементы.ГруппаВидОплатыКартойГоризонтально, Истина);
	УстановитьВидимостьЭлементаФормы(Элементы.ГруппаВидОплатыКартойГоризонтально, Истина);
	УстановитьВидимостьЭлементаФормы(Элементы.ОплатаКартой, Истина);
	УстановитьДоступностьЭлементаФормы(Элементы.ОплатаКартой, Истина);
	Элементы.ОплатаКартой.Отображение = ОтображениеКнопки.Текст;
	Элементы.ОплатаКартой.Заголовок   = НСтр("ru = 'Внести остаток'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиСтатусаПокупателяMAX(РезультатВызова, ДополнительныеПараметры) Экспорт
	
	ТипыРезультатаПроверки = МенеджерОборудованияКлиент.ТипРезультатаПроверкиСтатусаВМакс();
	
	Если РезультатВызова.Результат = ТипыРезультатаПроверки.СтатусПодтвержден Тогда
		ПокупательПенсионер = Истина;
		РассчитатьСкидкуПенсионерам(Неопределено);
	ИначеЕсли РезультатВызова.Результат = ТипыРезультатаПроверки.СтатусПроверен Тогда
		Если РезультатВызова.Статусы.Взрослый И ПодтвержденныйВозрастПокупателя < 18 Тогда
			ПодтвержденныйВозрастПокупателя = 18;
		КонецЕсли;
		Если РезультатВызова.Статусы.Пенсионер Тогда
			ПокупательПенсионер = Истина;
			РассчитатьСкидкуПенсионерам(Неопределено);
		Иначе
			ТекстЗаголовка = НСтр("ru = 'Проверка статуса пенсионера MAX.'");
			ТекстОшибки = НСтр("ru = 'Статус пенсионера не подтвержден в мессенджере MAX. Скидка не будет применена.'");
			ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстОшибки, ТекстЗаголовка);
			ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
			Если ДополнительныеПараметры = Неопределено Тогда
				ДополнительныеПараметры = Новый Структура("ОткрытьФормуПереходаКОплате",
					ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера);
			Иначе
				ДополнительныеПараметры.Вставить("ОткрытьФормуПереходаКОплате",
					ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера);
			КонецЕсли;
			ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки, ДополнительныеПараметры);
		КонецЕсли;
	ИначеЕсли РезультатВызова.Результат = ТипыРезультатаПроверки.ПозватьСотрудника Тогда
		ОткрытьПодтверждениеСтатусаПокупателя(Ложь, Истина);
	ИначеЕсли РезультатВызова.Результат = ТипыРезультатаПроверки.Ошибка Тогда
		ТекстЗаголовка = НСтр("ru = 'Проверка статуса пенсионера MAX.'");
		ТекстОшибки = РезультатВызова.ОписаниеОшибки;
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстОшибки, ТекстЗаголовка);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = РезультатВызова.КодОтвета = 404;
		Если ДополнительныеПараметры = Неопределено Тогда
			ДополнительныеПараметры = Новый Структура("ОткрытьФормуПереходаКОплате",
				ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера);
		Иначе
			ДополнительныеПараметры.Вставить("ОткрытьФормуПереходаКОплате",
				ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера);
		КонецЕсли;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки, ДополнительныеПараметры);
	КонецЕсли;
	ОбновитьИнформациюНаДисплееПокупателя(ТипыОперацийДисплеяПокупателя.СписокТоваров);
	
	Если ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера
		И РезультатВызова.Результат = ТипыРезультатаПроверки.Отмена Тогда
		ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВнешнийРасчетСкидкиПенсионера(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ НЕ ДополнительныеПараметры.Свойство("ОбратноеОповещение") Тогда
		Возврат;
	КонецЕсли;
	
	РассчитатьСкидкуПенсионерам(ДополнительныеПараметры.ОбратноеОповещение);
	
КонецПроцедуры

#КонецОбласти

#Область СообщениеОбОшибке
&НаКлиенте
Процедура ОткрытьФормуСообщенияОбОшибке(ПараметрыДляОткрытия, ДополнительныеПараметры = Неопределено)
	
	Если Не ПодчиненнаяФормаОжиданияПроверкиМарок = Неопределено И ПодчиненнаяФормаОжиданияПроверкиМарок.Открыта() Тогда
		ПодчиненнаяФормаОжиданияПроверкиМарок.Закрыть();
		ПодчиненнаяФормаОжиданияПроверкиМарок = Неопределено;
	КонецЕсли;
	
	Если УправлениеФормойПередано Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры <> Неопределено
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДополнительныеПараметры, "ОбработкаОповещения") Тогда
		ОбработкаОповещения = ДополнительныеПараметры.ОбработкаОповещения;
	Иначе
		ОбработкаОповещения = Новый ОписаниеОповещения("ЗакрытиеСообщенияОбОшибке", ЭтотОбъект, ДополнительныеПараметры);
	КонецЕсли;
	УправлениеФормойПередано = Истина;
	
	Если ОткрытаСтраницаПоискаТовара() Тогда
		ЗакрытьПоискТоваровКлиент();
	КонецЕсли;
	
	ОчиститьОчередьШтрихкодов();
	
	ПараметрыДляОткрытия.Вставить("РежимКассыСамообслуживания", РежимКассыСамообслуживания);
	ПараметрыДляОткрытия.Вставить("УвеличенныйВариантМасштаба", УвеличенныйВариантМасштаба);
	ИнтерфейсРМКСлужебныйКлиент.ОткрытьФормуСообщенияОбОшибке(ЭтотОбъект, ПараметрыДляОткрытия, ОбработкаОповещения);
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьПараметрыБаннера()
	ПараметрыБаннера = Новый Структура;
	ПараметрыБаннера.Вставить("ЗаголовокБаннера", "");
	ПараметрыБаннера.Вставить("ТекстБаннера", "");
	ПараметрыБаннера.Вставить("БаннерОшибка", Ложь);
	ПараметрыБаннера.Вставить("БаннерПредупреждение", Ложь);
	ПараметрыБаннера.Вставить("БаннерИнформация", Ложь);
	ПараметрыБаннера.Вставить("БаннерУспех", Ложь);
	ПараметрыБаннера.Вставить("Скрываемый", Истина);
	ПараметрыБаннера.Вставить("ОтображатьКомандуДобавитьБезМарки", Ложь);
	ПараметрыБаннера.Вставить("ОтображатьВыборКодаМаркировки", Ложь);
	ПараметрыБаннера.Вставить("БаннерОжиданияМарки", Ложь);
	Возврат ПараметрыБаннера;
КонецФункции

&НаКлиенте
Процедура ОткрытьБаннер(ПараметрыБаннера)
	
	Если ОткрытаСтраницаПоискаТовара() Тогда
		ЗакрытьПоискТоваровКлиент();
	КонецЕсли;
	
	Если Не Элементы.СтраницаБаннер.Видимость Тогда
		УстановитьВидимостьЭлементаФормы(Элементы.СтраницаБаннер, Истина);
	КонецЕсли;
	Элементы.СтраницыУправленияВерх.ТекущаяСтраница = Элементы.СтраницаБаннер;

	Если ПараметрыБаннера.БаннерПредупреждение Тогда
		ИмяПараметра = НСтр("ru = 'Предупреждение'");
	ИначеЕсли ПараметрыБаннера.БаннерИнформация Тогда
		ИмяПараметра = НСтр("ru = 'Информация'");
	ИначеЕсли ПараметрыБаннера.БаннерУспех Тогда
		ИмяПараметра = НСтр("ru = 'Успех'");
	Иначе
		ИмяПараметра = НСтр("ru = 'Ошибка'");
	КонецЕсли;
	
	ИмяТекстаБаннера = СтрШаблон(НСтр("ru = 'ТекстБаннера%1'"), ИмяПараметра);
	ИмяЗаголовокБаннера = СтрШаблон(НСтр("ru = 'ЗаголовокБаннера%1'"), ИмяПараметра);
	ИмяСтраницаБаннера = СтрШаблон(НСтр("ru = 'СтраницаБаннер%1'"), ИмяПараметра);
	ИмяЗкрытьБаннер = СтрШаблон(НСтр("ru = 'ЗакрытьБаннер%1'"), ИмяПараметра);
	
	Элементы.СтраницыБаннеры.ТекущаяСтраница = Элементы[ИмяСтраницаБаннера];
	
	Если ЗначениеЗаполнено(ПараметрыБаннера.ЗаголовокБаннера) Тогда
		УстановитьВидимостьЭлементаФормы(Элементы[ИмяЗаголовокБаннера], Истина);
		Элементы[ИмяЗаголовокБаннера].Заголовок = ПараметрыБаннера.ЗаголовокБаннера;
	Иначе
		УстановитьВидимостьЭлементаФормы(Элементы[ИмяЗаголовокБаннера], Ложь);
	КонецЕсли;
	Элементы[ИмяТекстаБаннера].Заголовок = ПараметрыБаннера.ТекстБаннера;
	
	УстановитьВидимостьЭлементаФормы(Элементы[ИмяЗкрытьБаннер], ПараметрыБаннера.Скрываемый);
	
	УстановитьВидимостьЭлементаФормы(Элементы.ГруппаДобавитьБезМарки,
		ПараметрыБаннера.ОтображатьКомандуДобавитьБезМарки);
		
	УстановитьВидимостьЭлементаФормы(Элементы.ГруппаВыбратьКодМаркировки,
		ПараметрыБаннера.ОтображатьВыборКодаМаркировки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьБаннерНажатие(Элемент)
	ЗакрытьБаннерПриНеобходимости();
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьБаннерПриНеобходимости()
	ИмяЭлемента = Элементы.СтраницыБаннеры.ТекущаяСтраница.Имя;
	Если ОткрытаСтраницаБаннер() Тогда
		ИмяПараметра = СтрЗаменить(ИмяЭлемента, "СтраницаБаннер", НСтр("ru = ''"));
		ИмяЗаголовокБаннера = СтрШаблон(НСтр("ru = 'ЗаголовокБаннера%1'"), ИмяПараметра);
		ИмяТекстБаннера = СтрШаблон(НСтр("ru = 'ТекстБаннера%1'"), ИмяПараметра);
		
		Элементы[ИмяЗаголовокБаннера].Заголовок = НСтр("ru = ''");
		Элементы[ИмяТекстБаннера].Заголовок = НСтр("ru = ''");
		Если РежимКассыСамообслуживания Тогда
			УстановитьВидимостьЭлементаФормы(Элементы.СтраницаБаннер, Ложь);
			Элементы.СтраницыУправленияВерх.ТекущаяСтраница = Элементы.СтраницаУправленияЛояльностьюКСО;
		Иначе
			Элементы.СтраницыУправленияВерх.ТекущаяСтраница = Элементы.СтраницаУправленияЛояльностью;
		КонецЕсли;
		
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаДобавитьБезМарки, Ложь);
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаВыбратьКодМаркировки, Ложь);
		
		ПоказыватьГруппуСкидок = ИспользоватьАвтоматическиеСкидки Или МаксимальныйПроцентРучнойНаценки > 0
			Или МаксимальныйПроцентРучнойСкидки > 0;
			
		Если НЕ ПоказыватьГруппуСкидок Тогда
			УстановитьВидимостьЭлементаФормы(Элементы.СтраницыБаннеры, Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОткрытаСтраницаБаннер()
	Возврат Элементы.СтраницыУправленияВерх.ТекущаяСтраница = Элементы.СтраницаБаннер;
КонецФункции

#КонецОбласти

#Область ВыдачаПодарков
&НаКлиенте
Процедура ВыдатьПодарок()

	Доступность = Истина;
	Если ТаблицаПодаркиБезВыбора.Количество() = 0 Тогда
		Если ТаблицаПодарков.Количество() = 0 Тогда
			ВыполнитьОтложенныйМетод();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ЭтоВозвратПродажи = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	ДополнительныеПараметры = Неопределено;
	Если РежимРаботыСЧеком = РежимыРаботыСЧеком.ВозвратКоррекция Или (ЭтоВозвратПродажи И ОжидатьВводМарки) Тогда
		ДополнительныеПараметры = Новый Структура();
	КонецЕсли;
	ОткрытьФормуВыдачиПодарка(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборПодарка(Результат, ДополнительныеПараметры) Экспорт
	
	СтрокаТаблицы = ДополнительныеПараметры.СтрокаПодарок;
	Если Результат = КодВозвратаДиалога.Да Тогда
		ТекущийВладелецПодарка = СтрокаТаблицы.ВладелецПодарка;
		ОбработатьВыдачуПодарка(СтрокаТаблицы);
	КонецЕсли;
	ИдентификаторСтрокиПодарка = СтрокаТаблицы.ПолучитьИдентификатор();
	Если ТаблицаПодаркиБезВыбора.НайтиПоИдентификатору(ИдентификаторСтрокиПодарка) <> Неопределено Тогда
		ТаблицаПодаркиБезВыбора.Удалить(СтрокаТаблицы);
	КонецЕсли;
	ПерезаполнитьТаблицуСкидок();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыдачуПодарка(СтрокаТаблицы)
	СтруктураВыбора = ПодготовитьДанныеВыбораНоменклатуры(СтрокаТаблицы.Номенклатура);
	СтруктураВыбора.Вставить("Количество");
	СтруктураВыбора.Вставить("КоличествоУпаковок");
	СтруктураВыбора.Вставить("ВладелецПодарка");
	СтруктураВыбора.Вставить("ОбластьПредоставленияДокумент");
	СтруктураВыбора.Вставить("ВыводитьПодарокВЧек");
	СтруктураВыбора.Вставить("ВладелецПодарка");
	СтруктураВыбора.Вставить("МинимальнаяЦена");
	ЗаполнитьЗначенияСвойств(СтруктураВыбора, СтрокаТаблицы,,"Упаковка");
	СтруктураВыбора.Вставить("Подарок", Истина);
	
	СписокТоваровВыборКлиент(СтруктураВыбора);
	КоличествоТоваров = Объект.Товары.Количество();
	Если КоличествоТоваров > 0 Тогда
		ТекущаяСтрока = Объект.Товары[КоличествоТоваров - 1];
		ОбщегоНазначенияРМККлиентСервер.ПересчитатьСуммуВСтроке(ЭтотОбъект, ТекущаяСтрока, ,
			ИспользоватьАвтоматическиеСкидки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьСкидкуНаПодарок(СтрокаТоваров, СуммаСкидки)
	СтрокаТоваров.СуммаАвтоматическойСкидки = СтрокаТоваров.СуммаАвтоматическойСкидки - СуммаСкидки;
	СтрокаТоваров.СуммаАвтоматическойСкидкиЧекаПродажи = СтрокаТоваров.СуммаАвтоматическойСкидкиЧекаПродажи - СуммаСкидки;
	СтрокаТоваров.ПроцентАвтоматическойСкидки = ?(СтрокаТоваров.СуммаБезСкидки = 0, 0, СтрокаТоваров.СуммаАвтоматическойСкидки/СтрокаТоваров.СуммаБезСкидки * 100);
	СтрокаТоваров.ОтображаетсяСкидкаПроцентом = Истина;
	ОбщегоНазначенияРМККлиентСервер.ПересчитатьСуммуВСтроке(ЭтотОбъект, СтрокаТоваров, , ИспользоватьАвтоматическиеСкидки);
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиПодаркиПриВозврате()
	
	ТаблицаПодаркиБезВыбора.Очистить();
	МассивСтрокКУдалению = Новый Массив;
	Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
		Если НЕ СтрокаТаблицы.Подарок Тогда
			Если СтрокаТаблицы.СуммаАвтоматическойСкидки <> 0 Тогда
				ОтменитьСкидкуНаПодарок(СтрокаТаблицы, СтрокаТаблицы.СуммаСкидкиПодарок);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		МассивСтрокКУдалению.Добавить(СтрокаТаблицы);
		НоваяСтрока = ТаблицаПодаркиБезВыбора.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
		НоваяСтрока.ВладелецПодарка = СтрокаТаблицы.ИдентификаторСтроки;
	КонецЦикла;
	
	Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
		Объект.Товары.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьПодарки()
	
	Если ТаблицаПодарков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрокКУдалению = Новый Массив;
	
	КоличествоТоваров = Объект.Товары.Количество();
	Если КоличествоТоваров > 0 Тогда
		Продавец = Объект.Товары[КоличествоТоваров - 1].Продавец;
	КонецЕсли;
	
	ОтборПодаркиНаВыбор = Новый Структура("ВыборИзСписка, ОтказОтВыдачиПодарка", Истина, Ложь);
	СтрокиПодаркаНаВыбор = ТаблицаПодарков.НайтиСтроки(ОтборПодаркиНаВыбор);;
	ТаблицаПодаркиНаВыбор.Загрузить(ТаблицаПодарков.Выгрузить(СтрокиПодаркаНаВыбор));
	Для Каждого СтрокаКУдалению Из СтрокиПодаркаНаВыбор Цикл
		ТаблицаПодарков.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	ОтборПодаркиБезВыбора = Новый Структура("ВыборИзСписка, ОтказОтВыдачиПодарка", Ложь, Ложь);
	СтрокиПодаркаБезВыбора = ТаблицаПодарков.НайтиСтроки(ОтборПодаркиБезВыбора);;
	ТаблицаПодаркиБезВыбора.Загрузить(ТаблицаПодарков.Выгрузить(СтрокиПодаркаБезВыбора));
	Для Каждого СтрокаКУдалению Из СтрокиПодаркаБезВыбора Цикл
		ТаблицаПодарков.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ОтображатьСкидкиВЧеке(ЭтоОперацияПродажа, ЭтоОперацияВозврат)
	
	РезультатФункции = Истина;
	Если ЭтоОперацияПродажа Тогда
		РезультатФункции = ВключеноИспользованиеАвтоматическихСкидок
			Или (ДопускаетсяПрименениеСкидок И Не РежимКассыСамообслуживания);
	ИначеЕсли ЭтоОперацияВозврат Тогда
		РезультатФункции = ИспользоватьАвтоматическиеСкидкиПриВозврате
			Или ДопускаетсяПрименениеСкидок Или ВЧекеПрисутствуетСкидка();
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Функция ВЧекеПрисутствуетСкидка()
	
	РезультатФункции = Ложь;
	КоличествоСтрок = Объект.Товары.Количество();
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоСтрок И Не РезультатФункции Цикл
		СтрокаТовара = Объект.Товары.Получить(ИндексСтроки);
		Если Не СтрокаТовара.СуммаСкидокОбщая = 0 Тогда
			РезультатФункции = Истина;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти

#Область КомандыНастройкиКаталога

&НаКлиенте
Процедура НастройкаКаталогаОткрытьНастройки(Команда)
	Элементы.ГруппаНастройкиКаталогаВсплывающая.Показать();
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаЗакрыть(Команда)
	Элементы.ГруппаНастройкиКаталогаВсплывающая.Скрыть();
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаОткрытьРасширеннуюФорму(Команда)
	
	ЗакрытьПоискТоваровКлиент();
	ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуПодбораТоваров(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаПоУмолчанию(Команда)
	
	НастройкаКаталогаВариантОтображения = 0;
	НастройкаКаталогаОбъединятьПоНоменклатуре = Ложь;
	НастройкаКаталогаПоказыватьПозицииБезЦен = Ложь;
	НастройкаКаталогаПоказыватьНеактуальные = Ложь;
	
	НастроитьВКаталогеОтображениеПозицийБезЦен();
	НастроитьВКаталогеОтображениеНеактуальныхПозиций();
	НастроитьОтображениеКаталога();
	НастройкаКаталогаВключитьВидимостьВсехПолей();
	НастройкаКаталогаОтключитьВидимостьДополнительныхПолей();
	НастройкаКаталогаВключитьВсеПоляПоиска();
	ВосстановитьПорядокКолонокКаталога();
	СброситьНастройкиОтбораКаталога();
	
	ИменаСтраниц = Новый Массив;
	ИменаСтраниц.Добавить("ИспользоватьПоискПоСтроке");
	ИменаСтраниц.Добавить("Видимость");
	
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		ИмяПоляКаталога = СтрокаПоля.ИмяПоля;
		Для Каждого ИмяСтраницы Из ИменаСтраниц Цикл
			ИмяРеквизита = "НастройкаКаталога" + ИмяСтраницы + "_" + ИмяПоляКаталога;
			ЭтотОбъект[ИмяРеквизита] = СтрокаПоля[ИмяСтраницы];
		КонецЦикла;
	КонецЦикла;
	
	ЗакрытьНастройкиКаталога();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаПерейтиВГруппуНоменклатуры(Команда)
	
	ТекущиеДанныеСпискаТоваров = Элементы.СписокТоваров.ТекущиеДанные;
	Если ТекущиеДанныеСпискаТоваров = Неопределено Тогда
		ЗакрытьНастройкиКаталога();
		Возврат;
	КонецЕсли;
	
	Элементы.ОтборГруппа.ТекущаяСтрока = ТекущиеДанныеСпискаТоваров.Родитель;
	Элементы.ОтборКатегория.ТекущаяСтрока = ТекущиеДанныеСпискаТоваров.ВидНоменклатуры;
	ЗакрытьНастройкиКаталога();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаСброситьОтбор(Команда)
	СброситьНастройкиОтбораКаталога();
КонецПроцедуры

&НаКлиенте
Процедура КомандаНастройкаКаталогаПорядок(Команда)
	
	НомерПоля = СтрЗаменить(Команда.Имя, "НастройкаКаталогаПорядок_", "");
	Направление = ?(Сред(НомерПоля, 2) = "Вниз", 1, -1);
	НомерПоля = Лев(НомерПоля, 1);
	СтруктураОтбора = Новый Структура("Порядок", Число(НомерПоля));
	СтрокиПолей = НастройкаКаталогаНастройкиПолей.НайтиСтроки(СтруктураОтбора);
	
	Если СтрокиПолей.Количество() > 0 Тогда
		СтрокаПоля = СтрокиПолей[0];
		ИмяПоля = СтрокаПоля.ИмяПоля;
		ТекущееЗначение = СтрокаПоля["Порядок"];
		НастройкаКаталогаНастройкиПолей.Сдвинуть(ТекущееЗначение, Направление);
		ОбновитьНаименованиеКнопокПолейНастроекКаталога();
	КонецЕсли;
	
	РасставитьКолонкиКаталога();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаКаталогаВыключательПоляПриИзменении(Элемент)
	
	ИменаСтраниц = Новый Массив;
	ИменаСтраниц.Добавить("ИспользоватьПоискПоСтроке");
	ИменаСтраниц.Добавить("Видимость");
	
	Для Каждого СтрокаПоля Из НастройкаКаталогаНастройкиПолей Цикл
		ИмяПоляКаталога = СтрокаПоля.ИмяПоля;
		Для Каждого ИмяСтраницы Из ИменаСтраниц Цикл
			ИмяРеквизита = "НастройкаКаталога" + ИмяСтраницы + "_" + ИмяПоляКаталога;
			СтрокаПоля[ИмяСтраницы] = ЭтотОбъект[ИмяРеквизита];
		КонецЦикла;
	КонецЦикла;
	
	НомерПоля = СтрЗаменить(Элемент.Имя,"НастройкаКаталога", "");
	ИмяПоляИНастройка = СтрРазделить(НомерПоля, "_");
	
	СтруктураОтбора = Новый Структура("ИмяПоля", ИмяПоляИНастройка[1]);
	СтрокиПолей = НастройкаКаталогаНастройкиПолей.НайтиСтроки(СтруктураОтбора);
	Если СтрокиПолей.Количество() > 0 Тогда
		СтрокаПоля = СтрокиПолей[0];
		ИмяПоля = СтрокаПоля.ИмяПоля;
		ИмяНастройки = ИмяПоляИНастройка[0];
		
		ТекущееЗначение = СтрокаПоля[ИмяНастройки];
		ИменаПолей = Новый Массив;
		ИменаПолей.Добавить(ИмяПоля);
		Если ИмяНастройки = "Видимость" Тогда
			НастроитьВидимостьПолейКаталога(ИменаПолей, СтрокаПоля.Видимость);
			Если СтрокаПоля.ИспользоватьПоискПоСтроке Тогда
				НастроитьИспользованиеПоискаПолейКаталога(ИменаПолей, СтрокаПоля.Видимость);
			КонецЕсли;
		ИначеЕсли ИмяНастройки = "ИспользоватьПоискПоСтроке" Тогда
			НастроитьИспользованиеПоискаПолейКаталога(ИменаПолей, СтрокаПоля.ИспользоватьПоискПоСтроке);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

