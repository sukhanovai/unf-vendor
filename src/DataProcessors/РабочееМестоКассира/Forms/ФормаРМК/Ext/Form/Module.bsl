&НаКлиенте
Функция ПараметрыЗапускаЗаполнитьУправляемыеСкидкиФоновое()
	
	ТаблицаУправляемыхСкидок.Очистить();
	Если Не ИспользоватьАвтоматическиеСкидки Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначенияПараметровМетода = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыМетодаЗаполненияУправляемыхСкидок();
	СтруктураПараметровУправляемыхСкидок = Новый Структура;
	СтруктураПараметровУправляемыхСкидок.Вставить("МаксимальныйПроцентРучнойСкидки", МаксимальныйПроцентРучнойСкидки);
	СтруктураПараметровУправляемыхСкидок.Вставить("МаксимальныйПроцентРучнойНаценки", МаксимальныйПроцентРучнойНаценки);
	СтруктураПараметровУправляемыхСкидок.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
	СтруктураПараметровУправляемыхСкидок.Вставить("Контрагент", Объект.Контрагент);
	СтруктураПараметровУправляемыхСкидок.Вставить("ДисконтнаяКарта", Объект.ДисконтнаяКарта);
	СтруктураПараметровУправляемыхСкидок.Вставить("ДопускаетсяПрименениеСкидок", ДопускаетсяПрименениеСкидок);
	СтруктураПараметровУправляемыхСкидок.Вставить("НайденнаяКартаНомер", НайденнаяКартаНомер);
	
	ЗаполнитьПараметрыУправляемыеСкидки(ЗначенияПараметровМетода, СтруктураПараметровУправляемыхСкидок);
		
	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("ПараметрыПодключенияКСерверуЛояльности", ПараметрыПодключенияКСерверуЛояльности);
	ПараметрыЗапуска.Вставить("ЗначенияПараметровМетода", ЗначенияПараметровМетода);
	
	СтруктураПараметровВыполнения = Новый Структура;
	СтруктураПараметровВыполнения.Вставить("ВыполняемыйМетод", "ОбщегоНазначенияРМК.ПолучитьУправляемыеСкидки");
	СтруктураПараметровВыполнения.Вставить("НаименованиеФоновогоЗадания", НСтр("ru = 'Заполнение таблицы управляемых скидок'"));
	ДополнительныеПараметры = Новый Структура("ИмяОтложенногоМетода", "ОбработатьРезультатПолученияУправляемыхСкидок");
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьДанныеССервераЛояльности", ЭтотОбъект, ДополнительныеПараметры);
	СтруктураПараметровВыполнения.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);

	Возврат Новый Структура("ПараметрыЗапуска, СтруктураПараметровВыполнения", ПараметрыЗапуска, СтруктураПараметровВыполнения);
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатПолученияУправляемыхСкидок(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВыполнения.ЕстьОшибки Тогда
		НеобходимоПерезаполнитьТаблицуУправляемыхСкидок = Ложь;
		СтрокаJSON = РезультатВыполнения.ДанныеОтвета;
		ДанныеОтвета = Неопределено;
		Если СтрокаJSON <> Неопределено Тогда
			
			СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаJSON, ДанныеОтвета);
			
			Если ДанныеОтвета <> Неопределено И ТипЗнч(ДанныеОтвета) = Тип("Массив") Тогда
				Для каждого СтрокаМассива Из ДанныеОтвета Цикл
					НоваяСтрока = ТаблицаУправляемыхСкидок.Добавить();
					
					Если СтрокаМассива.Свойство("DiscountValue") Тогда
						
						НоваяСтрока.ЗначениеСкидки = СтрокаМассива.DiscountValue;
						НоваяСтрока.Представление = СтрокаМассива.DiscountDescription;
						НоваяСтрока.ТипСкидки = СтрокаМассива.DiscoutType;
						НоваяСтрока.ОбластьДействия = СтрокаМассива.ApplicationArea;
						НоваяСтрока.ИдентификаторСкидки = СтрокаМассива.DiscountID;
						НоваяСтрока.СкидкаНаценка = СтрокаМассива.DiscountRef;
						
						Если ЕстьСвойство(СтрокаМассива, "Return") Тогда
							НоваяСтрока.ПриВозврате = СтрокаМассива.Return;
						КонецЕсли;
						Если ЕстьСвойство(СтрокаМассива, "Bonuses") Тогда
							НоваяСтрока.ЭтоПравилоНачисленияБонусов = СтрокаМассива.Bonuses;
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(НоваяСтрока.СкидкаНаценка) Тогда
							ЗаполнитьЗначениеСкидкиНаценки(НоваяСтрока.СкидкаНаценка, СтрокаМассива);
						КонецЕсли;
						
					Иначе
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМассива);
						Если НЕ ЗначениеЗаполнено(НоваяСтрока.СкидкаНаценка) Тогда
							ЗаполнитьЗначениеСкидкиНаценки(НоваяСтрока.СкидкаНаценка, СтрокаМассива);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
		
КонецПроцедуры

&НаКлиенте
Функция ПараметрыЗапускаЗаполнитьТаблицуСотрудниковФоновое()
	
	ТаблицаСотрудников.Очистить();
	ВыборПродавцаИзСписка = ИспользоватьСерверЛояльностиПолучательДанных И НеИспользоватьПродавцов;
	Если НЕ ВыборПродавцаИзСписка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураПараметровЗапросаСотрудников = ПолучитьСтруктуруПараметровЗапросаСотрудников();
		
	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("ПараметрыПодключенияКСерверуЛояльности", ПараметрыПодключенияКСерверуЛояльности);
	ПараметрыЗапуска.Вставить("ЗначенияПараметровМетода", СтруктураПараметровЗапросаСотрудников);
			
	СтруктураПараметровВыполнения = Новый Структура;
	СтруктураПараметровВыполнения.Вставить("ВыполняемыйМетод", "ОбщегоНазначенияРМК.ПолучитьСписокСотрудников");
	СтруктураПараметровВыполнения.Вставить("НаименованиеФоновогоЗадания", НСтр("ru = 'Заполнение таблицы сотрудников'"));
	ДополнительныеПараметры = Новый Структура("ИмяОтложенногоМетода", "ОбработатьРезультатПолученияТаблицыСотрудников");
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьДанныеССервераЛояльности", ЭтотОбъект, ДополнительныеПараметры);
	СтруктураПараметровВыполнения.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);

	Возврат Новый Структура("ПараметрыЗапуска, СтруктураПараметровВыполнения", ПараметрыЗапуска, СтруктураПараметровВыполнения);
КонецФункции

&НаКлиенте
Функция ПараметрыЗапускаЗаполнитьВидыДисконтныхКартФоновое()
	
	ТаблицаВидыКарт.Очистить();
	Если Не ИспользоватьДисконтныеКарты Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначениеПараметровВидовКарт = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыМетодаЗаполненияВидовКарт();
	ЗаполнитьПараметрыВидовКарт(ЗначениеПараметровВидовКарт, Объект.ТорговыйОбъект);
		
	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("ПараметрыПодключенияКСерверуЛояльности", ПараметрыПодключенияКСерверуЛояльности);
	ПараметрыЗапуска.Вставить("ЗначенияПараметровМетода", ЗначениеПараметровВидовКарт);
	
	СтруктураПараметровВыполнения = Новый Структура;
	СтруктураПараметровВыполнения.Вставить("ВыполняемыйМетод", "ОбщегоНазначенияРМК.ПолучитьСписокВидовКарт");
	СтруктураПараметровВыполнения.Вставить("НаименованиеФоновогоЗадания", НСтр("ru = 'Заполнение списка видов дисконтных карт'"));
	ДополнительныеПараметры = Новый Структура("ИмяОтложенногоМетода", "ОбработатьРезультатПолученияСпискаВидовКарт");
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьДанныеССервераЛояльности", ЭтотОбъект, ДополнительныеПараметры);
	СтруктураПараметровВыполнения.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);

	Возврат Новый Структура("ПараметрыЗапуска, СтруктураПараметровВыполнения", ПараметрыЗапуска, СтруктураПараметровВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатПолученияСпискаВидовКарт(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Свойство("ЕстьОшибки")
		И НЕ РезультатВыполнения.ЕстьОшибки Тогда
		СтрокаJSON = РезультатВыполнения.ДанныеОтвета;
		ДанныеОтвета = Неопределено;
		Если СтрокаJSON <> Неопределено Тогда
			СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаJSON, ДанныеОтвета);
			Если ДанныеОтвета <> Неопределено И ТипЗнч(ДанныеОтвета) = Тип("Массив") Тогда
				Для каждого СтрокаМассива Из ДанныеОтвета Цикл
					ВидКарты = ТаблицаВидыКарт.Добавить();
					
					Если СтрокаМассива.Свойство("CardTypeID") Тогда
						ВидКарты.Идентификатор = СтрокаМассива.CardTypeID;
						ВидКарты.Наименование = СтрокаМассива.CardTypeDescription;
						ВидКарты.ЭтоИменнаяКарта = СтрокаМассива.IsPerson;
						Если СтрокаМассива.Свойство("GenerateNumer") Тогда
							ВидКарты.ГенерироватьНомер = СтрокаМассива.GenerateNumer;
						КонецЕсли;
						Если СтрокаМассива.Свойство("NumberToPhone") Тогда
							ВидКарты.ПрисваиватьНомерКартыКНомеруТелефона = СтрокаМассива.NumberToPhone;
						КонецЕсли;
						Если СтрокаМассива.Свойство("TemplateRepresentation") Тогда
							ВидКарты.ПредставлениеШаблона = СтрокаМассива.TemplateRepresentation;
						КонецЕсли;
						Если СтрокаМассива.Свойство("LengthRange") Тогда
							ВидКарты.НачалоДиапазона = СтрокаМассива.BeginRange;
							ВидКарты.КонецДиапазона = СтрокаМассива.EndRange;
							ВидКарты.ДлинаДиапазона = СтрокаМассива.LengthRange;
						КонецЕсли;
					Иначе
						ЗаполнитьЗначенияСвойств(ВидКарты, СтрокаМассива);
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатПолученияТаблицыСотрудников(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВыполнения.ЕстьОшибки Тогда
		СтрокаJSON = РезультатВыполнения.ДанныеОтвета;
		ДанныеОтвета = Неопределено;
		Если СтрокаJSON <> Неопределено Тогда
			СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаJSON, ДанныеОтвета);
			Если ДанныеОтвета <> Неопределено И ТипЗнч(ДанныеОтвета) = Тип("Массив") Тогда
				Для Каждого СтрокаМассива Из ДанныеОтвета Цикл
					НоваяСтрока = ТаблицаСотрудников.Добавить();
					НоваяСтрока.СотрудникПредставление = СтрокаМассива.EmployeeDescription;
					НоваяСтрока.ИдентификаторСотрудника = СтрокаМассива.EmployeeID;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПараметрыЗапускаЗаполнитьСписокСкидокЗависящихОтВидаОплатФоновое()
	
	Если Не ИспользоватьАвтоматическиеСкидки Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("ПараметрыПодключенияКСерверуЛояльности", ПараметрыПодключенияКСерверуЛояльности);
	ПараметрыЗапуска.Вставить("ЗначенияПараметровМетода", Неопределено);
	
	СтруктураПараметровВыполнения = Новый Структура;
	СтруктураПараметровВыполнения.Вставить("ВыполняемыйМетод", "ОбщегоНазначенияРМК.ПолучитьСписокСкидокПоВидуОплаты");
	СтруктураПараметровВыполнения.Вставить("НаименованиеФоновогоЗадания", НСтр("ru = 'Заполнение списка скидок, зависявших от вида оплат'"));
	ДополнительныеПараметры = Новый Структура("ИмяОтложенногоМетода", "ОбработатьРезультатПолученияСпискаСкидокПоВидуОплаты");
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьДанныеССервераЛояльности", ЭтотОбъект, ДополнительныеПараметры);
	СтруктураПараметровВыполнения.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Возврат Новый Структура("ПараметрыЗапуска, СтруктураПараметровВыполнения", ПараметрыЗапуска, СтруктураПараметровВыполнения);
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатПолученияСпискаСкидокПоВидуОплаты(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Свойство("ЕстьОшибки")
		И НЕ РезультатВыполнения.ЕстьОшибки Тогда
		СтрокаJSON = РезультатВыполнения.ДанныеОтвета;
		ДанныеОтвета = Неопределено;
		Если СтрокаJSON <> Неопределено Тогда
			СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаJSON, ДанныеОтвета);
			Если ДанныеОтвета <> Неопределено И ТипЗнч(ДанныеОтвета) = Тип("Массив") Тогда
				Для Каждого СтрокаМассива Из ДанныеОтвета Цикл
					СтрокаСкидки = ТаблицаСкидокЗависяшихОтВидаОплаты.Добавить();
					СтрокаСкидки.СкидкаНаценка = СтрокаМассива.DiscountID;
					Если НЕ ЗначениеЗаполнено(СтрокаСкидки.СкидкаНаценка) Тогда
						ЗаполнитьЗначениеСкидкиНаценки(СтрокаСкидки.СкидкаНаценка, СтрокаМассива);
					КонецЕсли;
					ЗаполнитьВидОплаты(СтрокаСкидки.ВидОплаты, СтрокаМассива.PayType);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыЗапускаОбновитьДаннныеЗапретовПродажФоновое()
	
	Если Не ИспользоватьКонтрольПродаж Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначенияПараметровМетода = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыМетодовБонуснойПодсистемы();
	Если ЗначениеЗаполнено(Объект.ТорговыйОбъект) Тогда
		ЗначенияПараметровМетода.Вставить("Store", Строка(Объект.ТорговыйОбъект.УникальныйИдентификатор()));
	КонецЕсли;
	
	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("ПараметрыПодключенияКСерверуЛояльности", ПараметрыПодключенияКСерверуЛояльности);
	ПараметрыЗапуска.Вставить("ЗначенияПараметровМетода", ЗначенияПараметровМетода);
	
	СтруктураПараметровВыполнения = Новый Структура;
	СтруктураПараметровВыполнения.Вставить("ВыполняемыйМетод", "ОбщегоНазначенияРМК.ПолучитьДанныеЗапретовРедактирования");
	СтруктураПараметровВыполнения.Вставить("НаименованиеФоновогоЗадания", НСтр("ru = 'Выполняется обновление данных контроля продаж.'"));
	ДополнительныеПараметры = Новый Структура("ИмяОтложенногоМетода", "ОбработатьРезультатПолученияКонтроляПродаж");
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьДанныеССервераЛояльности", ЭтотОбъект, ДополнительныеПараметры);
	СтруктураПараметровВыполнения.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	
	Возврат Новый Структура("ПараметрыЗапуска, СтруктураПараметровВыполнения", ПараметрыЗапуска, СтруктураПараметровВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатПолученияКонтроляПродаж(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("ПризнакУспешноОбновлен", Ложь);
	Результат.Вставить("КомментарийКОбновлениюПризнака", НСтр("ru = ''"));
	Результат.Вставить("ЗапретыПродажУспешноЗагружены", Ложь);
	Результат.Вставить("КомментарийОбновленияЗапретов", НСтр("ru = ''"));
	
	
	Если Не РезультатВыполнения.ЕстьОшибки Тогда
		
		ДанныеОтвета = Неопределено;
		СтрокаJSON = РезультатВыполнения.ДанныеОтвета;
		СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаJSON, ДанныеОтвета);
		
		РезультатОбработки = ОбщегоНазначенияРМКВызовСервера.ОбработатьДанныеЗапретовИзОтвета(ДанныеОтвета, ТекущаяНастройкаРМК, Объект.ТорговыйОбъект);
		ЗаполнитьЗначенияСвойств(Результат, РезультатОбработки);
		
	КонецЕсли;
	
		
	Если НЕ Результат.ПризнакУспешноОбновлен Тогда
			
		ПричинаНевозможностиОбновленияПризнака = НСтр("ru = 'Признак разрешения редактирования не обновлен по причине:'");
		СостояниеОбновленияЗапретовПродаж = СтрШаблон("%1 %2%3",
			ПричинаНевозможностиОбновленияПризнака, Результат.КомментарийКОбновлениюПризнака, Символы.ПС);
			
	КонецЕсли;
		
	Если НЕ Результат.ЗапретыПродажУспешноЗагружены Тогда
			
		ПричинаНевозможностиОбновленияЗапретовПродаж = НСтр("ru = 'Не удалось обновить запреты продаж по причине:'");
		ПричинаНевозможностиОбновленияЗапретовПродажРасширенная = СтрШаблон("%1%2",
			ПричинаНевозможностиОбновленияЗапретовПродаж, Результат.КомментарийОбновленияЗапретов);
		СостояниеОбновленияЗапретовПродаж = СтрШаблон("%1%2%3",
			СостояниеОбновленияЗапретовПродаж, ПричинаНевозможностиОбновленияЗапретовПродажРасширенная, Символы.ПС);
			
	КонецЕсли;

	
	Если НЕ ПустаяСтрока(СостояниеОбновленияЗапретовПродаж) Тогда
		КомментарийКЗаписи = НСтр("ru = 'Данные о запретах продаж не были обновлены.'",
			ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
		
		ИмяСобытия = НСтр("ru = 'Обновление данных запретов о продажах'",
			ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
			
		ОбщегоНазначенияРМКВызовСервера.ЗафиксироватьОшибкуВЖурналеРегистрации(ИмяСобытия, КомментарийКЗаписи);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуПередОжиданием(ИмяСтраницыПередОжиданием)
