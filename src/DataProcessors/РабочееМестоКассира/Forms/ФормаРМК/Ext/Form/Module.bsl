&НаКлиентеНаСервереБезКонтекста
Функция ЧекПоОрганизацииСНОПробит(ТаблицаЧековКПробитию, Организация, СистемаНалогообложения)
	
	Результат = Ложь;
	
	СтруктураОтбора = Новый Структура("Организация, СистемаНалогообложения",
		Организация, СистемаНалогообложения);
	
	ПробитыйЧек = ТаблицаЧековКПробитию.НайтиСтроки(СтруктураОтбора);
	Если ЗначениеЗаполнено(ПробитыйЧек) Тогда
		Результат = ПробитыйЧек[0].Пробит;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ГруппаЧекНажатие(Элемент)
	
	НомерВыбранногоЧека = Число(Сред(Элемент.Имя, 21));
	
	Если ЗначениеЗаполнено(НомерТекущегоЭлементаСпискаЧеков) Тогда
		Если НомерТекущегоЭлементаСпискаЧеков = НомерВыбранногоЧека Тогда
			Возврат;
		КонецЕсли;
		ИмяГруппы = СтрШаблон("%1%2", "ГруппаЧековПоКорзине", НомерТекущегоЭлементаСпискаЧеков);
		ПредыдущаяКарточка = Элементы.Найти(ИмяГруппы);
		Если НЕ ПредыдущаяКарточка = Неопределено Тогда
			
			ПредыдущаяОрганизацияСНО = ТаблицаЧековКПробитию[НомерТекущегоЭлементаСпискаЧеков-1];
			СтруктураОтбора = Новый Структура("Организация, СистемаНалогообложения");
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, ПредыдущаяОрганизацияСНО);
			
			Если ЧекПоОрганизацииСНОПробит(ТаблицаЧековКПробитию, ПредыдущаяОрганизацияСНО.Организация, ПредыдущаяОрганизацияСНО.СистемаНалогообложения) Тогда
				ПредыдущаяКарточка.ЦветФона = ЦветФонаОплаченнойКарточки;
			Иначе
				ПредыдущаяКарточка.ЦветФона = ЦветФонаКарточки;
				ПересчитатьОплатыПоТекущемуЧеку(Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОрганизацияСНО = ТаблицаЧековКПробитию[НомерВыбранногоЧека-1];
	
	Если ПредыдущаяОрганизацияСНО <> Неопределено И ОрганизацияСНО <> Неопределено И
		ПредыдущаяОрганизацияСНО.Организация <> ОрганизацияСНО.Организация Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ВыбранныйВидОплаты") Тогда
			ЭтотОбъект.ВыбранныйВидОплаты = Неопределено;
		Иначе
			ЭквайринговыйТерминалВыполненияОперации = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ОрганизацияСНО.Пробит Тогда
		Элемент.ЦветФона = ЦветФонаВыбраннойОплаченнойКарточки;
	Иначе
		Элемент.ЦветФона = ЦветФонаВыбраннойКарточки;
	КонецЕсли;
	
	ВыбраннаяОрганизация = ОрганизацияСНО.Организация;
	ВыбраннаяСистемаНалогообложения = ОрганизацияСНО.СистемаНалогообложения;
	
	ПереключитьНаСледующийЧек();
	
	Если НомерВыбранногоЧека <> НомерТекущегоЭлементаСпискаЧеков И НЕ РежимТихойОплаты Тогда
		ЭквайринговыйТерминалВыполненияОперации = Неопределено;
		УстановитьВидимостьЭлементаФормы(Элементы.ВыбратьЭквайринговыйТерминал, Ложь);
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаОплатаКартой, Ложь);
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаПодсказкаСкидкаОтВидаОплатаКартой, Истина);
		УстановитьВидимостьЭлементаФормы(Элементы.ОплатаКартой, Истина);
		УстановитьДоступностьЭлементаФормы(Элементы.ОплатаКартой, Истина);
		
		ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОплатаНал);
		ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОплатаСБП);
		ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОплатаЮКасса);
		
	КонецЕсли;
	ОбнулитьСчетчикНажатийКупюр();
	
	НомерТекущегоЭлементаСпискаЧеков = НомерВыбранногоЧека;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИспользованиеНДССверху(Форма, Отказ, ТекстЗаголовка, ТекстСообщения)
	
	ОбщегоНазначенияРМКПереопределяемый.ПроверитьИспользованиеНДССверху(Форма, Отказ, ТекстЗаголовка, ТекстСообщения);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьВозможностьРаботы(Отказ = Ложь)
	
	ПустаяСтрока = НСтр("ru = ''");
	ТекстЗаголовка = ПустаяСтрока;
	ТекстСообщения = ПустаяСтрока;
	ОшибкаЗапуска = ПустаяСтрока;
	ДанныеПроверки = Новый Структура("ТекстЗаголовка,ТекстСообщения,ОшибкаЗапуска", ТекстЗаголовка, ТекстСообщения, ОшибкаЗапуска);
	
	ПроверитьОбщуюВозможностьРаботы(Отказ, ДанныеПроверки);
	Если Отказ Тогда
		ПараметрыОткрытияФормы = Новый Структура();
		ПараметрыОткрытияФормы.Вставить("ТекстЗаголовка", ДанныеПроверки.ТекстЗаголовка);
		ПараметрыОткрытияФормы.Вставить("ТекстСообщения", ДанныеПроверки.ТекстСообщения);
		ПараметрыОткрытияФормы.Вставить("ОшибкаЗапуска", ДанныеПроверки.ОшибкаЗапуска);
		
		ТаблицаКассККМОрганизаций.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКассыККМ(КассаККМ)
	
	ОтборКассыККМ = Новый Структура("КассаККМ", КассаККМ);
	СтрокаКассы = ТаблицаКассККМОрганизаций.НайтиСтроки(ОтборКассыККМ)[0];
	
	ПодключаемоеОборудование = СтрокаКассы.ИдентификаторУстройства;
	КассоваяСмена = СтрокаКассы.КассоваяСмена;
	Объект.Организация = СтрокаКассы.Организация;
	Объект.КассаККМ = СтрокаКассы.КассаККМ;
	ККМПоддерживаетПроверкуКодовМаркировки = СтрокаКассы.ПоддерживаетПроверкуКодовМаркировки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОперациюВыемкаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если ЕстьСвойство(РезультатВыполнения, "Результат") И РезультатВыполнения.Результат Тогда
		
		Если СуммаВыемка = 0 Тогда
			
			Если ЕстьСвойство(РезультатВыполнения, "СуммаВыемка") Тогда
				СуммаВыемка = РезультатВыполнения.СуммаВыемка;
			КонецЕсли;
			
		КонецЕсли;
		
		ОтразитьОстаткиНаличныхДенежныхСредствНаФорме(Объект.Организация, Объект.КассаККМ);
		
		ТекстПояснения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Произведена выемка в размере %1 %2'"), СуммаВыемка, ПредставлениеВалюты);
		ПоказатьОповещениеПользователя(НСтр("ru='Выемка'"), , ТекстПояснения, БиблиотекаКартинок.РМКВыемка);
		
	Иначе
		
		ТекстЗаголовка = НСтр("ru = 'Ошибка выемки.'");
		ТекстОшибки = НСтр("ru='Ошибка выемки'");
		Если ЕстьСвойство(РезультатВыполнения, "ТекстСообщения") Тогда
			ТекстОшибки = РезультатВыполнения.ТекстСообщения;
		КонецЕсли;
		Если ЕстьСвойство(РезультатВыполнения, "ОписаниеОшибки") Тогда
			ТекстОшибки = РезультатВыполнения.ОписаниеОшибки;
		КонецЕсли;
		
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстОшибки, ТекстЗаголовка);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

