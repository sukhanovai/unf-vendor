&НаКлиенте
Процедура ДобавитьСтрокуВТабличнуюЧастьНаКлиенте(Знач ДанныеТовара, Знач НеобходимВводМаркировки = Ложь)
	
	НоваяСтрока = Объект.Товары.Добавить();
	РезультатКонтроляПродаж.СтартКонтроля = ИспользоватьКонтрольПродаж;
	
	Если ДанныеТовара.Свойство("КодыМаркировкиПоДаннымИБ") И ТипЗнч(ДанныеТовара.КодыМаркировкиПоДаннымИБ) = Тип("Массив") Тогда
		Для каждого КодМаркировкиПоДаннымИБ Из ДанныеТовара.КодыМаркировкиПоДаннымИБ Цикл
			НовыйКодМаркировки = НоваяСтрока.КодыМаркировкиПоДаннымИБ.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйКодМаркировки, КодМаркировкиПоДаннымИБ);
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеТовара, , "КодыМаркировкиПоДаннымИБ");
	Иначе
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеТовара);
	КонецЕсли;
	
	Если НЕ ИспользоватьВыборСкладаПриПродаже Тогда
		НоваяСтрока.ТорговыйОбъект = Объект.ТорговыйОбъект;
	КонецЕсли;
	
	Если ДанныеТовара.Свойство("МинимальнаяЦена") Тогда
		НоваяСтрока.МинимальнаяРозничнаяЦена = ДанныеТовара.МинимальнаяРозничнаяЦена;
	КонецЕсли;
	
	Если НоваяСтрока.Подарок Тогда
		КоличествоТоваров = Объект.Товары.Количество();
		Если КоличествоТоваров > 0 Тогда
			СтрокаТаблицы = Объект.Товары[КоличествоТоваров - 2];
			НоваяСтрока.Продавец = СтрокаТаблицы.Продавец;
			НоваяСтрока.ПродавецПредставление = СтрокаТаблицы.ПродавецПредставление;
			НоваяСтрока.ТорговыйОбъект = СтрокаТаблицы.ТорговыйОбъект;
		КонецЕсли;
		СуммаПодарка = НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
		НоваяСтрока.СуммаБезСкидки = СуммаПодарка;
		Если ДанныеТовара.ОбластьПредоставленияДокумент
			И ДанныеТовара.ВыводитьПодарокВЧек Тогда
			СуммаПодарковКРаспределению = СуммаПодарковКРаспределению + СуммаПодарка;
		Иначе
			НоваяСтрока.ПроцентАвтоматическойСкидки = 100;
			НоваяСтрока.СуммаАвтоматическойСкидки = НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
			НоваяСтрока.ОтображаетсяСкидкаПроцентом = Истина;
		КонецЕсли;
	КонецЕсли;
	
	НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	НоваяСтрока.НеобходимостьВводаКодаМаркировки = НеобходимВводМаркировки;
	
	Если ЭтоВнесениеПредоплатыПоЗаказу Или ЭтоОплатаРассрочки Или РежимЗаказа Тогда
		НоваяСтрока.НеобходимостьВводаКодаМаркировки = Ложь;
		НоваяСтрока.ПроверятьЗаполнениеСерий = Ложь;
		Если Не РежимЗаказа Тогда
			НоваяСтрока.НеобходимостьВводаСерии = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если НоваяСтрока.ПоштучноеВыбытие Тогда
		НоваяСтрока.ЧастичноеВыбытиеВариантУчета = ДанныеТовара.ВариантЧастичногоВыбытия;
		НоваяСтрока.ЧастичноеВыбытиеНоменклатура = НоваяСтрока.Номенклатура;
		НоваяСтрока.ЧастичноеВыбытиеХарактеристика = НоваяСтрока.Характеристика;
		Если НоваяСтрока.КоэффициентУпаковки = 0 Тогда
			НоваяСтрока.ЧастичноеВыбытиеКоличество = НоваяСтрока.Количество;
		Иначе
			НоваяСтрока.ЧастичноеВыбытиеКоличество = НоваяСтрока.КоэффициентУпаковки * НоваяСтрока.Количество;
		КонецЕсли;
		ЗаполнитьЧастичноеВыбытиеОстатокПоСтроке(НоваяСтрока, Объект.Товары, ИндексКартинкиПоштучноеВыбытие);
	КонецЕсли;
	
	Отказ = Ложь;
	Если РучноеСопоставлениеТовара И ЗначениеЗаполнено(ДанныеДляРучногоСопоставления) Тогда
		НоваяСтрокаИндекс = НоваяСтрока.НомерСтроки-1;
		ЗаполнитьДанныеРучногоСопоставленияСКлиента(НоваяСтрокаИндекс, Отказ);
	КонецЕсли;
	
	Если РежимКассыСамообслуживания Тогда
		УстановитьДоступностьЭлементаФормы(Элементы.КнопкаПолучитьВесКСО, НоваяСтрока.Весовой);
		Если Не ЗакрыватьПодборПриВыбореТовара Тогда
			УстановитьДоступностьЭлементаФормы(Элементы.КнопкаПолучитьВесВПлиткеКСО, НоваяСтрока.Весовой);
		КонецЕсли;
	Иначе
		УстановитьДоступностьЭлементаФормы(Элементы.ПолучитьВес, НоваяСтрока.Весовой);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		Если НоваяСтрока.НеобходимостьВводаСерии
			И ЗначениеЗаполнено(НоваяСтрока.Серия) Тогда
			НоваяСтрока.СерияПредставление = Строка(НоваяСтрока.Серия);
		КонецЕсли;
			
		ТекущийТоварКоличество = НоваяСтрока.КоличествоУпаковок;
		ТекущийТоварИдентификатор = НоваяСтрока.ПолучитьИдентификатор();
		
		ДоступныРучныеСкидки = ДопускаетсяПрименениеСкидок И (Объект.Товары.Количество() > 0);
		
		Если Не РежимПлитки Тогда
			УстановитьВидимостьЭлементаФормы(Элементы.ГруппаРучнаяСкидкаНаТовар, ДоступныРучныеСкидки);
			УстановитьДоступностьЭлементаФормы(Элементы.СкидкаНаЧек, ДоступныРучныеСкидки);
			УстановитьДоступностьЭлементаФормы(Элементы.УправляемыеСкидки, ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации));
		КонецЕсли;
		
		ДобавленаНоваяСтрокаКорзины = Истина;
		
		Если ОткрытаПустаяСтраница(Элементы) Тогда
			УстановитьСтраницыСДаннымиЧека();
		КонецЕсли;
		Элементы.Товары.ТекущаяСтрока = ТекущийТоварИдентификатор;
		Если Не ЭтоНеИзменяемаяМаркируемаяПродукция(НоваяСтрока) Тогда
			УстановитьТекущийЭлементКоличество(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьКассираКакПродавца Тогда
		ЗаполнитьПродавцаИзКассираНаКлиенте(НоваяСтрока);
	КонецЕсли;
	
	Если ИспользоватьУточненияПринадлежностиЗапасов Тогда
		ЗаполнитьОрганизаюКомитентаПоУточнению(НоваяСтрока);
	КонецЕсли;
	
	Если НоваяСтрока.ПрепаратОтпускаетсяПоДокументу Тогда
		ПроверятьЗаполнениеВетРецептов = Истина;
	КонецЕсли;
	
	Если Не Отказ И ДанныеТовара.СтрокаТовараПолученаИзКэша Тогда
		ОбновитьДанныеРазливногоПива = Ложь;
		СтрокаТовара = НоваяСтрока;
		Если СтрокаТовара.НеобходимостьВводаКодаМаркировки И Не ЗначениеЗаполнено(СтрокаТовара.КодМаркировки)
			И СтрокаТовара.ПоштучноеВыбытие И СтрокаТовара.ПоддерживаетсяПодключениеКОборудованиюРозлива
			И ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации) Тогда
				ОбновитьДанныеРазливногоПива = Истина;
		КонецЕсли;
		Если (ОтображатьОстаток И Не ИспользуютсяСтатическиеОстаткиТоваров)
			Или ОбновитьДанныеРазливногоПива Тогда
			ДополнитьСтрокуНаСервереПослеДобавленияНаКлиенте(ОбновитьДанныеРазливногоПива);
			Если ОбновитьДанныеРазливногоПива Тогда
				ОграничитьДоступностьЭлементовПриОжиданииМарки(Не ЗначениеЗаполнено(СтрокаТовара.КодМаркировки));
				ТоварыПриАктивизацииСтроки(Элементы.Товары);
				ВывестиПредупреждениеОстаткаЧастичноеВыбытие(СтрокаТовара);
				НоваяСтрока.ПредставлениеКодАртикул = ОбщегоНазначенияРМККлиентСервер.ПолучитьПредставлениеКодАртикул(
					СтрокаТовара, ИспользоватьКод, ИспользоватьАртикул);
				Если ДоступнаПивнаяПалитра Тогда
					ОбработатьИзменениеКоличестваДляПлиткиКрана(НоваяСтрока, Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СписокДобавленныхСтрокТоваров.Добавить(НоваяСтрока.ИдентификаторСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПродавцаИзКассираНаКлиенте(ТекущиеДанные)
	ПродавецПредставление = Строка(Объект.Кассир);
	ТекущиеДанные.Продавец = Объект.Кассир;
	ТекущиеДанные.ПродавецПредставление = ПродавецПредставление;
	ПродавецТекущейСтроки = Строка(Объект.Кассир);
	
	Если Элементы.ПродавецТекущейСтроки.СписокВыбора.НайтиПоЗначению(ПродавецПредставление) = Неопределено
		И ЗначениеЗаполнено(ПродавецПредставление) Тогда
		Элементы.ПродавецТекущейСтроки.СписокВыбора.Добавить(ПродавецПредставление, ПродавецПредставление);
		Элементы.ПродавецТекущейСтрокиВПлитке.СписокВыбора.Добавить(ПродавецПредставление, ПродавецПредставление);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтрокуВТабличнойЧастиНаКлиенте(НайденнаяСтрока, ТекущийВыбор)
	
	Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.ИдентификаторСтроки) Тогда
		НайденнаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	Если РучноеСопоставлениеТовара И ЗначениеЗаполнено(ДанныеДляРучногоСопоставления) Тогда
		Отказ = Ложь;
		НайденнаяСтрокаИндекс = НайденнаяСтрока.НомерСтроки-1;
		ЗаполнитьДанныеРучногоСопоставленияСКлиента(НайденнаяСтрокаИндекс, Отказ);
		ИнтерфейсРМКСлужебныйКлиентСервер.АктивизироватьСлойГруппы(ЭтотОбъект, Элементы.ОбластьОперативногоУправленияЧеком);
	КонецЕсли;
	
	Если ТекущийВыбор.Свойство("Количество") И ЗначениеЗаполнено(ТекущийВыбор.Количество) Тогда
		НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + ТекущийВыбор.Количество;
		Если ТекущийВыбор.Свойство("КоличествоУпаковок") Тогда
			НайденнаяСтрока.КоличествоУпаковок = НайденнаяСтрока.КоличествоУпаковок + ТекущийВыбор.КоличествоУпаковок;
		КонецЕсли;
	Иначе
		НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + 1;
		НайденнаяСтрока.КоличествоУпаковок = НайденнаяСтрока.КоличествоУпаковок + 1;
	КонецЕсли;
	
	ТекущийТоварКоличество = НайденнаяСтрока.КоличествоУпаковок;
	
	Элементы.Товары.ТекущаяСтрока = НайденнаяСтрока.ПолучитьИдентификатор();
	ТекущийТоварИндексСтроки = Объект.Товары.Индекс(НайденнаяСтрока);
	
	УстановитьТекущийЭлементКоличество(ЭтотОбъект);
	РезультатКонтроляПродаж.СтартКонтроля = ИспользоватьКонтрольПродаж;
	СписокДобавленныхСтрокТоваров.Добавить(НайденнаяСтрока.ИдентификаторСтроки);
	НастроитьДоступностьКомандИзмененияКоличества(НайденнаяСтрока);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеРучногоСопоставленияСКлиента(ТекущаяСтрокаИндекс, УпаковкаНеНайдена)
	
	ТекущаяСтрока = Объект.Товары[ТекущаяСтрокаИндекс];
	
	ПараметрыШтрихкодирования = Новый Структура();
	ПараметрыШтрихкодирования.Вставить("Объект", Объект);
	ПараметрыШтрихкодирования.Вставить("КонтролироватьЕМРЦ", КонтролироватьЕМРЦ);
	ПараметрыШтрихкодирования.Вставить("УчитыватьМРЦ", УчитыватьМРЦ);
	ПараметрыШтрихкодирования.Вставить("МРЦНекорректна", Ложь);
	ПараметрыШтрихкодирования.Вставить("МРЦИзменена", Ложь);
	
	Если ЕстьСвойство(ДанныеДляРучногоСопоставления, "КодМарки") Тогда
		
		ШтрихкодированиеРМК.РазобратьМаркуИЗаполнитьДанные(ТекущаяСтрока,
			ДанныеДляРучногоСопоставления.КодМарки,
			ПараметрыШтрихкодирования);
			
	КонецЕсли;
	
	Если ЕстьСвойство(ПараметрыШтрихкодирования, "УпаковкаНеНайдена") Тогда
		
		УпаковкаНеНайдена = Истина;
		ДанныеДляРучногоСопоставления = Неопределено;
		
	Иначе
		
		Если ЕстьСвойство(ДанныеДляРучногоСопоставления, "EAN") Тогда
			ТекущаяСтрока.Штрихкод = ДанныеДляРучногоСопоставления.EAN;
		КонецЕсли;
		Если ЕстьСвойство(ДанныеДляРучногоСопоставления, "Штрихкод") 
			И ЕстьСвойство(ДанныеДляРучногоСопоставления, "ТоварНеНайденПоШтрихкоду")
			И НЕ ЗначениеЗаполнено(ТекущаяСтрока.Штрихкод) Тогда
			ТекущаяСтрока.Штрихкод = ДанныеДляРучногоСопоставления.Штрихкод;
		КонецЕсли;
		Если ЕстьСвойство(ДанныеДляРучногоСопоставления, "КодМарки") Тогда
			ТекущаяСтрока.КодМаркировки = ДанныеДляРучногоСопоставления.КодМарки;
		КонецЕсли;
		
		СоздатьЗаписьВШтрихкоды(ТекущаяСтрока);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКэшСтрокТоваровКорзины()
	
	Если КэшиСтрокТоваров.Свойство("КэшКорзины") Тогда
		КэшиСтрокТоваров.КэшКорзины.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКэшПлитки()
	
	Если КэшиСтрокТоваров.Свойство("КэшПлитки") Или ((Не ДанныеПакета = Неопределено)
			И ЗначениеЗаполнено(ДанныеПакета.Номенклатура)) Тогда
		РеквизитыФормыРМК = СтруктураРеквизитовФормыРМКДляДобавленияСтроки();
		Если РеквизитыФормыРМК.МассивОрганизаций.Количество() > 0 Тогда
			ИнтерфейсРМКСлужебныйКлиент.ОчиститьКэшКонтроляПродаж(КэшКонтроляПродаж);
			КэшиСтрокТоваров.КэшПлитки = КэшОпорныхДанныхПлитки(РеквизитыФормыРМК, КэшКонтроляПродаж, КэшУточненияПринадлежностиЗапасов);
			ДатаОбновленияКэшаКонтроляПродажПлитки = ОбщегоНазначенияКлиент.ДатаСеанса();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДобавитьТоварОтдельнойСтрокойНаКлиенте(СтрокаТовара)
	
	РезультатФункции = ДобавлятьВсеТоварыОтдельнойСтрокой
		Или (РежимКассыСамообслуживания И СтрокаТовара.Весовой);
	Возврат РезультатФункции;
	
КонецФункции

&НаСервере
Функция СтруктураПустойСтрокиТаблицыТоваров()
	
	СтруктураПустойСтрокиТаблицыТоваров = Новый Структура;
	ТаблицаТоваров = Объект.Товары.Выгрузить();
	ПустаяСтрокаТоваров = ТаблицаТоваров.Добавить();
	Для Каждого Колонка Из ТаблицаТоваров.Колонки Цикл
		ЗначениеКолонки = ПустаяСтрокаТоваров[Колонка.Имя];
		Если Колонка.Имя = "КартинкаПроцентов"
			Или Колонка.Имя = "КодыМаркировкиПоДаннымИБ" Тогда
			ЗначениеКолонки = Неопределено;
		КонецЕсли;
		СтруктураПустойСтрокиТаблицыТоваров.Вставить(Колонка.Имя, ЗначениеКолонки);
	КонецЦикла;
	
	Возврат СтруктураПустойСтрокиТаблицыТоваров;
	
КонецФункции

&НаСервере
Функция КэшОпорныхДанныхПлитки(РеквизитыФормыРМК, ДанныеКонтроляПродаж, ДанныеУточненияПринадлежностиЗапасов)
	
	ИменаРеквизитовСтрокиОпорныхДанных = "Номенклатура, Характеристика, Упаковка, Цена";
	СтруктураСтрокиОпорныхДанных = Новый Структура(ИменаРеквизитовСтрокиОпорныхДанных);
	СтруктураСтрокиОпорныхДанных.Вставить("РеквизитыФормыРМК", РеквизитыФормыРМК);
	
	ПустаяСтрокаТаблицыТоваров = ОбщегоНазначения.СкопироватьРекурсивно(РеквизитыФормыРМК.ПустаяСтрокаТаблицыТоваров);
	КэшПлитки = Новый Массив;
	ИсточникиДанныхПлитки = ИнтерфейсРМКСлужебныйКлиентСервер.ИсточникиДанныхДляПлитки();
	
	Для Каждого СтрокаОпорныхДанных Из ОпорныеДанные Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаОпорныхДанных.Номенклатура)
				Или СтрокаОпорныхДанных.ИсточникПлитки = ИсточникиДанныхПлитки.ВесовойТовар Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовара = Неопределено;
		Индекс = 0;
		Для Каждого СтрокаКэша Из КэшПлитки Цикл
			
			Индекс = Индекс + 1;
			
			Если Не СтрокаОпорныхДанных.Номенклатура = СтрокаКэша.Номенклатура Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не СтрокаОпорныхДанных.Упаковка = СтрокаКэша.Упаковка Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не СтрокаОпорныхДанных.Характеристика = СтрокаКэша.Характеристика Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТовара = СтрокаКэша;
			Прервать;
			
		КонецЦикла;
		
		Если СтрокаТовара = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтруктураСтрокиОпорныхДанных, СтрокаОпорныхДанных);
			ОбновитьПустуюСтрокуДляЗаполнения(СтруктураСтрокиОпорныхДанных, ПустаяСтрокаТаблицыТоваров, РеквизитыФормыРМК);
			СтруктураСтрокиОпорныхДанных.Вставить("ПолучитьЦену", Истина);
			ДанныеТовара = СтрокаТовараНаКлиентеСервере(СтруктураСтрокиОпорныхДанных, ЭтотОбъект);
			СтрокаТовара = ДанныеТовара.СтрокаТовара;
			Если СтрокаТовара.Свойство("ДобавлятьСтрокуВКэшСтрок") И СтрокаТовара.ДобавлятьСтрокуВКэшСтрок Тогда
				КэшПлитки.Добавить(СтрокаТовара);
				Индекс = Индекс + 1;
			КонецЕсли;
			Если Не Данныетовара.ДанныеКонтроляПродаж = Неопределено Тогда
				ИнтерфейсРМКСлужебныйКлиентСервер.ДобавитьНовыеДанныеКэшаПродаж(ДанныеКонтроляПродаж,
					Данныетовара.ДанныеКонтроляПродаж, Истина);
			КонецЕсли;
			Если Не Данныетовара.ДанныеУточненияПринадлежностиЗапасов = Неопределено Тогда
				ИнтерфейсРМКСлужебныйКлиентСервер.ДобавитьНовыеДанныеКэшаУточненияПринадлежностиЗапасов(ДанныеУточненияПринадлежностиЗапасов,
					Данныетовара.ДанныеУточненияПринадлежностиЗапасов);
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаТовара.Свойство("ДобавлятьСтрокуВКэшСтрок") И СтрокаТовара.ДобавлятьСтрокуВКэшСтрок Тогда
			СтрокаОпорныхДанных.ИндексКэшаСтрокиТовара = Индекс;
		КонецЕсли;
		
	КонецЦикла;
	ДобавитьВКэшДанныеПакета(ДанныеКонтроляПродаж, СтруктураСтрокиОпорныхДанных, ПустаяСтрокаТаблицыТоваров,
		РеквизитыФормыРМК);
	
	Возврат КэшПлитки;
	
КонецФункции

&НаСервере
Процедура ДобавитьВКэшДанныеПакета(ДанныеКонтроляПродаж, СтруктураСтрокиОпорныхДанных,
		ПустаяСтрокаТаблицыТоваров, РеквизитыФормыРМК)
	
	Если (Не ДанныеПакета = Неопределено) И ЗначениеЗаполнено(ДанныеПакета.Номенклатура) Тогда
		ЗаполнитьЗначенияСвойств(СтруктураСтрокиОпорныхДанных, ДанныеПакета);
		ОбновитьПустуюСтрокуДляЗаполнения(СтруктураСтрокиОпорныхДанных, ПустаяСтрокаТаблицыТоваров, РеквизитыФормыРМК);
		ДанныеТовара = СтрокаТовараНаКлиентеСервере(СтруктураСтрокиОпорныхДанных, ЭтотОбъект);
		СтрокаТовара = ДанныеТовара.СтрокаТовара;
		Если Не Данныетовара.ДанныеКонтроляПродаж = Неопределено Тогда
			ИнтерфейсРМКСлужебныйКлиентСервер.ДобавитьНовыеДанныеКэшаПродаж(ДанныеКонтроляПродаж,
				Данныетовара.ДанныеКонтроляПродаж, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПустуюСтрокуДляЗаполнения(СтруктураСтрокиОпорныхДанных,
		ПустаяСтрокаТаблицыТоваров, РеквизитыФормыРМК)
	
	ПустаяСтрокаТаблицыТоваровДляЗаполнения = ОбщегоНазначения.СкопироватьРекурсивно(ПустаяСтрокаТаблицыТоваров);
	РеквизитыФормыРМК.Вставить("ПустаяСтрокаТаблицыТоваров" ,ПустаяСтрокаТаблицыТоваровДляЗаполнения);
	СтруктураСтрокиОпорныхДанных.Вставить("РеквизитыФормыРМК", РеквизитыФормыРМК);
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьКомандуЗавершенияРаботыПриНеобходимости()
	
	СкрытьКоманду = Истина;
	Если ТекущийРежимЗапуска() = РежимЗапускаКлиентскогоПриложения.УправляемоеПриложение Тогда
		ТекущийРежимОкна = КлиентскоеПриложение.ПолучитьРежимОсновногоОкна();
		Если ТекущийРежимОкна = РежимОсновногоОкнаКлиентскогоПриложения.Киоск
			Или ТекущийРежимОкна = РежимОсновногоОкнаКлиентскогоПриложения.ПолноэкранноеРабочееМесто Тогда
			
			СкрытьКоманду = Ложь;
			
		КонецЕсли;
	КонецЕсли;
	Если СкрытьКоманду Тогда
		УстановитьВидимостьЭлементаФормы(Элементы.ЗавершитьРаботуРМК, Ложь);
		УстановитьВидимостьЭлементаФормы(Элементы["ЗавершитьРаботуРМК_Карточка"], Ложь);
		УстановитьВидимостьЭлементаФормы(Элементы["ДекорацияЕщеОтступ"], Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРаботуРМККлиент()
	
	Если Объект.Товары.Количество() = 0 Или ФормаЗамороженаПослеПробитияЧека() Тогда
		
		ЗавершитьРаботуСистемы(Истина);
		
	Иначе
		
		ТекстПредупреждения =
			НСтр("ru = 'Перед закрытием программы необходимо пробить, отложить или удалить текущий чек.'");
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстПредупреждения);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ПараметрыОткрытияОшибки.Вставить("УправлениеЧеком", Истина);
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

#Область СкидкиПриВозврате
&НаКлиенте
Функция ПроверитьВидОплаты(ВидОплаты)
	РазрешенныйВид = Ложь;
	ОбщегоНазначенияРМККлиентПереопределяемый.ОпределитьВидОплатыРазрешенныйВид(РазрешенныйВид,ВидОплаты);
	Возврат РазрешенныйВид;
КонецФункции

&НаКлиенте
Процедура НастроитьЭлементыПриПереходеКОплате(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	ИтогиОплаты = Объект.Оплата.Итог("Сумма");
	РазницаОплаты = СуммаИтого - ИтогиОплаты;
	КоличествоОплат = 0;
	СуммаРаспределено = 0;
	Для Каждого Строка Из Объект.Оплата Цикл
		РазрешенныйВид = ПроверитьВидОплаты(Строка.ВидОплаты);
		Если РазрешенныйВид Тогда
			ПроцентРаспределения = Строка.Сумма/ИтогиОплаты;
			СуммаОтОплаты = РазницаОплаты * ПроцентРаспределения;
			Строка.Сумма = Строка.Сумма + СуммаОтОплаты;
			СуммаРаспределено = СуммаРаспределено + СуммаОтОплаты;
		КонецЕсли;
	КонецЦикла;
	СуммаРаспределено = Окр(СуммаРаспределено, 2, РежимОкругления.Окр15как20);
	РазницаОплаты = РазницаОплаты - СуммаРаспределено;
	Для Каждого Строка Из Объект.Оплата Цикл
		РазрешенныйВид = ПроверитьВидОплаты(Строка.ВидОплаты);
		Если РазрешенныйВид И РазницаОплаты <> 0 Тогда
			Строка.Сумма = Строка.Сумма + РазницаОплаты;
			РазницаОплаты = 0;
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьВидыОплатДляЧекаВозврата();
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("Восстановление") Тогда
		Для Каждого СтрокаОплаты Из ТаблицаОплатКартой Цикл
			
			Если КоличествоДополнительныхКарт = 0 Тогда
				НаименованиеРеквизитаПоляСуммы = "СуммаОплаченоБН_0";
				НаименованиеГруппыЭлементовПоляСуммы = "ГруппаОплатаКартой";
				НаименованиеГруппыОплаты = "ГруппаВидОплатыКартойГоризонтально";
				УстановитьДоступностьЭлементаФормы(Элементы[НаименованиеГруппыОплаты], Истина);
				УстановитьВидимостьЭлементаФормы(Элементы[НаименованиеГруппыОплаты], Ложь);
			ИначеЕсли КоличествоДополнительныхКарт < 3 Тогда
				ДобавитьРеквизитыОплатыКартой(КоличествоДополнительныхКарт);
				НаименованиеРеквизитаПоляСуммы = "СуммаОплаченоБН_" + Строка(КоличествоДополнительныхКарт);
				НаименованиеГруппыЭлементовПоляСуммы = "ГруппаОплатаКартой_" + Строка(КоличествоДополнительныхКарт);
			КонецЕсли;
			КоличествоДополнительныхКарт = КоличествоДополнительныхКарт + 1;
			УстановитьВидимостьЭлементаФормы(Элементы[НаименованиеГруппыЭлементовПоляСуммы], Истина);
			УстановитьДоступностьЭлементаФормы(Элементы[НаименованиеГруппыЭлементовПоляСуммы], Истина);
			ЭтотОбъект[НаименованиеРеквизитаПоляСуммы] = СтрокаОплаты.Сумма;
			
		КонецЦикла;
	КонецЕсли;
	
	НастроитьДоступностьПробитьЧек();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСкидкиЗавершениеПриВозврате(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ИмяМетода = "НастроитьЭлементыПриПереходеКОплате";
		РассчитатьСкидкиКлиент(Истина);
	Иначе
		НастроитьЭлементыПриПереходеКОплате();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСкидкиПриВозврате(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если НЕ ИспользоватьАвтоматическиеСкидки Тогда
		Возврат;
	КонецЕсли;
	
	НеобходимПересчетАвтоматическихСкидок = ОпределитьНеобходимостьПересчетаАвтоматическихСкидок();
	Если НеобходимПересчетАвтоматическихСкидок И ВопросПоРасчетуСкидок Тогда
		ЗадатьВопросПоРасчетуСкидок("ПересчитатьСкидкиЗавершениеПриВозврате", , Истина);
	Иначе
		КодВозвратаОтвет = ?(НеобходимПересчетАвтоматическихСкидок, КодВозвратаДиалога.Да, КодВозвратаДиалога.Нет);
		ПересчитатьСкидкиЗавершениеПриВозврате(КодВозвратаОтвет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВидыОплатДляЧекаВозврата()
	
	ТаблицаОплатКартой.Очистить();
	ИндексОплатыКартой = 0;
	СуммаОплаченоБН = 0;
	
	Для Каждого СтрокаОплаты Из Объект.Оплата Цикл
		
		ЭтоОплатаНаличными = ОбщегоНазначенияРМККлиент.ЭтоОплатаНаличными(СтрокаОплаты.ВидОплаты);
		ЭтоОплатаПлатежнойКартой = ОбщегоНазначенияРМККлиент.ЭтоОплатаПлатежнойКартой(СтрокаОплаты.ВидОплаты);
		
		Если ЭтоОплатаНаличными Тогда
			
			СуммаОплаченоНал = СтрокаОплаты.Сумма;
			ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаСуммаОплатаНал);
			
		КонецЕсли;
		
		Если ЭтоОплатаПлатежнойКартой Тогда
			
			Если ИндексОплатыКартой <> 0 Тогда;
				НаименованиеРеквизитаПоляСуммы = "СуммаОплаченоБН_" + Строка(ИндексОплатыКартой);
				НаименованиеГруппыЭлементовПоляСуммы = "ГруппаОплатаКартой_" + Строка(ИндексОплатыКартой);
			Иначе
				НаименованиеРеквизитаПоляСуммы = "СуммаОплаченоБН_0";
				НаименованиеГруппыЭлементовПоляСуммы = "ГруппаОплатаКартой";
			КонецЕсли;
			Если ИспользоватьОплатуНесколькимиКартами Тогда
				УстановитьДоступностьЭлементаФормы(Элементы[НаименованиеГруппыЭлементовПоляСуммы], Ложь);
			КонецЕсли;
			ЭтотОбъект[НаименованиеРеквизитаПоляСуммы] = СтрокаОплаты.Сумма;
			
			НоваяОплатаКартой = ТаблицаОплатКартой.Добавить();
			НоваяОплатаКартой.Сумма = СтрокаОплаты.Сумма;
			НоваяОплатаКартой.Организация = ВыбраннаяОрганизация;
			НоваяОплатаКартой.СистемаНалогообложения = ВыбраннаяСистемаНалогообложения;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ВыбранныйВидОплаты") Тогда
				НоваяОплатаКартой.ВидОплаты = ЭтотОбъект.ВыбранныйВидОплаты;
			КонецЕсли;
			Если ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации) И Не ЭтоЗаменаТоваров Тогда
				НоваяОплатаКартой.Оплачено = Истина;
			КонецЕсли;
			СуммаОплаченоБН = СуммаОплаченоБН + СтрокаОплаты.Сумма;
			ИндексОплатыКартой = ИндексОплатыКартой + 1;
			
		КонецЕсли;
		
		ЗаполнитьВидОплатыВРежимеКассира(СтрокаОплаты);
		
	КонецЦикла;
	
	Если БонусыДоступноКОплате > 0 Тогда
		
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаОплатаБонусами, Истина);
		Элементы.СтраницыОплатаБонусами.ТекущаяСтраница = Элементы.ГруппаОплатаБонусами;
		СуммаОплаченоБонусами = БонусыДоступноКОплате * КурсБонусов;
		
	КонецЕсли;
	
	РассчитатьСуммыОплаты();
	
КонецПроцедуры
#КонецОбласти

&НаКлиенте
Процедура ПродолжитьБезРасчетаКлиент()
	
	ИспользоватьАвтоматическиеСкидки = Ложь;
	ЗакрытьСтраницуИнфоОшибкаНаКлиенте();
	Если ЗначениеЗаполнено(ИмяМетода) Тогда
		ВыполнитьОтложенныйМетод();
	КонецЕсли;
	ЗарегистрироватьРаботуСЧекомБезРасчетаСкидок();
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьПравоПродолжитьБезРасчетаСкидок()
	
	НеобходимоеПраво = "ПравоУдалитьЧекРМК";
	Возврат ((Не ЗапретитьПробитиеЧекаБезРасчетаСкидок) Или ЧекПозволяетРедактированиеБезПовышенияПрав()
		Или ЕстьПравоНаДействие(НеобходимоеПраво));
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьБезРасчетаПроверкаПрав()
	
	Если ЕстьПравоПродолжитьБезРасчетаСкидок() Тогда
		ПродолжитьБезРасчетаКлиент();
	Иначе
		НеобходимоеПраво = "ПродолжитьБезРасчетаСкидок";
		ПредложитьЗаменитьПраваКассира(НеобходимоеПраво);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибкуНекорректнойМарки(ПараметрыШтрихкода)
	
	//Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПустая Тогда
	//	ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОбщая);
	//КонецЕсли;
	ШтрихкодУрезанный = СтрШаблон("%1%2", Лев(ПараметрыШтрихкода.Штрихкод, 50),
		?(СтрДлина(ПараметрыШтрихкода.Штрихкод) > 50, "...", ""));
	ТекстЗаголовка = НСтр("ru = 'Марка некорректная.'");
	ТекстСообщения = СтрШаблон(НСтр("ru = '%1
		|Попробуйте отсканировать снова.'"), ШтрихкодУрезанный);
	
	ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ТекстЗаголовка);
	ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
	ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИнформациюОКарте(ПараметрыШтрихкода)
	
	//Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПустая Тогда
	//	ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОбщая);
	//КонецЕсли;
	ШтрихкодУрезанный = СтрШаблон("%1%2", Лев(ПараметрыШтрихкода.Штрихкод, 25),
		?(СтрДлина(ПараметрыШтрихкода.Штрихкод) > 25, "...", ""));
	ТекстЗаголовка = НСтр("ru = 'Информация о карте'");
	ТекстСообщения = СтрШаблон(НСтр("ru = 'Дисконтная карта недействительна: %1'"), ШтрихкодУрезанный);
	
	ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ТекстЗаголовка);
	ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
	ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуИнформацииОКарте(ПараметрыДляОбработкиШтрихкода)
	
	ПоказатьИнформациюОКарте(ПараметрыДляОбработкиШтрихкода);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьУстройствоРаспознаванияЭлектронныхВесов(ИдентификаторЭлектронныхВесов)
	
	УстройствоРаспознавания = Неопределено;
	
	ОтборВесов = Новый Структура("ЭлектронныеВесы", ИдентификаторЭлектронныхВесов);
	СтрокиВесов = ТаблицаЭлектронныхВесов.НайтиСтроки(ОтборВесов);
	Если СтрокиВесов.Количество() > 0 И ЗначениеЗаполнено(СтрокиВесов[0].УстройствоРаспознавания) Тогда
		УстройствоРаспознавания = СтрокиВесов[0].УстройствоРаспознавания;
	КонецЕсли;
	
	Возврат УстройствоРаспознавания;
	
КонецФункции

&НаКлиенте
Функция ТребуетсяПодтверждениеРаспознаванияВыбранногоТовара(СтрокаПозиции, ДополнительныеПараметры, 
		ТекущееУстройствоРаспознавания)
	
	РезультатФункции = Ложь;
	
	Если ТипПостроенияПлитки = ТипыПостроенияПлитки.РаспознанныйВесовойТовар
			И ОбучатьУстройствоРаспознаванияВоВремяПродажи И Не СтрокаПозиции.SKU = 0 Тогда
			
		ТекущееУстройствоРаспознавания
			= ПолучитьУстройствоРаспознаванияЭлектронныхВесов(ДополнительныеПараметры.ТекущиеЭлектронныеВесы);
		Если Не ТекущееУстройствоРаспознавания = Неопределено Тогда
			РезультатФункции = Истина;
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьПодтверждениеРаспознаванияВыбранногоТовара(SKU, ТекущееУстройствоРаспознавания)
	
	МенеджерОборудованияРМККлиент.ПодтвердитьРаспознавание(Неопределено, УникальныйИдентификатор,
		ТекущееУстройствоРаспознавания, SKU);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуДанныеПокупателяРасчетСкидокПриНеобходимости()
	
	ЗакрытьФормуДанныеПокупателяСОтменойПробитияЧека();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуДанныеПокупателяЗавершение(Результат, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ИмяМетода = "ЗакрытьФормуДанныеПокупателяСОтменойПробитияЧека";
		РассчитатьСкидкиКлиент(Истина);
	Иначе
		ЗакрытьФормуДанныеПокупателяСОтменойПробитияЧека();
	КонецЕсли;
	
КонецПроцедуры

#Область УправляемыеСкидки

&НаСервереБезКонтекста
Процедура ЗаполнитьПараметрыУправляемыеСкидки(ЗначенияПараметровМетода, ПараметрыИзФормы)
	
	ЗначенияПараметровМетода.MaxSale = ПараметрыИзФормы.МаксимальныйПроцентРучнойСкидки;
	ЗначенияПараметровМетода.MaxMarkup = ПараметрыИзФормы.МаксимальныйПроцентРучнойНаценки;
	ЗначенияПараметровМетода.Store = СерверЛояльностиПолучательДанныхКлиентСервер.ПолучитьПараметрыСсылки(ПараметрыИзФормы.ТорговыйОбъект).Ref;
	УИДКонтрагента = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	Если ЗначениеЗаполнено(ПараметрыИзФормы.Контрагент) Тогда
		УИДКонтрагента = СерверЛояльностиПолучательДанныхКлиентСервер.ПолучитьПараметрыСсылки(ПараметрыИзФормы.Контрагент).Ref;
	КонецЕсли;
	ЗначенияПараметровМетода.Client = УИДКонтрагента;
	Если ЗначениеЗаполнено(ПараметрыИзФормы.ДисконтнаяКарта) Тогда
		ЗначенияПараметровМетода.CardGUID = СерверЛояльностиПолучательДанныхКлиентСервер.ПолучитьПараметрыСсылки(ПараметрыИзФормы.ДисконтнаяКарта).Ref;
	Иначе
		ЗначенияПараметровМетода.ClientCardID = ПараметрыИзФормы.НайденнаяКартаНомер;
	КонецЕсли;
	ЗначенияПараметровМетода.UseSelection = Истина;
	ЗначенияПараметровМетода.DiscountsAllowed = ПараметрыИзФормы.ДопускаетсяПрименениеСкидок;
	
КонецПроцедуры

#КонецОбласти

#Область ГосИС

&НаСервере
Функция ИспользоватьРазрешительныйРежимПродажиГосИС()
	
	Возврат ОбщегоНазначенияРМК.ИспользоватьРазрешительныйРежимПродажиГосИС(Этотобъект);
	
Конецфункции

&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(ДанныеШтрихкода, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ДанныеШтрихкода = Неопределено Тогда
		ОчиститьОчередьШтрихкодов();
		Возврат;
	КонецЕсли;
	
	Если ДанныеШтрихкода.Свойство("ДанныеПО") Тогда
		
		ПараметрыДляОбработкиШтрихкода = ДанныеШтрихкода.ПараметрыДляОбработкиШтрихкода;
		
		СтруктураПараметровКлиента = ДанныеШтрихкода;
		СтруктураПараметровКлиента.Вставить("ОтображатьОстаток", ОтображатьОстаток);
		СтруктураПараметровКлиента.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
		ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента, ПараметрыДляОбработкиШтрихкода);
		
		ОбработатьШтрихкодЗавершение(ПараметрыДляОбработкиШтрихкода);
		
		ОбработатьСледующийШтрихкодИзОчереди();
		Возврат;
	КонецЕсли;
	
	Если ДанныеШтрихкода.Свойство("ТребуетсяАвторизацияИСМПРозница") Тогда
		ПараметрыОбновленияКлючаСессии = ПараметрыОбновленияКлючаСессии();
		ПараметрыОбновленияКлючаСессии.Организация = Объект.Организация;
		ПараметрыОбновленияКлючаСессии.ПараметрыИСМП.ЛокальныйКонтрольКлючаИСМП = ЛокальныйКонтрольКлючаИСМП;
		ПараметрыОбновленияКлючаСессии.ПараметрыИСМП.ИспользоватьРазрешительныйРежимГосИС = ИспользоватьРазрешительныйРежимГосИС;
		ПараметрыОбновленияКлючаСессии.ПараметрыСервераЛояльности = ПараметрыПодключенияКСерверуЛояльности;
		РезультатОбновленияКлюча = ТребуетсяОбновлениеКлючаСессииСервер(ПараметрыОбновленияКлючаСессии);
		Если РезультатОбновленияКлюча.ТребуетсяОбновлениеКлючаСессии Тогда
			ЗаголовокОшибки = НСтр("ru = 'Ошибка обновления ключа авторизации ИС ""Честный знак""'");
			ТекстСообщения = РезультатОбновленияКлюча.ОписаниеОшибки;
			ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ЗаголовокОшибки);
			ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
			ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	Если ДанныеШтрихкода.Свойство("ТребуетсяУточнениеВеса") Тогда
		// Обработка взвешивания
		ЗаголовокОшибки = НСтр("ru='Уточнение веса'");
		ТекстСообщения = НСтр("ru='Необходимо взвесить товар'");
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ЗаголовокОшибки);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШтрихкода.ТекстОшибки) Тогда
		ЗаголовокОшибки = НСтр("ru='Предупреждение'");
		ТекстСообщения = ДанныеШтрихкода.ТекстОшибки;
		
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ЗаголовокОшибки);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		Возврат;
	КонецЕсли;
	
	Отказ = ПроверитьВозможностьДобавленияВСлучаеУточненияШтрихкода(ДанныеШтрихкода);
	
	Если Отказ Тогда
		ОчиститьОчередьШтрихкодов();
		Возврат;
	КонецЕсли;

	СтруктураПараметровКлиента = ДанныеШтрихкода.ВнешниеДанныеПоШтрихкодам[0];
	СтруктураПараметровКлиента.Вставить("ОтображатьОстаток", ОтображатьОстаток);
	СтруктураПараметровКлиента.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
	ПараметрыДляОбработкиШтрихкода = СтруктураПараметровКлиента.ПараметрыДляОбработкиШтрихкода;
	
	Если Не ОбщегоНазначенияРМККлиент.ИспользоватьПроверкуМаркиВнеБиблиотекиГосИС() Тогда
		Если Не ПараметрыДляОбработкиШтрихкода.Свойство("ПроверкаМаркиВБиблиотекеГосИС")
			Или Не ПараметрыДляОбработкиШтрихкода.ПроверкаМаркиВБиблиотекеГосИС Тогда
			ПараметрыДляОбработкиШтрихкода.Вставить("ПроверкаМаркиВБиблиотекеГосИС", Истина);
		КонецЕсли;
	КонецЕсли;
		
	Если ДанныеШтрихкода.Свойство("ОбработатьБезМаркировки") И ДанныеШтрихкода.ОбработатьБезМаркировки Тогда
		ПараметрыДляОбработкиШтрихкода.Вставить("ОбработатьБезМаркировки", Истина);
	КонецЕсли;
	
	Если ДанныеШтрихкода.Свойство("ГоденДо") Тогда
		СтруктураПараметровКлиента.ПараметрыШтрихкода.Вставить("ГоденДо", ДанныеШтрихкода.ГоденДо);
	КонецЕсли;
	
	Если ДанныеШтрихкода.Свойство("МинимальнаяРозничнаяЦена") Тогда
		СтруктураПараметровКлиента.ПараметрыШтрихкода.Вставить("МинимальнаяРозничнаяЦена", ДанныеШтрихкода.МинимальнаяРозничнаяЦена);
	КонецЕсли;
	
	ЭтоПроверкаМаркировкиГОСИС = ПараметрыДляОбработкиШтрихкода.Свойство("ПроверкаМаркиВБиблиотекеГосИС")
		И ПараметрыДляОбработкиШтрихкода.ПроверкаМаркиВБиблиотекеГосИС;
	ПрошелЗапросРР = ЗначениеЗаполнено(ДанныеШтрихкода.РазрешительныйРежимДатаЗапросаГИСМТ)
		И ЗначениеЗаполнено(ДанныеШтрихкода.РазрешительныйРежимИдентификаторЗапросаГИСМТ);
	
	Если ПараметрыДляОбработкиШтрихкода.Свойство("ЭтоПроверкаМарки") Тогда
		
		СтрокаТовара = Неопределено;
		ОтборПоИдентификатору = Новый Структура("ИдентификаторСтроки", ПараметрыДляОбработкиШтрихкода.ИдентификаторСтроки);
		СтрокиТоваров = Объект.Товары.НайтиСтроки(ОтборПоИдентификатору);
		Если СтрокиТоваров.Количество() > 0 Тогда
			СтрокаТовара = СтрокиТоваров[0];
		КонецЕсли;
		Если Не СтрокаТовара = Неопределено
			И (ЭтоПроверкаМаркировкиГОСИС Или ПрошелЗапросРР) Тогда
			СтрокаТовара.РазрешительныйРежимДатаЗапросаГИСМТ = ДанныеШтрихкода.РазрешительныйРежимДатаЗапросаГИСМТ;
			СтрокаТовара.РазрешительныйРежимИдентификаторЗапросаГИСМТ = ДанныеШтрихкода.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
			СтрокаТовара.РазрешительныйРежимИдентификаторЭкземпляраПО = ДанныеШтрихкода.РазрешительныйРежимИдентификаторЭкземпляраПО;
			СтрокаТовара.РазрешительныйРежимВерсияБазы = ДанныеШтрихкода.РазрешительныйРежимВерсияБазы;
			СтрокаТовара.КонтрольнаяМарка = СтрокаТовара.КодМаркировки;
			
			Если СтруктураПараметровКлиента.Свойство("ЗначенияПоиска") Тогда
				ЗначениеПоиска = СтруктураПараметровКлиента.ЗначенияПоиска[0];
				СтрокаТовара.МаркаПроверенаНаККТ = ЗначениеПоиска.МаркаПроверенаНаККТ;
				СтрокаТовара.ОжидатьОтветПроверкиМаркиНаККТ = ЗначениеПоиска.ОжидатьОтветПроверкиМаркиНаККТ;
			КонецЕсли;
			
			Если ПараметрыДляОбработкиШтрихкода.Свойство("ВызовИзПродолженияЧека") Тогда
				ПроверитьКодМаркировкиПриПродолженииЧека();
			Иначе
				СтрокаТовара.ТребуетсяПроверкаКодаМаркировки = Ложь;
				ПроверитьКодыМаркировкиПередПробитием();
			КонецЕсли;
		Иначе
			КонтекстПроверкиКонтрольнойМарки = КонтекстПроверкиКонтрольнойМарки();
			ЗаполнитьЗначенияСвойств(КонтекстПроверкиКонтрольнойМарки, СтрокаТовара);
			Если ПараметрыДляОбработкиШтрихкода.Свойство("ВызовИзПродолженияЧека") Тогда
				КонтекстПроверкиКонтрольнойМарки.КонтекстВызова = "ПроверитьКодыМаркировкиПриПродолженииЧека";
			Иначе
				КонтекстПроверкиКонтрольнойМарки.КонтекстВызова = "ПроверитьКодыМаркировкиПередПробитиемЧека";
			КонецЕсли;
			КонтекстПроверкиКонтрольнойМарки.КодМаркировки = ПараметрыДляОбработкиШтрихкода.Штрихкод;
			
			ВременныйКонтекстПроверкиМарки = КонтекстПроверкиКонтрольнойМарки;
			ОбработатьКонтрольнуюМарку(КонтекстПроверкиКонтрольнойМарки);
		КонецЕсли;
	Иначе
		
		ЭтоСопоставлениеМаркиКТекущейСтроке = ПараметрыДляОбработкиШтрихкода.Свойство("ЭтоСопоставлениеМаркиКТекущейСтроке");
		Если ЭтоСопоставлениеМаркиКТекущейСтроке Тогда
			
			ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
			
			ТекущаяСтрока.РазрешительныйРежимДатаЗапросаГИСМТ = ДанныеШтрихкода.РазрешительныйРежимДатаЗапросаГИСМТ;
			ТекущаяСтрока.РазрешительныйРежимИдентификаторЗапросаГИСМТ = ДанныеШтрихкода.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
			ТекущаяСтрока.РазрешительныйРежимИдентификаторЭкземпляраПО = ДанныеШтрихкода.РазрешительныйРежимИдентификаторЭкземпляраПО;
			ТекущаяСтрока.РазрешительныйРежимВерсияБазы = ДанныеШтрихкода.РазрешительныйРежимВерсияБазы;
			
			Если СтруктураПараметровКлиента.Свойство("ЗначенияПоиска") Тогда
				ЗначениеПоиска = СтруктураПараметровКлиента.ЗначенияПоиска[0];
				ТекущаяСтрока.МаркаПроверенаНаККТ = ЗначениеПоиска.МаркаПроверенаНаККТ;
				ТекущаяСтрока.ОжидатьОтветПроверкиМаркиНаККТ = ЗначениеПоиска.ОжидатьОтветПроверкиМаркиНаККТ;
			КонецЕсли;
			
			КонтекстПроверкиКонтрольнойМарки = КонтекстПроверкиКонтрольнойМарки();
			ЗаполнитьЗначенияСвойств(КонтекстПроверкиКонтрольнойМарки, ТекущаяСтрока);
			ЭтоОбработкаСопоставленияТовара = Истина;
			КонтекстПроверкиКонтрольнойМарки.ЭтоОбработкаСопоставленияТовара = ЭтоОбработкаСопоставленияТовара;
			
			КонтекстПроверкиКонтрольнойМарки.ПроверкаМаркиВБиблиотекеГосИС = ИспользоватьРазрешительныйРежимГосИС
				И ПараметрыДляОбработкиШтрихкода.Свойство("ПроверкаМаркиВБиблиотекеГосИС");
			КонтекстПроверкиКонтрольнойМарки.ПодтверждениеПродажиМаркиГосИС =
				ПараметрыДляОбработкиШтрихкода.Свойство("ПодтверждениеПродажиМаркиГосИС");
			КонтекстПроверкиКонтрольнойМарки.ОбработатьБезМаркировки =
				ПараметрыДляОбработкиШтрихкода.Свойство("ОбработатьБезМаркировки");
			
			ЗавершитьВводШтрихкодаМаркаВведена(КонтекстПроверкиКонтрольнойМарки);
			
		Иначе
			
			Если ПараметрыДляОбработкиШтрихкода.Свойство("ТекущаяНоменклатура")
				И СтруктураПараметровКлиента.Свойство("ЗначенияПоиска") Тогда
				Если ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура)
					И ЗначениеЗаполнено(ПараметрыДляОбработкиШтрихкода.ТекущаяНоменклатура) Тогда
					СоответствуетНоменклатуре =
						(ДанныеШтрихкода.Номенклатура = ПараметрыДляОбработкиШтрихкода.ТекущаяНоменклатура
							И ДанныеШтрихкода.Характеристика = ПараметрыДляОбработкиШтрихкода.ТекущаяХарактеристика);
					СоответствуетНоменклатуреЧастичногоВыбытия = Ложь;
					Если ДанныеШтрихкода.Свойство("ЧастичноеВыбытиеНоменклатура")
						И ЗначениеЗаполнено(ДанныеШтрихкода.ЧастичноеВыбытиеНоменклатура) Тогда
						СоответствуетНоменклатуреЧастичногоВыбытия =
							(ДанныеШтрихкода.ЧастичноеВыбытиеНоменклатура = ПараметрыДляОбработкиШтрихкода.ТекущаяНоменклатура
							И ДанныеШтрихкода.ЧастичноеВыбытиеХарактеристика = ПараметрыДляОбработкиШтрихкода.ТекущаяХарактеристика);
					КонецЕсли;
					Если Не СоответствуетНоменклатуре И Не СоответствуетНоменклатуреЧастичногоВыбытия Тогда
						ПараметрыДляОбработкиШтрихкода.Вставить("НоменклатураПоМаркеОтличается", Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента, ПараметрыДляОбработкиШтрихкода);
			ОбработатьШтрихкодЗавершение(ПараметрыДляОбработкиШтрихкода);
			
		Конецесли;
		
		Если СтруктураПараметровКлиента.ЗначенияПоиска.Количество() > 0
			И ДанныеШтрихкода.Свойство("Номенклатура") И ЗначениеЗаполнено(ДанныеШтрихкода.Номенклатура) Тогда
			РучноеСопоставлениеТовара = Ложь;
			ДанныеДляРучногоСопоставления = Неопределено;
		КонецЕсли;
		
		ОбработатьСледующийШтрихкодИзОчереди();
		
	КонецЕсли;
	
КонецПроцедуры

// Параметры обновления ключа сессии.
// 
// Возвращаемое значение:
//  Структура - Параметры обновления ключа сессии:
// * Организация - ОпределяемыйТип.ОрганизацияРМК - Организация для получения токена 
// * ПараметрыИСМП - Структура - Параметры ИС МП:
// ** ОжидатьПолученияОтветаИСМП - Булево - Настройка РМК
// ** ЛокальныйКонтрольКлючаИСМП - Булево - Настройка РМК
// ** ТипТокенаАвторизации - ПеречислениеСсылка.ТипыТокеновАвторизации
// * ПараметрыСервераЛояльности - Структура - см. Перем. ПараметрыПодключенияКСерверуЛояльности
&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыОбновленияКлючаСессии()
	ПараметрыОбновленияКлючаСессии = Новый Структура;
	ПараметрыИСМП = Новый Структура();
	
	ПараметрыИСМП.Вставить("ИспользоватьРазрешительныйРежимГосИС", Ложь);
	ПараметрыИСМП.Вставить("ЛокальныйКонтрольКлючаИСМП", Истина);

	ПараметрыОбновленияКлючаСессии.Вставить("Организация");	
	ПараметрыОбновленияКлючаСессии.Вставить("ПараметрыИСМП", ПараметрыИСМП);	
	ПараметрыОбновленияКлючаСессии.Вставить("ПараметрыСервераЛояльности", Неопределено);
	ПараметрыОбновленияКлючаСессии.Вставить("НомерФискальногоНакопителя");
	ПараметрыОбновленияКлючаСессии.Вставить("ККТ");
	
	Возврат ПараметрыОбновленияКлючаСессии;
КонецФункции

// Требуется обновление ключа сессии сервер.
// 
// Параметры:
//  ПараметрыОбновленияКлючаСессии - Структура - см. ПараметрыОбновленияКлючаСессии()
&НаСервереБезКонтекста
Функция ТребуетсяОбновлениеКлючаСессииСервер(ПараметрыОбновленияКлючаСессии)
	РезультатВыполнения = Новый Структура;
	РезультатВыполнения.Вставить("ТребуетсяОбновлениеКлючаСессии", Истина);
	РезультатВыполнения.Вставить("Ошибка", Ложь);
	РезультатВыполнения.Вставить("ОписаниеОшибки");
	РезультатВыполнения.Вставить("ПараметрыОбновленияКлючаСессии", ПараметрыОбновленияКлючаСессии);
	
	Если ПараметрыОбновленияКлючаСессии.ПараметрыИСМП.ИспользоватьРазрешительныйРежимГосИС Тогда
		СтандартнаяОбработка = Истина;
		ОбщегоНазначенияРМКПереопределяемый.ТребуетсяОбновлениеКлючаСессии(СтандартнаяОбработка, РезультатВыполнения);
	
		Если СтандартнаяОбработка Тогда
			Если ОбщегоНазначения.ПодсистемаСуществует("ГосИС.ИСМП") Тогда
				МодульИнтерфейсАвторизацииИСМПВызовСервера = ОбщегоНазначения.ОбщийМодуль("ИнтерфейсАвторизацииИСМПВызовСервера");
				МодульИнтерфейсИСМПОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ИнтерфейсИСМПОбщегоНазначенияКлиентСервер");
				
				РезультатВыполнения.ТребуетсяОбновлениеКлючаСессии = МодульИнтерфейсАвторизацииИСМПВызовСервера.ТребуетсяОбновлениеКлючаСессииРозница(
					МодульИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ПараметрыЗапросаКлючаСессииИСМПРозница(ПараметрыОбновленияКлючаСессии.Организация));
			КонецЕсли;
		КонецЕсли;
		
		Если РезультатВыполнения.ТребуетсяОбновлениеКлючаСессии Тогда
			Если Не ПараметрыОбновленияКлючаСессии.ПараметрыИСМП.ЛокальныйКонтрольКлючаИСМП Тогда
				Если ЗначениеЗаполнено(ПараметрыОбновленияКлючаСессии.ПараметрыСервераЛояльности) Тогда
					ТекстПредупреждения = СтрШаблон(НСтр("ru = 'Для организации: %1 не удалось получить ключ авторизации ИС ""Честный знак"" через сервер лояльности.
						|Обратитесь к администратору системы.'"), Строка(ПараметрыОбновленияКлючаСессии.Организация));
					СтруктураПараметровЗапроса = Новый Структура;
					СтруктураПараметровЗапроса.Вставить("Organization", СерверЛояльностиПолучательДанныхКлиентСервер.ПолучитьПараметрыСсылки(ПараметрыОбновленияКлючаСессии.Организация));
					
					ПараметрыВыполненияЗапроса = СерверЛояльностиПолучательДанныхКлиентСервер.
												ПараметрыЗапросаПолучитьТокенАвторизацииГосИС(ПараметрыОбновленияКлючаСессии.ПараметрыСервераЛояльности, СтруктураПараметровЗапроса);
					Результат = СерверЛояльностиПолучательДанныхКлиентСервер.ВыполнитьЗапросКСерверуЛояльности(ПараметрыВыполненияЗапроса);
					
					Если Не Результат.ЕстьОшибки И ЗначениеЗаполнено(Результат.ДанныеОтвета) Тогда
						ДанныеОтвета = Неопределено;
						СтрокаJSON = Результат.ДанныеОтвета;
						СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаJSON, ДанныеОтвета);
					Иначе
						РезультатВыполнения.Ошибка = Истина;
						РезультатВыполнения.ОписаниеОшибки = ТекстПредупреждения;
						
						Возврат РезультатВыполнения;
					КонецЕсли;
					
					Если ТипЗнч(ДанныеОтвета) = Тип("Структура") Тогда
						Если ДанныеОтвета.Свойство("Error") И ДанныеОтвета.Error Тогда
							Если ДанныеОтвета.Свойство("ErrorMessage") Тогда
								ТекстПредупреждения = ДанныеОтвета.ErrorMessage;
							КонецЕсли;
							
							РезультатВыполнения.Ошибка = Истина;
							РезультатВыполнения.ОписаниеОшибки = ТекстПредупреждения;
						Иначе
							СтандартнаяОбработка = Истина;
							ОбщегоНазначенияРМКПереопределяемый.УстановитьКлючСессии(СтандартнаяОбработка, ДанныеОтвета);
							
							Если СтандартнаяОбработка Тогда
								Если ОбщегоНазначения.ПодсистемаСуществует("ГосИС.ИСМП") Тогда
									ОбщийМодульИнтерфейсАвторизацииИСМПВызовСервера = ОбщегоНазначения.ОбщийМодуль("ИнтерфейсАвторизацииИСМПВызовСервера");
									ОбщийМодульИнтерфейсИСМПОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ИнтерфейсИСМПОбщегоНазначенияКлиентСервер");
									
									ПараметрыКлючаСессии = ОбщийМодульИнтерфейсАвторизацииИСМПВызовСервера.ПараметрыКлючаСессии();
									ПараметрыКлючаСессии.КлючСессии  = ДанныеОтвета.Token;
									ПараметрыКлючаСессии.ДействуетДо = ОбщийМодульИнтерфейсИСМПОбщегоНазначенияКлиентСервер.ДатаДействияТокенаИСМПРозница();
									ТипТокенаАвторизации = Перечисления["ТипыТокеновАвторизации"]["ИСМПРозница"];
									ПараметрыЗапросаИСМП = ОбщийМодульИнтерфейсАвторизацииИСМПВызовСервера.ПараметрыЗапросаКлючаСессии(ТипТокенаАвторизации);
									ПараметрыЗапросаИСМП.Организация = ПараметрыОбновленияКлючаСессии.Организация;
									
									ОбщийМодульИнтерфейсАвторизацииИСМПВызовСервера.УстановитьКлючСессии(ПараметрыЗапросаИСМП, ПараметрыКлючаСессии);
									
									РезультатВыполнения.ТребуетсяОбновлениеКлючаСессии = Ложь;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					Иначе
						РезультатВыполнения.Ошибка = Истина;
						РезультатВыполнения.ОписаниеОшибки = ТекстПредупреждения;
					КонецЕсли;
				Иначе
					ТекстПредупреждения = СтрШаблон(НСтр("ru = 'Для организации: %1 не удалось получить ключ авторизации ИС ""Честный знак"".
						|Обратитесь к администратору системы.'"), Строка(ПараметрыОбновленияКлючаСессии.Организация));
					
					РезультатВыполнения.Ошибка = Истина;
					РезультатВыполнения.ОписаниеОшибки = ТекстПредупреждения;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		РезультатВыполнения.ТребуетсяОбновлениеКлючаСессии = Ложь;
	КонецЕсли;
	
	Возврат РезультатВыполнения;
КонецФункции

&НаСервереБезКонтекста
Процедура ОпределитьПараметрыОшибкиНевозможностиПодбора(ЗаголовокОшибки,
		ТекстСообщения, ПараметрыОшибки, РезультатОбработкиШтрихкода)
	
	ОбщегоНазначенияРМКПереопределяемый.ОпределитьПараметрыОшибкиНевозможностиПодбора(ЗаголовокОшибки,
		ТекстСообщения, ПараметрыОшибки, РезультатОбработкиШтрихкода);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьДобавленияВСлучаеУточненияШтрихкода(ДанныеШтрихкода)
	
	Отказ = Ложь;
	ИмяРеквизитаДанныеДляУточненияСведенийПользователя = "ДанныеДляУточненияСведенийПользователя";
	ИмяРеквизитаПараметрыСканирования                  = "ПараметрыСканирования";
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизитаДанныеДляУточненияСведенийПользователя)
		И Не ЭтотОбъект[ИмяРеквизитаДанныеДляУточненияСведенийПользователя] = Неопределено Тогда
		
		ДанныеДляУточненияКода       = ЭтотОбъект[ИмяРеквизитаДанныеДляУточненияСведенийПользователя];
		ДанныеПараметровСканирования = ЭтотОбъект[ИмяРеквизитаПараметрыСканирования];
		
		Модуль = ОбщегоНазначенияКлиент.ОбщийМодуль("ШтрихкодированиеОбщегоНазначенияИСКлиент");
		ТекстСообщения = Модуль.ПроверитьНаНаличиеОшибокУточнения(ДанныеПараметровСканирования, ДанныеШтрихкода, ДанныеДляУточненияКода);
		
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
			Отказ = Ложь;
			// Для Тестирования
			ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения);
			ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
			ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
			// Для Тестирования
		Иначе
			ЭтотОбъект[ИмяРеквизитаДанныеДляУточненияСведенийПользователя] = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

&НаКлиенте
Процедура ПроверкаКодаМаркировкиПриСканированииЗавершение(ДанныеШтрихкода, ДополнительныеПараметры = Неопределено) Экспорт
	
	ИмяРеквизитаКодМаркировкиДляУточнения = "КодМаркировкиДляУточнения";
	РезультатОбработкиШтрихкода = ЭтотОбъект[ИмяРеквизитаКодМаркировкиДляУточнения].РезультатОбработкиШтрихкода;
	
	ДанныеШтрихкодаЗавершение = РезультатОбработкиШтрихкода.ДанныеШтрихкода;
	Если ДанныеШтрихкодаЗавершение.Свойство("ВнешниеДанныеПоШтрихкодам") Тогда
		
		ВнешниеДанныеПоШтрихкодам = ДанныеШтрихкодаЗавершение.ВнешниеДанныеПоШтрихкодам[0];
		ВнешниеДанныеПоШтрихкодам.ПараметрыДляОбработкиШтрихкода.Вставить("ПроверкаМаркиВБиблиотекеГосИС", Истина);
		
		Если ДанныеШтрихкодаЗавершение.Свойство("РазрешительныйРежимИдентификаторЗапросаГИСМТ") Тогда
			Для Каждого СтрокаТовара Из ВнешниеДанныеПоШтрихкодам.ЗначенияПоиска Цикл
				СтрокаТовара.Вставить("РазрешительныйРежимИдентификаторЗапросаГИСМТ",
					ДанныеШтрихкодаЗавершение.РазрешительныйРежимИдентификаторЗапросаГИСМТ);
				СтрокаТовара.Вставить("РазрешительныйРежимДатаЗапросаГИСМТ",
					ДанныеШтрихкодаЗавершение.РазрешительныйРежимДатаЗапросаГИСМТ);
				СтрокаТовара.Вставить("РазрешительныйРежимИдентификаторЭкземпляраПО",
					ДанныеШтрихкодаЗавершение.РазрешительныйРежимИдентификаторЭкземпляраПО);
				СтрокаТовара.Вставить("РазрешительныйРежимВерсияБазы",
					ДанныеШтрихкодаЗавершение.РазрешительныйРежимВерсияБазы);
			КонецЦикла;
		КонецЕсли;
		
		Если ПараметрыПроверкиСредствамиККТ.Свойство("Результат") Тогда
			ДанныеПроверки = ПараметрыПроверкиСредствамиККТ.Результат.ДанныеПроверки;
			
			Для Каждого ЭлементПроверки Из ДанныеПроверки Цикл
				ЗначениеПроверки = ЭлементПроверки.Значение;
				Для Каждого СтрокаТовара Из ВнешниеДанныеПоШтрихкодам.ЗначенияПоиска Цикл
					СтрокаТовара.Вставить("МаркаПроверенаНаККТ", ЗначениеПроверки.ПодтвержденНаККТ);
					СтрокаТовара.Вставить("ОжидатьОтветПроверкиМаркиНаККТ", Не ЗначениеПроверки.ПропуститьОжиданиеОтветаОИСМ);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	ПоискПоШтрихкодуЗавершение(ДанныеШтрихкодаЗавершение);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьФормуУточненияДанных()
	
	ИмяРеквизитаКодМаркировкиДляУточнения              = "КодМаркировкиДляУточнения";
	ИмяРеквизитаДанныеДляУточненияСведенийПользователя = "ДанныеДляУточненияСведенийПользователя";
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизитаКодМаркировкиДляУточнения)
		И ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизитаКодМаркировкиДляУточнения]) Тогда
		
		ПараметрыЗавершенияВводаШтрихкода = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(ЭтотОбъект[ИмяРеквизитаКодМаркировкиДляУточнения]);
		РезультатОбработкиШтрихкода       = ПараметрыЗавершенияВводаШтрихкода.РезультатОбработкиШтрихкода;
		ПараметрыЗавершенияВводаШтрихкода.Форма = ЭтотОбъект;
		
		ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле =
			РезультатОбработкиШтрихкода.Свойство("ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле")
			И РезультатОбработкиШтрихкода.ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле;
			
		ТребуетсяПроверкаРазрешительногоРежимаНаТСПИоТ =
			РезультатОбработкиШтрихкода.Свойство("ТребуетсяПроверкаРазрешительногоРежимаНаТСПИоТ")
			И РезультатОбработкиШтрихкода.ТребуетсяПроверкаРазрешительногоРежимаНаТСПИоТ;
			
		Если РезультатОбработкиШтрихкода.ОткрытьФормуВводаКодаМаркировки Тогда
			
			НастроитьЭлементыФормы(Элементы.СтраницаОбщая, Ложь);
			ПараметрыУточнения = ОбщегоНазначенияРМККлиент.Подключаемый_ОбработатьУточнениеКодаМаркировки(ЭтотОбъект);
			
			// 1. Сканирование GTIN, который сопоставлен с номенклатурой.
			ДанныеДляУточнения = ПараметрыУточнения.ДанныеДляУточненияСведенийПользователя;
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизитаДанныеДляУточненияСведенийПользователя) Тогда
				ЭтотОбъект[ИмяРеквизитаДанныеДляУточненияСведенийПользователя] = ДанныеДляУточнения;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеДляУточнения.Номенклатура) Тогда
				ПоказатьПредупреждениеВПанелиИнфо(НСтр("ru = 'Отсканирован GTIN и найдена номенклатура по GTIN.
					|Отсканируйте КМ.'"));
			КонецЕсли;
			
		ИначеЕсли РезультатОбработкиШтрихкода.ТребуетсяУточнениеДанных Тогда
			
			НастроитьЭлементыФормы(Элементы.СтраницаОбщая, Ложь);
			
			// 2. Сканирование GTIN, который сопоставлен с несколькими номенклатурными позициями
			СписокНоменклатурыДляВыбораПоGTIN = РезультатОбработкиШтрихкода.ДанныеШтрихкода.СписокНоменклатуры;
			НетНоменклатуры = СписокНоменклатурыДляВыбораПоGTIN.Количество() = 0;
			
			Если СписокНоменклатурыДляВыбораПоGTIN.Количество() > 1 Или НетНоменклатуры = Истина Тогда
			
				ДанныеШтрихкода = РезультатОбработкиШтрихкода.ДанныеШтрихкода;
				
				ИдентификаторСтроки = 0;
				Штрихкод = МенеджерОборудованияКлиентСервер.Base64ВШтрихкод(ДанныеШтрихкода.ШтрихкодBase64);
				ИнтерфейсРМКСлужебныйКлиентСервер.ЗаменитьСимволGS1(Штрихкод);
				
				ПараметрыДляОбработкиШтрихкода = Новый Структура();
				
				Если НетНоменклатуры И ДанныеШтрихкода.ЭтоКодВводаОстатков Тогда
					
					ПараметрыДляОбработкиШтрихкода.Вставить("Штрихкод", Штрихкод);
					ПараметрыДляОбработкиШтрихкода.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
					ПроверитьНеобходимостьВводаМарки(ПараметрыДляОбработкиШтрихкода);
					ДополнитьПараметрыДляОбработкиШтрихкода(ПараметрыДляОбработкиШтрихкода);
					
					ДанныеМаркировки = Новый Структура;
					ДанныеМаркировки.Вставить("Разобран", Истина);
					ДанныеМаркировки.Вставить("EAN", ДанныеШтрихкода.EAN);
					
					ПараметрыШтрихкода = Новый Структура;
					ПараметрыШтрихкода.Вставить("ДанныеМаркировки", ДанныеМаркировки);
					ПараметрыШтрихкода.Вставить("ЭтоКодМаркировки", Истина);
					ПараметрыШтрихкода.Вставить("НекорректнаяМарка", Ложь);
					
					СтруктураПараметровКлиента = Новый Структура;
					СтруктураПараметровКлиента.Вставить("ЗначенияПоиска", Новый Массив);
					СтруктураПараметровКлиента.Вставить("ПараметрыШтрихкода", ПараметрыШтрихкода);
					
					ПоказатьПредупреждениеВПанелиИнфо(НСтр("ru = 'Ошибка марки остатков. Обратитесь в службу поддержки.'"));
					Возврат;
					
				Иначе
					
					СтруктураПараметровКлиента = ДанныеШтрихкода.ВнешниеДанныеПоШтрихкодам[0];
					ПараметрыДляОбработкиШтрихкода = СтруктураПараметровКлиента.ПараметрыДляОбработкиШтрихкода;
					
				КонецЕсли;
				
				ПоискПоШтрихкодуЗавершение(ДанныеШтрихкода);
				
			КонецЕсли;
			
		ИначеЕсли РезультатОбработкиШтрихкода.ТребуетсяУточнениеСоставаУпаковки Тогда
			
			ПоказатьПредупреждениеВПанелиИнфо(НСтр("ru = 'Требуется уточнение состава упаковки.'"));
		
		ИначеЕсли РезультатОбработкиШтрихкода.ДанныеШтрихкода.ТребуетсяУточнениеЧастичногоВыбытия Тогда
			
			ПоказатьПредупреждениеВПанелиИнфо(НСтр("ru = 'Требуется уточнение частичного выбытия.'"));
			
		ИначеЕсли РезультатОбработкиШтрихкода.ТребуетсяПроверкаСредствамиККТ
				И Не РезультатОбработкиШтрихкода.ПроверкаСредствамиККТЗавершена
				И Не РезультатОбработкиШтрихкода.ТребуетсяУточнениеДанных
				И Не ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле
				И Не ТребуетсяПроверкаРазрешительногоРежимаНаТСПИоТ Тогда
			
			ИсходныйРезультатВыбора = Неопределено;
			ДанныеШтрихкода = РезультатОбработкиШтрихкода.ДанныеШтрихкода;
			СтруктураПараметровКлиента = ДанныеШтрихкода.ВнешниеДанныеПоШтрихкодам[0];
			ПараметрыДляОбработкиШтрихкода = СтруктураПараметровКлиента.ПараметрыДляОбработкиШтрихкода;
			
			Если РезультатОбработкиШтрихкода.Свойство("СтатусыГотовностиТСПИоТ") Тогда
				
				ИмяРеквизитаПараметрыСканирования = "ПараметрыСканирования";
				ККТ = ЭтотОбъект[ИмяРеквизитаПараметрыСканирования].ККТФФД12ИСМП;
				ОбновитьСтатусТСПИоТ(РезультатОбработкиШтрихкода.СтатусыГотовностиТСПИоТ, ККТ);
				
			КонецЕсли;
			
			Если ПараметрыДляОбработкиШтрихкода.Свойство("ЧастичноеВыбытие") Тогда
			
				ДанныеВыбора = Новый Структура();
				ДанныеВыбора.Вставить("Номенклатура", РезультатОбработкиШтрихкода.ДанныеШтрихкода.Номенклатура);
				ДанныеВыбора.Вставить("ЧастичноеВыбытие", ПараметрыДляОбработкиШтрихкода.ЧастичноеВыбытие);
				ДанныеВыбора.Вставить("Количество", ПараметрыДляОбработкиШтрихкода.ЧастичноеВыбытиеКоличество);
				
				ИсходныйРезультатВыбора = Новый Структура();
				ИсходныйРезультатВыбора.Вставить("ДанныеВыбора", ДанныеВыбора);
				
			КонецЕсли;
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ИдентификаторСтроки", ПараметрыДляОбработкиШтрихкода.ИдентификаторСтроки);
			СтрокиКорзины = Объект.Товары.НайтиСтроки(СтруктураОтбора);
			
			Для Каждого СтрокаКорзины Из СтрокиКорзины Цикл
				Если СтрокаКорзины.ПоштучноеВыбытие Тогда
					ДанныеШтрихкода.Количество = СтрокаКорзины.ЧастичноеВыбытиеКоличество;
					ДанныеШтрихкода.Вставить("ЧастичноеВыбытиеКоличество", ДанныеШтрихкода.Количество);
				КонецЕсли;
			КонецЦикла;
			
			ОповещениеОбОкончанииПроверкиСредствамиККТ = Новый ОписаниеОповещения(
				"ПроверкаКодаМаркировкиПриСканированииЗавершение",
				ЭтотОбъект);
				
			КодМаркировкиДляУточненияРеквизит = ЭтотОбъект[ИмяРеквизитаКодМаркировкиДляУточнения];
			ОбщегоНазначенияРМККлиент.ПроверкаКодаМаркировкиСредствамиККТПоДаннымШтрихкода(
				КодМаркировкиДляУточненияРеквизит.ПараметрыСканирования,
				РезультатОбработкиШтрихкода,
				ЭтотОбъект,
				ОповещениеОбОкончанииПроверкиСредствамиККТ);
			
		ИначеЕсли РезультатОбработкиШтрихкода.ТребуетсяУточнениеКоэффициентовУпаковок Тогда
			
			НоменклатураДляУточнения = "";
			Если РезультатОбработкиШтрихкода.ДанныеШтрихкода.Свойство("Номенклатура") Тогда
				НоменклатураДляУточнения = Строка(РезультатОбработкиШтрихкода.ДанныеШтрихкода.Номенклатура);
			КонецЕсли;
			
			ТекстОшибки = СтрШаблон(НСтр("ru = 'В карточке товара: ""%1"" требуется указать вид упаковки по GTIN.'"), НоменклатураДляУточнения);
			ПоказатьПредупреждениеВПанелиИнфо(ТекстОшибки);
			
		ИначеЕсли ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле Тогда
			
			ОписаниеОповещенияПослеПолучения = Новый ОписаниеОповещения("ПослеПолученияИдентификаторовЛокальногоМодуля",
				ЭтотОбъект, Новый Структура("ПараметрыЗавершенияВводаШтрихкода", ПараметрыЗавершенияВводаШтрихкода));
			ШтрихкодированиеОбщегоНазначенияИСМПКлиент.ОбработатьАсинхронноШтрихкод(ПараметрыЗавершенияВводаШтрихкода,
				ОписаниеОповещенияПослеПолучения);
			
		ИначеЕсли ТребуетсяПроверкаРазрешительногоРежимаНаТСПИоТ Тогда
			
			ОписаниеОповещенияПослеПолучения = Новый ОписаниеОповещения("ПослеПолученияИдентификаторовЛокальногоМодуля",
				ЭтотОбъект, Новый Структура("ПараметрыЗавершенияВводаШтрихкода", ПараметрыЗавершенияВводаШтрихкода));
			ИнтеграцияТСПИоТКлиент.ОбработатьАсинхронноШтрихкод(ПараметрыЗавершенияВводаШтрихкода, ОписаниеОповещенияПослеПолучения);
			
		Иначе
			
			ПоказатьПредупреждениеВПанелиИнфо(НСтр("ru = 'Непредвиденная ситуация. Требуется уточнение по товару.'"));
			
		КонецЕсли;
		
	Иначе
		
		ПоказатьПредупреждениеВПанелиИнфо(НСтр("ru = 'Непредвиденная ситуация. Код маркировки для уточнения отсутствует.'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнениеШагаПроверкиСредствамиККТ()

	ОбщегоНазначенияРМККлиент.ВыполнениеШагаПроверкиСредствамиККТ(ЭтотОбъект, ПараметрыПроверкиСредствамиККТ);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПолученияИдентификаторовЛокальногоМодуля(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеПараметры.Свойство("ПараметрыЗавершенияВводаШтрихкода") Тогда
		Возврат;
	КонецЕсли;
	
	РезультатОбработкиШтрихкода = ДополнительныеПараметры.ПараметрыЗавершенияВводаШтрихкода.РезультатОбработкиШтрихкода;
	РезультатОбработкиШтрихкода.ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле = Ложь;
	РезультатОбработкиШтрихкода.ДанныеШтрихкода = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(Результат.ДанныеВыбора);
	
	ШтрихкодированиеОбщегоНазначенияИСКлиент.ЗавершитьОбработкуШтрихкода(
		ДополнительныеПараметры.ПараметрыЗавершенияВводаШтрихкода);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СообщитьОНевозможностиПодбора()
	
	// Сценарий: есть текущий результат обработки кода маркировки
	ИмяРеквизитаКодМаркировкиДляУточнения = "КодМаркировкиДляУточнения";
	
	РезультатОбработкиШтрихкода = ЭтотОбъект[ИмяРеквизитаКодМаркировкиДляУточнения].РезультатОбработкиШтрихкода;
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока = Неопределено
		И РезультатОбработкиШтрихкода.Свойство("ДанныеШтрихкода")
		И Не РезультатОбработкиШтрихкода.ДанныеШтрихкода = Неопределено
		И РезультатОбработкиШтрихкода.ДанныеШтрихкода.Свойство("ВнешниеДанныеПоШтрихкодам")
		И РезультатОбработкиШтрихкода.ДанныеШтрихкода.ВнешниеДанныеПоШтрихкодам.Количество() > 0 Тогда
			ВнешниеДанныеПоШтрихкодам = РезультатОбработкиШтрихкода.ДанныеШтрихкода.ВнешниеДанныеПоШтрихкодам[0];
			ЭтоСопоставлениеМаркиКТекущейСтроке = 
				ВнешниеДанныеПоШтрихкодам.ПараметрыДляОбработкиШтрихкода.Свойство("ЭтоСопоставлениеМаркиКТекущейСтроке");
				
			Если ЭтоСопоставлениеМаркиКТекущейСтроке И Не Элементы.Товары.ТекущиеДанные = Неопределено Тогда
				ТекущаяСтрока.КодМаркировки = "";
			КонецЕсли;
	КонецЕсли;
	
	РучноеСопоставлениеТовара = Ложь;
	ДанныеДляРучногоСопоставления = Неопределено;
	
	Если ЗначениеЗаполнено(РезультатОбработкиШтрихкода.ТекстОшибки) Тогда
		
		ЗаголовокОшибки = НСтр("ru='Предупреждение'");
		ТекстСообщения = РезультатОбработкиШтрихкода.ТекстОшибки;
		
		Если РезультатОбработкиШтрихкода.Свойство("ТребуетсяАвторизацияИСМПРозница") 
			И РезультатОбработкиШтрихкода.ТребуетсяАвторизацияИСМПРозница Тогда
			ПараметрыОбновленияКлючаСессии = ПараметрыОбновленияКлючаСессии();
			ПараметрыОбновленияКлючаСессии.Организация = Объект.Организация;
			ПараметрыОбновленияКлючаСессии.ПараметрыИСМП.ЛокальныйКонтрольКлючаИСМП = ЛокальныйКонтрольКлючаИСМП;
			ПараметрыОбновленияКлючаСессии.ПараметрыИСМП.ИспользоватьРазрешительныйРежимГосИС = ИспользоватьРазрешительныйРежимГосИС;
			ПараметрыОбновленияКлючаСессии.ПараметрыСервераЛояльности = ПараметрыПодключенияКСерверуЛояльности;
			РезультатОбновленияКлюча = ТребуетсяОбновлениеКлючаСессииСервер(ПараметрыОбновленияКлючаСессии);
			Если РезультатОбновленияКлюча.ТребуетсяОбновлениеКлючаСессии Тогда
				ЗаголовокОшибки = НСтр("ru = 'Ошибка обновления ключа авторизации ИС ""Честный знак""'");
				ТекстСообщения = РезультатОбновленияКлюча.ОписаниеОшибки;
			КонецЕсли;
		ИначеЕсли РезультатОбработкиШтрихкода.Свойство("СтатусыГотовностиТСПИоТ")
					И Не РезультатОбработкиШтрихкода.СтатусыГотовностиТСПИоТ = Неопределено Тогда
				
				ИмяРеквизитаПараметрыСканирования = "ПараметрыСканирования";
				ККТ = ЭтотОбъект[ИмяРеквизитаПараметрыСканирования].ККТФФД12ИСМП;
				ОбновитьСтатусТСПИоТ(РезультатОбработкиШтрихкода.СтатусыГотовностиТСПИоТ, ККТ);
				
		КонецЕсли;
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ЗаголовокОшибки);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		
		ОпределитьПараметрыОшибкиНевозможностиПодбора(ЗаголовокОшибки,
			ТекстСообщения, ПараметрыОткрытияОшибки, РезультатОбработкиШтрихкода);
			
		ВыйтиИзРежимаПлитки();
				
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредупреждениеВПанелиИнфо(ТекстСообщения)
	
	ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения);
	ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
	ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ВывестиСтраницуОжиданияРаспознавания()
	
	Элементы.ЗаголовокОжидания.Заголовок = НСтр("ru='Распознаем товары на весах.'");
	ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОжидание);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементовРедактированияЧека(ЗначениеДоступности)
	
	УстановитьДоступностьЭлементаФормы(Элементы.ГруппаЛево, ЗначениеДоступности);
	УстановитьДоступностьЭлементаФормы(Элементы.ГруппаОперации, ЗначениеДоступности);
	УстановитьДоступностьЭлементаФормы(Элементы.СменитьКассира, ЗначениеДоступности);
	УстановитьДоступностьЭлементаФормы(Элементы["СменитьКассира_Карточка"], ЗначениеДоступности);
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьСтрокуНаСервереПослеДобавленияНаКлиенте(ОбновитьДанныеРазливногоПива)
	
	СтрокаТовара = Объект.Товары.НайтиПоИдентификатору(ТекущийТоварИдентификатор);
	
	Если ОбновитьДанныеРазливногоПива Тогда
		ПродажиРМК.ЗаполнитьДанныеКодовМаркировкиДляВыбора(СтрокаТовара, ЭтотОбъект);
		
		КодыМаркировкиДоступныеДляВыбора = ОбщегоНазначенияРМККлиентСервер.КодыМаркировкиДоступныеДляВыбора(
			СтрокаТовара.КодыМаркировкиПоДаннымИБ, СтрокаТовара.ПредставлениеЕдиницыИзмерения);
		Если КодыМаркировкиДоступныеДляВыбора.Количество() = 1 Тогда
			СтрокаТовара.КодМаркировки = КодыМаркировкиДоступныеДляВыбора.Получить(0).Значение;
			СтрокаТовара.ТребуетсяПроверкаКодаМаркировки = Истина;
		Иначе
			Если ДанныеДобавляемогоТовара <> Неопределено И ДанныеДобавляемогоТовара.Свойство("КомментарийПодключенногоКега") Тогда
				Отбор = Новый Структура("КодМаркировкиПредставление", ДанныеДобавляемогоТовара.КомментарийПодключенногоКега);
				КодыМаркировкиПоКрану = СтрокаТовара.КодыМаркировкиПоДаннымИБ.НайтиСтроки(Отбор);
				Если КодыМаркировкиПоКрану.Количество() <> 0 Тогда
					СтрокаТовара.КодМаркировки = КодыМаркировкиПоКрану[КодыМаркировкиПоКрану.Количество() - 1].ПолныйКодМаркировки;
					СтрокаТовара.ТребуетсяПроверкаКодаМаркировки = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТовара.ТорговыйОбъект) Тогда
		ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьСНОСтрокиПоСкладу(СтрокаТовара, ЭтотОбъект);
	КонецЕсли;
	
	Если ОтображатьОстаток И Не ИспользуютсяСтатическиеОстаткиТоваров Тогда
		ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьКолонкуОстаток(СтрокаТовара, Объект.ТорговыйОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСтрокиПоСкладу(СтрокаТаблицы)
	
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьСНОСтрокиПоСкладу(СтрокаТаблицы, ЭтотОбъект);
	
	Если ОтображатьОстаток Тогда
		ТорговыйОбъектОстатки = ?(НЕ ЗначениеЗаполнено(СтрокаТаблицы.ТорговыйОбъект), Объект.ТорговыйОбъект, СтрокаТаблицы.ТорговыйОбъект);
		ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьКолонкуОстаток(СтрокаТаблицы, ТорговыйОбъектОстатки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьСостояниеКассовойСменыВызовСервера(ПоказыватьСтатусСмен)
	
	ПроверитьВозможностьРаботы();
	
	Если ИспользоватьОплатуНаличными Тогда
		СписокСмен = ТаблицаКассККМОрганизаций;
		Если ЗначениеЗаполнено(КассаККМДляОперации) Тогда
			Отбор = Новый Структура("КассаККМ", КассаККМДляОперации);
			СтрокиКассы = ТаблицаКассККМОрганизаций.НайтиСтроки(Отбор);
			Если ЗначениеЗаполнено(СтрокиКассы) Тогда
				СписокСмен = СтрокиКассы;
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьНаличныеДенежныеСредстваСмены(СписокСмен);
	КонецЕсли;
	
	Если ПоказыватьСтатусСмен Тогда
		АктуализироватьСостояниеСтатусаКассовыхСменСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиРазделУчетаНаличных(Макет, ОтчетЗаСмену, КлиентскиеДанныеОтчетаЗаСмену, СерверныеДанныеОтчетаЗаСмену, ОтборКасса)
	
	НаличныеНаНачалоСмены = 0;
	СуммаВнесений = 0;
	СуммаВыемок = 0;
	ПриходНаличных = 0;
	РасходНаличных = 0;
	ТекущийОстатокНаличных = 0;
	ИтогоНаличных = 0;
	
	ОтборСтрокКассы = Новый Структура("Касса", ОтборКасса);
	
	Кассы = СерверныеДанныеОтчетаЗаСмену.ТаблицаКасс.НайтиСтроки(ОтборСтрокКассы);
	Если Кассы.Количество() > 0 Тогда
		СтрокаКассы = Кассы[0];
		НаличныеНаНачалоСмены = СтрокаКассы.НаличныеНаНачало;
		ТекущийОстатокНаличных = СтрокаКассы.НаличныеТекущийОстаток;
		СуммаВнесений = СтрокаКассы.СуммаВнесений;
		СуммаВыемок = СтрокаКассы.СуммаВыемок;
	КонецЕсли;
	Суммы = СерверныеДанныеОтчетаЗаСмену.ТаблицаСумм.НайтиСтроки(ОтборСтрокКассы);
	Для Каждого СтрокаСуммы Из Суммы Цикл
		
		Если СтрокаСуммы.ВидОплаты = "Наличные" Тогда
			ПриходНаличных = ПриходНаличных + СтрокаСуммы.СуммаПродаж;
			РасходНаличных = РасходНаличных + СтрокаСуммы.СуммаВозвратов;
		КонецЕсли;
		РасходНаличных = РасходНаличных + СтрокаСуммы.СуммаВыдачиНаличных;
		
	КонецЦикла;
	
	Если КлиентскиеДанныеОтчетаЗаСмену.ИспользоватьОплатуНаличными Тогда
	
		ОбластьУчетНаличных = Макет.ПолучитьОбласть("УчетНаличных");
		ОбластьУчетНаличных.Параметры.НаличныеНаНачалоСмены = НаличныеНаНачалоСмены;
		ОбластьУчетНаличных.Параметры.СуммаВнесений = СуммаВнесений;
		ОбластьУчетНаличных.Параметры.СуммаВыемок = -СуммаВыемок;
		ОбластьУчетНаличных.Параметры.ПриходНаличных = ПриходНаличных;
		ОбластьУчетНаличных.Параметры.РасходНаличных = -РасходНаличных;
		ОбластьУчетНаличных.Параметры.ИтогоНаличных = НаличныеНаНачалоСмены + СуммаВнесений - СуммаВыемок + ПриходНаличных - РасходНаличных;
		
		ОбластьУчетНаличных.Параметры.ТекущийОстатокНаличных = ТекущийОстатокНаличных;
		
		ОтчетЗаСмену.Вывести(ОбластьУчетНаличных);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВызватьПолныйАвтоматическийРасчетСкидок()
	
	Если (РежимРаботыСЧеком = РежимыРаботыСЧеком.ВводТоваров Или РежимРаботыСЧеком = РежимыРаботыСЧеком.ЧекПустой)
		И ПолныйРасчетСкидок
		И Не РаботаВРежимеМедленногоСоединения Тогда
		
		РассчитатьСкидкиКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеДляОтправкиЧека(ПочтаКонтрагента, ТелефонКонтрагента)
	
	ОтправкаЧекаПочта	= ПочтаКонтрагента;
	ОтправкаЧекаТелефон	= ТелефонКонтрагента;
		
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицуПлатежныхКарт()
	
	Если КоличествоДополнительныхКарт = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УдалятьРеквизитыОплатыКартой = Ложь;
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоДополнительныхКарт Цикл
		Если ИспользоватьОплатуНесколькимиКартами И ИндексСтроки > 0 Тогда
			УдалятьРеквизитыОплатыКартой = Истина;
			Прервать;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Если УдалятьРеквизитыОплатыКартой Тогда
		ОчиститьТаблицуПлатежныхКартИУдалитьРеквизиты();
		Возврат;
	КонецЕсли;
	
	ВосстановитьЭлементыОплатыКартой(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыОплатыКартой(ИндексЭлемента)
	
	ПараметрыУвеличенногоИнтерфейса = ИнтерфейсРМКСлужебный.ПараметрыУвеличенногоИнтерфейса(ВидОтображения);
	ШрифтСуммы = ?(ВидОтображения = Перечисления.ВидыОтображения.Увеличенный, ПараметрыУвеличенногоИнтерфейса.ШрифтСуммОплат, ШрифтыСтиля.ШрифтОбычныйПолужирныйРМК);
	
	// Добавляем реквизиты на форму
	ДобавляемыеРеквизиты = Новый Массив;
	
	ТипРеквизита  = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.НеотрицательноеЧисло15_2_РМК.Тип);
	ИмяРеквизита  = "СуммаОплаченоБН_" + ИндексЭлемента;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	РеквизитФормы = Новый РеквизитФормы(ИмяРеквизита, ТипРеквизита);
	
	ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	ЭтотОбъект[ИмяРеквизита] = 0;
	
	ИмяГруппыОплаты = "ГруппаОплатаКартой_" + ИндексЭлемента;
	ГруппаЭлементовОплаты = Элементы.Добавить(ИмяГруппыОплаты, Тип("ГруппаФормы"), Элементы.ГруппаОплатаКартами);
	ГруппаЭлементовОплаты.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	
	ГруппаЭлементовОплаты.ОтображатьЗаголовок = Ложь;
	ГруппаЭлементовОплаты.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаЭлементовОплаты.РастягиватьПоГоризонтали = Истина;
	
	ПолеЭталон = Элементы.СуммаОплаченоБН;
	ПолеСуммаОплатыБН = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), ГруппаЭлементовОплаты);
	ПолеСуммаОплатыБН.ПутьКДанным = ИмяРеквизита;
	ПолеСуммаОплатыБН.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСуммаОплатыБН.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеСуммаОплатыБН.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	ПолеСуммаОплатыБН.КнопкаВыбора = Истина;
	ПолеСуммаОплатыБН.Ширина = ПолеЭталон.Ширина;
	ПолеСуммаОплатыБН.Шрифт = ШрифтСуммы;
	ПолеСуммаОплатыБН.Заголовок = Нстр(("ru = 'Сумма'"));
	ПолеСуммаОплатыБН.АвтоМаксимальнаяШирина = Ложь;
	ПолеСуммаОплатыБН.РастягиватьПоГоризонтали = Истина;
	ПолеСуммаОплатыБН.КартинкаКнопкиВыбора = БиблиотекаКартинок.РМКЦифроваяПанель;
	
	ПолеСуммаОплатыБН.УстановитьДействие("ПриИзменении", "СуммаОплаченоБНПриИзменении");
	ПолеСуммаОплатыБН.УстановитьДействие("НачалоВыбора", "СуммаОплаченоБННачалоВыбора");
	ПолеСуммаОплатыБН.УстановитьДействие("АвтоПодбор", "СуммаОплаченоБНАвтоПодбор");
	ПолеСуммаОплатыБН.УстановитьДействие("ОкончаниеВводаТекста", "СуммаОплаченоБНОкончаниеВводаТекста");
	
	ИмяКнопки = "УдалитьОплатуКартой_" + ИндексЭлемента;
	НоваяКнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), ГруппаЭлементовОплаты);
	НоваяКнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НоваяКнопка.ИмяКоманды = "УдалитьОплатуКартой";
	НоваяКнопка.Важность = ВажностьКнопки.Дополнительная;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьРеквизитыОплатыКартой(ИндексОплатыКартой)
	
	ИндексУдаления = Строка(ИндексОплатыКартой);
	НаименованиеУдаляемогоРеквизита = "СуммаОплаченоБН_" + ИндексУдаления;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, НаименованиеУдаляемогоРеквизита) Тогда
		
		УдаляемыеРеквизиты = Новый Массив;
		УдаляемыеРеквизиты.Добавить("СуммаОплаченоБН_" + ИндексУдаления);
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);
		
		УдалитьЭлементФормы("УдалитьОплатуКартой_" + ИндексУдаления);
		УдалитьЭлементФормы("ГруппаОплатаКартой_" + ИндексУдаления);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСуммуОплатыЧека(СуммаОперации, ЭтоПродажа = Истина)
	
	СтруктураОтбора = ВыбраннаяОрганизацияИСНО();
	СтруктураОтбора.Вставить("Сумма", СуммаОперации);
	СтруктураОтбора.Вставить("Оплачено", Не ЭтоПродажа);
	СтрокиОплаты = ТаблицаОплатКартой.НайтиСтроки(СтруктураОтбора);
	Если СтрокиОплаты.Количество() > 0 Тогда
		СтрокаОплатыКартой = СтрокиОплаты[0];
		СтрокаОплатыКартой.Оплачено = ЭтоПродажа;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, "ВыбранныйВидОплаты") Тогда
			ВидОплатыКартой = ЭтотОбъект.ВыбранныйВидОплаты;
		Иначе
			ВидОплатыКартой = ЭквайринговыйТерминалВыполненияОперации;
		КонецЕсли;
	КонецЕсли;
	
	Отказ = Ложь;
	ТекстОшибки = "";
	
	ДополнительныеДанные = ДополнительныеДанныеДляФискализации();
	ОбщегоНазначенияРМККлиентПереопределяемый.ЗаполнитьДополнительныеДанныеДляПробитияЧека(ЭтотОбъект,
		ДополнительныеДанные);
	ЗаписатьЧекККМПередПробитием(ДополнительныеДанные, Отказ, ТекстОшибки);
	ОбновитьРеквизитыФормыПослеПодготовкиДанныхДляЧека(ДополнительныеДанные);
	
	СтруктураОтбора = ВыбраннаяОрганизацияИСНО();
	СтруктураОтбора.Вставить("Оплачено", ЭтоПродажа);
	
	СуммаОплаченоБНЧастично = 0;
	СтрокиОплаты = ТаблицаОплатКартой.НайтиСтроки(СтруктураОтбора);
	Для Каждого СтрокаОплаты Из СтрокиОплаты Цикл
		СуммаОплаченоБНЧастично = СуммаОплаченоБНЧастично + СтрокаОплаты.Сумма;
	КонецЦикла;
	Если СуммаОплаченоБН = СуммаОплаченоБНЧастично Тогда
		ТранзакцияПоКартеЗавершена = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРеквизитыФормыПослеПодготовкиДанныхДляЧека(ДополнительныеДанные)
	
	ЧекККМВОбработке = ДополнительныеДанные.РеквизитыФормы.ЧекККМВОбработке;
	ОбщегоНазначенияРМККлиентПереопределяемый.ОбновитьРеквизитыФормыПослеПодготовкиДанныхДляЧека(ЭтотОбъект,
		ДополнительныеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекстКороткогоСлипЧека(РезультатВыполнения)
	
	СтруктураОтбора = ВыбраннаяОрганизацияИСНО();
	СтрокиОплаты = ТаблицаОплатКартой.НайтиСтроки(СтруктураОтбора);
	
	Если СтрокиОплаты.Количество() > 1 ИЛИ НЕ ПечататьКороткийСлипЧек Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерОборудованияРМККлиент.ЗаполнитьТекстКороткогоСлипЧека(РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКВозвратуЧека(Знач ЧекНаВозврат)
	
	Результат = Новый Структура("ЧекККМ", ЧекНаВозврат);
	УстановитьДоступностьЭлементаФормы(Элементы.ГруппаВидовОплат, Истина);
	Объект.ВидОперации = ОбщегоНазначенияРМККлиент.ВидТекущейОперации(Истина);
	КассирДоЗаменыПрав = Объект.Кассир;
	ВыборЧекаЗавершение(Результат, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура АктуализироватьПервоначальноеСостояниеСтатусаКассовыхСмен(НастройкиЭлементов)
	
	Если ЗначениеЗаполнено(ТекущаяНастройкаРМК) И (Не РежимКассыСамообслуживания)
			И ИнтерфейсРМКСлужебныйКлиентСервер.ПоказыватьСтатусКассовыхСмен(НастройкиЭлементов) Тогда
		АктуализироватьСостояниеСтатусаКассовыхСменСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АктуализироватьСостояниеСтатусаКассовыхСменСервер()
	
	СтатусСменИзменился = Ложь;
	ДатаТекущая = ТекущаяДатаСеанса();
	ГрупповойСтатусСмен = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьГрупповойСтатусКассовыхСмен(ЭтотОбъект, ДатаТекущая,
		СтатусСменИзменился);
	Если СтатусСменИзменился Тогда
		ИнтерфейсРМКСлужебный.ОбновитьКнопкуСтатусаКассовыхСмен(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АктуализироватьСостояниеСтатусаКассовыхСменПриНеобходимостиКлиент()
	
	Если (Не РежимКассыСамообслуживания)
			И ИнтерфейсРМКСлужебныйКлиентСервер.ПоказыватьСтатусКассовыхСмен(СвойстваНастроекЭлементов) Тогда
		
		СтатусСменИзменился = Ложь;
		ДатаТекущая = ОбщегоНазначенияКлиент.ДатаСеанса();
		ГрупповойСтатусСмен = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьГрупповойСтатусКассовыхСмен(ЭтотОбъект, ДатаТекущая,
			СтатусСменИзменился);
		Если СтатусСменИзменился Тогда
			ОбновитьКнопкуСтатусаКассовыхСмен();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКнопкуСтатусаКассовыхСмен()
	ИнтерфейсРМКСлужебный.ОбновитьКнопкуСтатусаКассовыхСмен(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПодборМарок(СтрокаАдреса)
	
	СтрокиТоваровСМарками = ТоварыПодобранныхМарок(СтрокаАдреса);
	
	Если СтрокиТоваровСМарками.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТовараСМаркой Из СтрокиТоваровСМарками Цикл
		
		ТекущийВыбор = СтрокаТовараСМаркой.ДанныеДобавляемогоТовара;
		РеквизитыФормыРМК = СтруктураРеквизитовФормыРМКДляДобавленияСтроки();
		
		ПараметрыШтрихкода = Новый Структура;
		ПараметрыШтрихкода.Вставить("ЭтоКодМаркировки", Истина);
		
		ПараметрыДляОбработкиШтрихкода = Новый Структура;
		ПараметрыДляОбработкиШтрихкода.Вставить("ПараметрыШтрихкода", ПараметрыШтрихкода);
		ПараметрыДляОбработкиШтрихкода.Вставить("ДозаполнитьПоВосстановленнойМарке", Истина);
		ДополнитьПараметрыДляОбработкиШтрихкода(ПараметрыДляОбработкиШтрихкода);
		РеквизитыФормыРМК.Вставить("ПараметрыДляОбработкиШтрихкода", ПараметрыДляОбработкиШтрихкода);
		ТекущийВыбор.Вставить("РеквизитыФормыРМК", РеквизитыФормыРМК);
		ТекущийВыбор.Вставить("ПолучитьЦену", Истина);
		
		ДанныеТовара = СтрокаТовараНаКлиентеСервере(ТекущийВыбор, ЭтотОбъект);
		СтрокаТовара = ДанныеТовара.СтрокаТовара;
		
		СтрокаТовара.КодМаркировки = СтрокаТовараСМаркой.Штрихкод;
		СтрокаТовара.РазрешительныйРежимДатаЗапросаГИСМТ          = СтрокаТовараСМаркой.РазрешительныйРежимДатаЗапросаГИСМТ;
		СтрокаТовара.РазрешительныйРежимИдентификаторЗапросаГИСМТ = СтрокаТовараСМаркой.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
		
		ДобавитьСтрокуВТабличнуюЧастьНаКлиенте(СтрокаТовара, Истина);
		
		РассчитатьСуммуВСтрокеТабличнойЧасти();
		
	КонецЦикла;
	
	ЕстьНезаполненныеДанные = ЕстьНезаполненныеДанные();
	РассчитатьСуммуОплатыБонусами();
	ОбработатьИзменениеТаблицыТоваровНаКлиенте(Не ЕстьНезаполненныеДанные);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТоварыПодобранныхМарок(СтрокаАдреса)
	Возврат ОбщегоНазначенияРМК.ТоварыПодобранныхМарок(СтрокаАдреса);
КонецФункции

&НаКлиенте
Процедура ПослеАвторизацииТСПИоТ(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Свойство("Результат") И Результат.Результат Тогда
		
		Если Результат.Свойство("СтатусСостояния") И Результат.СтатусСостояния <> Неопределено Тогда
			
			ОбновитьСтатусТСПИоТ(Результат.СтатусСостояния, ДополнительныеПараметры.ККТ);
			
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("ЗапуститьОбработкуСтатусовТСПИоТ", 0.5, Истина);
		
	Иначе
		
		ОбновитьСтатусТСПИоТ(Неопределено, ДополнительныеПараметры.ККТ);
		
		Если Результат.Свойство("ОписаниеОшибки") И ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
			
			ТекстЗаголовка = НСтр("ru = 'Ошибка авторизации ТС ПИоТ.'");
			ТекстСообщения = Результат.ОписаниеОшибки;
			ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ТекстЗаголовка);
			ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
			ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПолученияСтатусовТСПИоТ(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Свойство("Результат") И Результат.Результат Тогда
		
		Если Результат.Свойство("СтатусСостояния") И Результат.СтатусСостояния <> Неопределено Тогда
			
			ОбновитьСтатусТСПИоТ(Результат.СтатусСостояния, ДополнительныеПараметры.ККТ);
			
			Отбор = Новый Структура("ИдентификаторУстройства", ДополнительныеПараметры.ККТ);
			СтрокиКасс = ТаблицаКассККМОрганизаций.НайтиСтроки(Отбор);
			
			Для каждого СтрокаКассы Из СтрокиКасс Цикл
				
				Если (СтрокаКассы.АвторизацияПройденаТСПИоТ И СтрокаКассы.ГотовКРаботеТСПИоТ)
						Или СтрокаКассы.АварийныйРежимТСПИоТ Тогда
					
					СтрокаКассы.ИдетОбработкаСтатусаТСПИоТ = Ложь;
					
				КонецЕсли;
				
				ПодключитьОбработчикОжидания("ЗапуститьОбработкуСтатусовТСПИоТ", 0.5, Истина);
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		ОбновитьСтатусТСПИоТ(Неопределено, ДополнительныеПараметры.ККТ);
		
		Если Результат.Свойство("ОписаниеОшибки") И ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
			
			ТекстЗаголовка = НСтр("ru = 'Ошибка обновления статуса ТС ПИоТ.'");
			ТекстСообщения = Результат.ОписаниеОшибки;
			ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ТекстЗаголовка);
			ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
			ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусТСПИоТ(Статус, ККТ)
	
	ОбщегоНазначенияРМККлиент.ОбновитьСтатусТСПИоТ(Статус, ККТ, ТаблицаКассККМОрганизаций);
	
	Отбор = Новый Структура("ИдентификаторУстройства", ККТ);
	СтрокиКасс = ТаблицаКассККМОрганизаций.НайтиСтроки(Отбор);
	
	Для каждого СтрокаКассы Из СтрокиКасс Цикл
		
		ОбновитьОтображениеСтатусаТСПИоТ(СтрокаКассы)
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеСтатусаТСПИоТ(СтрокаКассы)
	
	ПоказыватьСтатусСмен = (Не РежимКассыСамообслуживания)
		И ИнтерфейсРМКСлужебныйКлиентСервер.ПоказыватьСтатусКассовыхСмен(СвойстваНастроекЭлементов);
	
	Если ПоказыватьСтатусСмен Тогда
		
		ТСПИоТГотов = ТСПИоТГотовКРаботе();
		
		Если ТСПИоТГотов Тогда
			
			Иконка = БиблиотекаКартинок.РМКУспешноеСканирование;
			
		Иначе
			
			Иконка = БиблиотекаКартинок.РМКОшибкаСканирования;
			
		КонецЕсли;
		
		Элементы.ДекорацияСтатусТСПИоТ.Картинка = Иконка;
		
	КонецЕсли;
	
	ОбновитьСтатусТСПИоТНаФормеВыбораКассККМ(СтрокаКассы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусТСПИоТНаФормеВыбораКассККМ(СтрокаКассы)
	
	ФормаКассовыхСмен = НайтиФормуПоИмени("Обработка.РабочееМестоКассира.Форма.ФормаУправленияКассовымиСменами");
	УправлениеСменамиОткрыто = ((Не ФормаКассовыхСмен = Неопределено) И ФормаКассовыхСмен.Открыта());
	Если УправлениеСменамиОткрыто Тогда
		ОповещаниеОбновленияСтатусаТСПИоТ = Новый ОписаниеОповещения("ОбновитьСтатусТСПИоТИзВнешнихДанных", ФормаКассовыхСмен, СтрокаКассы);
		ВыполнитьОбработкуОповещения(ОповещаниеОбновленияСтатусаТСПИоТ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТСПИоТГотовКРаботе()
	
	ТСПИоТГотов = Ложь;
	
	Для каждого ККТ Из ТаблицаКассККМОрганизаций Цикл
		
		Если ККТ.НастроенТСПИоТ Тогда
			
			ТСПИоТГотов = ККТ.ГотовКРаботеТСПИоТ;
			
			Если Не ТСПИоТГотов Тогда
			
				Возврат ТСПИоТГотов;
			
			КонецЕсли;
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТСПИоТГотов;
	
КонецФункции // ТСПИоТГотов()

&НаСервереБезКонтекста
Функция ПолучитьПараметрыАварийногоРежима()
	
	ПараметрыАварийногоРежима = Неопределено;
	ОбщегоНазначенияРМКПереопределяемый.ПолучитьПараметрыАварийногоРежима(ПараметрыАварийногоРежима);
	
	Возврат ПараметрыАварийногоРежима;
	
КонецФункции

&НаКлиенте
Процедура ПослеОбработкиФормыУточненияАварийногоРежима(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Свойство("АктивностьРежима") Тогда
		
		ОбщегоНазначенияРМККлиентПереопределяемый.ОбработатьИзменениеАварийногоРежима(Результат);
		
		ПараметрыАварийногоРежима = ПолучитьПараметрыАварийногоРежима();
		
		Если ПараметрыАварийногоРежима = Неопределено Тогда
			
			Возврат;
			
		Иначе
			
			Если Не ПараметрыАварийногоРежима.Включено Тогда
				
				Отбор = Новый Структура;
				Отбор.Вставить("АварийныйРежимТСПИоТ", Истина);
				
				СтрокиКассВАварийномРежиме = ТаблицаКассККМОрганизаций.НайтиСтроки(Отбор);
				
				Для каждого СтрокаКассыВАварийномРежиме Из СтрокиКассВАварийномРежиме Цикл
					
					СтрокаКассыВАварийномРежиме.АварийныйРежимТСПИоТ = Ложь;
					
				КонецЦикла;
				
				ПодключитьОбработчикОжидания("ЗапуститьОбработкуСтатусовТСПИоТ", 0.5, Истина);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция  СоздатьДокументКассоваяСменаБезТО(ПараметрыКассовойСмены, Отказ)
	
	Возврат ОбщегоНазначенияРМК.ОткрытьКассовуюСменуБезОборудования(Отказ, ПараметрыКассовойСмены);
	
КонецФункции

&НаКлиенте
Функция ПодготовитьДанныеКассовойСменыКСО()
	
	ПараметрыКассовойСмены = Новый Структура();
	Если ТаблицаКассККМОрганизаций.Количество() = 1 Тогда
		СтрокаКассыККМ = ТаблицаКассККМОрганизаций[0];
		ПараметрыКассовойСмены.Вставить("КассаККМ", СтрокаКассыККМ.КассаККМ);
		ПараметрыКассовойСмены.Вставить("СменаОткрыта", СтрокаКассыККМ.Открыта);
		ПараметрыКассовойСмены.Вставить("НачалоКассовойСмены", СтрокаКассыККМ.НачалоКассовойСмены);
		ПараметрыКассовойСмены.Вставить("ВремяНачалаСмены", ВремяНачалаСмены);
	Иначе
		ПараметрыКассовойСмены.Вставить("КассаККМ", Неопределено);
	КонецЕсли;
	
	Возврат ПараметрыКассовойСмены;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьОборудованиеДляСверкиКПередаче()
	
	РезультатФункции = Новый Массив;
	Если Не ИспользоватьОплатуПлатежнымиКартами Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	
	ТерминалыДляСверкиИтогов = ТерминалыДляСверкиИтогов(ТаблицаТерминалы);
	Для Каждого Терминал Из ТерминалыДляСверкиИтогов Цикл
		
		Если НЕ Терминал.ИспользоватьБезПодключенияОборудования
			И ЗначениеЗаполнено(Терминал.ПодключаемоеОборудование) Тогда
			
			Отбор = Новый Структура("Организация", Терминал.Организация);
			НайденыСтрокиКассы = ТаблицаКассККМОрганизаций.НайтиСтроки(Отбор);
			Если НайденыСтрокиКассы.Количество() > 0 Тогда
				СтрокаКассы = НайденыСтрокиКассы[0];
				ПодключаемоеОборудованиеДляСверки = СтрокаКассы.ИдентификаторУстройства;
			Иначе
				ПодключаемоеОборудованиеДляСверки = ПодключаемоеОборудование;
			КонецЕсли;
			
			ДанныеТерминала = Новый Структура;
			ДанныеТерминала.Вставить("Терминал", Терминал.ПодключаемоеОборудование);
			ДанныеТерминала.Вставить("ККМ", ПодключаемоеОборудованиеДляСверки);
			
			РезультатФункции.Добавить(ДанныеТерминала);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Функция ОбнаруженыАктивныеДействияПользователя()
	
	РезультатФункции = (ОткрытаСтраницаПоискаТовара()
		Или РежимЦифровойПанели = РежимыЦифровойПанели.ДанныеПокупателя
		Или Не Сокрлп(Элементы.ВводТовараПоСтроке.ТекстРедактирования) = "");
	
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДанныеРМКПриВозможности()
	
	Если РежимРаботыСЧеком = РежимыРаботыСЧеком.ЧекПустой
			Или РежимРаботыСЧеком = РежимыРаботыСЧеком.ПродолжениеПослеПробития Тогда
	
		Если Не (ТипПостроенияПлитки = ТипыПостроенияПлитки.РаспознанныйВесовойТовар
				Или ОбнаруженыАктивныеДействияПользователя()) Тогда

			ОбновитьДанныеРМК();
		
		КонецЕсли;
		ИнтервалОбновления = 30;
		ПодключитьОбработчикОжидания("ОбновитьДанныеРМКПриВозможности", ИнтервалОбновления, Истина);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеРМК()
	
	ДатаТекущая = ОбщегоНазначенияКлиент.ДатаСеанса();
	
	СтатусСменИзменился = Ложь;
	Если (Не РежимКассыСамообслуживания)
			И ИнтерфейсРМКСлужебныйКлиентСервер.ПоказыватьСтатусКассовыхСмен(СвойстваНастроекЭлементов) Тогда
		ГрупповойСтатусСмен = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьГрупповойСтатусКассовыхСмен(ЭтотОбъект, ДатаТекущая,
			СтатусСменИзменился);
	КонецЕсли;
	ФормаПлиточногоИнтерфейсаДоступна
		= ЕстьВесовойТоварВПлитке Или ЗначениеЗаполнено(СтруктураПлиточногоИнтерфейсаПодбора);
	
	ОбновитьДанныеИзбранных = Ложь;
	ОбновитьДанныеПлиток = Ложь;
	ОбновитьНаличныеВКассеККМ = Ложь;
	
	СтруктураДействийНаКлиентеПриОбновлении = Новый Структура;
	СтруктураДействийНаКлиентеПриОбновлении.Вставить("ОбновитьДанныеИзбранных", Ложь);
	СтруктураДействийНаКлиентеПриОбновлении.Вставить("ОбновитьДанныеПлиток", Ложь);
	СтруктураДействийНаКлиентеПриОбновлении.Вставить("ОбновитьНаличныеВКассеККМ", Ложь);
	СтруктураДействийНаКлиентеПриОбновлении.Вставить("СтатусСменИзменился", СтатусСменИзменился);
	СтруктураДействийНаКлиентеПриОбновлении.Вставить("ФормаПлиточногоИнтерфейсаДоступна",
		ФормаПлиточногоИнтерфейсаДоступна);

	Если ТребуетсяОбновлениеДанныхРМКНаСервере(СтруктураДействийНаКлиентеПриОбновлении) Тогда
		ОбновлениеДанныхРМКНаСервере(СтруктураДействийНаКлиентеПриОбновлении);
	КонецЕсли;
	
	Если СтруктураДействийНаКлиентеПриОбновлении.ОбновитьДанныеИзбранных Тогда
		ЗаполнитьКнопкиИзбранныхПозиций();
	КонецЕсли;
	
	Если СтруктураДействийНаКлиентеПриОбновлении.ОбновитьДанныеПлиток Тогда
		ЗаполнитьКнопкиПлиток();
	КонецЕсли;
	
	Если СтруктураДействийНаКлиентеПриОбновлении.ОбновитьНаличныеВКассеККМ Тогда
		ОтразитьОстаткиНаличныхДенежныхСредствНаФорме(Объект.Организация, Объект.КассаККМ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТребуетсяОбновлениеДанныхРМКНаСервере(СтруктураДействийНаКлиентеПриОбновлении)
	
	Возврат (ИспользоватьПанельИзбранныхТоваров Или ИспользоватьОплатуНаличными
		Или СтруктураДействийНаКлиентеПриОбновлении.ФормаПлиточногоИнтерфейсаДоступна
		Или СтруктураДействийНаКлиентеПриОбновлении.СтатусСменИзменился);
	
КонецФункции

&НаСервере
Процедура ОбновлениеДанныхРМКНаСервере(СтруктураДействийНаКлиентеПриОбновлении)
	
	Если ИспользоватьПанельИзбранныхТоваров Тогда
		СтруктураДействийНаКлиентеПриОбновлении.ОбновитьДанныеИзбранных = ПерезаполнитьИзбранное();
	КонецЕсли;
	
	Если СтруктураДействийНаКлиентеПриОбновлении.ФормаПлиточногоИнтерфейсаДоступна Тогда
		СтруктураДействийНаКлиентеПриОбновлении.ОбновитьДанныеПлиток = ПерезаполнитьПлиточныйИнтерфейс();
	КонецЕсли;
	
	Если СтруктураДействийНаКлиентеПриОбновлении.ОбновитьДанныеИзбранных
			Или СтруктураДействийНаКлиентеПриОбновлении.ОбновитьДанныеПлиток Тогда
		ОбновитьЦеныИзбранныхИПлиток();
	КонецЕсли;
	
	Если ИспользоватьОплатуНаличными Тогда
		Для Каждого СтрокаКассыККМ Из ТаблицаКассККМОрганизаций Цикл
			ЗаполнитьНаличныеВКассеККМ(СтрокаКассыККМ);
		КонецЦикла;
		СтруктураДействийНаКлиентеПриОбновлении.ОбновитьНаличныеВКассеККМ = Истина;
	КонецЕсли;
	
	Если СтруктураДействийНаКлиентеПриОбновлении.СтатусСменИзменился Тогда
		ИнтерфейсРМКСлужебный.ОбновитьКнопкуСтатусаКассовыхСмен(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуУправленияКассовойСменойВКСО()
	
	КассовыеОперации = ИнтерфейсРМКСлужебныйКлиент.КассовыеОперации();
	ОткрытьФормуУправленияКассовымиСменами(КассовыеОперации.УправлениеСменами);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытииПродолжение(ОтложеннаяПроверкаКассовойСмены)
	
	ОперацияЧека = ОперацииЧека.Продажа;
	Если РежимКассыСамообслуживания Тогда
		ОформитьРежимНовогоЧека("Продажа");
	КонецЕсли;
	ИзменитьКартинкуВводПокупателя();
	ПоискТоваровОткрытИзСтрокиВвода = Ложь;

	ДанныеДляПлитки = Новый Массив;
	ТипПостроенияПлитки = ТипыПостроенияПлитки.ПоПалитре;
	ИнтерфейсРМКСлужебныйКлиент.ПодготовитьДанныеДляПлитки(ЭтотОбъект);
	ЗаполнитьКнопкиИзбранныхПозиций();
	ЗаполнитьКнопкиПлиток();
	
	СкрытьКомандуЗавершенияРаботыПриНеобходимости();
	Если Не (РежимКассыСамообслуживания Или ОсновнойПодборПлиточный) Тогда
		ОбновитьСостояниеЭлементовПриИзмененииТаблицыТоваров();
	КонецЕсли;
	ПереключатьсяВРежимПлитки = ОсновнойПодборПлиточный;
	ПереключитьВРежимПлитки();
	ОбновлятьСуммуАванса = Ложь;
	ПереключениеЦифровойПанели = Ложь;
	ВводСЦифровойКлавиатуры = Ложь;
	ТекущаяСтрокаРедактированияКоличества = Неопределено;
	ПробитиеСоСтраницыОтправкиЧека = Ложь;
	Если ОтложеннаяПроверкаКассовойСмены Тогда
		ПодключитьОбработчикОжидания("ПроверитьКассовуюСменуИНайтиКассираВФоне", 0.1, Истина);
	КонецЕсли;
	НастроитьДоступностьГорячейКлавишиEnter();
	ФильтрПоискаПоШтрихкоду = Новый Структура("Номенклатура");
	ПустаяСтрокаТаблицыТоваров = СтруктураПустойСтрокиТаблицыТоваров();
	КэшУточненияПринадлежностиЗапасов = Новый Соответствие;
	СписокИдентификаторовСтрокДляУточнения = Новый СписокЗначений;
	КэшиСтрокТоваров = ОбщегоНазначенияРМККлиент.СтруктураКэшовСтрокТоваров();
	ЗаполнитьКэшПлитки();
	ПараметрыЗакрытияСменыПриАвтоматическойВыемке = ОбщегоНазначенияРМККлиент.ПараметрыЗакрытияСменыПриАвтоматическойВыемке();
	ОтразитьОстаткиНаличныхДенежныхСредствНаФорме(Объект.Организация, Объект.КассаККМ);
	
	НастроитьОтображениеКаталогаПриОткрытии();
	НастроитьОтображениеНастроекПолейВводаПоСтроке();
	ИнтерфейсРМКСлужебныйКлиент.НастроитьПерсонализированнуюПанельОпераций(ЭтотОбъект);
	Если РежимКассыСамообслуживания
			И ОбщегоНазначенияРМККлиентСервер.ЕстьСвойство(Элементы, "КнопкаВесовойОтборКСО") Тогда
		ЦветФонаОтборВеса = Элементы.КнопкаВесовойОтборКСО.ЦветФона;
	КонецЕсли;
	УстановитьВидимостьПромокодов(РежимКассыСамообслуживания);
	УправлениеВидимостьюРеквизитовКарты();
	
	ПодключитьОбработчикОжидания("ОбновитьДанныеРМКПриВозможности", 60, Истина);
	
	ИзменитьВысотуКнопокПанелиЕще();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуАвторизацииДляПовторногоВхода()
	
	Если ЗавершатьСессиюКассираПослеПродажи Тогда
		ОткрытьФормуАвторизацииПринудительнаяСмена();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуАвторизации(ПараметрыАвторизации, ПроверяемоеПраво = "", ТекстАвторизации = "")
	
	ВозможныеНазначенияАвторизации = ИнтерфейсРМКСлужебныйКлиентСервер.НазначенияАвторизации();
	ПередаваемыйКассир = Неопределено;
	Если ПараметрыАвторизации.НазначениеАвторизации = ВозможныеНазначенияАвторизации.ОткрытиеФормы Тогда
		ПередаваемыйКассир = Объект.Кассир;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
	ПараметрыОткрытия.Вставить("Кассир", ПередаваемыйКассир);
	ПараметрыОткрытия.Вставить("ИспользоватьЦифровуюКлавиатуру", Не СкрытьЦифровуюКлавиатуру);
	ПараметрыОткрытия.Вставить("НастроитьКассировДляВхода", НастроитьКассировДляВхода);
	ПараметрыОткрытия.Вставить("РежимКассыСамообслуживания", РежимКассыСамообслуживания);
	ПараметрыОткрытия.Вставить("НазначениеАвторизации", ПараметрыАвторизации.НазначениеАвторизации);
	ПараметрыОткрытия.Вставить("НеобходимоеПраво", ПроверяемоеПраво);
	ПараметрыОткрытия.Вставить("ТекстАвторизации", ТекстАвторизации);
	ПараметрыОткрытия.Вставить("УвеличенныйВариантМасштаба", УвеличенныйВариантМасштаба);
	Если ПараметрыАвторизации.НазначениеАвторизации = ВозможныеНазначенияАвторизации.ПовышениеПрав Тогда
		ПараметрыОткрытия.Вставить("НаименованиеПользователяПриЗапросеПрав", НаименованиеПользователяПриЗапросеПрав);
	КонецЕсли;
	
	ПараметрыАвторизации.Вставить("НеобходимоеПраво", ПроверяемоеПраво);
	ОбработкаОповещения = Новый ОписаниеОповещения("АвторизацияЗавершение", ЭтотОбъект, ПараметрыАвторизации);
	
	Элементы.ГруппаКомандыГорячихКлавиш.Доступность = Ложь;
	УправлениеФормойПередано = Истина;
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаАвторизации", ПараметрыОткрытия, ЭтотОбъект,,,,
		ОбработкаОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуАвторизацииПриЗапуске()
	
	ВозможныеНазначенияАвторизации = ИнтерфейсРМКСлужебныйКлиентСервер.НазначенияАвторизации();
	ПараметрыАвторизации = Новый Структура("НазначениеАвторизации", ВозможныеНазначенияАвторизации.ОткрытиеФормы);
	ФормаАвторизацииДо = НайтиФормуПоИмени("Обработка.РабочееМестоКассира.Форма.ФормаАвторизации");
	Если ФормаАвторизацииДо = Неопределено Тогда
		ОткрытьФормуАвторизации(ПараметрыАвторизации);
	ИначеЕсли ФормаАвторизацииДо.Открыта() И ТипЗнч(ФормаАвторизацииДо.ВладелецФормы) = Тип("ФормаКлиентскогоПриложения")
			И Не ФормаАвторизацииДо.ВладелецФормы.Открыта() Тогда
		ФормаАвторизацииДо.Закрыть(Неопределено);
		ОткрытьФормуАвторизации(ПараметрыАвторизации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АвторизацияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	УправлениеФормойПередано = Ложь;
	ВозможныеНазначенияАвторизации = ИнтерфейсРМКСлужебныйКлиентСервер.НазначенияАвторизации();
	НазначениеАвторизации = ДополнительныеПараметры.НазначениеАвторизации;
	Если НазначениеАвторизации = ВозможныеНазначенияАвторизации.ПовышениеПрав Тогда
		ПогаситьСветовойСигналОбОшибкеНаДисплее();
	КонецЕсли;
	Если Результат = Неопределено Тогда
		
		Если НазначениеАвторизации = ВозможныеНазначенияАвторизации.ОткрытиеФормы
				Или НазначениеАвторизации = ВозможныеНазначенияАвторизации.ПринудительнаяСменаКассира Тогда
			
			РежимОсновногоОкна = КлиентскоеПриложение.ПолучитьРежимОсновногоОкна();
			ЭтоРабочееМесто = (РежимОсновногоОкна = РежимОсновногоОкнаКлиентскогоПриложения.РабочееМесто
				Или РежимОсновногоОкна = РежимОсновногоОкнаКлиентскогоПриложения.Киоск);
			ЭтоФиксированноеОкно = (РежимОсновногоОкна = РежимОсновногоОкнаКлиентскогоПриложения.РабочееМесто
				Или РежимОсновногоОкна = РежимОсновногоОкнаКлиентскогоПриложения.Киоск
				Или ((Не ЭтотОбъект.Окно = Неопределено) И Окно.НачальнаяСтраница));
				
			Если Открыта() И Не ЭтоФиксированноеОкно Тогда
				
				Закрыть();
				
			ИначеЕсли Открыта() И ЭтоРабочееМесто Тогда
				
				ПодключитьОбработчикОжидания("ЗавершитьРаботуСистемыБезусловно", 1);
				
			ИначеЕсли Открыта() И (Не ЭтотОбъект.Окно = Неопределено) И Окно.НачальнаяСтраница Тогда
				
				ПоказатьРекомендациюУбратьИзНачальнойСтраницы(Истина);
				
			КонецЕсли;
			
		ИначеЕсли НазначениеАвторизации = ВозможныеНазначенияАвторизации.ПовышениеПрав Тогда
			
			Если ТекущаяОперация = "ИзменениеКоличестваВМеньшуюСторону" Тогда
				ВернутьСостояниеДоНачалаОперации();
			ИначеЕсли ТекущаяОперация = "ПодтверждениеСтатусаПокупателяРМК"
				И ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера Тогда
				ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера();
			ИначеЕсли ТекущаяОперация = "ВводЦеныТовара" Тогда
				УдалитьТоварЗавершение(КодВозвратаДиалога.Да, Неопределено);
			КонецЕсли;
			ТекущаяОперация = "";
			
		ИначеЕсли НазначениеАвторизации = ВозможныеНазначенияАвторизации.СлужебныеДействияКСО Тогда
			
			ТекущаяОперация = "";
			ОткрытьОбщуюСтраницу();
			СкрытьКомандуВыходаПриНеобходимости();
			
		КонецЕсли;
	Иначе
		
		Если НазначениеАвторизации = ВозможныеНазначенияАвторизации.ОткрытиеФормы Тогда
			
			ОбновитьДанныеМагазинаКассираПриСмене(Результат);
			ВыполнитьНастройкиПослеОбновленияКассираМагазина(Истина, Истина);
			ВыполнитьДействияПослеОткрытияИАвторизации();
			
		ИначеЕсли НазначениеАвторизации = ВозможныеНазначенияАвторизации.ПринудительнаяСменаКассира Тогда
			
			ОбновитьДанныеМагазинаКассираПриСменеСводно(Результат, Истина);
			
		ИначеЕсли НазначениеАвторизации = ВозможныеНазначенияАвторизации.СменаКассира
				Или НазначениеАвторизации = ВозможныеНазначенияАвторизации.СменаМагазина Тогда
			
			НеобходимоПерезаполнитьТаблицуУправляемыхСкидок = Истина;
			ОбновитьДанныеМагазинаКассираПриСменеСводно(Результат);
			
		ИначеЕсли НазначениеАвторизации = ВозможныеНазначенияАвторизации.ПовышениеПрав Тогда
			
			Если ЭтоОперацияВозвратаИлиКоррекции() Тогда
				НачатьВозвратКоррекциюПослеПодтвержденияПрав(Результат);
			Иначе
				ВыполнитьДействиеПослеПовышенияПрав(Результат);
			КонецЕсли;
			
		ИначеЕсли НазначениеАвторизации = ВозможныеНазначенияАвторизации.СлужебныеДействияКСО Тогда
			
			ЗапомнитьПользователяДоЗаменыПравКлиент();
			УстановитьДанныеВыбранногоКассира(Результат);
			ОткрытьФормуОперацийСотрудника();
			ТекущаяОперация = "";
			
		КонецЕсли;
		
	КонецЕсли;
	Элементы.ГруппаКомандыГорячихКлавиш.Доступность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеПослеПовышенияПрав(Результат)
	
	ЗапомнитьПользователяДоЗаменыПравКлиент();
	Объект.Кассир = Результат.Кассир;
	Объект.ПользовательБД = Результат.ПользовательБД;
	
	ВосстанавливатьПользователя = (ЗначениеЗаполнено(ТекущаяОперация)
		И Не ТекущаяОперация = "ОткрытиеСлужебныхДействийКСО");
	
	Если ТекущаяОперация = "УдалитьСтрокуРМК" Тогда
	
		Строка = Объект.Товары.НайтиПоИдентификатору(ТекущийТоварИдентификатор);
		ВозможноЗакрытьСессиюРегистрацииМарок = ККМПоддерживаетПроверкуКодовМаркировки
			И ЗначениеЗаполнено(Строка.КодМаркировки)
			И ЗначениеЗаполнено(ИдентификаторТекущейСессииПроверкиМарок)
			И ВозможноЗакрытьСессиюРегистрацииМарок();
	
		Если ВозможноЗакрытьСессиюРегистрацииМарок Тогда
			ЗакрытьСессиюРегистрацииМарок();
		КонецЕсли;
	
	ИначеЕсли ТекущаяОперация = "УдалитьЧекРМК" Тогда
	
		ВыполнитьОтменуОплатыКлиент();
		РазблокироватьОбъектСервераЛояльности("clientbonuses");
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяОперация) Тогда
		ВыполнитьДействиеПослеПовышенияПравНаСервере();
		Если Не ПропуститьОбновлениеТаблицыДляОперации() Тогда
			ОбработатьИзменениеТаблицыТоваровНаКлиенте();
		КонецЕсли;
	КонецЕсли;
	
	Если ВосстанавливатьПользователя Или НЕ ПараметрыИнфоОшибки = Неопределено Тогда
		ВыбратьПользователяДоЗаменыПравКлиент();
	КонецЕсли;
	
	НастроитьФормуПослеЗаменыПрав();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействиеПослеПовышенияПравНаСервере()
	
	ЗаполнитьТаблицуРолейПользователя();
	ВыполнитьТекущуюОперацию();
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьВозвратКоррекциюПослеПодтвержденияПрав(Результат)
	
	ЗапомнитьПользователяДоЗаменыПравКлиент();
	
	Если ТекущаяОперация = "ЧекНаВозвратРМК" Тогда
		УстановитьДанныеВыбранногоКассира(Результат, Истина);
		ЗарегистрироватьПовышениеПравНаВозвратЧека();
		ВыбратьЧекНаВозврат();
	ИначеЕсли ТекущаяОперация = "ВозвратБезЧекаРМК" Тогда
		УстановитьДанныеВыбранногоКассира(Результат, Истина);
		ЗарегистрироватьПовышениеПравНаВозвратЧека();
		ПереключитьФормуВРежимВозвратБезЧека();
	Иначе
		УстановитьДанныеВыбранногоКассира(Результат, Ложь);
		ИмяРегистрируемойОперации = "Перечисление.ОперацииРабочегоМестаКассира.ПовышениеПравНаКоррекциюЧека";
		ОперацияПовышения = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент(ИмяРегистрируемойОперации);
		ЗарегистрироватьПовышениеПрав(ЭтотОбъект, ОперацияПовышения);
		ВыбратьЧекКоррекции();
		Возврат;
	КонецЕсли;
	ВыбратьПользователяДоЗаменыПравКлиент();
	СформироватьЗаголовок();
	ОтразитьОстаткиНаличныхДенежныхСредствНаФорме(Объект.Организация, Объект.КассаККМ);
	ТекущаяОперация = "";
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоОперацияВозвратаИлиКоррекции()
	
	РезультатФункции = (ТекущаяОперация = "ЧекНаВозвратРМК"
		Или ТекущаяОперация = "ВозвратБезЧекаРМК" Или ТекущаяОперация = "ЧекКоррекцииРМК");
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРекомендациюУбратьИзНачальнойСтраницы(ОтказАвторизации = Ложь)
	
	ТекстРекомендации = "";
	Если ОтказАвторизации Тогда
		ТекстРекомендации = НСтр("ru = 'Рекомендуем убрать рабочее место кассира из начальной страницы
			|или настроить текущему пользователю вход по умолчанию.'");
	Иначе
		ТекстРекомендации = НСтр("ru = 'Рекомендуем убрать рабочее место кассира из начальной страницы
			|до корректной настройки рабочего места кассира.'");
	КонецЕсли;
	
	Элементы.ЗаголовокОшибкиВхода.Заголовок = НСтр("ru = 'Ошибка входа'");
	Элементы.ТекстОшибкиВхода.Заголовок = ТекстРекомендации;
	УстановитьВидимостьЭлементаФормы(Элементы.ВыполнитьВход, Истина);
	УстановитьДоступностьЭлементаФормы(Элементы.ГруппаОперации, Ложь);
	ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаЗавершение);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьПользователяДоЗаменыПравКлиент()
	
	ПользовательДоЗаменыПрав = Объект.ПользовательБД;
	КассирДоЗаменыПрав = Объект.Кассир;
	СписокРолейПользователяДоЗамены = СписокРолейПользователя.Скопировать();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПользователяДоЗаменыПравКлиент()
	
	Если ЗначениеЗаполнено(ПользовательДоЗаменыПрав) И ЗначениеЗаполнено(КассирДоЗаменыПрав)
			И СписокРолейПользователяДоЗамены.Количество() > 0 Тогда
			
		Объект.ПользовательБД = ПользовательДоЗаменыПрав;
		Объект.Кассир = КассирДоЗаменыПрав;
		СписокРолейПользователя.Очистить();
		Для Каждого РольДоЗамены Из СписокРолейПользователяДоЗамены Цикл
			СписокРолейПользователя.Добавить(РольДоЗамены.Значение);
		КонецЦикла;
			
	Иначе
		ВыбратьПользователяДоЗаменыПрав();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДанныеВыбранногоКассира(Результат, ЭтоВозврат = Ложь)
	
	Объект.Кассир = Результат.Кассир;
	Объект.ПользовательБД = Результат.ПользовательБД;
	ОткрытьОбщуюСтраницу(ЭтоВозврат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеМагазинаКассираПриСмене(Результат)
	
	Объект.Кассир = Результат.Кассир;
	Объект.ПользовательБД = Результат.ПользовательБД;
	Если (ЗначениеЗаполнено(Результат.ТорговыйОбъект) И Не Результат.ТорговыйОбъект = Объект.ТорговыйОбъект)
			Или Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		СменитьТорговыйОбъект(Результат.ТорговыйОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьПодключенноеОборудование(ПодключаемыеТипыОборудования)
	
	Для Каждого СтрокаТипа Из ПодключаемыеТипыОборудования Цикл
		Если СтрокаТипа.Значение Тогда
			РанееПодключенныеТипыОборудования[СтрокаТипа.Ключ] = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТипыОборудованияДляПодключения()
	
	ПодключаемыеТипыОборудования = МенеджерОборудованияРМККлиентСервер.ПараметрыТипыОборудования();
	Для Каждого СтрокаТипа Из ПоддерживаемыеТипыПодключаемогоОборудования Цикл
		Если СтрокаТипа.Значение И Не РанееПодключенныеТипыОборудования[СтрокаТипа.Ключ] Тогда
			ПодключаемыеТипыОборудования[СтрокаТипа.Ключ] = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ПодключаемыеТипыОборудования;
	
КонецФункции

&НаСервере
Функция ПроверкаСвязанныхКассировУспешна()
	
	РезультатФункции = ФизЛицоПользователяЗаполнено Или ЗначениеЗаполнено(Объект.Кассир);
	
	Если Не РезультатФункции И НастроитьКассировДляВхода Тогда
		КассирКСО = ОбщегоназначенияРМК.ПолучитьКассираИзПараметраЗапуска();
		Если ЗначениеЗаполнено(КассирКСО) Тогда
			Объект.Кассир = КассирКСО;
			РезультатФункции = Истина;
		Иначе
			ДоступныеКассиры = ОбщегоназначенияРМК.ПолучитьДоступныхКассировПользователя(Объект.ПользовательБД);
			Если ДоступныеКассиры.Количество() > 0 Тогда
				РезультатФункции = Истина;
				Если ДоступныеКассиры.Количество() = 1 Тогда
					Объект.Кассир = ДоступныеКассиры[0];
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Процедура ЗавершитьВыборПокупателя(Результат, ДополнительныеПараметры) Экспорт
	
	УстановитьВыбранногоКонтрагента(Результат, ДополнительныеПараметры);

