Процедура ПодтвердитьПоСМС(Команда)
	ОткрытьФормуВводаСМС();
КонецПроцедуры

&НаКлиенте
Процедура КомандаОплатыБонусами(Команда)
	Если ИнтерфейсРМКСлужебныйКлиентСервер.ЭтоЭтапРаботыСОплатойИлиКоррекцией(ЭтотОбъект) Тогда
		ДанныеКартыЗаполнены = ИнтерфейсРМКСлужебныйКлиентСервер.ДанныеЛояльностиЗаполнены(ЭтотОбъект);
	
		Если Элементы.СтраницыОплатыБонусами.ТекущаяСтраница = Элементы.СтраницаОплатыБонусами Тогда
			ИмяКоманды = Команды.Найти("УдалитьОплатуБонусами");
			УдалитьОплатуБонусами(ИмяКоманды);
		Иначе
			ОплатаБонусами(Команда);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФормаВводаШтрихкодаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИскатьВЧеке = Результат.ИскатьВЧеке;
	Штрихкод = Результат.Штрихкод;
	
	Если Не ЗначениеЗаполнено(Штрихкод) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИскатьВЧеке Тогда
		Если РежимПоказаСкидок Тогда
			НайтиТоварРасшифровкеСкидок(Штрихкод);
		Иначе
			НайтиТоварВЧеке(Штрихкод);
		КонецЕсли;
	Иначе
		ПоискПоШтрихкодуНаКлиенте(Штрихкод);
	КонецЕсли;
	
КонецПроцедуры

