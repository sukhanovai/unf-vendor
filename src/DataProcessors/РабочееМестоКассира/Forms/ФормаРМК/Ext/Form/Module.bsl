	ДанныеПроверки.ТекстСообщения = НСтр("ru = 'На рабочем месте нет сотрудника с правами старшего кассира и выше, у которого введен код подтверждения.
		|Обратитесь к администратору системы.'");
	Отказ = Истина;
КонецПроцедуры

&НаСервере
Процедура ОбработатьПараметрыКассДляГосИС(ОрганизацииДляПроверкиРозничногоТокена, ДанныеККТ)
	
	Если ПараметрыОткрытияФормыГосИС = Неопределено Тогда
		ПараметрыОткрытияФормыГосИС = Новый Структура;
	КонецЕсли;
	
	НастройкиТСПИоТ = Неопределено;
	ОбщегоНазначенияРМКПереопределяемый.НастройкиТСПИоТ(НастройкиТСПИоТ, ДанныеККТ, ЭтотОбъект);
	
	ДанныеККТ.НастроенТСПИоТ = НастройкиТСПИоТ.НастроенТСПИоТ;
	ДанныеККТ.ВнешнийТСПИоТ = НастройкиТСПИоТ.ВнешнийТСПИоТ;
	
	Если ДанныеККТ.НастроенТСПИоТ Тогда
		
		Если ПараметрыОткрытияФормыГосИС.Свойство("ПараметрыАвторизацииТСПИоТ") Тогда
			
			ПараметрыОткрытияФормыГосИС.ПараметрыАвторизацииТСПИоТ.Добавить(НастройкиТСПИоТ);
			
		Иначе
			
			ПараметрыАвторизацииТСПИоТ = Новый Массив;
			ПараметрыАвторизацииТСПИоТ.Добавить(НастройкиТСПИоТ);
			
			ПараметрыОткрытияФормыГосИС.Вставить("ПараметрыАвторизацииТСПИоТ", ПараметрыАвторизацииТСПИоТ);
			
		КонецЕсли;
		
	Иначе
		
		Если ОрганизацииДляПроверкиРозничногоТокена.Найти(ДанныеККТ.Организация) <> Неопределено
			И ИспользоватьРазрешительныйРежимГосИС Тогда
			
			НомерФискальногоНакопителя = ДанныеККТ.НомерФискальногоНакопителя;
			ККТ = ДанныеККТ.ИдентификаторУстройства;
			ПараметрыОбновленияКлючаСессии = ПараметрыОбновленияКлючаСессии();
			
			ПараметрыОбновленияКлючаСессии.Организация = ДанныеККТ.Организация;
			ПараметрыОбновленияКлючаСессии.НомерФискальногоНакопителя = НомерФискальногоНакопителя;
			ПараметрыОбновленияКлючаСессии.ККТ = ККТ;
			ПараметрыОбновленияКлючаСессии.ПараметрыИСМП.ЛокальныйКонтрольКлючаИСМП = ЛокальныйКонтрольКлючаИСМП;
			ПараметрыОбновленияКлючаСессии.ПараметрыИСМП.ИспользоватьРазрешительныйРежимГосИС = ИспользоватьРазрешительныйРежимГосИС;
			Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
				ПараметрыПодключения = ОбщегоНазначенияРМК.ЗначенияПараметровСервераЛояльности(ТекущаяНастройкаРМК);
				ПараметрыОбновленияКлючаСессии.ПараметрыСервераЛояльности = ПараметрыПодключения;
			КонецЕсли;
			РезультатОбновленияКлюча = ТребуетсяОбновлениеКлючаСессииСервер(ПараметрыОбновленияКлючаСессии);
			
			Если РезультатОбновленияКлюча.ТребуетсяОбновлениеКлючаСессии Или РезультатОбновленияКлюча.Ошибка Тогда
				Если ПараметрыОткрытияФормыГосИС.Свойство("РезультатыОбновленияКлючаСессии") Тогда
					ПараметрыОткрытияФормыГосИС.РезультатыОбновленияКлючаСессии.Добавить(РезультатОбновленияКлюча);
				Иначе
					РезультатыОбновления = Новый Массив;
					РезультатыОбновления.Добавить(РезультатОбновленияКлюча);
					ПараметрыОткрытияФормыГосИС.Вставить("РезультатыОбновленияКлючаСессии", РезультатыОбновления);
				КонецЕсли;
			Иначе
				СтандартнаяОбработка = Истина;
				ТребуетсяОбновлениеСпискаCDNПлощадок = Ложь;
				ОбщегоНазначенияРМКПереопределяемый.ТребуетсяОбновлениеСпискаCDNПлощадок(ТребуетсяОбновлениеСпискаCDNПлощадок, СтандартнаяОбработка);
				Если СтандартнаяОбработка И ТребуетсяОбновлениеСпискаCDNПлощадок Тогда
					ПараметрыОбновленияCDN = Новый Структура;
					ПараметрыОбновленияCDN.Вставить("Организация", ДанныеККТ.Организация);
					ПараметрыОбновленияCDN.Вставить("ТребуетсяОбновлениеСпискаCDNПлощадок", ТребуетсяОбновлениеСпискаCDNПлощадок);
					ПараметрыОбновленияCDN.Вставить("НомерФискальногоНакопителя", НомерФискальногоНакопителя);
					ПараметрыОбновленияCDN.Вставить("ККТ", ККТ);
					ПараметрыОткрытияФормыГосИС.Вставить("РезультатОбновленияСпискаCDNПлощадок", ПараметрыОбновленияCDN);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодключаемоеОборудованиеИспользуется(ПроверяемоеПодключаемоеОборудование)
	РезультатФункции = Истина;
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьПризнакИспользованияПодключаемогоОборудования(ПроверяемоеПодключаемоеОборудование, РезультатФункции);
	Возврат РезультатФункции;
КонецФункции

&НаСервере
Процедура ПроверитьЗаполнениеВидовОплатДляКассыСамообслуживания(ТерминалБезПодключения, Отказ, ДанныеПроверки)
	Если РежимКассыСамообслуживания Тогда
		Если ПлатежнаяСистема_ВидыОплат.Количество() = 0 И Не ИспользоватьОплатуПлатежнымиКартами Тогда
			Если ТерминалБезПодключения Тогда
				ДанныеПроверки.ОшибкаЗапуска = "ЭквайринговыйТерминал";
				ДанныеПроверки.ТекстЗаголовка = НСтр("ru = 'Ошибка настройки оплаты банковскими картами'");
				ДанныеПроверки.ТекстСообщения = НСтр("ru = 'В режиме КСО можно использовать только эквайринговые терминалы
					|с настроенным подключенным оборудованием.
					|Обратитесь к администратору системы.'");
			Иначе
				ДанныеПроверки.ОшибкаЗапуска = "ВидыОплат";
				ДанныеПроверки.ТекстЗаголовка = НСтр("ru = 'Ошибка настройки видов оплат'");
				ДанныеПроверки.ТекстСообщения = НСтр("ru = 'Не настроен ни один вид оплаты на рабочем месте.
					|Обратитесь к администратору системы.'");
			КонецЕсли;
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СоздатьКарточкиЧековНаФорме()
	
	КарточкиЧеков = Элементы.ГруппаСписокЧековПродажи.ПодчиненныеЭлементы;
	ИндексыКарточек = КарточкиЧеков.Количество()-1;
	Для Индекс = 0 По ИндексыКарточек Цикл
		Элементы.Удалить(КарточкиЧеков[ИндексыКарточек-Индекс]);
	КонецЦикла;
	
	Если ТаблицаЧековКПробитию.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	Интерфейс85 = ЭтоИнтерфейс85;
	ЦветФонаКарточки = ?(Интерфейс85, Новый Цвет(), ЦветаПалитры.СветлоБежевыйРМК);
	ЦветФонаВыбраннойКарточки = ЦветаПалитры.БежевыйРМК;
	ЦветФонаВыбраннойОплаченнойКарточки = ЦветаПалитры.ТемноЗеленыйРМК;
	ЦветФонаОплаченнойКарточки = ЦветаПалитры.ЗеленыйСветлоТусклыйРМК;
	
	НомерПП = 0;
	Для Каждого ОрганизацияСНО Из ТаблицаЧековКПробитию Цикл
		
		НомерПП = НомерПП + 1;
		ИмяГруппы = СтрШаблон("%1%2", "ГруппаЧековПоКорзине", НомерПП);
		
		ГруппаЧек = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"),
			Элементы.ГруппаСписокЧековПродажи);
	
		ГруппаЧек.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаЧек.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ГруппаЧек.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаЧек.ОтображатьЗаголовок = Ложь;
		ГруппаЧек.УстановитьДействие("Нажатие", "ГруппаЧекНажатие");
		ГруппаЧек.ОтображатьКакКарточку = Истина;
		ГруппаЧек.Гиперссылка = Истина;
		ГруппаЧек.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
		ГруппаЧек.РастягиватьПоГоризонтали = Истина;
	
		//Организация
		ИмяЭлемента = СтрШаблон("ЧекПолеОрганизация%1", НомерПП);
		ПолеОрганизация = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаЧек);
		ПолеОрганизация.Вид = ВидПоляФормы.ПолеНадписи;
		ПолеОрганизация.ПутьКДанным = СтрШаблон("ТаблицаЧековКПробитию[%1].Организация", НомерПП-1);
		ПолеОрганизация.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ПолеОрганизация.Шрифт = ШрифтыСтиля.ШрифтОбычныйПолужирный12РМК;
		ПолеОрганизация.РастягиватьПоГоризонтали = Истина;
		
		//СистемаНалогообложения
		ИмяЭлемента = СтрШаблон("ЧекПолеСистемаНалогообложение%1", НомерПП);
