&НаСервере
Процедура ЗаполнитьПодсказки(Команда, ТекстСочетания)
	
	ЭлементВвода = Элементы.Найти(Команда.ИмяКнопки);
	Если ЭлементВвода <> Неопределено Тогда
		Если ТипЗнч(ЭлементВвода) = Тип("ПолеФормы") Тогда
			ЭлементВвода.ПодсказкаВвода = ТекстСочетания;
		КонецЕсли;
		Если ТипЗнч(ЭлементВвода) = Тип("КнопкаФормы") И ЭлементВвода.Важность = ВажностьКнопки.Дополнительная Тогда
			Если Найти(ЭлементВвода.Заголовок, ТекстСочетания) = 0 Тогда
				ЭлементВвода.Заголовок = СтрШаблон("%1 (%2)", ЭлементВвода.Заголовок, ТекстСочетания);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Команда.ИмяКнопки = "ДобавитьСертификат" Тогда
		ЭлементДоплатить = Элементы.Найти("ДоплатитьСертификатом");
		Если НЕ ЭлементДоплатить = Неопределено Тогда
			Если Найти(ЭлементДоплатить.Заголовок, ТекстСочетания) = 0 Тогда
				ЭлементДоплатить.Заголовок = СтрШаблон("%1 (%2)", ЭлементДоплатить.Заголовок, ТекстСочетания);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

