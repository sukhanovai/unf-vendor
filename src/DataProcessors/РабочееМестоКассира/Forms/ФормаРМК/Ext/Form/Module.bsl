&НаКлиенте
Процедура ГорячаяКлавишаСБП(Команда)
	
	ГруппаСлоевСлужебнаяИнформация = Элементы.ГруппаСлоевСлужебнаяИнформацияЧека;
	Если ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьТекущийСлойГруппы(ГруппаСлоевСлужебнаяИнформация)
		= Элементы.ОбластьОперативногоУправленияЧеком Тогда
		
		Если ИнтерфейсРМКСлужебныйКлиентСервер.ЭтоЭтапРаботыСОплатойИлиКоррекцией(ЭтотОбъект) Тогда
			
			Если Элементы.СтраницыОплатыСБП.ТекущаяСтраница = Элементы.СтраницаСуммаОплатаСБП Тогда
				ИмяКоманды = Команды.Найти("УдалитьОплатуСБП");
				УдалитьОплатуСБП(ИмяКоманды);
			Иначе
				ИмяКоманды = Команды.Найти("ОплатаСБП");
				ОплатаСБП(ИмяКоманды);
			КонецЕсли;
			
		ИначеЕсли РежимРаботыСЧеком = РежимыРаботыСЧеком.ВводТоваров Тогда
			ИменаВидовОплат = ИнтерфейсРМКСлужебныйКлиентСервер.ИменаУникальныхВидовОплат();
			Если Элементы.ГруппаQRCode.Видимость И Элементы.ГруппаQRCodeСБП.Видимость Тогда
				
				ИмяКоманды = Команды.Найти("ОплатаСБПВТихомРежиме");
				ОплатаСБПВТихомРежиме(ИмяКоманды);
				
			ИначеЕсли ИнтерфейсРМКСлужебныйКлиент.ИспользуетсяУникальныйВидОплаты(ЭтотОбъект)
				И ИспользуемыеВидыОплат[0] = ИменаВидовОплат.СБП Тогда
			
				ПерейтиВУникальнуюОплату();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

