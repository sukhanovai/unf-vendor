&НаКлиенте
Процедура ДекорацияСтатусТСПИоТНажатие(Элемент)
	
	Отбор = Новый Структура("АварийныйРежимТСПИоТ", Истина);
	СтрокиКассВАварийномРежиме = ТаблицаКассККМОрганизаций.НайтиСтроки(Отбор);
	
	Если СтрокиКассВАварийномРежиме.Количество() = 0 Тогда
		
		ПодключитьОбработчикОжидания("ЗапуститьОбработкуСтатусовТСПИоТ", 0.5, Истина);
		
	Иначе
		
		ПараметрыАварийногоРежима = ПолучитьПараметрыАварийногоРежима();
		
		Если ПараметрыАварийногоРежима = Неопределено Тогда
			
			Возврат;
			
		Иначе
			
			ПослеЗакрытияФормы = Новый ОписаниеОповещения("ПослеОбработкиФормыУточненияАварийногоРежима", ЭтотОбъект);
			
			ОбщегоНазначенияРМККлиентПереопределяемый.ОткрытьФормуУправленияАварийнымРежимом(ПараметрыАварийногоРежима, ПослеЗакрытияФормы, ЭтотОбъект);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

