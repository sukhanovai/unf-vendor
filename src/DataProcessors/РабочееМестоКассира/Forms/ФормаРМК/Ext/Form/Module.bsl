&НаКлиенте
Процедура ЗаполнитьСписокНастроекСервераЛояльности(ЗначениеНастройка)
	СписокНастроекСервераЛояльности.Очистить();
	Если ЗначениеНастройка Тогда
		СписокНастроекСервераЛояльности.Добавить("РазрешитьЗаменуДисконтнойКарты");
		СписокНастроекСервераЛояльности.Добавить("ДоступноНачислениеБонусов");
		СписокНастроекСервераЛояльности.Добавить("ДоступноНачислениеСертификатов");
		СписокНастроекСервераЛояльности.Добавить("ИспользоватьНовыеМетоды_3_0_11");
		СписокНастроекСервераЛояльности.Добавить("ДоступенПоискПоФИО");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачислитьБонусныеБаллыСерверЛояльности()
	
	Если ИспользоватьСерверЛояльностиПолучательДанных
		И СписокНастроекСервераЛояльности.НайтиПоЗначению("ДоступноНачислениеБонусов") <> Неопределено Тогда
		СуммаНачисления = ТаблицаБонусныеБаллы.Итог("КоличествоБонусныхБаллов");
		Если СуммаНачисления > 0 Тогда
			
			ЗначенияПараметровМетода = ПараметрыМетодовБонуснойПодсистемы();
			ЗначенияПараметровМетода.Вставить("BonusesCount", Строка(СуммаНачисления));
			
			ПараметрыВыполненияЗапроса = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыЗапросаНачислитьБонусыКлиента(ПараметрыПодключенияКСерверуЛояльности,
					ЗначенияПараметровМетода);
			Результат = СерверЛояльностиПолучательДанныхКлиентСервер.ВыполнитьЗапросКСерверуЛояльности(ПараметрыВыполненияЗапроса);
			
			ОшибкаНачисления = Ложь;
			СтрокаОтвета = Результат.ДанныеОтвета;
			ДанныеОтвета = Неопределено;
			СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаОтвета, ДанныеОтвета);
			Если НЕ ДанныеОтвета = Неопределено Тогда
				ОшибкаНачисления = ДанныеОтвета.Error;
				СообщениеОбОшибке = ДанныеОтвета.ErrorMessage;
			КонецЕсли;
			
			Если ОшибкаНачисления Тогда
				ТекстЗаголовка = НСтр("ru = 'Ошибка начисления бонусов.'");
				ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(СообщениеОбОшибке, ТекстЗаголовка);
				ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуОжидания(ИмяСтраницы, ИмяСтраницыПередОжиданием)
	Если НЕ ИмяСтраницы = Элементы.СтраницаОжидание.Имя Тогда
		ИмяСтраницыПередОжиданием = ИмяСтраницы;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОжидатьЗавершенияВсехЗаданий(МассивАктивныхЗаданий)
	СоответствиеЗаданийИПараметров = Новый Соответствие;
	МассивЗаданий = Новый Массив();
	Для Каждого ОписаниеЗадания Из МассивАктивныхЗаданий Цикл
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ОписаниеЗадания.ИдентификаторЗадания);
		Если Не Задание = Неопределено Тогда
			МассивЗаданий.Добавить(Задание);
			СоответствиеЗаданийИПараметров.Вставить(Задание.УникальныйИдентификатор, ОписаниеЗадания);
		КонецЕсли;
	КонецЦикла;
	РезультатОжидания = ОжидатьЗавершенияФоновыхЗаданий(МассивЗаданий);	
	Результат = Новый Массив;
	Для Каждого Задание Из РезультатОжидания Цикл
		ПараметрыЗапуска = СоответствиеЗаданийИПараметров[Задание.УникальныйИдентификатор];
		ОписаниеРезультата = Новый Структура();
		ОписаниеРезультата.Вставить("ИдентификаторПараметровЗапуска", ПараметрыЗапуска.ИдентификаторПараметровЗапуска);
		РезультатЗадания = Новый Структура();
		РезультатЗадания.Вставить("АдресРезультата", ПараметрыЗапуска.АдресРезультата);
		Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			РезультатЗадания.Вставить("Статус", "Выполнено");
		ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			РезультатЗадания.Вставить("Статус", "Ошибка");
			ИнформациОбОшибке = Задание.ИнформацияОбОшибке;
			РезультатЗадания.Вставить("ИнформацияОбОшибке", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформациОбОшибке));
		КонецЕсли;
		ОписаниеРезультата.Вставить("Результат", РезультатЗадания);
		
		Результат.Добавить(ОписаниеРезультата);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ОжидатьЗавершенияФоновыхЗаданий(МассивАктивныхЗаданий)
	Результат = Новый Массив;
	МассивЗаданий = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(МассивАктивныхЗаданий,30);
	ОставшиесяЗадания = Новый Массив;
	Для Каждого Задание Из МассивЗаданий Цикл
		Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			ОставшиесяЗадания.Добавить(Задание);
		Иначе
			Результат.Добавить(Задание);
		КонецЕсли;		
	КонецЦикла;
	Если ОставшиесяЗадания.Количество() < МассивЗаданий.Количество()
		И НЕ ОставшиесяЗадания.Количество() = 0 Тогда
		РезультатОжидания = ОжидатьЗавершенияФоновыхЗаданий(ОставшиесяЗадания);
		Для Каждого Задание Из РезультатОжидания Цикл
			Результат.Добавить(Задание);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции
#КонецОбласти

#Область ПервоначальныеДанныеЛокально
&НаСервере
Процедура ЗаполнитьПервоначальныеДанныеЛокально()
	Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуУправляемыхСкидок();
	ЗаполнитьТаблицуВидовКарт();
	ЗаполнитьТаблицуСкидокЗависящихОтВидаОплаты();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуУправляемыхСкидок()
	ТаблицаУправляемыхСкидок.Очистить();
	Если Не РежимКассыСамообслуживания Тогда
		ПараметрыУправляемыхСкидок = Новый Структура();
		ЗаполнитьПараметрыУправляемыхСкидокЛокально(ПараметрыУправляемыхСкидок);
		СерверЛояльностиПолучательДанныхКлиентСерверПереопределяемый.
			ЗаполнитьТаблицуУправляемыхСкидок(ТаблицаУправляемыхСкидок, ПараметрыУправляемыхСкидок);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыУправляемыхСкидокЛокально(ПараметрыУправляемыхСкидок)
	ПараметрыУправляемыхСкидок = Новый Структура();
	ПараметрыУправляемыхСкидок.Вставить("МаксимальныйПроцентСкидки", МаксимальныйПроцентРучнойСкидки);
	ПараметрыУправляемыхСкидок.Вставить("МаксимальныйПроцентНаценки", МаксимальныйПроцентРучнойНаценки);
	ПараметрыУправляемыхСкидок.Вставить("Магазин", Объект.ТорговыйОбъект.УникальныйИдентификатор());
	УИДКонтрагента = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		УИДКонтрагента = Объект.Контрагент.УникальныйИдентификатор();
	КонецЕсли;
	ПараметрыУправляемыхСкидок.Вставить("Клиент", УИДКонтрагента);
	Если ЗначениеЗаполнено(Объект.ДисконтнаяКарта) Тогда
		ПараметрыУправляемыхСкидок.Вставить("УникальныйИдентификаторКарты", Объект.ДисконтнаяКарта.УникальныйИдентификатор());
	Иначе
		ПараметрыУправляемыхСкидок.Вставить("ИдентификаторКартыКлиента",НайденнаяКартаНомер);
	КонецЕсли;
	ПараметрыУправляемыхСкидок.Вставить("ИспользоватьОтборы",Истина);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуВидовКарт()
	
	ТаблицаВидыКарт.Очистить();
	ПараметрыВидовКарт = Новый Структура();
	ЗаполнитьПараметрыВидовКартЛокально(ПараметрыВидовКарт);
	СерверЛояльностиПолучательДанныхКлиентСерверПереопределяемый.ЗаполнитьТаблицуВидовКарт(ТаблицаВидыКарт, ПараметрыВидовКарт);	
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСкидокЗависящихОтВидаОплаты()
	
	ТаблицаСкидокЗависяшихОтВидаОплаты.Очистить();
	СерверЛояльностиПолучательДанныхКлиентСерверПереопределяемый.ЗаполнитьТаблицуСкидокЗависящихОтВидаОплаты(ТаблицаСкидокЗависяшихОтВидаОплаты);
	
КонецПроцедуры
#КонецОбласти

#Область НастройкиРМК

&НаКлиенте
Процедура ИзменитьНастройкиРабочегоМестаКассира(Команда)
	Если РежимКассыСамообслуживания Тогда
		ОсновнаяСтраница = Элементы.СтраницаПустая;
	Иначе
		ОсновнаяСтраница = Элементы.СтраницаОбщая;
	КонецЕсли;
	Если Объект.Товары.Количество() > 0 ИЛИ ФормаЗамороженаПослеПробитияЧека()
		Или НЕ Элементы.Страницы.ТекущаяСтраница = ОсновнаяСтраница Тогда
		ТекстСообщения = НСтр("ru = 'Таблица товаров не пуста. Команда недоступна.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("НастройкаРабочегоМеста", ТекущаяНастройкаРМК);
	ПараметрыОткрытия.Вставить("РабочееМестоКассира", Истина);
	ОписаниеОповещенияНастройкиРМК = Новый ОписаниеОповещения("ОбработатьИзменениеНастройкиРМК", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.НастройкиРабочегоМестаКассира", ПараметрыОткрытия, ЭтаФорма,,,, ОписаниеОповещенияНастройкиРМК, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	СкрытьГруппуЕще();
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеНастройкиРМК(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьФормуПриСозданииНаСервере();
	
КонецПроцедуры

// Открывает основную форму выбора цены справочника Виды цен
//
// Параметры:
//  Нет
//                 
&НаКлиенте
Процедура ОткрытьФормуВыбораВидаЦеныКлиент()
	ПараметрыОткрытия = Новый Структура;
	ОповещениеОВыборе = Новый ОписаниеОповещения("ВыборВидаЦеныЗавершение",ЭтотОбъект);
	ОбщегоНазначенияРМККлиент.ЗаполнитьПараметрыОткрытияФормыВыбораВидаЦены(ПараметрыОткрытия);
	ОбщегоНазначенияРМККлиент.ОткрытьФормуВыбораВидаЦены(ЭтотОбъект, ПараметрыОткрытия, ОповещениеОВыборе);
КонецПроцедуры // ОткрытьФормуВыбораВидаЦеныКлиент()

// Открывает основную форму выбора подразделения
//
// Параметры:
//  Нет
//
&НаКлиенте
Процедура ОткрытьФормуВыбораСтруктурнойЕдиницыКлиент()
	ПараметрыОткрытия = Новый Структура;
	ОповещениеОВыборе = Новый ОписаниеОповещения("ВыборСтруктурнойЕдиницыЗавершение", ЭтотОбъект);
	ОбщегоНазначенияРМККлиент.ЗаполнитьПараметрыОткрытияФормыВыбораСтруктурнойЕдиницы(ЭтотОбъект, ПараметрыОткрытия);
	ОбщегоНазначенияРМККлиент.ОткрытьФормуВыбораСтруктурнойЕдиницы(ЭтотОбъект, ПараметрыОткрытия, ОповещениеОВыборе);
КонецПроцедуры

// Обработка выбранного вида цены
//
// Параметры:
//  ВыбранныйВидЦены		 - СправочникСсылка.ВидыЦен - Выбранный вид цены
//  ДополнительныеПараметры	 - Произвольный	 - Дополнительные параметры
//
&НаКлиенте
Процедура ВыборВидаЦеныЗавершение(ВыбранныйВидЦены,ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйВидЦены = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ РозничныйВидЦены = ВыбранныйВидЦены Тогда
		
		ПересчитатьКорзинуРМКПослеВыбораЦеныНаСервере(ВыбранныйВидЦены);
		ПересчитатьИтогиТабличнойЧастиТовары();
		
		ФормаПлиточногоИнтерфейсаДоступна
			= ЕстьВесовойТоварВПлитке Или ЗначениеЗаполнено(СтруктураПлиточногоИнтерфейсаПодбора);
		
		Если ИспользоватьПанельИзбранныхТоваров Тогда
			ЗаполнитьКнопкиИзбранныхПозиций();
		КонецЕсли;
		
		Если ФормаПлиточногоИнтерфейсаДоступна Тогда
			ЗаполнитьКнопкиПлиток();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ВыборВидаЦеныЗавершение()

&НаСервере
Процедура ПересчитатьКорзинуРМКПослеВыбораЦеныНаСервере(ВыбранныйВидЦены)
	
	ОбщегоНазначенияРМК.ПересчитатьКорзинуРМКПослеВыбораЦены(ЭтотОбъект,ВыбранныйВидЦены);
	
	ФормаПлиточногоИнтерфейсаДоступна
		= ЕстьВесовойТоварВПлитке Или ЗначениеЗаполнено(СтруктураПлиточногоИнтерфейсаПодбора);
		
	Если ИспользоватьПанельИзбранныхТоваров
		ИЛИ ФормаПлиточногоИнтерфейсаДоступна Тогда
		
		ОбновитьЦеныИзбранныхИПлиток();
		
	КонецЕсли;
	
КонецПроцедуры

// Обработка выбранной структурной единицы с типом подразделение
//
// Параметры:
//  СтруктурнаяЕдиница		 - СправочникСсылка.СтруктурныеЕдиницы - Выбранная структурная единица
//  ДополнительныеПараметры	 - Произвольный	 - Дополнительные параметры
//
&НаКлиенте
Процедура ВыборСтруктурнойЕдиницыЗавершение(СтруктурнаяЕдиница,ДополнительныеПараметры) Экспорт
	
	Если СтруктурнаяЕдиница = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьСвойство(ЭтотОбъект, "Подразделение") Тогда
		Подразделение = СтруктурнаяЕдиница;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПодарочныеСертификаты
&НаКлиенте
Процедура НайтиСертификатКлиент(РезультатПоискаСертификата, ПодарочныйСертификат, НомерСертификата)
	
	Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
		
		ЗначенияПараметровМетода = ЗначениеПараметровПодарочногоСертификата(ПодарочныйСертификат, НомерСертификата);
		ПараметрыВыполненияЗапроса = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыЗапросаПолучитьДанныеПодарочногоСертификата(ПараметрыПодключенияКСерверуЛояльности,
										ЗначенияПараметровМетода, ТипЗапросаПодарочныеСертификаты);
		Результат = СерверЛояльностиПолучательДанныхКлиентСервер.ВыполнитьЗапросКСерверуЛояльности(ПараметрыВыполненияЗапроса);
		
		РезультатПоискаСертификата.ЕстьОшибки = Результат.ЕстьОшибки;
		РезультатПоискаСертификата.ТекстОшибки = НСтр("ru = 'Ошибка поиска подарочного сертификата.'");
		
		Если Результат.ЕстьОшибки Тогда
			Возврат;
		КонецЕсли;
		
		ДанныеОтвета = Неопределено;
		СтрокаJSON = Результат.ДанныеОтвета;
		СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаJSON, ДанныеОтвета);
		
		Если НЕ ДанныеОтвета = Неопределено Тогда 
			
			Если ДанныеОтвета.Свойство("Error") И НЕ ДанныеОтвета.Error Тогда
				
				РезультатПоискаСертификата.СуммаСертификата = ДанныеОтвета.GiftCardBalance;;
				
			ИначеЕсли ДанныеОтвета.Свойство("Error") И ДанныеОтвета.Error Тогда
				
				РезультатПоискаСертификата.ЕстьОшибки = ДанныеОтвета.Error;
				РезультатПоискаСертификата.ТекстОшибки = ДанныеОтвета.ErrorMessage;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ОбщегоНазначенияРМККлиент.ИспользоватьПоискСертификатаЛокально() Тогда
		
		ПараметрыПоискаСертификата = Новый Структура;
		ПараметрыПоискаСертификата.Вставить("НомерСертификата", НомерСертификата);
		ПараметрыПоискаСертификата.Вставить("ПодарочныйСертификат", ПодарочныйСертификат);
		
		НайтиСертификатЛокально(ПараметрыПоискаСертификата, РезультатПоискаСертификата);
		
		Если РезультатПоискаСертификата.СуммаСертификата = 0
			ИЛИ Не ЗначениеЗаполнено(ПодарочныйСертификат) Тогда
			Если СуммаСертификата = 0 Тогда
				ТекстОшибки = НСтр("ru = 'Сертификат не активирован или полностью погашен.'");
			Иначе
				ТекстОшибки = НСтр("ru = 'Сертификат не найден.'");
			КонецЕсли;
			РезультатПоискаСертификата.ЕстьОшибки = Истина;
			РезультатПоискаСертификата.ТекстОшибки = ТекстОшибки;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НайтиСертификатЛокально(ПараметрыПоискаСертификата, РезультатПоискаСертификата)
	
	АдресХранилищаТаблицыТоваров = ПоместитьВоВременноеХранилище(Объект.Товары.Выгрузить());
	ПараметрыПоискаСертификата.Вставить("АдресХранилищаТаблицыТоваров", АдресХранилищаТаблицыТоваров);
	ОбщегоНазначенияРМКПереопределяемый.НайтиСертификатЛокально(ПараметрыПоискаСертификата, РезультатПоискаСертификата);
	
КонецПроцедуры

&НаКлиенте
Функция ЗначениеПараметровПодарочногоСертификата(ПодарочныйСертификат, НомерСертификата)
	
	СтатичныеПараметры	= СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыПодарочногоСертификата();
	СтатичныеПараметры.GiftCardNumber	= НомерСертификата;
	СтатичныеПараметры.GiftCardUID		= Строка(ПодарочныйСертификат.УникальныйИдентификатор());
	СтатичныеПараметры.Goods			= ПолучитьТоварыПоПодарочнымСертификатам();
	
	Возврат СтатичныеПараметры;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТоварыПоПодарочнымСертификатам()
	МассивТоваров = Новый Массив;
	ТоварыДляЗапроса = Объект.Товары;
	Если НЕ ОплатаБезДеленияПоЧекам Тогда
		Отбор = Новый Структура("Организация", ВыбраннаяОрганизация);
		ТоварыДляЗапроса = Объект.Товары.НайтиСтроки(Отбор);
	КонецЕсли;
	Для Каждого СтрокаТовар Из ТоварыДляЗапроса Цикл
		
		СтруктураСтроки = СерверЛояльностиПолучательДанныхКлиентСервер.СтруктураТоваровДляРасчетаСкидок();
		
		СтруктураСтроки.Item = СерверЛояльностиПолучательДанныхКлиентСервер.ПолучитьПараметрыСсылки(СтрокаТовар.Номенклатура);
		СтруктураСтроки.Variant = СерверЛояльностиПолучательДанныхКлиентСервер.ПолучитьПараметрыСсылки(СтрокаТовар.Характеристика);
		СтруктураСтроки.Organization = СерверЛояльностиПолучательДанныхКлиентСервер.ПолучитьПараметрыСсылки(СтрокаТовар.Организация);
		СтруктураСтроки.Amount = СтрокаТовар.Сумма;
		
		МассивТоваров.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	Возврат МассивТоваров;
КонецФункции

&НаСервере
Процедура ЗаполнитьБалансПодарочныхСертификатовПриВозврате()
	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		ТипСертификат = ЭтоПодарочныйСертификат(СтрокаТовара.ТипНоменклатуры);
		Если НЕ ТипСертификат Тогда
			Продолжить;
		КонецЕсли;
		
		Если СерииНеВыгружаются Тогда
			Серия = СтрокаТовара.ИдентификаторСерий;
		Иначе
			Серия = СтрокаТовара.Серия;
		КонецЕсли;
		
		СерияЗаполнена = ЗначениеЗаполнено(Серия);
		
		Если НЕ СерияЗаполнена Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыСертификата = Новый Структура;
		ПараметрыСертификата.Вставить("БалансСертификата", 0);
		ПараметрыСертификата.Вставить("Сертификат", СтрокаТовара.Номенклатура);
		ПараметрыСертификата.Вставить("Серия", Серия);
		ПараметрыСертификата.Вставить("СерииНеВыгружаются", СерииНеВыгружаются);
		ПараметрыСертификата.Вставить("Организация", СтрокаТовара.Организация);
		
		ПолучитьБалансСертификата(ПараметрыСертификата, СтрокаТовара);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьЗапросаБалансаСертификата()
	
	ЗапрашиватьБаланс = Ложь;
	ОбщегоНазначенияРМККлиентПереопределяемый.ОпределитьНеобходимостьЗапросаБалансаСертификата(ЗапрашиватьБаланс);
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ТекущийТоварИдентификатор);
	
	Если ТекущаяСтрока = Неопределено
		Или НЕ ЗапрашиватьБаланс Тогда
		УстановитьВидимостьЭлементаФормы(Элементы.ЗапроситьБалансСертификата, Ложь);
		Возврат;
	КонецЕсли;
	
		
	ВидимостьЗапросаБаланса = Ложь;
	ЭтоПродажа = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации);
	ТипНоменклатурыСертификат = ОбщегоНазначенияРМККлиент.ТипНоменклатурыПодарочныйСертификат();
	
	ВидимостьЗапросаБаланса = НЕ ЭтоПродажа
		И ТекущаяСтрока.ТипНоменклатуры = ТипНоменклатурыСертификат
		И ТекущаяСтрока.НеобходимостьВводаСерии;
		
	УстановитьВидимостьЭлементаФормы(Элементы.ЗапроситьБалансСертификата, ВидимостьЗапросаБаланса);
	
КонецПроцедуры

&НаСервере
Процедура ЗапроситьБалансСертификатаСервер()
	
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ТекущийТоварИдентификатор);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СерииНеВыгружаются Тогда
		Серия = ТекущаяСтрока.ИдентификаторСерий;
	Иначе
		Серия = ТекущаяСтрока.Серия;
	КонецЕсли;
	СерияЗаполнена = ЗначениеЗаполнено(Серия);
	
	Если НЕ СерияЗаполнена Тогда
		ТекстСообщения = НСтр("ru = 'Серия не заполнена'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыСертификата = Новый Структура;
	ПараметрыСертификата.Вставить("БалансСертификата", 0);
	ПараметрыСертификата.Вставить("Сертификат", ТекущаяСтрока.Номенклатура);
	ПараметрыСертификата.Вставить("Серия", Серия);
	ПараметрыСертификата.Вставить("СерииНеВыгружаются", СерииНеВыгружаются);
	ПараметрыСертификата.Вставить("Организация", ТекущаяСтрока.Организация);
	
	ПолучитьБалансСертификата(ПараметрыСертификата, ТекущаяСтрока);
КонецПроцедуры

&НаСервере
Процедура ПолучитьБалансСертификата(ПараметрыСертификата, СтрокаТовара)
	ОбщегоНазначенияРМКПереопределяемый.ЗапроситьБалансСертификата(ПараметрыСертификата);
	Если НЕ ПараметрыСертификата.БалансСертификата = 0 Тогда
		ТекущийТоварЦенаИзКарточки = ПараметрыСертификата.БалансСертификата;
		СтрокаТовара.Цена = ПараметрыСертификата.БалансСертификата;
		ДобавитьСертификатВТаблицу(ЭтотОбъект, ПараметрыСертификата.БалансСертификата, СтрокаТовара);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписатьПодарочныйСертификат(ПодарочныйСертификат, НомерСертификата, СуммаСертификата, СертификатСписан)
	
	ЭтоОперацияВозврат = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	
	Если ЭтоОперацияВозврат
		И СписокНастроекСервераЛояльности.НайтиПоЗначению("ДоступноНачислениеСертификатов") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоОперацияВозврат Тогда
		СуммаСписания = Строка(-СуммаСертификата);
	Иначе
		СуммаСписания = Строка(СуммаСертификата);
	КонецЕсли;
	
	ЗначенияПараметровМетода = ЗначениеПараметровПодарочногоСертификата(ПодарочныйСертификат, НомерСертификата);
	ЗначенияПараметровМетода.Вставить("GiftCardWriteOffAmount", СуммаСписания);
	
	Если СписокНастроекСервераЛояльности.НайтиПоЗначению("ИспользоватьНовыеМетоды_3_0_11") <> Неопределено Тогда
		ИмяРесурса = "writeoffgiftcard3_0";
	ИначеЕсли ИспользоватьНовыйМетодСЛ Тогда
		ИмяРесурса = "writeoffgiftcardnew";
	Иначе
		ИмяРесурса = "writeoffgiftcard";
	КонецЕсли;
	ПараметрыВыполненияЗапроса = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыЗапросаСписатьПодарочныйСертификат(ПараметрыПодключенияКСерверуЛояльности,
	ЗначенияПараметровМетода, ИмяРесурса);
	Результат = СерверЛояльностиПолучательДанныхКлиентСервер.ВыполнитьЗапросКСерверуЛояльности(ПараметрыВыполненияЗапроса);
	
	СтрокаОтвета = Результат.ДанныеОтвета;
	СертификатСписан = Ложь;
	
	Если СтрокаОтвета = "Подарочный сертификат успешно списан на указанную сумму" Тогда
		
		СертификатСписан = Истина;
		
	Иначе
		
		ДанныеОтвета = Неопределено;
		СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаОтвета, ДанныеОтвета);
		
		Если ДанныеОтвета <> Неопределено Тогда
			Если НЕ ДанныеОтвета.Error Тогда
				СертификатСписан = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УдалитьПодарочныйСертификат(ИдентификаторСертификата, УдалитьСтрокуТаблицы = Ложь)
	
	Если УдалитьСтрокуТаблицы Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("УникальныйИдентификатор", ИдентификаторСертификата);
		МассивСтрокТаблицы = ТаблицаПодарочныхСертификатов.НайтиСтроки(Отбор);
		
		Для Каждого СтрокаТаблицы Из МассивСтрокТаблицы Цикл
			ТаблицаПодарочныхСертификатов.Удалить(СтрокаТаблицы);
		КонецЦикла;
		УстановитьВидимостьКомандыУдаленияВсехСертификатов(Элементы.ГруппаУдалитьСертификаты, ТаблицаПодарочныхСертификатов);
		
	КонецЕсли;
	
	Если НЕ Элементы.Найти("СуммаОплаченоСертификатом_" + ИдентификаторСертификата) = Неопределено Тогда
		УдаляемыеРеквизиты = Новый Массив;
		УдаляемыеРеквизиты.Добавить("СуммаОплаченоСертификатом_" + ИдентификаторСертификата);
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);
		
		УдалитьЭлементФормы("ГруппаСертификатГоризонтальная_" + ИдентификаторСертификата);
		УдалитьЭлементФормы("СуммаОплаченоСертификатом_" + ИдентификаторСертификата);
		УдалитьЭлементФормы("ДекорацияУдалитьСертификат_" + ИдентификаторСертификата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписатьРазблокироватьПодарочныеСертификаты(Списать = Ложь)
	
	Для Каждого СтрокаТаблицы Из ТаблицаПодарочныхСертификатов Цикл
		
		СтруктураОтбора = Новый Структура("НомерСертификата, ПодарочныйСертификат",
			СтрокаТаблицы.НомерСертификата,
			СтрокаТаблицы.ПодарочныйСертификат);
		
		Если НЕ ТаблицаПодарочныхСертификатов.НайтиСтроки(СтруктураОтбора).Количество() Тогда
			ОчиститьДанныеПодарочногоСертификата(СтрокаТаблицы);
		КонецЕсли;
		
		Если СтрокаТаблицы.СуммаСертификата > 0 И СтрокаТаблицы.ЭтоСерийныйПодарочныйСертификат Тогда
			СертификатСписан = Ложь;
			Если Списать И ИспользоватьСерверЛояльностиПолучательДанных Тогда
				СписатьПодарочныйСертификат(СтрокаТаблицы.ПодарочныйСертификат, СтрокаТаблицы.НомерСертификата, СтрокаТаблицы.СуммаСертификата, СертификатСписан);
			КонецЕсли;
			
			УдалитьЭлементПодарочногоСертификата(СтрокаТаблицы.УникальныйИдентификатор);
			
			Если СертификатСписан Тогда
				ОчиститьДанныеПодарочногоСертификата(СтрокаТаблицы);
			Иначе
				ПараметрыСертификата = Новый Структура;
				ПараметрыСертификата.Вставить("СуммаОплаченоСертификатом", СтрокаТаблицы.СуммаСертификата);
				ПараметрыСертификата.Вставить("ПодарочныйСертификат", СтрокаТаблицы.ПодарочныйСертификат);
				ПараметрыСертификата.Вставить("НомерСертификата", СтрокаТаблицы.НомерСертификата);
				РазблокироватьПодарочныйСертификат(ПараметрыСертификата);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НачислитьПодарочныеСертификаты()
	
	ЭтоОперацияВозврат = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	ТипНоменклатурыПодарочныйСертификат = ОбщегоНазначенияРМККлиент.ТипНоменклатурыПодарочныйСертификат();
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		Если НЕ СтрокаТовары.ЭтоПодарочныйСертификат Тогда
			Продолжить;
		КонецЕсли;
		СуммаНачисления = СтрокаТовары.СуммаБезСкидки;
		Если ЭтоОперацияВозврат Тогда
			СуммаНачисления = -СуммаНачисления;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТовары.ИдентификаторСерий) Тогда
			Номер = СтрокаТовары.ИдентификаторСерий;
		Иначе
			Номер = Строка(СтрокаТовары.Серия.УникальныйИдентификатор());
		КонецЕсли;
		ЗначенияПараметровМетода	= СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыПодарочногоСертификата();
		ЗначенияПараметровМетода.GiftCardNumber = Номер;
		ЗначенияПараметровМетода.GiftCardUID = Строка(СтрокаТовары.Номенклатура.УникальныйИдентификатор());
		ЗначенияПараметровМетода.Вставить("GiftCardAccrueOffAmount", Строка(СуммаНачисления));
		НачислитьБалансСертификатаСерверЛояльности(ЗначенияПараметровМетода, СтрокаТовары.Серия, ЭтоОперацияВозврат);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НачислитьБалансСертификатаСерверЛояльности(ЗначенияПараметровМетода, СерияПодарочногоСертификата, ЭтоОперацияВозврат)
	ПараметрыВыполненияЗапроса = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыЗапросаНачислитьПодарочныйСертификат(ПараметрыПодключенияКСерверуЛояльности,
		ЗначенияПараметровМетода);
	Результат = СерверЛояльностиПолучательДанныхКлиентСервер.ВыполнитьЗапросКСерверуЛояльности(ПараметрыВыполненияЗапроса);
	
	ДанныеОтвета = Неопределено;
	СтрокаJSON = Результат.ДанныеОтвета;
	СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаJSON, ДанныеОтвета);
	
	Если НЕ ДанныеОтвета = Неопределено Тогда
		Если ЕстьСвойство(ДанныеОтвета, "Error")
			И НЕ ДанныеОтвета.Error Тогда
			ОбщегоНазначенияРМКВызовСервера.УстановитьПризнакПроданПодарочныйСертификат(СерияПодарочногоСертификата, ЭтоОперацияВозврат);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораПодарочногоСертификата()
	
	РежимВыбораПодарочногоСертификата = Истина;
	ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаДополнительныйСписокТоваров);
	НастроитьВидимостьЭлементовГруппыПоискаТовара(Истина);
	Адрес = "";
	ПолучитьАдресТаблицыПодарочныхСертификатов(Адрес);
	ЗаголовокСтраницы = НСтр("ru = 'Выберите подарочный сертификат'");
	ИзменитьСостояниеЗаголовкаСтраницыПоискаТовара(ЗаголовокСтраницы, Истина);
	ОткрытьКаталогКлиент();
	ЗаполнитьДанныеТаблицыДляВыбораНоменклатуры(Адрес);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРежимВыбораПодарочногоСертификатаКлиент(Номенклатура)
	
	ЭтоСерийныйПодарочныйСертификат = ИспользованиеСерий(Номенклатура);
	ОграничениеОплатыПоОрганизациям = ОграничениеОплатыПодарочнымСертификатомПоОргназинациям(Номенклатура);;
	РежимВыбораПодарочногоСертификата = Ложь;
	
	ИнтерфейсРМКСлужебныйКлиентСервер.УстановитьВидимостьГруппыОперации(Элементы);
	ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОбщая);
	НастроитьВидимостьЭлементовГруппыПоискаТовара();
	
	СписокТоваров.Отбор.Элементы.Очистить();
	ВосстановитьОтображениеКаталогаПоНастройкам();
	ИзменитьСостояниеЗаголовкаСтраницыПоискаТовара(, Истина);
	ЭтоВозврат = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	
	ПереместитьТоварыПриПереходеКОплате(Истина, ЭтоВозврат);
	ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаСложнойОплаты);
	ОбработатьВыборСертификата(Номенклатура, ЭтоСерийныйПодарочныйСертификат);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСертификата(ПодарочныйСертификат, ЭтоСерийныйПодарочныйСертификат)
	Если ЭтоСерийныйПодарочныйСертификат Тогда
		ОткрытьВводШтрихкодаПоСертификату(ПодарочныйСертификат, ЭтоСерийныйПодарочныйСертификат);
	Иначе
		НайтиПодарочныйСертификат(ПодарочныйСертификат, ЭтоСерийныйПодарочныйСертификат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиПодарочныйСертификат(ПодарочныйСертификат, ЭтоСерийныйПодарочныйСертификат, НомерСертификата = "")
	РезультатПоискаСертификата = ЗаполнитьПараметрыРезультатаПоискаСертификата();
	НайтиСертификатКлиент(РезультатПоискаСертификата, ПодарочныйСертификат, НомерСертификата);
	
	Если РезультатПоискаСертификата.ЕстьОшибки Тогда
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(РезультатПоискаСертификата.ТекстОшибки);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
	Иначе
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПодарочныйСертификат", ПодарочныйСертификат);
		ДополнительныеПараметры.Вставить("НомерПодарочногоСертификата", НомерСертификата);
		ДополнительныеПараметры.Вставить("СуммаСертификата", РезультатПоискаСертификата.СуммаСертификата);
		ДополнительныеПараметры.Вставить("ЭтоСерийныйПодарочныйСертификат", ЭтоСерийныйПодарочныйСертификат);
		ОткрытьФормуВводаСуммыСертификата(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьПараметрыРезультатаПоискаСертификата()
	РезультатПоискаСертификата = Новый Структура;
	РезультатПоискаСертификата.Вставить("ЕстьОшибки", Ложь);
	РезультатПоискаСертификата.Вставить("ТекстОшибки", НСтр("ru = ''"));
	РезультатПоискаСертификата.Вставить("СуммаСертификата", 0);
	Возврат РезультатПоискаСертификата;
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуВводаСуммыСертификата(ДополнительныеПараметры)
	ДополнительныеПараметрыОповещения = Новый Структура;
	ДополнительныеПараметрыОповещения.Вставить("ПодарочныйСертификат", ДополнительныеПараметры.ПодарочныйСертификат);
	ДополнительныеПараметрыОповещения.Вставить("НомерПодарочногоСертификата", ДополнительныеПараметры.НомерПодарочногоСертификата);
	ДополнительныеПараметрыОповещения.Вставить("ЭтоСерийныйПодарочныйСертификат", ДополнительныеПараметры.ЭтоСерийныйПодарочныйСертификат);
	ДополнительныеПараметрыОповещения.Вставить("БалансСертификата", ДополнительныеПараметры.СуммаСертификата);
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ЗавершитьРезультатВыбораСертификата", ЭтотОбъект, ДополнительныеПараметрыОповещения);
	
	ПараметрыОткрытия = ЗаполнитьПустуюСтруктураФормыВводаСумм();
	ПараметрыОткрытия.Режим = 5;
	ПараметрыОткрытия.СуммаИтого = ОбщийОсталосьОплатить;
	ПараметрыОткрытия.ПодарочныйСертификат = ДополнительныеПараметры.ПодарочныйСертификат;
	ПараметрыОткрытия.НомерПодарочногоСертификата = ДополнительныеПараметры.НомерПодарочногоСертификата;
	ПараметрыОткрытия.СуммаСертификата = ДополнительныеПараметры.СуммаСертификата;
	
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВводаСумм", ПараметрыОткрытия,,,,,ОписаниеОповещенияОЗакрытии);
КонецПроцедуры

&НаСервере
Процедура ДобавитьПодарочныйСертификатВТаблицу(ПараметрыСертификата, СуммаРезультат)
	
	СтрокаДанныхСертификата = ТаблицаПодарочныхСертификатов.Добавить();
	СтрокаДанныхСертификата.СуммаСертификата = СуммаРезультат;
	СтрокаДанныхСертификата.ЛимитСертификата = СуммаРезультат;
	СтрокаДанныхСертификата.НомерСертификата = ПараметрыСертификата.НомерПодарочногоСертификата;
	СтрокаДанныхСертификата.ПодарочныйСертификат = ПараметрыСертификата.ПодарочныйСертификат;
	СтрокаДанныхСертификата.ЭтоСерийныйПодарочныйСертификат = ПараметрыСертификата.ЭтоСерийныйПодарочныйСертификат;
	СтрокаДанныхСертификата.БалансСертификата = ПараметрыСертификата.БалансСертификата;
	СтрокаДанныхСертификата.Организация = ВыбраннаяОрганизация;
	СтрокаДанныхСертификата.СистемаНалогообложения = ВыбраннаяСистемаНалогообложения;
	НовыйИдентификаторСтроки = Новый УникальныйИдентификатор;
	СтрокаДанныхСертификата.УникальныйИдентификатор = СтрЗаменить(Строка(НовыйИдентификаторСтроки),"-", "_");
	СоздатьГруппуСертификата(СтрокаДанныхСертификата);
	СуммаОплаченоСертификатами = СуммаОплаченоСертификатами + СуммаРезультат;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьГруппуСертификата(ПараметрыСертификата)
	
	НомерЭлемента = ПараметрыСертификата.УникальныйИдентификатор;
	ИмяГруппыПодарочныйСертификат = СтрШаблон(НСтр("ru = 'ГруппаПодарочныйСертификат_%1'"), НомерЭлемента);
	
	Элемент = Элементы.Найти(ИмяГруппыПодарочныйСертификат);
	Если Не Элемент = Неопределено Тогда
		Элемент.Видимость = Истина;
		Возврат;
	КонецЕсли;
	
	НоваяГруппаСертификата = Элементы.Добавить(ИмяГруппыПодарочныйСертификат, Тип("ГруппаФормы"), Элементы.ГруппаОплаченоСертификатом);
	НоваяГруппаСертификата.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаСертификата.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаСертификата.ОтображатьЗаголовок = Ложь;
	НоваяГруппаСертификата.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяГруппаСертификата.ОтображатьКакКарточку = Ложь;
	НоваяГруппаСертификата.РастягиватьПоГоризонтали = Истина;
	
	ДобавляемыеРеквизиты = Новый Массив;
	ТипРеквизита = Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.Число15_2РМК.Тип);
	ИмяРеквизитаСуммаСертификата = СтрШаблон(НСтр("ru = 'СуммаОплаченоСертификатом_%1'"), НомерЭлемента);
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизитаСуммаСертификата, ТипРеквизита);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ЭтотОбъект.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ИмяГруппыПользовательГоризонтальная = СтрШаблон(НСтр("ru = 'ГруппаСертификатГоризонтальная_%1'"), НомерЭлемента);
	НоваяГруппаКарточкаГоризонтальная = Элементы.Добавить(ИмяГруппыПользовательГоризонтальная, Тип("ГруппаФормы"), НоваяГруппаСертификата);
	НоваяГруппаКарточкаГоризонтальная.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаКарточкаГоризонтальная.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаКарточкаГоризонтальная.ОтображатьЗаголовок = Ложь;
	НоваяГруппаКарточкаГоризонтальная.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	Если ЗначениеЗаполнено(ПараметрыСертификата.НомерСертификата) Тогда
		ЗаголовокСертификат = СтрШаблон(НСтр("ru = 'Сертификат %1'"), ПараметрыСертификата.НомерСертификата);
	Иначе
		ЗаголовокСертификат = Строка(ПараметрыСертификата.ПодарочныйСертификат);
	КонецЕсли;
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизитаСуммаСертификата, Тип("ПолеФормы"), НоваяГруппаКарточкаГоризонтальная);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = ЗаголовокСертификат;
	НовыйЭлемент.ПутьКДанным = ИмяРеквизитаСуммаСертификата;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
	НовыйЭлемент.КартинкаКнопкиВыбора = БиблиотекаКартинок.РМКЦифроваяПанель;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ИзменитьСуммуСертификата");
	НовыйЭлемент.УстановитьДействие("НачалоВыбора", "СуммаОплатаСертификатамиНачалоВыбора");
	НовыйЭлемент.УстановитьДействие("АвтоПодбор", "СуммаНаличныхКВыдачеАвтоПодбор");
	НовыйЭлемент.Видимость = Истина;
	
	ИмяКомандыУдалитьСертификат = СтрШаблон(НСтр("ru = 'УдалитьСертификат_%1'"), НомерЭлемента);
	НовыйЭлемент = ЭтотОбъект.Элементы.Добавить(ИмяКомандыУдалитьСертификат, Тип("КнопкаФормы"), НоваяГруппаКарточкаГоризонтальная);
	НовыйЭлемент.Заголовок = НСтр("ru = 'Удалить подарочный сертификат'");
	НовыйЭлемент.ИмяКоманды = НСтр("ru = 'УдалитьСертификат'");
	НовыйЭлемент.Отображение = ОтображениеКнопки.Картинка;
	НовыйЭлемент.Важность = ВажностьКнопки.Дополнительная;
	ЭтотОбъект[ИмяРеквизитаСуммаСертификата] = ПараметрыСертификата.СуммаСертификата;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКомандуСертификат()
	Если ТаблицаПодарочныхСертификатов.Количество() > 0
		И Элементы.СтраницыКомандыДобавитьСертификат.ТекущаяСтраница = Элементы.СтраницаДобавитьСертификат Тогда
		Элементы.СтраницыКомандыДобавитьСертификат.ТекущаяСтраница = Элементы.СтраницаДоплатитьСертификатом;
	ИначеЕсли ТаблицаПодарочныхСертификатов.Количество() = 0
		И Элементы.СтраницыКомандыДобавитьСертификат.ТекущаяСтраница = Элементы.СтраницаДоплатитьСертификатом Тогда
		Элементы.СтраницыКомандыДобавитьСертификат.ТекущаяСтраница = Элементы.СтраницаДобавитьСертификат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСертификатНаКлиенте()
	
	СкрытьЦифровуюПанельСложнойОплатыПриНеобходимости();
	ИмяЭлемента = ТекущийЭлемент.Имя;
	УникальныйИдентификаторСертификата = СтрЗаменить(ИмяЭлемента, "УдалитьСертификат_", "");
	СтрокиСертификаты = ТаблицаПодарочныхСертификатов.НайтиСтроки(Новый Структура("УникальныйИдентификатор", УникальныйИдентификаторСертификата));
	Для Каждого СтрокаТаблицы Из СтрокиСертификаты Цикл
		ОчиститьДанныеПодарочногоСертификата(СтрокаТаблицы);
		ТаблицаПодарочныхСертификатов.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	УдалитьЭлементПодарочногоСертификата(УникальныйИдентификаторСертификата);
	
	ПересчитатьСуммыОплатыПриРедактированииСертификатов();
	ИзменитьКомандуСертификат();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ИзменитьСуммуСертификата(Элемент)
	ИмяЭлемента = ТекущийЭлемент.Имя;
	УникальныйИдентификаторСертификата = СтрЗаменить(ИмяЭлемента, "СуммаОплаченоСертификатом_", "");
	ЛимитСертификата = 0;
	СтрокиСертификаты = ТаблицаПодарочныхСертификатов.НайтиСтроки(Новый Структура("УникальныйИдентификатор", УникальныйИдентификаторСертификата));
	СуммаСертификатаДоИзменения = 0;
	Для Каждого СтрокаТаблицы Из СтрокиСертификаты Цикл
		ЛимитСертификата = СтрокаТаблицы.БалансСертификата;
		СуммаСертификатаДоИзменения = СтрокаТаблицы.СуммаСертификата;
	КонецЦикла;
	СуммаОстатокИтого = ОбщийОсталосьОплатить + СуммаСертификатаДоИзменения;
	
	ЛимитСертификата = Мин(СуммаОстатокИтого, ЛимитСертификата);
	СуммаСертификатаЭлемента = ЭтотОбъект[ИмяЭлемента];
	Если СуммаСертификатаЭлемента > ЛимитСертификата Тогда
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Доступно к оплате сертификатом не более %1 %2'"), ЛимитСертификата, ПредставлениеВалюты);
		ПараметрыОткрытияФормыОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения);
		ПараметрыОткрытияФормыОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияФормыОшибки);
		СуммаСертификатаЭлемента = ЛимитСертификата;
		
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из СтрокиСертификаты Цикл
		СтрокаТаблицы.СуммаСертификата = СуммаСертификатаЭлемента;
	КонецЦикла;
	
	ПересчитатьСуммыОплатыПриРедактированииСертификатов();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВсеПодарочныеСертификаты(БезПересчетаСумм = Ложь)
	
	КоличествоПодарочныхСертификатов = ТаблицаПодарочныхСертификатов.Количество();
	МассивСтрокКУдалению = Новый Массив;
	Для Каждого СтрокаСертификат Из ТаблицаПодарочныхСертификатов Цикл
		УдалитьЭлементПодарочногоСертификата(СтрокаСертификат.УникальныйИдентификатор);
		ОчиститьДанныеПодарочногоСертификата(СтрокаСертификат);
	КонецЦикла;
	
	ТаблицаПодарочныхСертификатов.Очистить();
	ИзменитьКомандуСертификат();
	Если БезПересчетаСумм Тогда
		СуммаОплаченоСертификатами = 0;
	Иначе
		ПересчитатьСуммыОплатыПриРедактированииСертификатов();
	КонецЕсли;
	ИзменитьКомандуСертификат();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЭлементПодарочногоСертификата(УникальныйИдентификаторСертификата)
	
	Если НЕ Элементы.Найти("СуммаОплаченоСертификатом_" + УникальныйИдентификаторСертификата) = Неопределено Тогда
		УдаляемыеРеквизиты = Новый Массив;
		УдаляемыеРеквизиты.Добавить("СуммаОплаченоСертификатом_" + УникальныйИдентификаторСертификата);
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);
		
		УдалитьЭлементФормы("ГруппаПодарочныйСертификат_" + УникальныйИдентификаторСертификата);
		УдалитьЭлементФормы("СуммаОплаченоСертификатом_" + УникальныйИдентификаторСертификата);
		УдалитьЭлементФормы("ГруппаСертификатГоризонтальная_" + УникальныйИдентификаторСертификата);
		УдалитьЭлементФормы("УдалитьСертификат_" + УникальныйИдентификаторСертификата);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДанныеПодарочногоСертификата(СтрокаСертификат)
	
	Если СтрокаСертификат.ЭтоСерийныйПодарочныйСертификат Тогда
		ПараметрыСертификата = Новый Структура;
		ПараметрыСертификата.Вставить("СуммаОплаченоСертификатом", СтрокаСертификат.СуммаСертификата);
		ПараметрыСертификата.Вставить("ПодарочныйСертификат", СтрокаСертификат.ПодарочныйСертификат);
		ПараметрыСертификата.Вставить("НомерСертификата", СтрокаСертификат.НомерСертификата);
		РазблокироватьПодарочныйСертификат(ПараметрыСертификата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВводШтрихкодаПоСертификату(ПодарочныйСертификат, ЭтоСерийныйПодарочныйСертификат)
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПодарочныйСертификат", ПодарочныйСертификат);
	ДополнительныеПараметры.Вставить("ЭтоСерийныйПодарочныйСертификат", ЭтоСерийныйПодарочныйСертификат);
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ЗавершитьРезультатПоискаСерииСертификата", ЭтотОбъект, ДополнительныеПараметры);
	ПараметрыОткрытия = ПараметрыФормыВводаШтрихкода();
	ПараметрыОткрытия.ПоискСерии = Истина;
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВводаШтрихкода", ПараметрыОткрытия, ЭтотОбъект,,,,
		ОписаниеОповещенияОЗакрытии,РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
КонецПроцедуры

&НаКлиенте
Процедура РазблокироватьПодарочныйСертификат(ПараметрыСертификата)
	Если ПараметрыСертификата.СуммаОплаченоСертификатом <= 0 Тогда
		Возврат;
	КонецЕсли;
	Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
		ЗначенияПараметровМетода = ЗначениеПараметровПодарочногоСертификата(ПараметрыСертификата.ПодарочныйСертификат,
			ПараметрыСертификата.НомерСертификата);
		
		Если СписокНастроекСервераЛояльности.НайтиПоЗначению("ИспользоватьНовыеМетоды_3_0_11") <> Неопределено Тогда
			ИмяРесурса = "unlockgiftcard3_0";
		ИначеЕсли ИспользоватьНовыйМетодСЛ Тогда
			ИмяРесурса = "unlockgiftcardnew";
		Иначе
			ИмяРесурса = "unlockgiftcard";
		КонецЕсли;
		ПараметрыВыполненияЗапроса = СерверЛояльностиПолучательДанныхКлиентСервер.ПараметрыЗапросаРазблокироватьПодарочныйСертификат(ПараметрыПодключенияКСерверуЛояльности,
		ЗначенияПараметровМетода, ИмяРесурса);
		
		Результат = СерверЛояльностиПолучательДанныхКлиентСервер.ВыполнитьЗапросКСерверуЛояльности(ПараметрыВыполненияЗапроса);
		
		ОбработатьОтветРазблокироватьСертификат(Результат);
	Иначе
		ОбщегоНазначенияРМККлиентПереопределяемый.РазблокироватьОбъектСервераЛояльности("giftcard", ПараметрыСертификата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСертификатВТаблицу(Форма, БалансСертификата, ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ИдентификаторСерий) Тогда
		НомерСертификата = ТекущаяСтрока.ИдентификаторСерий;
	Иначе
		НомерСертификата = Строка(ТекущаяСтрока.Серия.УникальныйИдентификатор());
	КонецЕсли;
	ЭтоСерийныйПодарочныйСертификат = ЗначениеЗаполнено(ТекущаяСтрока.СерияПредставление);
	
	СтрокаДанныхСертификата = Форма.ТаблицаПодарочныхСертификатов.Добавить();
	СтрокаДанныхСертификата.СуммаСертификата = Форма.ТекущийТоварЦенаИзКарточки;
	СтрокаДанныхСертификата.ЛимитСертификата = Форма.ТекущийТоварЦенаИзКарточки;
	СтрокаДанныхСертификата.НомерСертификата = НомерСертификата;
	СтрокаДанныхСертификата.ПодарочныйСертификат = ТекущаяСтрока.Номенклатура;
	СтрокаДанныхСертификата.ЭтоСерийныйПодарочныйСертификат = ЭтоСерийныйПодарочныйСертификат;
	СтрокаДанныхСертификата.БалансСертификата = БалансСертификата;
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСЦифровойКлавиатурой

&НаКлиенте
Функция ВычислитьПозициюВыделенияПослеВставки(РедактируемыйЭлемент, ТекстДоРедактирования,
		НачалоВыделения, КонецВыделения, СимволыКлавиатуры)
	
	РезультатФункции = 0;
	
	ДлинаТекста = СтрДлина(РедактируемыйЭлемент.ТекстРедактирования);
	ДлинаВставки = СтрДлина(СимволыКлавиатуры);
	
	Если РежимЦифровойПанели = РежимыЦифровойПанели.ДанныеПокупателя Тогда
		
		Если ИнтерфейсРМКСлужебныйКлиентСервер.ЭтоПолеТелефонаСМаской(РедактируемыйЭлемент) Тогда
			Если НачалоВыделения < 3 Тогда
				НачалоВыделения = 3;
			КонецЕсли;
			РезультатФункции = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПозициюКурсораСУчетомФорматирования(ТекстДоРедактирования,
				РедактируемыйЭлемент.ТекстРедактирования, НачалоВыделения, ДлинаВставки, " ");
		ИначеЕсли ИнтерфейсРМКСлужебныйКлиентСервер.ЭтоПолеДатыСМаской(РедактируемыйЭлемент) Тогда
			РезультатФункции = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПозициюКурсораСУчетомФорматирования(ТекстДоРедактирования,
				РедактируемыйЭлемент.ТекстРедактирования, НачалоВыделения, ДлинаВставки, ".");
		Иначе
			РезультатФункции = НачалоВыделения + ДлинаВставки;
		КонецЕсли;
		
	Иначе
	
		Если ЭтоПолеСтрокиЦифр(РедактируемыйЭлемент) Тогда
			РезультатФункции = НачалоВыделения + ДлинаВставки;
		Иначе
			
			СимволРазделителя = ИнтерфейсРМКСлужебныйКлиентСервер.РазделительДробнойЧасти();
			ВводДробнойЧасти = Ложь;
			ПозицияРазделителя = -1;
			Если РежимЦифровойПанели = РежимыЦифровойПанели.ВводСуммОплаты Тогда
				ПозицияРазделителя = СтрНайти(ТекстДоРедактирования, СимволРазделителя);
				ВводДробнойЧасти = (НачалоВыделения > ПозицияРазделителя);
			КонецЕсли;
			Если ВводДробнойЧасти Тогда
				
				РезультатФункции = Мин(ДлинаТекста + 1, НачалоВыделения + ДлинаВставки);
				
			ИначеЕсли ПозицияРазделителя > 0 И НачалоВыделения <= ПозицияРазделителя И КонецВыделения > ПозицияРазделителя Тогда
				// Точка внутри выделения
				РезультатФункции = СтрНайти(РедактируемыйЭлемент.ТекстРедактирования, СимволРазделителя);
			Иначе
				ТекстЦелоеДоЕдиницы = СтрШаблон("0%1", СимволРазделителя);
				Если Лев(ТекстДоРедактирования, 2) = ТекстЦелоеДоЕдиницы Тогда
					НачалоВыделения = 1;
				КонецЕсли;
				РезультатФункции = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПозициюКурсораСУчетомФорматирования(ТекстДоРедактирования,
					РедактируемыйЭлемент.ТекстРедактирования, НачалоВыделения, ДлинаВставки, Символы.НПП);
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Процедура УдалитьСимволыВРедактируемомПоле(Знач РедактируемыйЭлемент, СимволИсключения, ПараметрыФорматирования)
	
	Если (Не РедактируемыйЭлемент = Неопределено) И РедактируемыйЭлемент.Доступность Тогда
		
		НачалоВыделения = 0;
		НачалоСтроки = 0;
		КонецВыделения = 0;
		КонецСтроки = 0;
		
		РедактируемыйЭлемент.ПолучитьГраницыВыделения(НачалоСтроки, НачалоВыделения, КонецСтроки, КонецВыделения);
		РедактируемыйТекст = РедактируемыйЭлемент.ТекстРедактирования;
		ТекущийЭлемент = РедактируемыйЭлемент;
		
		НовыйКонецВыделения = 1;
		МинимальноеНачало = ?(ПараметрыФорматирования.ЭтоТелефон, 3, 1);
		СимволЗамены = ?(ПараметрыФорматирования.Форматированный, " ", "");
		Если НачалоВыделения = КонецВыделения Тогда
			Если НачалоВыделения > МинимальноеНачало Тогда
				СимволСлева = Сред(РедактируемыйТекст, НачалоВыделения - 1, 1);
				Если СимволСлева = СимволИсключения Тогда
					НовыйКонецВыделения = НачалоВыделения - 1;
				Иначе
					РедактируемыйЭлемент.УстановитьГраницыВыделения(НачалоВыделения - 1, НачалоВыделения);
					РедактируемыйЭлемент.ВыделенныйТекст = СимволЗамены;
					ОбновитьОтображениеДанных(РедактируемыйЭлемент);
					НовыйКонецВыделения = ВычислитьПозициюВыделенияПослеВставки(РедактируемыйЭлемент, РедактируемыйТекст,
						НачалоВыделения - 1, КонецВыделения, "");
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если ПараметрыФорматирования.ЭтоТелефон И КонецВыделения <= МинимальноеНачало Тогда
				НовыйКонецВыделения = НачалоВыделения;
			Иначе
				РедактируемыйЭлемент.ВыделенныйТекст = СимволЗамены;
				ОбновитьОтображениеДанных(РедактируемыйЭлемент);
				НовыйКонецВыделения = ВычислитьПозициюВыделенияПослеВставки(РедактируемыйЭлемент, РедактируемыйТекст,
					НачалоВыделения, КонецВыделения, "");
			КонецЕсли;
		КонецЕсли;
		
		ТекущийЭлемент = РедактируемыйЭлемент;
		РедактируемыйЭлемент.УстановитьГраницыВыделения(НовыйКонецВыделения, НовыйКонецВыделения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьСимволыВРедактируемоеПоле(Знач РедактируемыйЭлемент, СимволыКлавиатуры)
	
	Если (Не РедактируемыйЭлемент = Неопределено) И РедактируемыйЭлемент.Доступность Тогда
	
		НачалоВыделения = 0;
		НачалоСтроки = 0;
		КонецВыделения = 0;
		КонецСтроки = 0;
		
		РедактируемыйЭлемент.ПолучитьГраницыВыделения(НачалоСтроки, НачалоВыделения, КонецСтроки, КонецВыделения);
		РедактируемыйТекст = РедактируемыйЭлемент.ТекстРедактирования;
		
		ТекущийЭлемент = РедактируемыйЭлемент;
		РедактируемыйЭлемент.ВыделенныйТекст = СимволыКлавиатуры;
		ОбновитьОтображениеДанных(РедактируемыйЭлемент);
		
		НовыйКонецВыделения = ВычислитьПозициюВыделенияПослеВставки(РедактируемыйЭлемент, РедактируемыйТекст,
			НачалоВыделения, КонецВыделения, СимволыКлавиатуры);
			
		ТекущийЭлемент = РедактируемыйЭлемент;
		РедактируемыйЭлемент.УстановитьГраницыВыделения(НовыйКонецВыделения, НовыйКонецВыделения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТекстРедактированияПоляФормы(Знач РедактируемыйЭлемент)
	
	Если (Не РедактируемыйЭлемент = Неопределено) И РедактируемыйЭлемент.Доступность Тогда
		ВводСЦифровойКлавиатуры = (Не РежимКассыСамообслуживания);
		Если Не ИнтерфейсРМКСлужебныйКлиент.ОчиститьТекстРедактированияВПолеФормы(ЭтотОбъект, РедактируемыйЭлемент) Тогда
			СкрытьЦифровуюПанельДляВводаСумм();
		КонецЕсли;
		ВводСЦифровойКлавиатуры = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКомандуЦифровойКлавиатурыУдалитьПоследнее()
	
	ПараметрыФорматирования = Новый Структура("Форматированный, ЭтоТелефон", Ложь, Ложь);
	СимволИсключения = "";
	Если ЭтоРежимРедактированияПоляНадписиКСО() Тогда
		ИмяРеквизитаПоля = ПолучитьИмяСвязанногоРеквизитаПоля();
		Если Не ИмяРеквизитаПоля = "" Тогда
			УдалитьПоследнийЗначимыйСимволВПолеНадписиПриНеобходимости(ИмяРеквизитаПоля);
		КонецЕсли;
	ИначеЕсли РежимВводаСимволовИСумм(РежимЦифровойПанели, РежимыЦифровойПанели) Тогда
		Если Не ЭтоПолеСтрокиЦифр(ЭлементВводаСуммы) Тогда
			СимволИсключения = Символы.НПП;
		КонецЕсли;
		УдалитьСимволыВРедактируемомПоле(ЭлементВводаСуммы, СимволИсключения, ПараметрыФорматирования);
	Иначе
		Если Не ЭлементВводаДанныхПокупателя = Неопределено Тогда
			Если ИнтерфейсРМКСлужебныйКлиентСервер.ЭтоПолеТелефонаСМаской(ЭлементВводаДанныхПокупателя) Тогда
				ПараметрыФорматирования.Форматированный = Истина;
				ПараметрыФорматирования.ЭтоТелефон = Истина;
				СимволИсключения = " ";
			ИначеЕсли ИнтерфейсРМКСлужебныйКлиентСервер.ЭтоПолеДатыСМаской(ЭлементВводаДанныхПокупателя) Тогда
				ПараметрыФорматирования.Форматированный = Истина;
				СимволИсключения = ".";
			КонецЕсли;
			УдалитьСимволыВРедактируемомПоле(ЭлементВводаДанныхПокупателя, СимволИсключения, ПараметрыФорматирования);
			НастроитьКнопкиЦифровойПанели();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКомандуЦифровойКлавиатурыОчистить()
	
	Если ЭтоРежимРедактированияПоляНадписиКСО() Тогда
		ИмяРеквизитаПоля = ПолучитьИмяСвязанногоРеквизитаПоля();
		Если Не ИмяРеквизитаПоля = "" Тогда
			ЭтотОбъект[ИмяРеквизитаПоля] = 0;
			ПозицияПослеТочки = 0;
			ОбработатьИзменениеЗначенияВПолеНадписи(ИмяРеквизитаПоля);
		КонецЕсли;
	ИначеЕсли РежимВводаСимволовИСумм(РежимЦифровойПанели, РежимыЦифровойПанели) Тогда
		ОчиститьТекстРедактированияПоляФормы(ЭлементВводаСуммы);
	Иначе
		
		ОчиститьТекстРедактированияПоляФормы(ЭлементВводаДанныхПокупателя);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЦифруЦифровойКлавиатуры(ИмяКомандыКлавиатуры)
	
	СимволКлавиатуры = ИнтерфейсРМКСлужебныйКлиент.ПолучитьСимволКоманды(ИмяКомандыКлавиатуры);
	ПрименитьСимволыЦифровойКлавиатуры(СимволКлавиатуры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКомандуДваНуляЦифровойКлавиатуры()
	
	СимволыКлавиатуры = ИнтерфейсРМКСлужебныйКлиент.ПолучитьТекстКнопкиДваНуля();
	ПрименитьСимволыЦифровойКлавиатуры(СимволыКлавиатуры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьСимволыЦифровойКлавиатуры(СимволыКлавиатуры)
	
	Если ЭтоРежимРедактированияПоляНадписиКСО() Тогда
		
		ИмяРеквизитаПоля = ПолучитьИмяСвязанногоРеквизитаПоля();
		Если Не ИмяРеквизитаПоля = "" Тогда
			ДобавитьСимволыВПолеНадписи(ИмяРеквизитаПоля, СимволыКлавиатуры);
		КонецЕсли;
		
	ИначеЕсли РежимВводаСимволовИСумм(РежимЦифровойПанели, РежимыЦифровойПанели) Тогда
		
		ВставитьСимволыВРедактируемоеПоле(ЭлементВводаСуммы, СимволыКлавиатуры);
		
	Иначе
		
		ВставитьСимволыВРедактируемоеПоле(ЭлементВводаДанныхПокупателя, СимволыКлавиатуры);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКомандуЦифровойКлавиатурыВводПоиск()
	
	Если РежимЦифровойПанели = РежимыЦифровойПанели.ДанныеПокупателя Тогда
		
		ОбработатьШтрихкодКлиент(СтрокаПоискаКарты);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКомандуЦифровойКлавиатурыЗвездочкаЗапятая()
	
	Если ЭтоРежимРедактированияПоляНадписиКСО() Тогда
		Если ПозицияПослеТочки <= 0 Тогда
			ПозицияПослеТочки = 1;
		КонецЕсли;
	ИначеЕсли РежимЦифровойПанели = РежимыЦифровойПанели.ВводСуммОплаты Тогда
		ПеревестиКурсорНаВводДробнойЧасти();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяСвязанногоРеквизитаПоля(ЭлементВводаДанных = Неопределено)
	Если ЭлементВводаДанных = Неопределено Тогда
		ЭлементВводаДанных = ЭлементВводаСуммы;
	КонецЕсли;
	
	РезультатФункции = "";
	Если ЭлементВводаДанных = Элементы.КоличествоКСО Тогда
		РезультатФункции = "ТекущийТоварКоличество";
	ИначеЕсли ЭлементВводаДанных = Элементы.ЦенаИзКарточкиКСО Тогда
		РезультатФункции = "ТекущийТоварЦенаИзКарточки";
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Функция ЭтоРежимРедактированияПоляНадписиКСО()
	
	ИспользуетсяПолеНадписи = Ложь;
	Если РежимВводаСимволовИСумм(РежимЦифровойПанели, РежимыЦифровойПанели)
			И ТипЗнч(ЭлементВводаСуммы) = Тип("ПолеФормы") И ЭлементВводаСуммы.Вид = ВидПоляФормы.ПолеНадписи Тогда
		ИспользуетсяПолеНадписи = Истина;
	КонецЕсли;
	Возврат (РежимКассыСамообслуживания И ЭтоИнтерфейс85 И ИспользуетсяПолеНадписи);
	
КонецФункции

&НаКлиенте
Функция ПолучитьКоличествоЗнаковСвязанногоПоля()
	
	РезультатФункцмм = 1;
	НачалоРаздела = СтрНайти(ЭлементВводаСуммы.Формат, "ЧДЦ=");
	Если НачалоРаздела > 0 Тогда
		СимволКоличества = Сред(ЭлементВводаСуммы.Формат, НачалоРаздела + 4, 1);
		ТипЧисло = Новый ОписаниеТипов("Число");
		РезультатФункцмм = ТипЧисло.ПривестиЗначение(СимволКоличества);
	КонецЕсли;
	Возврат РезультатФункцмм;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеЗначенияВПолеНадписи(ИмяРеквизитаПоля)
	
	Если ИмяРеквизитаПоля = "ТекущийТоварКоличество" Тогда
		КоличествоТовараПриИзменении(ЭлементВводаСуммы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСимволыВПолеНадписи(ИмяРеквизитаПоля, СимволыКлавиатуры)
	
	Если СимволыКлавиатуры = "00" Тогда
		ДобавитьДваНуляВПолеНадписи(ИмяРеквизитаПоля);
	Иначе
		ДобавитьЦифруВПолеНадписи(ИмяРеквизитаПоля, СимволыКлавиатуры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПоследнийЗначимыйСимволВПолеНадписиПриНеобходимости(ИмяРеквизитаПоля)
	
	Если ЭтотОбъект[ИмяРеквизитаПоля] <> 0 Тогда
		ЧислоЗнаков = ПолучитьКоличествоЗНаковСвязанногоПоля();
		ИсходнаяСтрока = Формат(ЭтотОбъект[ИмяРеквизитаПоля], СтрШаблон("ЧДЦ=%1; ЧГ=", ЧислоЗнаков));
		УдалитьПоследнийЗначимыйСимволВПолеНадписи(ИмяРеквизитаПоля, ИсходнаяСтрока);
	Иначе
		ПозицияПослеТочки = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПоследнийЗначимыйСимволВПолеНадписи(ИмяРеквизитаПоля, ИсходнаяСтрока)
	
	БылоУдалениеСимвола = Ложь;
	СтрокаЦифр = "123456789";
	СимволРазделителя = ИнтерфейсРМКСлужебныйКлиентСервер.РазделительДробнойЧасти();
	ПозицияРазделителя = СтрНайти(ИсходнаяСтрока, СимволРазделителя);
	Если ПозицияРазделителя > 0 Тогда
		Счт = СтрДлина(ИсходнаяСтрока);
		Пока Счт > ПозицияРазделителя И Не БылоУдалениеСимвола Цикл
			ТекущийСимвол = Сред(ИсходнаяСтрока, Счт, 1);
			Если СтрНайти(СтрокаЦифр, ТекущийСимвол) > 0 Тогда
				ТипЧисло = Новый ОписаниеТипов("Число");
				БылоУдалениеСимвола = Истина;
				ЧастьДо = Лев(ИсходнаяСтрока, Счт - 1);
				ЧастьПосле = "0";
				ВычисленнаяСтрока = СтрШаблон("%1%2", ЧастьДо, ЧастьПосле);
				ЭтотОбъект[ИмяРеквизитаПоля] = ТипЧисло.ПривестиЗначение(ВычисленнаяСтрока);
				ПозицияПослеТочки = Счт - ПозицияРазделителя;
			КонецЕсли;
			Счт = Счт - 1;
		КонецЦикла;
	КонецЕсли;
	Если Не БылоУдалениеСимвола Тогда
		ЭтотОбъект[ИмяРеквизитаПоля] = Цел(ЭтотОбъект[ИмяРеквизитаПоля] / 10);
		ПозицияПослеТочки = 0;
	КонецЕсли;
	ОбработатьИзменениеЗначенияВПолеНадписи(ИмяРеквизитаПоля);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДваНуляВПолеНадписи(ИмяРеквизитаПоля)
	
	СимволыДваНуля = "00";
	Если ПозицияПослеТочки = -1 Тогда
		ЭтотОбъект[ИмяРеквизитаПоля] = 0;
		ПозицияПослеТочки = 0;
	ИначеЕсли ПозицияПослеТочки = 0 Тогда
		ЭтотОбъект[ИмяРеквизитаПоля] = ЭтотОбъект[ИмяРеквизитаПоля] * 100;
	Иначе
		ЧислоЗнаков = ПолучитьКоличествоЗНаковСвязанногоПоля();
		Если ПозицияПослеТочки > ЧислоЗнаков Тогда
			ПозицияПослеТочки = ЧислоЗнаков;
		КонецЕсли;
		СимволРазделителя = ИнтерфейсРМКСлужебныйКлиентСервер.РазделительДробнойЧасти();
		ИсходнаяСтрока = Формат(ЭтотОбъект[ИмяРеквизитаПоля], СтрШаблон("ЧДЦ=%1; ЧГ=", ЧислоЗнаков));
		Если ИсходнаяСтрока = "" Тогда
			ЭтотОбъект[ИмяРеквизитаПоля] = 0;
		Иначе
			ТипЧисло = Новый ОписаниеТипов("Число");
			НомерПозицииРазделителя = СтрНайти(ИсходнаяСтрока, СимволРазделителя);
			ЧастьДо = Лев(ИсходнаяСтрока, НомерПозицииРазделителя + ПозицияПослеТочки - 1);
			ЧастьПосле = Сред(ИсходнаяСтрока, НомерПозицииРазделителя + ПозицияПослеТочки + 2);
			ВычисленнаяСтрока = СтрШаблон("%1%2%3", ЧастьДо, СимволыДваНуля, ЧастьПосле);
			ЭтотОбъект[ИмяРеквизитаПоля] = ТипЧисло.ПривестиЗначение(ВычисленнаяСтрока);
		КонецЕсли;
		ПозицияПослеТочки = ПозицияПослеТочки + 2;
		Если ПозицияПослеТочки > ЧислоЗнаков + 1 Тогда
			ПозицияПослеТочки = ЧислоЗнаков + 1;
		КонецЕсли;
	КонецЕсли;
	ОбработатьИзменениеЗначенияВПолеНадписи(ИмяРеквизитаПоля);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЦифруВПолеНадписи(ИмяРеквизитаПоля, СимволыКлавиатуры)
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	ЦифраКлавиатуры = ТипЧисло.ПривестиЗначение(СимволыКлавиатуры);
	Если ПозицияПослеТочки = -1 Тогда
		ЭтотОбъект[ИмяРеквизитаПоля] = ЦифраКлавиатуры;
		ПозицияПослеТочки = 0;
	ИначеЕсли ПозицияПослеТочки = 0 Тогда
		ЭтотОбъект[ИмяРеквизитаПоля] = ЭтотОбъект[ИмяРеквизитаПоля] * 10 + ЦифраКлавиатуры;
	Иначе
		ЧислоЗнаков = ПолучитьКоличествоЗНаковСвязанногоПоля();
		Если ПозицияПослеТочки > ЧислоЗнаков Тогда
			ПозицияПослеТочки = ЧислоЗнаков;
		КонецЕсли;
		СимволРазделителя = ИнтерфейсРМКСлужебныйКлиентСервер.РазделительДробнойЧасти();
		ИсходнаяСтрока = Формат(ЭтотОбъект[ИмяРеквизитаПоля], СтрШаблон("ЧДЦ=%1; ЧГ=", ЧислоЗнаков));
		Если ИсходнаяСтрока = "" Тогда
			ЧастьДо = "0" + СимволРазделителя;
			Счт = 0;
			Пока Счт < ПозицияПослеТочки - 1 Цикл
				ЧастьДо = ЧастьДо + "0";
				Счт = Счт + 1;
			КонецЦикла;
			ЧастьПосле = "";
		Иначе
			НомерПозицииРазделителя = СтрНайти(ИсходнаяСтрока, СимволРазделителя);
			ЧастьДо = Лев(ИсходнаяСтрока, НомерПозицииРазделителя + ПозицияПослеТочки - 1);
			ЧастьПосле = Сред(ИсходнаяСтрока, НомерПозицииРазделителя + ПозицияПослеТочки + 1);
		КонецЕсли;
		ВычисленнаяСтрока = СтрШаблон("%1%2%3", ЧастьДо, СимволыКлавиатуры, ЧастьПосле);
		ЭтотОбъект[ИмяРеквизитаПоля] = ТипЧисло.ПривестиЗначение(ВычисленнаяСтрока);
		Если ПозицияПослеТочки <= ЧислоЗнаков Тогда
			ПозицияПослеТочки = ПозицияПослеТочки + 1;
		КонецЕсли;
	КонецЕсли;
	ОбработатьИзменениеЗначенияВПолеНадписи(ИмяРеквизитаПоля);
	
КонецПроцедуры

#КонецОбласти

#Область КомандыНастройкиВводаПоСтроке

&НаКлиенте
Процедура НастройкаВводаПоСтрокеОткрытьНастройки(Команда)
	Элементы.ГруппаНастройкаВводаПоСтрокеСвертываемая.Показать();
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВводаПоСтрокеЗакрыть(Команда)
	Элементы.ГруппаНастройкаВводаПоСтрокеСвертываемая.Скрыть();
	ТекущийЭлемент = Элементы.НастройкаВводаПоСтрокеОткрытьНастройки;
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВводаВыключательПоляПриИзменении(Элемент)
	
	ИменаСтраниц = Новый Массив;
	ИменаСтраниц.Добавить("СпособПоиска");
	ИменаСтраниц.Добавить("СпособПоискаСПрефексом");
	ИменаСтраниц.Добавить("Отображать");
	
	Для Каждого СтрокаПоля Из НастройкаВводаПоСтрокеНастройкиПолей Цикл
		ИмяПоляКаталога = СтрокаПоля.ИмяПоля;
		Для Каждого ИмяСтраницы Из ИменаСтраниц Цикл
			ИмяРеквизита = "НастройкаВвода" + ИмяСтраницы + "_" + ИмяПоляКаталога;
			СтрокаПоля[ИмяСтраницы] = ЭтотОбъект[ИмяРеквизита];
		КонецЦикла;
	КонецЦикла;
	
	СформироватьСтрокуНастроекВводаПоСтроке();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНастройкаВводаПорядок(Команда)
	
	НомерПоля = СтрЗаменить(Команда.Имя, "НастройкаВводаПорядок_", "");
	Направление = ?(Сред(НомерПоля, 2) = "Вниз", 1, -1);
	НомерПоля = Лев(НомерПоля, 1);
	СтруктураОтбора = Новый Структура("Порядок", Число(НомерПоля));
	СтрокиПолей = НастройкаВводаПоСтрокеНастройкиПолей.НайтиСтроки(СтруктураОтбора);
	
	Если СтрокиПолей.Количество() > 0 Тогда
		СтрокаПоля = СтрокиПолей[0];
		ИмяПоля = СтрокаПоля.ИмяПоля;
		ТекущееЗначение = СтрокаПоля["Порядок"];
		НастройкаВводаПоСтрокеНастройкиПолей.Сдвинуть(ТекущееЗначение, Направление);
		ОбновитьНаименованиеКнопокПолей();
	КонецЕсли;
	
	СформироватьСтрокуНастроекВводаПоСтроке();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВводаПоСтрокеИспользоватьПриИзменении(Элемент)
	
	ОбновитьЭлементыНастроекВводаПоСтроке();
	СформироватьСтрокуНастроекВводаПоСтроке();
	
КонецПроцедуры

#КонецОбласти

#Область НастройкиВводаПоСтроке

&НаКлиенте
Процедура УстановитьОтборПоляВводаПоСтроке(Отбор)
	
	Отбор.Вставить("ЭтоВызовИзРМК", Истина);
	Если Не НастройкаВводаПоСтрокеПоказыватьНеактуальные Тогда
		Отбор.Вставить("ПометкаУдаления", Ложь);
	КонецЕсли;
	Если НастройкаВводаПоСтрокеИспользовать Тогда
		Отбор.Вставить("НастройкиПолейСтрокой", НастройкаВводаПоСтрокеНастройкиПолейСтрокой);
		Отбор.Вставить("ВидЦеныРМК", РозничныйВидЦены);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСтрокуНастроекВводаПоСтроке()
	
	Если Не НастройкаВводаПоСтрокеИспользовать Тогда
		НастройкаВводаПоСтрокеНастройкиПолейСтрокой = "";
	КонецЕсли;
	
	ПоляПоискаСНастройками = Новый Массив;
	
	Для Каждого СтрокаПоля Из НастройкаВводаПоСтрокеНастройкиПолей Цикл
		
		ТекстПоляСНастройками = СтрокаПоля.ИмяПоля;
		
		ТекстПоляСНастройками = СтрШаблон("%1/%2", ТекстПоляСНастройками, СтрокаПоля.СпособПоиска);
		ТекстПоляСНастройками = СтрШаблон("%1/%2", ТекстПоляСНастройками, СтрокаПоля.СпособПоискаСПрефексом);
		ТекстПоляСНастройками = СтрШаблон("%1/%2", ТекстПоляСНастройками, СтрокаПоля.Порядок);
		ТекстПоляСНастройками = СтрШаблон("%1/%2", ТекстПоляСНастройками, СтрокаПоля.Отображать);
		
		ПоляПоискаСНастройками.Добавить(ТекстПоляСНастройками);
		
	КонецЦикла;
	
	ПоляПоискаСНастройками = СтрСоединить(ПоляПоискаСНастройками, ",");
	НастройкаВводаПоСтрокеНастройкиПолейСтрокой = ПоляПоискаСНастройками;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНаименованиеКнопокПолей()
	
	ИндексСтроки = 0;
	Для Каждого СтрокаПоля Из НастройкаВводаПоСтрокеНастройкиПолей Цикл
		СтрокаПоля.Порядок = ИндексСтроки;
		Элементы["НастройкаВводаПорядок_" + ИндексСтроки + "Надпись"].Заголовок = СтрокаПоля.ИмяПоля;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЭлементыНастроекВводаПоСтроке()
	
	Для Каждого Страница Из Элементы.ГруппаНастройкаВводаПоСтрокеСтраницы.ПодчиненныеЭлементы Цикл
		Если Страница.Имя = "НастройкаВводаОсновное" Тогда
			Продолжить;
		КонецЕсли;
		Страница.Видимость = НастройкаВводаПоСтрокеИспользовать;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтображениеНастроекПолейВводаПоСтроке()
	
	Если Не ИспользоватьБыстроеДобавлениеТовара Или РежимКассыСамообслуживания 
		Или Не НастройкаВводаПоСтрокеВозможноИспользовать Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИмяПоляКаталога Из НастройкаВводаПоСтрокеИменаПолей Цикл
		
		ИмяКолонки = ИмяПоляКаталога.Значение;
		Отбор = Новый Структура("ИмяПоля", ИмяКолонки);
		СтрокиПолей = НастройкаВводаПоСтрокеНастройкиПолей.НайтиСтроки(Отбор);
		
		Если СтрокиПолей.Количество() = 0 Тогда
			СтрокаПоля = НастройкаВводаПоСтрокеНастройкиПолей.Добавить();
			СтрокаПоля.ИмяПоля = ИмяКолонки;
		КонецЕсли;
		
	КонецЦикла;
	
	ПорядковыйНомер = 0;
	Для Каждого СтрокаПоля Из НастройкаВводаПоСтрокеНастройкиПолей Цикл
		СтрокаПоля.Порядок = ПорядковыйНомер;
		ПорядковыйНомер = ПорядковыйНомер + 1;
	КонецЦикла;
	
	ОбновитьНаименованиеКнопокПолей();
	ОбновитьЭлементыНастроекВводаПоСтроке();
	СформироватьСтрокуНастроекВводаПоСтроке();
	
	ИменаСтраниц = Новый Массив;
	ИменаСтраниц.Добавить("СпособПоиска");
	ИменаСтраниц.Добавить("СпособПоискаСПрефексом");
	ИменаСтраниц.Добавить("Отображать");
	
	Для Каждого СтрокаПоля Из НастройкаВводаПоСтрокеНастройкиПолей Цикл
		ИмяПоляКаталога = СтрокаПоля.ИмяПоля;
		Для Каждого ИмяСтраницы Из ИменаСтраниц Цикл
			ИмяРеквизита = "НастройкаВвода" + ИмяСтраницы + "_" + ИмяПоляКаталога;
			ЭтотОбъект[ИмяРеквизита] = СтрокаПоля[ИмяСтраницы];
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыНастроекВводаПоСтроке()
	
	Если Не ИспользоватьБыстроеДобавлениеТовара Или РежимКассыСамообслуживания 
		Или Не НастройкаВводаПоСтрокеВозможноИспользовать Тогда
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаНастройкаВводаПоСтроке, Ложь);
		Возврат;
	КонецЕсли;
	
	НастройкаВводаПоСтрокеИменаПолей.Очистить();
	НастройкаВводаПоСтрокеИменаПолей.Добавить("Наименование");
	НастройкаВводаПоСтрокеИменаПолей.Добавить("Код");
	НастройкаВводаПоСтрокеИменаПолей.Добавить("Артикул");
	НастройкаВводаПоСтрокеИменаПолей.Добавить("Штрихкод");
	НастройкаВводаПоСтрокеИменаПолей.Добавить("Цена");
	НастройкаВводаПоСтрокеИменаПолей.Добавить("SKU");
	
	ИменаСтраниц = Новый Массив;
	ИменаСтраниц.Добавить("СпособПоиска");
	ИменаСтраниц.Добавить("СпособПоискаСПрефексом");
	ИменаСтраниц.Добавить("Порядок");
	ИменаСтраниц.Добавить("Отображать");
	
	Для Каждого ИмяСтраницы Из ИменаСтраниц Цикл
		
		СтраницаЭлементов = Элементы["НастройкаВвода" + ИмяСтраницы];
		
		НомПП = 0;
		ДобавляемыеРеквизиты = Новый Массив;
		Для Каждого ИмяПоляКаталога Из НастройкаВводаПоСтрокеИменаПолей Цикл
			ИмяРеквизита = "НастройкаВвода" + ИмяСтраницы + "_" + ИмяПоляКаталога;
			НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Булево")); 
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		КонецЦикла;
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		Для Каждого ИмяПоляКаталога Из НастройкаВводаПоСтрокеИменаПолей Цикл
			Если ИмяСтраницы = "Порядок" Тогда
				
				ИмяЭлемента = "НастройкаВвода" + ИмяСтраницы + "_" + НомПП;
				ЭлементГруппа = Элементы.Добавить(ИмяЭлемента + "Группа", Тип("ГруппаФормы"), СтраницаЭлементов);
				ЭлементГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
				ЭлементГруппа.ОтображатьЗаголовок = Ложь;
				
				ИмяКоманды = ИмяЭлемента + "Вниз";
				КомандаПорядок = Команды.Добавить(ИмяКоманды);
				КомандаПорядок.Действие = "КомандаНастройкаВводаПорядок";
				КомандаПорядок.Картинка = БиблиотекаКартинок.ПереместитьВниз;
				КомандаПорядок.Отображение = ОтображениеКнопки.Картинка;
				
				ЭлементКнопкаПорядок = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементГруппа);
				ЭлементКнопкаПорядок.ИмяКоманды = ИмяКоманды;
				ЭлементКнопкаПорядок.Важность = ВажностьКнопки.Дополнительная;
				
				Если НомПП = 5 Тогда
					ЭлементКнопкаПорядок.Доступность = Ложь;
				КонецЕсли;
				
				ИмяКоманды = ИмяЭлемента + "Вверх";
				КомандаПорядок = Команды.Добавить(ИмяКоманды);
				КомандаПорядок.Действие = "КомандаНастройкаВводаПорядок";
				КомандаПорядок.Картинка = БиблиотекаКартинок.ПереместитьВверх;
				КомандаПорядок.Отображение = ОтображениеКнопки.Картинка;
				
				ЭлементКнопкаПорядок = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементГруппа);
				ЭлементКнопкаПорядок.ИмяКоманды = ИмяКоманды;
				ЭлементКнопкаПорядок.Важность = ВажностьКнопки.Дополнительная;
				
				Если НомПП = 0 Тогда
					ЭлементКнопкаПорядок.Доступность = Ложь;
				КонецЕсли;
				
				ЭлементНадпись = Элементы.Добавить(ИмяЭлемента + "Надпись" , Тип("ДекорацияФормы"), ЭлементГруппа);
				ЭлементНадпись.Вид = ВидДекорацииФормы.Надпись;
				ЭлементНадпись.Заголовок = ИмяПоляКаталога;
				ЭлементНадпись.Ширина = 16;
				НомПП = НомПП + 1;
				
			Иначе
				
				ИмяРеквизита = "НастройкаВвода" + ИмяСтраницы + "_" + ИмяПоляКаталога;
				ЭлементВыключатель = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), СтраницаЭлементов);
				ЭлементВыключатель.Вид = ВидПоляФормы.ПолеФлажка;
				ЭлементВыключатель.ВидФлажка = ВидФлажка.Выключатель;
				ЭлементВыключатель.ПутьКДанным = ИмяРеквизита;
				ЭлементВыключатель.Заголовок = ИмяПоляКаталога;
				ЭлементВыключатель.УстановитьДействие("ПриИзменении", "НастройкаВводаВыключательПоляПриИзменении");
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОграничениеОплаты

&НаКлиенте
Функция ТекстПодсказкиОграничениеОплатыБалламиМинимальныйОстаток(УстановленоОграничение, КоличествоБонусовОграничение)
	ШаблонДекорации = "";
	Если УстановленоОграничение Тогда
		ШаблонДекорации = СтрШаблон(НСтр("ru = 'Оплата возможна, если остаток больше %1 баллов'"), КоличествоБонусовОграничение);
	Иначе
		ШаблонДекорации = НСтр("ru = ''");
	КонецЕсли;
	Возврат ШаблонДекорации;
КонецФУнкции

#КонецОбласти

#Область КомментарийПричинаВозврата

&НаКлиенте
Процедура ВвестиКомментарийПричинуВозвратаКлиент()
	
	ЭтоВозвратПродажи = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	
	ПараметрыОткрытия = ПараметрыФормыВводаКомментарияПричиныВозврата();
	ПараметрыОткрытия.ВыводитьКомментарийКЧеку = ВыводитьКомментарийКЧеку;
	ПараметрыОткрытия.КомментарийКЧеку = КомментарийКЧеку;
	
	Если ЭтоВозвратПродажи Тогда
		ПараметрыОткрытия.УказыватьПричинуВозврата = УказыватьПричинуВозврата;
		ПараметрыОткрытия.ЗаголовокФормы = НСтр("ru = 'Причина возврата'");
		ПараметрыОткрытия.ПричинаВозврата = ПричинаВозврата;
	Иначе
		ПараметрыОткрытия.ЗаголовокФормы = НСтр("ru = 'Комментарий к продаже'");
	КонецЕсли;
	
	ОбработкаОповещения = Новый ОписаниеОповещения("ВвестиКомментарийПричинуВозвратаЗавершение",
		ЭтотОбъект);
	
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВводаКомментарияПричиныВозврата",
		ПараметрыОткрытия, ЭтотОбъект,,,, ОбработкаОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьПричинуВозврата(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		ВыборЧекаЗавершение(Результат, ДополнительныеПараметры);
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = ПараметрыФормыВводаКомментарияПричиныВозврата();
	ПараметрыОткрытия.ВыводитьКомментарийКЧеку = ВыводитьКомментарийКЧеку;
	ПараметрыОткрытия.УказыватьПричинуВозврата = Истина;
	ПараметрыОткрытия.ЗаголовокФормы = НСтр("ru = 'Причина возврата'");
	ПараметрыОткрытия.ВыборЧекаНаВозврат = Истина;
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("РезультатВыбораЧека", Результат);
	ПараметрыОповещения.Вставить("ДополнительныеПараметрыВыбораЧека", ДополнительныеПараметры);
	
	ОбработкаОповещения = Новый ОписаниеОповещения("ВвестиКомментарийПричинуВозвратаЗавершение",
		ЭтотОбъект, ПараметрыОповещения);
	
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВводаКомментарияПричиныВозврата",
		ПараметрыОткрытия, ЭтотОбъект,,,, ОбработкаОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиКомментарийПричинуВозвратаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеРезультата = ПараметрыФормыВводаКомментарияПричиныВозврата();
	ЗаполнитьЗначенияСвойств(ДанныеРезультата, Результат);
	
	Если ДанныеРезультата.ВыводитьКомментарийКЧеку Тогда
		КомментарийКЧеку = ДанныеРезультата.КомментарийКЧеку;
		УстановитьИконкуКомментарияКЧеку(Элементы.ВвестиКомментарийКЧеку, КомментарийКЧеку);
	КонецЕсли;
	Если ДанныеРезультата.УказыватьПричинуВозврата Тогда
		ПричинаВозврата = ДанныеРезультата.ПричинаВозврата;
		Элементы.ВвестиКомментарийКЧеку.Видимость = Не РежимПлитки;
	КонецЕсли;
	
	Если ДанныеРезультата.ВыборЧекаНаВозврат
		И ДополнительныеПараметры <> Неопределено
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДополнительныеПараметры,
			"РезультатВыбораЧека") Тогда
		
		РезультатВыбораЧека = Неопределено;
		ДополнительныеПараметрыВыбораЧека = Неопределено;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДополнительныеПараметры,
			"ДополнительныеПараметрыВыбораЧека") Тогда
			
			ДополнительныеПараметрыВыбораЧека = ДополнительныеПараметры.ДополнительныеПараметрыВыбораЧека;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПричинаВозврата) Тогда
			РезультатВыбораЧека = ДополнительныеПараметры.РезультатВыбораЧека;
		КонецЕсли;
		ВыборЧекаЗавершение(РезультатВыбораЧека, ДополнительныеПараметрыВыбораЧека);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыФормыВводаКомментарияПричиныВозврата()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыборЧекаНаВозврат", Ложь);
	ПараметрыФормы.Вставить("ВыводитьКомментарийКЧеку", Ложь);
	ПараметрыФормы.Вставить("ЗаголовокФормы", "");
	ПараметрыФормы.Вставить("КомментарийКЧеку", "");
	ПараметрыФормы.Вставить("ПричинаВозврата", Неопределено);
	ПараметрыФормы.Вставить("УказыватьПричинуВозврата", Ложь);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура НастроитьКнопкуВвестиКомментарийКЧеку()
	
	РежимПлиткиБезЗакрытияПриВыборе = РежимПлитки И НЕ ЗакрыватьПодборПриВыбореТовара;
	ЭтоВозвратПродажи = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	ВыводитьКомментарийПричинуВозвратов = ВыводитьКомментарийКЧеку ИЛИ (УказыватьПричинуВозврата И ЭтоВозвратПродажи);
	ПодходящийРежимИнтерфейса = (НЕ РежимКассыСамообслуживания) И (НЕ РежимПлитки ИЛИ РежимПлиткиБезЗакрытияПриВыборе);
	ВидимостьКнопкиВвестиКомментарийКЧеку = ВыводитьКомментарийПричинуВозвратов И ПодходящийРежимИнтерфейса;
	
	Элементы.ВвестиКомментарийКЧеку.Видимость = ВидимостьКнопкиВвестиКомментарийКЧеку;
	Если Элементы.ВвестиКомментарийКЧеку.Высота = 0 Тогда
		Элементы.ВвестиКомментарийКЧеку.Высота = 1;
	КонецЕсли;
	
	Если ВыводитьКомментарийКЧеку И УказыватьПричинуВозврата И ЭтоВозвратПродажи Тогда
		ЗаголовокПодсказки = НСтр("ru = 'Ввести комментарий и причину возврата'")
	ИначеЕсли НЕ ВыводитьКомментарийКЧеку И УказыватьПричинуВозврата И ЭтоВозвратПродажи Тогда
		ЗаголовокПодсказки = НСтр("ru = 'Ввести причину возврата'")
	Иначе
		ЗаголовокПодсказки = НСтр("ru = 'Ввести комментарий'")
	КонецЕсли;
	Элементы.ВвестиКомментарийКЧеку.РасширеннаяПодсказка.Заголовок = ЗаголовокПодсказки;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьИконкуКомментарияКЧеку(Элемент, КомментарийКЧеку)
	
	Если ЗначениеЗаполнено(КомментарийКЧеку) Тогда
		КартинкаКомментария = БиблиотекаКартинок.РМККомментарийЗаполнен;
	Иначе
		КартинкаКомментария = БиблиотекаКартинок.РМККомментарийПустой;
	КонецЕсли;
	
	Элемент.Картинка = КартинкаКомментария;
	
КонецПроцедуры

#КонецОбласти

#Область УточненияПринадлежностиЗапасов

&НаКлиенте
Процедура УстановитьПоставщикаТекущейСтроки(ТекущаяСтрока)
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Поставщик) Тогда
		Если ТекущаяСтрока.ЭтоАгентскаяУслуга Тогда
			ЗаголовокПоставщика = НСтр("ru = 'Агент:'");
		Иначе
			ЗаголовокПоставщика = НСтр("ru = 'Комитент:'");
		КонецЕсли;
		Элементы.ПоставщикТекущейСтроки.Заголовок = ЗаголовокПоставщика;
		ПоставщикТекущейСтроки = ТекущаяСтрока.Поставщик;
		УстановитьВидимостьЭлементаФормы(Элементы.ПоставщикТекущейСтроки, Истина);
	Иначе
		УстановитьВидимостьЭлементаФормы(Элементы.ПоставщикТекущейСтроки, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКэшУточненияПринадлежностиЗапасовКорзины()
	
	Если НЕ ИспользоватьУточненияПринадлежностиЗапасов Тогда
		Возврат;
	КонецЕсли;
	
	Если КэшиСтрокТоваров.Свойство("КэшПлитки") Тогда
		
		МассивНоменклатурыКСохранению = Новый Массив;
		
		Для Каждого СтрокаКэшаПлитки ИЗ КэшиСтрокТоваров.КэшПлитки Цикл
			
			ЭлементУточнения = КэшУточненияПринадлежностиЗапасов.Получить(СтрокаКэшаПлитки.Номенклатура);
			Если НЕ ЭлементУточнения = Неопределено Тогда
				Если МассивНоменклатурыКСохранению.Найти(СтрокаКэшаПлитки.Номенклатура) = Неопределено Тогда
					МассивНоменклатурыКСохранению.Добавить(СтрокаКэшаПлитки.Номенклатура);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		ОчищенныйКэшУточненияПринадлежностиЗапасов = Новый Соответствие;
		Для Каждого СоответствиеУточненияПринадлежности Из КэшУточненияПринадлежностиЗапасов Цикл
			Если НЕ МассивНоменклатурыКСохранению.Найти(СоответствиеУточненияПринадлежности.Ключ) = Неопределено Тогда
				ОчищенныйКэшУточненияПринадлежностиЗапасов.Вставить(СоответствиеУточненияПринадлежности.Ключ, СоответствиеУточненияПринадлежности.Значение);
			КонецЕсли;
		КонецЦикла;
		
		КэшУточненияПринадлежностиЗапасов = ОчищенныйКэшУточненияПринадлежностиЗапасов;
		
	Иначе
		
		КэшУточненияПринадлежностиЗапасов.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьИспользованиеУточненияПринадлежностиЗапасов()
	
	ОбщегоНазначенияРМК.УстановитьИспользованиеУточненияПринадлежностиЗапасов(ИспользоватьУточненияПринадлежностиЗапасов);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОрганизаюКомитентаПоСпискуИдентификаторов()
	
	СписокИдентификаторов = СписокИдентификаторовСтрокДляУточнения.Скопировать();
	
	Для Каждого ИдентификаторСтроки ИЗ СписокИдентификаторов Цикл
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ИдентификаторСтроки", ИдентификаторСтроки.Значение);
		
		СтрокиКорзины = Объект.Товары.НайтиСтроки(СтруктураОтбора);
		
		ОткрытаФормаУточнения = Ложь;
		Для Каждого СтрокаКорзины ИЗ СтрокиКорзины Цикл
			ЗаполнитьОрганизаюКомитентаПоУточнению(СтрокаКорзины, ОткрытаФормаУточнения);
		КонецЦикла;
		
		Если ОткрытаФормаУточнения Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОрганизаюКомитентаПоУточнению(СтрокаТоваров, ОткрытаФормаУточнения = Ложь)
	
	Номенклатура = СтрокаТоваров.Номенклатура;
	
	МассивУточнений = КэшУточненияПринадлежностиЗапасов.Получить(Номенклатура);
	
	Если ЗначениеЗаполнено(МассивУточнений) Тогда
		ТорговыйОбъект = Объект.ТорговыйОбъект;
		Если ИспользоватьВыборСкладаПриПродаже Тогда
			ТорговыйОбъект = СтрокаТоваров.ТорговыйОбъект;
		КонецЕсли;
		Характеристика = СтрокаТоваров.Характеристика;
		Серия = СтрокаТоваров.Серия;
		
		ПодходящиеСтроки = Новый Массив;
		Для Каждого Уточнение Из МассивУточнений Цикл
			
			Если Уточнение.ТорговыйОбъект = ТорговыйОбъект И
				Уточнение.Характеристика = Характеристика И
				Уточнение.Серия = Серия Тогда
				
				ПодходящиеСтроки.Добавить(Уточнение);
				
			КонецЕсли;
			
		КонецЦикла;
		
		КоличествоПодходящихСтрок = ПодходящиеСтроки.Количество();
		
		Если КоличествоПодходящихСтрок = 1 Тогда
			
			Уточнение = ПодходящиеСтроки[0];
			ЗаполнитьУточненияПринадлежностиЗапасовВСтроке(СтрокаТоваров, Уточнение);
			
		ИначеЕсли КоличествоПодходящихСтрок > 1 Тогда
			
			СписокУточнений = Новый СписокЗначений;
			Для Каждого ПодходящаяСтрока ИЗ ПодходящиеСтроки Цикл
				СписокУточнений.Добавить(ПодходящаяСтрока);
				
				Если НЕ ЗначениеЗаполнено(ПодходящаяСтрока.ОрганизацияПродавец)
					И НЕ ЗначениеЗаполнено(ПодходящаяСтрока.Комитент) Тогда
					
					ВариантУточненияПринадлежностиСобственный = Новый Структура;
					ВариантУточненияПринадлежностиСобственный.Вставить("ИдентификаторСтроки", СтрокаТоваров.ИдентификаторСтроки);
					ВариантУточненияПринадлежностиСобственный.Вставить("Уточнение", ПодходящаяСтрока);
					
				КонецЕсли;
				
			КонецЦикла;
			
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("ИдентификаторСтроки", СтрокаТоваров.ИдентификаторСтроки);
			ПараметрыОткрытия.Вставить("СписокУточнений", СписокУточнений);
			
			ПредставлениеНоменклатуры =
				СтрШаблон(
					НСтр("ru = '%1%2%3'"),
					СтрокаТоваров.ПредставлениеНоменклатураХарактеристика,
					Символы.ПС,
					Серия);
			ПараметрыОткрытия.Вставить("Номенклатура", ПредставлениеНоменклатуры);
			
			ОповещениеУточнения = Новый ОписаниеОповещения("ОбработатьВыборУточненияПринадлежностиЗапасов", ЭтаФорма);
			
			Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		
			ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаУточненияПринадлежностиЗапасов",
						ПараметрыОткрытия, ЭтотОбъект, , , , 
						ОповещениеУточнения, Режим);
						
			ОткрытаФормаУточнения = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
	НайденныйИдентификатор = СписокИдентификаторовСтрокДляУточнения.НайтиПоЗначению(СтрокаТоваров.ИдентификаторСтроки);
	Если НайденныйИдентификатор <> Неопределено Тогда
		СписокИдентификаторовСтрокДляУточнения.Удалить(НайденныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборУточненияПринадлежностиЗапасов(Результат, ДополнительныеПараметры) Экспорт
	
	УточнениеПринадлежности = ВариантУточненияПринадлежностиСобственный;
	Если ЗначениеЗаполнено(Результат) Тогда
		УточнениеПринадлежности = Результат;
	КонецЕсли;
	
	Если НЕ УточнениеПринадлежности = Неопределено Тогда
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ИдентификаторСтроки", УточнениеПринадлежности.ИдентификаторСтроки);
		
		СтрокиКорзины = Объект.Товары.НайтиСтроки(СтруктураОтбора);
		
		Для Каждого СтрокаКорзины ИЗ СтрокиКорзины Цикл
			ЗаполнитьУточненияПринадлежностиЗапасовВСтроке(СтрокаКорзины, УточнениеПринадлежности.Уточнение);
		КонецЦикла;
		
	КонецЕсли;
	
	ВариантУточненияПринадлежностиСобственный = Неопределено;
	
	Если СписокИдентификаторовСтрокДляУточнения.Количество() > 0 Тогда
		ЗаполнитьОрганизаюКомитентаПоСпискуИдентификаторов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьУточненияПринадлежностиЗапасовВСтроке(СтрокаТовара, Уточнение)
	
	Если ЗначениеЗаполнено(Уточнение.ОрганизацияПродавец)
		ИЛИ ЗначениеЗаполнено(Уточнение.Комитент)
		ИЛИ ЗначениеЗаполнено(Уточнение.СистемаНалогообложения) Тогда
		
		Если ЗначениеЗаполнено(Уточнение.ОрганизацияПродавец) Тогда
			СтрокаТовара.Организация = Уточнение.ОрганизацияПродавец;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Уточнение.СистемаНалогообложения) Тогда
			СтрокаТовара.СистемаНалогообложения = Уточнение.СистемаНалогообложения;
		КонецЕсли;
		
		СтрокаТовара.Поставщик = Уточнение.Комитент;
		СтрокаТовара.СтавкаНДС = Уточнение.СтавкаНДС;
		СтрокаТовара.СтавкаНДСУСН = Уточнение.СтавкаНДСУСН;
		
		ПересчитатьСуммы(СтрокаТовара, Истина);
		ОбщегоНазначенияРМККлиентСервер.УстановитьНомерКартинкиСтрокиТовара(СтрокаТовара);
		УстановитьПоставщикаТекущейСтроки(СтрокаТовара);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

&НаКлиенте
Процедура ЗакрытиеСообщенияОбОшибке(Результат, ДополнительныеПараметры) Экспорт
	
	УправлениеФормойПередано = Ложь;
	
	Если Не ДополнительныеПараметры = Неопределено Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
			ДополнительныеПараметры, "МаркаНеПроверенаНаККТ") Тогда
				Если Результат = Неопределено Тогда
					ДобавитьТоварСНеПровереннойМаркойНаККТ();
				Иначе
					ОтказатьсяОтДобавленияТовара();
				КонецЕсли;
				Возврат;
				
		ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
			ДополнительныеПараметры, "КонтрольСотрудникомНаКСО") Тогда
				Если Результат = Неопределено Тогда
					РезультатКонтроляПродаж.НужнаПроверкаДоступностиОплаты = Истина;
					РезультатКонтроляПродаж.ОграниченияПродаж.Удалить(0);
					ОбработатьРезультатКонтроляПродаж();
				Иначе
					Если Не РезультатКонтроляПродаж.ОповещениеПриОтказе = Неопределено Тогда
						ВыполнитьОбработкуОповещения(РезультатКонтроляПродаж.ОповещениеПриОтказе);
					КонецЕсли;
				КонецЕсли;
				Возврат;
		ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
			ДополнительныеПараметры, "ОткрытьФормуПереходаКОплате")
			И ДополнительныеПараметры.ОткрытьФормуПереходаКОплате Тогда
				ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПогаситьСветовойСигналОбОшибкеНаДисплее();
	
	Если Результат = Неопределено Тогда
		ДанныеДляРучногоСопоставления = Неопределено;
		ПродолжитьВыполнениеКонтроляПродажПриНеобходимости();
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ВосстановитьСоединение") Тогда
		ПроверитьСоединениеСервераЛояльностиФоновое();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ПродолжитьБезРасчета") Тогда
		ПродолжитьБезРасчетаПроверкаПрав();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ОтменитьОплатуКартой") Тогда
		ВыполнитьОтменуОплатыКлиент();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ПовторитьПробитие") Тогда
		НачатьПечатьЧека();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ОтложитьЧек") Тогда
		ОтложитьЧекНаКлиенте();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ПовторитьФискальнуюОперацию") Тогда
		ПовторитьОперациюПакетнойФискализацииКлиент();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "УдалитьЧек") Тогда
		УдалитьЧекНаКлиенте();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ОткрытьСмену") Тогда
		ОткрытьУправлениеКассовымиСменамиИзОшибкиНаКлиенте();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "ЗакрытьСмену") Тогда
		ОткрытьУправлениеКассовымиСменамиИзОшибкиНаКлиенте();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Результат, "СопоставитьТовар") Тогда
		СопоставитьСТоваром();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводСМС(Результат, ДополнительныеПараметры) Экспорт
	Если НЕ Результат = Неопределено И Результат.ОперацияПодтверждена Тогда
		НастройкиПодтвержденияБонусов.ОплатаБонусовПодтверждена = Результат.ОперацияПодтверждена;
		НастройкиПодтвержденияБонусов.ПодтверждениеНеТребуется = Ложь;
		НастройкиПодтвержденияБонусов.СуммаБонусовМеньшеНастройки = Ложь;
		
		ОплатаБонусамиПодтверждена = НастройкиПодтвержденияБонусов.ПодтверждениеНеТребуется
		Или НастройкиПодтвержденияБонусов.СуммаБонусовМеньшеНастройки Или НастройкиПодтвержденияБонусов.ОплатаБонусовПодтверждена;
		
		НастроитьПодтверждениеБонусов(ОплатаБонусамиПодтверждена);
		НастроитьДоступностьПробитьЧек();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводСуммыОплатыБонусами(Результат, ДополнительныеПараметры) Экспорт
	Если НЕ Результат = Неопределено И Результат.ОперацияПодтверждена Тогда
		НастройкиПодтвержденияБонусов.ОплатаБонусовПодтверждена = Результат.ОперацияПодтверждена;
		НастройкиПодтвержденияБонусов.ПодтверждениеНеТребуется = Ложь;
		НастройкиПодтвержденияБонусов.СуммаБонусовМеньшеНастройки = Ложь;
		
		ОплатаБонусамиПодтверждена = НастройкиПодтвержденияБонусов.ПодтверждениеНеТребуется
		Или НастройкиПодтвержденияБонусов.СуммаБонусовМеньшеНастройки Или НастройкиПодтвержденияБонусов.ОплатаБонусовПодтверждена;
		
		СуммаОплаченоБонусами = Результат.СуммаБонусов;
		Если СуммаОплаченоБонусами > 0 Тогда
			Элементы.СтраницыОплатыБонусами.ТекущаяСтраница = Элементы.СтраницаОплатыБонусами;
		КонецЕсли;
		ОбработатьИзменениеСуммыБонусов();
		НастроитьПодтверждениеБонусов(ОплатаБонусамиПодтверждена);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводСуммыОплатыКартой(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено И Результат.ОперацияПодтверждена Тогда
		
		НастройкиПодтвержденияБонусов.ОплатаБонусовПодтверждена = Результат.ОперацияПодтверждена;
		НастройкиПодтвержденияБонусов.ПодтверждениеНеТребуется = Ложь;
		НастройкиПодтвержденияБонусов.СуммаБонусовМеньшеНастройки = Ложь;
		СуммаОплаченоБонусами = Результат.СуммаБонусов;
		Если Результат.СуммаБонусов > 0 Тогда
			БонусыВведеныВТихойОплате = Истина;
		КонецЕсли;
		ОбработатьИзменениеСуммыБонусов();
		Элементы.СтраницыОплатыБонусами.ТекущаяСтраница = Элементы.СтраницаОплатыБонусами;
		ОплатитьКартойВТихомРежимеНаКлиенте();
		
	Иначе
		
		РежимТихойОплаты = Ложь;
		ОплатаБезДеленияПоЧекам = Ложь;
		ПереключитьВРежимВводаТоваров();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРезультатВыбораСертификата(Результат, ДополнительныеПараметры) Экспорт
	Если НЕ Результат = Неопределено
		И Результат.ОперацияПодтверждена Тогда
		ДобавитьПодарочныйСертификатВТаблицу(ДополнительныеПараметры, Результат.СуммаОперации);
		
		ПересчитатьСуммыОплатыПриРедактированииСертификатов();
		ИзменитьКомандуСертификат();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРезультатПоискаСерии(Результат, ДополнительныеПараметры) Экспорт
	РежимВводаСерии = Ложь;
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяСерия = Результат.Штрихкод;
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если СерииНеВыгружаются Тогда
		ТекущаяСтрока.ИдентификаторСерий = ВыбраннаяСерия;
		МассивСерий = ДополнительныеПараметры.МассивСерий;
		ПредставлениеСерии = НСтр("ru = ''");
		Для Каждого СтрокаМассива Из МассивСерий Цикл
			Если СтрокаМассива.ИдентификаторСерий = ВыбраннаяСерия Тогда
				ПредставлениеСерии = СтрокаМассива.СерияПредставление;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ТекущаяСтрока.СерияПредставление = ПредставлениеСерии;
	Иначе
		Если ТипЗнч(ВыбраннаяСерия) = Тип("Строка") Тогда
			ВыполнитьПоискШтрихкода(ВыбраннаяСерия);
		Иначе
			ТекущаяСтрока.Серия = ВыбраннаяСерия;
			ТекущаяСтрока.СерияПредставление = Строка(ВыбраннаяСерия);
		КонецЕсли;
	КонецЕсли;
	ОбработатьВыборСерии();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРезультатПоискаСерииСертификата(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерСерии = Результат.Штрихкод;
	НайтиПодарочныйСертификат(ДополнительныеПараметры.ПодарочныйСертификат, ДополнительныеПараметры.ЭтоСерийныйПодарочныйСертификат, НомерСерии);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьУточнениеВетРеквизитов(Результат, ДополнительныеПараметры) Экспорт
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если Результат = Неопределено
		Или ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.ОперацияПодтверждена Тогда
		ТекущаяСтрока.ЭтоВетТребование = Результат.ЭтоВетТребование;
		ТекущаяСтрока.ДатаВетРецепта = Результат.ДатаВетРецепта;
		ТекущаяСтрока.НомерВетРецепта = Результат.НомерВетРецепта;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРезультатПоискаПартии(Результат, ДополнительныеПараметры) Экспорт
	РежимВводаСерии = Ложь;
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяПартия = Результат.Штрихкод;
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Если ТипЗнч(ВыбраннаяПартия) = Тип("Строка") Тогда
		ВыполнитьПоискШтрихкода(ВыбраннаяПартия);
	Иначе
		ТекущаяСтрока.Партия = ВыбраннаяПартия;
	КонецЕсли;
	ОбработатьВыборПартии();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводСуммыОплатыСБП(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено И Результат.ОперацияПодтверждена Тогда
		
		НастройкиПодтвержденияБонусов.ОплатаБонусовПодтверждена = Результат.ОперацияПодтверждена;
		НастройкиПодтвержденияБонусов.ПодтверждениеНеТребуется = Ложь;
		НастройкиПодтвержденияБонусов.СуммаБонусовМеньшеНастройки = Ложь;
		СуммаОплаченоБонусами = Результат.СуммаБонусов;
		ОбработатьИзменениеСуммыБонусов();
		Элементы.СтраницыОплатыБонусами.ТекущаяСтраница = Элементы.СтраницаОплатыБонусами;
		ОплатитьСБПВТихомРежимеНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводЗначенияСуммы(Результат, ДополнительныеРеквизиты) Экспорт
	
	ЭлементЗначения = ДополнительныеРеквизиты.ЭлементЗначения;
	ЭлементКоличество = Элементы.ТекущийТоварКоличество;
	ОбновитьДоступностьИзмененияКоличества = (ЭлементЗначения = ЭлементКоличество);
	
	Если НЕ Результат = Неопределено
		И Результат.ОперацияПодтверждена Тогда
		
		ЭтотОбъект[ДополнительныеРеквизиты.ПутьКДанным] = Результат.СуммаОперации;
		Если РежимКассыСамообслуживания Тогда
			ОбработатьИзменениеЗначенияВПолеНадписи(ЭлементЗначения.Имя);
		КонецЕсли;
		ОбновитьОтображениеДанных(ЭлементЗначения);
		Если Не РежимКассыСамообслуживания Тогда
			ТекстВПоле = ЭлементЗначения.ТекстРедактирования;
			ЭлементЗначения.УстановитьГраницыВыделения(1, СтрДлина(ТекстВПоле) + 1);
			ЭлементЗначения.ВыделенныйТекст = ЭлементЗначения.ТекстРедактирования;
		КонецЕсли;
		
		Если РежимКассыСамообслуживания Тогда
			
			Если ОбновитьДоступностьИзмененияКоличества Тогда
				ОбновитьДоступностьИзмененияКоличества();
			КонецЕсли;
			Если РежимКассыСамообслуживания И ОбновитьДоступностьИзмененияКоличества Тогда
				ТекущийЭлемент = Элементы.Товары;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	Если РежимКассыСамообслуживания И ОбновитьДоступностьИзмененияКоличества И ЭтоИнтерфейс85 Тогда
		ПодсветитьПоле(Элементы.КоличествоКСО, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводНеНулевойЦены(Результат, ДополнительныеРеквизиты) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.ОперацияПодтверждена Тогда
		ЭлементЗначения = ДополнительныеРеквизиты.ЭлементЗначения;
		ЭтотОбъект[ЭлементЗначения.Имя] = Результат.СуммаОперации;
		ТекущийТоварЦенаИзКарточкиПриИзменении(ЭлементЗначения);
	Иначе
		УдалитьТоварЗавершение(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

