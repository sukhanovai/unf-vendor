&НаКлиенте
Процедура СкладТекущейСтрокиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборСкладаЗавершение", ЭтотОбъект);
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ВыборСклада");
	ПараметрыОткрытия.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
	ОбщегоНазначенияРМККлиентПереопределяемый.ДополнитьПараметрыОткрытияФормыВыбораСкладЯчейка(
		ЭтотОбъект, ПараметрыОткрытия);
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВыбораСкладЯчейка",
		ПараметрыОткрытия,
		ЭтотОбъект, , , ,
		ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура СкладТекущейСтрокиОчистка(Элемент, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Склад = Неопределено;
	Ячейка = Неопределено;
	Если ТекущиеДанные.ЭтоНабор Тогда
		НомерНабора = ТекущиеДанные.НомерНабора;
		ЗаполнитьСкладВНаборе(Склад, НомерНабора);
		ЗаполнитьЯчейкуВНаборе(Ячейка, НомерНабора);
	Иначе
		ТекущиеДанные.ТорговыйОбъект = Склад;
		ТекущиеДанные.Ячейка = Ячейка;
		ДанныеСтроки = Новый Структура("Номенклатура, Характеристика, ТорговыйОбъект, КоличествоОстаток, КоэффициентУпаковки,
				|СистемаНалогообложения, УчетНДССпецРежим, Патент",
			ТекущиеДанные.Номенклатура, ТекущиеДанные.Характеристика, ТекущиеДанные.ТорговыйОбъект,
			ТекущиеДанные.КоличествоОстаток, ТекущиеДанные.КоэффициентУпаковки, Неопределено, ТекущиеДанные.УчетНДССпецРежим);
		ЗаполнитьДанныеСтрокиПоСкладу(ДанныеСтроки);
		ТекущиеДанные.КоличествоОстаток = ДанныеСтроки.КоличествоОстаток;
		Если ЗначениеЗаполнено(ДанныеСтроки.СистемаНалогообложения) Тогда
			ТекущиеДанные.СистемаНалогообложения = ДанныеСтроки.СистемаНалогообложения;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСтроки.Патент) Тогда
			ТекущиеДанные.Патент = ДанныеСтроки.Патент;
		КонецЕсли;
	КонецЕсли;
	
	Если ОтображатьОстаток Тогда
		ОстатокЗаголовок = СтрШаблон(НСтр("ru = '%1 %2'"), ТекущиеДанные.КоличествоОстаток, ТекущиеДанные.ПредставлениеЕдиницыИзмерения);
		Если Не РазрешитьЗапросОстатка Тогда
			Элементы.Доступно.Заголовок = ОстатокЗаголовок;
		Иначе
			Элементы.ПоказатьОстатки.Заголовок = ОстатокЗаголовок;
		КонецЕсли;
	КонецЕсли;
	СкладТекущейСтроки = Склад;
	ЯчейкаТекущейСтроки = Ячейка;
КонецПроцедуры

&НаКлиенте
Процедура ЯчейкаТекущейСтрокиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(НСтр("ru = 'Не выбрана текущая строка.'"));
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		Возврат;
	КонецЕсли;
	Склад = ТекущаяСтрока.ТорговыйОбъект;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборЯчейкиЗавершение", ЭтотОбъект);
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ВыборЯчейки");
	ПараметрыОткрытия.Вставить("Склад", Склад);
	ОбщегоНазначенияРМККлиентПереопределяемый.ДополнитьПараметрыОткрытияФормыВыбораСкладЯчейка(
		ЭтотОбъект, ПараметрыОткрытия);
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВыбораСкладЯчейка",
		ПараметрыОткрытия,
		ЭтотОбъект, , , ,
		ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура ЯчейкаТекущейСтрокиОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ячейка = Неопределено;
	Если ТекущиеДанные.ЭтоНабор Тогда
		НомерНабора = ТекущиеДанные.НомерНабора;
		ЗаполнитьЯчейкуВНаборе(Ячейка, НомерНабора);
	Иначе
		ТекущиеДанные.Ячейка = Ячейка;
	КонецЕсли;
	
	ЯчейкаТекущейСтроки = Ячейка;
КонецПроцедуры

&НаКлиенте
Процедура УточнитьВетДанные(Команда)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	ПараметрыОткрытия = ПустаяСтруктураФормыУточненияРеквизитов();
	ПараметрыОткрытия.ЭтоВетТребование = ТекущаяСтрока.ЭтоВетТребование;
	ПараметрыОткрытия.ДатаВетРецепта = ТекущаяСтрока.ДатаВетРецепта;
	ПараметрыОткрытия.НомерВетРецепта = ТекущаяСтрока.НомерВетРецепта;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьУточнениеВетРеквизитов", ЭтотОбъект);
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаУточненияРеквизитов", ПараметрыОткрытия, Этотобъект, , , ,
		ОписаниеОповещения, РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
КонецПроцедуры

&НаКлиенте
Функция ПустаяСтруктураФормыУточненияРеквизитов()
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Режим", 0);
	ПараметрыОткрытия.Вставить("ЭтоВетТребование", Ложь);
	ПараметрыОткрытия.Вставить("ДатаВетРецепта", Дата(1,1,1,0,0,0));
	ПараметрыОткрытия.Вставить("НомерВетРецепта", НСтр("ru = ''"));
	Возврат ПараметрыОткрытия;
КонецФункции

&НаКлиенте
Процедура СкидкиНаЧекСкидкаПереключательПриИзменении(Элемент)
	ИзменитьОборажениеРучнойСкидкиНаЧек(СкидкиНаЧекСкидкаПереключатель = 0);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОборажениеРучнойСкидкиНаЧек(ПоказыватьПроцентом)
	СуммаТоваровПодлежащихДисконтированию = 0;
	
	Для Каждого СтрокаКорзины Из Объект.Товары Цикл
		
		Если (Не (СтрокаКорзины.ЗапретРучныхСкидок Или СтрокаКорзины.Подарок)) Тогда
			СуммаТоваровПодлежащихДисконтированию = СуммаТоваровПодлежащихДисконтированию + СтрокаКорзины.СуммаБезСкидки;
		КонецЕсли;
		
	КонецЦикла;
	Если СуммаТоваровПодлежащихДисконтированию = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НовоеЗначениеСкидкиНаЧек = 0;
	
	Если ПоказыватьПроцентом Тогда
		
			
		ОтображаетсяСкидкаПроцентомНаЧек = Истина;
		ОтображаетсяСкидкаСуммойНаЧек = Ложь;
		НовоеЗначениеСкидкиНаЧек = Окр(Объект.Товары.Итог("СуммаСкидкиНаценки") / СуммаТоваровПодлежащихДисконтированию * 100, 2);
		
		Если ЗначениеСкидкиНаценки <> НовоеЗначениеСкидкиНаЧек Тогда
			ЗначениеСкидкиНаЧек = НовоеЗначениеСкидкиНаЧек;
		КонецЕсли;
			
	Иначе
		ОтображаетсяСкидкаСуммойНаЧек			= Истина;
		ОтображаетсяСкидкаПроцентомНаЧек		= Ложь;
		НовоеЗначениеСкидкиНаЧек = Объект.Товары.Итог("СуммаСкидкиНаценки");
		
		Если ЗначениеСкидкиНаценки <> НовоеЗначениеСкидкиНаЧек Тогда
			ЗначениеСкидкиНаЧек = НовоеЗначениеСкидкиНаЧек;
		КонецЕсли;
	КонецЕсли;
	
	Если НовоеЗначениеСкидкиНаЧек < 0 Тогда
		ЗначениеСкидкиНаЧек = - НовоеЗначениеСкидкиНаЧек;
	КонецЕсли;
	ЗначениеСкидкиНаценки = НовоеЗначениеСкидкиНаЧек;
КонецПроцедуры

&НаКлиенте
Процедура ВывестиДанныеСдачи()
	ПоказыватьГруппуСкидок = ИспользоватьАвтоматическиеСкидки Или МаксимальныйПроцентРучнойНаценки > 0
			Или МаксимальныйПроцентРучнойСкидки > 0;
			
	Если ОсновнойПодборПлиточный
		И Не ЗакрыватьПодборПриВыбореТовара Тогда
		Если Элементы.СтраницыИтогиПлитка.ТекущаяСтраница = Элементы.СтраницаСдачаПлитка Тогда
			Сдача = 0;
			Элементы.СтраницыИтогиПлитка.ТекущаяСтраница = Элементы.СтраницаИтогПлитка;
		Иначе
			Если Сдача > 0 Тогда
				Элементы.СтраницыИтогиПлитка.ТекущаяСтраница = Элементы.СтраницаСдачаПлитка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.СтраницыДанныеСуммыТоваров.ТекущаяСтраница = Элементы.СтраницаСдача Тогда
		Сдача = 0;
		Элементы.СтраницыДанныеСуммыТоваров.ТекущаяСтраница = Элементы.СтраницаСуммаБезСкидок;
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаСуммаИтогоПоЧеку, Истина);
		Если НЕ ПоказыватьГруппуСкидок Тогда
			УстановитьВидимостьЭлементаФормы(Элементы.ГруппаСуммаСдачи, Ложь);
		КонецЕсли;
	Иначе
		Если Сдача > 0 Тогда
			Элементы.СтраницыДанныеСуммыТоваров.ТекущаяСтраница = Элементы.СтраницаСдача;
			Если Не ОставлятьПоследнийЧекНаЭкране Тогда
				УстановитьВидимостьЭлементаФормы(Элементы.ГруппаСуммаИтогоПоЧеку, Ложь);
			КонецЕсли;
			Если НЕ ПоказыватьГруппуСкидок Тогда
				УстановитьВидимостьЭлементаФормы(Элементы.ГруппаСуммаСдачи, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ВыборПартии
&НаКлиенте
Процедура ПартияТекущейСтрокиНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	УказатьПартиюНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура УказатьПартиюНаКлиенте(ТекущаяСтрока = Неопределено)
	
	СкрытьЦифровуюПанельДляВводаСуммПриНеобходимости();
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		Если ТекущаяСтрока = Неопределено Тогда
			ТекстПредупреждения = НСтр("ru = 'Не выбрана строка для указания серии.'");
			ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстПредупреждения);
			ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
			ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ТекущийТоварИдентификатор = ТекущаяСтрока.ПолучитьИдентификатор();
	
	Если ТекущаяОперация = "" И РежимКассыСамообслуживания Тогда
		
		ПараметрыТекущейОперации = Новый Структура;
		ПараметрыТекущейОперации.Вставить("ИдентификаторСтроки", ТекущаяСтрока.ПолучитьИдентификатор());
		
		НеобходимоеПраво = "ПравоВыбораСерииРМК";
		ТекущаяОперация = "ВыборСерииРМК";
		ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОбщая);
		ПредложитьЗаменитьПраваКассира(НеобходимоеПраво);
		Если Не Элементы.ГруппаОперации.Видимость Тогда
			ИнтерфейсРМКСлужебныйКлиентСервер.УстановитьВидимостьГруппыОперации(Элементы);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	МассивПартий = Новый Массив;
	ЗаполнитьДанныеВыбораПартий(МассивПартий, ТекущаяСтрока.Номенклатура);
	
	Если МассивПартий.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(НаименованиеПользователяПриЗапросеПрав) Тогда
			НаправлениеОбращения = НаименованиеПользователяПриЗапросеПрав;
		Иначе
			НаправлениеОбращения = НСтр("ru = 'администратору'");
		КонецЕсли;
		ТекстПредупреждения = СтрШаблон(НСтр("ru = 'У номенклатуры %1 нет партий для выбора.'"),
			ТекущаяСтрока.ПредставлениеНоменклатураХарактеристика) + Символы.ПС + СтрШаблон(НСтр("ru = 'Обратитесь к %1.'"), НаправлениеОбращения);
		ТекстЗаголовка = НСтр("ru = 'Выбор партии'");
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстПредупреждения, ТекстЗаголовка);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
		Возврат;
	КонецЕсли;
	
	ВыбраннаяПартия = ТекущаяСтрока.Партия;
	ОткрытьФормуВводаШтрихкодаПартий(МассивПартий, ТекущаяСтрока.ПредставлениеНоменклатураХарактеристика, ВыбраннаяПартия, ТекущаяСтрока.ПроверятьЗаполнениеПартий);
	
	ОчиститьОчередьШтрихкодов();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеВыбораПартий(МассивПартий, Номенклатура)
	
	ОбщегоНазначенияРМКПереопределяемый.ЗаполнитьСписокВыбораПартийНоменклатуры(
		Номенклатура,
		МассивПартий);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ОткрытьФормуВводаШтрихкодаПартий(МассивПартий, ПредставлениеНоменклатуры, ВыбраннаяПартия, ПроверятьЗаполнениеПартий)
	Если РежимВводаСерии Тогда
		Возврат;
	КонецЕсли;
	
	РежимВводаСерии = Истина;
	ПараметрыОткрытия = ПараметрыФормыВводаШтрихкода();
	ПараметрыОткрытия.ВыборПартии = Истина;
	ПараметрыОткрытия.Заголовок = ПредставлениеНоменклатуры;
	ПараметрыОткрытия.МассивЗначений = МассивПартий;
	ПараметрыОткрытия.ВыбранноеЗначение = ВыбраннаяПартия;
	ПараметрыОткрытия.МожноВводитьПустоеЗначение = НЕ ПроверятьЗаполнениеПартий;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьРезультатПоискаПартии", ЭтотОбъект);
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВводаШтрихкода", ПараметрыОткрытия, Этотобъект, , , ,
		ОписаниеОповещения, РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца);
			
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборПартии()
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ЭтоЗаменаТоваров Тогда
		НастроитьДоступностьПробитьЧек();
	Иначе
		ИнтерфейсРМКСлужебныйКлиент.НастроитьДоступностьРежимаОплаты(ЭтотОбъект);
	КонецЕсли;
	
	УточнитьДанныеДляСтрокиПриВыбореСерииИПартии();
	ОбщегоНазначенияРМККлиентСервер.УстановитьНомерКартинкиСтрокиТовара(ТекущаяСтрока);
	НастроитьКомандуУказатьСерии(ТекущаяСтрока);
	Если ИспользоватьУточненияПринадлежностиЗапасов Тогда
		ЗаполнитьОрганизаюКомитентаПоУточнению(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьГруппуЕще()
	
	ТекущийЭлемент = Элементы.КомандаЕще;
	Элементы.ГруппаЕще.Скрыть();
	Элементы.СтраницыЕще.ТекущаяСтраница = Элементы.СтраницаЕще1;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьГруппуРежим()
	
	ТекущийЭлемент = Элементы.КомандаРежим;
	Элементы.ГруппаРежим.Скрыть();
	Элементы.СтраницыРежимы.ТекущаяСтраница = Элементы.СтраницаРежимы1;
	
КонецПроцедуры

