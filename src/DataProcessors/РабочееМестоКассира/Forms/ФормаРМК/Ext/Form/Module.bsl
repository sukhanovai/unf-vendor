&НаКлиенте
Процедура ДеревоСкидокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ИдантификаторСтроки = Элементы.ДеревоСкидок.ТекущаяСтрока;
	Если ИдантификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаСкидки = ДеревоСкидок.НайтиПоИдентификатору(ИдантификаторСтроки);
	Если СтрокаСкидки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭтоУдаление = СтрокаСкидки.ЭтоУправляемаяСкидка;
	Если ЭтоУдаление Тогда
		УдалитьУправляемуюСкидкуНаСтроку(СтрокаСкидки);
	Иначе
		ОткрытьДиалогВыбораУпрСкидки();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ФормаВводаЗначенийСумм

&НаКлиенте
Процедура ОткрытьФормуВводаЗначенийСуммы(Элемент, ЗаголовокЭлемента)
	Если СкрытьЦифровуюКлавиатуру Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = ЗаполнитьПустуюСтруктураФормыВводаСумм();
	ПараметрыОткрытия.Режим = 6;
	ПараметрыОткрытия.ЗаголовокЭлемента = ЗаголовокЭлемента;
	
	ИмяСвязаногоЭлемента = НСтр("ru = ''");
	Если РежимКассыСамообслуживания Тогда
		ИмяСвязаногоЭлемента = ПолучитьИмяСвязанногоРеквизитаПоля(Элемент);
	КонецЕсли;
	
	ЭтоВводСуммы = Истина;
	Если ЭтоРежимРедактированияПоляНадписиКСО() Тогда
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		ЭтоВводСуммы = НЕ ТекущаяСтрока.ЗапретитьВводДробногоКоличества;
		НовыйФормат = ?(НЕ ЭтоВводСуммы, "ЧДЦ=0; ЧФ = 'Ч %1'", "ЧФ = 'Ч %1'");
		ФорматСтроки = СтрШаблон(НовыйФормат, ТекущаяСтрока.ПредставлениеЕдиницыИзмерения);
		ПараметрыОткрытия.Формат = ФорматСтроки;
	Иначе
		ПараметрыОткрытия.Формат = Элемент.ФорматРедактирования;
		ПараметрыОткрытия.МаскаВвода = Элемент.Маска;
		ИмяЭлемента = Элемент.Имя;
		ЭтоВводСуммы = ЭтоПолеВводаДробнойСуммы(Элемент.ТекстРедактирования);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяСвязаногоЭлемента) Тогда
		ИмяЭлемента = ИмяСвязаногоЭлемента;
	КонецЕсли;
	
	ПараметрыОткрытия.ТребуетсяРазделитель = ЭтоВводСуммы;
	
	ДополнительныеРеквизиты = Новый Структура("ЭлементЗначения", Элементы[ИмяЭлемента]);
	ПараметрыОткрытия.ЗначениеЭлемента = ЭтотОбъект[ИмяЭлемента];
	ДанныеРеквизита = ВернутьТипЗначенияИПутьДанныхРеквизита(ИмяЭлемента);
	ДополнительныеРеквизиты.Вставить("ПутьКДанным", ДанныеРеквизита.ПутьКДанным);
	ПараметрыОткрытия.ТипЗначения = ДанныеРеквизита.Тип;
	
	ОповещениеПродолжения = Новый ОписаниеОповещения(
		"ЗавершитьВводЗначенияСуммы",
		ЭтотОбъект, ДополнительныеРеквизиты);
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВводаСумм", ПараметрыОткрытия,,,,,ОповещениеПродолжения);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВводаНеНулевойЦены(ТекущаяСтрокаТовара = Неопределено)
	
	Если ТекущаяСтрокаТовара = Неопределено Тогда
		ТекущаяСтрокаТовара = Объект.Товары.НайтиПоИдентификатору(ТекущийТоварИдентификатор);
	КонецЕсли;
	РежимЦифровойПанели = РежимыЦифровойПанели.ВводСуммОплаты;
	ПараметрыОткрытия = ЗаполнитьПустуюСтруктураФормыВводаСумм();
	ПараметрыОткрытия.Режим = 7;
	ПараметрыОткрытия.ЗаголовокЭлемента = СтрШаблон(НСтр("ru = 'Введите цену товара ""%1"".'"),
		ТекущаяСтрокаТовара.ПредставлениеНоменклатураХарактеристика);
	
	Элемент = Элементы.ТекущийТоварЦенаИзКарточки;
	ПараметрыОткрытия.Формат = Элемент.ФорматРедактирования;
	ПараметрыОткрытия.МаскаВвода = Элемент.Маска;
	ИмяЭлемента = Элемент.Имя;
	ПараметрыОткрытия.ТребуетсяРазделитель = Истина;
	
	ДополнительныеРеквизиты = Новый Структура("ЭлементЗначения", Элемент);
	ДополнительныеРеквизиты.Вставить("ИдентификаторСтрокиТовара", ТекущийТоварИдентификатор);
	ПараметрыОткрытия.ЗначениеЭлемента = 0;
	ДанныеРеквизита = ВернутьТипЗначенияИПутьДанныхРеквизита(ИмяЭлемента);
	ДополнительныеРеквизиты.Вставить("ПутьКДанным", ДанныеРеквизита.ПутьКДанным);
	ПараметрыОткрытия.ТипЗначения = ДанныеРеквизита.Тип;
	
	ОповещениеПродолжения = Новый ОписаниеОповещения(
		"ЗавершитьВводНеНулевойЦены",
		ЭтотОбъект, ДополнительныеРеквизиты);
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВводаСумм", ПараметрыОткрытия,,,,,ОповещениеПродолжения);
	
КонецПроцедуры

&НаСервере
Функция ВернутьТипЗначенияИПутьДанныхРеквизита(ИмяЭлемента)
	
	ЭлементФормы = Элементы[ИмяЭлемента];
	РезультатФункции = Новый Структура("Тип,ПутьКДанным", Неопределено, ЭлементФормы.ПутьКДанным);
	МассивРеквизитов = ЭтотОбъект.ПолучитьРеквизиты();
	КоличествоРеквизитов = МассивРеквизитов.Количество();
	Счт = 0;
	Пока Счт < КоличествоРеквизитов И РезультатФункции.Тип = Неопределено Цикл
		Реквизит = МассивРеквизитов.Получить(Счт);
		Если Реквизит.Имя = ЭлементФормы.Имя Тогда
			РезультатФункции.Тип = Реквизит.ТипЗначения;
		КонецЕсли;
		Счт = Счт + 1;
	КонецЦикла;
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти

#Область ВидыОплат
&НаСервере
Процедура СоздатьВидыОплат(ПроверкаЧека = Ложь)
	УстановитьВидимостьЭлементаФормы(Элементы.КолонкаОплат, Истина);
	ТаблицаОплат = Новый ТаблицаЗначений;
	ТаблицаОплат.Колонки.Добавить("ИмяВидаОплаты", Новый ОписаниеТипов("Строка"));
	ТаблицаОплат.Колонки.Добавить("Заголовок", Новый ОписаниеТипов("Строка"));
	ТаблицаОплат.Колонки.Добавить("Сумма", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.Число15_2РМК.Тип));
	МассивЧековККМ = Новый Массив;
	Если ПроверкаЧека Тогда
		МассивЧековККМ.Добавить(ЧекККМПродажа);
	Иначе
		Для Каждого СтрокаЧека Из ПробитыеЧеки Цикл
			МассивЧековККМ.Добавить(СтрокаЧека.ЧекККМ);
		КонецЦикла;
	КонецЕсли;
	
	ОбщегоНазначенияРМКПереопределяемый.СформироватьТаблицуОплат(МассивЧековККМ, ТаблицаОплат, Сдача);
	
	ДобавляемыеРеквизиты = Новый Массив;
	ИменаВидимыхРеквизитов = Новый Соответствие;
	Для Каждого СтрокаВидОплаты Из ТаблицаОплат Цикл
		Если Элементы.Найти(СтрокаВидОплаты.ИмяВидаОплаты) = Неопределено Тогда
			НовыйРеквизит = Новый РеквизитФормы(СтрокаВидОплаты.ИмяВидаОплаты, Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.Число15_2РМК.Тип));
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		КонецЕсли;
	КонецЦикла;
	ЭтотОбъект.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Для Каждого СтрокаЭлемента Из Элементы.ГруппаОплат.ПодчиненныеЭлементы Цикл
		УстановитьВидимостьЭлементаФормы(СтрокаЭлемента, Ложь);
	КонецЦикла;
	
	Для Каждого СтрокаВидОплаты Из ТаблицаОплат Цикл
		ЭтотОбъект[СтрокаВидОплаты.ИмяВидаОплаты] = СтрокаВидОплаты.Сумма;
		ЭлементВидаОплаты = Элементы.Найти(СтрокаВидОплаты.ИмяВидаОплаты);
		Если ЭлементВидаОплаты = Неопределено Тогда
			НовыйЭлемент = Элементы.Добавить(СтрокаВидОплаты.ИмяВидаОплаты, Тип("ПолеФормы"), Элементы.ГруппаОплат);
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
			НовыйЭлемент.ПутьКДанным = СтрокаВидОплаты.ИмяВидаОплаты;
			НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
			НовыйЭлемент.Заголовок = СтрокаВидОплаты.Заголовок;
			ЭлементВидаОплаты = НовыйЭлемент;
		КонецЕсли;
		УстановитьВидимостьЭлементаФормы(ЭлементВидаОплаты, Истина);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

