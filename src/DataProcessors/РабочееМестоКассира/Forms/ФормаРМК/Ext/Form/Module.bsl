	ОбщегоНазначенияРМКПереопределяемый.НастроитьФормуПриСозданииНовогоНабора(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьДанныеКартыЛояльности()
	
	Если ИнтерфейсРМКСлужебныйКлиентСервер.ДанныеЛояльностиЗаполнены(ЭтотОбъект) Тогда
		Если (Не ЗначениеЗаполнено(Объект.ДисконтнаяКарта))
			И ИнтерфейсРМКСлужебныйКлиентСервер.ПараметрыКартыЗаполнены(ПараметрыКартыЛояльности) Тогда
			
			ДозаполнитьДанныеКартыССервераЛояльности();
			
		Иначе
			
			ДанныеКарты = Новый Структура;
			ДанныеКарты.Вставить("КартаНедействительна", Ложь);
			ДанныеКарты.Вставить("НомерКарты", "");
			ОбщегоНазначенияРМККлиентПереопределяемый.ПолучитьДанныеКартыЛояльности(Объект.ДисконтнаяКарта, ДанныеКарты);
			КартаНедействительна = ДанныеКарты.КартаНедействительна;
			
			Если Не КартаНедействительна Тогда
				ЗавершитьВводШтрихкодаНайденаКарта(КодВозвратаДиалога.Нет);
			Иначе
				ОчиститьДанныеКартыЛояльности();
				ПараметрыШтрихкода = Новый Структура;
				ПараметрыШтрихкода.Вставить("Штрихкод", ДанныеКарты.НомерКарты);
				ПоказатьИнформациюОКарте(ПараметрыШтрихкода);
			КонецЕсли;
		КонецЕсли;
		НастроитьВидКнопкиОплатыВПлиткеСУчетомВозврата();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьПриложениеПриОшибкеПродолжение(ЗадаватьВопросПередЗавершением)
	
	РежимОсновногоОкна = КлиентскоеПриложение.ПолучитьРежимОсновногоОкна();
	Если РежимОсновногоОкна = РежимОсновногоОкнаКлиентскогоПриложения.РабочееМесто
		Или РежимОсновногоОкна = РежимОсновногоОкнаКлиентскогоПриложения.Киоск
		Или ЭтоНачальноеОкноРядовогоПользователя() Тогда
		
		ЗавершитьРаботуСистемы(ЗадаватьВопросПередЗавершением);
		
	ИначеЕсли (Не ЭтотОбъект.Окно = Неопределено) И Окно.НачальнаяСтраница Тогда
		
		ПоказатьРекомендациюУбратьИзНачальнойСтраницы();
		
	Иначе
		Если ЗначениеЗаполнено(Объект.ТорговыйОбъект) Или Не ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
			Если ЭтотОбъект.Открыта() Тогда
				ЭтотОбъект.Закрыть();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоНачальноеОкноРядовогоПользователя()
	
	Возврат ((Не ЭтотОбъект.Окно = Неопределено) И ЭтотОбъект.Окно.НачальнаяСтраница И Не ЭтоПолноправныйПользователь);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьСборкуЗаказа(ТекстОшибки)
	
	Для Каждого СтрокаТовары  Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовары.ЗаказПокупателя)
			И СтрокаТовары.Количество <> СтрокаТовары.КоличествоСобрано Тогда
				ТекстОшибки = НСтр("ru='Количество собранных товаров отличается от заказанного.'");;
				Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСборкуЗаказаПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПропускатьПроверкуСборкиЗаказа = Истина;
	ИначеЕсли Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	Иначе
		ПереключитьРежимНаСборкуЗаказа(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуАвторизацииПринудительнаяСмена()
	
	ВозможныеНазначенияАвторизации = ИнтерфейсРМКСлужебныйКлиентСервер.НазначенияАвторизации();
	ПараметрыАвторизации = Новый Структура("НазначениеАвторизации",
		ВозможныеНазначенияАвторизации.ПринудительнаяСменаКассира);
	ОткрытьФормуАвторизации(ПараметрыАвторизации);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеМагазинаКассираПриСменеСводно(Результат, НужнаИнициализация = Ложь)
	
	ОбновитьДанныеМагазинаКассираПриСмене(Результат);
	ВыполнитьНастройкиПослеОбновленияКассираМагазина(НужнаИнициализация);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНастройкиПослеОбновленияКассираМагазина(НужнаИнициализация, ЗапускПриСтарте = Ложь)
	
	ОткрытьОбщуюСтраницу();
	ПроверитьКассовуюСменуИНайтиКассира(, ЗапускПриСтарте);
	Если НужнаИнициализация Тогда
		ИнициализироватьФормуРабочегоМестаКассира();
	КонецЕсли;
	СформироватьЗаголовок();
	
КонецПроцедуры

&НаКлиенте
Функция ТребуетсяПовторнаяАвторизация(ОтложеннаяПроверкаКассовойСмены)

	РежимОсновногоОкна = КлиентскоеПриложение.ПолучитьРежимОсновногоОкна();
	ЭтоПолноэкранныйРежимРМК = (РежимОсновногоОкна = РежимОсновногоОкнаКлиентскогоПриложения.РабочееМесто
		Или РежимОсновногоОкна = РежимОсновногоОкнаКлиентскогоПриложения.Киоск);
	РезультатФункция = (Элементы.СменитьМагазин.Видимость 
		И (ОтложеннаяПроверкаКассовойСмены = Неопределено Или ЭтоПолноэкранныйРежимРМК));
		
	Возврат РезультатФункция;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОтправкуЧекаНаКлиентеПослеКонтроляПродаж(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ПараметрыОплатыПлатежнойСистемой) = Тип("Структура") Тогда
		ЗапуститьОплатуВозвратПлатежнойСистемой(ПараметрыОплатыПлатежнойСистемой.АвтономнаяККТ);
	Иначе
		ПробитоЧеков = ПробитыеЧеки.Количество();
		Если ЭтоЗаменаТоваров Тогда
			ОжидаемоеКоличествоЧеков = 2 - ПробитоЧеков;
		Иначе
			СистемыНалогообложенияПродажТоваровКорзины = ТаблицаЧековКПробитию;
			ОжидаемоеКоличествоЧеков = СистемыНалогообложенияПродажТоваровКорзины.Количество() - ПробитоЧеков;
		КонецЕсли;
		
		НачатьПечатьЧека();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействияПослеОткрытияИАвторизации();
	
	Если Не ПараметрыОткрытияФормыГосИС = Неопределено Тогда
		ПодключитьОбработчикОжидания("ОбработатьПараметрыГосИС", 0.1, Истина);
	КонецЕсли;
	
	ОбнулитьСчетчикНажатийКупюр();
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщениеОбОтсутствииКассККМ()
	
	ТекстЗаголовка = НСтр("ru = 'Ошибка открытия формы'");
	ТекстОшибки = НСтр("ru = 'Не найдено ни одной кассы ККМ. Обратитесь к администратору.'");
	ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстОшибки, ТекстЗаголовка);
	ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
	ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьТаблицуКассККМДляПередачиВФормы()
	
	МассивКасс = Новый Массив;
	Для Каждого СтрокаТаблицыКасс Из ТаблицаКассККМОрганизаций Цикл
		
		ПараметрыКассы = Новый Структура();
		ПараметрыКассы.Вставить("Организация", СтрокаТаблицыКасс.Организация);
		ПараметрыКассы.Вставить("КассаККМ", СтрокаТаблицыКасс.КассаККМ);
		ПараметрыКассы.Вставить("ИдентификаторУстройства", СтрокаТаблицыКасс.ИдентификаторУстройства);
		ПараметрыКассы.Вставить("КассоваяСмена", СтрокаТаблицыКасс.КассоваяСмена);
		ПараметрыКассы.Вставить("НачалоКассовойСмены", СтрокаТаблицыКасс.НачалоКассовойСмены);
		ПараметрыКассы.Вставить("ДатаИстеченияСрокаДействия", СтрокаТаблицыКасс.ДатаИстеченияСрокаДействия);
		ПараметрыКассы.Вставить("Открыта", СтрокаТаблицыКасс.Открыта);
		ПараметрыКассы.Вставить("КоличествоОтложенныхИНепробитыхЧеков",
			СтрокаТаблицыКасс.КоличествоОтложенныхИНепробитыхЧеков);
		ПараметрыКассы.Вставить("ТребуетсяВыемкаПриЗакрытииСмены", СтрокаТаблицыКасс.ТребуетсяВыемкаПриЗакрытииСмены);
		ПараметрыКассы.Вставить("ДенежныеСредстваВКассеККМ", СтрокаТаблицыКасс.ДенежныеСредстваВКассеККМ);
		ПараметрыКассы.Вставить("МинимальныйОстатокНаличныхВКассе", СтрокаТаблицыКасс.МинимальныйОстатокНаличныхВКассе);
		ПараметрыКассы.Вставить("СверятьСДаннымиОФД", СтрокаТаблицыКасс.СверятьСДаннымиОФД);
		ПараметрыКассы.Вставить("ПоддерживаетПроверкуКодовМаркировки",
			СтрокаТаблицыКасс.ПоддерживаетПроверкуКодовМаркировки);
		ПараметрыКассы.Вставить("ИспользоватьБезПодключенияОборудования",
			СтрокаТаблицыКасс.ИспользоватьБезПодключенияОборудования);
		ПараметрыКассы.Вставить("АвторизацияПройденаТСПИоТ", СтрокаТаблицыКасс.АвторизацияПройденаТСПИоТ);
		ПараметрыКассы.Вставить("ГотовКРаботеТСПИоТ", СтрокаТаблицыКасс.ГотовКРаботеТСПИоТ);
		ПараметрыКассы.Вставить("НастроенТСПИоТ", СтрокаТаблицыКасс.НастроенТСПИоТ);
		ПараметрыКассы.Вставить("ВнешнийТСПИоТ", СтрокаТаблицыКасс.ВнешнийТСПИоТ);
		МассивКасс.Добавить(ПараметрыКассы);
		
	КонецЦикла;
	Возврат МассивКасс;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьТаблицуТерминаловДляУправленияКассовымиСменами()
	
	МассивТерминалов = Новый Массив;
	Для Каждого СтрокаТерминала Из ТаблицаТерминалы Цикл
		ПараметрыТерминала = Новый Структура();
		ПараметрыТерминала.Вставить("ЭквайринговыйТерминал", СтрокаТерминала.ЭквайринговыйТерминал);
		ПараметрыТерминала.Вставить("ИспользоватьБезПодключенияОборудования",
			СтрокаТерминала.ИспользоватьБезПодключенияОборудования);
		ПараметрыТерминала.Вставить("ПодключаемоеОборудование", СтрокаТерминала.ПодключаемоеОборудование);
		ПараметрыТерминала.Вставить("Организация", СтрокаТерминала.Организация);
		МассивТерминалов.Добавить(ПараметрыТерминала);
	КонецЦикла;
	Возврат МассивТерминалов;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуУправленияКассовымиСменами(КассоваяОперация, ЗапускПриСтарте = Ложь)
	
	ТаблицаКассККМ = ПодготовитьТаблицуКассККМДляПередачиВФормы();
	Если ТаблицаКассККМ.Количество() = 0 Тогда
		ВывестиСообщениеОбОтсутствииКассККМ();
		Возврат;
	КонецЕсли;
	
	ФормаКассовыхСменДо = НайтиФормуПоИмени("Обработка.РабочееМестоКассира.Форма.ФормаУправленияКассовымиСменами");
	УправлениеСменамиОткрыто = ((Не ФормаКассовыхСменДо = Неопределено) И ФормаКассовыхСменДо.Открыта());
	Если УправлениеСменамиОткрыто Тогда
		ФормаКассовыхСменДо.ИнтерактивноеЗакрытие = Истина;
		ФормаКассовыхСменДо.Закрыть(Неопределено);
	КонецЕсли;
	
	ВозможныеКассовыеОперации = ИнтерфейсРМКСлужебныйКлиент.КассовыеОперации();
	РежимВыбора = (Не КассоваяОперация = ВозможныеКассовыеОперации.УправлениеСменами);
	
	ПараметрыДляОткрытия = Новый Структура();
	ПараметрыДляОткрытия.Вставить("РежимВыбора", РежимВыбора);
	ПараметрыДляОткрытия.Вставить("ЗапускПриСтарте", ЗапускПриСтарте);
	ПараметрыДляОткрытия.Вставить("ИспользоватьПодключаемоеОборудование", ИспользоватьПодключаемоеОборудование);
	ПараметрыДляОткрытия.Вставить("РежимКассыСамообслуживания", РежимКассыСамообслуживания);
	ПараметрыДляОткрытия.Вставить("ИспользоватьЦифровуюКлавиатуру", Не СкрытьЦифровуюКлавиатуру);
	ПараметрыДляОткрытия.Вставить("ИспользоватьДисплейПокупателя", ИспользоватьДисплейПокупателя);
	ПараметрыДляОткрытия.Вставить("ИспользоватьОплатуНаличными", ИспользоватьОплатуНаличными);
	ПараметрыДляОткрытия.Вставить("ПравоПросмотраОстаткаНаличныхРМК", ПравоПросмотраОстаткаНаличныхРМК);
	ПараметрыДляОткрытия.Вставить("ТаблицаКассККМ", ТаблицаКассККМ);
	ПараметрыДляОткрытия.Вставить("ТаблицаТерминалов", ПодготовитьТаблицуТерминаловДляУправленияКассовымиСменами());
	ПараметрыДляОткрытия.Вставить("НастройкаРМК", ТекущаяНастройкаРМК);
	ПараметрыДляОткрытия.Вставить("РабочееМесто", РабочееМесто);
	ПараметрыДляОткрытия.Вставить("Пользователь", Объект.ПользовательБД);
	ПараметрыДляОткрытия.Вставить("Кассир", Объект.Кассир);
	ПараметрыДляОткрытия.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
	ПараметрыДляОткрытия.Вставить("СписокРолейПользователя", СписокРолейПользователя);
	ПараметрыДляОткрытия.Вставить("УвеличенныйВариантМасштаба", УвеличенныйВариантМасштаба);
	ПараметрыДляОткрытия.Вставить("ПодключенаОблачнаяККТ", ПодключенаОблачнаяККТ);
	
	ДополнительныеПараметры = Новый Структура("КассоваяОперация", КассоваяОперация);
	ОбработкаОповещения = Новый ОписаниеОповещения("РаботаСКассамиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	РежимБлокировкиОкна = РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца;
	ОкноДиалога = Неопределено;
	
	УправлениеФормойПередано = Истина;
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаУправленияКассовымиСменами", ПараметрыДляОткрытия,
		ЭтотОбъект, , ОкноДиалога, , ОбработкаОповещения, РежимБлокировкиОкна);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВнесенияВыемки(ПараметрыДляОткрытия)
	
	НаличныеВКассе = 0;
	СтрокиКассККМ = ТаблицаКассККМОрганизаций.НайтиСтроки(Новый Структура("КассаККМ", Объект.КассаККМ));
	Если СтрокиКассККМ.Количество() > 0 Тогда
		СтрокаКассыККМ = СтрокиКассККМ[0];
		
		ПараметрыДляОткрытия.Вставить("ИспользоватьЦифровуюКлавиатуру", Не СкрытьЦифровуюКлавиатуру);
		ПараметрыДляОткрытия.Вставить("ПравоПросмотраОстаткаНаличныхРМК", ПравоПросмотраОстаткаНаличныхРМК);
		ПараметрыДляОткрытия.Вставить("НаличныеВКассе", СтрокаКассыККМ.ДенежныеСредстваВКассеККМ);
		ПараметрыДляОткрытия.Вставить("Организация", СтрокаКассыККМ.Организация);
		ПараметрыДляОткрытия.Вставить("КассаККМ", СтрокаКассыККМ.КассаККМ);
		ПараметрыДляОткрытия.Вставить("Кассир", Объект.Кассир);
		ПараметрыДляОткрытия.Вставить("КассоваяСмена", СтрокаКассыККМ.КассоваяСмена);
		ПараметрыДляОткрытия.Вставить("ПользовательБД", Объект.ПользовательБД);
		ПараметрыДляОткрытия.Вставить("ПодключаемоеОборудование", СтрокаКассыККМ.ИдентификаторУстройства);
		ПараметрыДляОткрытия.Вставить("СписокРолейПользователя", СписокРолейПользователя);
		ПараметрыДляОткрытия.Вставить("ЭтоВыемкаПриЗакрытииСмены", Ложь);
		ПараметрыДляОткрытия.Вставить("НесколькоКасс", (ТаблицаКассККМОрганизаций.Количество() > 1));
		ПараметрыДляОткрытия.Вставить("ТорговыйОбъект", Объект.ТорговыйОбъект);
		ПараметрыДляОткрытия.Вставить("Масштаб", Масштаб);
		
		ДополнительныеПараметры = Новый Структура("ЭтоВнесение", ПараметрыДляОткрытия.ЭтоВнесение);
		ДополнительныеПараметры.Вставить("КассаККМ", Объект.КассаККМ);
		ОбработкаОповещения = Новый ОписаниеОповещения("ВнесениеВыемкаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		УправлениеФормойПередано = Истина;
		ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаВнесенияВыемки", ПараметрыДляОткрытия, ЭтотОбъект,,,,
			ОбработкаОповещения);
	Иначе
		ТекстФормы = ?(ПараметрыДляОткрытия.ЭтоВнесение, НСтр("ru = 'внесения'"), НСтр("ru = 'выемки'"));
		ТекстЗаголовка = СтрШаблон("%1 %2", НСтр("ru = 'Ошибка открытия формы'"), ТекстФормы);
		ТекстОшибки = НСтр("ru = 'Ошибка получения данных кассы ККМ.'");
		
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстОшибки, ТекстЗаголовка);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнесениеВыемкаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	УправлениеФормойПередано = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.ОперацияПодтверждена И Не Результат.Ошибка Тогда
		
		СтрокиКассККМ = ТаблицаКассККМОрганизаций.НайтиСтроки(Новый Структура("КассаККМ", ДополнительныеПараметры.КассаККМ));
		Если СтрокиКассККМ.Количество() > 0 Тогда
			СтрокаКассыККМ = СтрокиКассККМ[0];
			СуммаДельта = ?(ДополнительныеПараметры.ЭтоВнесение, 1, -1) * Результат.СуммаОперации;
			СтрокаКассыККМ.ДенежныеСредстваВКассеККМ = СтрокаКассыККМ.ДенежныеСредстваВКассеККМ + СуммаДельта;
			ОтразитьОстаткиНаличныхДенежныхСредствНаФорме(Объект.Организация, Объект.КассаККМ);
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаботаСКассамиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	УправлениеФормойПередано = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если РежимКассыСамообслуживания Тогда
			ВыбратьПользователяДоЗаменыПрав();
		КонецЕсли;
		ВозможныеКассовыеОперации = ИнтерфейсРМКСлужебныйКлиент.КассовыеОперации();
		Если Результат.БылоОткрытиеСмены Тогда
			ЗаполнитьКэшКонтроляПродажПоДаннымПлиткиКлиент();
		КонецЕсли;
		Если Результат.БылоВнесениеВыемка Тогда
			Если Не Результат.БылоОбновлениеПослеВнесенияВыемки Тогда
				КассаДо = Объект.КассаККМ;
				ОрганизацияДо = Объект.Организация;
				ИзменитьСостояниеКассовойСмены();
				ВосстановитьТекущуюКассу(КассаДо, ОрганизацияДо);
			КонецЕсли;
			ОтразитьОстаткиНаличныхДенежныхСредствНаФорме(Объект.Организация, Объект.КассаККМ);
		КонецЕсли;
		
		Если Результат.БылоИзменениеСтатусаТСПИоТ Тогда
			
			ПодключитьОбработчикОжидания("ЗапуститьОбработкуСтатусовТСПИоТ", 0.5, Истина);
			
		КонецЕсли;
		
		Если Результат.ПродолжитьДействие Тогда
			ОбработатьВыборКассыККМ(Результат.КассаККМ);
			Если ДополнительныеПараметры.КассоваяОперация = ВозможныеКассовыеОперации.Внесение Тогда
				ОткрытьФормуВнесенияПослеВыбораКассы();
			ИначеЕсли ДополнительныеПараметры.КассоваяОперация = ВозможныеКассовыеОперации.Выемка Тогда
				ОткрытьФормуВыемки();
			ИначеЕсли ДополнительныеПараметры.КассоваяОперация = ВозможныеКассовыеОперации.ОтчетГашение Тогда
				ЗапроситьПодтверждениеСнятияОтчетаБезГашения();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТекущуюКассу(КассаДо, ОрганизацияДо)
	
	СтрокиКассККМ = ТаблицаКассККМОрганизаций.НайтиСтроки(Новый Структура("КассаККМ", КассаДо));
	Если СтрокиКассККМ.Количество() > 0 Тогда
		СтрокаКассыККМ = СтрокиКассККМ[0];
		Если ОрганизацияДо = СтрокаКассыККМ.Организация
				И (Не ОрганизацияДо = Объект.Организация Или Не КассаДо = Объект.КассаККМ) Тогда
			ОбработатьВыборКассыККМ(КассаДо);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЧекПозволяетРедактированиеБезПовышенияПрав()
	
	ЭтоВозвратПродажи = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации);
	ЭтоВозвратСкупки = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозвратСкупки(Объект.ВидОперации);
	
	Возврат (ЭтоВозвратПродажи Или ЭтоВозвратСкупки);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗарегистрироватьПовышениеПрав(Форма, ОперацияПовышения)
	
	Если РегистрироватьДействияКассира(Форма) Тогда
		ПараметрыОперации = ИнтерфейсРМКСлужебныйКлиентСервер.ПодготовитьПараметрыОперацииНаРабочемМестеКассира(Форма);
		ПараметрыОперации.РегистрируемаяОперация = ОперацияПовышения;
		
		ЗаписатьОперациюНаРабочемМестеКассира(ПараметрыОперации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьПовышениеПравНаВозвратЧека()
	
	ИмяРегистрируемойОперации = "Перечисление.ОперацииРабочегоМестаКассира.ПовышениеПравНаВозвратЧека";
	ОперацияПовышения = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент(ИмяРегистрируемойОперации);
	ЗарегистрироватьПовышениеПрав(ЭтотОбъект, ОперацияПовышения);
	
КонецПроцедуры

&НаКлиенте
Процедура АктуализироватьМаркиВСессииККТИПробитьЧек(КассаККМ)
	
	Отбор = Новый Структура("КассаККМ", КассаККМ);
	СтрокиКассы = ТаблицаКассККМОрганизаций.НайтиСтроки(Отбор);
	Если СтрокиКассы.Количество() = 0 Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не найдена касса ККМ ""%1"" в таблице касс. Обратитесь к администратору'"),
			Строка(КассаККМ));
		ВызватьИсключение ТекстОшибки;
	Иначе
		СтрокаКассы = СтрокиКассы[0];
	КонецЕсли;
	
	Если СтрокаКассы.ИспользоватьБезПодключенияОборудования
		Или Не ЗначениеЗаполнено(СтрокаКассы.ИдентификаторУстройства)
		Или Не СтрокаКассы.ПоддерживаетПроверкуКодовМаркировки Тогда
			ПробитьЧекПослеАктуализацииМарок();
			Возврат;
	КонецЕсли;
	
	Организация = СтрокаКассы.Организация;
	ИдентификаторУстройства = СтрокаКассы.ИдентификаторУстройства;
	
	ЕстьМаркиДляДобавленияВСессию = Ложь;
	Для Каждого ЭлементПроверки Из Объект.Товары Цикл
		Если (ЭлементПроверки.Оплачена И Не ЭлементПроверки.ТоварКЗамене)
			Или Не ЭлементПроверки.Организация = Организация
			Или Не ЭлементПроверки.МаркаПроверенаНаККТ Тогда
				Продолжить;
		КонецЕсли;
		ЕстьМаркиДляДобавленияВСессию = Истина;
		Прервать;
	КонецЦикла;
	
	Если Не ЕстьМаркиДляДобавленияВСессию Тогда
		ПробитьЧекПослеАктуализацииМарок();
		Возврат;
	КонецЕсли;
	
	Если ЭтоЗаменаТоваров И ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации) Тогда
		ПланируемыйСтатусТовара = ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварВозвращен");
	Иначе
		ПланируемыйСтатусТовара = ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварРеализован");
	КонецЕсли;
	
	ПодчиненнаяФормаОжиданияПроверкиМарок = ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаОжиданияПроверкиМарок");
	
	ПараметрыПроверкиКМ = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПроверкиКМ();
	ПараметрыПроверкиКМ.ОжидатьПолученияОтветаПроверкиКМ = Истина;
	ПараметрыПроверкиКМ.ОповещатьОВыполнении = Ложь;
	
	Для Каждого ЭлементПроверки Из Объект.Товары Цикл
		
		Если (ЭлементПроверки.Оплачена И Не ЭлементПроверки.ТоварКЗамене)
			Или Не ЭлементПроверки.Организация = Организация
			Или Не ЭлементПроверки.МаркаПроверенаНаККТ Тогда
				Продолжить;
		КонецЕсли;
		
		ПолныйКодМаркировки = ПривестиКодМаркировкиКBase64(ЭлементПроверки.КонтрольнаяМарка);
		
		ПараметрыЗапросаКМ = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыЗапросКМ();
		ПараметрыЗапросаКМ.КонтрольнаяМарка                = ПолныйКодМаркировки;
		ПараметрыЗапросаКМ.ПланируемыйСтатусТовара         = ПланируемыйСтатусТовара;
		ПараметрыЗапросаКМ.ЗапросРазрешенияПродажиКМ       = ЗначениеЗаполнено(ЭлементПроверки.РазрешительныйРежимДатаЗапросаГИСМТ);
		ПараметрыЗапросаКМ.ИдентификаторЗапросаРазрешения  = ЭлементПроверки.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
		ПараметрыЗапросаКМ.ВремяЗапросаРазрешения          = ЭлементПроверки.РазрешительныйРежимДатаЗапросаГИСМТ;
		ПараметрыЗапросаКМ.Наименование                    = СокрЛП(ЭлементПроверки.Номенклатура);
		ПараметрыЗапросаКМ.ИгнорироватьРезультатПроверкиКМ = Истина;
		ПараметрыЗапросаКМ.ОжидатьПолучениеОтветаОИСМ      = ЭлементПроверки.ОжидатьОтветПроверкиМаркиНаККТ;
		
		ЧастичноеВыбытие = Ложь;
		Если ЭлементПроверки.ПоддерживаетсяПодключениеКОборудованиюРозлива И ЧастичноеВыбытие
			И ЗначениеЗаполнено(ЭлементПроверки.ЧастичноеВыбытиеКоличество) Тогда
				ПараметрыЗапросаКМ.Количество = ЭлементПроверки.Количество;
				ПараметрыЗапросаКМ.МераКоличестваПредметаРасчета =
					ПредопределенноеЗначение("Перечисление.МераКоличестваПредметаРасчетаККТ.Литр");
		Иначе
			
			ПараметрыЗапросаКМ.Количество = 1;
			ДробноеКоличество = Ложь;
			Если ДробноеКоличество Тогда
				ПараметрыЗапросаКМ.ДробноеКоличество.Числитель   = ЭлементПроверки.ЧастичноеВыбытиеКоличество;
				ПараметрыЗапросаКМ.ДробноеКоличество.Знаменатель = ЭлементПроверки.ЕмкостьПотребительскойУпаковки;
				ПараметрыЗапросаКМ.КодЕдиницыИзмерения           = ЭлементПроверки.КодЕдиницыИзмерения;
			КонецЕсли;
			
		КонецЕсли;
		
		ПараметрыПроверкиКМ.ЗапросыКМ.Добавить(ПараметрыЗапросаКМ);
		
	КонецЦикла;
	
	ОповещениеПродолжения = Новый ОписаниеОповещения(
			"АктуализироватьМаркиВСессииККТЗавершение",
			ЭтотОбъект,
			ПараметрыПроверкиКМ);
		
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПроверкуКМ(
		ОповещениеПродолжения,
		ЭтотОбъект.УникальныйИдентификатор,
		ИдентификаторУстройства,
		ПараметрыПроверкиКМ);
		
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекПослеАктуализацииМарок()
	
	Если ЭтоЗаменаТоваров И ОбщегоНазначенияРМККлиент.ЭтоВидОперацииВозврат(Объект.ВидОперации) Тогда
		Отказ = Ложь;
		ПробитьЧекЗаменыТоваровВозвратЗавершениеПроверкиКМ(Отказ);
	Иначе
		НачатьПробитиеЧекаПриОплатеБезДеления();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АктуализироватьМаркиВСессииККТЗавершение(ДанныеОтвета, ПараметрыПроверки) Экспорт
	
	Если Не ПодчиненнаяФормаОжиданияПроверкиМарок = Неопределено И ПодчиненнаяФормаОжиданияПроверкиМарок.Открыта() Тогда
		ПодчиненнаяФормаОжиданияПроверкиМарок.Закрыть();
		ПодчиненнаяФормаОжиданияПроверкиМарок = Неопределено;
	КонецЕсли;
	
	Если ДанныеОтвета.Результат Тогда
		ПробитьЧекПослеАктуализацииМарок();
	Иначе
		ТекстСообщения = ДанныеОтвета.ОписаниеОшибки;
		ЗаголовокОшибки = НСтр("ru='Ошибка проверки марок'");
		
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстСообщения, ЗаголовокОшибки);
		ОткрытьФормуСообщенияОбОшибке(ПараметрыОткрытияОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПробитиеЧекаПриОплатеБезДеления()
	
	ПробитоЧеков = ПробитыеЧеки.Количество();
	Если ПробитоЧеков > 0 Тогда
		Если СуммаОплаченоБН > 0 Тогда
			ОплатитьКартойИПробитьЧекВТихомРежимеПродолжение(Ложь, Неопределено);
		ИначеЕсли РежимТихойОплаты И ТипОплаты = "СБП" Тогда
			ОплатитьСБПИПробитьЧекВТихомРежимеПродолжение(Ложь, Неопределено);
		ИначеЕсли ОплатаБезДеленияПоЧекам Тогда
			ОбработатьПробитиеЧекаНаКлиенте(Команды.ПробитьЧек);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПредставлениеСНО(СистемаНалогообложения)
	
	Результат = СистемаНалогообложения;
	ОбщегоНазначенияРМККлиентПереопределяемый.ПредставлениеСНО(Результат, СистемаНалогообложения);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьОплатыПоТекущемуЧеку(Обнулить = Ложь)
	
	Если НЕ ЗначениеЗаполнено(НомерТекущегоЭлементаСпискаЧеков) Тогда
		Возврат;
	КонецЕсли;
	
	НомерТекущегоЭлементаСпискаЧеков = Мин(НомерТекущегоЭлементаСпискаЧеков, ТаблицаЧековКПробитию.Количество());
	
	ТекущийЧек = ТаблицаЧековКПробитию[НомерТекущегоЭлементаСпискаЧеков-1];
	Если Обнулить Тогда
		ТекущийЧек.ПринятоНаличными = 0;
		ТекущийЧек.Сдача = 0;
		ТекущийЧек.СуммаОплат = 0;
		ТекущийЧек.ОсталосьОплатить = ТекущийЧек.СуммаЧека;
		ОбщийСдача = 0;
	Иначе
		ТекущийЧек.ПринятоНаличными = СуммаОплаченоНал;
		ТекущийЧек.Сдача = Сдача;
		ТекущийЧек.СуммаОплат = СуммаЗаполненныхОплат;
		ТекущийЧек.ОсталосьОплатить = Макс(0, СуммаКОплате);
		ОбщийСдача = Сдача;
	КонецЕсли;
	
	ПересчитатьОбщиеИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьДанныеКартыПолученныеССервераЛояльности(ДанныеКарты, ЗапрашиватьБонусы = Ложь)
	КартаНедействительна = Ложь;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеКарты, "Valid") Тогда
		КартаНедействительна = НЕ ДанныеКарты.Valid;
	КонецЕсли;
	
	ЭтоПродажа = ОбщегоНазначенияРМККлиент.ЭтоВидОперацииПродажа(Объект.ВидОперации);
	Если НЕ КартаНедействительна Тогда
		РеквизитыДисконтнойКарты = ЗаполнитьПараметрыКартыЛояльности(ДанныеКарты);
		ЗаполнитьДанныеКартыНаФормеВЧеке85(РеквизитыДисконтнойКарты);
		Если ЭтоПродажа Тогда
			ЗавершитьВводШтрихкодаНайденаКарта(КодВозвратаДиалога.Нет, ЗапрашиватьБонусы);
		КонецЕсли;
	Иначе
		ОчиститьДанныеПокупателя();
		ПараметрыШтрихкода = Новый Структура;
		ПараметрыШтрихкода.Вставить("Штрихкод", ДанныеКарты.Barcode);
		ПоказатьИнформациюОКарте(ПараметрыШтрихкода);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьПараметрыКартыЛояльности(ДанныеКарты)
	Возврат ИнтерфейсРМКСлужебный.ЗаполнитьПараметрыКартыЛояльности(ДанныеКарты);
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеКартыНаФормеВЧеке85(ВыбранноеОписаниеКарты)
	
	ЭтоПродажа = ОбщегоНазначенияРМК.ЭтоВидОперацииПродажа(Объект.ВидОперации);
	
	ШтрихкодированиеРМК.ЗаполнитьФормуПоДисконтнойКарте(ЭтотОбъект, ВыбранноеОписаниеКарты);
	Если ЭтоПродажа И ИспользоватьОплатуБонусами Тогда
		ИнтерфейсРМКСлужебныйКлиентСервер.ОтобразитьИнформациюОБонусныхБаллах85(ЭтотОбъект, ВыбранноеОписаниеКарты);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция АктивацияNFCСсылки()
	
	АктивацияNFC = Ложь;
	
	ОплатаСБПНастроена = Не Элементы.ПробитьЧекСложнойОплаты.Доступность
		И Элементы.ОплатаСБП.Видимость
		И Элементы.ОплатаСБП.Доступность;
		
	ЭтоКСОВВертикальнойОриентации = (РежимКассыСамообслуживания И ВертикальнаяОриентация);
	Если ОплатаСБПНастроена 
			И ЭтоКСОВВертикальнойОриентации
			И ИспользуемыеВидыОплат.Количество() > 1 Тогда
		
		АктивацияNFC = Истина;
		
	КонецЕсли;
	
	Возврат АктивацияNFC;
	
КонецФункции

&НаСервере
Процедура ПереместитьТоварыПриПереходеКОплате(РежимОплаты, ЭтоВозврат = Ложь)
	
	Элементы.ГруппаЛево.Доступность = Истина;
	Элементы.ГруппаЛево.ТолькоПросмотр = РежимОплаты;
	
	Элементы.КолонкиРежимаПлитки.Видимость = РежимОплаты Или РежимПлитки;
	
	Элементы.КолонкиОбычногоРежима.Видимость = НЕ (РежимОплаты Или РежимПлитки);
	Элементы.ГруппаИнфо.Видимость = НЕ (РежимОплаты Или РежимПлитки);
	Элементы.ПанельИзбранныхТоваров.Видимость = ИспользоватьПанельИзбранныхТоваров И НЕ РежимОплаты;
	АктуализироватьРежимВыделенияТоваров(ЭтотОбъект, Не (РежимОплаты Или РежимПлитки));
	
	Если РежимОплаты Тогда
		Элементы.Переместить(Элементы.ГруппаУправленияКонтрагентами, Элементы.ГруппаОбщиеИтоги, Элементы.ГруппаДанныеОтправкиЧека);
		Элементы.Переместить(Элементы.ГруппаЛево, Элементы.СтраницаТоваровСложнойОплаты);
	ИначеЕсли РежимПлитки Тогда
		Элементы.Переместить(Элементы.ГруппаУправленияКонтрагентами, Элементы.ГруппаКнопокЛояльности, Элементы.ГруппаСкидка);
		Элементы.Переместить(Элементы.ГруппаЛево, Элементы.ГруппаРаботаСТоварамиПлитки);
	Иначе
		Элементы.Переместить(Элементы.ГруппаУправленияКонтрагентами, Элементы.ГруппаКнопокЛояльности, Элементы.ГруппаСкидка);
		Элементы.Переместить(Элементы.ГруппаЛево, Элементы.ГруппаЛевоОболочкаПорядка, Элементы.КомандыПробитияСложнойОплаты);
	КонецЕсли;
	Если Не РежимКассыСамообслуживания Тогда
		ЭтапЧекаВозвратКоррекция = (РежимРаботыСЧеком = РежимыРаботыСЧеком.ВозвратКоррекция);
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаКнопокУправленияТоваромВозврат, ЭтоВозврат);
		УстановитьДоступностьЭлементаФормы(Элементы.ГруппаКнопокУправленияТоваромВозврат, ЭтапЧекаВозвратКоррекция);
	КонецЕсли;
	
	Если РежимОплаты Тогда
		Элементы.СтраницыСложнойОплатыДополнительные.ТекущаяСтраница = Элементы.СтраницаТоваровСложнойОплаты;
	КонецЕсли;
	
	ОбновлятьСуммуАванса = РежимОплаты И ПриемАванса И СуммаИтого = 0;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьПустуюСтруктураФормыВводаСумм()
	
	ПараметрыДляОткрытия = ИнтерфейсРМКСлужебныйКлиент.ШаблонСтруктурыФормыВводаСумм();
	
	ПараметрыДляОткрытия.ИспользоватьЦифровуюКлавиатуру = (Не СкрытьЦифровуюКлавиатуру);
	ПараметрыДляОткрытия.Масштаб = Масштаб;
	ПараметрыДляОткрытия.УвеличенныйВариантМасштаба = УвеличенныйВариантМасштаба;
	ПараметрыДляОткрытия.ШаблонСообщения =
		ОбщегоНазначенияРМКВызовСервера.ЗначениеРеквизитаОбъекта(ТекущаяНастройкаРМК, "ШаблонSMSПриСписанииБонусов");
	ПараметрыДляОткрытия.ИспользоватьПанельВводаНаличных = ИспользоватьПанельВводаНаличных;
	ПараметрыДляОткрытия.ТекущаяНастройкаРМК = ТекущаяНастройкаРМК;
	ПараметрыДляОткрытия.ЭтоВнесениеПредоплатыПоЗаказу = ЭтоВнесениеПредоплатыПоЗаказу;
	ПараметрыДляОткрытия.СуммаОплаченоЗачетАванса = СуммаОплаченоЗачетАванса;
	ПараметрыДляОткрытия.ПриемАванса = ПриемАванса;
	ПараметрыДляОткрытия.ИспользоватьДисплейПокупателя
		= (ИспользоватьДисплейПокупателя И ИспользоватьПодключаемоеОборудование);
	ПараметрыДляОткрытия.РежимКассыСамообслуживания = РежимКассыСамообслуживания;
	ПараметрыДляОткрытия.КомпактныйРежимПодменю = КомпактныйРежимПодменю;
	
	Возврат ПараметрыДляОткрытия;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОткрытаПустаяСтраница(Элементы)
	
	РезультатФункции = (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПустая
		Или (Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОбщая
			И Элементы.СтраницыКорзиныРМК.ТекущаяСтраница = Элементы.СтраницаУправленияЧеком
			И Элементы.СтраницыОбластиСоставаЧека.ТекущаяСтраница = Элементы.СтраницаПустогоЧека));
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Процедура УстановитьСтраницыСДаннымиЧека()
	
	ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаЧекаСДанными);
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПустая Тогда
		ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаОбщая);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура АктуализироватьРежимВыделенияТоваров(Форма, РежимОбычногоПодбора)
	
	Элементы = Форма.Элементы;
	Если ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85() И Форма.МножественноеВыделениеТоваров Тогда
		НовыйРежимВыделения = ?(РежимОбычногоПодбора, РежимВыделенияТаблицы.Множественный, РежимВыделенияТаблицы.Одиночный);
		Если Не Элементы.Товары.РежимВыделения = НовыйРежимВыделения Тогда
			Элементы.Товары.РежимВыделения = НовыйРежимВыделения;
			Если Элементы.Товары.ВыделенныеСтроки.Количество() > 0 Тогда
				Элементы.Товары.ВыделенныеСтроки.Очистить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОпределеитьКоличествоВидимыхКнопокВГруппе(КоличествоКнопок, КоличествоГрупп, ЭлементГруппа)
	
	АвтоЦвет = Новый Цвет();
	Для Каждого ПодчиненныйЭлемент Из ЭлементГруппа.ПодчиненныеЭлементы Цикл
		Если ПодчиненныйЭлемент.Видимость И ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") Тогда
			Если СтрЗаканчиваетсяНа(ПодчиненныйЭлемент.Имя, "_Карточка") Тогда
				КоличествоКнопок = КоличествоКнопок + 1;
			Иначе
				Если Не ПодчиненныйЭлемент.ЦветФона = АвтоЦвет И Не ПодчиненныйЭлемент.ЦветФона = ЭлементГруппа.ЦветФона Тогда
					КоличествоГрупп = КоличествоГрупп + 1;
				КонецЕсли;
				ОпределеитьКоличествоВидимыхКнопокВГруппе(КоличествоКнопок, КоличествоГрупп, ПодчиненныйЭлемент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыГруппыРежим()
	
	ЭлементыОригиналы = Новый Массив;
	СоздатьКарточкиВГруппе(Элементы.СтраницаРежимы1, 24, ЭлементыОригиналы);
	
	Для Каждого ЭлементКнопка Из ЭлементыОригиналы Цикл
		Элементы.Переместить(ЭлементКнопка, Элементы.СтраницаРежимы2);
	КонецЦикла;
	
	Элементы["Продажа_Картинка"].ЦветКартинки = ЦветаПалитры.Зеленый;
	Элементы["ВозвратПродажи_Картинка"].ЦветКартинки = ЦветаПалитры.Красный;
	Элементы["Заказ_Картинка"].ЦветКартинки = ЦветаПалитры.Желтый;
	
	Элементы.Переместить(Элементы.ДекорацияОтступРежим, Элементы.ГруппаРежимКолонка4);
	Элементы.Переместить(Элементы.РежимЗакрыть, Элементы.ГруппаРежимКолонка4);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыГруппыЕще()
	
	КнопкиДляПереноса = Новый Массив;
	ШиринаКарточки = ?(ЭтоИнтерфейс85 И КомпактныйРежимПодменю, 26, 28);
	СоздатьКарточкиВГруппе(Элементы.СтраницаЕще1, ШиринаКарточки, КнопкиДляПереноса);
	
	Для Каждого ЭлементКнопка Из КнопкиДляПереноса Цикл
		Элементы.Переместить(ЭлементКнопка, Элементы.СтраницаЕще2);
	КонецЦикла;
	
	МаксимальноеКоличествоКнопок = 0;
	МаксимальноеКоличествоГрупп = 0;
	КоличествоКнопокКолонки3 = 0;
	Для Каждого ЭлементКолонка Из Элементы.СтраницаЕще1.ПодчиненныеЭлементы Цикл
		КоличествоКнопок = 0;
		КоличествоГрупп = 0;
		ОпределеитьКоличествоВидимыхКнопокВГруппе(КоличествоКнопок, КоличествоГрупп, ЭлементКолонка);
		МаксимальноеКоличествоКнопок = Макс(МаксимальноеКоличествоКнопок, КоличествоКнопок);
		Если ЭлементКолонка = Элементы.ГруппаЕщеКолонка3 Тогда
			КоличествоКнопокКолонки3 = КоличествоКнопок;
		КонецЕсли;
	КонецЦикла;
	Если КомпактныйРежимПодменю Тогда
		КоличествоОтступовДобавить = Макс(МаксимальноеКоличествоКнопок - (КоличествоКнопок + КоличествоКнопокКолонки3), 0);
	Иначе
		КоличествоОтступовДобавить = МаксимальноеКоличествоКнопок - (КоличествоКнопок + 1);
	КонецЕсли;
	
	Для НомерЭлемента = 1 По КоличествоОтступовДобавить Цикл
		ЭлементНадпись = Элементы.Добавить("ДекорацияЕщеОтступ_" + НомерЭлемента,
			Тип("ДекорацияФормы"), Элементы.ЕщеГруппаОтступ);
		ЭлементНадпись.Вид = ВидДекорацииФормы.Надпись;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьКарточкиВГруппе(ЭлементГруппа, Ширина, ЭлементыОригиналы)
	
	Для Каждого Элемент Из ЭлементГруппа.ПодчиненныеЭлементы Цикл
		Если СтрЗаканчиваетсяНа(Элемент.Имя, "_Карточка") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			Элемент.ЦветФона = Новый Цвет;
		//	Элемент.Ширина = 28;
		//	Элемент.Видимость = Истина;  // все кнопки Истина
			Элемент.Объединенная = Ложь;
			Элемент.РастягиватьПоВертикали = Ложь;
			СоздатьКарточкиВГруппе(Элемент, Ширина, ЭлементыОригиналы);
		ИначеЕсли ТипЗнч(Элемент) = Тип("КнопкаФормы") Тогда
			Если Элемент.Имя = "ЕщеЗакрыть" Или Элемент.Имя = "РежимЗакрыть" Тогда
				Продолжить;
			КонецЕсли;
			Карточка = СоздатьКарточкуКнопки(Элемент, Ширина);
			ЭлементыОригиналы.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СоздатьКарточкуКнопки(ЭлементКнопка, Ширина)
	
	Если Не ТипЗнч(ЭлементКнопка) = Тип("КнопкаФормы") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЭлементКнопка.Ширина = 1;
	ЭлементКнопка.РастягиватьПоГоризонтали = Ложь;
	
	ЭлементГруппа = ЭлементКнопка.Родитель;
	
	ИмяКнопки = ЭлементКнопка.Имя;
	ИмяГруппы = ИмяКнопки + "_Карточка";
	
	ГруппаКарточка = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), ЭлементГруппа);
	ГруппаКарточка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКарточка.ОтображатьЗаголовок = Ложь;
	ГруппаКарточка.ОтображатьКакКарточку = Истина;
	ГруппаКарточка.РастягиватьПоГоризонтали = Ложь;
	ГруппаКарточка.Ширина = Ширина;
	ГруппаКарточка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаКарточка.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	ГруппаКарточка.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Центр;
	ГруппаКарточка.Гиперссылка = Истина;
//	ГруппаКарточка.РастягиватьПоВертикали = Истина;
	
	Если Не ЭтоИнтерфейс85 Тогда
		ГруппаКарточка.ЦветФона = Новый Цвет(235,235,235);
	КонецЕсли;
	
	ГруппаКарточка.Доступность = ЭлементКнопка.Доступность;
	ГруппаКарточка.Видимость = ЭлементКнопка.Видимость;
//	ГруппаКарточка.Видимость = ЭлементКнопка.Видимость;
//	ГруппаКарточка.Видимость = Истина;  // все кнопки Истина
	
	Если ЗначениеЗаполнено(ЭлементКнопка.ИмяКоманды) Тогда
		Команда = Команды[ЭлементКнопка.ИмяКоманды];
	Иначе
		Команда = Команды.НастройкаКаталогаЗакрыть;
	КонецЕсли;
	
	ГруппаКарточка.УстановитьДействие("Нажатие", Команда.Действие);
	
	Если Не ЭтоИнтерфейс85 Тогда
		ИмяГруппы = ИмяКнопки + "_Рамка";
		ГруппаКарточка1 = ГруппаКарточка;
		ГруппаКарточка = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), ГруппаКарточка);
		ГруппаКарточка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаКарточка.ОтображатьЗаголовок = Ложь;
		ГруппаКарточка.РастягиватьПоГоризонтали = Истина;
		ГруппаКарточка.ЦветФона = Новый Цвет(255,255,255);
	КонецЕсли;
	
	ЭлементКартинка = Элементы.Добавить(ИмяКнопки + "_Картинка" , Тип("ДекорацияФормы"), ГруппаКарточка);
	ЭлементКартинка.Вид = ВидДекорацииФормы.Картинка;
	Если ЗначениеЗаполнено(ЭлементКнопка.Картинка) Тогда
		ЭлементКартинка.Картинка = ЭлементКнопка.Картинка;
	ИначеЕсли ЗначениеЗаполнено(Команда.Картинка) Тогда
		ЭлементКартинка.Картинка = Команда.Картинка;
	Иначе
		ЭлементКартинка.Картинка = БиблиотекаКартинок.Закрыть;
	КонецЕсли;
	ЭлементКартинка.ОтображениеФона = ОтображениеФонаКартинки.ОтображатьИНеУвеличиватьРазмер;
	ЭлементКартинка.РазмерКартинки = РазмерКартинки.ПоРазмеруШрифта;
	ЭлементКартинка.Шрифт = Элементы.ДекорацияШрифтКартинок.Шрифт;
	ЭлементКартинка.ЦветКартинки = ЦветаПалитры.Синий;
	
	Если ГруппаКарточка.Родитель.Имя = "ГруппаЕщеКолонка1" Или ГруппаКарточка.Родитель.Родитель.Имя = "ГруппаЕщеКолонка1"
		Или ГруппаКарточка.Родитель.Родитель.Родитель.Имя = "ГруппаЕщеКолонка1" Тогда
		ЭлементКартинка.ЦветКартинки = ЦветаПалитры.Зеленый;
	ИначеЕсли ГруппаКарточка.Родитель.Имя = "ГруппаЕщеКолонка2" Или ГруппаКарточка.Родитель.Родитель.Имя = "ГруппаЕщеКолонка2"
		Или ГруппаКарточка.Родитель.Родитель.Родитель.Имя = "ГруппаЕщеКолонка2" Тогда
		ЭлементКартинка.ЦветКартинки = ЦветаПалитры.Синий;
	ИначеЕсли ГруппаКарточка.Родитель.Имя = "ГруппаЕщеКолонка3" Или ГруппаКарточка.Родитель.Родитель.Имя = "ГруппаЕщеКолонка3"
		Или ГруппаКарточка.Родитель.Родитель.Родитель.Имя = "ГруппаЕщеКолонка3" Тогда
		ЭлементКартинка.ЦветКартинки = ЦветаПалитры.Оранжевый;
	ИначеЕсли ГруппаКарточка.Родитель.Имя = "ГруппаЕщеКолонка4" Или ГруппаКарточка.Родитель.Родитель.Имя = "ГруппаЕщеКолонка4"
		Или ГруппаКарточка.Родитель.Родитель.Родитель.Имя = "ГруппаЕщеКолонка4" Тогда
		ЭлементКартинка.ЦветКартинки = ЦветаПалитры.Сиреневый;
	КонецЕсли;
	
	ЭлементНадпись = Элементы.Добавить(ИмяКнопки + "_Надпись" , Тип("ДекорацияФормы"), ГруппаКарточка);
	ЭлементНадпись.Вид = ВидДекорацииФормы.Надпись;
	Заголовок = ?(ЭлементКнопка.Заголовок = "", Команда.Заголовок, ЭлементКнопка.Заголовок);
	ЭлементНадпись.Заголовок = Заголовок + ?(СтрНайти(Заголовок, " ") > 0, "", " " + Символы.НПП);
//	ЭлементНадпись.Высота = 2;
	ЭлементНадпись.АвтоМаксимальнаяВысота = Ложь;
	ЭлементНадпись.МаксимальнаяВысота = 2;
	Если Ширина = 25 Тогда
		ЭлементНадпись.МаксимальнаяВысота = 1;
		ЭлементКартинка.РазмерКартинки = РазмерКартинки.Пропорционально;
	КонецЕсли;
	Если ЭтоИнтерфейс85 И КомпактныйРежимПодменю Тогда
		ЭлементНадпись.Шрифт = ШрифтыСтиля.ТекстТретьегоУровня;
	КонецЕсли;
	ЭлементНадпись.РастягиватьПоВертикали = Истина;
//	ЭлементНадпись.РастягиватьПоГоризонтали = Истина;
	
//	ЭлементНадпись.АвтоМаксимальнаяШирина = Ложь;
//	ЭлементНадпись.МаксимальнаяШирина = 28;
	
	Возврат ГруппаКарточка;
	
КонецФункции

&НаСервере
Процедура ПереместитьЭлементыПодменюКомпактно()
	
	Элементы.Переместить(Элементы.ГруппаРежимКолонка4, Элементы.ГруппаРежимКолонка2);
	Элементы.Переместить(Элементы.ДекорацияОтступРежим, Элементы.ГруппаРежимКолонка3);
	Элементы.Переместить(Элементы.РежимЗакрыть, Элементы.ГруппаРежимКолонка3);
	
	Элементы.Переместить(Элементы.ГруппаЕщеКолонка4, Элементы.ГруппаЕщеКолонка3);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСвойстваЭлементовПанелиОперацийПоИнтерфейсу(НастройкиЭлементов)
	
	Если Не ЭтоИнтерфейс85 Тогда
		
		ЭлементыПанелиОпераций = Новый Массив;
		ЭлементыПанелиОпераций.Добавить(Элементы.ПерейтиНаНачальнуюСтраницу);

		Для Каждого ЭлементПанели Из ЭлементыПанелиОпераций Цикл
			ЭлементПанели.РастягиватьПоВертикали = Истина;
		КонецЦикла;
		
		Если Элементы.ПерейтиНаНачальнуюСтраницу.Ширина = 0 Тогда
			Элементы.ПерейтиНаНачальнуюСтраницу.Ширина = 6;
		КонецЕсли;
		ШиринаКнопокОперации = 4;
		УстановитьШиринуЕслиНеЗадана(Элементы.УдалитьЧек, ШиринаКнопокОперации);
		УстановитьШиринуЕслиНеЗадана(Элементы.Каталог, ШиринаКнопокОперации);
		УстановитьШиринуЕслиНеЗадана(Элементы.НастройкаВводаПоСтрокеОткрытьНастройки, ШиринаКнопокОперации);
		УстановитьШиринуЕслиНеЗадана(Элементы.ТекущийТоварУстановитьДробноеКоличество, ШиринаКнопокОперации);
		Элементы.Декорация1.Ширина = 5;
		УвеличенныйВид = (ВидОтображения = ПредопределенноеЗначение("Перечисление.ВидыОтображения.Увеличенный"));
		ВысотаКнопокОпераций = 1;
		Если Не УвеличенныйВид Тогда
			УстановитьВысотуЕслиНеЗадана(Элементы.Каталог, ВысотаКнопокОпераций);
			УстановитьВысотуЕслиНеЗадана(Элементы.НайтиПоШтрихкодуКСО, ВысотаКнопокОпераций);
			УстановитьВысотуЕслиНеЗадана(Элементы.СкидкаНаЧек, ВысотаКнопокОпераций);
			УстановитьВысотуЕслиНеЗадана(Элементы.УправляемыеСкидки, ВысотаКнопокОпераций);
			УстановитьВысотуЕслиНеЗадана(Элементы.СборкаПоЗаказу, ВысотаКнопокОпераций);
			УстановитьВысотуЕслиНеЗадана(Элементы.ОтменитьИзмененияЧека, ВысотаКнопокОпераций);
			УстановитьВысотуЕслиНеЗадана(Элементы.СкидкиНайтиВЧеке, ВысотаКнопокОпераций);
			УстановитьВысотуЕслиНеЗадана(Элементы.ПечатьСкидок, ВысотаКнопокОпераций);
			УстановитьВысотуЕслиНеЗадана(Элементы.НастройкаВводаПоСтрокеОткрытьНастройки, ВысотаКнопокОпераций);
			Если Не ОсновнойПодборПлиточный Тогда
				УстановитьВысотуЕслиНеЗадана(Элементы.ОткрытьПлиточныйИнтерфейсКаталога, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.ОтложитьЧек, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.ВвестиКомментарийКЧеку, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.УдалитьЧек, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.КомандаЕще, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.ТекущийТоварУменьшитьКоличество, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.ТекущийТоварУменьшитьКоличествоИзВозврата, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.ТекущийТоварУвеличитьКоличество, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.ТекущийТоварУвеличитьКоличествоИзВозврата, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.ТекущийТоварУстановитьДробноеКоличество, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.ПолучитьВес, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.УдалитьТовар, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.УдалитьТоварИзВозврата, ВысотаКнопокОпераций);
				УстановитьВысотуЕслиНеЗадана(Элементы.ПоказатьОстатки, ВысотаКнопокОпераций);
				Элементы.ГруппаТекущийТовар.РастягиватьПоВертикали = Ложь;
				
				УстановитьШиринуЕслиНеЗадана(Элементы.УдалитьТовар, ШиринаКнопокОперации);
				УстановитьШиринуЕслиНеЗадана(Элементы.ТекущийТоварУменьшитьКоличество, ШиринаКнопокОперации);
				УстановитьШиринуЕслиНеЗадана(Элементы.ТекущийТоварУвеличитьКоличество, ШиринаКнопокОперации);
				УстановитьШиринуЕслиНеЗадана(Элементы.УдалитьТоварИзВозврата, ШиринаКнопокОперации);
				УстановитьШиринуЕслиНеЗадана(Элементы.ТекущийТоварУменьшитьКоличествоИзВозврата, ШиринаКнопокОперации);
				УстановитьШиринуЕслиНеЗадана(Элементы.ТекущийТоварУвеличитьКоличествоИзВозврата, ШиринаКнопокОперации);
				УстановитьШиринуЕслиНеЗадана(Элементы.ПолучитьВес, ШиринаКнопокОперации);
			КонецЕсли;
		КонецЕсли;
		Элементы.ГруппаНастройкиРежим.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
		Элементы.ГруппаНастройкиРежим.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Центр;
		Элементы.КомандаРежим.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Авто;
		
		Элементы.ПродавецТекущейСтроки.АвтоМаксимальнаяШирина = Ложь;
		Элементы.ПродавецТекущейСтроки.МаксимальнаяШирина = ?(УвеличенныйВид, 37, 39);
		Элементы.ПродавецТекущейСтроки.РастягиватьПоГоризонтали = Истина;
		Элементы.ВвестиДанныеПокупателя.Высота = ?(УвеличенныйВид, 2, 1);
		Элементы.ПоказатьРассчитанныеСкидкиНаЧек.Высота = ?(УвеличенныйВид, 2, 1);
		Элементы.ОтменитьВводКартыКрестик.Ширина = ?(УвеличенныйВид, 4, 2);
		Элементы.ОтменаРасчетаСкидок.Ширина = ?(УвеличенныйВид, 4, 2);
		Элементы.ПиктограммаЗапретаПродажи.Высота = 6;
		
		ИнтерфейсРМКСлужебныйКлиентСервер.НастроитьВидГлавнойКнопкиПереходаКОплате(ЭтотОбъект, НастройкиЭлементов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВысотуЕслиНеЗадана(ЭлементФормы, НоваяВысота)
	
	Если ЭлементФормы.Высота = 0 Тогда
		ЭлементФормы.Высота = НоваяВысота;
	КонецЕсли;
	ЭлементФормы.РастягиватьПоВертикали = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьШиринуЕслиНеЗадана(ЭлементФормы, НоваяШирина)
	
	Если ЭлементФормы.Ширина = 0 Тогда
		ЭлементФормы.Ширина = НоваяШирина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеКупюры(КомандаКупюры, НоминалКупюры)
	
	КоличествоНажатий = 0;
	Если Не СчетчикНажатийНаКупюры.Свойство("Номинал" + НоминалКупюры, КоличествоНажатий) Тогда
		КоличествоНажатий = 0;
	КонецЕсли;
	УстановитьЗаголовокКупюры(КомандаКупюры, КоличествоНажатий, НоминалКупюры);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокКупюры(КомандаКупюры, КоличествоНажатий, НоминалКупюры)
	
	ЗаголовокКупюры = "";
	Если КоличествоНажатий > 0 Тогда
		ЗаголовокКупюры = СтрШаблон("(%1) %2", Формат(КоличествоНажатий, "ЧГ="), НоминалКупюры);
	Иначе
		ЗаголовокКупюры = НоминалКупюры;
	КонецЕсли;
	КомандаКупюры.Заголовок = ЗаголовокКупюры;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьБыстрыеОплаты()
	
	Возврат (ИспользоватьОплатуНаличными Или ИспользоватьБыструюОплатуКартой Или ИспользоватьБыструюОплатуСБП);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьПереходКОплате()
	
	НеобходимПересчетАвтоматическихСкидок = ОпределитьНеобходимостьПересчетаАвтоматическихСкидок();
	Если НеобходимПересчетАвтоматическихСкидок И ВопросПоРасчетуСкидок Тогда
		ЗадатьВопросПоРасчетуСкидок("ПерейтиВОплатуЗавершение", , Истина);
	Иначе
		ПерейтиВОплатуЗавершение(?(НеобходимПересчетАвтоматическихСкидок, КодВозвратаДиалога.Да, КодВозвратаДиалога.Нет));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВУникальнуюОплату()
	
	Если РежимПлитки И Элементы.ПлиткаГруппаОплатить.Доступность Тогда
		ПерейтиВОплатуИзПлитки();
	ИначеЕсли (Не РежимПлитки) И Элементы.КонтейнерКнопокПереходаКОплате.Доступность Тогда
		ПерейтиВРежимОплаты(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВОплатуИзПлитки()
	
	ЭтоЕдинственныйВидОплаты = (ИспользуемыеВидыОплат.Количество() = 1
		И ИнтерфейсРМКСлужебныйКлиент.ПропуститьОкноСВыборомКартыЛояльностиДопустимо(ЭтотОбъект));
	Если РежимКассыСамообслуживания И ЭтоЕдинственныйВидОплаты Тогда
		ОбработатьПереходКОплате();
	ИначеЕсли (Не РежимКассыСамообслуживания) И (ЭтоЕдинственныйВидОплаты Или Не ЕстьБыстрыеОплаты()) Тогда
		ОбработатьПереходКОплате();
	Иначе
		ПоказатьДиалогПереходаКОплате(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыДаннымиЛояльности(ПараметрыЗаполнения)
	
	ДанныеЛояльности = Новый Структура("Объект", Новый Структура);
	ДанныеЛояльности.Объект.Вставить("Контрагент", Объект.Контрагент);
	ДанныеЛояльности.Объект.Вставить("ДисконтнаяКарта", Объект.ДисконтнаяКарта);
	ДанныеЛояльности.Вставить("ПараметрыКартыЛояльности", ПараметрыКартыЛояльности);
	
	ПараметрыЗаполнения.Вставить("ДанныеЛояльности", ДанныеЛояльности);
	ПараметрыЗаполнения.Вставить("КоличествоБонусов", КоличествоБонусов);
	ПараметрыЗаполнения.Вставить("НайденнаяКартаНомер", НайденнаяКартаНомер);
	ПараметрыЗаполнения.Вставить("НайденнаяКартаТелефон", НайденнаяКартаТелефон);
	ПараметрыЗаполнения.Вставить("НайденнаяКартаФИО", НайденнаяКартаФИО);
	ПараметрыЗаполнения.Вставить("СуммаБезСкидки", СуммаБезСкидки);
	ПараметрыЗаполнения.Вставить("СуммаБонусовКНачислению", СуммаБонусовКНачислению);
	ПараметрыЗаполнения.Вставить("СуммаИтого", СуммаИтого);
	ПараметрыЗаполнения.Вставить("СуммаКОплате", СуммаКОплате);
	ПараметрыЗаполнения.Вставить("СуммаОплаченоБонусами", СуммаОплаченоБонусами);
	ПараметрыЗаполнения.Вставить("ВведенаБонуснаяКарта", ВведенаБонуснаяКарта);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДиалогПереходаКОплате(ИзПлиточногоИнтерфейса)
	
	ЗаголовкиОбластей = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьЗаголовкиОбластейДляНастроек();
	НастройкиВводаПокупателей = СвойстваНастроекЭлементов.Получить(ЗаголовкиОбластей.ВвестиДанныеПокупателя);
	СвойствоВысота = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ВысотаКнопок");
	ЗначениеНастройки = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьЗначениеПерсональнойНастройки(СвойстваНастроекЭлементов,
		Элементы.ПерейтиКОплате.Имя, СвойствоВысота);
	ВысотаКнопокОплат = ?(ЗначениеЗаполнено(ЗначениеНастройки), ЗначениеНастройки, 0);
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("ВертикальнаяОриентация", ВертикальнаяОриентация);
	ПараметрыОткрытия.Вставить("ЗапоминатьНомерКартыЛояльности", ЗапоминатьНомерКартыЛояльности);
	ПараметрыОткрытия.Вставить("РазрешитьЗаменуДисконтнойКарты", РазрешитьЗаменуДисконтнойКарты);
	ПараметрыОткрытия.Вставить("ИспользоватьДисконтныеКарты", ?(РежимКассыСамообслуживания,
		ВводДисконтныхКарт, ИспользоватьДисконтныеКарты));
	ПараметрыОткрытия.Вставить("ИспользоватьОплатуНаличными", ИспользоватьОплатуНаличными);
	ПараметрыОткрытия.Вставить("ИспользоватьОплатуПлатежнымиКартами", ИспользоватьОплатуПлатежнымиКартами);
	ПараметрыОткрытия.Вставить("ИспользоватьБыструюОплатуСБП", ИспользоватьБыструюОплатуСБП);
	ПараметрыОткрытия.Вставить("КодВалютыЦены", КодВалютыЦены);
	ПараметрыОткрытия.Вставить("НастройкаРМК", ТекущаяНастройкаРМК);
	ПараметрыОткрытия.Вставить("ЭлектронныйЧек", (ПодключенаОблачнаяККТ Или (Не ПечататьБумажныйЧек И РежимТихойОплаты)));
	ПараметрыОткрытия.Вставить("ЭтоРаботаСАвансом", ЭтоРаботаСАвансом());
	ПараметрыОткрытия.Вставить("ИспользоватьОплатуБонусами", ИспользоватьОплатуБонусами);
	ПараметрыОткрытия.Вставить("ИспользоватьАвтоматическиеСкидки", ИспользоватьАвтоматическиеСкидки);
	ПараметрыОткрытия.Вставить("ВводДисконтныхКарт", ВводДисконтныхКарт);
	ПараметрыОткрытия.Вставить("РежимКассыСамообслуживания", РежимКассыСамообслуживания);
	ПараметрыОткрытия.Вставить("НастройкиВводаПокупателей", НастройкиВводаПокупателей);
	ПараметрыОткрытия.Вставить("ИзПлиточногоИнтерфейса", ИзПлиточногоИнтерфейса);
	ПараметрыОткрытия.Вставить("Масштаб", Масштаб);
	ПараметрыОткрытия.Вставить("ВысотаКнопокОплат", ВысотаКнопокОплат);
	ПараметрыОткрытия.Вставить("УвеличенныйВариантМасштаба", УвеличенныйВариантМасштаба);
	ПараметрыОткрытия.Вставить("ИспользоватьСкидкуПенсионерам", ЗначениеСкидкиПенсионерам <> 0
		И РежимКассыСамообслуживания);
	ПараметрыОткрытия.Вставить("ЗаголовокКомандыСкидкаПенсионера",
		ЗаголовокКомандыСкидкаПенсионера(СкидкаПенсионерамРассчитана));
	ПараметрыОткрытия.Вставить("ПокупательПенсионер", ПокупательПенсионер);
	ПараметрыОткрытия.Вставить("ПодключенаОблачнаяККТ", ПодключенаОблачнаяККТ);
	ЗаполнитьПараметрыДаннымиЛояльности(ПараметрыОткрытия);

	ОбработкаОповещения = Новый ОписаниеОповещения("ОбработатьОтветДиалогаПереходаКОплате", ЭтотОбъект);
	
	РежимБлокировкиОкна = ?(РежимКассыСамообслуживания, РежимБлокировкиПриОткрытииОкнаФормы.НеБлокировать,
		РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВесьИнтерфейс);
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаПереходаКОплате",
		ПараметрыОткрытия, ЭтотОбъект,,,, ОбработкаОповещения, РежимБлокировкиОкна);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветДиалогаПереходаКОплате(Результат, ДополнительныеПараметры) Экспорт
	
	РассчитатьСкидкуПенсионерам = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("РассчитатьСкидкуПенсионерам", РассчитатьСкидкуПенсионерам) Тогда
		
		ОбщегоНазначенияРМККлиентСервер.УстановитьТекущуюСтраницу(Элементы.СтраницаПодтверждениеСтатусаПокупателя);
		УстановитьДоступностьЭлементаФормы(Элементы.ГруппаОперации, Ложь);
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаУправленияКСО, Ложь);
		
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаДекорацияСтатусПокупателя, Ложь);
		Элементы.ДекорацияТекстСтатусПокупателя.Заголовок = "";
		УстановитьВидимостьЭлементаФормы(Элементы.ГруппаПодтверждениеСтатусаПокупателяКоманды, Ложь);
		
		ПерейтиВРежимОплатыПослеРасчетаСкидкиПенсионера = Истина;
		ОткрытьПодтверждениеСтатусаПокупателя(Ложь, Ложь);
		Возврат;
	КонецЕсли;
	
	ИмяВидаОплаты = "";
	Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("ВидОплаты", ИмяВидаОплаты) Тогда
		Если ИмяВидаОплаты = "СложнаяОплата" Тогда
			ОбработатьПереходКОплате();
		ИначеЕсли ИмяВидаОплаты = "Наличные" Тогда
			ВыполнитьОплатуНаличнымиВТихомРежиме();
		ИначеЕсли ИмяВидаОплаты = "Карта" Тогда
			ВыполнитьОплатуКартойВТихомРежиме();
		ИначеЕсли ИмяВидаОплаты = "СБП" Тогда
			ВыполнитьОплатуСБПВТихомРежиме();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьПараметрыОбновленияЛояльности()
	
	РезультатФункции = Новый Структура;
	ЗаполнитьПараметрыДаннымиЛояльности(РезультатФункции);
	Возврат РезультатФункции;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОповещениеОтменыВводаКарты(Результат, ДополнительныеПараметры) Экспорт
	
	ОтменитьВводКартыКлиент(Истина);
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Свойство("ПлиточныйИнтерфейс") И Результат.ПлиточныйИнтерфейс = Истина Тогда
			ВернутьПлиточныйИнтерфейс();
		КонецЕсли;
		Если Результат.Свойство("ОбратноеОповещение") Тогда
			ПараметрыОбновленияЛояльности = ПодготовитьПараметрыОбновленияЛояльности();
			ВыполнитьОбработкуОповещения(Результат.ОбратноеОповещение, ПараметрыОбновленияЛояльности);
		КонецЕсли;
	КонецЕсли;
	НастроитьВидКнопкиОплатыВПлиткеСУчетомВозврата();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВнешнийВыборКартыЛояльности(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не Результат = Неопределено Тогда
		
		ОбновитьДанныеЛояльности(Результат, ДополнительныеПараметры.ДополнительныеПараметры);
		Если ДополнительныеПараметры.Свойство("ПлиточныйИнтерфейс")
				И ДополнительныеПараметры.ПлиточныйИнтерфейс = Истина Тогда
			ВернутьПлиточныйИнтерфейс();
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("ОбратноеОповещение") Тогда
			ПараметрыОбновленияЛояльности = ПодготовитьПараметрыОбновленияЛояльности();
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбратноеОповещение, ПараметрыОбновленияЛояльности);
		КонецЕсли;
		НастроитьВидКнопкиОплатыВПлиткеСУчетомВозврата();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьПлиточныйИнтерфейс()
	
	Если Не РежимПлитки Тогда
		ОткрытьПлиточныйИнтерфейсКаталога(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОплатуКартойВТихомРежиме()
	
	Если Объект.Товары.Количество() > 0 И Не ФормаЗамороженаПослеПробитияЧека() Тогда 
		РежимТихойОплаты = Истина;
		ОплатаБезДеленияПоЧекам = Истина;
		ТипОплаты = "Карта";
		ОплатитьКартойВТихомРежиме();
	КонецЕсли;
	
КонецПроцедуры

