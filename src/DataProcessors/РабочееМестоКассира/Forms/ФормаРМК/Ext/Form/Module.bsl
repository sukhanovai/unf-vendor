	Если ЗначениеЗаполнено(Объект.ДисконтнаяКарта) Тогда
		
		СохранитьДанныеКартыСервер();
		ЗаполнитьДанныеДляОтправкиЧека(НайденнаяКартаПочта, НайденнаяКартаТелефон);
		
	КонецЕсли;
	
КонецПроцедуры

