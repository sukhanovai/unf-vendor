&НаКлиенте
Процедура ВосстановитьСтраницуИзбранного(НомерНажатой, СтрокаКарточки)
	
	МаксимальноеКоличествоНаСтранице = ИнтерфейсРМКСлужебныйКлиентСервер.КоличествоКарточекИзбранногоНаСтранице();
	
	ИменаЭлементов = ИнтерфейсРМКСлужебныйКлиент.ПолучитьИменаЭлементовИзбранного();
	ИмяКонтейнера = СтрШаблон("%1%2", ИменаЭлементов.Контейнер, НомерНажатой);
	ИмяПустойОбласти = СтрШаблон("%1%2", ИменаЭлементов.ВидПустой, НомерНажатой);
	ИмяСтраницаИзбранное = СтрШаблон("%1%2", ИменаЭлементов.СтраницаИзбранное, НомерНажатой);
	ИмяСтраницыИзбранного = СтрШаблон("%1%2", ИменаЭлементов.СтраницыИзбранного, НомерНажатой);
	ИмяСтраницаЭлемента = СтрШаблон("%1%2", ИменаЭлементов.СтраницаЭлемента, НомерНажатой);
	ИмяСтраницаЭлементаСКартинкой = СтрШаблон("%1%2", ИменаЭлементов.СтраницаЭлементаСКартинкой, НомерНажатой);
	ИмяСтраницыГруппы = СтрШаблон("%1%2", ИменаЭлементов.СтраницаГруппы, НомерНажатой);
	ВидимостьКартинки = ЗначениеЗаполнено(СтрокаКарточки.АдресИзображения);
	
	Если ЗначениеЗаполнено(СтрокаКарточки.Номенклатура) Или ЗначениеЗаполнено(СтрокаКарточки.Характеристика) Тогда
		Элементы[ИмяКонтейнера].ТекущаяСтраница = Элементы[ИмяСтраницаИзбранное];
		Элементы[ИмяСтраницыИзбранного].ТекущаяСтраница
			= ?(ВидимостьКартинки, Элементы[ИмяСтраницаЭлементаСКартинкой], Элементы[ИмяСтраницаЭлемента]);
	ИначеЕсли (РежимВыбораХарактеристики И НомерНажатой = МаксимальноеКоличествоНаСтранице)
			Или СтрокаКарточки.ЭтоКатегория Тогда
		Элементы[ИмяКонтейнера].ТекущаяСтраница = Элементы[ИмяСтраницаИзбранное];
		Элементы[ИмяСтраницыИзбранного].ТекущаяСтраница = Элементы[ИмяСтраницыГруппы];
	ИначеЕсли НавигацияИзбранногоВключена И НомерНажатой = МаксимальноеКоличествоНаСтранице Тогда
		Элементы.КонтейнерИзбранное_8.ТекущаяСтраница = Элементы.СтраницаИзбранноеНавигация;
	Иначе
		Элементы[ИмяКонтейнера].ТекущаяСтраница = Элементы[ИмяПустойОбласти];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКарточкиХарактеристики(СтрокаКарточки, НомерНажатой)
	
	МаксимальноеКоличествоНаСтранице = ИнтерфейсРМКСлужебныйКлиентСервер.КоличествоКарточекИзбранногоНаСтранице();
	Если НомерНажатой = МаксимальноеКоличествоНаСтранице И Не ЗначениеЗаполнено(СтрокаКарточки.Характеристика) Тогда
		ПоказатьВсеХарактеристики(Неопределено, Неопределено);
	Иначе
		ОтборПоХарактеристике = Новый Структура("ЗначениеВыбора", СтрокаКарточки.Характеристика);
		СтрокиДанных = ДанныеПлиткиПодбораЗначений.НайтиСтроки(ОтборПоХарактеристике);
		Если СтрокиДанных.Количество() > 0 Тогда
			ПараметрыХарактеристики = Новый Структура();
			ПараметрыХарактеристики.Вставить("ЗначениеВыбора", СтрокаКарточки.Характеристика);
			ПараметрыХарактеристики.Вставить("Цена", СтрокиДанных[0].Цена);
			ПараметрыХарактеристики.Вставить("НаименованиеДляПечати", СтрокаКарточки.ИмяЭлемента);
			ЗаполнитьДанныеВыборХарактеристики(Неопределено, ПараметрыХарактеристики);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборИзбранного(ОбъектИнтерфейса)
	
	ТребуетсяПовышениеПрав = Ложь;
	ОбновитьКоличествоВРедактируемойСтроке(ТребуетсяПовышениеПрав);
	Если ТребуетсяПовышениеПрав Тогда
		Возврат;
	КонецЕсли;
	
	НомерСтрокой = ИнтерфейсРМКСлужебныйКлиент.ПолучитьНомерНажатогоИзбранного(ОбъектИнтерфейса);
	Если Не НомерСтрокой = Неопределено Тогда
		
		НомерНажатой = Число(НомерСтрокой);
		СтрокаНажатойКнопки = ДанныеКнопок.Получить(НомерНажатой - 1);
		
		СтрокаКарточки = ДанныеКнопок.Получить(НомерНажатой - 1);
		ЭтоКарточкаГруппа = (СтрокаКарточки.ЭтоКатегория ИЛИ СтрокаКарточки.ЭтоТекущаяКатегория
			ИЛИ СтрокаКарточки.ИмеетсяВложенность);
		Если ТребуетсяПовышениеПрав Или Не ЭтоКарточкаГруппа Тогда
			
			ВосстановитьСтраницуИзбранного(НомерНажатой, СтрокаКарточки);
			
		КонецЕсли;
		Если Не ТребуетсяПовышениеПрав Тогда
			Если РежимВыбораХарактеристики Тогда
				ОбработатьВыборКарточкиХарактеристики(СтрокаКарточки, НомерНажатой);
			Иначе
				ПропуститьПоискСопутствующихТоваров = Истина;
				ВыбратьЭлементИзИзбранногоИПлитки(СтрокаНажатойКнопки, Ложь);
				ПропуститьПоискСопутствующихТоваров = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

