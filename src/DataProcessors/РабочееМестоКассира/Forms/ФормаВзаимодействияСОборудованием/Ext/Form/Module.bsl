КонецПроцедуры

&НаКлиенте
Процедура АвтономнаяККТПодтвердитьОплату(Команда)
	ПараметрыЗакрытияФорма = Новый Структура("АвтономнаяККТОплатаПодтверждена", Истина);
	ЗакрытьФорму(ПараметрыЗакрытияФорма);
КонецПроцедуры

&НаКлиенте
Процедура АвтономнаяККТОтменитьОплату(Команда)
	ПараметрыЗакрытияФорма = Новый Структура("АвтономнаяККТОплатаОтклонена", Истина);
	ЗакрытьФорму(ПараметрыЗакрытияФорма);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьОтменуОплаты(Команда)
	
	Если РежимКассыСамообслуживания Тогда
		
		ТекстВопроса = НСтр("ru = 'Возникла проблема при продаже. При продолжении будет произведен возврат оплаты.'");
		
		СписокОтветов = Новый СписокЗначений;
		СписокОтветов.Добавить("Продолжить");
		СписокОтветов.Добавить("Отмена");
		
		Результат = Ждать ВопросАсинх(ТекстВопроса, СписокОтветов, , "Продолжить");
		
		Если Результат <> "Продолжить" Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыЗакрытияФорма = Новый Структура("ОтменитьОплатуКартой", Истина);
	Если ЭтоОшибкаПроверкиСтатусаЧекаВОблаке Тогда
		ПараметрыЗакрытияФорма.Вставить("НеобходимоПодтверждениеОперации", Истина);
	КонецЕсли;
	
	ЗакрытьФорму(ПараметрыЗакрытияФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПовторноеПробитие(Команда)
	ПараметрыЗакрытияФорма = Новый Структура("ПовторитьПробитие", Истина);
