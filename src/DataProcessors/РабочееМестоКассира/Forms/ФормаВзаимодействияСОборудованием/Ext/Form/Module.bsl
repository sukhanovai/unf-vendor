КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьОкноВызоваСотрудника()
	
	НаименованиеПользователяВОбращении = "";
	Если ТипЗнч(ВладелецФормы) = Тип("ФормаКлиентскогоПриложения")
			И ВладелецФормы.ИмяФормы = "Обработка.РабочееМестоКассира.Форма.ФормаРМК" Тогда
		НаименованиеПользователяВОбращении = ВладелецФормы.НаименованиеПользователяПриЗапросеПрав;
	КонецЕсли;
	ТекстЗаголовка = ИнтерфейсРМКСлужебныйКлиент.СформироватьЗаголовокВызоваСотрудника(ПодключенаОблачнаяККТ,
		НаименованиеПользователяВОбращении);
	
	ТекстОшибки = НСтр("ru = 'Чтобы отменить вызов сотрудника, закройте текущее сообщение.'");
	ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстОшибки, ТекстЗаголовка);
	ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
	
	ОбработкаОповещения = Новый ОписаниеОповещения("ЗакрытиеСообщенияОбОшибке", ЭтотОбъект);
	
	ПараметрыОткрытияОшибки.Вставить("РежимКассыСамообслуживания", РежимКассыСамообслуживания);
	ПараметрыОткрытияОшибки.Вставить("УвеличенныйВариантМасштаба", УвеличенныйВариантМасштаба);
	ИнтерфейсРМКСлужебныйКлиент.ОткрытьФормуСообщенияОбОшибке(ЭтотОбъект, ПараметрыОткрытияОшибки, ОбработкаОповещения);
	
	ВывестиИнформациюНаДисплейПокупателя(ТипыОперацийДисплеяПокупателя.Ошибка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеСообщенияОбОшибке(Результат, ДополнительныеПараметры) Экспорт
	ВывестиСветовойСигналНаДисплей("РабочееМестоРаботает");
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСветовойСигналНаДисплей(ИмяСтатуса)
	
	ПараметрыОперации = МенеджерОборудованияРМККлиент.ПараметрыОперацииДисплейПокупателя();
	Если ПараметрыОперации.Свойство("СтатусРабочегоМеста") Тогда
		ПолноеИмяСтатуса = СтрШаблон("Перечисление.СтатусРабочегоМестаНаДисплее.%1", ИмяСтатуса);
		СтатусРабочегоМеста = ПредопределенноеЗначение(ПолноеИмяСтатуса);
		ПараметрыОперации.СтатусРабочегоМеста = СтатусРабочегоМеста;
			
		МенеджерОборудованияРМККлиент.НачатьВыводСтатусаРабочегоМестаНаДисплейПокупателя(Неопределено,
			Неопределено, Неопределено, ПараметрыОперации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиИнформациюНаДисплейПокупателя(Операция, ТекстОшибки = "")
	
	Если Не ИспользоватьДисплейПокупателя Тогда
		Возврат;
	КонецЕсли;
	
	ИсходныеДанные = МенеджерОборудованияРМККлиент.ИсходныеДанныеДляПервичнойПередачиНаДисплейПокупателя();
	ИсходныеДанные.ОповещениеПриЗавершении = Новый ОписаниеОповещения("ВывестиИнформациюНаДисплейПокупателяЗавершение", ЭтотОбъект);
	ИсходныеДанные.ИспользоватьПодключаемоеОборудование = ИспользоватьПодключаемоеОборудование;
	ИсходныеДанные.ДанныеДляОтображения = ИнтерфейсРМКСлужебныйКлиент.БуферОбменаДисплеяПокупателя();
	ИсходныеДанные.Операция = Операция;
	ИсходныеДанные.Организация = Объект.Организация;
	ИсходныеДанные.ТекстОшибки = ТекстОшибки;
	МенеджерОборудованияРМККлиент.ВывестиИнформациюНаДисплейПокупателя(Операция, ИсходныеДанные, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(ПараметрыЗакрытияФорма)
	ПрограммноеЗакрытие = Истина;
	Закрыть(ПараметрыЗакрытияФорма);
КонецПроцедуры

#КонецОбласти