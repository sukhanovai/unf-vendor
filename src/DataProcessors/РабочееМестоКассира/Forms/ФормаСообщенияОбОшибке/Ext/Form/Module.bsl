#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьФормуПоВходнымПараметрам()
	
	РежимКассыСамообслуживания = Параметры.РежимКассыСамообслуживания;
	Если ЗначениеЗаполнено(Параметры.ТекстЗаголовка) Тогда
		Если РежимКассыСамообслуживания И ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85() Тогда
			Элементы.ЗаголовокФормы.Заголовок = Параметры.ТекстЗаголовка;
			Элементы.ЗаголовокФормы.Видимость = Истина;
		Иначе
			ОтображатьЗаголовок = Истина;
			Заголовок = Параметры.ТекстЗаголовка;
		КонецЕсли;
	КонецЕсли;
	Элементы.ТекстПредупреждениеОшибка.Заголовок = Параметры.ТекстОшибки;
	ИнтерфейсРМКСлужебный.ПрименитьНаФормеМасштабИзПараметров(ЭтотОбъект, Параметры);
	
	ОтобразитьГруппуОтчетОбОшибке = Истина;
		
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ЭтоПредупреждение")
		И Параметры.ЭтоПредупреждение Тогда
		ОтобразитьГруппуОтчетОбОшибке = Ложь;
	Иначе
		#Если Не ВебКлиент Тогда
			ПодатьСигнал = Истина;
		#КонецЕсли
	КонецЕсли;
	
	ВосстановитьСоединение = Ложь;
	ОшибкаРасчетаСкидок = Ложь;
	НеобходимоСторно = Ложь;
	ОшибкаФормированияИсходныхДанных = Ложь;
	ТипОплаты = НСтр("ru = ''");
	ЭтоПродажа = Ложь;
	ТранзакцияПоКартеЗавершена = Ложь;
	ОткрытиеСмены = Ложь;
	ЗакрытиеСмены = Ложь;
	УправлениеЧеком = Ложь;
	СопоставлениеТовара = Ложь;
	МаркаНеПроверенаНаККТ = Ложь;
	КонтрольСотрудникомНаКСО = Ложь;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ВосстановитьСоединение") Тогда
		ВосстановитьСоединение = Параметры.ВосстановитьСоединение;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ОшибкаРасчетаСкидок")Тогда
		ОшибкаРасчетаСкидок = Параметры.ОшибкаРасчетаСкидок;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "НеобходимоСторно") Тогда
		НеобходимоСторно = Параметры.НеобходимоСторно;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ОшибкаФормированияИсходныхДанных") Тогда
		ОшибкаФормированияИсходныхДанных = Параметры.ОшибкаФормированияИсходныхДанных;
	КонецЕсли;
		
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ТипОплаты") Тогда
		ТипОплаты = Параметры.ТипОплаты;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ЭтоПродажа") Тогда
		ЭтоПродажа = Параметры.ЭтоПродажа;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ТранзакцияПоКартеЗавершена") Тогда
		ТранзакцияПоКартеЗавершена = Параметры.ТранзакцияПоКартеЗавершена;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ОткрытиеСмены") Тогда
		ОткрытиеСмены = Параметры.ОткрытиеСмены;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ЗакрытиеСмены") Тогда
		ЗакрытиеСмены = Параметры.ЗакрытиеСмены;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "УправлениеЧеком") Тогда
		УправлениеЧеком = Параметры.УправлениеЧеком;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "СопоставлениеТовара") Тогда
		СопоставлениеТовара = Параметры.СопоставлениеТовара;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "МаркаНеПроверенаНаККТ") Тогда
		МаркаНеПроверенаНаККТ = Параметры.МаркаНеПроверенаНаККТ;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "КонтрольСотрудникомНаКСО") Тогда
		КонтрольСотрудникомНаКСО = Параметры.КонтрольСотрудникомНаКСО;
	КонецЕсли;
	
	
	ОтобразитьКнопкуОтмены = Истина;
	ОтобразитьКнопкуПовторногоПробития = Ложь;
	ОтобразитьКнопкуОтменыПлатежа = Ложь;
	ОтобразитьКнопкуОтложитьЧек = Ложь;
	ОтобразитьКнопкуУдалитьЧек = Ложь;
	
	Если НеобходимоСторно
		И ЗначениеЗаполнено(ТипОплаты) Тогда
		ОтобразитьКнопкуПовторногоПробития = НЕ ОшибкаФормированияИсходныхДанных;
		ОтобразитьКнопкуОтмены = Ложь;
		ОтобразитьКнопкуОтложитьЧек = Истина;
		
		Если ЭтоПродажа И (ТранзакцияПоКартеЗавершена ИЛИ ТипОплаты = "СБП") Тогда
			ОтобразитьКнопкуОтменыПлатежа = Истина;
			ОтобразитьКнопкуУдалитьЧек = Ложь;
		ИначеЕсли Не ЭтоПродажа И (ТранзакцияПоКартеЗавершена ИЛИ ТипОплаты = "СБП") Тогда
			ОтобразитьКнопкуОтменыПлатежа = Ложь;
			ОтобразитьКнопкуУдалитьЧек = Ложь;
		ИначеЕсли ТипОплаты = "ЮКасса" Тогда
			ОтобразитьКнопкуОтменыПлатежа = Ложь;
			ОтобразитьКнопкуУдалитьЧек = Ложь;
		Иначе
			ОтобразитьКнопкуОтменыПлатежа = Истина;
			ОтобразитьКнопкуУдалитьЧек = Истина;
		КонецЕсли;
	Иначе
		ОтобразитьКнопкуОтложитьЧек = УправлениеЧеком;
		ОтобразитьКнопкуУдалитьЧек = УправлениеЧеком;
	КонецЕсли;
	
	УстановитьВидимостьЭлементаФормы(Элементы.ОтправитьСообщениеВПоддержку, ОтобразитьГруппуОтчетОбОшибке И Не РежимКассыСамообслуживания);
	УстановитьВидимостьЭлементаФормы(Элементы.СформироватьОтчетОбОшибке, ОтобразитьГруппуОтчетОбОшибке И Не РежимКассыСамообслуживания);
	УстановитьВидимостьЭлементаФормы(Элементы.КартинкаЛинияПредупреждения, ОтобразитьГруппуОтчетОбОшибке);
	УстановитьВидимостьЭлементаФормы(Элементы.ВосстановитьСоединениеССерверомЛояльности, ВосстановитьСоединение);
	УстановитьВидимостьЭлементаФормы(Элементы.ПродолжитьБезРасчетаСкидок, ОшибкаРасчетаСкидок Или ВосстановитьСоединение);
	
	УстановитьВидимостьЭлементаФормы(Элементы.ЗакрытьФорму, ОтобразитьКнопкуОтмены);
	УстановитьВидимостьЭлементаФормы(Элементы.ГруппаКомандПовторногоДействия, ОтобразитьКнопкуПовторногоПробития);
	УстановитьВидимостьЭлементаФормы(Элементы.ВыполнитьОтменуОплаты, ОтобразитьКнопкуОтменыПлатежа);
	УстановитьВидимостьЭлементаФормы(Элементы.ОтложитьЧекИзОшибки, ОтобразитьКнопкуОтложитьЧек);
	УстановитьВидимостьЭлементаФормы(Элементы.УдалитьЧекИзОшибки, ОтобразитьКнопкуУдалитьЧек);
	УстановитьВидимостьЭлементаФормы(Элементы.ОткрытьКассовуюСмену, ОткрытиеСмены);
	УстановитьВидимостьЭлементаФормы(Элементы.ЗакрытьКассовуюСмену, ЗакрытиеСмены);
	
	УстановитьВидимостьЭлементаФормы(Элементы.СопоставитьТовар, СопоставлениеТовара);
	УстановитьВидимостьЭлементаФормы(Элементы.ОтказатьсяДобавлятьТовар, МаркаНеПроверенаНаККТ);
	УстановитьВидимостьЭлементаФормы(Элементы.ОтменитьПриКонтролеСотрудникомНаКСО, КонтрольСотрудникомНаКСО);
	
	Если МаркаНеПроверенаНаККТ Тогда
		Элементы.ЗакрытьФорму.Заголовок = НСтр("ru = 'Да'");
	ИначеЕсли КонтрольСотрудникомНаКСО Тогда
		Элементы.ЗакрытьФорму.Заголовок = НСтр("ru = 'Подтвердить'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементаФормы(Элемент, Видимость)
	Элемент.Видимость = Видимость;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(ПараметрыЗакрытияФорма)
	ПрограммноеЗакрытие = Истина;
	Закрыть(ПараметрыЗакрытияФорма);
КонецПроцедуры

#КонецОбласти