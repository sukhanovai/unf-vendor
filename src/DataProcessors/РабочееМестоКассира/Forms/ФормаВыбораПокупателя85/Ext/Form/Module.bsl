&НаКлиенте
Процедура ОтменитьСозданиеКартыКлиент()
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ОповещениеОтменитьСозданиеКарты", ЭтотОбъект);
	ТекстВопроса = НСтр("ru = 'При закрытии данные будут потеряны. Продолжить?'");
	ПоказатьВопрос(ОповещениеОЗакрытии,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормуДаннымиКонтрагента()
	НайденнаяКартаЛояльности = Неопределено;
	Если ЗначениеЗаполнено(Объект.Контрагент) И Не ЗначениеЗаполнено(Объект.ДисконтнаяКарта) Тогда
		ШтрихкодированиеРМКПереопределяемый.ЗаполнитьДанныеНайденнойКартыЛояльности(
			Объект.Контрагент, НайденнаяКартаЛояльности);
	КонецЕсли;
	
	Если Не НайденнаяКартаЛояльности = Неопределено Тогда
		
		Если ЗначениеЗаполнено(НайденнаяКартаЛояльности.АдресЭПВладельцаКарты) Тогда
			ОтправкаЧекаПочта = НайденнаяКартаЛояльности.АдресЭПВладельцаКарты;
			НоваяКартаПочта = НайденнаяКартаЛояльности.АдресЭПВладельцаКарты;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденнаяКартаЛояльности.НомерТелефонаВладельцаКарты) Тогда
			
			МаскаТелефона = ИнтерфейсРМКСлужебныйКлиентСервер.МаскаВводаТелефона();
			ИсходныйНомер = НайденнаяКартаЛояльности.НомерТелефонаВладельцаКарты;
			ОтправкаЧекаТелефон
				= ИнтерфейсРМКСлужебныйКлиентСервер.ПривестиЗначениеКМаскеТелефона(ИсходныйНомер, МаскаТелефона);
			НоваяКартаТелефон = НайденнаяКартаЛояльности.НомерТелефонаВладельцаКарты;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СокрЛП(НайденнаяКартаЛояльности.ФИО)) Тогда
			НоваяКартаФИО = НайденнаяКартаЛояльности.ФИО;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс
&НаКлиенте
Процедура ВыполнитьЗаменуИЗакрытьФрму(Результат, ДополнительныеПараметры) Экспорт
	
	СтрокиДляОбработки = Новый Массив;
	Для Каждого СтрокаЗаменить Из ТаблицаДанных.НайтиСтроки(Новый Структура("Отметка", Истина)) Цикл
		СтрокиДляОбработки.Добавить(СтрокаЗаменить);
	КонецЦикла;
	Для Каждого СтрокаНаЗамену Из ТаблицаДанных.НайтиСтроки(Новый Структура("ОтметкаЗамена", Истина)) Цикл
		СтрокиДляОбработки.Добавить(СтрокаНаЗамену);
	КонецЦикла;
	ВыполнитьОбъединение(СтрокиДляОбработки);
	РезультатПоиска = ПолучитьРезультатПоискаКарты();
	Закрыть(РезультатПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВыборПокупателя(Результат, ДополнительныеПараметры) Экспорт
	
	УстановитьВыбранногоКонтрагента(Результат, ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВыбранногоКонтрагента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Контрагент = Результат;
	Контрагент = Результат;
	ПродолжатьБезКарты = Истина;
	Если НЕ ТекущееДействие = "ОтправкаЧека" Тогда
		ТекущееДействие = "Поиск";
		ВыполнитьПоискКарты(СтрокаПоиска);
	КонецЕсли;
	ЗаполнитьФормуДаннымиКонтрагента();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКартыКлиентаСервераЛояльности(ВыбранноеОписаниеКарты, ШтрихкодОригинал,
		ЗапросНаБлокировку = Истина) Экспорт
	Если ВыбранноеОписаниеКарты.Свойство("Valid") Тогда
		Если НЕ ВыбранноеОписаниеКарты.Valid Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если ЗапросНаБлокировку И ВыбранноеОписаниеКарты.BonusData.BonusCount <= 0 Тогда
		ЗапросНаБлокировку = Ложь;
	КонецЕсли;
	ЗавершитьВводКартыЛояльностиПоШтрихкоду(ЗапросНаБлокировку);
	
КонецПроцедуры

&НаКлиенте
Процедура АвтоПодбор(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка, Пол = 0) Экспорт
	
	ТекстДляАвтоПодбора = СокрЛП(Текст);
	Если СтрДлина(ТекстДляАвтоПодбора) < 1 Тогда
		Возврат;
	КонецЕсли;

	ДанныеВыбора 			= Новый СписокЗначений;    
	ДанныеКлассификатора    = Новый Массив;
	ДанныеФИО  				= Новый Структура;
	
	ДанныеФИО.Вставить("Фамилия",       "");
	ДанныеФИО.Вставить("Имя",           "");
	ДанныеФИО.Вставить("Отчество",      "");
	ДанныеФИО.Вставить("Представление", Текст);
	
	ДанныеПредставления = СтрРазделить(ТРег(Текст), " ", Ложь);
	
	Если ДанныеПредставления.Количество() > 2 Тогда

		ДанныеФИО.Имя      = ДанныеПредставления[0];
		ДанныеФИО.Фамилия  = ДанныеПредставления[1];
		ДанныеФИО.Отчество = ДанныеПредставления[2];
		
		ВидДанных          = "Отчество";
		
	ИначеЕсли ДанныеПредставления.Количество() = 2 И Прав(Текст, 1) = " " Тогда

		ДанныеФИО.Имя      = ДанныеПредставления[0];
		ДанныеФИО.Фамилия  = ДанныеПредставления[1];
		
		ВидДанных          = "Отчество";
		
	ИначеЕсли ДанныеПредставления.Количество() = 2 Тогда

		ДанныеФИО.Имя      = ДанныеПредставления[0];
		ДанныеФИО.Фамилия  = ДанныеПредставления[1];
		
		ВидДанных          = "Фамилия";
		
	ИначеЕсли ДанныеПредставления.Количество() = 1 И Прав(Текст, 1) = " " Тогда

		ДанныеФИО.Имя  	   = ДанныеПредставления[0];
		ДанныеПредставления.Добавить("");
		
		ВидДанных          = "Фамилия";
		
	Иначе

		ВидДанных          = "Имя";
		ДанныеФИО.Имя  	   = ТРег(СокрЛП(Текст));
		
	КонецЕсли;
	

	МодульПодборФИОКлиент 	= ОбщегоНазначенияКлиент.ОбщийМодуль("ПодборФИОКлиент");
	ДанныеВидаДанных 		= МодульПодборФИОКлиент.Подобрать(ВидДанных, ДанныеФИО, 0);
	
	Для Каждого ЗначениеВидаДанных Из ДанныеВидаДанных Цикл
		ДанныеПредставления[ДанныеПредставления.Количество()-1] = ЗначениеВидаДанных;
		ДанныеКлассификатора.Добавить(СтрСоединить(ДанныеПредставления, " "));
	КонецЦикла;
	
	Для Каждого ЗначениеКлассификатора Из ДанныеКлассификатора Цикл
		ДанныеВыбора.Добавить(ЗначениеКлассификатора, ЗначениеКлассификатора);
	КонецЦикла;
	
	Если ДанныеВыбора.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
 
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента, ПараметрыДляОбработкиШтрихкода = Неопределено) Экспорт
	
	ТипыДанных = ОписанияТиповИскомыхДанных();
	
	Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
		
		РезультатЗапросаКарт = ЗапроситьКартыССервераЛояльности();
		ОбработатьПолучениеКартССервераЛояльности(РезультатЗапросаКарт);
	КонецЕсли;
	
	СтрокиДляОбработки = ТаблицаДанных.НайтиСтроки(Новый Структура("ОтметкаЗамена", Ложь));
	
	Если СтрокиДляОбработки.Количество() = 0 Тогда
		МассивКарт = Новый Массив;
		МассивПокупателей = Новый Массив;
		Для Каждого НайденныйЭлемент Из СтруктураПараметровКлиента.ЗначенияПоиска Цикл
			Если ТипыДанных.Покупатель.СодержитТип(ТипЗнч(НайденныйЭлемент.Владелец)) Тогда
				МассивПокупателей.Добавить(НайденныйЭлемент.Владелец);
			ИначеЕсли ТипыДанных.КартаЛояльности.СодержитТип(ТипЗнч(НайденныйЭлемент.Владелец))
				И ЗначениеЗаполнено(СтруктураПараметровКлиента.ПараметрыШтрихкода.ШтрихкодПоиска) Тогда
				МассивКарт.Добавить(НайденныйЭлемент.Владелец);
			КонецЕсли;
		КонецЦикла;
		ЗаполнитьДанныеТаблицыКарт(МассивКарт, МассивПокупателей);
		ОбновитьИтогиТаблицы();
		СтрокиДляОбработки = ТаблицаДанных.НайтиСтроки(Новый Структура("ОтметкаЗамена", Ложь));
	КонецЕсли;
	
	ПустойРезультат = СтрокиДляОбработки.Количество() = 0 И ЗначениеЗаполнено(Контрагент);
	
	Если ПустойРезультат Тогда
		ДобавитьЛокальнуюКартуКонтрагентаПриНеобходимости();
		СтрокиДляОбработки = ТаблицаДанных.НайтиСтроки(Новый Структура("ОтметкаЗамена", Ложь));
	КонецЕсли;

	Если СтрокиДляОбработки.Количество() = 0 Тогда
		БаннерОткрыт = Истина;
	ИначеЕсли СтрокиДляОбработки.Количество() = 1 Тогда
		СтрокаДанных = СтрокиДляОбработки[0];
		УстановитьОсновнуюКарту(СтрокаДанных);
		ЗаполнитьДанныеВыбраннойКарты(СтрокаДанных);
		ТекущееДействие = "Подтверждение";
	ИначеЕсли РежимКассыСамообслуживания Тогда
		СтрокаДанных = СтрокиДляОбработки[0];
		УстановитьОсновнуюКарту(СтрокиДляОбработки[0]);
		ЗаполнитьДанныеВыбраннойКарты(СтрокаДанных);
		ТекущееДействие = "Подтверждение";
	Иначе
		УстановитьОсновнуюКарту(СтрокиДляОбработки[0]);
		ТекущееДействие = "Поиск";
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВводШтрихкодаНайденаКарта(Результат, ЗапросДанныхБонусов = Истина) Экспорт
	
	ПереключитьНаСтраницуПоискаКарты();
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеВидаКарты(ИдентификаторВидаКарты) Экспорт
	ДанныеВидаКарты = Новый Структура;
	ДанныеВидаКарты.Вставить("Идентификатор", "");
	ДанныеВидаКарты.Вставить("Наименование", "");
	ДанныеВидаКарты.Вставить("ЭтоИменнаяКарта", Истина);
	ДанныеВидаКарты.Вставить("ГенерироватьНомер", Ложь);
	ДанныеВидаКарты.Вставить("ПрисваиватьНомерКартыКНомеруТелефона", Ложь);
	ДанныеВидаКарты.Вставить("ПредставлениеШаблона", "");
	ПараметрыПоиска = Новый Структура("Идентификатор", ИдентификаторВидаКарты);
	НайденныеВиды = ТаблицаВидыКарт.НайтиСтроки(ПараметрыПоиска);
	Если НайденныеВиды.Количество() <> 0 Тогда
		ЗаполнитьЗначенияСвойств(ДанныеВидаКарты, НайденныеВиды[0]);
	КонецЕсли;
	
	Возврат ДанныеВидаКарты;
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатПолученияСпискаВидовКарт(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыполнения.Свойство("ЕстьОшибки")
		И НЕ РезультатВыполнения.ЕстьОшибки Тогда
		СтрокаJSON = РезультатВыполнения.ДанныеОтвета;
		ДанныеОтвета = Неопределено;
		Если СтрокаJSON <> Неопределено Тогда
			СерверЛояльностиПолучательДанныхКлиентСервер.ОбработатьJSON(СтрокаJSON, ДанныеОтвета);
			Если ДанныеОтвета <> Неопределено И ТипЗнч(ДанныеОтвета) = Тип("Массив") Тогда
				Для каждого СтрокаМассива Из ДанныеОтвета Цикл
					ВидКарты = ТаблицаВидыКарт.Добавить();
					
					Если СтрокаМассива.Свойство("CardTypeID") Тогда
						ВидКарты.Идентификатор = СтрокаМассива.CardTypeID;
						ВидКарты.Наименование = СтрокаМассива.CardTypeDescription;
						ВидКарты.ЭтоИменнаяКарта = СтрокаМассива.IsPerson;
						Если СтрокаМассива.Свойство("GenerateNumer") Тогда
							ВидКарты.ГенерироватьНомер = СтрокаМассива.GenerateNumer;
						КонецЕсли;
						Если СтрокаМассива.Свойство("NumberToPhone") Тогда
							ВидКарты.ПрисваиватьНомерКартыКНомеруТелефона = СтрокаМассива.NumberToPhone;
						КонецЕсли;
						Если СтрокаМассива.Свойство("TemplateRepresentation") Тогда
							ВидКарты.ПредставлениеШаблона = СтрокаМассива.TemplateRepresentation;
						КонецЕсли;
						Если СтрокаМассива.Свойство("LengthRange") Тогда
							ВидКарты.НачалоДиапазона = СтрокаМассива.BeginRange;
							ВидКарты.КонецДиапазона = СтрокаМассива.EndRange;
							ВидКарты.ДлинаДиапазона = СтрокаМассива.LengthRange;
						КонецЕсли;
					Иначе
						ЗаполнитьЗначенияСвойств(ВидКарты, СтрокаМассива);
					КонецЕсли;
					
					Элементы.НоваяКартаВидКарты.СписокВыбора.Добавить(ВидКарты.Идентификатор, ВидКарты.Наименование);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		Элементы.НоваяКартаВидКарты.Доступность = Истина;
	КонецЕсли;
	
	Если ТаблицаВидыКарт.Количество() = 1 Тогда
		НоваяКартаВидКарты = ТаблицаВидыКарт[0].Идентификатор;
		ЗаполнитьНастройкиВидаКарты();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДанныеССервераЛояльности(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		РезультатВыполнения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
		УдалитьИзВременногоХранилища(Результат.АдресРезультата);
		ОтложенноеОповещение = Новый ОписаниеОповещения(ДополнительныеПараметры.ИмяОтложенногоМетода, ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(ОтложенноеОповещение, РезультатВыполнения);
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		
		ТекстПредупреждения = СтрШаблон("%1 %2",
			НСтр("ru = 'Не удалось установить досутпные типы карт: " + Символы.ПС + "%1'"),
				Результат.ПодробноеПредставлениеОшибки);
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(ТекстПредупреждения);
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ИнтерфейсРМКСлужебныйКлиент.ОткрытьФормуСообщенияОбОшибке(ЭтотОбъект, ПараметрыОткрытияОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораДанныхПоиска(Результат, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.СтруктураПараметровКлиента.Свойство("ВыборКонтрагента") Тогда
		
		ДанныеКартыКлиента = Результат.ЗначенияПоиска[0];
		
		Если ДанныеКартыКлиента.КартаНедействительна Тогда
			ШтрихкодУрезанный = СтрШаблон("%1%2", Лев(ДанныеКартыКлиента.НомерКарты, 25),
				?(СтрДлина(ДанныеКартыКлиента.НомерКарты) > 25, "...", ""));
			ОшибкаСервераЛояльности = СтрШаблон(НСтр("ru = 'Дисконтная карта недействительна: %1'"), ШтрихкодУрезанный);
			ПереключитьНаСтраницуСообщения();
		Иначе
			НайденнаяКарта = ТаблицаДанных.Добавить();
			НайденнаяКарта.ДисконтнаяКарта = ДанныеКартыКлиента.Карта;
			НайденнаяКарта.КодКарты = ДанныеКартыКлиента.НомерКарты;
			НайденнаяКарта.ПродажиОборот = ДанныеКартыКлиента.ПродажиОборот;
			НайденнаяКарта.ДатаРождения = ДанныеКартыКлиента.ДатаРождения;
			НайденнаяКарта.НомерТелефона = ДанныеКартыКлиента.НомерТелефона;
			НайденнаяКарта.ПокупательПочта = ДанныеКартыКлиента.ЭлектроннаяПочта;
			НайденнаяКарта.ПокупательФИО = ДанныеКартыКлиента.ФИО;
			НайденнаяКарта.Покупатель = ДанныеКартыКлиента.Контрагент;
			ЗапроситьЛокальныеДанныеКарты(НайденнаяКарта);
		КонецЕсли;
			
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОтменитьСозданиеКарты(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Закрыть();
КонецПроцедуры

#КонецОбласти


