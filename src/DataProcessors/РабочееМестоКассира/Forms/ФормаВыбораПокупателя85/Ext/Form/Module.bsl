&НаКлиенте
Процедура ЗаменитьНаСуществующуюКарту(Команда)
	РежимЗаменыКарты = Истина;
	
	СтрокиСОтметкой = ТаблицаДанных.НайтиСтроки(Новый Структура("Отметка", Истина));
	Для Каждого СтрокаНаЗамену Из СтрокиСОтметкой Цикл
		СтрокаНаЗамену.Отметка = Ложь;
		СтрокаНаЗамену.ОтметкаЗамена = Истина;
	КонецЦикла;
	СтрокиУдалить = Новый Массив;
	Для Каждого СтрокаУдалить Из ТаблицаДанных Цикл
		Если СтрокиСОтметкой.Найти(СтрокаУдалить) = Неопределено Тогда
			СтрокиУдалить.Добавить(СтрокаУдалить);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаУдалить Из СтрокиУдалить Цикл
		ТаблицаДанных.Удалить(СтрокаУдалить);
	КонецЦикла;
	ПереключитьНаСтраницуПоискаКарты();
	
КонецПроцедуры

