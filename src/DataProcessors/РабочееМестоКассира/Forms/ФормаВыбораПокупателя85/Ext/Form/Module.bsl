#Область ОписаниеПеременных

&НаКлиенте
Перем ЭлементВФокусе;

&НаКлиенте
Перем ТекстДатыРожденияСозданиеКарты;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗакрытьБезИзмененияФормы = Ложь;
	РежимКассыСамообслуживания = Ложь;
	ТекущаяНастройкаРМК = Параметры.ТекущаяНастройкаРМК;
	ЗаполнитьТекущуюНастройкуРМК();
	ИнтерфейсРМКСлужебный.ПрименитьНаФормеМасштабИзПараметров(ЭтотОбъект, Параметры);
	ЗапоминатьНомерКартыЛояльности = Параметры.ЗапоминатьНомерКартыЛояльности;
	РазрешитьЗаменуДисконтнойКарты = Параметры.РазрешитьЗаменуДисконтнойКарты И НЕ РежимКассыСамообслуживания;
	Контрагент = Параметры.Контрагент;
	Организация = Параметры.Организация;
	РазрешитьРедактированиеДисконтнойКарты = Ложь;
	ПродолжатьБезКарты = Параметры.ПродолжатьБезКарты;
	СуммаДокумента = Параметры.СуммаДокумента;
	ВключеноРедактировниеКарты = РазрешитьРедактированиеДисконтнойКарты И Параметры.РедактироватьКарту;
	ЭлектронныйЧек = Параметры.ЭлектронныйЧек;
	ПодключенаОблачнаяККТ = Параметры.ПодключенаОблачнаяККТ;
	ИспользоватьДисконтныеКарты = Параметры.ИспользоватьДисконтныеКарты;
	ТорговыйОбъект = Параметры.ТорговыйОбъект;
	Если Параметры.Свойство("ТаблицаВидыКарт")
		И Параметры.ТаблицаВидыКарт <> Неопределено
		И Параметры.ТаблицаВидыКарт.Количество() Тогда
		ТаблицаВидыКарт.Загрузить(Параметры.ТаблицаВидыКарт.Выгрузить());
		Для Каждого ОписаниеВидаКарт Из ТаблицаВидыКарт Цикл
			Элементы.НоваяКартаВидКарты.СписокВыбора.Добавить(ОписаниеВидаКарт.Идентификатор, ОписаниеВидаКарт.Наименование);
		КонецЦикла;
		Элементы.НоваяКартаВидКарты.Доступность = Истина;
	КонецЕсли;
	
	Если Параметры.ВидСоздаваемойКарты <> Неопределено 
		И Параметры.НомерСоздаваемойКарты <> Неопределено Тогда
		ТекущееДействие = "СозданиеКарты";
		НоваяКартаВидКарты = Параметры.ВидСоздаваемойКарты;
		НоваяКартаНомер = Параметры.НомерСоздаваемойКарты;
	ИначеЕсли ЗначениеЗаполнено(Параметры.ДисконтнаяКарта) Тогда
		ТекущееДействие = "Просмотр";
		МассивКарт = Новый Массив;
		МассивКарт.Добавить(Параметры.ДисконтнаяКарта);
		ЗаполнитьДанныеТаблицыКарт(МассивКарт);
		Если ТаблицаДанных.Количество() > 0 Тогда
			СтрокаКарты = ТаблицаДанных[0];
			Если Параметры.Свойство("ОстатокБалловНаКарте")Тогда
				СтрокаКарты.ОстатокБонусныхБаллов = Параметры.ОстатокБалловНаКарте;
			КонецЕсли;
			Если Параметры.Свойство("СуммаПродажПоКарте") Тогда
				СтрокаКарты.НайденнаяКартаСуммаПродаж = Параметры.СуммаПродажПоКарте;
			КонецЕсли;
			Если Параметры.Свойство("КурсБаллов") Тогда
				СтрокаКарты.КурсБонусов = Параметры.КурсБаллов;
			Иначе
				СтрокаКарты.КурсБонусов = 0;
			КонецЕсли;
		КонецЕсли;
		ЗакрытьБезИзмененияФормы = Истина;
		
		Если ОтправлятьSMSКодПриПродаже Тогда
			ПараметрыВводаКодаSMS = ПараметрыПроверкиПоSMSКоду();
			ПараметрыВводаКодаSMS.ВариантПроверки = "ПриПродаже";
			НомерТелефонаПодтвержден = Истина;		
			ОбновитьСостояниеПроверкиСМСНаФорме();
		КонецЕсли;
	ИначеЕсли Параметры.ПараметрыКартыЛояльности <> Неопределено Тогда
		ТекущееДействие = ?(РежимКассыСамообслуживания, "Просмотр", "Подтверждение");
		ДанныеИмеющейсяКарты = Параметры.ПараметрыКартыЛояльности;
		СтрокаКарты = ТаблицаДанных.Добавить();
		ЗаполнитьПараметрыСтрокиКартыПоДаннымРМК(СтрокаКарты, Параметры.ПараметрыКартыЛояльности);
		СтрокаКарты.ОстатокБонусныхБаллов = Параметры.ОстатокБалловНаКарте;
		СтрокаКарты.КурсБонусов = Параметры.КурсБаллов;
		СтрокаКарты.ОстатокБалловРуб = СтрокаКарты.ОстатокБонусныхБаллов * СтрокаКарты.КурсБонусов;
		ЗакрытьБезИзмененияФормы = Истина;
		Если ОтправлятьSMSКодПриПродаже Тогда
			ПараметрыВводаКодаSMS = ПараметрыПроверкиПоSMSКоду();
			ПараметрыВводаКодаSMS.ВариантПроверки = "ПриПродаже";
			НомерТелефонаПодтвержден = Истина;		
			ОбновитьСостояниеПроверкиСМСНаФорме();
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Параметры.ШтрхикодДляПоиска) Тогда
		ТекущееДействие = "Поиск";
		СтрокаПоиска = Параметры.ШтрхикодДляПоиска;
	ИначеЕсли ЗначениеЗаполнено(Параметры.Контрагент)
		И ИспользоватьДисконтныеКарты Тогда
		ТекущееДействие = "Поиск";
	ИначеЕсли НЕ ИспользоватьДисконтныеКарты
		И (ЭлектронныйЧек Или ПодключенаОблачнаяККТ) Тогда
		ТекущееДействие = "ОтправкаЧека";
	Иначе
		ТекущееДействие = "Поиск";
	КонецЕсли;
	Если Параметры.РежимВыбораКонтрагента Тогда
		РежимВыбораКонтрагента = Параметры.РежимВыбораКонтрагента;
		БаннерОткрыт = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаголовокФормы") Тогда
		НачальныйЗаголовокФормы = Параметры.ЗаголовокФормы;
	КонецЕсли;
	Если ТекущееДействие = "Просмотр" Тогда
		ИспользоватьЦифровуюКлавиатуру = Ложь;
	КонецЕсли;
	
	Если ИспользоватьЦифровуюКлавиатуру Тогда
		
		ВидыКлавиатуры = ИнтерфейсРМКСлужебный.ВидыЦифровойКлавиатуры();
		ПараметрыПостроения = Новый Структура();
		ПараметрыПостроения.Вставить("ВидКлавиатуры", ВидыКлавиатуры.Стандартный);
		ПараметрыПостроения.Вставить("ИнтервалМеждуКлавишамиГоризонтальный", ИнтервалМеждуЭлементамиФормы.Одинарный);
		ПараметрыПостроения.Вставить("ИнтервалМеждуКлавишамиВертикальный", ИнтервалМеждуЭлементамиФормы.Половинный);
		ПараметрыПостроения.Вставить("РастягиватьПоШирине", Истина);
		ПараметрыПостроения.Вставить("ЦветКнопок", ИнтерфейсРМКСлужебный.ЦветУправляющейКнопки(Истина));
		
		ТекстОшибки = ИнтерфейсРМКСлужебный.ПостроитьПанельЦифровойКлавиатуры(ЭтотОбъект, Элементы.ГруппаЦифроваяПанель,
			ПараметрыПостроения);
			
		Если ТекстОшибки = "" Тогда
			Элементы.ПоискСтраницы.Видимость = Ложь;
			Элементы.ЗапятаяУниверсальнаяКлавиатура.Доступность = Не РежимКассыСамообслуживания;
		Иначе
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	
	ЦветаФормы = ОбщегоНазначенияРМК.ЦветаФормыРМК();

	ЗаголовокКнопкиДействия = НСтр("ru = 'Выбрать карту'");
	НастроитьТиповыеГорячиеКлавиши();
	НастроитьГорячиеКлавиши();
	ОбщегоНазначенияРМК.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);

	НоваяКартаКодСтраны = "+7";
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.КонтактнаяИнформация") Тогда
		МодульРасширенныйВводКонтактнойИнформации = ОбщегоНазначения.ОбщийМодуль("Обработки.РасширенныйВводКонтактнойИнформации");
		ПодсказкиПриВводеТелефона = МодульРасширенныйВводКонтактнойИнформации.ПодсказкиПриВводеТелефона();
		НоваяКартаКодСтраны = ПодсказкиПриВводеТелефона.КодСтраны;	
	КонецЕсли;
	
	ЗаполнитьПервоначальныеДанныеЛокально();
	НастроитьКомандыВРежимеКассыСамообслуживания();
	
	БезЗаменяемыхКарт = Новый ФиксированнаяСтруктура("ОтметкаЗамена", Ложь);
	Элементы.ТаблицаДанных.ОтборСтрок = БезЗаменяемыхКарт;
	
	АдаптацияТакси();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыСтрокиКартыПоДаннымРМК(СтрокаКарты, ДанныеРМК)
	ЗаполнитьЗначенияСвойств(СтрокаКарты, ДанныеРМК);
	СтрокаКарты.ПокупательФИО = ДанныеРМК.ФИО;
	СтрокаКарты.ПокупательПочта = ДанныеРМК.АдресЭПВладельцаКарты;
	СтрокаКарты.ДатаРождения = ДанныеРМК.ДатаРождения;
	СтрокаКарты.НомерТелефона = ДанныеРМК.НомерТелефонаВладельцаКарты;
	СтрокаКарты.ПродажиОборот = ДанныеРМК.СуммаПродаж;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если (ТекущееДействие = "Подтверждение" Или ТекущееДействие = "Просмотр")
		И ТаблицаДанных.Количество() = 1 Тогда
		СтрокаТаблицы = ТаблицаДанных.Получить(0);
		ЗаполнитьДанныеВыбраннойКарты(СтрокаТаблицы);
		НастроитьЭлементыФормыКлиент();
	ИначеЕсли ТекущееДействие = "ОтправкаЧека" Тогда
		НастроитьЭлементыФормыКлиент();
	ИначеЕсли ЗначениеЗаполнено(Контрагент) Тогда
		ТекущееДействие = "Поиск";
		УстановитьВыбранногоКонтрагента(Контрагент, Неопределено);
	Иначе
		ПереключитьНаСтраницуПоискаКарты();
		ЗаполнитьНастройкиВидаКарты();
	КонецЕсли;
	
	ОбновитьМаскуВводаНомераТелефона();
	Если ИспользоватьЦифровуюКлавиатуру Тогда
		Элементы.ЗапятаяУниверсальнаяКлавиатура.Заголовок = ИнтерфейсРМКСлужебныйКлиент.ПолучитьСимволЗвездочка();
	КонецЕсли;
	
	Если ИспользоватьСерверЛояльностиПолучательДанных 
		И ТаблицаВидыКарт.Количество() = 0 Тогда
		ЗаполнитьПервоначальныеДанныеСерверЛояльности();
	ИначеЕсли ТаблицаВидыКарт.Количество() = 1 Тогда		
		НоваяКартаВидКарты = ТаблицаВидыКарт[0].Идентификатор;
		ЗаполнитьНастройкиВидаКарты();
	КонецЕсли;
	
	Если ТекущееДействие = "Поиск"
		И ЗначениеЗаполнено(СтрокаПоиска) Тогда
		ВыполнитьПоискКарты(СтрокаПоиска);
	КонецЕсли;
	

	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ПодключаемоеОборудование" Тогда
		
		Если ИмяСобытия = "ScanData" Тогда
			
			Штрихкод = ?(Параметр[1] = Неопределено, Параметр[0], Параметр[1][1]);
			Если ТекущееДействие = "СозданиеКарты" Тогда
				НоваяКартаНомер = Штрихкод;
			ИначеЕсли ПоискДоступен() Тогда
				СтрокаПоиска = Штрихкод;
				ВыполнитьПоискКарты(Штрихкод);
			КонецЕсли;
			
		ИначеЕсли ИмяСобытия = "ScanDataBase64" Тогда
			
			ШтрихкодBase64 = ?(Параметр[1] = Неопределено, Параметр[0], Параметр[1][1]);
			МенеджерОборудованияРМККлиентСервер.Base64ВШтрихкод(ШтрихкодBase64, Штрихкод);
			Если ТекущееДействие = "СозданиеКарты" Тогда
				НоваяКартаНомер = Штрихкод;
			ИначеЕсли ПоискДоступен() Тогда
				СтрокаПоиска = Штрихкод;
				ВыполнитьПоискКарты(Штрихкод);
			КонецЕсли;
			
		ИначеЕсли ИмяСобытия = "TracksData" И ИспользуетсяСчитывательМагнитныхКарт Тогда
			Если ТекущееДействие = "СозданиеКарты" Тогда
				НоваяКартаНомер = Параметр[0];
			ИначеЕсли ПоискДоступен() Тогда
				СтрокаПоиска = Параметр[0];
				ВыполнитьПоискКарты(СтрокаПоиска);
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
				
	Иначе
		
		ОбработатьОповещениеНаСервере = Ложь;
		ОбщегоНазначенияРМККлиентПереопределяемый.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник,
			ОбработатьОповещениеНаСервере);
		
		Если ОбработатьОповещениеНаСервере Тогда
			ОбработкаОповещенияНаСервере(ИмяСобытия, Параметр, Источник);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если ОбщегоНазначенияРМККлиент.ИспользоватьВнешнееСобытие() И ПоискДоступен() Тогда
		
		Если Событие = "Штрихкод" Или Событие = "ПолученШтрихкод" Или Событие = "ScanData" Тогда
			ВыполнитьПоискКарты(Данные);
		ИначеЕсли Событие = "TracksData" Или Событие = "ДанныеКарты" Тогда
			ВыполнитьПоискКарты(Данные);
		Иначе
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НоваяКартаВидКартыПриИзменении(Элемент)
	ЗаполнитьНастройкиВидаКарты();
	НастроитьЭлементыФормыКлиент();
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаВидКартыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбработатьПотерюФокусаДатыРождения();
	ЭлементВФокусе = Элемент;
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаНомерАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	СменитьЭлементВводаДанныхПокупателя(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаТелефонАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	СменитьЭлементВводаДанныхПокупателя(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаФИОАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если Не НеИспользоватьПодборФИО 
		И ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.ПодборФИО") Тогда
		АвтоПодбор(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
	КонецЕсли;

	ОбработатьПотерюФокусаДатыРождения();
	ЭлементВФокусе = Элемент;
	
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаПочтаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ОбработатьПотерюФокусаДатыРождения();
	ЭлементВФокусе = Элемент;
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаДатаРожденияАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	СменитьЭлементВводаДанныхПокупателя(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НайденнаяКартаВидКартыПриИзменении(Элемент)
	ЗаполнитьНастройкиВидаКарты();
КонецПроцедуры

&НаКлиенте
Процедура НайденнаяКартаВидКартыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбработатьПотерюФокусаДатыРождения();
	ЭлементВФокусе = Элемент;
КонецПроцедуры

&НаКлиенте
Процедура НайденнаяКартаНомерАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	СменитьЭлементВводаДанныхПокупателя(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НайденнаяКартаТелефонАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	СменитьЭлементВводаДанныхПокупателя(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НайденнаяКартаФИОАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

	Если Не НеИспользоватьПодборФИО 
		И ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.ПодборФИО") Тогда
		АвтоПодбор(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
	КонецЕсли;

	ОбработатьПотерюФокусаДатыРождения();
	ЭлементВФокусе = Элемент;
	
КонецПроцедуры

&НаКлиенте
Процедура НайденнаяКартаПочтаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ОбработатьПотерюФокусаДатыРождения();
	ЭлементВФокусе = Элемент;
КонецПроцедуры

&НаКлиенте
Процедура НайденнаяКартаДатаРожденияАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	СменитьЭлементВводаДанныхПокупателя(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура СогласиеПолученоПриИзменении(Элемент)
	НастроитьЭлементыФормыКлиент();
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)
	
	ПоискВыполнен = Ложь;
	Если НЕ РежимВыбораКонтрагента
		И НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ЗакрытьБаннерПриНеобходимости();
	КонецЕсли;
	НастроитьЭлементыФормыКлиент();
КонецПроцедуры

&НаКлиенте
Процедура НайденнаяКартаКодПодтвержденияИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ПроверитьВведенныйКодПроверки(Текст)
КонецПроцедуры

&НаКлиенте
Процедура НайденнаяКартаДатаРожденияИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ДатаРожденияИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаКодПодтвержденияВведенныйИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ПроверитьВведенныйКодПроверки(Текст)
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаДатаРожденияИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ДатаРожденияИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура КодПроверкиИзSMSНайденнойКартыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СформироватьСообщениеИОтправитьSMS();
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаТелефонНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ЗначениеДляВставки = ИнтерфейсРМКСлужебныйКлиентСервер.ТолькоЦифры(СтрокаПоиска);
	Если Лев(ЗначениеДляВставки, 1) = "7" Тогда
		ЗначениеДляВставки = Прав(ЗначениеДляВставки, СтрДлина(ЗначениеДляВставки) - 1);
	КонецЕсли;
	
	ВставитьСимволыВРедактируемоеПоле(Элемент, ЗначениеДляВставки);
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаФИОНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ЗначениеДляВставки = СтрокаПоиска;
	ИнтерфейсРМКСлужебныйКлиент.ВставитьСимволыВРедактируемоеПоле(ЭтотОбъект, Элемент,
		ЗначениеДляВставки);
	Если Не НеИспользоватьПодборФИО 
		И ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.ПодборФИО") Тогда
		АвтоПодбор(Элемент, НоваяКартаФИО, ДанныеВыбора, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ЭлементВФокусе = Элемент;
	Если ПоискВыполнен Тогда
		ПоискВыполнен = Ложь;
		ЗакрытьБаннерПриНеобходимости();
		НастроитьЭлементыФормыКлиент();
		СтрокаПоиска = Текст;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаНомерНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ЗначениеДляВставки = ИнтерфейсРМКСлужебныйКлиентСервер.ТолькоЦифры(СтрокаПоиска);
	
	ИнтерфейсРМКСлужебныйКлиент.ВставитьСимволыВРедактируемоеПоле(ЭтотОбъект, Элемент,
		ЗначениеДляВставки);
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	Если ТребуетсяНастройкаКнопокЦифровойПанели(Текст) И ИспользоватьЦифровуюКлавиатуру Тогда
		НастроитьКнопкиЦифровойПанели(Текст);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаНомерПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(НоваяКартаВидКарты) Тогда
		ВидКартыЗаполнен = Ложь;
		ЗаполнитьВидКарты(НоваяКартаНомер, ВидКартыЗаполнен);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьБаннерНажатие(Элемент)
	БаннерОткрыт = Ложь;
	НастроитьЭлементыФормыКлиент();
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЧекаТелефонАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	СменитьЭлементВводаДанныхПокупателя(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаЧекаПочтаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	СменитьЭлементВводаДанныхПокупателя(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОтправитьСМСНажатие(Элемент)
	СформироватьСообщениеИОтправитьSMS();
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаДанных

&НаКлиенте
Процедура ТаблицаДанныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ОбработатьВыборСтроки(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДанныхПриИзмененииСоставаВыделенныхСтрок(Элемент)
	
	ВыделенныеСтроки = Элементы.ТаблицаДанных.ПолучитьСтрокиДляОбработки();
	Если ВыделенныеСтроки = Неопределено Тогда
		ВыделенныеСтроки = Новый Массив;
	КонецЕсли;
	ВыделенаКартаНачисления = Ложь;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		СтрокаДанных = ТаблицаДанных.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если СтрокаДанных.Отметка Тогда
			ВыделенаКартаНачисления = Истина;
		КонецЕсли;
	КонецЦикла;
	ОбъединениеДоступно = ОдинВладелец 
		И ВыделенныеСтроки.Количество() > 1
		И ВыделенаКартаНачисления;
	Элементы.ТаблицаДанныхОбъединитьИВыбрать.Видимость = ОбъединениеДоступно;
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоискНаСервереЛояльности(Команда)
	
	ВыполнитьПоискКарты(СтрокаПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКарту(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаДанных.ТекущиеДанные;
	
	Если Не ОдинВладелец Тогда
		ОбработатьВыборСтроки(ТекущиеДанные);
		Возврат;
	КонецЕсли;
	
	СтрокиТаблицы = ТаблицаДанных.НайтиСтроки(Новый Структура("Отметка", Истина));
	Если СтрокиТаблицы.Количество() > 0 Тогда
		СтрокаНачисления = СтрокиТаблицы[0];
	КонецЕсли;
	
	Если НЕ СтрокаНачисления = ТекущиеДанные
		И ИспользоватьОплатуБонусами Тогда
		ОбработатьВыборСтроки(СтрокаНачисления, ТекущиеДанные);
	Иначе
		ОбработатьВыборСтроки(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Объединить(Команда)
	
	ВыполнитьОбъединение();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбъединение(СтрокиДляОбработки = Неопределено)
	
	Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
		ОбъединитьДисконтныеКартыСерверЛояльности(СтрокиДляОбработки);
	Иначе
		СтруктураОтвета = Новый Структура("Error, ErrorMessage", Ложь, "");
		ОбъединитьДисконтныеКартыЛокально(СтруктураОтвета);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьНаНовуюКарту(Команда)
	РежимЗаменыКарты = Истина;
	СтрокиУдалить = Новый Массив;
	Для Каждого СуществующиеСтрока Из ТаблицаДанных Цикл
		Если СуществующиеСтрока.Отметка Тогда
			СуществующиеСтрока.Отметка = Ложь;
		Иначе
			СтрокиУдалить.Добавить(СуществующиеСтрока);
		КонецЕсли;
	КонецЦикла;
	НоваяКартаДатаРождения = НайденнаяКартаДатаРождения;
	МаскаТелефона = ИнтерфейсРМКСлужебныйКлиентСервер.МаскаВводаТелефона();
	Телефон = ИнтерфейсРМКСлужебныйКлиентСервер.ПривестиЗначениеКМаскеТелефона(НайденнаяКартаТелефон,
				МаскаТелефона);
	НоваяКартаТелефон = Телефон;
	НоваяКартаПочта = НайденнаяКартаПочта;
	НоваяКартаФИО = НайденнаяКартаФИО;
	
	ПереключитьНаСтраницуСозданияКарты();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКартуНачисления(Команда)
 	УстановитьОсновнуюКарту();
КонецПроцедуры

&НаКлиенте
Процедура ВыборКонтрагента(Команда)
	ОткрытьФормуВыбораКонтрагента();
КонецПроцедуры

&НаКлиенте
Процедура ПечатьСогласияНаОбработкуПД(Команда) 
	
	ТабличныйДокументСогласиеПД = ПолучитьТабличныйДокументСогласияПДНаСервере();
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("ПереданныйТабличныйДокумент", ТабличныйДокументСогласиеПД);
	ПараметрыОткрытия.Вставить("ПредставлениеДокумента", НСтр("ru = 'Согласие на обработку персональных данных'"));
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаПечатногоДокумента", 
		ПараметрыОткрытия, ЭтотОбъект, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТекущееДействие(Команда)
	ВыполнитьДействиеГлавнойКоманды();
КонецПроцедуры
	
&НаКлиенте
Процедура ПерейтиКСозданиюКарты(Команда)
	ПереключитьНаСтраницуСозданияКарты();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьSMSСКодомПроверки(Команда)
	СформироватьСообщениеИОтправитьSMS();
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	Если ТекущееДействие = "СозданиеКарты" Тогда
		Если ТекущийШагСозданияКарты <= 0 Тогда
			ПереключитьНаСтраницуПоискаКарты();
		Иначе
			ТекущийШагСозданияКарты = Макс(ТекущийШагСозданияКарты - 1, 0);
		КонецЕсли;
	Иначе
		ОчиститьДанныеКарты();
		ПереключитьНаСтраницуПоискаКарты();
	КонецЕсли;
	БаннерОткрыт = Ложь;
	ЭлементВФокусе = Неопределено;
	НастроитьЭлементыФормыКлиент();
КонецПроцедуры

&НаКлиенте
Процедура КнопкаОтменить(Команда)
	Если ЭлектронныйЧек Или ПодключенаОблачнаяККТ Тогда
		ТекущееДействие = "ОтправкаЧека";
		НастроитьЭлементыФормыКлиент();
	Иначе
		ВернутьРезультатОтказаОтВвода();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВернутьРезультатОтказаОтВвода()
	Результат = Новый Структура("ОтказОтВводаКарты, Контрагент", Истина, Контрагент);
	Закрыть(Результат);
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьКарту(Команда)
	ВключеноРедактировниеКарты = Истина;
	НастроитьЭлементыФормыКлиент();
КонецПроцедуры

#Область ЦифроваяКлавиатура

&НаКлиенте
Процедура Подключаемый_ЦифраУниверсальнаяКлавиатура(Команда)
	ОбработатьЦифруЦифровойКлавиатуры(Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОчиститьУниверсальнаяКлавиатура(Команда)
	ОбработатьКомандуЦифровойКлавиатурыОчистить();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УдалитьПоследнееУниверсальнаяКлавиатура(Команда)
	ОбработатьКомандуЦифровойКлавиатурыУдалитьПоследнее();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДваНуляУниверсальнаяКлавиатура(Команда)
	ОбработатьКомандуДваНуляЦифровойКлавиатуры();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗапятаяУниверсальнаяКлавиатура(Команда)
	ОбработатьКомандуЦифровойКлавиатурыЗвездочкаЗапятая();
КонецПроцедуры

&НаКлиенте
Процедура ПоискУниверсальнаяКлавиатура(Команда)
	ВыполнитьПоискКарты(СтрокаПоиска);
КонецПроцедуры


&НаКлиенте
Процедура ГорячаяКлавишаEnter(Команда)
	
	ОбработатьГорячуюКлавишуEnter();
	
КонецПроцедуры

