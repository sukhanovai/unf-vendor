#Область ОтправкаЧека
&НаКлиенте
Процедура ЗаполнитьРезультатОтправкаЧека(ХочуБумажныйЧек = Ложь)
	
	Если ЗначениеЗаполнено(ОтправкаЧекаТелефон) Тогда
		МаскаТелефона = ИнтерфейсРМКСлужебныйКлиентСервер.МаскаВводаТелефона();
		ДлинаМаски = СтрДлина(МаскаТелефона);
		ДлинаВведенногоНомера = СтрДлина(СокрЛП(ОтправкаЧекаТелефон));
		Если ДлинаМаски <> ДлинаВведенногоНомера Тогда
			Если ХочуБумажныйЧек Тогда
				ОтправкаЧекаТелефон = "";
			Иначе
				ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(НСтр("ru = 'Проверьте корректность введенного номера телефона.'"));
				ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
				ИнтерфейсРМКСлужебныйКлиент.ОткрытьФормуСообщенияОбОшибке(ЭтотОбъект, ПараметрыОткрытияОшибки);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтправкаЧекаПочта)
		И НЕ ЗначениеЗаполнено(ОтправкаЧекаТелефон)
		И НЕ ХочуБумажныйЧек Тогда
		ПараметрыОткрытияОшибки = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПараметрыОшибки(НСтр("ru = 'Не заполнены данные для отправки'"));
		ПараметрыОткрытияОшибки.ЭтоПредупреждение = Истина;
		ИнтерфейсРМКСлужебныйКлиент.ОткрытьФормуСообщенияОбОшибке(ЭтотОбъект, ПараметрыОткрытияОшибки);
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ОтправкаЧекаПочта", ОтправкаЧекаПочта);
	Результат.Вставить("ОтправкаЧекаТелефон", ОтправкаЧекаТелефон);
	Результат.Вставить("ХочуБумажныйЧек", ХочуБумажныйЧек);
	
	Закрыть(Результат);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура НастроитьГорячиеКлавиши()
	
	Если РежимКассыСамообслуживания Или НЕ ЗначениеЗаполнено(ТекущаяНастройкаРМК) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Команда Из ТекущаяНастройкаРМК.ГорячиеКлавиши Цикл
		
		КомандаНаФорме = Элементы.Найти(Команда.ИмяКнопки);
		Если НЕ КомандаНаФорме = Неопределено Тогда
			
			СочетаниеКлавиш = Новый СочетаниеКлавиш(Клавиша[Команда.Клавиша],
				Команда.АкселераторAlt,
				Команда.АкселераторCtrl,
				Команда.АкселераторShift);
			
			КомандаНаФорме.СочетаниеКлавиш = СочетаниеКлавиш;
		КонецЕсли;
		
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьКомандыВРежимеКассыСамообслуживания()
	
	Если РежимКассыСамообслуживания Тогда
		ЭтотОбъект.ОтображатьКоманднуюПанель = Ложь;
		Элементы.ВыборКонтрагента.Видимость = Ложь;
		Элементы.СоздатьКарту.Видимость = Ложь;
		
		Элементы.КомандыФормы.Высота = 3;
		Элементы.КомандыФормы.РастягиватьПоВертикали = Ложь;
		Для Каждого ЭлементГруппы Из Элементы.КомандыФормы.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(ЭлементГруппы) = Тип("КнопкаФормы") Тогда
				ЭлементГруппы.РастягиватьПоВертикали = Истина;
			КонецЕсли;
		КонецЦикла;
		Элементы.ГруппаНайденнойКартыФИО.Видимость = Ложь;
		Элементы.ГруппаНайденнойКартыДатаРождения.Видимость = Ложь;
		Элементы.ГруппаНайденнойКартыПочта.Видимость = Ложь;
		Элементы.ГруппаДанныеНайденнойКартыСтатистикаПраво.Видимость = Ложь;
		Элементы.СтраницаСоздания.Видимость = Ложь;
		Элементы.СтраницаВыбора.Видимость = Ложь;
		Элементы.СтрокаПоиска.ПодсказкаВвода = НСтр("ru = 'Телефон, номер карты'");
		ЭтотОбъект.ОтображатьКнопкуЗакрытия = Ложь;
		Если ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85() Тогда
			ЭтотОбъект.ОтображатьЗаголовок = Ложь;
			Элементы.ЗаголовокФормы.Видимость = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементаФормы(Элемент, Видимость)
	Элемент.Видимость = Видимость;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементаФормы(Элемент, Доступность)
