&НаКлиенте
Процедура ЗакрытьСПараметрами()
	
	Результат = Новый Структура;
	Результат.Вставить("ОпросЗавершен", ОпросЗавершен);
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКИИЗакрыть()
	
	КонтактнаяИнформация = КонтактнаяИнформацияПользователя();
	Если КонтактнаяИнформация <> Неопределено Тогда
		ОтправитьКИ(КонтактнаяИнформация);
	КонецЕсли;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Функция КонтактнаяИнформацияПользователя()
	
	КонтактнаяИнформация = Новый Структура;
	Если Не ЗначениеЗаполнено(КонтактТелефон) И Не ЗначениеЗаполнено(КонтактЭлектроннаяПочта) Тогда
		Возврат Неопределено;
	Иначе
		КонтактнаяИнформация.Вставить("Имя", КонтактИмя);
		КонтактнаяИнформация.Вставить("Телефон", КонтактТелефон);
		КонтактнаяИнформация.Вставить("ЭлектроннаяПочта", КонтактЭлектроннаяПочта);
		Возврат КонтактнаяИнформация;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОтправитьКИ(КонтактнаяИнформация)
	
	ОбратнаяСвязь.ОпросНачалоРаботыОтправитьКонтактнуюИнформацию(КонтактнаяИнформация);
	
КонецПроцедуры

#КонецОбласти