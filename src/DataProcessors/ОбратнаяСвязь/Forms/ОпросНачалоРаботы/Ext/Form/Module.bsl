
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдаптацияТакси();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоЗакрытие Тогда
		Отказ = Истина;
		ЭтоЗакрытие = Истина;
		ПодключитьОбработчикОжидания("ЗакрытьСПараметрами", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Вопрос10ПриИзменении(Элемент)
	
	Вопрос10 = Число(Вопрос10Строкой);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Назад(Команда)
	
	НомерСтраницы = НомерСтраницы - 1;
	УстановитьСтраницу(НомерСтраницы);
	
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	НомерСтраницыОтправить = 2;
	НомерСтраницыГотово = 3;
	
	Если НомерСтраницы = 1 И Вопрос10 = 0 Тогда
		Ошибки = Неопределено;
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
		Ошибки, "Вопрос10", НСтр("ru ='Не выбран вариант ответа оценки интерфейса'"), "");
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
		Возврат;
	КонецЕсли;
	
	Если НомерСтраницы = НомерСтраницыОтправить Тогда
		ОтправитьОпрос();
		ОпросЗавершен = Истина;
	ИначеЕсли НомерСтраницы = НомерСтраницыГотово Тогда
		ОтправитьКИИЗакрыть();
		Возврат;
	КонецЕсли;
	
	НомерСтраницы = НомерСтраницы + 1;
	УстановитьСтраницу(НомерСтраницы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура АдаптацияТакси()
	
	ЭтоТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	Если Не ЭтоТакси Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Вопрос10.Ширина = 46;
	Элементы.ДекорацияВопрос1.Шрифт = ШрифтыСтиля.ЗаголовокЧетвертогоУровня;
	Элементы.ДекорацияВопрос2.Шрифт = ШрифтыСтиля.ЗаголовокЧетвертогоУровня;
	Элементы.ДекорацияВопрос3.Шрифт = ШрифтыСтиля.ЗаголовокЧетвертогоУровня;
	Элементы.ДекорацияВопрос4.Шрифт = ШрифтыСтиля.ЗаголовокЧетвертогоУровня;

КонецПроцедуры

&НаСервере
Процедура УстановитьСтраницу(НомерСтраницы)

	Если НомерСтраницы = 0 Тогда
		Элементы.ФормаНазад.Видимость = Ложь;
	ИначеЕсли НомерСтраницы = 1 Тогда
		Элементы.ФормаДалее.Заголовок = НСтр("ru = 'Далее'");
		Элементы.ФормаДалее.Отображение = ОтображениеКнопки.КартинкаИТекст;
		Элементы.ФормаНазад.Видимость = Истина;
	ИначеЕсли НомерСтраницы = 2 Тогда
		Элементы.ФормаДалее.Заголовок = НСтр("ru = 'Отправить'");
		Элементы.ФормаДалее.Отображение = ОтображениеКнопки.Текст;
	ИначеЕсли НомерСтраницы = 3 Тогда
		Элементы.ФормаДалее.Заголовок = НСтр("ru = 'Готово'");
		Элементы.ФормаДалее.Отображение = ОтображениеКнопки.Текст;
		Элементы.ФормаНазад.Видимость = Ложь;
	КонецЕсли;
	
	ШаблонИмяСтраницы = "Страница%1";
	ИмяСтраницы = СтрШаблон(ШаблонИмяСтраницы, НомерСтраницы + 1);
	Элементы.Страницы.ТекущаяСтраница = Элементы[ИмяСтраницы];
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОпрос()
	
	РезультатОпроса = СформироватьРезультатОпроса();
	ОтправитьРезультатОпроса(РезультатОпроса);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтправитьРезультатОпроса(РезультатОпроса)
	
	ОбратнаяСвязь.ОпросНачалоРаботыОтправитьДанные(РезультатОпроса);
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьРезультатОпроса()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ПолноеИмяФормы", "ВсеФормы");
	Результат.Вставить("Событие", "НачалоРаботы");
	Результат.Вставить("ИдентификаторОпроса", "90ab5b6f-a1e9-46c4-a2e2-27574038a441");
	
	РезультатВопрос1 = Новый Структура;
	РезультатВопрос1.Вставить("ТекстВопроса", Элементы.ГруппаОценкаВопрос1.Заголовок);
	РезультатВопрос1.Вставить("Ответ", Вопрос1);
	Результат.Вставить("Вопрос1", РезультатВопрос1);
	
	РезультатВопрос2 = Новый Структура;
