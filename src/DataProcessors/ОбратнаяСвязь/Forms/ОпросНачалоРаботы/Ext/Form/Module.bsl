	РезультатВопрос5 = Новый Структура;
	РезультатВопрос5.Вставить("ТекстВопроса", Элементы.ДекорацияПриветствие2.Заголовок);
	РезультатВопрос5.Вставить("Ответ", СоставОтвета5);
	Результат.Вставить("Вопрос5", РезультатВопрос5);
	
	РезультатВопрос6 = Новый Структура;
	РезультатВопрос6.Вставить("ТекстВопроса", Элементы.Вопрос10.Заголовок);
	РезультатВопрос6.Вставить("Ответ", Вопрос10);
	Результат.Вставить("Вопрос6", РезультатВопрос6);
	
	РезультатВопрос7 = Новый Структура;
	РезультатВопрос7.Вставить("ТекстВопроса", Элементы.ГруппаОценкаВопрос11.Заголовок);
	РезультатВопрос7.Вставить("Ответ", Вопрос11);
