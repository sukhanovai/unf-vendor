	РезультатВопрос3.Вставить("Ответ", Вопрос3);
	Результат.Вставить("Вопрос3", РезультатВопрос3);
	
	РезультатВопрос4 = Новый Структура;
	РезультатВопрос4.Вставить("ТекстВопроса", Элементы.ГруппаОценкаВопрос4.Заголовок);
	РезультатВопрос4.Вставить("Ответ", Вопрос4);
	Результат.Вставить("Вопрос4", РезультатВопрос4);
	
	СоставОтвета5 = Новый Структура;
	СоставОтвета5.Вставить("Ответ51", Вопрос5);
	СоставОтвета5.Вставить("Ответ52", Вопрос6);
	СоставОтвета5.Вставить("Ответ53", Вопрос7);
	СоставОтвета5.Вставить("Ответ54", Вопрос8);
