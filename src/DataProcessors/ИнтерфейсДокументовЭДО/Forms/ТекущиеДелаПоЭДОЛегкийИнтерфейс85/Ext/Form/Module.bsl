&НаКлиенте
Процедура ВидимостьЭлементовИКоманд()
	
	ТекущиеДанные = Неопределено;
		
	Если ТекущийРаздел = РазделыПанелиНавигации().ВходящиеЭлектронныеДокументы Тогда
		
		ТекущиеДанные = Элементы.ВходящиеЭлектронныеДокументы.ТекущиеДанные;
		
	ИначеЕсли ТекущийРаздел = РазделыПанелиНавигации().ИсходящиеЭлектронныеДокументы Тогда
		
		ТекущиеДанные = Элементы.ИсходящиеЭлектронныеДокументы.ТекущиеДанные;
		
	ИначеЕсли ТекущийРаздел = РазделыПанелиНавигации().Сформировать Тогда
		
		ТекущиеДанные = Элементы.Сформировать.ТекущиеДанные;
		
	ИначеЕсли ТекущийРаздел = РазделыПанелиНавигации().Приглашения Тогда
		
		ТекущиеДанные = Неопределено;
		
	ИначеЕсли ТекущийРаздел = РазделыПанелиНавигации().Ошибки Тогда
		
		ТекущиеДанные = Неопределено;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	НастроитьВидимостьКомандТекущейСтроки(ТекущиеДанные);
	ОбновитьОтображениеФильтров();
	
КонецПроцедуры

