&НаСервереБезКонтекста
Функция ВыполнениеДействийПоЭДОДоступноДляПакетов(Знач ПакетыДокументов)

	Результат = Истина;
	
	Для Каждого ИдентификаторПакета Из ПакетыДокументов Цикл
		СостоянияДокументовПакета = ПакетыДокументовЭДО.СостоянияДокументовПакета(ИдентификаторПакета);
		СостояниеПакета = ПакетыДокументовЭДО.СостояниеПакета(СостоянияДокументовПакета);
		Если Не ЗначениеЗаполнено(СостояниеПакета) Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция АннулированиеДоступноДляПакетов(ПакетыДокументов)

	Результат = Новый Структура("Результат, ТекстОшибки", Истина, "");
	
	ТекстыОшибок = Новый Массив;
	
	Для Каждого ИдентификаторПакета Из ПакетыДокументов Цикл
		СостоянияДокументовПакета = ПакетыДокументовЭДО.СостоянияДокументовПакета(ИдентификаторПакета);
		СостояниеПакета = ПакетыДокументовЭДО.СостояниеПакета(СостоянияДокументовПакета);
		Если Не АннулированиеДоступно(Неопределено, СостояниеПакета) Тогда
			Результат.Результат = Ложь;
			ТекстыОшибок.Добавить(СтрШаблон(
				НСтр("ru = 'Аннулирование пакета ""%1"" недоступно при состоянии ЭДО ""%2""'") + Символы.ПС,
				Строка(ИдентификаторПакета), Строка(СостояниеПакета)));
		КонецЕсли;
	КонецЦикла;
	
	Результат.ТекстОшибки = СтрСоединить(ТекстыОшибок, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция АннулированиеДоступноДляДокументов(Документы)

	Результат = Новый Структура("Результат, ТекстОшибки", Истина, "");
	
	ТекстыОшибок = Новый Массив;
	
	СостоянияДокументов = ЭлектронныеДокументыЭДО.СостоянияДокументов(Документы);
	ВидыДокументов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Документы, "ВидДокумента");
	ТипыДокументов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(
		ОбщегоНазначения.ВыгрузитьКолонку(ВидыДокументов, "Значение"), "ТипДокумента");
	
	Для Каждого СостояниеПоДокументу Из СостоянияДокументов Цикл
		Документ = СостояниеПоДокументу.Ключ;
		СостояниеДокумента = СостояниеПоДокументу.Значение;
		ВидДокумента = ВидыДокументов[Документ];
		ТипДокумента = ТипыДокументов[ВидДокумента];
		Если Не АннулированиеДоступно(ТипДокумента, СостояниеДокумента) Тогда
			Результат.Результат = Ложь;
			ТекстыОшибок.Добавить(СтрШаблон(
				НСтр("ru = 'Аннулирование документа ""%1"" недоступно при состоянии ЭДО ""%2""'") + Символы.ПС,
				Строка(Документ), Строка(СостояниеДокумента)));
		КонецЕсли;
	КонецЦикла;
	
	Результат.ТекстОшибки = СтрСоединить(ТекстыОшибок, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция АннулированиеДоступно(ТипДокумента, СостоянияДокумента)
	
	Если ТипДокумента <> ПредопределенноеЗначение("Перечисление.ТипыДокументовЭДО.МашиночитаемаяДоверенность")
		И СостоянияДокумента = ПредопределенноеЗначение("Перечисление.СостоянияДокументовЭДО.ТребуетсяУтверждение")
		Или СостоянияДокумента = 
		ПредопределенноеЗначение("Перечисление.СостоянияДокументовЭДО.ТребуетсяИзвещениеОПолучении")
		Или СостоянияДокумента = 
		ПредопределенноеЗначение("Перечисление.СостоянияДокументовЭДО.ТребуетсяПодписаниеИзвещения")
		Или СостоянияДокумента = 
		ПредопределенноеЗначение("Перечисление.СостоянияДокументовЭДО.ТребуетсяПодготовкаКОтправкеИзвещения")
		Или СостоянияДокумента = 
		ПредопределенноеЗначение("Перечисление.СостоянияДокументовЭДО.ТребуетсяОтправкаИзвещения")
		Или СостоянияДокумента = 
		ПредопределенноеЗначение("Перечисление.СостоянияДокументовЭДО.ОжидаетсяПодтверждениеОператора")
		Или СостоянияДокумента = 
		ПредопределенноеЗначение("Перечисление.СостоянияДокументовЭДО.ОжидаетсяИзвещениеОПолучении")
		Или СостоянияДокумента = 
		ПредопределенноеЗначение("Перечисление.СостоянияДокументовЭДО.ОжидаетсяПодтверждение")
		Или СостоянияДокумента = 
		ПредопределенноеЗначение("Перечисление.СостоянияДокументовЭДО.ОбменЗавершен")
		Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

