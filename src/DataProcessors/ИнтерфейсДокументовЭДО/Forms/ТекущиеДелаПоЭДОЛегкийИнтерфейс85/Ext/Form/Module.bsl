	ПоказатьРасширенныйПодборОбъектовУчета();
КонецПроцедуры

#КонецОбласти // ОтражениеВУчете

#Область МобильныйКлиент

&НаКлиенте
Процедура Подключаемый_МК_АктивироватьСтраницуВходящие(Команда)

	СведенияОбЭлементахФормы = ЭтотОбъект["МК_СведенияОбЭлементахФормы"];
	Если СведенияОбЭлементахФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МК_АктивироватьТекущуюСтраницу(
		СведенияОбЭлементахФормы.СведенияОРазделах.СтраницаВходящиеЭлектронныеДокументы);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_МК_АктивироватьСтраницуИсходящие(Команда)
	
	СведенияОбЭлементахФормы = ЭтотОбъект["МК_СведенияОбЭлементахФормы"];
	Если СведенияОбЭлементахФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МК_АктивироватьТекущуюСтраницу(
		СведенияОбЭлементахФормы.СведенияОРазделах.СтраницаИсходящиеЭлектронныеДокументы);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_МК_ПоказатьСкрытьФильтры(Команда)

	СведенияОбЭлементахФормы = ЭтотОбъект["МК_СведенияОбЭлементахФормы"];
	Если СведенияОбЭлементахФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы[СведенияОбЭлементахФормы.ИмяГруппыФильтры].Видимость =
		Не Элементы[СведенияОбЭлементахФормы.ИмяГруппыФильтры].Видимость;
	
	КнопкаПоказатьСкрытьФильтры =
		Элементы[СведенияОбЭлементахФормы.ИмяКомандыПоказатьСкрытьФильтры];

	СведенияОбЭлементахФормы = ЭтотОбъект["МК_СведенияОбЭлементахФормы"];
	
	МК_ОформитьКнопкуПоказатьСкрытьФильтры(КнопкаПоказатьСкрытьФильтры);
	
КонецПроцедуры

&НаКлиенте
Процедура МК_ОформитьКнопкуПоказатьСкрытьФильтры(КнопкаПоказатьСкрытьФильтры = Неопределено)
	
	СведенияОбЭлементахФормы = ЭтотОбъект["МК_СведенияОбЭлементахФормы"];
	Если СведенияОбЭлементахФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если КнопкаПоказатьСкрытьФильтры = Неопределено Тогда
		КнопкаПоказатьСкрытьФильтры =
			Элементы[СведенияОбЭлементахФормы.ИмяКомандыПоказатьСкрытьФильтры];
	КонецЕсли;
	
	ИнтерфейсМобильногоЭДОКлиентСервер.НастроитьКнопкуФильтры(ЭтотОбъект,
		КнопкаПоказатьСкрытьФильтры,
		СведенияОбЭлементахФормы.ИмяГруппыФильтры);
	
КонецПроцедуры

&НаКлиенте
Процедура МК_ОбновитьСпискиВходящихИИсходящихДокументов()
	
	Если Не ЭтоМобильныйКлиент Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ВходящиеЭлектронныеДокументы.Обновить();
	Элементы.ИсходящиеЭлектронныеДокументы.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура МК_АктивироватьТекущуюСтраницу(СведенияОСтранице)

	ИнтерфейсМобильногоЭДОКлиентСервер.АктивироватьСтраницуФормыТекущиеДелаПоЭДОЛегкийИнтерфейс(
		ЭтотОбъект, СведенияОСтранице);

	ОбновитьФильтры();
	ВидимостьЭлементовИКоманд();

КонецПроцедуры

&НаСервере
Процедура МК_ОбновитьЗаголовкиПереключателейСтраниц()

	СведенияОбЭлементахФормы = ЭтотОбъект["МК_СведенияОбЭлементахФормы"];
	Если СведенияОбЭлементахФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИнтерфейсМобильногоЭДО.ОбновитьЗаголовкиПереключателейСтраницФормыТекущиеДелаЭДОЛегкийИнтерфейс(
		ЭтотОбъект, СведенияОбЭлементахФормы);

КонецПроцедуры

#КонецОбласти

#КонецОбласти