&НаСервере
Процедура ПоказатьУведомлениеПоТекущемуТрафику()
	
	Элементы.ГруппаОтправленоЗаМесяц.Видимость = ИспользуетсяПоказТрафикаЭлектронныхДокументов;
	
	Если Не ИспользуетсяПоказТрафикаЭлектронныхДокументов Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийТрафик = ИнтерфейсДокументовЭДО.ТекущийТрафик();
	Итог = ТекущийТрафик.Итог("РасчетныйТрафикОтправленныхЗаМесяц");
	
	Элементы.ДекорацияПоказатьСведенияПоТекущемуТрафику.Заголовок = СтрШаблон(НСтр("ru = 'Отправлено за месяц: %1'"), Итог);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоИспользованиюПоказаТрафикаЭлектронныхДокументов()
	
	ИспользуетсяПоказТрафикаЭлектронныхДокументов = ИнтерфейсДокументовЭДО.ИспользуетсяПоказТрафикаЭлектронныхДокументов();
	ПоказатьУведомлениеПоТекущемуТрафику();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПомощьНажатиеПоказатьВыборИзМеню(Элемент)
	
	ОбработчикЗавершения = Новый ОписаниеОповещения("ДекорацияПомощьНажатиеПослеВыбораИзМеню", ЭтотОбъект);
	
	СоставКомандПодменю = СоставКомандПодменюПомощь();
	
	СписокКоманд = Новый СписокЗначений;
	СписокКоманд.Добавить(СоставКомандПодменю.ОМодулеЭДО, НСтр("ru = 'О модуле ЭДО'"),, БиблиотекаКартинок.Информация);
	СписокКоманд.Добавить(СоставКомандПодменю.ПолезныеСсылки, НСтр("ru = 'Полезные ссылки'"));
	СписокКоманд.Добавить(СоставКомандПодменю.Техподдержка, НСтр("ru = 'Техподдержка'"));
	СписокКоманд.Добавить(СоставКомандПодменю.ДиагностикаЭДО, НСтр("ru = 'Диагностика ЭДО'"));
	СписокКоманд.Добавить(СоставКомандПодменю.ЕстьИдея, НСтр("ru = 'Есть идея?'"));
	
	ПоказатьВыборИзМеню(ОбработчикЗавершения, СписокКоманд, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПомощьНажатиеПослеВыбораИзМеню(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяКоманда = Результат.Значение;
	
	СоставКомандПодменю = СоставКомандПодменюПомощь();
	
	Если ВыбраннаяКоманда = СоставКомандПодменю.ОМодулеЭДО Тогда
		
		ОткрытьФорму("Обработка.ИнтерфейсДокументовЭДО.Форма.ОМодулеЭДО");
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ПолезныеСсылки Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ОткрытьФормуПолезныхСсылок();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.Техподдержка Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ОткрытьОбращениеВСлужбуТехническойПоддержки();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ДиагностикаЭДО Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ЗапуститьДиагностикуЭДО();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ЕстьИдея Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ОткрытьСтраницуОпроса();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СоставКомандПодменюПомощь()

	СоставКоманд = Новый Структура;
	СоставКоманд.Вставить("ОМодулеЭДО", "ОМодулеЭДО");
	СоставКоманд.Вставить("ПолезныеСсылки", "ПолезныеСсылки");
	СоставКоманд.Вставить("Техподдержка", "Техподдержка");
	СоставКоманд.Вставить("ДиагностикаЭДО", "ДиагностикаЭДО");
	СоставКоманд.Вставить("ЕстьИдея", "ЕстьИдея");
	Возврат СоставКоманд;

КонецФункции

&НаКлиенте
Процедура ДекорацияНастройкиНажатиеПоказатьВыборИзМеню(Элемент)
	
	ОбработчикЗавершения = Новый ОписаниеОповещения("ДекорацияНастройкиНажатиеПослеВыбораИзМеню", ЭтотОбъект);
	
	СоставКомандПодменю = СоставКомандПодменюНастройки();
	
	СписокКоманд = Новый СписокЗначений;
	СписокКоманд.Добавить(СоставКомандПодменю.ПерсональныеНастройки, НСтр("ru = 'Персональные настройки'"),, БиблиотекаКартинок.БыстрыеНастройкиОтчета);
	СписокКоманд.Добавить(СоставКомандПодменю.НастройкиЭДО, НСтр("ru = 'Настройки ЭДО'"),, БиблиотекаКартинок.ПрочиеПользовательскиеНастройки);
	СписокКоманд.Добавить(СоставКомандПодменю.ОткрытьМашиночитаемыеДоверенности, НСтр("ru = 'Машиночитаемые доверенности'"),, БиблиотекаКартинок.МашиночитаемыеДоверенностиБЭД);
	Если ЕстьПравоАдминистрирования Тогда
		СписокКоманд.Добавить(СоставКомандПодменю.ПроверитьПодписи, НСтр("ru = 'Проверить подписи'"),, БиблиотекаКартинок.СинтаксическийКонтроль);
	КонецЕсли;
	Если ЕстьПравоОбработкиДокументов Тогда
		СписокКоманд.Добавить(СоставКомандПодменю.ЗагрузитьФайлы, НСтр("ru = 'Массовая отправка файлов'"),, БиблиотекаКартинок.МассоваяОтправкаБЭД);
	КонецЕсли;
	
	ПоказатьВыборИзМеню(ОбработчикЗавершения, СписокКоманд, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНастройкиНажатиеПослеВыбораИзМеню(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяКоманда = Результат.Значение;
	
	СоставКомандПодменю = СоставКомандПодменюНастройки();
	
	Если ВыбраннаяКоманда = СоставКомандПодменю.ЗагрузитьФайлы Тогда
		
		ЗагрузитьФайлы(Неопределено);
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ПроверитьПодписи Тогда
		
		ОбщегоНазначенияБЭДКлиент.ОткрытьФормуБЭД("Обработка.ИнтерфейсДокументовЭДО.Форма.ПроверкаПодписей");
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ОткрытьМашиночитаемыеДоверенности Тогда
		
		МашиночитаемыеДоверенностиКлиент.ОткрытьОбщуюФормуСписковМЧД();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ПерсональныеНастройки Тогда
		
		ОткрытьФорму("Обработка.ПанельАдминистрированияБЭД.Форма.ПерсональныеНастройки");
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.НастройкиЭДО Тогда
		
		НастройкиЭДОКлиент.ОткрытьФормуНастроекЭДО();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СоставКомандПодменюНастройки()

	СоставКоманд = Новый Структура;
	СоставКоманд.Вставить("ЗагрузитьФайлы", "ЗагрузитьФайлы");
