#Область ИнициализацияФормы

&НаСервере
Процедура ЗаполнитьНастройкиФормы()
	
	ЗагрузитьНастройкиИзФормыТакси();
	
	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();

	РежимОтображения = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ИмяФормы, "РежимОтображения",
		РежимыОтображенияФормы().ВсеДокументы);
	
	ПакетноеОтображение = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ИмяФормы, "ПакетноеОтображение", Истина);
	
	ИспользоватьЭП = ОбщегоНазначенияБЭД.ЗначениеФункциональнойОпции("ИспользоватьЭлектронныеПодписиЭД");
	
	ОтложеннаяОтправкаЭлектронныхДокументов = НастройкиЭДО.ОтложеннаяОтправкаЭлектронныхДокументов();
	
	ПоказыватьОбластьПросмотра = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ИмяФормы,
		"ПоказыватьОбластьПросмотра", Ложь);
	
	ПоказыватьОбластьЛегенды = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ИмяФормы, 
		"ПоказыватьОбластьЛегенды", Ложь);
		
	ПоказыватьПомеченныеНаУдаление = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		ИнтерфейсДокументовЭДОКлиентСервер.КлючОбъектаНастроекИнтерфейсаЭДО(),
		"ОтображатьУдаленные", Ложь);
		
	ЖирныйШрифтФормы = ШрифтыСтиля.ЖирныйШрифтТекстаВторогоУровня85БЭД;
	ОбычныйШрифтФормы = ШрифтыСтиля.ТекстВторогоУровня;
	
	ОтправлятьВходящиеДокументыНаУтверждение = НастройкиЭДО.ОтправлятьВходящиеДокументыНаУтверждение();
	
	ЕстьПравоОбработкиДокументов = ЭлектронныеДокументыЭДО.ЕстьПравоОбработкиДокументов();
	ЕстьПравоАдминистрирования = ОбщегоНазначенияБЭД.ЕстьПравоАдминистрирования();
	ЕстьПравоВыполненияОбмена = СинхронизацияЭДО.ЕстьПравоВыполненияОбмена();
	
	БыстрыеОтборыУстановлены = Ложь;
	
	СписокВидовДокументов.ЗагрузитьЗначения(ИнтерфейсДокументовЭДО.ВидыЭлектронныхДокументовДоступныеДляОтборов());
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокФормы()

	РежимыОтображения = РежимыОтображенияФормы();

	Если РежимОтображения = РежимыОтображения.КИсполнению Тогда
		СуффиксЗаголовка = НСтр("ru = 'к исполнению'");
	ИначеЕсли РежимОтображения = РежимыОтображения.МоиДокументы Тогда
		СуффиксЗаголовка = НСтр("ru = 'мои документы'");
	ИначеЕсли РежимОтображения = РежимыОтображения.ВсеДокументы Тогда
		СуффиксЗаголовка = НСтр("ru = 'весь документооборот'");
	Иначе
		СуффиксЗаголовка = "";
	КонецЕсли;

	Если ПакетноеОтображение Тогда
		СуффиксЗаголовка = СуффиксЗаголовка + НСтр("ru = ', по пакетам'");
	Иначе
		СуффиксЗаголовка = СуффиксЗаголовка + НСтр("ru = ', по документам'");
	КонецЕсли;

	Заголовок = СтрШаблон(НСтр("ru = 'Текущие дела ЭДО (%1)'"), СуффиксЗаголовка);

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовкиЭлементов()

	Если НастройкиЭДО.ИспользуютсяВнутренниеДокументы() Тогда
		ЗаголовокКолонкиКонтрагентИсходящихЭД = НСтр("ru = 'Контрагент / Организация'");
	Иначе
		ЗаголовокКолонкиКонтрагентИсходящихЭД = НСтр("ru = 'Контрагент'");
	КонецЕсли;
	
	Элементы.ИсходящиеЭДКонтрагент.Заголовок = ЗаголовокКолонкиКонтрагентИсходящихЭД;
	Элементы.СформироватьЭДКонтрагент.Заголовок = ЗаголовокКолонкиКонтрагентИсходящихЭД;
	
	Элементы.ОтправитьЭДОтправить.Заголовок = НСтр("ru = 'Отправить'");
	
	Если ОтложеннаяОтправкаЭлектронныхДокументов Тогда
		Элементы.ОтправитьЭДОтправить.Заголовок = НСтр("ru = 'Подготовить к отправке'");
		Элементы.ИсходящиеЭДПодписать.Заголовок = НСтр("ru = 'Подписать'");
		Элементы.СформироватьЭДСформироватьПодписатьИОтправить.Заголовок = НСтр("ru = 'Создать и подписать'");
		Команды.ВходящиеЭДУтвердитьПодписатьИОтправить.Подсказка =
			НСтр("ru = 'Создать, подписать и подготовить к отправке
			|выделенные электронные документы'");
		Если Не ИспользоватьЭП Тогда
			Элементы.СформироватьЭДСформироватьПодписатьИОтправить.Заголовок = НСтр("ru = 'Создать'");
			Команды.ВходящиеЭДУтвердитьПодписатьИОтправить.Подсказка = НСтр("ru = 'Создать и подготовить к отправке
				|выделенные электронные документы'");
		КонецЕсли;
	ИначеЕсли Не ИспользоватьЭП Тогда
		Элементы.СформироватьЭДСформироватьПодписатьИОтправить.Заголовок = НСтр("ru = 'Создать и отправить'");
		Команды.ВходящиеЭДУтвердитьПодписатьИОтправить.Подсказка = НСтр("ru = 'Создать и отправить
			|выделенные электронные документы'");
	КонецЕсли;
	
	Если Не ОтправлятьВходящиеДокументыНаУтверждение Тогда
		Элементы.ВходящиеЭДУтвердитьПодписатьИОтправить.Заголовок = НСтр("ru = 'Подписать и отправить'");
	КонецЕсли;
	
КонецПроцедуры

