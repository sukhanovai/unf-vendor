////////////////////////////////////////////////////////////////////////////////
// Модуль формы Обработка.ОбменСКонтрагентами.ТекущиеДелаПоЭДО85.

// Параметры формы:
//  * РежимОтображения - Строка - режим просмотра, устанавливаемый при открытии.
//                                Доступные значения: См. РежимыОтображенияФормы.
//  * Раздел - Строка - раздел, устанавливаемый при открытии. Доступные разделы: см. ИнициализироватьРазделы.
//  * ОтборУчетныхДокументов - Массив Из Структура - отборы, которые нужно установить на прикладной документ в разделе "Создать": 
//   ** Поле - Строка - путь к данным, на которые устанавливается отбор. Должно начинаться с "Документ".
//		Примеры: "Документ", "Документ.Организация".
//   ** ВидСравнения - ВидСравненияКомпоновкиДанных - вид сравнения отбора.
//   ** Значение - Произвольный - значение отбора.
//  * ОтборВходящихДокументов - Массив Из Структура - отборы, которые нужно установить на входящие электронные документы:
//   ** Поле - Строка - путь к данным, на которые устанавливается отбор. Должно начинаться с "ЭлектронныйДокумент".
//		Примеры: "ЭлектронныйДокумент", "ЭлектронныйДокумент.СодержитДанныеОМаркируемыхТоварах"
//   ** ВидСравнения - ВидСравненияКомпоновкиДанных - вид сравнения отбора.
//   ** Значение - Произвольный - значение отбора.
//  * ОтборИсходящихДокументов - Массив Из Структура - отборы, которые нужно установить на исходящие электронные документы:
//   ** Поле - Строка - путь к данным, на которые устанавливается отбор. Должно начинаться с "ЭлектронныйДокумент".
//		Примеры: "ЭлектронныйДокумент", "ЭлектронныйДокумент.СодержитДанныеОМаркируемыхТоварах"
//   ** ВидСравнения - ВидСравненияКомпоновкиДанных - вид сравнения отбора.
//   ** Значение - Произвольный - значение отбора.
//   
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ВариантыИнтерфейса = ИнтерфейсДокументовЭДОКлиентСервер.ВариантыИнтерфейсаДокументовЭДО();
	ТекущийВариантИнтерфейса = ИнтерфейсДокументовЭДО.ВариантИнтерфейсаДокументовЭДО();
	Если ТекущийВариантИнтерфейса <> ВариантыИнтерфейса.Расширенный Тогда
		ВызватьИсключение ИнтерфейсДокументовЭДО.ТекстСообщенияОНедоступностиОткрытияФормыТекущихДелЭДО( 
			Метаданные.Обработки.ИнтерфейсДокументовЭДО.Формы.ТекущиеДелаПоЭДО.Синоним,
			ТекущийВариантИнтерфейса);
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(
		"РегистрСведений.НастройкиОтправкиЭлектронныхДокументовПоВидам", ЭтотОбъект);
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(
		"РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами", ЭтотОбъект);
	
	Если ТолькоПросмотр Тогда
		Для Каждого Команда Из Команды Цикл
			Команда.ИзменяетСохраняемыеДанные = Истина;
		КонецЦикла;
	КонецЕсли;
	
	АдресКэшаРасчетов = ПоместитьВоВременноеХранилище(Новый Соответствие, УникальныйИдентификатор);
	
	СохраняемыеВНастройкахДанныеМодифицированы = Истина;
	
	ЗаполнитьНастройкиФормы();
	
	УстановитьУсловноеОформление();
	
	ОбновитьЗаголовокФормы();
	
	ОбновитьЗаголовкиЭлементов();
	
	ИнициализироватьДерево();

	ИнтерфейсДокументовЭДО.ИнициализироватьРазделыТекущихДел(ОписаниеРазделов);
	
	Если ЗначениеЗаполнено(Параметры.РежимОтображения) Тогда
		УстановитьРежимОтображения(Параметры.РежимОтображения);
	КонецЕсли;

	ОбновитьВидимостьРазделовДерева(ДеревоДействий, РежимОтображения);
	
	СформироватьТаблицуБыстрогоОтбора();
	ЗагрузитьОтборы();
	НастроитьБыстрыеОтборы(ЭтотОбъект);

	НастроитьВидимостьДоступностьКомандПоПравам();
	
	Для Каждого ТаблицаФормы Из ТаблицыФормы() Цикл
		СкрытьСлужебныеКомандыТаблицы(Элементы[ТаблицаФормы.Значение].КоманднаяПанель.ПодчиненныеЭлементы);
	КонецЦикла;
	
	НастроитьВидимостьДоговоровКонтрагентов();

	УстановитьОтборУчетныхДокументов(Параметры.ОтборУчетныхДокументов);
	УстановитьОтборВходящихДокументов(Параметры.ОтборВходящихДокументов);
	УстановитьОтборИсходящихДокументов(Параметры.ОтборИсходящихДокументов);

	НастроитьСпискиРазделов();
	Если ЗначениеЗаполнено(Параметры.Раздел) Тогда
		ПоказатьРазделСПроверкой(Параметры.Раздел);
	Иначе
		ПоказатьРаздел(РазделыФормы().Входящие);
	КонецЕсли;
	
	ОбновитьНавигациюПоРазделамНаСервере(Истина, Ложь);

	УстановитьНавигационнуюСсылкуФормы();

	УстановитьСвойстваПереопределяемыхЭлементовФормы();
	
	УстановитьОтображениеЭлементовПоНастройкамПользователя();
	
	ВывестиВерсиюБЭД();
	
	Задолженность = СведенияОЗадолженности();
	ПоказатьУведомленияПоЗадолженности(ЭтотОбъект, Задолженность);
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами.КонтекстныеПодсказкиБЭД
	КонтекстныеПодсказкиБЭД.КонтекстныеПодсказки_ПриСозданииНаСервере(ЭтотОбъект, Элементы.ПанельКонтекстныхНовостей,
		Элементы.ГруппаКонтекстныхПодсказок);
	СформироватьКонтекст();
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами.КонтекстныеПодсказкиБЭД
	
	ПараметрыПриСозданииНаСервере = АвтоматическоеПолучениеЭДО.НовыеПараметрыФормыСпискаПриСозданииНаСервере();
	АвтоматическоеПолучениеЭДО.ФормаСпискаПриСозданииНаСервере(ЭтотОбъект, ПараметрыПриСозданииНаСервере);
	
	УчетныеЗаписиЭДО.НастроитьГруппуПредупреждениеОЗавершенииДокументовТакском(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = ИнтерфейсДокументовЭДОКлиент.ИмяСобытияОбновленияСостоянияЭДО()
		Или ИмяСобытия = "ОбновитьСостояниеПриглашений"
		Или ИмяСобытия = ИнтерфейсДокументовЭДОКлиент.ИмяСобытияОбновленияТекущихДелЭДО()Тогда

		ОбновитьТекущиеДелаПоЭДО(Параметр);
		
	ИначеЕсли ИмяСобытия = "ВыполнитьСинхронизацию" Тогда
		
		Активизировать();
		ОтправитьИПолучитьЭД(Неопределено);

	ИначеЕсли ИмяСобытия = "Запись_НаборКонстант"
		И (Источник = "ОтправлятьВходящиеДокументыНаУтверждение"
		Или Источник = "ИспользоватьОтложеннуюОтправкуЭлектронныхДокументов") Тогда

		Если Источник = "ОтправлятьВходящиеДокументыНаУтверждение" Тогда
			ПриИзмененииУтвержденияВходящихДокументов();
		КонецЕсли;
		
		ОбновитьОтображениеДанных();
		ОбновитьЗаголовкиЭлементов();
		РазблокироватьЗаблокированныеЭлементыФормы();
		ПодключитьОбработчикОжидания("РазвернутьУзлыДереваОтложенно", 0.1, Истина);
		
	ИначеЕсли ИмяСобытия = "Запись_НаборКонстант" 
		И Источник = "ИспользоватьРазделениеДокументовПоОтветственнымЭДО" Тогда
		
		РежимОтображения = РежимыОтображенияФормы().ВсеДокументы;
		ОбновитьОтображениеДанных();
		
	ИначеЕсли ИмяСобытия = "ПрочтениеОбновитьСписок" Тогда
		
		ОбновитьДинамическиеСписки();
		
	ИначеЕсли ИмяСобытия = ИнтерфейсДокументовЭДОКлиент.ИмяСобытияИзмененияНастроекТекущихДелЭДО() Тогда
		
		ПриИзмененииНастроек();
		
	КонецЕсли;
	
	ОчиститьОбластьПросмотраЕслиСписокПуст();

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами.КонтекстныеПодсказкиБЭД
	КонтекстныеПодсказкиБЭДКлиент.КонтекстныеНовости_ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами.КонтекстныеПодсказкиБЭД
	
	АвтоматическоеПолучениеЭДОКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбработкаНеисправностейБЭДКлиент.ЗаполнитьДанныеСлужбыПоддержки(ТелефонСлужбыПоддержки, АдресЭлектроннойПочтыСлужбыПоддержки);
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами.КонтекстныеПодсказкиБЭД
	КонтекстныеПодсказкиБЭДКлиент.КонтекстныеНовости_ПриОткрытии(ЭтотОбъект);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами.КонтекстныеПодсказкиБЭД
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)

	СохранитьОтборы(ИмяФормы, "Отборы", БыстрыеОтборы);

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(ИмяФормы, "РежимОтображения", РежимОтображения);

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	ОбновитьНавигациюПоРазделамНаСервере(Ложь, Истина);
	
	ПоказыватьОбластьПросмотра = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ИмяФормы,
		"ПоказыватьОбластьПросмотра", Ложь);
	ПоказыватьОбластьЛегенды = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ИмяФормы, 
		"ПоказыватьОбластьЛегенды", Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказатьКомментарийСостояния(Команда)
	
	ИнтерфейсДокументовЭДОКлиент.ПоказатьКомментарийКСостояниюДокумента(ТекущийКомментарийСостояния);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПомощьНажатие(Элемент)
	
	ПодменюПомощьПоказатьВыборИзМеню(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПомощьКартинкаНажатие(Элемент)
	
	ПодменюПомощьПоказатьВыборИзМеню(Элемент)
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияСервисНажатие(Элемент)
	
	ПодменюСервисПоказатьВыборИзМеню(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияСервисКартинкаНажатие(Элемент)
	
	ПодменюСервисПоказатьВыборИзМеню(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНастройкиНажатие(Элемент)
	
	ПодменюНастройкиПоказатьВыборИзМеню(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНастройкиКартинкаНажатие(Элемент)
	
	ПодменюНастройкиПоказатьВыборИзМеню(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБыстрыеОтборыНажатие(Элемент)
	
	ПоказатьБыстрыеОтборы = Не ПоказатьБыстрыеОтборы;
	НастроитьБыстрыеОтборы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБыстрыеОтборыКартинкаНажатие(Элемент)
	
	ПоказатьБыстрыеОтборы = Не ПоказатьБыстрыеОтборы;
	НастроитьБыстрыеОтборы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьПредупреждениеОЗавершенииДокументовТакскомОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	УчетныеЗаписиЭДОКлиент.ОбработкаНавигационнойСсылкиЗавершенияДокументовТакском(Элемент, 
		НавигационнаяСсылкаФорматированнойСтроки,
		СтандартнаяОбработка);
		
КонецПроцедуры

#Область ОбработчикиСобытийОбластьПросмотра

&НаКлиенте
Процедура НадписьОшибкаФормированияПредставленияОбработкаНавигационнойСсылки(Элемент, 
	НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ОткрытьЖурналРегистрации" Тогда
		
		СтандартнаяОбработка = Ложь;
		ОтборЖурналаРегистрации = Новый Структура;
		ОтборЖурналаРегистрации.Вставить("Данные", "ЭлектронныеДокументыЭДО.ПредставлениеДанныхДокумента");
		ЖурналРегистрацииКлиент.ОткрытьЖурналРегистрации(ОтборЖурналаРегистрации, ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийДокументУчетаПредставлениеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущийСписок = ПолучитьТекущийСписок();

	Если ЗначениеЗаполнено(ТекущийДокументУчета) Тогда
		ПоказатьЗначение( , ТекущийДокументУчета);
	ИначеЕсли ТекущийСписок = Элементы.ВходящиеЭД Тогда
			
		ТекущиеДанные = ТекущийСписок.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПоказатьДанныеВЗависимостиОтОтраженияВУчете(ТекущиеДанные.КонтрольОтраженияВУчете);
		
	Иначе

		ПоказатьРасширенныйПодборДокументовУчета();
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекущийФайлПредставлениеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДляРедактирования = Ложь;
	ИнтерфейсДокументовЭДОКлиент.ОткрытьФайл(ТекущийФайл, УникальныйИдентификатор, ДляРедактирования);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНоменклатураКонтрагентов

&НаКлиенте
Процедура НоменклатураКонтрагентовВыбор(Элемент, ВыбраннаяСтрока, Поле,	СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ПоказатьСопоставлениеНоменклатуры();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыБыстрыеОтборы

&НаКлиенте
Процедура БыстрыеОтборыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если СтрНайти(Поле.Имя, "Кнопка") <> 0 Тогда

		ИмяСписка = СписокРаздела(ТекущийРаздел);
		Список = ЭтотОбъект[ИмяСписка];

		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Раздел", ТекущийРаздел);

		Оповещение = Новый ОписаниеОповещения("ПриОкончанииНастройкиСписка", ЭтотОбъект, ДопПараметры);

		ИнтерфейсДокументовЭДОКлиент.ОткрытьНастройкиОтборовСписка(Оповещение, ЭтотОбъект, Список.КомпоновщикНастроек)
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура БыстрыеОтборыПриАктивизацииСтроки(Элемент)
	
	СтрокаБыстрыеОтборы = Элементы.БыстрыеОтборы.ТекущаяСтрока;
	ТекущиеДанныеБыстрыеОтборы = Элементы.БыстрыеОтборы.ТекущиеДанные;
	
	Если ТекущаяСтрокаВОтбореВПапке = СтрокаБыстрыеОтборы Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрокаВОтбореВПапке = СтрокаБыстрыеОтборы;
	
	Если ТекущаяСтрокаВОтбореВПапке = Неопределено
		Или ТекущиеДанныеБыстрыеОтборы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанныеБыстрыеОтборы.Значение = Неопределено
		И ТекущиеДанныеБыстрыеОтборы.Тип = "Булево" Тогда
		
		Элементы.БыстрыеОтборыЗначение.КнопкаВыпадающегоСписка = Истина;
		Элементы.БыстрыеОтборыЗначение.КнопкаВыбора = Ложь;
		
	ИначеЕсли СтрНайти(ТекущиеДанныеБыстрыеОтборы.Тип, "СправочникСсылка")
		Или ТекущиеДанныеБыстрыеОтборы.Параметр = "ВидДокумента" Тогда
		
		Элементы.БыстрыеОтборыЗначение.КнопкаВыпадающегоСписка = Истина;
		Элементы.БыстрыеОтборыЗначение.КнопкаВыбора = Истина;
		
	ИначеЕсли ТекущиеДанныеБыстрыеОтборы.Тип = "Дата" Тогда
		
		Элементы.БыстрыеОтборыЗначение.КнопкаВыпадающегоСписка = Ложь;
		Элементы.БыстрыеОтборыЗначение.КнопкаВыбора = Истина;
		
	Иначе
		
		Элементы.БыстрыеОтборыЗначение.КнопкаВыпадающегоСписка = Ложь;
		Элементы.БыстрыеОтборыЗначение.КнопкаВыбора = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыеОтборыЗначениеПриИзменении(Элемент)

	ДанныеБыстрыеОтборы = Элемент.Родитель.ТекущиеДанные;
	Если ДанныеБыстрыеОтборы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеБыстрыеОтборы.Тип = "Число" И ДанныеБыстрыеОтборы.Значение = 0 Тогда
		ДанныеБыстрыеОтборы.Значение = Неопределено;
	КонецЕсли;
	
	ПриИзмененииОтбора();

КонецПроцедуры

&НаКлиенте
Процедура БыстрыеОтборыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ДанныеБыстрыеОтборы = Элемент.ТекущиеДанные;
	Если ДанныеБыстрыеОтборы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеБыстрыеОтборы.Тип = "Число" И ДанныеБыстрыеОтборы.Значение = Неопределено Тогда
		ДанныеБыстрыеОтборы.Значение = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура БыстрыеОтборыПриОкончанииРедактирования(Элемент, НоваяСтрока,	ОтменаРедактирования)

	ДанныеБыстрыеОтборы = Элемент.ТекущиеДанные;
	Если ДанныеБыстрыеОтборы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеБыстрыеОтборы.Тип = "Число" И ДанныеБыстрыеОтборы.Значение = 0 Тогда
		ДанныеБыстрыеОтборы.Значение = Неопределено;
	КонецЕсли;

	СохраняемыеВНастройкахДанныеМодифицированы = Истина;

КонецПроцедуры

&НаКлиенте
Процедура БыстрыеОтборыЗначениеОчистка(Элемент, СтандартнаяОбработка)
	
	БыстрыеОтборыУстановлены = Ложь;

	ДанныеБыстрыеОтборы = Элементы.БыстрыеОтборы.ТекущиеДанные;
	Если ДанныеБыстрыеОтборы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НазваниеСправочникаКонтрагенты = ИмяПрикладногоСправочника("Контрагенты");
	Если Не ЗначениеЗаполнено(НазваниеСправочникаКонтрагенты) Тогда
		НазваниеСправочникаКонтрагенты = "Контрагенты";
	КонецЕсли;

	НазваниеСправочникаОрганизации = ИмяПрикладногоСправочника("Организации");
	Если Не ЗначениеЗаполнено(НазваниеСправочникаОрганизации) Тогда
		НазваниеСправочникаОрганизации = "Организации";
	КонецЕсли;
	
	Если ДанныеБыстрыеОтборы.Тип = "Строка" Тогда
		ДанныеБыстрыеОтборы.Значение = "";
	ИначеЕсли ДанныеБыстрыеОтборы.Тип = "Дата" Тогда
		ДанныеБыстрыеОтборы.Значение = Дата(1, 1, 1);
	ИначеЕсли ДанныеБыстрыеОтборы.Тип = "Число" Тогда
		ДанныеБыстрыеОтборы.Значение = Неопределено;
	ИначеЕсли ДанныеБыстрыеОтборы.Тип = "Булево" Тогда
		ДанныеБыстрыеОтборы.Значение = Неопределено;
	ИначеЕсли ДанныеБыстрыеОтборы.Тип = "ПеречислениеСсылка.ТипыДокументовЭДО" Тогда
		ДанныеБыстрыеОтборы.Значение = ПредопределенноеЗначение("Перечисление.ТипыДокументовЭДО.ПустаяСсылка");
	ИначеЕсли ДанныеБыстрыеОтборы.Тип = "СправочникСсылка." + НазваниеСправочникаКонтрагенты Тогда
		ДанныеБыстрыеОтборы.Значение = ПредопределенноеЗначение("Справочник." + НазваниеСправочникаКонтрагенты 
			+ ".ПустаяСсылка");
	ИначеЕсли ДанныеБыстрыеОтборы.Тип = "СправочникСсылка." + НазваниеСправочникаОрганизации Тогда
		ДанныеБыстрыеОтборы.Значение = ПредопределенноеЗначение("Справочник." + НазваниеСправочникаОрганизации 
			+ ".ПустаяСсылка");
	ИначеЕсли ДанныеБыстрыеОтборы.Тип = "СправочникСсылка.Пользователи" Тогда
		ДанныеБыстрыеОтборы.Значение = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
	ИначеЕсли ДанныеБыстрыеОтборы.Тип = "ПеречислениеСсылка.НаправленияЭДО" Тогда
		ДанныеБыстрыеОтборы.Значение = ПредопределенноеЗначение("Перечисление.НаправленияЭДО.ПустаяСсылка");
	ИначеЕсли ДанныеБыстрыеОтборы.Тип = "СправочникСсылка.ВидыДокументовЭДО" Тогда
		ДанныеБыстрыеОтборы.Значение = ПредопределенноеЗначение("Справочник.ВидыДокументовЭДО.ПустаяСсылка");;
	КонецЕсли;

	ПриИзмененииОтбора();

КонецПроцедуры

&НаКлиенте
Процедура БыстрыеОтборыЗначениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ДанныеБыстрыеОтборы = Элементы.БыстрыеОтборы.ТекущиеДанные;
	Если ДанныеБыстрыеОтборы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеБыстрыеОтборы.Параметр = "ВидДокумента" Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = СписокВидовДокументов;
	ИначеЕсли ДанныеБыстрыеОтборы.Параметр = "Прочтен" Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить(Истина);
		ДанныеВыбора.Добавить(Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоДействий

&НаКлиенте
Процедура ДеревоДействийПриАктивизацииСтроки(Элемент)

	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НовыйРаздел = Элемент.ТекущиеДанные.Значение;
	Если НовыйРаздел <> ТекущийРаздел Тогда
		ПриИзмененииРаздела(НовыйРаздел, Истина);
		ПодключитьОбработчикОжидания("УстановитьУсловноеОформлениеКлиент", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

