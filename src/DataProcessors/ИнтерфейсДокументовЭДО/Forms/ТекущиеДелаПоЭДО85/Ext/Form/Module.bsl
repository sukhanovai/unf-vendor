		СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Данные = Элемент.ДанныеСтроки(ВыбраннаяСтрока);

	ПоказатьЗначение(, Данные.ЭлектронныйДокумент);

КонецПроцедуры

