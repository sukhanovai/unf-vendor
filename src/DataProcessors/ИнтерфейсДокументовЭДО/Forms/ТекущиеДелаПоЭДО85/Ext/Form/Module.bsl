&НаСервереБезКонтекста
Процедура ПоказатьУведомленияПоЗадолженности(Форма, Задолженность)
	
	Если Не Задолженность.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПредупреждения = НСтр("ru = '<a href=%1>У вас задолженность</a>'");
	
	ПараметрыБаннера = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыБаннера.Сообщение = СтроковыеФункции.ФорматированнаяСтрока(ТекстПредупреждения,
		"ПоказатьСведенияОЗадолженности");
	ПараметрыБаннера.Идентификатор = "ПредупреждениеОНаличииЗадолженности";
	ПараметрыБаннера.КраткоеПредставление = НСтр("ru = 'У вас задолженность'");;
	ПараметрыБаннера.Обработчик = "Подключаемый_ПоказатьСведенияОЗадолженности"; // См. Подключаемый_ПоказатьСведенияОЗадолженности
	ПараметрыБаннера.Скрываемый = Ложь;
		
	ОбщегоНазначения.ДобавитьВажноеСообщение(Форма, ПараметрыБаннера);
	ОбщегоНазначения.ВывестиСтатусыИВажныеСообщенияНаФорму(Форма);
	
КонецПроцедуры

