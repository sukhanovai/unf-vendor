КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСписков()
	
	СтандартныеПодсистемыСервер.УстановитьУсловноеОформлениеПоляДата(ЭтотОбъект,
		"Сформировать.Дата", "СформироватьЭДДата");
		
	СпискиФормы = СпискиФормы();
	
	Для Каждого ИмяСписка Из СпискиФормы Цикл
		УстановитьУсловноеОформлениеСпискаДляЕдинообразияШрифтов(ИмяСписка.Значение);
	КонецЦикла;
	
	ИменаСписковЭлектронныхДокументов = Новый Массив;
	ИменаСписковЭлектронныхДокументов.Добавить(СпискиФормы.ВходящиеЭД);
	ИменаСписковЭлектронныхДокументов.Добавить(СпискиФормы.ИсходящиеЭД);
	ИменаСписковЭлектронныхДокументов.Добавить(СпискиФормы.ОзнакомитьсяЭД);
	ИменаСписковЭлектронныхДокументов.Добавить(СпискиФормы.ОтправитьЭД);
	ИменаСписковЭлектронныхДокументов.Добавить(СпискиФормы.ОшибкиЭД);

	Для Каждого ИмяСписка Из ИменаСписковЭлектронныхДокументов Цикл
		
		ИнтерфейсДокументовЭДО.УстановитьУсловноеОформлениеСпискаДляПодсветкиНевалидныхПодписейПоМЧД(ЭтотОбъект,
			ИмяСписка);
		
		УстановитьУсловноеОформлениеСпискаДляПомеченныхНаУдалениеДокументов(ИмяСписка);
		
		УстановитьУсловноеОформлениеСпискаДляНепрочитанныхДокументов(ИмяСписка);
		
		УстановитьУсловноеОформлениеПоИспользованиюПакетногоОтображения(ИмяСписка);
		
		УстановитьУсловноеОформлениеДляОтображенияДатыПолучения(ИмяСписка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСпискаДляЕдинообразияШрифтов(ИмяСписка)

	Элемент = ЭтотОбъект[ИмяСписка].УсловноеОформление.Элементы.Добавить();

	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ОбычныйШрифтКомпактнаяФорма85БЭД);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСпискаДляПомеченныхНаУдалениеДокументов(ИмяСписка)
	
	ПолеПометкаУдаления = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	Если ЭтотОбъект[ИмяСписка].УсловноеОформление.ДоступныеПоляПолей.НайтиПоле(ПолеПометкаУдаления) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элемент = ЭтотОбъект[ИмяСписка].УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = НСтр("ru = 'Отображение помеченных на удаление электронных документов'");

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = ПолеПометкаУдаления;
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ЗачеркнутыйШрифтКомпактнаяФорма85БЭД);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаПалитры.Серый);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСпискаДляНепрочитанныхДокументов(ИмяСписка)
	
	ИспользоватьПрочтениеДокументовЭДО = ПолучитьФункциональнуюОпцию("ИспользоватьПрочтениеДокументовЭДО");
	Если Не ИспользоватьПрочтениеДокументовЭДО Тогда
		Возврат;
	КонецЕсли;
	
	ПолеПрочтен = Новый ПолеКомпоновкиДанных("Прочтен");
	ПолеПометкаУдаления = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	Если ЭтотОбъект[ИмяСписка].УсловноеОформление.ДоступныеПоляПолей.НайтиПоле(ПолеПрочтен) = Неопределено
		Или ЭтотОбъект[ИмяСписка].УсловноеОформление.ДоступныеПоляПолей.НайтиПоле(ПолеПометкаУдаления) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = ЭтотОбъект[ИмяСписка].УсловноеОформление.Элементы.Добавить();
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = ПолеПрочтен;
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = ПолеПометкаУдаления;
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ЖирныйШрифтКомпактнаяФорма85БЭД);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеДляОтображенияДатыПолучения(ИмяСписка)
	
	Если ИмяСписка = "ВходящиеЭД" Тогда
		ИмяПоляДаты = "ДатаПолучения";
	ИначеЕсли ИмяСписка = "ИсходящиеЭД" Тогда
		ИмяПоляДаты = "ДатаСоздания";
	ИначеЕсли ИмяСписка = "ОзнакомитьсяЭД" Или ИмяСписка = "ОтправитьЭД" Тогда
		ИмяПоляДаты = "ДатаСозданияПолучения";
	ИначеЕсли ИмяСписка = "ОшибкиЭД" Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяСписка + ИмяПоляДаты].Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяСписка + "." + ИмяПоляДаты);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	ОтборЭлемента.ПравоеЗначение = Новый СтандартнаяДатаНачала(ВариантСтандартнойДатыНачала.НачалоЭтогоДня);
	ОтборЭлемента.Использование = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("Формат", "ДФ=ЧЧ:мм");
		
	Элемент.Представление = 
		НСтр("ru = 'Отображать дату сегодняшних писем только в виде времени ""09:46"" (стандартная настройка)'");
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяСписка + ИмяПоляДаты].Имя);
	
	ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяСписка + "." + ИмяПоляДаты);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = Новый СтандартнаяДатаНачала(ВариантСтандартнойДатыНачала.НачалоЭтогоДня);
	ОтборЭлемента.Использование = Истина;

	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяСписка + "." + ИмяПоляДаты);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	ОтборЭлемента.ПравоеЗначение = Новый СтандартнаяДатаНачала(ВариантСтандартнойДатыНачала.НачалоЭтогоМесяца);
	ОтборЭлемента.Использование = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Формат", "ДФ='dd MMMM'");
	
	Элемент.Представление = 
		НСтр("ru = 'Отображать дату документов за эту неделю в виде ""Вт 10.06"" (стандартная настройка)'");
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяСписка + ИмяПоляДаты].Имя);
	
	ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяСписка + "." + ИмяПоляДаты);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = Новый СтандартнаяДатаНачала(ВариантСтандартнойДатыНачала.НачалоЭтогоМесяца);
	ОтборЭлемента.Использование = Истина;

	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяСписка + "." + ИмяПоляДаты);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	ОтборЭлемента.ПравоеЗначение = Новый СтандартнаяДатаНачала(ВариантСтандартнойДатыНачала.НачалоЭтогоГода);
	ОтборЭлемента.Использование = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Формат", "ДФ='dd.MM'");
	
	Элемент.Представление = НСтр("ru = 'Отображать дату документов за этот год в виде ""10.06"" (стандартная настройка)'");
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяСписка + ИмяПоляДаты].Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяСписка + "." + ИмяПоляДаты);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборЭлемента.ПравоеЗначение = Новый СтандартнаяДатаНачала(ВариантСтандартнойДатыНачала.НачалоЭтогоГода);
	ОтборЭлемента.Использование = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Формат", "ДФ='dd.MM.yy'");
			
	Элемент.Представление = НСтр("ru = 'Отображать дату документов за период более ранний, чем этот год в виде ""10.06.2022"" 
		|(стандартная настройка)'");
	
КонецПроцедуры

#Область РаботаСПакетами

&НаСервере
Процедура УстановитьУсловноеОформлениеПоИспользованиюПакетногоОтображения(ИмяСписка)
	
	Если ПакетноеОтображение Тогда
		
		УстановитьУсловноеОформлениеДляВыделенияДокументовПакета(ИмяСписка);
		
	Иначе
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяСписка + "ПредставлениеДокументовВнеОтбора");
		Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеДляВыделенияДокументовПакета(ИмяСписка)
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяСписка);
	
	ГруппаОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КлючиВыбранныхДокументов");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит;
