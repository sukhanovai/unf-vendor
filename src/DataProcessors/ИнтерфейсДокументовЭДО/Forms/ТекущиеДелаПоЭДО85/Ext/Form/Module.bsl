	РассчитатьКоличествоЭлементовВРазделах(ПересчитатьКоличество, ПересчитатьКоличествоОтбор);

	ОбновитьДеревоНавигации(ДеревоДействий.ПолучитьЭлементы());
	
КонецПроцедуры

