		ТекущийЭлектронныйДокумент = Неопределено;
	КонецЕсли;
	
	Если ПакетноеОтображение Тогда
		ЗаполнитьВыбранныеДанные();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ОбновитьОбластьПросмотра", 0.2, Истина);
	
