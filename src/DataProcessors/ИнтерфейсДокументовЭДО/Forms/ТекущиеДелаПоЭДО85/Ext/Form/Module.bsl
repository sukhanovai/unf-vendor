&НаКлиенте
Процедура ПодменюПомощьПоказатьВыборИзМеню(Элемент)
	
	ОбработчикЗавершения = Новый ОписаниеОповещения("ПодменюПомощьПослеВыбораИзМеню", ЭтотОбъект);
	
	СоставКомандПодменю = СоставКомандПодменюПомощь();
	
	СписокКоманд = Новый СписокЗначений;
	СписокКоманд.Добавить(СоставКомандПодменю.ПолезныеСсылки, НСтр("ru = 'Полезные ссылки'"));
	СписокКоманд.Добавить(СоставКомандПодменю.Техподдержка, НСтр("ru = 'Техподдержка'"));
	СписокКоманд.Добавить(СоставКомандПодменю.ДиагностикаЭДО, НСтр("ru = 'Диагностика ЭДО'"));
	СписокКоманд.Добавить(СоставКомандПодменю.ЕстьИдея, НСтр("ru = 'Есть идея?'"));
	
	ПоказатьВыборИзМеню(ОбработчикЗавершения, СписокКоманд, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодменюПомощьПослеВыбораИзМеню(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяКоманда = Результат.Значение;
	
	СоставКомандПодменю = СоставКомандПодменюПомощь();
	
	Если ВыбраннаяКоманда = СоставКомандПодменю.ПолезныеСсылки Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ОткрытьФормуПолезныхСсылок();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.Техподдержка Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ОткрытьОбращениеВСлужбуТехническойПоддержки();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ДиагностикаЭДО Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ЗапуститьДиагностикуЭДО();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ЕстьИдея Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ОткрытьСтраницуОпроса();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СоставКомандПодменюПомощь()

	СоставКоманд = Новый Структура;
	СоставКоманд.Вставить("ПолезныеСсылки", "ПолезныеСсылки");
	СоставКоманд.Вставить("Техподдержка", "Техподдержка");
	СоставКоманд.Вставить("ДиагностикаЭДО", "ДиагностикаЭДО");
	СоставКоманд.Вставить("ЕстьИдея", "ЕстьИдея");
	Возврат СоставКоманд;

КонецФункции

&НаКлиенте
Процедура ПодменюСервисПоказатьВыборИзМеню(Элемент)
	
	ОбработчикЗавершения = Новый ОписаниеОповещения("ПодменюСервисПослеВыбораИзМеню", ЭтотОбъект);
	
	СоставКомандПодменю = СоставКомандПодменюСервис();
	
	СписокКоманд = Новый СписокЗначений;
	Если ЕстьПравоОбработкиДокументов Тогда
		СписокКоманд.Добавить(СоставКомандПодменю.МассоваяОтправкаФайлов, НСтр("ru = 'Массовая отправка файлов'"),,
			БиблиотекаКартинок.МассоваяОтправкаБЭД);
	КонецЕсли;
	СписокКоманд.Добавить(СоставКомандПодменю.АрхивЭДО, НСтр("ru = 'Архив ЭДО'"),, БиблиотекаКартинок.Справочник);
	СписокКоманд.Добавить(СоставКомандПодменю.УчетныеЗаписиЭДО, НСтр("ru = 'Учетные записи ЭДО'"),,
		БиблиотекаКартинок.ПодключениеБЭДШаблонная);
	СписокКоманд.Добавить(СоставКомандПодменю.МашиночитаемыеДоверенности, НСтр("ru = 'Машиночитаемые доверенности'"),,
		БиблиотекаКартинок.МашиночитаемыеДоверенностиБЭД);
	Если ЕстьПравоАдминистрирования Тогда
		СписокКоманд.Добавить(СоставКомандПодменю.ПроверитьПодписи, НСтр("ru = 'Проверить подписи'"),,
			БиблиотекаКартинок.СинтаксическийКонтроль);
	КонецЕсли;
	СписокКоманд.Добавить(СоставКомандПодменю.ОбщееСостояниеЭДО, НСтр("ru = 'Общее состояние ЭДО'"),,
		БиблиотекаКартинок.Отчет);
	
	ПоказатьВыборИзМеню(ОбработчикЗавершения, СписокКоманд, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодменюСервисПослеВыбораИзМеню(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяКоманда = Результат.Значение;
	
	СоставКомандПодменю = СоставКомандПодменюСервис();
	
	Если ВыбраннаяКоманда = СоставКомандПодменю.МассоваяОтправкаФайлов Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ОткрытьФормуМассовойЗагрузкиФайлов();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.АрхивЭДО Тогда
		
		ИнтерфейсДокументовЭДОКлиент.ОткрытьАрхивЭДО();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.УчетныеЗаписиЭДО Тогда
		
		СинхронизацияЭДОКлиент.ОткрытьСписокУчетныхЗаписей();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.МашиночитаемыеДоверенности Тогда
		
		МашиночитаемыеДоверенностиКлиент.ОткрытьОбщуюФормуСписковМЧД();
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ПроверитьПодписи Тогда
		
		ОбщегоНазначенияБЭДКлиент.ОткрытьФормуБЭД("Обработка.ИнтерфейсДокументовЭДО.Форма.ПроверкаПодписей");
		
	ИначеЕсли ВыбраннаяКоманда = СоставКомандПодменю.ОбщееСостояниеЭДО Тогда
		
		ОбщегоНазначенияБЭДКлиент.ОткрытьФормуБЭД("Отчет.ДиаграммаСостоянияЭДО.Форма");
		
	КонецЕсли;

КонецПроцедуры

