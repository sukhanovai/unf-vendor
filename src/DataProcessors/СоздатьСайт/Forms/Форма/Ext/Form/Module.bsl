&НаКлиенте
Функция МенюСтраницПоляСтраницыЗаполненыКорректно( ИмяСтраницы ) Экспорт
	
	Результат = Истина;
	
	ОчиститьСообщения();
	
	Если ИмяСтраницы = "СтраницаТипСайта" Тогда
		
		Если ПринимаюСоглашение = Ложь Тогда
			Результат = Ложь;

			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Необходимо принять лицензионное соглашение.'"),,
			"ПринимаюСоглашение" );
		КонецЕсли;
		
	ИначеЕсли ИмяСтраницы = "СтраницаНастройкиСайта" Тогда
		
		Если ПустаяСтрока( EmailРегистрацииСайта ) Тогда
			Результат = Ложь;
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Укажите e-mail, на который будет зарегистрирован сайт.'"),,
			"EmailРегистрацииСайта" );
			
		Иначе

			Если ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям( EmailРегистрацииСайта ) = Ложь Тогда
				Результат = Ложь;
			
				ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'E-mail задан некорректно.'"),,
				"EmailРегистрацииСайта" );
			КонецЕсли;

		КонецЕсли;

		Если ПустаяСтрока( ИмяСайта ) Тогда
			Результат = Ложь;

			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Заполните адрес сайта.'"),,
			"ИмяСайта" );
		Иначе
			Если ИмяСайтаСвободно = Ложь Тогда
				Результат = Ложь;

				ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'Адрес сайта занят, выберите другое имя сайта.'"),,
				"ИмяСайта" );
			КонецЕсли;
		КонецЕсли;
		
		Если ПустаяСтрока( ШаблонСайтаОписание ) Тогда
			Результат = Ложь;

			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Заполните шаблон сайта.'"),,
			"ШаблонСайтаОписание" );
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено( ОсновнаяОрганизация ) Тогда
			Результат = Ложь;
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Заполните организацию.'"),,
			"ОсновнаяОрганизация" );
		КонецЕсли;

		Если Элементы.ВидЦен.Доступность
		И Не ЗначениеЗаполнено( ВидЦен ) Тогда
			Результат = Ложь;
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Заполните вид цен.'"),,
			"ВидЦен" );
		КонецЕсли;
		
	ИначеЕсли ИмяСтраницы = "СтраницаЗавершение" Тогда
		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура МенюСтраницНастройкиФормыОбновить( ИмяСтраницы ) Экспорт

	Если ИмяСтраницы = "СтраницаТипСайта" Тогда
	
		Элементы.МенюСтраницНазад.Видимость = Ложь;
		Элементы.МенюСтраницВперед.Видимость = Истина;
		Элементы.СоздатьСайт.Видимость = Ложь;
		
	ИначеЕсли ИмяСтраницы = "СтраницаЗавершение" Тогда
	
		Элементы.МенюСтраницНазад.Видимость = Истина;
		Элементы.МенюСтраницВперед.Видимость = Ложь;
		Элементы.СоздатьСайт.Видимость = Истина;

		Элементы.СоздатьСайт.Важность = ВажностьКнопки.Главная;
		Элементы.СоздатьСайт.КнопкаПоУмолчанию = Истина;
		
	Иначе
	
		Элементы.МенюСтраницНазад.Видимость = Истина;
		Элементы.МенюСтраницВперед.Видимость = Истина;
		Элементы.СоздатьСайт.Видимость = Ложь;
		
	КонецЕсли;
	
	Если Элементы.МенюСтраницВперед.Видимость = Истина Тогда
		Элементы.МенюСтраницВперед.Важность = ВажностьКнопки.Главная;
		Элементы.МенюСтраницВперед.КнопкаПоУмолчанию = Истина;
	КонецЕсли;

КонецПроцедуры

