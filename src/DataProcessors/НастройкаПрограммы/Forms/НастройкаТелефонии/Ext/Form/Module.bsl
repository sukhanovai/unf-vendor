	Возврат ИдентификаторОператора = ПредопределенноеЗначение("Перечисление.ДоступныеАТС.УниверсальныйItoolabs");
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОтключитьОператораНаСервере(ИдентификаторОператора)

	НачатьТранзакцию();
	
	Попытка
		
		ИспользуемаяАТС = Перечисления.ДоступныеАТС.ПустаяСсылка();
		Константы.ИспользуемаяАТС.Установить(ИспользуемаяАТС);
		Константы.ИспользуемаяАТСДополнительно.Установить("");
		Константы.ИспользоватьМобильнуюТелефонию.Установить(Ложь);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Отключение оператора: %1'"),
			ИдентификаторОператора);
				
		ЗаписьЖурналаРегистрации(ТекстОшибки, УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			
		ОбщегоНазначения.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
			
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПодключитьОператораНаСервере(ИдентификаторОператора, ЭтоОператорItoolabs)

	Если Не ЗначениеЗаполнено(ИдентификаторОператора) Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	
	Попытка
		
		ЭтоОблачнаяАТС = ЭтоОблачнаяАТС(ИдентификаторОператора) Или ЭтоОператорItoolabs;
		
		ТелефонияСервер.СоздатьИзменитьСлужебногоПользователяТелефонии(ЭтоОблачнаяАТС);
		
		Константы.ИспользоватьОблачнуюТелефонию.Установить(ЭтоОблачнаяАТС);
		
		ИспользоватьРегламентноеОбновлениеПодпискиАТС = ЭтоОблачнаяАТС
			И ИдентификаторОператора = Перечисления.ДоступныеАТС.Билайн;
			
		Константы.ИспользоватьРегламентноеОбновлениеПодпискиАТС.Установить(
			ИспользоватьРегламентноеОбновлениеПодпискиАТС);
		
		Если ЭтоОблачнаяАТС(ИдентификаторОператора) Тогда
			КлючевойПараметрИспользуемойАТС = ИдентификаторОператора;
		ИначеЕсли ЭтоОператорItoolabs Тогда
			КлючевойПараметрИспользуемойАТС = Перечисления.ДоступныеАТС.УниверсальныйItoolabs;
		Иначе
			КлючевойПараметрИспользуемойАТС = Перечисления.ДоступныеАТС.ПустаяСсылка();
		КонецЕсли;
		
		Константы.ИспользуемаяАТС.Установить(КлючевойПараметрИспользуемойАТС);
		
		ИспользоватьМобильнаяТелефония = ЭтоМобильнаяТелефония(ИдентификаторОператора);
		Константы.ИспользоватьМобильнуюТелефонию.Установить(ИспользоватьМобильнаяТелефония);
		
		КлючевойПараметрДополнительнойАТС = ?(ЭтоОператорItoolabs, ИдентификаторОператора, "");
		Константы.ИспользуемаяАТСДополнительно.Установить(КлючевойПараметрДополнительнойАТС);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Выбор оператора: %1'"), ИдентификаторОператора); 
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение;
		
	КонецПопытки;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлагИспользованияВТаблице()
	
	СтрокаОператора = Неопределено;
	
	ПодключенныйОператор = ПодключенныйОператор();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Идентификатор", ПодключенныйОператор);
		
	НайденныеСтроки = Операторы.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() Тогда
		СтрокаОператора = НайденныеСтроки[0];
	КонецЕсли;

	Для Каждого ОбрабатываемаяСтрока Из Операторы Цикл
		ОбрабатываемаяСтрока.Подключен = ОбрабатываемаяСтрока = СтрокаОператора;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПодключенныйОператор()
	
	Результат = Неопределено;
	
	Если ИспользуемаяАТС = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ИспользуемаяАТС = ПредопределенноеЗначение("Перечисление.ДоступныеАТС.УниверсальныйItoolabs") Тогда
		Результат = ИспользуемаяАТСДополнительно;
	Иначе
		Результат = ИспользуемаяАТС;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПерейтиНаСтрокуПодключенногоОператора()
		
	ПодключенныйОператор = ПодключенныйОператор();
	Если ПодключенныйОператор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Идентификатор", ПодключенныйОператор);
	
	НайденныеСтроки = Операторы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() Тогда
		СтрокаОператора = НайденныеСтроки[0];
		Элементы.Операторы.ТекущаяСтрока = СтрокаОператора.ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

