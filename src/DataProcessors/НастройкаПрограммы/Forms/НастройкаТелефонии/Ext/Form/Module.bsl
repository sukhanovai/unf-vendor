
#Область ОписаниеПеременных

&НаКлиенте
Перем ПользователиТелефонииПользовательИзменен;

&НаКлиенте
Перем ПользователиТелефонииВнутреннийНомерИзменен;

&НаКлиенте
Перем ПользователиТелефонииИсходящийНомерИзменен;

&НаКлиенте
Перем ПользователиТелефонииВнутреннийИдентификаторВАТСИзменен;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если МобильныйКлиентУНФ.ФункциональностьВременноНедоступна(Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПрочитатьПользователиТелефонии();
	ПрочитатьЗначенияНастроек();
	
	ЭтоВариантИнтерфейса85 = ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();
	
	// Идентификаторами операторов Itoolabs являются строки
	ОператорыItoolabs = Перечисления.ДоступныеАТС.ДоступныеАТСУниверсальногоВиджетаItoolabs();
	ОператорыItoolabs.Сортировать("Представление Возр");

	ЗаполнитьСсылкиНаСтатьи(ОператорыItoolabs);
	ЗаполнитьТаблицуОператоров(ОператорыItoolabs);	
		
	УстановитьДоступностьЭлементов();	
	ЗаполнитьДействияОбработкиЗвонков();
	
	ВывестиБаннеры();	
	АдаптацияТакси();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДеталиОтключить",  "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДеталиПодключить", "Видимость", Ложь);
	Элементы.ГруппаБаннерМобильнаяТелефония.Видимость = Ложь;
	Элементы.ГруппаСтраницыПараметров.Видимость = Ложь;
	
	УстановитьФлагИспользованияВТаблице();
	ПерейтиНаСтрокуПодключенногоОператора();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбсужденияПодключены" Тогда
		АвтоматическаяОбработкаЗвонков = СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована();
	ИначеЕсли ИмяСобытия = "Запись_НаборКонстант" И Источник = "ОбщиеНастройкиТелефонии" Тогда
		Если ИспользуемаяАТС <> Неопределено
			И ИспользуемаяАТС = ПредопределенноеЗначение("Перечисление.ДоступныеАТС.Билайн") Тогда
			ПроверкаПодпискиНаСобытияАТСБилайн();
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПредложитьВозможностьНажатие(Элемент)
	
	ТекстПисьма = НСтр("ru = 'С какими операторами телефонии вы бы хотели интеграцию?'");
	Тег = НСтр("ru = 'Телефония'");
	
	УправлениеНебольшойФирмойКлиент.ПредложитьВозможностьНажатие(Тег, ТекстПисьма);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_БаннерМобильнойТелефонииОбработкаНавигационнойСсылки(Команда, НавигационнаяСсылка = Неопределено,
	СтандартнаяОбработка = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://dl03.1c.ru/content/SmallBusiness/Extrafiles/Android.zip");
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьДействиеИнформационногоСообщения(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено,
	СтандартнаяОбработка = Неопределено)
	
	ОбщегоНазначенияКлиент.ОбработатьДействиеИнформационногоСообщения(ЭтотОбъект, ЭлементИлиКоманда, НавигационнаяСсылка,
		СтандартнаяОбработка);
		
КонецПроцедуры

&НаКлиенте
Процедура АвтоматическаяОбработкаЗвонковПриИзменении(Элемент)
	
	АвтоматическаяОбработкаЗвонков = СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована();
	НачатьПодключениеОбсуждений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокНеобрабатываемыеТелефонныеНомераНажатие(Элемент)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияВводаНеобрабатываемыхНомеров", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.НеобрабатываемыеТелефонныеНомера.ФормаСписка", , , , , , ОписаниеОповещения);
	
КонецПроцедуры

