&НаКлиенте
Процедура ОбновитьСписокПользователейТелефонииНаКлиенте(ИспользуемаяАТС)

	Если ИспользуемаяАТС = ПредопределенноеЗначение("Перечисление.ДоступныеАТС.Билайн")
		И НастройкиАТС_Билайн <> Неопределено
		И ЗначениеЗаполнено(НастройкиАТС_Билайн[0].Значение) Тогда
		
		СписокАбонентовВАТС = СписокАбонентовВАТС();

		Элементы.ГруппаПользователиТелефонии.ПодчиненныеЭлементы.ПользователиТелефонии.ПодчиненныеЭлементы.ПользователиТелефонииВнутреннийНомер.СписокВыбора.Очистить();
		Если СписокАбонентовВАТС <> Неопределено Тогда
			Для каждого Абонент Из СписокАбонентовВАТС Цикл
				Элементы.ГруппаПользователиТелефонии.ПодчиненныеЭлементы.ПользователиТелефонии.ПодчиненныеЭлементы.ПользователиТелефонииВнутреннийНомер.СписокВыбора.Добавить(Строка(Абонент.Представление), Строка(Абонент.Представление));
				СписокАбонентов.Добавить(Строка(Абонент.Представление), Строка(Абонент.Значение));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

