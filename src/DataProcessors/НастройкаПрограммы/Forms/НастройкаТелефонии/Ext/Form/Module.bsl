	ПользователиТелефонииИсходящийНомерИзменен = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПользователиТелефонииВнутреннийНомерОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ИспользуемаяАТС = ПредопределенноеЗначение("Перечисление.ДоступныеАТС.Билайн") Тогда
		Элементы.ПользователиТелефонии.ТекущиеДанные.ВнутреннийИдентификаторВАТС =
			СписокАбонентов.НайтиПоЗначению(ВыбранноеЗначение).Представление;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПользователиТелефонииВнутреннийИдентификаторВАТСПриИзменении(Элемент)
	ПользователиТелефонииВнутреннийИдентификаторВАТСИзменен = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПользователиТелефонииПользовательОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные,
	ВыборДобавлением, СтандартнаяОбработка)

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Пользователь", ВыбранноеЗначение);
	НайденныеСтроки = ПользователиТелефонии.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьПредупреждение(, НСтр("ru='Пользователь уже присутствует в списке'"));
		ВыбранноеЗначение = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОБработчикиСобытийЭлементовТаблицыФормыОператоры

&НаКлиенте
Процедура ОператорыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ОбновитьКарточкуВыбранногоОператора", 0.3, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОператорыПриНаведении(Элемент, Строка, Поле)
	
	Если Не ЭтоВариантИнтерфейса85 Тогда
		Возврат;
	КонецЕсли;
	
	Если Строка = Неопределено Тогда
		ДанныеСтроки = Элемент.ТекущиеДанные;
	Иначе
		ДанныеСтроки =  Элемент.ДанныеСтроки(Строка);
	КонецЕсли;
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СписокПодключитьОператора.Доступность = Не ДанныеСтроки.Подключен;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИнструкцияПубликацияИБ(Команда)
	
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(ИнструкцияПубликацииСервисаТелефонии());
		
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПубликацииСервисов(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьНастройкуПубликацииHttpСервисовЗавершение", ЭтотОбъект);
	ОткрытьФорму("Обработка.ОбщиеНастройкиТелефонии.Форма", , , , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОператораСписок(Команда)
	
	ПодключитьОператораПоТекущимДанным();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеталиПодключить(Команда)

	ПодключитьОператораПоТекущимДанным();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура Отключить(Команда)
	
	ТекущиеДанные = Элементы.Операторы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(
		НСтр("ru='Отключить ""%1""?'"), ТекущиеДанные.Представление);
		
	Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОператораНаСервере(ИспользуемаяАТС);
	Оповестить("Запись_НаборКонстант");
	
	ИспользуемаяАТС = Неопределено;
	ИспользуемаяАТСДополнительно = "";
	
	// Реквизиты формы
	ПризнакиИспользованияАТС = ПризнакиИспользованияАТС();
	Для Каждого КлючИЗначение Из ПризнакиИспользованияАТС Цикл
		ЭтотОбъект[КлючИЗначение.Ключ] = Ложь;
	КонецЦикла;
	
	ПрочитатьЗначенияНастроек();
	УстановитьОтметкуПодключенногоОператораВСписке();
	ОбновитьКарточкуВыбранногоОператора(); 

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтраницуОператора(Команда)
	
	Если Не ПустаяСтрока(СсылкаНаСтатьюОператора) Тогда
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(СсылкаНаСтатьюОператора);
	КонецЕсли;
	
КонецПроцедуры

