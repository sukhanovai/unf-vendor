Процедура ДействиеПропущенныйЗвонокПриИзменении(Элемент)
	
	ЗаписатьЗначениеОбщейНастройкиТелефонии("ДействиеПропущенногоЗвонка", ДействиеПропущенныйЗвонок);
	ОбновитьПовторноИспользуемыеЗначения();

	Элементы.СлужебныйПользователь.Видимость = ДействиеПропущенныйЗвонок <> "ПоследнегоОтклонившегоЗвонок";
	Если ДействиеПропущенныйЗвонок = "ПоследнегоОтклонившегоЗвонок" Тогда
		ЗаписатьЗначениеОбщейНастройкиТелефонии("СлужебныйПользовательДляПропущенногоЗвонка",
			ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка"));
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;
	
