#Область ОписаниеПеременных

&НаКлиенте
Перем ЗапущеноЗаданиеОбновленияСкладов;

&НаКлиенте
Перем ТекущийСклад;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если МобильныйКлиентУНФ.ФункциональностьВременноНедоступна(Отказ) Тогда
    	Возврат;
  	КонецЕсли;

    // служебный вызов для удаления устаревших записей в логе
    ОбменСВнешнимиСистемамиЛогирование.ЛогЗаписиСтарыеПоВсемУчетнымЗаписямОчиститьЧерезФоновоеЗадание();
    
	Если ЗначениеЗаполнено( Параметры.УчетнаяЗапись ) Тогда
		ЗначениеВРеквизитФормы( Параметры.УчетнаяЗапись.ПолучитьОбъект(), "Объект" );
	КонецЕсли;

	УчетнаяЗапись = Объект.Ссылка;
	
	Если Не ЗначениеЗаполнено(Объект.ВалютаУчета) Тогда
		Объект.ВалютаУчета = ИнтеграцияСМаркетплейсомOzonСервер.ВалютаРегламентированногоУчетаОрганизации( Объект.Организация );
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ВидМаркетплейса) Тогда
		Объект.ВидМаркетплейса = Перечисления.ВидыМаркетплейсов.МаркетплейсWildberries;
	КонецЕсли;
	ВидМаркетплейса = Перечисления.ВидыМаркетплейсов.МаркетплейсWildberries;
	
	МенюСтраницПараметры = КаналыПродажКлиентСервер.МенюСтраницПараметрыНовый();
	МенюСтраницПараметры.СтрокиОтмечатьКорректноЗаполненные = Не Объект.НастройкаЗавершена;
	МенюСтраницПараметры.КнопкаНазадИспользование = Ложь;
	МенюСтраницПараметры.КнопкаВпередИспользование = Ложь;
	МенюСтраницПараметры.ВысотаВСтрокахТаблицы = 7;
	
	КаналыПродажСервер.МенюСтраницИнициализация( ЭтотОбъект, МенюСтраницПараметры );
    
    Если Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
    	ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Верх;
    	КоманднаяПанель.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
    КонецЕсли;

	БаннерыДобавитьИПоказать();
    
	РазделениеВключено = РаботаВМоделиСервиса.РазделениеВключено();
	НастроитьРасписаниеРегламентногоЗадания = НСтр("ru = 'Настроить расписание регламентного задания'");

	ФормаЭлементыОтборыУстановить(УчетнаяЗапись);
	
	НастройкиУчетнойЗаписи = Справочники.УчетныеЗаписиМаркетплейсов.НастройкиУчетнойЗаписи(УчетнаяЗапись);
	НастройкиУчетнойЗаписи.ВидыЦен.Свойство(ИнтеграцияСМаркетплейсамиКлиентСервер.ИмяВидЦеныДоСкидок(), ВидЦеныДоСкидок);
	НастройкиУчетнойЗаписи.ВидыЦен.Свойство(ИнтеграцияСМаркетплейсамиКлиентСервер.ИмяВидЦеныСоСкидкойПродавца(), ВидЦеныСУчетомСкидок);
	НастройкиУчетнойЗаписи.ВидыЦен.Свойство(ИнтеграцияСМаркетплейсамиКлиентСервер.ИмяВидЦеныКлубная(), ВидЦеныМинимальныхЦен);

	Если СостояниеНастроек.Количество() = 0 Тогда
		ДобавитьНастройкиСоздания();
	КонецЕсли;
    
    Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
    	ТекПользователь = Пользователи.ТекущийПользователь();
		ОсновнаяОрганизация = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(ТекПользователь, "ОсновнаяОрганизация");
		Если НЕ ЗначениеЗаполнено(ОсновнаяОрганизация) Тогда
			ОсновнаяОрганизация = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		Объект.Организация = ОсновнаяОрганизация;
	КонецЕсли;

	ШрифтыИзЭлементовСтиля = ШрифтыЭлементовСтиляПолучить();

	Элементы.НастроитьРасписаниеРегламентногоЗадания.Доступность = Объект.ИспользоватьРегламентныеЗадания;
	
	ОбновитьОтображениеНаСервере();

    ФормаКнопкиПоУмолчаниюЗаполнить();
	
	НовыйКэшированныеЗначения();
	УстановитьУсловноеОформление();
	ИнициализацияЦеныОстаткиТоваровМП();
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ВыполнитьДлительныеОперацииПолучитьОсновныеДанныеУчетнойЗаписи();
	КонецЕсли;

	НоменклатураПартнеров.Параметры.УстановитьЗначениеПараметра("УчетнаяЗапись", УчетнаяЗапись);
	ЦеныОстаткиТоваровМП.Параметры.УстановитьЗначениеПараметра("УчетнаяЗаписьМаркетплейса", УчетнаяЗапись);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьОтображениеНаКлиенте();
	
	Если Объект.НастройкаЗавершена Тогда
		КаналыПродажКлиент.МенюСтраницПерейти( ЭтотОбъект, "СтраницаТовары" );
	КонецЕсли;
	
	ЗапущеноЗаданиеОбновленияСкладов = Ложь;
	
	// Если новая настройка интеграции, то скроем видимость 
	// некоторых элементов для исключения скроллинга начальной формы
	Если НЕ Объект.НастройкаЗавершена Тогда
		Если Объект.СостояниеНастроек.Количество() > 0 Тогда
			СостояниеНастроекСтрока = Объект.СостояниеНастроек[0];
			Если СостояниеНастроекСтрока.ИмяСтраницы = "Приветствие"
			И СостояниеНастроекСтрока.Статус = 1 Тогда
				ФормаЭлементыДляНовойНастройкиИнтеграцииВидимостьУстановить( Ложь );
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
    
    Если Объект.НастройкаЗавершена Тогда
		ПодключитьОбработчикОжидания("Подключаемый_СинхронизироватьОстатки", 180, Истина);
		ПодключитьОбработчикОжидания("Подключаемый_СинхронизироватьЦены", 180, Истина);
		
		Обработчик = Новый ОписаниеОповещения("Подключаемый_ЦеныОжиданиеПолученияСтраницыДанных", ЭтотОбъект);
		УведомленияКлиента.ПодключитьОбработчик("Маркетплейсы_ЗавершениеМенеджерДлительныхОпераций", Обработчик);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Кэш.ПараметрыМенеджераДлительныхОпераций) Тогда
		НачатьВыполнениеДлительныхОперацийПродолжение(Истина, Кэш.ПараметрыМенеджераДлительныхОпераций, Неопределено);
		Кэш.ПараметрыМенеджераДлительныхОпераций = Неопределено;
	КонецЕсли;
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСписокПодключений" Тогда
		УчетнаяЗапись = Объект.Ссылка;
	ИначеЕсли ИмяСобытия = "Маркетплейсы_ЗавершениеМенеджерДлительныхОпераций" Тогда
		
		Если Источник.ИдентификаторНазначения = УникальныйИдентификатор Тогда
			ОбработатьРезультатДлительныхОпераций(Параметр, Источник);
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "Wildberries_ОбновлениеНастроек" Тогда
		
		ПолучитьУчетныеЗаписи("ОбновленыНастройки");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом	
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	УчетнаяЗапись = Объект.Ссылка;
	
	ФормаЭлементыОтборыУстановить(ТекущийОбъект.Ссылка);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	НоменклатураПартнеров.Параметры.УстановитьЗначениеПараметра("УчетнаяЗапись", УчетнаяЗапись);
	ЦеныОстаткиТоваровМП.Параметры.УстановитьЗначениеПараметра("УчетнаяЗаписьМаркетплейса", УчетнаяЗапись);
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПриЗаписиНаСервере(Знач ОписаниеУчетнойЗаписи, Знач ДанныеФормы, УзелОбмена)
	
	Если Не ЗначениеЗаполнено(ОписаниеУчетнойЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(УзелОбмена) Тогда
		
		// Создадим узел для сервиса интеграции по учетной записи
		УзелОбмена = НайтиСоздатьУзелОбменаСИ(ОписаниеУчетнойЗаписи.УчетнаяЗапись, ОписаниеУчетнойЗаписи.Представление,
			Истина);
		
		// Всю иерархию групп складов сразу зафиксируем на плане обмена.
		// Элементы будем фиксировать по мере их сопоставления со складами маркетплейсов
		Склады = Новый Массив;
		ПолучитьИерархиюСкладов(Склады);
		Если Склады.Количество() > 0 Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Склады);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользоватьРегламентныеЗаданияПриИзменении(Элемент)
	Элементы.НастроитьРасписаниеРегламентногоЗадания.Доступность = Объект.ИспользоватьРегламентныеЗадания;
КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьОстаткиПриИзменении(Элемент)
	ОбновитьОтображениеНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьЦеныПриИзменении(Элемент)
	ОбновитьОтображениеНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасписаниеВыгрузкиОстатковТоваровНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите учетную запись.'"), , "УчетнаяЗапись");
		Возврат;
	КонецЕсли;
	
	ОписаниеУчетнойЗаписи = Кэш.УчетныеЗаписи.Получить(УчетнаяЗапись);
	
	Если ОписаниеУчетнойЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УчетнаяЗаписьМаркетплейса", УчетнаяЗапись);
	ПараметрыФормы.Вставить("Наименование", ИнтеграцияСМаркетплейсамиСИКлиентСервер.ПредставлениеЗаданияРасчетОстатковТоваров(ВидМаркетплейса));
	ПараметрыФормы.Вставить("ИмяМетаданных", "ВыгрузкаОстатковНаМаркетплейсы");
	ПараметрыФормы.Вставить("Префикс", ИнтеграцияСМаркетплейсамиСИКлиентСервер.ПрефиксЗаданияРасчетОстатковТоваров(ВидМаркетплейса));
	ПараметрыФормы.Вставить("ОткрыватьПодОграниченнымиПравами", Истина);
	
	ОткрытьФорму("Справочник.УчетныеЗаписиМаркетплейсов.Форма.РегламентноеЗадание", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасписаниеВыгрузкиЦенТоваровНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите учетную запись.'"), , "УчетнаяЗапись");
		Возврат;
	КонецЕсли;
	
	ОписаниеУчетнойЗаписи = Кэш.УчетныеЗаписи.Получить(УчетнаяЗапись);
	
	Если ОписаниеУчетнойЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УчетнаяЗаписьМаркетплейса", УчетнаяЗапись);
	ПараметрыФормы.Вставить("Наименование", ИнтеграцияСМаркетплейсамиСИКлиентСервер.ПредставлениеЗаданияВыгрузкаЦенНаМаркетплейсы(ВидМаркетплейса));
	ПараметрыФормы.Вставить("ИмяМетаданных", "ВыгрузкаЦенНаМаркетплейсы");
	ПараметрыФормы.Вставить("Префикс", ИнтеграцияСМаркетплейсамиСИКлиентСервер.ПрефиксЗаданияВыгрузкаЦенНаМаркетплейсы(ВидМаркетплейса));
	ПараметрыФормы.Вставить("ОткрыватьПодОграниченнымиПравами", Истина);
	
	ОткрытьФорму("Справочник.УчетныеЗаписиМаркетплейсов.Форма.РегламентноеЗадание", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура АвтоКоррекцияОстатковПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Объект.АвтоКоррекцияОстатков = Ложь;
	Иначе
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АвтоКоррекцияЦенПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Объект.АвтоКоррекцияЦен = Ложь;
	Иначе
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СостояниеВСервисеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "Показать" Тогда
		ПоказатьПредупреждение( , Элементы.СостояниеВСервисе.Подсказка);
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОткрытьНастройкиWildberriesНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю( НСтр("ru = 'Заполните поле ""Организация""'"),, "Организация", "Объект");
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	Объект.ИдентификаторКлиента = Объект.Организация.УникальныйИдентификатор();
	Если ПустаяСтрока( Объект.Наименование ) Тогда
		Объект.Наименование = Строка(Объект.Организация) + " ( " + Строка(Объект.ИдентификаторКлиента) + " )";
	КонецЕсли;
	Если Не ЗначениеЗаполнено( Объект.ДатаСоздания ) Тогда
		Объект.ДатаСоздания = ОбщегоНазначенияКлиент.ДатаСеанса();
	КонецЕсли;
	
	Записать();
	
	УчетнаяЗапись = Объект.Ссылка;
	
	ПараметрыФормы = ИнтеграцияСМаркетплейсамиСИКлиент.НовыеПараметрыФормыСервисаМаркетплейсы();
	ПараметрыФормы.ИмяФормы = "Обработка.МаркетплейсWildberries.Форма.ПодключениеКСервису";
	ПараметрыФормы.ВидМаркетплейса = ПредопределенноеЗначение("Перечисление.ВидыМаркетплейсов.МаркетплейсWildberries");
	ПараметрыФормы.РежимОткрытияОкнаФормы = РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца;
	ПараметрыФормы.Организация = Объект.Организация;
	
	ПараметрыФормы.УчетнаяЗапись = Объект.Ссылка;
	
	ДополнительныеПараметры = ИнтеграцияСМаркетплейсамиСИКлиент.НовыеДополнительныеПараметрыФормыСервисаМаркетплейсы();
	ДополнительныеПараметры.ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения( "НастройкиПодключенияПослеЗакрытия", ЭтотОбъект );
	
	ИнтеграцияСМаркетплейсамиСИКлиент.ОткрытьФормуСервисаМаркетплейсы(ПараметрыФормы, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработатьДействиеИнформационногоСообщения(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
    
    СтандартнаяОбработка = Ложь;
    
	Если НавигационнаяСсылка = "seller_wildberries_ru" Тогда
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку( "https://seller.wildberries.ru/" );
	Иначе
