		Если НЕ ЗначениеЗаполнено(Объект.Партнер) Тогда
			Результат = Ложь;
		КонецЕсли;
		
		Если Не УчетнаяЗаписьПодключена Тогда
			Результат = Ложь;
		КонецЕсли;
		
	ИначеЕсли ИмяСтраницы = "СтраницаСклады" Тогда

	
	ИначеЕсли ИмяСтраницы = "СтраницаЦены" Тогда
		
		Если Объект.ВыгружатьЦены Тогда
			Если НЕ ЗначениеЗаполнено(ВидЦеныДоСкидок)
				Или НЕ ЗначениеЗаполнено(ВидЦеныСУчетомСкидок)
				Или НЕ ЗначениеЗаполнено(ВидЦеныМинимальныхЦен) Тогда
				
				Результат = Ложь;
				
			КонецЕсли;
		КонецЕсли;
	
	ИначеЕсли ИмяСтраницы = "СтраницаТовары" Тогда
	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

