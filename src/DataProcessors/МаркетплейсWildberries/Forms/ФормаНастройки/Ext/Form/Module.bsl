	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СкладыМаркетплейсаСхемаРаботыСклада.Имя);
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
