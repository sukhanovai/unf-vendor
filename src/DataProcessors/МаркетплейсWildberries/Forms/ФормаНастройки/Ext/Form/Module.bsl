КонецФункции

&НаКлиенте
Процедура ОбновитьОтображениеНаКлиенте()
	
	Если НЕ Объект.НастройкаЗавершена Тогда
		
		ЕстьПереходПоСтранице = Ложь;
		Для Каждого Стр Из Объект.СостояниеНастроек Цикл
			
			Если Стр.Статус = 1 Тогда
				ЕстьПереходПоСтранице = Истина;
				Элементы.СтраницыПунктыМеню.ТекущаяСтраница = Элементы["Страница" + Стр.ИмяСтраницы];
			КонецЕсли;
			
		КонецЦикла;
		
		ТекущаяСтраницаИмя = Элементы.СтраницыПунктыМеню.ТекущаяСтраница.Имя;
		КаналыПродажКлиентСервер.МенюСтраницТекущаяСтрокаУстановить( ЭтотОбъект, ТекущаяСтраницаИмя );
		
		ФормаКнопкаПоУмолчаниюВключить( ТекущаяСтраницаИмя );
		
		Если Не ЕстьПереходПоСтранице Тогда
			Объект.НастройкаЗавершена = Истина;
			Записать();
			ОбновитьОтображениеНаСервере();
		КонецЕсли;
	КонецЕсли;

	Если Объект.НастройкаЗавершена Тогда
		Элементы.ФормаЗаписатьИзмененияИЗакрыть.КнопкаПоУмолчанию = Истина;
		Элементы.ФормаЗаписатьИзмененияИЗакрыть.Важность = ВажностьКнопки.Главная;
	КонецЕсли;
	
	// остатки
	Элементы.ГруппаНастройкиСкладов.Доступность = Объект.ВыгружатьОстатки;
	Элементы.ОстаткиТоваровМПРассчитать.Доступность = Объект.ВыгружатьОстатки;
	Элементы.ОстаткиТоваровМППолныйПересчет.Доступность = Объект.ВыгружатьОстатки;
	
	// цены
	Элементы.ГруппаВидыЦен.Доступность = Объект.ВыгружатьЦены;
	Элементы.ЦеныТоваровМППолныйПересчет.Доступность = Объект.ВыгружатьЦены;
	Элементы.ЦеныТоваровМПРассчитать.Доступность = Объект.ВыгружатьЦены;
	
КонецПроцедуры

