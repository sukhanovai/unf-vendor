	Иначе
		ТекНастройка = Объект.СостояниеНастроек.Добавить();
	КонецЕсли;
	
	ТекНастройка.ИмяСтраницы = ИмяСтраницы;
	ТекНастройка.Статус = Статус;
	
	КаналыПродажКлиентСервер.МенюСтраницДоступностьСтраницыДляПереключенияУстановить( ЭтотОбъект, "Страница" + ИмяСтраницы, Статус > 0 );
