#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	
	УстановитьПодменюПодсистемыПечати();
	
	// КомандыПечатиЗаказов
	ИспользоватьШаблоныПечатиКП = ПолучитьФункциональнуюОпцию("ИспользоватьШаблоныПечатиОфисныхДокументов");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодменюКоммерческоеПредложениеЗаказов", "Видимость", ИспользоватьШаблоныПечатиКП);
	// Конец КомандыПечатиЗаказов
	
	// УНФ.ОтборыСписка
	ОпределитьПорядокПредопределенныхОтборовНаСервере();
	ВосстановитьОтборыСписковПриСозданииНаСервере();
	// Конец УНФ.ОтборыСписка
	
	УстановитьУсловноеОформлениеПоЦветамСостоянийСервер();
	СписокЗаказов.Параметры.УстановитьЗначениеПараметра("АктуальнаяДатаСеанса", НачалоДня(ТекущаяДатаСеанса()));
	
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(Список);
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(СписокЗаказов);
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(СписокОтчетПереработчика);
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(СписокРасходнаяНакладная);
	
	// УНФ.ПанельКонтактнойИнформации
	КонтактнаяИнформацияПанельУНФ.ПриСозданииНаСервере(ЭтотОбъект, "КонтактнаяИнформацияОтчетПереработчика",
		"СписокОтчетПереработчикаКонтекстноеМеню");
	// Конец УНФ.ПанельКонтактнойИнформации
	
	ВремяЗадержкиОбработчиковОжидания = 0.3;
	АдаптацияТакси();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВремяЗадержкиОбработчиковОжидания = ДокументыУНФКлиент.ВремяЗадержкиОбработчиковОжидания();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если НЕ ЗавершениеРаботы Тогда
		//УНФ.ОтборыСписка
		СохранитьНастройкиОтборов();
		//Конец УНФ.ОтборыСписка
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// УНФ.ПанельКонтактнойИнформации
	Если КонтактнаяИнформацияПанельУНФКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьПанельКонтактнойИнформации();
	КонецЕсли;
	// Конец УНФ.ПанельКонтактнойИнформации
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПредставлениеПериодаТаксиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	РаботаСОтборамиКлиент.ПредставлениеПериодаВыбратьПериод(ЭтотОбъект, ИмяСписка(), "Дата", СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	РаботаСОтборамиКлиент.ПредставлениеПериодаВыбратьПериод(ЭтотОбъект, ИмяСписка(), "Дата", СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначокФильтрыНажатие(Элемент)
	
	СвернутьРазвернутьПанельОтборов();
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект);
	ТекущаяСтраница = Элементы[СтруктураИменЭлементов.ФильтрыНастройкиИДопИнфо];
	Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

&НаКлиенте
Процедура ИндексФильтрыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СвернутьРазвернутьПанельОтборов();
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект);
	ТекущаяСтраница = Элементы[СтруктураИменЭлементов.ФильтрыНастройкиИДопИнфо];
	Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначокКонтактыНажатие(Элемент)
	
	СвернутьРазвернутьПанельОтборов();
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект);
	ТекущаяСтраница = Элементы[СтруктураИменЭлементов.Контакты];
	Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].ТекущаяСтраница = ТекущаяСтраница;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокОтчетПереработчикаПриАктивизацииСтроки(Элемент)
	
	ЭтотОбъект.КИ_НужноИзменитьДанныеПриАктивизацииСтрокиТаблицы =
	КонтактнаяИнформацияПанельУНФКлиент.НужноИзменитьКонтактнуюИнформациюПриАктивизацииСтрокиТаблицы(
	ЭтотОбъект, Элемент, ТекущийКонтрагент, "Контрагент");
	
	Если ЭтотОбъект.КИ_НужноИзменитьДанныеПриАктивизацииСтрокиТаблицы Тогда
		ПодключитьОбработчикОжидания("СписокПриАктивизацииСтрокиОбработчик", ВремяЗадержкиОбработчиковОжидания, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Если Копирование Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Параметр) Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;

	СтруктураПараметров = Новый Структура;
	РаботаСФормойДокументаКлиент.ДобавитьПоследнееЗначениеОтбораПоля(ДанныеМеток, СтруктураПараметров, "Контрагент");
	РаботаСФормойДокументаКлиент.ДобавитьПоследнееЗначениеОтбораПоля(ДанныеМеток, СтруктураПараметров, "Организация");

	ИмяФормыСтрока = РаботаСФормойДокументаКлиент.ИмяДокументаПоТипу(Параметр);

	ВидОперации = Неопределено;

	Если ИмяФормыСтрока = "ЗаказПоставщику" Тогда
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказПоставщику.ЗаказНаПереработку");
	ИначеЕсли ИмяФормыСтрока = "РасходнаяНакладная" Тогда
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходнаяНакладная.ПередачаВПереработку");
	КонецЕсли;

	СтруктураПараметров.Вставить("ВидОперации", ВидОперации);

	ОткрытьФорму("Документ." + ИмяФормыСтрока + ".ФормаОбъекта", Новый Структура("ЗначенияЗаполнения",
		СтруктураПараметров));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НастроитьОтборы(Команда)
	
	ИмяМетки = СтрЗаменить(ЭтотОбъект.ТекущийЭлемент.Имя, "НастроитьОтборы", "");
	
	ИмяРеквизитаСписка = "Список" + ИмяМетки;
	ИмяТЧДанныеМеток = "ДанныеМеток" + ИмяМетки;
	ИмяТЧДанныеОтборов = "ДанныеОтборов" + ИмяМетки;
	ИмяГруппыОтборов = "ГруппаОтборы" + ИмяМетки;
	ИмяПредопределенныеОтборыПоУмолчанию = "ПредопределенныеОтборыПоУмолчанию" + ИмяМетки;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяРеквизитаСписка", ИмяРеквизитаСписка);
	ДополнительныеПараметры.Вставить("ИмяТЧДанныеМеток", ИмяТЧДанныеМеток);
	ДополнительныеПараметры.Вставить("ИмяТЧДанныеОтборов", ИмяТЧДанныеОтборов);
	ДополнительныеПараметры.Вставить("ИмяГруппыОтборов", ИмяГруппыОтборов);
	ДополнительныеПараметры.Вставить("ИмяПредопределенныеОтборыПоУмолчанию", ИмяПредопределенныеОтборыПоУмолчанию);
	
	РаботаСОтборамиКлиент.НастроитьОтборыНажатие(ЭтотОбъект, ПараметрыОткрытияФормыСНастройкамиОтборов(ДополнительныеПараметры), ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьВсеОтборы(Команда)
	
	ИмяМетки = СтрЗаменить(ЭтотОбъект.ТекущийЭлемент.Имя, "СброситьВсеОтборы", "");
	
	ИмяРеквизитаСписка = "Список" + ИмяМетки;
	ИмяТЧДанныеМеток = "ДанныеМеток" + ИмяМетки;
	ИмяТЧДанныеОтборов = "ДанныеОтборов" + ИмяМетки;
	
	СтруктураИменЭлементовПанелиОтборов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект);
	
	РаботаСОтборамиКлиент.СброситьОтборПоПериоду(ЭтотОбъект, ИмяРеквизитаСписка, "Дата", СтруктураИменЭлементовПанелиОтборов);
	СброситьВсеМеткиОтбораНаСервере(ИмяРеквизитаСписка, ИмяТЧДанныеМеток, СтруктураИменЭлементовПанелиОтборов, ИмяТЧДанныеОтборов);
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьПравуюПанель(Команда)
	СвернутьРазвернутьПанельОтборов();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиБиблиотек

// СтандартныеПодсистемы.ПодключаемыеКоманды
//@skip-warning
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ИмяТекущегоСписка = ИмяСписка();
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы[ИмяТекущегоСписка]);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ИмяТекущегоСписка = ИмяСпискаСервер();
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы[ИмяТекущегоСписка], Результат);
КонецПроцедуры

//@skip-warning
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ИмяТекущегоСписка = ИмяСписка();
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы[ИмяТекущегоСписка]);
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область ПанельКонтактнойИнформации

&НаКлиенте
Процедура Подключаемый_ОбработатьАктивизациюСтрокиСписка()

	ОбновитьПанельКонтактнойИнформации();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПанельКонтактнойИнформации()

	ДанныеПанелиКИ = ДанныеПанелиКонтактнойИнформации(ТекущийКонтрагент);
	КонтактнаяИнформацияПанельУНФКлиент.ЗаполнитьДанныеПанелиКИ(ЭтотОбъект, ДанныеПанелиКИ);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеПанелиКонтактнойИнформации(Контрагент)

	Возврат КонтактнаяИнформацияПанельУНФ.ДанныеПанелиКонтактнойИнформации(Контрагент);

КонецФункции

//@skip-warning
&НаКлиенте
Процедура Подключаемый_ДанныеПанелиКонтактнойИнформацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	КонтактнаяИнформацияПанельУНФКлиент.ДанныеПанелиКонтактнойИнформацииВыбор(ЭтотОбъект, Элемент, ВыбраннаяСтрока,
		Поле, СтандартнаяОбработка);

КонецПроцедуры

//@skip-warning
&НаКлиенте
Процедура Подключаемый_ДанныеПанелиКонтактнойИнформацииПриАктивизацииСтроки(Элемент)

	КонтактнаяИнформацияПанельУНФКлиент.ДанныеПанелиКонтактнойИнформацииПриАктивизацииСтроки(ЭтотОбъект, Элемент);

КонецПроцедуры

//@skip-warning
&НаКлиенте
Процедура Подключаемый_ДанныеПанелиКонтактнойИнформацииВыполнитьКоманду(Команда)

	КонтактнаяИнформацияПанельУНФКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, ТекущийКонтрагент);

КонецПроцедуры

#КонецОбласти

#Область Отборы

&НаСервере
Процедура ОпределитьПорядокПредопределенныхОтборовНаСервере()

	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект);
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыОтчетПереработчика",
		"ПредопределенныеОтборыПоУмолчаниюОтчетПереработчика");
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыЗаказов",
		"ПредопределенныеОтборыПоУмолчаниюЗаказов");
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыРасходнаяНакладная",
		"ПредопределенныеОтборыПоУмолчаниюРасходнаяНакладная");

КонецПроцедуры

&НаКлиенте
Процедура СвернутьРазвернутьПанельОтборов()
	
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект);
	НовоеЗначениеВидимость = НЕ Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].Видимость;
	РаботаСОтборамиКлиент.СвернутьРазвернутьПанельОтборов(ЭтотОбъект, НовоеЗначениеВидимость, СтруктураИменЭлементов);
	
	//Обход проблемы: Количество фильтров индекс
	ЗначениеКоличествоФильтров = ЭтотОбъект[СтруктураИменЭлементов.ИмяРеквизитаКоличествоФильтров];
	ТекстовыйЗаголовокИндексаФильтров = СтрШаблон("(%1)", ЗначениеКоличествоФильтров);
	Элементы[СтруктураИменЭлементов.ИндексФильтрыТакси].Заголовок = ТекстовыйЗаголовокИндексаФильтров;
	ВидимостьЗначков = Не НовоеЗначениеВидимость И ЗначениеКоличествоФильтров <> 0;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, СтруктураИменЭлементов.ИндексыФильтры, "Видимость", ВидимостьЗначков);
	//Обход проблемы: Количество фильтров индекс
	ЭтотОбъект[СтруктураИменЭлементов.ИмяРеквизитаКоличествоФильтровИндекс] = Мин(ЗначениеКоличествоФильтров, 10);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьОтборыСписковПриСозданииНаСервере()
	
	// Обход проблемы: Ширина панели
	Интерфейс85 = ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	ШиринаПанели = ?(Интерфейс85, 37, 35);
	
	// РасходнаяНакладная
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект, "РасходнаяНакладная");
	РаботаСОтборами.ВосстановитьНастройкиОтборов(ЭтотОбъект, СписокРасходнаяНакладная, "СписокРасходнаяНакладная", СтруктураИменЭлементов,,,, "ДанныеМетокРасходнаяНакладная",, "ДанныеОтборовРасходнаяНакладная", "ГруппаОтборыРасходнаяНакладная");
	
	// Обход проблемы: Картинка фильтры
	Элементы[СтруктураИменЭлементов.ФильтрыНастройкиИДопИнфо].Картинка = БиблиотекаКартинок.ФильтрПустой;
	// Обход проблемы: Ширина панели
	Элементы[СтруктураИменЭлементов.ПраваяПанель].Ширина = 0;
	Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].Ширина = ШиринаПанели;
	// Обход проблемы: Свернутая панель
	Если Не Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].Видимость Тогда
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].Отображение = ОтображениеКнопки.Картинка;
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Развернуть правую панель'");
	Иначе
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].Отображение = ОтображениеКнопки.КартинкаИТекст;
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Свернуть правую панель'")
	КонецЕсли;
	
	// Заказы поставщикам
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект, "Заказов");
	РаботаСОтборами.ВосстановитьНастройкиОтборов(ЭтотОбъект, СписокЗаказов, "СписокЗаказов", СтруктураИменЭлементов,,,, "ДанныеМетокЗаказов",, "ДанныеОтборовЗаказов", "ГруппаОтборыЗаказов");
	
	// Обход проблемы: Картинка фильтры
	Элементы[СтруктураИменЭлементов.ФильтрыНастройкиИДопИнфо].Картинка = БиблиотекаКартинок.ФильтрПустой;
	// Обход проблемы: Ширина панели
	Элементы[СтруктураИменЭлементов.ПраваяПанель].Ширина = 0;
	Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].Ширина = ШиринаПанели;
	// Обход проблемы: Свернутая панель
	Если Не Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].Видимость Тогда
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].Отображение = ОтображениеКнопки.Картинка;
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Развернуть правую панель'");
	Иначе
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].Отображение = ОтображениеКнопки.КартинкаИТекст;
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Свернуть правую панель'")
	КонецЕсли;
	
	// ОтчетПереработчика
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект, "ОтчетПереработчика");
	РаботаСОтборами.ВосстановитьНастройкиОтборов(ЭтотОбъект, СписокОтчетПереработчика, "СписокОтчетПереработчика", СтруктураИменЭлементов,,,, "ДанныеМетокОтчетПереработчика",, "ДанныеОтборовОтчетПереработчика", "ГруппаОтборыОтчетПереработчика");
	
	// Обход проблемы: Картинка фильтры
	Элементы[СтруктураИменЭлементов.ФильтрыНастройкиИДопИнфо].Картинка = БиблиотекаКартинок.ФильтрПустой;
	// Обход проблемы: Ширина панели
	Элементы[СтруктураИменЭлементов.ПраваяПанель].Ширина = 0;
	Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].Ширина = ШиринаПанели;
	// Обход проблемы: Свернутая панель
	Если Не Элементы[СтруктураИменЭлементов.ПраваяПанельСтраницы].Видимость Тогда
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].Отображение = ОтображениеКнопки.Картинка;
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Развернуть правую панель'");
	Иначе
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].Отображение = ОтображениеКнопки.КартинкаИТекст;
		Элементы[СтруктураИменЭлементов.СвернутьПравуюПанель].РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Свернуть правую панель'")
	КонецЕсли;
	
	// Обход проблемы: Свернутая панель
	Элементы.СвернутьПравуюПанель.Отображение = ОтображениеКнопки.Авто;
	Элементы.СвернутьПравуюПанель.РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Свернуть правую панель'");
	
	// Журнал
	РаботаСОтборами.ВосстановитьНастройкиОтборов(ЭтотОбъект, Список, "Список");
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиОтборов()
	
	// Журнал
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект, "Страница");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "Список", СтруктураИменЭлементов,,, "ДанныеМеток", "ДанныеОтборов", "ГруппаОтборы");
	
	// РасходнаяНакладная
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект, "РасходнаяНакладная");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокРасходнаяНакладная", СтруктураИменЭлементов,,, "ДанныеМетокРасходнаяНакладная", "ДанныеОтборовРасходнаяНакладная", "ГруппаОтборыРасходнаяНакладная");
	
	// Заказы покупателей
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект, "Заказов");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокЗаказов", СтруктураИменЭлементов,,, "ДанныеМетокЗаказов", "ДанныеОтборовЗаказов", "ГруппаОтборыЗаказов");
	
	// ОтчетПереработчика
	СтруктураИменЭлементов = СтруктураИменЭлементовПанелиОтборов(ЭтотОбъект, "ОтчетПереработчика");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокОтчетПереработчика", СтруктураИменЭлементов,,, "ДанныеМетокОтчетПереработчика", "ДанныеОтборовОтчетПереработчика", "ГруппаОтборыОтчетПереработчика");
	
