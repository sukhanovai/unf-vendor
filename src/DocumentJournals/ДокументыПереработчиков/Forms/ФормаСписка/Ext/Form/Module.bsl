	ИначеЕсли
	ИмяСтраницы = "Страница" Тогда
		Возврат "Список"
	КонецЕсли
	;

	Возврат "";

КонецФункции

&НаСервере
Процедура УстановитьПодменюПодсистемыПечати()
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("ДокументСсылка.ОтчетПереработчика"));
	
	ТипИсточника = Новый ОписаниеТипов(Массив);
	
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	
	ПараметрыРазмещения.Источники = ТипИсточника;
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ГруппаВажныеКомандыОтчетПереработчика;
	ПараметрыРазмещения.ПрефиксГрупп = "ОтчетПереработчика";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	ПечатьДокументовУНФ.УстановитьОтображениеПодменюПечати(Элементы.ОтчетПереработчикаПодменюПечать);
	
	Массив.Очистить();
	Массив.Добавить(Тип("ДокументСсылка.РасходнаяНакладная"));
	
	ТипИсточника = Новый ОписаниеТипов(Массив);
	
	ПараметрыРазмещения.Источники = ТипИсточника;
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ГруппаВажныеКомандыРасходнаяНакладная;
	ПараметрыРазмещения.ПрефиксГрупп = "РасходнаяНакладная";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	ПечатьДокументовУНФ.УстановитьОтображениеПодменюПечати(Элементы.ПодменюПечатьРасходнаяНакладная);
	
	Элементы.Переместить(Элементы.ПодменюПечатьФаксимилеРасходнаяНакладная,Элементы.ПодменюПечатьРасходнаяНакладная);
	
	Массив.Очистить();
	Массив.Добавить(Тип("ДокументСсылка.ЗаказПоставщику"));
	
	ТипИсточника = Новый ОписаниеТипов(Массив);
	
	ПараметрыРазмещения.Источники = ТипИсточника;
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ГруппаВажныеКомандыЗаказов;
	ПараметрыРазмещения.ПрефиксГрупп = "Заказов";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	ПечатьДокументовУНФ.УстановитьОтображениеПодменюПечати(Элементы.ПодменюПечатьЗаказов);
	
КонецПроцедуры

&НаСервере
Процедура АдаптацияТакси()
	
	Если Не ЭтоИнтерфейсТакси Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ПредставлениеПериода.Видимость = Ложь;
	Элементы.ПредставлениеПериодаЗаказов.Видимость = Ложь;
	Элементы.ПредставлениеПериодаОтчетПереработчика.Видимость = Ложь;
	Элементы.ПредставлениеПериодаРасходнаяНакладная.Видимость = Ложь;
	
	Элементы.ПредставлениеПериодаТакси.Видимость = Истина;
	Элементы.ПредставлениеПериодаТаксиЗаказов.Видимость = Истина;
	Элементы.ПредставлениеПериодаТаксиОтчетПереработчика.Видимость = Истина;
	Элементы.ПредставлениеПериодаТаксиРасходнаяНакладная.Видимость = Истина;
	
	Элементы.ИндексФильтры.Видимость = Ложь;
	Элементы.ИндексФильтрыЗаказов.Видимость = Ложь;
	Элементы.ИндексФильтрыОтчетПереработчика.Видимость = Ложь;
	Элементы.ИндексФильтрыРасходнаяНакладная.Видимость = Ложь;
	
	Элементы.ИндексФильтрыТакси.Видимость = Истина;
	Элементы.ИндексФильтрыТаксиЗаказов.Видимость = Истина;
	Элементы.ИндексФильтрыТаксиОтчетПереработчика.Видимость = Истина;
	Элементы.ИндексФильтрыТаксиРасходнаяНакладная.Видимость = Истина;
	
КонецПроцедуры

#КонецОбласти
