&НаСервере
Процедура УстановитьУсловноеОформлениеПоЦветамСостоянийСервер()
	
	СостоянияЗаказов.УстановитьУсловноеОформлениеОтмененногоЗаказа(
		СписокЗаказов.КомпоновщикНастроек.Настройки.УсловноеОформление);
	
	СостоянияЗаказов.УстановитьУсловноеОформлениеПоЦветамСостояний(
		СписокЗаказов.КомпоновщикНастроек.Настройки.УсловноеОформление,
		Метаданные.Справочники.СостоянияЗаказовПоставщикам.ПолноеИмя(),
		"СостояниеЗаказа",
		"СостояниеЗаказа");

КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтрокиОбработчик()
	
	ОбновитьКИ = ЭтотОбъект.КИ_НужноИзменитьДанныеПриАктивизацииСтрокиТаблицы;
	СписокПриАктивизацииСтрокиОбработчикНаСервере(ОбновитьКИ);
	
КонецПроцедуры

&НаСервере
Процедура СписокПриАктивизацииСтрокиОбработчикНаСервере(ОбновитьКИ)
	
	Если ОбновитьКИ Тогда
		КонтактнаяИнформацияПанельУНФ.ОбновитьДанныеПанели(ЭтотОбъект, ТекущийКонтрагент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтруктураИменЭлементовПанелиОтборов(Форма, ИмяОбъекта = Неопределено)
	
	Если Не ЗначениеЗаполнено(ИмяОбъекта) Тогда
		ИмяОбъекта = Форма.Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	КонецЕсли;
	
	ИмяОбъекта = СтрЗаменить(ИмяОбъекта, "Страница", "");
	СтруктураИменЭлементов = РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели(ИмяОбъекта);
	
	Возврат СтруктураИменЭлементов;
	
КонецФункции

&НаКлиенте
Функция ИмяСписка()

	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;

	Если ИмяСтраницы = "СтраницаОтчетПереработчика" Тогда
		Возврат "СписокОтчетПереработчика"
	ИначеЕсли
	ИмяСтраницы = "СтраницаЗаказов" Тогда
		Возврат "СписокЗаказов"
	ИначеЕсли
	ИмяСтраницы = "СтраницаРасходнаяНакладная" Тогда
		Возврат "СписокРасходнаяНакладная"
	ИначеЕсли
	ИмяСтраницы = "Страница" Тогда
		Возврат "Список"
	КонецЕсли
	;

	Возврат "";

КонецФункции

&НаСервере
