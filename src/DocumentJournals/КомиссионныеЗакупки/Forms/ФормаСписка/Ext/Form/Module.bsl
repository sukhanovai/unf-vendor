	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеЗапасов" Тогда Возврат "СписокСписаниеЗапасов"
	ИначеЕсли ИмяСтраницы = "СтраницаПриемНаКомиссию" Тогда Возврат "СписокПриемНаКомиссию"
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда Возврат "Список"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ИмяТчДанныеОтборов()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаОтчетКомитенту" 
		Тогда 
		Возврат "ДанныеОтборовОтчетКомитенту"
		
	ИначеЕсли ИмяСтраницы = "СтраницаПриемНаКомиссию" 
		Тогда 
		Возврат "ДанныеОтборовПриемНаКомиссию"
		
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратКомитенту" 
		Тогда
		Возврат "ДанныеОтборовВозвратКомитенту"
		
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеЗапасов" 
		Тогда
		Возврат "ДанныеОтборовСписаниеЗапасов"
		
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" 
		Тогда
		Возврат "ДанныеОтборов"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ЭлементОтбораНаФорме(ГруппаРодительМетки)
	
	Если ГруппаРодительМетки = "СтраницаОтчетКомитентуГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентОтчетКомитенту";
		
	ИначеЕсли ГруппаРодительМетки = "ГруппаОтборОплата" 
		Тогда
		Возврат "ОтборОплата";
		
	ИначеЕсли ГруппаРодительМетки = "СтраницаОтчетКомитентуГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйОтчетКомитенту";
		
	ИначеЕсли ГруппаРодительМетки = "СтраницаОтчетКомитентуГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияОтчетКомитенту";
		
	ИначеЕсли ГруппаРодительМетки = "СтраницаПриемНаКомиссиюГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентПриемНаКомиссию";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйПриемНаКомиссию";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаПриемНаКомиссиюГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияПриемНаКомиссию";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВозвратКомитентуГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентВозвратКомитенту";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВозвратКомитентуГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйВозвратКомитенту";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВозвратКомитентуГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияВозвратКомитенту";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаСписаниеЗапасовГруппаОтборОперацияСписания" 
		Тогда
		Возврат "ОтборОперацияСписания";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаСписаниеЗапасовГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияСписаниеЗапасов";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаСписаниеЗапасовГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйСписаниеЗапасов";
				
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция СтруктураИменЭлементовПанелиОтборов()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаВозвратКомитенту" Тогда
		ИмяОбъекта = "ВозвратКомитенту";
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомитенту" Тогда 
		ИмяОбъекта = "ОтчетКомитенту";
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеЗапасов" Тогда
		ИмяОбъекта = "СписаниеЗапасов";
	ИначеЕсли ИмяСтраницы = "СтраницаПриемНаКомиссию" Тогда
		ИмяОбъекта = "ПриемНаКомиссию";
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда 
		ИмяОбъекта = "";
	КонецЕсли;
	
	Возврат РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели(ИмяОбъекта);
	
КонецФункции

&НаКлиенте
Функция СтруктураИменПредставленияПериода()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаВозвратКомитенту" Тогда 
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодВозвратКомитенту", "ПредставлениеПериодаВозвратКомитенту");
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомитенту" Тогда
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодОтчетКомитенту", "ПредставлениеПериодаОтчетКомитенту");
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеЗапасов" Тогда
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодСписаниеЗапасов", "ПредставлениеПериодаСписаниеЗапасов");
	ИначеЕсли ИмяСтраницы = "СтраницаПриемНаКомиссию" Тогда
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодПриемНаКомиссию", "ПредставлениеПериодаПриемНаКомиссию");
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда 
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериод", "ПредставлениеПериода");
	КонецЕсли;
	
	Возврат Новый Структура("ОтборПериод, ПредставлениеПериода");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяТчДанныхМеток(Форма)
	
	ИмяСтраницы = Форма.Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаВозвратКомитенту" Тогда Возврат "ДанныеМетокВозвратКомитенту"
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомитенту" Тогда Возврат "ДанныеМетокОтчетКомитенту"
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеЗапасов" Тогда Возврат "ДанныеМетокСписаниеЗапасов"
	ИначеЕсли ИмяСтраницы = "СтраницаПриемНаКомиссию" Тогда Возврат "ДанныеМетокПриемНаКомиссию"
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда Возврат "ДанныеМеток"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ИмяПанелиМетокОтбора()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаВозвратКомитенту" Тогда Возврат "СтраницаВозвратКомитентуПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомитенту" Тогда Возврат "СтраницаОтчетКомитентуПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеЗапасов" Тогда Возврат "СтраницаСписаниеЗапасовПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаПриемНаКомиссию" Тогда Возврат "СтраницаПриемНаКомиссиюПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда Возврат "ПраваяПанель"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНастройкиДинамическогоСписка(Знач ИмяТаблицы, Знач ИмяКоманды)
	
	ЗаголовокФормы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Заголовок;
	ЗаголовокЖурналКраткоеНаименование = НСтр("ru = 'Журнал'");
	ЗаголовокЖурналПолноеНаименование = НСтр("ru = 'Комиссионные закупки'");	
	
	Если ЗаголовокФормы = ЗаголовокЖурналКраткоеНаименование Тогда
		ЗаголовокФормы = ЗаголовокЖурналПолноеНаименование;
	КонецЕсли;
	
	ПараметрыОтчета = Отчеты.РеестрДокументов.ПараметрыОтчета();
	ПараметрыОтчета.ЗаголовокФормы = ЗаголовокФормы;
	ПараметрыОтчета.ИмяТаблицы = ИмяТаблицы;
	ПараметрыОтчета.ИмяКоманды = ИмяКоманды;
	ПараметрыОтчета.ЗаменяемыеЗаголовкиПолей = ЗаголовкиПолейДляРеестраДокументов(ИмяТаблицы);
	
	Если ИмяТаблицы = "Список" Тогда
		ПараметрыОтчета.ЗаменяемыеПоляВыбора = СписокПолейДляЗамены();
	КонецЕсли;
	
	Отчеты.РеестрДокументов.НастройкиДинамическогоСписка(ЭтотОбъект, ПараметрыОтчета);
	
КонецПроцедуры

&НаСервере
Функция ЗаголовкиПолейДляРеестраДокументов(ИмяТекущегоСписка)
	
	Если ИмяТекущегоСписка = "Список" Тогда
		ИмяТекущегоСписка = "";
	КонецЕсли;
	
	ИмяКолонки = ИмяТекущегоСписка + "Контрагент";
	ЗаголовокКонтрагента = Элементы[ИмяКолонки].Заголовок;
	ЗаголовкиПолей = Новый Структура();
	ЗаголовкиПолей.Вставить("Контрагент", ЗаголовокКонтрагента);
	Возврат ЗаголовкиПолей;
	
КонецФункции

&НаСервере
Функция СписокПолейДляЗамены()
	
	СписокПолей = Новый Структура();
	СписокПолей.Вставить("СуммаДокумента", "Сумма");
	СписокПолей.Вставить("ВалютаДокумента", "Валюта");
	
	Возврат СписокПолей;
	
КонецФункции

#КонецОбласти

#Область Отборы

&НаСервере
Процедура УстановитьМеткуИОтборСписка(ИмяПоляОтбораСписка, ГруппаРодительМетки, ВыбранноеЗначение, ПредставлениеЗначения="")
	
	Если ПредставлениеЗначения="" Тогда
		ПредставлениеЗначения=Строка(ВыбранноеЗначение);
	КонецЕсли; 
	
	ИмяСписка = ИмяСпискаСервер();
	ИмяТчМеток = ИмяТчДанныхМеток(ЭтотОбъект);
	ИмяОтбораНаФорме = ЭлементОтбораНаФорме(ГруппаРодительМетки);
	
	Если ГруппаРодительМетки = "ГруппаОтборОплата" Тогда
		ПредставлениеЗначения = РаботаСОтборами.СформироватьПредставлениеМеткиОплата(ВыбранноеЗначение);
		Если ИмяПоляОтбораСписка = "НомерКартинкиОплаты" Тогда
			ВыбранноеЗначение = РаботаСОтборами.НомерКартинкиПоСтатусуОплаты(ВыбранноеЗначение);
		КонецЕсли;
	ИначеЕсли ПредставлениеЗначения="" Тогда
		ПредставлениеЗначения=Строка(ВыбранноеЗначение);
	КонецЕсли;
	
	РаботаСОтборами.ПрикрепитьМеткуОтбора(ЭтотОбъект, ИмяПоляОтбораСписка, ГруппаРодительМетки, ВыбранноеЗначение, ПредставлениеЗначения,,,ИмяТчМеток);
	РаботаСОтборами.УстановитьОтборСписка(ЭтотОбъект, ЭтотОбъект[ИмяСписка], ИмяПоляОтбораСписка,,,ИмяТчМеток, ИмяОтбораНаФорме, ИмяТчДанныеОтборов());
	
	Если ИмяСписка = "Список" Тогда
		ИмяСписка = ""
	КонецЕсли;
	
КонецПроцедуры

