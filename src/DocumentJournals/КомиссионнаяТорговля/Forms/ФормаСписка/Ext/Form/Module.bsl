	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект);
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыВозвратОтКомиссионера", "ПредопределенныеОтборыПоУмолчаниюВозвратОтКомиссионера");
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыВозвратВыкупленногоОтКомиссионера", "ПредопределенныеОтборыПоУмолчаниюВозвратВыкупленногоОтКомиссионера");
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыОтчетКомиссионера", "ПредопределенныеОтборыПоУмолчаниюОтчетКомиссионера");
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыПередачаНаКомиссию", "ПредопределенныеОтборыПоУмолчаниюПередачаНаКомиссию");
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыПереоценкаУКомиссионера", "ПредопределенныеОтборыПоУмолчаниюПереоценкаУКомиссионера");
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыСписаниеУКомиссионера", "ПредопределенныеОтборыПоУмолчаниюСписаниеУКомиссионера");
	РаботаСОтборами.ОпределитьПорядокПредопределенныхОтборов(ЭтотОбъект, "ГруппаОтборыВыкупКомиссионером", "ПредопределенныеОтборыПоУмолчаниюВыкупКомиссионером");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьФорматДатыСписковПриСозданииНаСервере()
	
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(Список);
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(СписокОтчетКомиссионера);
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(СписокПередачаНаКомиссию);
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(СписокПереоценкаУКомиссионера);
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(СписокСписаниеУКомиссионера);
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(СписокВозвратВыкупленногоОтКомиссионера);
	ДинамическиеСпискиУНФ.ОтображатьТолькоВремяДляТекущейДаты(СписокВыкупКомиссионером);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПанелиКонтактнойИнформацииПриСозданииНаСервере()
	// УНФ.ПанельКонтактнойИнформации
	КонтактнаяИнформацияПанельУНФ.ПриСозданииНаСервере(ЭтотОбъект, "КонтактнаяИнформация", "СписокПередачаНаКомиссиюКонтекстноеМеню");
	КонтактнаяИнформацияПанельУНФ.ПриСозданииНаСервере(ЭтотОбъект, "КонтактнаяИнформация", "СписокВыкупКомиссионеромКонтекстноеМеню");
	// Конец УНФ.ПанельКонтактнойИнформации
КонецПроцедуры

&НаКлиенте
Процедура СвернутьРазвернутьПанельОтборов()
	ИмяГруппы = ПолучитьИмяГруппыПанели();
	НовоеЗначениеВидимость = НЕ Элементы[ИмяГруппы].Видимость;
	РаботаСОтборамиКлиент.СвернутьРазвернутьПанельОтборов(ЭтотОбъект, НовоеЗначениеВидимость, СтруктураИменЭлементовПанелиОтборов());
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяГруппыПанели()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаПередачаНаКомиссию" Тогда Возврат "ПраваяПанельСтраницыПередачаНаКомиссию"
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомиссионера" Тогда Возврат "ПраваяПанельСтраницыОтчетКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаПереоценкаУКомиссионера" Тогда Возврат "ПраваяПанельСтраницыПереоценкаУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеУКомиссионера" Тогда Возврат "ПраваяПанельСтраницыСписаниеУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратОтКомиссионера" Тогда Возврат "ПраваяПанельСтраницыВозвратОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратВыкупленногоОтКомиссионера" Тогда Возврат "ПраваяПанельСтраницыВозвратВыкупленногоОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВыкупКомиссионером" Тогда Возврат "ПраваяПанельСтраницыВыкупКомиссионером"
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда Возврат "ПраваяПанельСтраницы"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция ИмяСписка()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаПередачаНаКомиссию" Тогда Возврат "СписокПередачаНаКомиссию"
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомиссионера" Тогда Возврат "СписокОтчетКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаПереоценкаУКомиссионера" Тогда Возврат "СписокПереоценкаУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеУКомиссионера" Тогда Возврат "СписокСписаниеУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратОтКомиссионера" Тогда Возврат "СписокВозвратОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратВыкупленногоОтКомиссионера" Тогда Возврат "СписокВозвратВыкупленногоОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда Возврат "Список"
	ИначеЕсли ИмяСтраницы = "СтраницаВыкупКомиссионером" Тогда Возврат "СписокВыкупКомиссионером"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ИмяСпискаСервер()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаПередачаНаКомиссию" Тогда Возврат "СписокПередачаНаКомиссию"
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомиссионера" Тогда Возврат "СписокОтчетКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаПереоценкаУКомиссионера" Тогда Возврат "СписокПереоценкаУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеУКомиссионера" Тогда Возврат "СписокСписаниеУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратОтКомиссионера" Тогда Возврат "СписокВозвратОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратВыкупленногоОтКомиссионера" Тогда Возврат "СписокВозвратВыкупленногоОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВыкупКомиссионером" Тогда Возврат "СписокВыкупКомиссионером"
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда Возврат "Список"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция СтруктураИменЭлементовПанелиОтборов()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаПередачаНаКомиссию" Тогда
		ИмяОбъекта = "ПередачаНаКомиссию";
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомиссионера" Тогда
		ИмяОбъекта = "ОтчетКомиссионера";
	ИначеЕсли ИмяСтраницы = "СтраницаПереоценкаУКомиссионера" Тогда
		ИмяОбъекта = "ПереоценкаУКомиссионера";
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеУКомиссионера" Тогда 
		ИмяОбъекта = "СписаниеУКомиссионера";
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратОтКомиссионера" Тогда 
		ИмяОбъекта = "ВозвратОтКомиссионера";
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратВыкупленногоОтКомиссионера" Тогда 
		ИмяОбъекта = "ВозвратВыкупленногоОтКомиссионера";
	ИначеЕсли ИмяСтраницы = "СтраницаВыкупКомиссионером" Тогда 
		ИмяОбъекта = "ВыкупКомиссионером";
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда 
		ИмяОбъекта = "";
	КонецЕсли;
	
	Возврат РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели(ИмяОбъекта);
	
КонецФункции

&НаКлиенте
Функция СтруктураИменПредставленияПериода()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаПередачаНаКомиссию" Тогда 
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодПередачаНаКомиссию", "ПредставлениеПериодаПередачаНаКомиссию");
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомиссионера" Тогда
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодОтчетКомиссионера", "ПредставлениеПериодаОтчетКомиссионера");
	ИначеЕсли ИмяСтраницы = "СтраницаПереоценкаУКомиссионера" Тогда
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодПереоценкаУКомиссионера", "ПредставлениеПериодаПереоценкаУКомиссионера");
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеУКомиссионера" Тогда 
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодСписаниеУКомиссионера", "ПредставлениеПериодаСписаниеУКомиссионера");
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратОтКомиссионера" Тогда
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодВозвратОтКомиссионера", "ПредставлениеПериодаВозвратОтКомиссионера");
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратВыкупленногоОтКомиссионера" Тогда
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодВозвратВыкупленногоОтКомиссионера", "ПредставлениеПериодаВозвратВыкупленногоОтКомиссионера");
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда 
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериод", "ПредставлениеПериода");
	ИначеЕсли ИмяСтраницы = "СтраницаВыкупКомиссионером" Тогда 
		Возврат Новый Структура("ОтборПериод, ПредставлениеПериода", "ОтборПериодВыкупКомиссионером", "ПредставлениеПериодаВыкупКомиссионером");
	КонецЕсли;
	
	Возврат Новый Структура("ОтборПериод, ПредставлениеПериода");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяТчДанныхМеток(Форма)
	
	ИмяСтраницы = Форма.Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаПередачаНаКомиссию" Тогда Возврат "ДанныеМетокПередачаНаКомиссию"
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомиссионера" Тогда Возврат "ДанныеМетокОтчетКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаПереоценкаУКомиссионера" Тогда Возврат "ДанныеМетокПереоценкаУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеУКомиссионера" Тогда Возврат "ДанныеМетокСписаниеУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратОтКомиссионера" Тогда Возврат "ДанныеМетокВозвратОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратВыкупленногоОтКомиссионера" Тогда Возврат "ДанныеМетокВозвратВыкупленногоОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВыкупКомиссионером" Тогда Возврат "ДанныеМетокВыкупКомиссионером"
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда Возврат "ДанныеМеток"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ЭлементОтбораНаФорме(ГруппаРодительМетки)
	
	Если ГруппаРодительМетки = "СтраницаОтчетКомиссионераГруппаОтборВидОперации" 
		Тогда
		Возврат  "ОтборВидОперацииОтчетКомиссионера";
		
	ИначеЕсли ГруппаРодительМетки = "СтраницаОтчетКомиссионераГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентОтчетКомиссионера";
		
	ИначеЕсли ГруппаРодительМетки = "ГруппаОтборОплата" 
		Тогда
		Возврат "ОтборОплата";
		
	ИначеЕсли ГруппаРодительМетки = "СтраницаОтчетКомиссионераГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйОтчетКомиссионера";
		
	ИначеЕсли ГруппаРодительМетки = "СтраницаОтчетКомиссионераГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияОтчетКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаПередачаНаКомиссиюГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентПередачаНаКомиссию";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаПередачаНаКомиссиюГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйПередачаНаКомиссию";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаПередачаНаКомиссиюГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияПередачаНаКомиссию";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаПереоценкаУКомиссионераГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентПереоценкаУКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаПереоценкаУКомиссионераГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйПереоценкаУКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаПереоценкаУКомиссионераГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияПереоценкаУКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаСписаниеУКомиссионераГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентСписаниеУКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаСписаниеУКомиссионераГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйСписаниеУКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаСписаниеУКомиссионераГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияСписаниеУКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВозвратОтКомиссионераГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентВозвратОтКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйВозвратОтКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВозвратОтКомиссионераГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияВозвратОтКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВыкупКомиссионеромГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентВыкупКомиссионером";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВыкупКомиссионеромГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйВыкупКомиссионером";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВыкупКомиссионеромГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияВыкупКомиссионером";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВозвратВыкупленногоОтКомиссионераГруппаОтборКонтрагент" 
		Тогда
		Возврат "ОтборКонтрагентВозвратВыкупленногоОтКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВозвратВыкупленногоГруппаОтборОтветственный" 
		Тогда
		Возврат "ОтборОтветственныйВозвратВыкупленногоОтКомиссионера";
				
	ИначеЕсли ГруппаРодительМетки = "СтраницаВозвратВыкупленногоОтКомиссионераГруппаОтборОрганизация" 
		Тогда
		Возврат "ОтборОрганизацияВозвратВыкупленногоОтКомиссионера";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ИмяТчДанныеОтборов()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаПередачаНаКомиссию" Тогда Возврат "ДанныеОтборовПередачаНаКомиссию"
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомиссионера" Тогда Возврат "ДанныеОтборовОтчетКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаПереоценкаУКомиссионера" Тогда Возврат "ДанныеОтборовПереоценкаУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеУКомиссионера" Тогда Возврат "ДанныеОтборовСписаниеУКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратОтКомиссионера" Тогда Возврат "ДанныеОтборовВозвратОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратВыкупленногоОтКомиссионера" Тогда Возврат "ДанныеОтборовВозвратВыкупленногоОтКомиссионера"
	ИначеЕсли ИмяСтраницы = "СтраницаВыкупКомиссионером" Тогда Возврат "ДанныеОтборовВыкупКомиссионером"
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда Возврат "ДанныеОтборов"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ИмяПанелиМетокОтбора()
	
	ИмяСтраницы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	
	Если ИмяСтраницы = "СтраницаПередачаНаКомиссию" Тогда Возврат "СтраницаПередачаНаКомиссиюПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаОтчетКомиссионера" Тогда Возврат "СтраницаОтчетКомиссионераПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаПереоценкаУКомиссионера" Тогда Возврат "СтраницаПереоценкаУКомиссионераПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаСписаниеУКомиссионера" Тогда Возврат "СтраницаСписаниеУКомиссионераПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратОтКомиссионера" Тогда Возврат "СтраницаВозвратОтКомиссионераПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаВозвратВыкупленногоОтКомиссионера" Тогда Возврат "СтраницаВозвратВыкупленногоОтКомиссионераПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаВыкупКомиссионером" Тогда Возврат "СтраницаВыкупКомиссионеромПраваяПанель"
	ИначеЕсли ИмяСтраницы = "СтраницаЖурнал" Тогда Возврат "ПраваяПанель"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНастройкиДинамическогоСписка(Знач ИмяТаблицы, Знач ИмяКоманды)
	
	ЗаголовокФормы = Элементы.ГруппаСтраницы.ТекущаяСтраница.Заголовок;
	
	ЗаголовокЖурналКраткоеНаименование = НСтр("ru = 'Журнал'");
	ЗаголовокЖурналПолноеНаименование = НСтр("ru = 'Комиссионные продажи'");	
	
	Если ЗаголовокФормы = ЗаголовокЖурналКраткоеНаименование Тогда
		ЗаголовокФормы = ЗаголовокЖурналПолноеНаименование;
	КонецЕсли;

	ПараметрыОтчета = Отчеты.РеестрДокументов.ПараметрыОтчета();
	ПараметрыОтчета.ЗаголовокФормы = ЗаголовокФормы;
	ПараметрыОтчета.ИмяТаблицы = ИмяТаблицы;
	ПараметрыОтчета.ИмяКоманды = ИмяКоманды;
	ПараметрыОтчета.ЗаменяемыеЗаголовкиПолей = ЗаголовкиПолейДляРеестраДокументов(ИмяТаблицы);
	
	Отчеты.РеестрДокументов.НастройкиДинамическогоСписка(ЭтотОбъект, ПараметрыОтчета);
	
КонецПроцедуры

&НаСервере
Функция ЗаголовкиПолейДляРеестраДокументов(Знач ИмяТекущегоСписка)

	Если ИмяТекущегоСписка = "Список" Тогда
		ИмяТекущегоСписка = "";
	КонецЕсли;
	
	ИмяКолонки = ИмяТекущегоСписка + "Контрагент";
	ЗаголовокКонтрагента = Элементы[ИмяКолонки].Заголовок;
	ЗаголовкиПолей = Новый Структура();
	ЗаголовкиПолей.Вставить("Контрагент", ЗаголовокКонтрагента);
	Возврат ЗаголовкиПолей;
	
КонецФункции

#Область Отборы

&НаСервере
Процедура УстановитьМеткуИОтборСписка(ИмяПоляОтбораСписка, ГруппаРодительМетки, ВыбранноеЗначение, ПредставлениеЗначения="")
	
	Если ПредставлениеЗначения="" Тогда
		ПредставлениеЗначения=Строка(ВыбранноеЗначение);
	КонецЕсли; 
	
	ИмяСписка = ИмяСпискаСервер();
	ИмяТчМеток = ИмяТчДанныхМеток(ЭтотОбъект);
	ИмяОтбораНаФорме = ЭлементОтбораНаФорме(ГруппаРодительМетки);
	
	Если ГруппаРодительМетки = "ГруппаОтборОплата" Тогда
		ПредставлениеЗначения = РаботаСОтборами.СформироватьПредставлениеМеткиОплата(ВыбранноеЗначение);
		Если ИмяПоляОтбораСписка = "НомерКартинкиОплаты" Тогда
			ВыбранноеЗначение = РаботаСОтборами.НомерКартинкиПоСтатусуОплаты(ВыбранноеЗначение);
		КонецЕсли;
	ИначеЕсли ПредставлениеЗначения="" Тогда
		ПредставлениеЗначения=Строка(ВыбранноеЗначение);
	КонецЕсли;
	
	РаботаСОтборами.ПрикрепитьМеткуОтбора(ЭтотОбъект, ИмяПоляОтбораСписка, ГруппаРодительМетки, ВыбранноеЗначение, ПредставлениеЗначения,,,ИмяТчМеток);
	РаботаСОтборами.УстановитьОтборСписка(ЭтотОбъект, ЭтотОбъект[ИмяСписка], ИмяПоляОтбораСписка,,,ИмяТчМеток, ИмяОтбораНаФорме, ИмяТчДанныеОтборов());
	
	Если ИмяСписка = "Список" Тогда
		ИмяСписка = ""
	КонецЕсли;
	
КонецПроцедуры

//@skip-warning
&НаКлиенте
Процедура Подключаемый_МеткаОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки,
	СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СмещениеНаименованияМетки = ?(Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "СтраницаЖурнал", 1, 3);
	
	МеткаИД = Сред(Элемент.Имя, СтрДлина("Метка_") + СмещениеНаименованияМетки);
	УдалитьМеткуОтбора(МеткаИД);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьМеткуОтбора(МеткаИД)
	
	ИмяСписка = ИмяСпискаСервер();
	ИмяПравойПанели = ИмяПанелиМетокОтбора();
	
	РаботаСОтборами.УдалитьМеткуОтбораСервер(ЭтотОбъект, ЭтотОбъект[ИмяСписка], МеткаИД, ИмяСписка, ИмяТчДанныхМеток(ЭтотОбъект),,ИмяПравойПанели,,ИмяТчДанныеОтборов());
	
	ИмяТчМеток = ИмяТчДанныхМеток(ЭтотОбъект);
	
	Если ИмяСписка = "Список" Тогда
		ИмяСписка = ""
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаНажатие(Элемент, СтандартнаяОбработка)
	ПолучитьПредставлениеПериода(СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПредставлениеПериода(СтандартнаяОбработка)
	ИмяСписка = ИмяСписка();
	СтандартнаяОбработка = Ложь;
	РаботаСОтборамиКлиент.ПредставлениеПериодаВыбратьПериод(ЭтотОбъект, ИмяСписка, "Дата", СтруктураИменПредставленияПериода());
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиОтборов()
	
	СтруктураИменЭлементов = РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели();
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "Список", СтруктураИменЭлементов,,, "ДанныеМеток", "ДанныеОтборов", "ГруппаОтборы");
	
	СтруктураИменЭлементов = РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели("ОтчетКомиссионера");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокОтчетКомиссионера", СтруктураИменЭлементов,,, "ДанныеМетокОтчетКомиссионера", "ДанныеОтборовОтчетКомиссионера", "ГруппаОтборыОтчетКомиссионера");
	
	СтруктураИменЭлементов = РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели("ПередачаНаКомиссию");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокПередачаНаКомиссию", СтруктураИменЭлементов,,, "ДанныеМетокПередачаНаКомиссию", "ДанныеОтборовПередачаНаКомиссию", "ГруппаОтборыПередачаНаКомиссию");
	
	СтруктураИменЭлементов = РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели("ПереоценкаУКомиссионера");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокПереоценкаУКомиссионера", СтруктураИменЭлементов,,, "ДанныеМетокПереоценкаУКомиссионера", "ДанныеОтборовПереоценкаУКомиссионера", "ГруппаОтборыПереоценкаУКомиссионера");
	
	СтруктураИменЭлементов = РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели("СписаниеУКомиссионера");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокСписаниеУКомиссионера", СтруктураИменЭлементов,,, "ДанныеМетокСписаниеУКомиссионера", "ДанныеОтборовСписаниеУКомиссионера", "ГруппаОтборыСписаниеУКомиссионера");
	
	СтруктураИменЭлементов = РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели("ВозвратОтКомиссионера");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокВозвратОтКомиссионера", СтруктураИменЭлементов,,, "ДанныеМетокВозвратОтКомиссионера", "ДанныеОтборовВозвратОтКомиссионера", "ГруппаОтборыВозвратОтКомиссионера");
	
	СтруктураИменЭлементов = РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели("ВыкупКомиссионером");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокВыкупКомиссионером", СтруктураИменЭлементов,,, "ДанныеМетокВыкупКомиссионером", "ДанныеОтборовВыкупКомиссионером", "ГруппаОтборыВыкупКомиссионером");
	
	СтруктураИменЭлементов = РаботаСОтборамиКлиентСервер.ИменаЭлементовПравойПанели("ВозвратВыкупленногоОтКомиссионера");
	РаботаСОтборами.СохранитьНастройкиОтборов(ЭтотОбъект, "СписокВозвратВыкупленногоОтКомиссионера", СтруктураИменЭлементов,,, "ДанныеМетокВозвратВыкупленногоОтКомиссионера", "ДанныеОтборовВозвратВыкупленногоОтКомиссионера", "ГруппаОтборыВозвратВыкупленногоОтКомиссионера");
	
КонецПроцедуры

&НаСервере
Функция ПараметрыОткрытияФормыСНастройкамиОтборов(ДополнительныеПараметры)
	
	Возврат РаботаСОтборами.ПараметрыДляОткрытияФормыСНастройкамиОтборов(ЭтотОбъект, ДополнительныеПараметры);
	
КонецФункции

&НаКлиенте
Процедура НастройкаОтборовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаОтборовЗавершениеНаСервере(Результат.АдресВыбранныеОтборы, Результат.АдресУдаленныеОтборы, ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура НастройкаОтборовЗавершениеНаСервере(АдресВыбранныеОтборы, АдресУдаленныеОтборы, ДополнительныеПараметры)
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ИмяРеквизитаСписка = "Список";
		ИмяТЧДанныеМеток = "ДанныеМеток";
		ИмяТЧДанныеОтборов = "ДанныеОтборов";
	Иначе
		ИмяРеквизитаСписка = ДополнительныеПараметры.ИмяРеквизитаСписка;
		ИмяТЧДанныеМеток = ДополнительныеПараметры.ИмяТЧДанныеМеток;
		ИмяТЧДанныеОтборов = ДополнительныеПараметры.ИмяТЧДанныеОтборов;
	КонецЕсли;
	
	РаботаСОтборами.НастройкаОтборовЗавершение(ЭтотОбъект, АдресВыбранныеОтборы, АдресУдаленныеОтборы, ДополнительныеПараметры);
	
КонецПроцедуры

// @skip-warning
&НаКлиенте
Процедура Подключаемый_ОтборПриИзменении(Элемент)
	
	Подключаемый_ОтборПриИзмененииНаСервере(Элемент.Имя, Элемент.Родитель.Имя)
	
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ОтборПриИзмененииНаСервере(ЭлементИмя, ЭлементРодительИмя)
	
	ПоискМетки = Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя;
	Если СтрЗаканчиваетсяНа(ПоискМетки, "ВозвратОтКомиссионера") Тогда
		ИмяРеквизитаСписка = "СписокВозвратОтКомиссионера";
		ИмяТЧДанныеМеток = "ДанныеМетокВозвратОтКомиссионера";
		ИмяТЧДанныеОтборов = "ДанныеОтборовВозвратОтКомиссионера";
	ИначеЕсли СтрЗаканчиваетсяНа(ПоискМетки, "ВозвратВыкупленногоОтКомиссионера") Тогда
		ИмяРеквизитаСписка = "СписокВозвратВыкупленногоОтКомиссионера";
		ИмяТЧДанныеМеток = "ДанныеМетокВозвратВыкупленногоОтКомиссионера";
		ИмяТЧДанныеОтборов = "ДанныеОтборовВозвратВыкупленногоОтКомиссионера";
	ИначеЕсли СтрЗаканчиваетсяНа(ПоискМетки, "ВыкупКомиссионером") Тогда
		ИмяРеквизитаСписка = "СписокВыкупКомиссионером";
		ИмяТЧДанныеМеток = "ДанныеМетокВыкупКомиссионером";
		ИмяТЧДанныеОтборов = "ДанныеОтборовВыкупКомиссионером";
	ИначеЕсли СтрЗаканчиваетсяНа(ПоискМетки, "ОтчетКомиссионера") Тогда
		ИмяРеквизитаСписка = "СписокОтчетКомиссионера";
		ИмяТЧДанныеМеток = "ДанныеМетокОтчетКомиссионера";
		ИмяТЧДанныеОтборов = "ДанныеОтборовОтчетКомиссионера";
	ИначеЕсли СтрЗаканчиваетсяНа(ПоискМетки, "ПередачаНаКомиссию") Тогда
		ИмяРеквизитаСписка = "СписокПередачаНаКомиссию";
		ИмяТЧДанныеМеток = "ДанныеМетокПередачаНаКомиссию";
		ИмяТЧДанныеОтборов = "ДанныеОтборовПередачаНаКомиссию";
	ИначеЕсли СтрЗаканчиваетсяНа(ПоискМетки, "ПереоценкаУКомиссионера") Тогда
		ИмяРеквизитаСписка = "СписокПереоценкаУКомиссионера";
		ИмяТЧДанныеМеток = "ДанныеМетокПереоценкаУКомиссионера";
		ИмяТЧДанныеОтборов = "ДанныеОтборовПереоценкаУКомиссионера";
	ИначеЕсли СтрЗаканчиваетсяНа(ПоискМетки, "СписаниеУКомиссионера") Тогда
		ИмяРеквизитаСписка = "СписокСписаниеУКомиссионера";
		ИмяТЧДанныеМеток = "ДанныеМетокСписаниеУКомиссионера";
		ИмяТЧДанныеОтборов = "ДанныеОтборовСписаниеУКомиссионера";
	Иначе
		ИмяРеквизитаСписка = "Список";
		ИмяТЧДанныеМеток = "ДанныеМеток";
		ИмяТЧДанныеОтборов = "ДанныеОтборов";
	КонецЕсли;
	
	РаботаСОтборами.Подключаемый_ОтборПриИзменении(ЭтотОбъект, ЭлементИмя, ЭлементРодительИмя, ИмяРеквизитаСписка, ИмяТЧДанныеМеток, ИмяТЧДанныеОтборов);
	
	ИмяСписка = ИмяСпискаСервер();
	ИмяТчМеток = ИмяТчДанныхМеток(ЭтотОбъект);
	
	Если ИмяСписка = "Список" Тогда
		ИмяСписка = ""
	КонецЕсли;
	
КонецПроцедуры

