&НаКлиенте
Процедура ДекорацияНастройкаВыводаИтоговНажатие(Элемент)
	
	ОткрытьФормуНастройкиИтогов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОстатокВВалютеНажатие(Элемент)
	
	ПериодОтчета = Новый СтандартныйПериод;
	ДатаСеанса = ОбщегоНазначенияКлиент.ДатаСеанса();
	ПериодОтчета.ДатаНачала = ДатаСеанса;
	ПериодОтчета.ДатаОкончания = ДатаСеанса;
	ПараметрыОтчета = Новый Структура("СтПериод", ПериодОтчета);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", "ОстаткиВВалюте");
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтчета);
	ОткрытьФорму("Отчет.ДенежныеСредства.Форма", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияВедомостьПоВалютеНажатие(Элемент)
	
	ПараметрыОтчета = Новый Структура("СтПериод, Валюта", ОтборПериод, ОтборВалютаВедомости);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", "ВедомостьВВалюте");
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтчета);
	ОткрытьФорму("Отчет.ДенежныеСредства.Форма", ПараметрыФормы);
	
КонецПроцедуры

