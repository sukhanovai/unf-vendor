#Область СлужебныеПроцедурыИФункции

Функция МенюСтраницИнициализация( Форма, Параметры = Неопределено ) Экспорт
	
	Если Параметры = Неопределено Тогда
		Параметры = КаналыПродажКлиентСервер.МенюСтраницПараметрыНовый();
	КонецЕсли;
	
	Результат = Истина;
	
	ФормаМенюСтраницДобавить( Форма, Параметры );
	
	ФормаМенюСтраницЭлементыПроверитьРезультат = ФормаМенюСтраницЭлементыПроверить( Форма, Параметры );
	Если ФормаМенюСтраницЭлементыПроверитьРезультат = Ложь Тогда
		Результат = Ложь;
	КонецЕсли;

	ФормаМенюСтраницРеквизитыПроверитьРезультат = ФормаМенюСтраницРеквизитыПроверить( Форма, Параметры );
	Если ФормаМенюСтраницРеквизитыПроверитьРезультат = Ложь Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Если Результат = Ложь Тогда
		Возврат Результат;
	КонецЕсли;
	
	Форма.МенюСтраницТекущаяСтрокаДоПереключения = -1;
	Попытка
		Форма.МенюСтраницЗаполнить();
	Исключение 
		ОшибкаТекст = ОбработкаОшибок.ПодробноеПредставлениеОшибки( ИнформацияОбОшибке() );
		ОбщегоНазначения.СообщитьПользователю( Форма.ИмяФормы + ": " + ОшибкаТекст );
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

Функция ФормаМенюСтраницДобавить( Форма, Параметры )
	
	ГруппаРодитель = Форма.Элементы.Найти( Параметры.ГруппаРодительИмя );
	Если ГруппаРодитель = Неопределено Тогда
	
		ГруппаРодитель = Форма.Элементы.Добавить( Параметры.ГруппаРодительИмя, Тип( "ГруппаФормы" ), Форма );
		ГруппаРодитель.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		
		ГруппаРодитель.ОтображатьЗаголовок = Ложь;
		ГруппаРодитель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		
	КонецЕсли;

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта( Форма, "МенюСтраницПараметры" ) = Ложь Тогда
		
		Реквизиты = Новый Массив;
		
		Типы = Новый ОписаниеТипов();
		Реквизит = Новый РеквизитФормы( "МенюСтраницПараметры", Типы, "", "" );
		Реквизиты.Добавить( Реквизит );
		
		Форма.ИзменитьРеквизиты( Реквизиты );
		
		Форма.МенюСтраницПараметры = КаналыПродажКлиентСервер.МенюСтраницПараметрыНовый();
		ЗаполнитьЗначенияСвойств( Форма.МенюСтраницПараметры, Параметры );
		
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта( Форма, Параметры.ЭлементМенюСтраницИмя ) = Ложь Тогда
	    
	    // реквизиты меню страниц
		Реквизиты = Новый Массив;

		Типы = Новый ОписаниеТипов( "Число" );
		Реквизит = Новый РеквизитФормы( Параметры.РеквизитТекущаяСтрокаДоПереключенияИмя, Типы, "", "" );
		Реквизиты.Добавить( Реквизит );
		
		Типы = Новый ОписаниеТипов( "ТаблицаЗначений" );
		Реквизит = Новый РеквизитФормы( Параметры.ЭлементМенюСтраницИмя, Типы, "", "" );
		Реквизиты.Добавить( Реквизит );

		Типы = Новый ОписаниеТипов( "Строка" );
		Реквизит = Новый РеквизитФормы( "Наименование", Типы, Параметры.ЭлементМенюСтраницИмя, "" );
		Реквизиты.Добавить( Реквизит );

		Типы = Новый ОписаниеТипов( "Число" );
		Реквизит = Новый РеквизитФормы( "НомерКартинки", Типы, Параметры.ЭлементМенюСтраницИмя, "" );
		Реквизиты.Добавить( Реквизит );

		Типы = Новый ОписаниеТипов( "Строка" );
		Реквизит = Новый РеквизитФормы( "ИмяСтраницы", Типы, Параметры.ЭлементМенюСтраницИмя, "" );
		Реквизиты.Добавить( Реквизит );

		Типы = Новый ОписаниеТипов( "Булево" );
		Реквизит = Новый РеквизитФормы( "ДоступностьСтраницы", Типы, Параметры.ЭлементМенюСтраницИмя, "" );
		Реквизиты.Добавить( Реквизит );

		Типы = Новый ОписаниеТипов( "Число" );
		Реквизит = Новый РеквизитФормы( "ВтораяКартинкаСтроки", Типы, Параметры.ЭлементМенюСтраницИмя, "" );
		Реквизиты.Добавить( Реквизит );

		Типы = Новый ОписаниеТипов( "Булево" );
		Реквизит = Новый РеквизитФормы( "ПоляСтраницыЗаполненыКорректно", Типы, Параметры.ЭлементМенюСтраницИмя, "" );
		Реквизиты.Добавить( Реквизит );

		Типы = Новый ОписаниеТипов( "Булево" );
		Реквизит = Новый РеквизитФормы( "ДоступностьСтраницыДляПереключения", Типы, Параметры.ЭлементМенюСтраницИмя, "" );
		Реквизиты.Добавить( Реквизит );
		
		Форма.ИзменитьРеквизиты( Реквизиты );
		
		// элементы меню страниц
		ЭлементМенюСтраниц = Форма.Элементы.Добавить( Параметры.ЭлементМенюСтраницИмя, Тип( "ТаблицаФормы" ), ГруппаРодитель );
		ЭлементМенюСтраниц.ПутьКДанным = Параметры.ЭлементМенюСтраницИмя;
		ЭлементМенюСтраниц.Отображение = ОтображениеТаблицы.Список;
		ЭлементМенюСтраниц.ТолькоПросмотр = Истина;
		ЭлементМенюСтраниц.ИзменятьПорядокСтрок = Ложь;
		ЭлементМенюСтраниц.ИзменятьСоставСтрок = Ложь;
		ЭлементМенюСтраниц.РазрешитьНачалоПеретаскивания = Ложь;
		ЭлементМенюСтраниц.РазрешитьПеретаскивание = Ложь;
		ЭлементМенюСтраниц.Видимость = Параметры.МенюСтраницВидимость;
		ЭлементМенюСтраниц.КартинкаСтрок = БиблиотекаКартинок[ Параметры.КартинкаСтрок ];
		ЭлементМенюСтраниц.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
		ЭлементМенюСтраниц.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ЭлементМенюСтраниц.МножественныйВыбор = Ложь;
		ЭлементМенюСтраниц.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
		ЭлементМенюСтраниц.Шапка = Ложь;
		ЭлементМенюСтраниц.ПутьКДаннымКартинкиСтроки = Параметры.ЭлементМенюСтраницИмя + ".НомерКартинки";
		ЭлементМенюСтраниц.ГоризонтальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.НеИспользовать;
		ЭлементМенюСтраниц.ВертикальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.НеИспользовать;
		ЭлементМенюСтраниц.ПоложениеСтрокиПоиска = ПоложениеСтрокиПоиска.Нет;
		ЭлементМенюСтраниц.ГоризонтальныеЛинии = Ложь;
		ЭлементМенюСтраниц.ВертикальныеЛинии = Ложь;
		ЭлементМенюСтраниц.Ширина = Параметры.Ширина;
		ЭлементМенюСтраниц.ВысотаВСтрокахТаблицы = Параметры.ВысотаВСтрокахТаблицы;
		ЭлементМенюСтраниц.РастягиватьПоГоризонтали = Ложь;
		ЭлементМенюСтраниц.РастягиватьПоВертикали = Ложь;
		ЭлементМенюСтраниц.УстановитьДействие( "ПриАктивизацииСтроки", Параметры.ДействиеПриАктивизацииСтроки );
		ЭлементМенюСтраниц.ЦветРамки = ЦветаСтиля.ЦветФонаФормы;
		ЭлементМенюСтраниц.РежимВыделенияСтроки = РежимВыделенияСтрокиТаблицы.Строка;
		ЭлементМенюСтраниц.ЧередованиеЦветовСтрок = Ложь;
		
		ЭлементМенюСтраницКолонка = Форма.Элементы.Добавить( "МенюСтраницНаименование", Тип( "ПолеФормы" ), ЭлементМенюСтраниц );
		ЭлементМенюСтраницКолонка.Вид = ВидПоляФормы.ПолеВвода;
		ЭлементМенюСтраницКолонка.ПутьКДанным = Параметры.ЭлементМенюСтраницИмя + ".Наименование";
		ЭлементМенюСтраницКолонка.Ширина = Параметры.КолонкаНаименованиеШирина;
		ЭлементМенюСтраницКолонка.МаксимальнаяШирина = Параметры.КолонкаНаименованиеШирина;
		ЭлементМенюСтраницКолонка.АвтоМаксимальнаяШирина = Ложь;
		ЭлементМенюСтраницКолонка.РастягиватьПоГоризонтали = Ложь;

		ЭлементМенюСтраницКолонка = Форма.Элементы.Добавить( "МенюСтраницВтораяКартинкаСтроки", Тип( "ПолеФормы" ), ЭлементМенюСтраниц );
		ЭлементМенюСтраницКолонка.Вид = ВидПоляФормы.ПолеКартинки;
		ЭлементМенюСтраницКолонка.ПутьКДанным = Параметры.ЭлементМенюСтраницИмя + ".ВтораяКартинкаСтроки";
		ЭлементМенюСтраницКолонка.КартинкаЗначений = БиблиотекаКартинок[ Параметры.ВтораяКартинкаСтрок ];
		ЭлементМенюСтраницКолонка.Ширина = Параметры.КолонкаВтораяКартинкаСтрокиШирина;
		ЭлементМенюСтраницКолонка.РастягиватьПоГоризонтали = Ложь;
		//@skip-check bsl-legacy-check-dynamic-feature-access
		ЭлементМенюСтраницКолонка.АвтоШиринаВТаблице = АвтоШиринаВТаблице.Нет;
		
		// командная панель
		Форма.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Низ;
		Форма.КоманднаяПанель.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
		
		Если Параметры.КнопкаНазадИспользование = Истина Тогда
			КнопкаНазад = Форма.Команды.Добавить( Параметры.КнопкаНазадИмя );
			КнопкаНазад.Заголовок = Параметры.КнопкаНазадЗаголовок;
			КнопкаНазад.Действие = Параметры.КнопкаНазадДействие;
			КнопкаНазад.НазначениеДействия = НазначениеДействияКомандыФормы.Завершение;
			КнопкаНазад.Картинка = БиблиотекаКартинок.ПерейтиНазад;
			КнопкаНазад.Отображение = ОтображениеКнопки.КартинкаИТекст; 

			ЭлементКнопкаНазад = Форма.Элементы.Добавить( Параметры.КнопкаНазадИмя, Тип( "КнопкаФормы" ), Форма.КоманднаяПанель );
			ЭлементКнопкаНазад.ИмяКоманды = Параметры.КнопкаНазадИмя;

			ЭлементКнопкаНазад.Видимость = Параметры.КнопкаНазадВидимость;
			
		КонецЕсли;

		Если Параметры.КнопкаВпередИспользование = Истина Тогда
		
			КнопкаВперед = Форма.Команды.Добавить( Параметры.КнопкаВпередИмя );
			КнопкаВперед.Заголовок = Параметры.КнопкаВпередЗаголовок;
			КнопкаВперед.Действие = Параметры.КнопкаВпередДействие;
			КнопкаВперед.НазначениеДействия = НазначениеДействияКомандыФормы.Завершение;
			КнопкаВперед.Картинка = БиблиотекаКартинок.ПерейтиВперед;
			КнопкаВперед.Отображение = ОтображениеКнопки.КартинкаИТекст; 
			
			ЭлементКнопкаВперед = Форма.Элементы.Добавить( Параметры.КнопкаВпередИмя, Тип( "КнопкаФормы" ), Форма.КоманднаяПанель );
			ЭлементКнопкаВперед.ИмяКоманды = Параметры.КнопкаВпередИмя;
			
			ЭлементКнопкаВперед.Видимость = Параметры.КнопкаВпередВидимость;
			
			Если ЭлементКнопкаВперед.Видимость = Истина Тогда
				ЭлементКнопкаВперед.Важность = ВажностьКнопки.Главная;
				ЭлементКнопкаВперед.КнопкаПоУмолчанию = Истина;
			КонецЕсли;

		КонецЕсли;
		
		ФормаМенюСтраницУсловноеОформлениеДобавить( Форма, Параметры );
		
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

Функция ФормаМенюСтраницУсловноеОформлениеДобавить( Форма, Параметры )

	// Доступность страницы
	ЭлементУсловногоОформления = Форма.УсловноеОформление.Элементы.Добавить();
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных( Параметры.ЭлементМенюСтраницИмя + ".ДоступностьСтраницы");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных( "МенюСтраницНаименование" );
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаПалитры.НедоступныеДанныеЦветУНФ);


	// Доступность страницы для переключения
	ЭлементУсловногоОформления = Форма.УсловноеОформление.Элементы.Добавить();
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных( Параметры.ЭлементМенюСтраницИмя + ".ДоступностьСтраницыДляПереключения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных( "МенюСтраницНаименование" );
	
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаПалитры.НедоступныеДанныеЦветУНФ);
	
	Возврат Истина;
КонецФункции

Функция ФормаМенюСтраницЭлементыПроверить( Форма, Параметры )
    
    Результат = Истина;
    
	ЗначенияДляПроверки = Новый Массив;
	ЗначенияДляПроверки.Добавить( Параметры.ЭлементМенюСтраницИмя );
	Если Параметры.КнопкаНазадИспользование = Истина Тогда
		ЗначенияДляПроверки.Добавить( Параметры.КнопкаНазадИмя );
	КонецЕсли;
	Если Параметры.КнопкаВпередИспользование = Истина Тогда
		ЗначенияДляПроверки.Добавить( Параметры.КнопкаВпередИмя );
	КонецЕсли;
	
	ЗначенияНеНайдены = Новый Массив;
	Для Каждого Имя Из ЗначенияДляПроверки Цикл
		Если Форма.Элементы.Найти( Имя ) = Неопределено Тогда
			ЗначенияНеНайдены.Добавить( Имя );
			
			Результат = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначенияНеНайдены.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю( 
		НСтр( "ru = 'Меню страниц: Не найдены элементы формы:'" )
		+ " " + СтрСоединить( ЗначенияНеНайдены, ", " ) );
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ФормаМенюСтраницРеквизитыПроверить( Форма, Параметры )
    
    Результат = Истина;
    
	ЗначенияДляПроверки = Новый Массив;
	ЗначенияДляПроверки.Добавить( Параметры.ЭлементМенюСтраницИмя );
	ЗначенияДляПроверки.Добавить( Параметры.РеквизитТекущаяСтрокаДоПереключенияИмя );
	
	ЗначенияНеНайдены = Новый Массив;
	Для Каждого Имя Из ЗначенияДляПроверки Цикл
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта( Форма, Имя ) = Ложь Тогда
			ЗначенияНеНайдены.Добавить( Имя );
			
			Результат = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначенияНеНайдены.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю( 
		НСтр( "ru = 'Меню страниц: Не найдены реквизиты формы:'" )
		+ " " + СтрСоединить( ЗначенияНеНайдены, "," ) );
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура ФормаДобавитьВажноеСообщениеПоДекорации( Форма, Декорация, ТипСообщения = "Информация", Скрываемый = Истина, Обработчик = "" ) Экспорт
	
	ДекорацияЭлемент = Форма.Элементы[ Декорация ];
	
	ПараметрыВажногоСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыВажногоСообщения.Родитель = ДекорацияЭлемент.Родитель.Имя;
	ПараметрыВажногоСообщения.ТипСообщения = ТипСообщения;
	ПараметрыВажногоСообщения.Сообщение = ДекорацияЭлемент.Заголовок;
	ПараметрыВажногоСообщения.КраткоеПредставление = Строка( ДекорацияЭлемент.Заголовок );
	ПараметрыВажногоСообщения.Скрываемый = Скрываемый;
	ПараметрыВажногоСообщения.Обработчик = Обработчик;
	
	ОбщегоНазначения.ДобавитьВажноеСообщение( Форма, ПараметрыВажногоСообщения );
	
	ДекорацияЭлемент.Видимость = Ложь;

КонецПроцедуры

Процедура Пауза_мс( Длительность_мс ) Экспорт
	
	Если ТекущийРежимЗапуска() = Неопределено Тогда
	
		ВызватьПаузу( Длительность_мс );
		
	Иначе
	
		ПараметрыФункции = Новый Массив;
		ПараметрыФункции.Добавить( Длительность_мс );
		ФоновоеЗадание = ФоновыеЗадания.Выполнить( "КаналыПродажСервер.Пауза_мс", ПараметрыФункции );
		ФоновоеЗадание.ОжидатьЗавершенияВыполнения();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаказПокупателяНДСПоДаннымОрганизацииЗаполнить( ЗаказПокупателя ) Экспорт

	НастройкиЗаполненияНДС = НалогиУНФ.НастройкиНДСОрганизации(ЗаказПокупателя.Организация, , ЗаказПокупателя.Дата);

	ЗаказПокупателя.НалогообложениеНДС = НастройкиЗаполненияНДС.ТипНалогообложения;
	
	НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти(ЗаказПокупателя, "Запасы", Истина, НастройкиЗаполненияНДС.ВидСтавкиНДС);
	НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти(ЗаказПокупателя, "Работы", Ложь, НастройкиЗаполненияНДС.ВидСтавкиНДС);

	// Доставка
	ДанныеРасчетаНДС = НоменклатураВДокументахСервер.ПараметрыОпределенияСтавкиНДС();
	ДанныеРасчетаНДС.Организация = ЗаказПокупателя.Организация;
	ДанныеРасчетаНДС.ДатаОбработки = ЗаказПокупателя.Дата;
	ДанныеРасчетаНДС.НалогообложениеНДС = ЗаказПокупателя.НалогообложениеНДС;
	ДанныеРасчетаНДС.ВидСтавкиНДСПоУмолчанию = НастройкиЗаполненияНДС.ВидСтавкиНДС;
	
	Если ЗначениеЗаполнено(ЗаказПокупателя.НоменклатураДоставки) Тогда
		ДанныеРасчетаНДС.Номенклатура = ЗаказПокупателя.НоменклатураДоставки;
		ДанныеРасчетаНДС.Партия = Неопределено;
		ДоставкаДанныеНДС = НоменклатураВДокументахСервер.ДанныеНДССтрокиНоменклатуры(ДанныеРасчетаНДС);
		
		ЗаказПокупателя.СтавкаНДСДоставки = ДоставкаДанныеНДС.СтавкаНДС;
		Если ЗаказПокупателя.СтоимостьДоставки <> 0 Тогда
			ЗаказПокупателя.СуммаНДСДоставки = УчетНДСКлиентСервер.РассчитатьСуммуНДС(ЗаказПокупателя.СтоимостьДоставки, ЗаказПокупателя.СуммаВключаетНДС, ДоставкаДанныеНДС.ЗначениеСтавкиНДС);
		КонецЕсли;
	КонецЕсли;
	// Конец Доставка
	
КонецПроцедуры


// Получает ставки НДС для указанной организации и номенклатуры на заданную дату
// с помощью типовых функций НалогиУНФ.НастройкиНДСОрганизации 
// и НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти
//
// Параметры:
//  Организация - СправочникСсылка.Организации - организация, для которой определяются ставки НДС
//  Дата       - Дата - дата, на которую определяются ставки НДС
//  Номенклатура - СправочникСсылка.Номенклатура
//    * СписокЗначений (значения должны быть ссылками на номенклатуру)
//    * Массив (элементы должны быть ссылками на номенклатуру)
//    * ВыборкаИзРезультатаЗапроса (с колонкой Номенклатура)
//    * СправочникСсылка.Номенклатура (с колонкой Номенклатура)
// - номенклатура для определения ставок НДС.
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - СправочникСсылка.Номенклатура - ссылка на номенклатуру
//   * Значение - Структура:
//    * СтавкаНДС      - СправочникСсылка.СтавкиНДС - ссылка на ставку НДС
//    * СтавкаНДСЧисло - Число - числовое значение ставки НДС
//
// Пример использования:
//  СтавкиНДС = КаналыПродажСервер.СтавкиНДСПоОрганизацииИТоварамПолучить(
//      Организация,
//      ТекущаяДатаСеанса(),
//      ТекущаяНоменклатура);
//  Если СтавкиНДС <> Неопределено Тогда
//      ДанныеНДС = СтавкиНДС.Получить(ТекущаяНоменклатура);
//      Если ДанныеНДС <> Неопределено Тогда
//          Ставка = ДанныеНДС.СтавкаНДС;
//          Число = ДанныеНДС.СтавкаНДСЧисло;
//      КонецЕсли;
//  КонецЕсли;
Функция СтавкиНДСПоОрганизацииИТоварамПолучить( Организация, Дата, Номенклатура ) Экспорт
	
	ТипСправочникСсылкаНоменклатура = Тип( "СправочникСсылка.Номенклатура" );
	
	МассивНоменклатура = Новый Массив;
	
	Если ТипЗнч( Номенклатура ) = Тип( "СписокЗначений" ) Тогда
		
		Для Каждого НоменклатураЭлемент Из Номенклатура Цикл
			НоменклатураСсылка = НоменклатураЭлемент.Значение;
			Если ЗначениеЗаполнено( НоменклатураСсылка )
			И ТипЗнч( НоменклатураСсылка ) = ТипСправочникСсылкаНоменклатура
			Тогда
				МассивНоменклатура.Добавить( НоменклатураСсылка );
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч( Номенклатура ) = ТипСправочникСсылкаНоменклатура Тогда
		НоменклатураСсылка = Номенклатура;
		Если ЗначениеЗаполнено( НоменклатураСсылка ) Тогда
			МассивНоменклатура.Добавить( НоменклатураСсылка );
		КонецЕсли;
		
	ИначеЕсли ТипЗнч( Номенклатура ) = Тип( "Массив" ) Тогда
		 		
		Для Каждого НоменклатураСсылка Из Номенклатура Цикл
			Если ЗначениеЗаполнено( НоменклатураСсылка )
			И ТипЗнч( НоменклатураСсылка ) = ТипСправочникСсылкаНоменклатура
			Тогда
				МассивНоменклатура.Добавить( НоменклатураСсылка );
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч( Номенклатура ) = Тип( "ВыборкаИзРезультатаЗапроса" ) Тогда
	
		Номенклатура.Сбросить();
		Пока Номенклатура.Следующий() Цикл
			НоменклатураСсылка = Номенклатура.Номенклатура;
			Если ЗначениеЗаполнено( НоменклатураСсылка )
			И ТипЗнч( НоменклатураСсылка ) = ТипСправочникСсылкаНоменклатура
			Тогда
				МассивНоменклатура.Добавить( НоменклатураСсылка );
			КонецЕсли;
		КонецЦикла;
		Номенклатура.Сбросить();
		
	Иначе
	
		Возврат Неопределено;
		
	КонецЕсли;
    
    Если МассивНоменклатура.Количество() = 0 Тогда
    	Возврат Неопределено;
    КонецЕсли;
	
	ДанныеДляНДС = Новый Структура;
	
	ДанныеДляНДС.Вставить( "Организация", Организация );
	ДанныеДляНДС.Вставить( "Дата", Дата );
	ДанныеДляНДС.Вставить( "НалогообложениеНДС" );
	ДанныеДляНДС.Вставить( "СуммаВключаетНДС", Ложь );
	ДанныеДляНДС.Вставить( "Запасы", Новый Массив );
	
	НастройкиЗаполненияНДС = НалогиУНФ.НастройкиНДСОрганизации( Организация, , Дата);	
	ДанныеДляНДС.НалогообложениеНДС = НастройкиЗаполненияНДС.ТипНалогообложения;

	Для Каждого НоменклатураСсылка Из МассивНоменклатура Цикл

		ЗапасыСтрока = Новый Структура;
		ЗапасыСтрока.Вставить( "Номенклатура", НоменклатураСсылка );
		ЗапасыСтрока.Вставить( "СтавкаНДС", ПредопределенноеЗначение( "Справочник.СтавкиНДС.ПустаяСсылка" ) );
		ЗапасыСтрока.Вставить( "СуммаНДС", 0 );
		ЗапасыСтрока.Вставить( "Сумма", 0 );
		ЗапасыСтрока.Вставить( "Всего", 0 );

		ДанныеДляНДС.Запасы.Добавить( ЗапасыСтрока );
	КонецЦикла;
	
	// Получение ставок НДС для Номенклатуры с помощью типовой функции
	НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти( ДанныеДляНДС, "Запасы", Ложь, НастройкиЗаполненияНДС.ВидСтавкиНДС );

	Результат = Новый Соответствие;
	Для Каждого ЗапасыСтрока Из ДанныеДляНДС.Запасы Цикл
		
		НДСЗначение = Новый Структура;
		НДСЗначение.Вставить( "СтавкаНДС", ЗапасыСтрока.СтавкаНДС );
		НДСЗначение.Вставить( "СтавкаНДСЧисло", 
		УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС( ЗапасыСтрока.СтавкаНДС ) );
		
		Результат.Вставить( ЗапасыСтрока.Номенклатура, НДСЗначение );
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти