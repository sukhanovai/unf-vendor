Процедура ЗаполнитьСуммуДокументаСписаниеЗапасов(ПараметрыОбработчика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
	|	СписаниеЗапасов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СписаниеЗапасов.Запасы КАК СписаниеЗапасовЗапасы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеЗапасов КАК СписаниеЗапасов
	|		ПО СписаниеЗапасовЗапасы.Ссылка = СписаниеЗапасов.Ссылка
	|		И СписаниеЗапасовЗапасы.Сумма <> 0
	|ГДЕ
	|	СписаниеЗапасов.СуммаДокумента = 0
	|	И СписаниеЗапасов.Проведен = ИСТИНА";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		Пока Выборка.Следующий() Цикл
			
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			Сумма = ДокументОбъект.Запасы.Итог("Сумма");
			ДокументОбъект.СуммаДокумента = Сумма;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИмяСобытия = НСтр("ru = 'Выполнение обработчика заполнения реквизита СуммаДокумента в документе СписаниеЗапасов'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ПараметрыОбработчика.ОбработкаЗавершена = Ложь;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьФлагиОтсрочкиНачисленийБаллов(ПараметрыОбработчика) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	БонусныеПрограммы.Ссылка КАК Ссылка,
	|	БонусныеПрограммы.НачислятьПередДнемРождения КАК Было_НачислятьПередДнемРождения,
	|	БонусныеПрограммы.ДнейПередДнемРождения > 0 КАК НачислятьПередДнемРождения,
	|	БонусныеПрограммы.СписыватьПослеДняРождения КАК Было_СписыватьПослеДняРождения,
	|	БонусныеПрограммы.ДнейПослеДняРождения > 0 КАК СписыватьПослеДняРождения,
	|	БонусныеПрограммы.ОтсрочкаДнейРегистрацияКарты > 0 КАК ИспользоватьОтсрочкуРегистрацияКарты,
	|	БонусныеПрограммы.ИспользоватьОтсрочкуРегистрацияКарты КАК Было_ИспользоватьОтсрочкуРегистрацияКарты,
	|	БонусныеПрограммы.ДнейСписанияРегистрацияКарты > 0 КАК СписыватьБаллыРегистрацииКарты,
	|	БонусныеПрограммы.СписыватьБаллыРегистрацииКарты КАК Было_СписыватьБаллыРегистрацииКарты
	|ИЗ
	|	Справочник.БонусныеПрограммы КАК БонусныеПрограммы
	|ГДЕ
	|	БонусныеПрограммы.ДнейПослеДняРождения > 0
	|	И НЕ БонусныеПрограммы.СписыватьПослеДняРождения
	|	ИЛИ БонусныеПрограммы.ДнейПередДнемРождения > 0
	|	И НЕ БонусныеПрограммы.НачислятьПередДнемРождения
	|	ИЛИ БонусныеПрограммы.ОтсрочкаДнейРегистрацияКарты > 0
	|	И НЕ БонусныеПрограммы.ИспользоватьОтсрочкуРегистрацияКарты
	|	ИЛИ БонусныеПрограммы.ДнейСписанияРегистрацияКарты > 0
