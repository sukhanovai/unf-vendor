Процедура ВКонтактеПеренестиТокеныВБезопасноеХранилище(ПараметрыОбработчика) Экспорт
	
	ЗапросТекст =
	"ВЫБРАТЬ
	|	ИнтеграцияСМагазинамиСоцСетей.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.ИнтеграцияСМагазинамиСоцСетей КАК ИнтеграцияСМагазинамиСоцСетей
	|ГДЕ
	|	ПОДСТРОКА(ИнтеграцияСМагазинамиСоцСетей.УдалитьТокенДоступа, 1, 10) > """"";

	ЗапросОбъект = Новый Запрос(ЗапросТекст);
	
	НачатьТранзакцию();
	
	Попытка
		
		ЗапросВыборка = ЗапросОбъект.Выполнить().Выбрать();
		Если ЗапросВыборка.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			ПараметрыОбработчика.ОбработкаЗавершена = Истина;
			Возврат;
		КонецЕсли;
		
		АвторизацияВКонтактеПараметры = ИнтеграцияСМагазинамиСоцСетейКлиентСервер.АвторизацияВКонтактеПараметрыНовый(
		ИнтеграцияСМагазинамиСоцСетейКлиентСервер.СпособАвторизацииOAUTH());
		
		Пока ЗапросВыборка.Следующий() Цикл
        
			Объект = ЗапросВыборка.Ссылка.ПолучитьОбъект();
        	
        	// запись в безопасное хранилище
        	АвторизацияВКонтактеПараметры.access_token = Объект.УдалитьТокенДоступа;
			АвторизацияВКонтактеПараметры.ОкончанияДействияТокенаДоступа = Объект.УдалитьОкончанияДействияТокенаДоступа;

			АвторизацияВКонтактеПараметры.access_token_community = Объект.УдалитьТокенДоступаСообщества;
			АвторизацияВКонтактеПараметры.ОкончанияДействияТокенДоступаСообщества = Объект.УдалитьОкончанияДействияТокенДоступаСообщества;

			ИнтеграцияСМагазинамиСоцСетейСервер.АвторизацияВКонтактеПараметрыВБезопасноеХранилищеЗаписать( 
			ЗапросВыборка.Ссылка, АвторизацияВКонтактеПараметры );
		
			// удаление значений в объекте
			
			Объект.УдалитьТокенДоступа = "";
			Объект.УдалитьОкончанияДействияТокенаДоступа = "";

			Объект.УдалитьТокенДоступаСообщества = "";
			Объект.УдалитьОкончанияДействияТокенДоступаСообщества = "";
			
			Объект.УдалитьСтрокаАвторизации = "";
			Объект.УдалитьСтрокаАвторизацииСообщества = "";
			
			
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
			
		КонецЦикла;
		ЗафиксироватьТранзакцию();
		
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПеренестиНастройкиРабочегоМеста(ПараметрыОбработчика) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	НастройкиРМК.Ссылка КАК СтараяНастройкаРМК,
	|	ЕСТЬNULL(НастройкиРабочегоМестаКассира.Ссылка, ЗНАЧЕНИЕ(Справочник.НастройкиРабочегоМестаКассира.ПустаяСсылка)) КАК НоваяНастройкаРМК
	|ИЗ
	|	Справочник.УдалитьНастройкиРМК КАК НастройкиРМК
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРабочегоМестаКассира КАК НастройкиРабочегоМестаКассира
	|		ПО НастройкиРМК.РабочееМесто = НастройкиРабочегоМестаКассира.РабочееМесто
	|ГДЕ
	|	НЕ НастройкиРМК.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		Возврат;
	Иначе
		ПараметрыОбработчика.ОбработкаЗавершена = Ложь;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	НачатьТранзакцию();
	
	Попытка
		Пока Выборка.Следующий() Цикл
			
			РеквизитыСтаройНастройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выборка.СтараяНастройкаРМК, "РаспределениеНоменклатуры, СтруктурныеЕдиницы, Наименование, ГруппыКатегории");
			РаспределениеНоменклатуры = РеквизитыСтаройНастройки.РаспределениеНоменклатуры.Выгрузить();
			СтруктурныеЕдиницы = РеквизитыСтаройНастройки.СтруктурныеЕдиницы.Выгрузить();
			Если РаспределениеНоменклатуры.Количество() = 0
				И СтруктурныеЕдиницы.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Блокировка = Новый БлокировкаДанных();
			Блокировка.Добавить("Справочник.НастройкиРабочегоМестаКассира");
			Блокировка.Заблокировать();
			
			Если Выборка.НоваяНастройкаРМК.Пустая() Тогда
				НастройкаОбъект = Справочники.НастройкиРабочегоМестаКассира.СоздатьЭлемент();
				НастройкаОбъект.Наименование = РеквизитыСтаройНастройки.Наименование;
			Иначе
				НастройкаОбъект = Выборка.НоваяНастройкаРМК.ПолучитьОбъект();
			КонецЕсли;
			
			Если РаспределениеНоменклатуры.Количество() > 0 Тогда
				Для Каждого СтрокаТаблицы Из РаспределениеНоменклатуры Цикл
					НоваяСтрока = НастройкаОбъект.РаспределениеНоменклатуры.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
				КонецЦикла;
				НастройкаОбъект.ГруппыКатегории = РеквизитыСтаройНастройки.ГруппыКатегории;
			КонецЕсли;
			
			Если СтруктурныеЕдиницы.Количество() > 0 Тогда
				Для Каждого СтрокаТаблицы Из СтруктурныеЕдиницы Цикл
					НоваяСтрока = НастройкаОбъект.СтруктурныеЕдиницы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
				КонецЦикла;
				НастройкаОбъект.РазрешитьВыборСклада = Истина;
			КонецЕсли;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаОбъект);
			
		КонецЦикла;
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		ЗафиксироватьТранзакцию();
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИмяСобытия = НСтр("ru = 'Выполнение обработчика обновления переноса настроек РМК'",
		ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		ПараметрыОбработчика.ОбработкаЗавершена = Ложь;
		
	КонецПопытки;
	
КонецПроцедуры

