Процедура ДополнитьОписаниеИСАлкогольнойПродукции(ПараметрыОбработчика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СправочникНоменклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК СправочникНоменклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|		ПО (ОписаниеНоменклатурыИС.Номенклатура = СправочникНоменклатура.Ссылка)
		|ГДЕ
		|	СправочникНоменклатура.УдалитьВидПродукцииИС = &ПустаяОсобенностьУчета
		|	И ЕСТЬNULL(ОписаниеНоменклатурыИС.КлючВидовПродукции, &ПустойКлючВидовПродукции) = &ПустойКлючВидовПродукции
		|	И СправочникНоменклатура.АлкогольнаяПродукция
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("ПустаяОсобенностьУчета",   Перечисления.ВидыПродукцииИС.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойКлючВидовПродукции", Справочники.КлючиВидовПродукцииИС.ПустаяСсылка());
	
	ПозицииНоменклатуры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если ПозицииНоменклатуры.Количество() Тогда
		ПараметрыОбработчика.ОбработкаЗавершена = Ложь;
	Иначе
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	ДанныеДляОбработки  = ОбновлениеИнформационнойБазыГосИС.ДанныеДляОбработкиНоменклатурыПриПереходеНаКонструкторНастроек(
		ПозицииНоменклатуры);
	
	ЕстьОшибки = Ложь;
	Для Каждого СтрокаТаблицы Из ДанныеДляОбработки.ТаблицаНоменклатуры Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			ТекущееОписание = ДанныеДляОбработки.ОписаниеНоменклатуры[СтрокаТаблицы.Номенклатура];
			
			РезультатОбработки = ОбновлениеИнформационнойБазыГосИС.ОбработатьСтрокуТаблицыНоменклатурыПриПереходеНаКонструкторНастроек(
				СтрокаТаблицы,
				ДанныеДляОбработки);
			
			Если РезультатОбработки.ЕстьОшибки Тогда
				ВызватьИсключение РезультатОбработки.ТекстОшибки;
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ЕстьОшибки = Истина;
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru = 'Не удалось обработать номенклатуру ""%1"" при переходе на конструктор настроек видов продукции по причине:
					       |%2'"),
				СтрокаТаблицы.Номенклатура,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.Номенклатура,
				ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		ПараметрыОбработчика.ОбработкаЗавершена = Ложь;
	Иначе
		ПараметрыОбработчика.ОбработкаЗавершена = Истина;
	КонецЕсли;
	
КонецПроцедуры

