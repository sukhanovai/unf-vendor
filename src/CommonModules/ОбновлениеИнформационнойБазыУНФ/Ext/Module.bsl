		ЭлементНДФЛСотрудники.Код = "00-000030";        
		ЭлементНДФЛСотрудники.КодБК = "18210102230011000110";
		ЭлементНДФЛСотрудники.ВидНалога = Перечисления.ВидыНалогов.НДФЛ; 
		Справочники.ВидыНалогов.ЗаполнитьСчетаУчета(ЭлементНДФЛСотрудники);
