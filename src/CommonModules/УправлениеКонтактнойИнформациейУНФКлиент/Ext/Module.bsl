
#Область ПрограммныйИнтерфейс

Функция ИмяЭлементаДляРазмещения(Форма, Элемент) Экспорт
	
	ОтборРеквизитов = Новый Структура("ИмяРеквизита", Элемент.Имя);
	ОписаниеРеквизитаКИ = Форма["КонтактнаяИнформацияОписаниеДополнительныхРеквизитов"].НайтиСтроки(ОтборРеквизитов);
	Если ОписаниеРеквизитаКИ.Количество() <> 0 Тогда
		ИмяЭлементаДляРазмещения = ОписаниеРеквизитаКИ[0].ИмяЭлементаДляРазмещения;
	Иначе
		ИмяЭлементаДляРазмещения = Неопределено;
	КонецЕсли;
	
	Возврат ИмяЭлементаДляРазмещения;
	
КонецФункции

Функция ОбработчикДействияПозвонитьПоТелефону(КонтактнаяИнформация, ДополнительныеПараметры) Экспорт
	
	Если ПустаяСтрока(КонтактнаяИнформация.Представление)
		И ЗначениеЗаполнено(ДополнительныеПараметры.ИмяРеквизита) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Для совершения звонка заполните номер телефона'"), , ДополнительныеПараметры.ИмяРеквизита);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТелефонияКлиент.ПоддерживаютсяВызовы() Тогда
		ТелефонияКлиент.ПозвонитьПоНомеру(КонтактнаяИнформация.Представление, ДополнительныеПараметры.ВладелецКонтактнойИнформации);
	Иначе
		ОбработчикДействияСозданияСобытия(КонтактнаяИнформация, ДополнительныеПараметры);
	КонецЕсли;
	
КонецФункции

// Выполняет открытие формы создания документа Событие (телефонный звонок) для планирования звонка контрагенту
//
// Параметры:
//  КонтактнаяИнформация - Структура - информация о контактном телефоне контрагнета.
//  ДополнительныеПараметры - Структура - данные по форме клиентского приложения из которого выполнен вызов процедуры.
//
Функция ОбработчикДействияЗапланироватьЗвонок(КонтактнаяИнформация, ДополнительныеПараметры) Экспорт
	
	Если ПустаяСтрока(КонтактнаяИнформация.Представление)
		И ЗначениеЗаполнено(ДополнительныеПараметры.ИмяРеквизита) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Для совершения звонка заполните номер телефона.'"), , ДополнительныеПараметры.ИмяРеквизита);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбработчикДействияСозданияСобытия(КонтактнаяИнформация, ДополнительныеПараметры, Истина);
	
КонецФункции

Функция ОбработчикДействияНаписатьTelegram(КонтактнаяИнформация, ДополнительныеПараметры) Экспорт
	
	НомерТелефона = УправлениеКонтактнойИнформациейУНФКлиентСервер.НомерТелефонаВМеждународномФормате(КонтактнаяИнформация.Представление);
	Ссылка = "https://t.me/%1";
	Ссылка = СтрШаблон(Ссылка, НомерТелефона);
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(Ссылка);
	
КонецФункции

Функция ОбработчикДействияНаписатьWhatsApp(КонтактнаяИнформация, ДополнительныеПараметры) Экспорт
	
	НомерТелефона = УправлениеКонтактнойИнформациейУНФКлиентСервер.НомерТелефонаВМеждународномФормате(КонтактнаяИнформация.Представление);
	Ссылка = "https://wa.me/%1";
	Ссылка = СтрШаблон(Ссылка, НомерТелефона);
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(Ссылка);
	
КонецФункции

Функция ОбработчикДействияЛичнаяВстреча(КонтактнаяИнформация, ДополнительныеПараметры) Экспорт
	
	ОбработчикДействияСозданияСобытия(КонтактнаяИнформация, ДополнительныеПараметры);
	
КонецФункции

Функция ОбработчикДействияПрочееСобытие(КонтактнаяИнформация, ДополнительныеПараметры) Экспорт
	
	ОбработчикДействияСозданияСобытия(КонтактнаяИнформация, ДополнительныеПараметры);
	
КонецФункции

Функция ОбработчикДействияНастроитьСвойстваАдреса(КонтактнаяИнформация, ДополнительныеПараметры) Экспорт
    
	КИОписаниеДополнительныхРеквизитов =
	ДополнительныеПараметры.Форма.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов;
	Если КИОписаниеДополнительныхРеквизитов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Отбор = Новый Структура( "Вид", КонтактнаяИнформация.Вид );
    КИОписаниеДополнительныхРеквизитовСтроки = КИОписаниеДополнительныхРеквизитов.НайтиСтроки( Отбор );
    Если КИОписаниеДополнительныхРеквизитовСтроки.Количество() = 0 Тогда
    	Возврат Неопределено;
    КонецЕсли;

   	КИОписаниеДополнительныхРеквизитовСтрока = КИОписаниеДополнительныхРеквизитовСтроки[0];	
	ИмяЭлементаДляРазмещения = КИОписаниеДополнительныхРеквизитовСтрока.ИмяЭлементаДляРазмещения;

	ДополнительныеПараметры.Вставить( "ИмяЭлементаДляРазмещения", ИмяЭлементаДляРазмещения);
    ДополнительныеПараметры.Вставить( "ВидКонтактнойИнформации", КонтактнаяИнформация.Вид );
    
   	Если КИОписаниеДополнительныхРеквизитовСтрока.ХранитьИсториюИзменений = Ложь Тогда
   	
	    // если хранение истории не включено, то предложим включить и поменять вид поля на "Диалог",
    	// так как в текущей версии БСП хранение истории допустимо только для "Диалог"
    	
		ОповещениеОЗавершении = Новый ОписаниеОповещения( 
		"НастроитьСвойстваАдресаПослеВопросаВключенияИстории", 
		УправлениеКонтактнойИнформациейУНФКлиент, 
		ДополнительныеПараметры);
   		
   		ВопросШаблон = НСтр( "ru = 'Для включения хранения истории вида адреса ""%1"" необходимо поменять способ ввода на ""Диалог"".
                              |Продолжить ?'" );
   		ВопросТекст = СтрШаблон( ВопросШаблон, КонтактнаяИнформация.Вид );
   		ПоказатьВопрос( ОповещениеОЗавершении, ВопросТекст, РежимДиалогаВопрос.ДаНетОтмена, , , 
   		НСтр( "ru = 'Включение истории для адреса'" ) );
   	КонецЕсли;
   	
    Возврат Неопределено;
	
КонецФункции

Функция ОбработчикДействияНаписатьВМессенджерWhatsApp(КонтактнаяИнформация, ДополнительныеПараметры) Экспорт
	
