		ДополнительныеПараметры);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФукнции

Процедура НастроитьСвойстваАдресаПослеЗавершения(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
    
    Результат = Неопределено;
    УправлениеКонтактнойИнформациейКлиент.ПослеЗакрытияФормыСпискаВидыКонтактнойИнформации(Результат,
    	ДополнительныеПараметры);
		
КонецПроцедуры

Процедура НастроитьСвойстваАдресаПослеВопросаВключенияИстории(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если КонтактнаяИнформацияУНФВызовСервера.АдресВключитьХранениеИстории( 
		ДополнительныеПараметры.ВидКонтактнойИнформации ) <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Неопределено;
	УправлениеКонтактнойИнформациейКлиент.ПослеЗакрытияФормыСпискаВидыКонтактнойИнформации(Результат,
		ДополнительныеПараметры);
	
КонецПроцедуры

Функция ТипСобытияПоТипуКонтактнойИнформации(ТипКИ)
	
	Если ТипКИ = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Skype") Тогда
		ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.Прочее");
	ИначеЕсли ТипКИ = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес") Тогда
		ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.ЛичнаяВстреча");
	ИначеЕсли ТипКИ = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты") Тогда
		ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.ЭлектронноеПисьмо");
	ИначеЕсли ТипКИ = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.ВебСтраница") Тогда
		ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.Прочее");
	ИначеЕсли ТипКИ = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Другое") Тогда
		ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.Прочее");
	ИначеЕсли ТипКИ = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Телефон") Тогда
		ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.ТелефонныйЗвонок");
	ИначеЕсли ТипКИ = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Факс") Тогда
		ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.ТелефонныйЗвонок");
	Иначе
		ТипСобытия = ПредопределенноеЗначение("Перечисление.ТипыСобытий.ПустаяСсылка");
	КонецЕсли;
	
	Возврат ТипСобытия;
	
КонецФункции

Процедура ОбработчикДействияСозданияСобытия(КонтактнаяИнформация, Знач ДополнительныеПараметры,
	ЭтоПланированиеЗвонка = Ложь)
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.ВладелецКонтактнойИнформации) Тогда
		
		СоздатьСобытие(КонтактнаяИнформация, ДополнительныеПараметры);
		
	Иначе
		
		ДополнительныеПараметрыОповещения = Новый Структура;
		ДополнительныеПараметрыОповещения.Вставить("КонтактнаяИнформация", КонтактнаяИнформация);
		ДополнительныеПараметрыОповещения.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
		ДополнительныеПараметрыОповещения.Вставить("ЭтоПланированиеЗвонка", ЭтоПланированиеЗвонка);
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОбработчикДействияСозданияСобытияВопросЗадан", ЭтотОбъект, ДополнительныеПараметрыОповещения);
		
		ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
		ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
		
		СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(
		ОписаниеОповещения,
		Новый ФорматированнаяСтрока(НСтр("ru = 'Данные еще не записаны.
		|Выполнение операции возможно только после записи данных.
		|Данные будут записаны.'")),
		РежимДиалогаВопрос.ОКОтмена,
		ПараметрыВопроса);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработчикДействияСозданияСобытияВопросЗадан(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Или Результат.Значение <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеПараметры.ДополнительныеПараметры.Форма.Записать() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеПараметры.ДополнительныеПараметры.Свойство("ВладелецКонтактнойИнформации")
		Или ТипЗнч(ДополнительныеПараметры.ДополнительныеПараметры.ВладелецКонтактнойИнформации) <>
		ТипЗнч(ДополнительныеПараметры.ДополнительныеПараметры.Форма.Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.ДополнительныеПараметры.ВладелецКонтактнойИнформации =
	ДополнительныеПараметры.ДополнительныеПараметры.Форма.Объект.Ссылка;
	
	СоздатьСобытие(
	ДополнительныеПараметры.КонтактнаяИнформация,
	ДополнительныеПараметры.ДополнительныеПараметры,
	ДополнительныеПараметры.ЭтоПланированиеЗвонка);
	
КонецПроцедуры

Процедура СоздатьСобытие(КонтактнаяИнформация, ДополнительныеПараметры, ЭтоПланированиеЗвонка = Ложь);
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ТипСобытия", ТипСобытияПоТипуКонтактнойИнформации(КонтактнаяИнформация.Тип));
	ЗначенияЗаполнения.Вставить("ОснованиеЗаполнения", ДополнительныеПараметры.ВладелецКонтактнойИнформации);
	
	Если ЭтоПланированиеЗвонка Тогда
		ЗначенияЗаполнения.Вставить("ИспользоватьНастройкиТелефонии", Ложь);
	КонецЕсли;
	
	ОткрытьФорму(
	"Документ.Событие.ФормаОбъекта",
	Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения),
	ДополнительныеПараметры.Форма);
	
КонецПроцедуры

#КонецОбласти
