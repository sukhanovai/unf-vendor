Процедура ОбновитьПорядокОбластей(НастройкаОбъект, ИменаОбластей, ЭлементМодифицирован, ВертикальнаяОриентация)
	
	ПорядкиОбластей = Новый Структура();
	ПорядкиОбластей.Вставить("ПорядокПанелиИзбранных", 2);
	ПорядкиОбластей.Вставить("ПорядокГруппыИнфо", 0);
	ПорядкиОбластей.Вставить("ПорядокТаблицыТоваров", 0);
	МинимальныйИндекс = -1;
	МаксимальныйИндекс = -1;
	ОтборКонтейнера = Новый Структура("ОбластьРодитель", ИменаОбластей.КонтейнерРаботыСТоварами);
	СтрокиКонтейнера = НастройкаОбъект.ПорядокОбластей.НайтиСтроки(ОтборКонтейнера);
	
	ОтборДанныеЧека = Новый Структура("Область", ИменаОбластей.ДанныеЧека);
	СтрокиДанныеЧека = НастройкаОбъект.ПорядокОбластей.НайтиСтроки(ОтборДанныеЧека);
	
	Если СтрокиКонтейнера.Количество() > 0 И СтрокиДанныеЧека.Количество() = 0 Тогда
		
		ЭлементМодифицирован = Истина;
		Для каждого СтрокаКонтейнера Из СтрокиКонтейнера Цикл
			Если СтрокаКонтейнера.Область = ИменаОбластей.ПанельИзбранныхТоваров Тогда
				ПорядкиОбластей.ПорядокПанелиИзбранных = ?(СтрокаКонтейнера.Порядок = 1, 1, 2);
			ИначеЕсли СтрокаКонтейнера.Область = ИменаОбластей.ГруппаИнфо Тогда
				ПорядкиОбластей.ПорядокГруппыИнфо = СтрокаКонтейнера.Порядок;
			ИначеЕсли СтрокаКонтейнера.Область = ИменаОбластей.ПанельТаблицыТоваров Тогда
				ПорядкиОбластей.ПорядокТаблицыТоваров = СтрокаКонтейнера.Порядок;
			КонецЕсли;
			
			ИндексСтроки = НастройкаОбъект.ПорядокОбластей.Индекс(СтрокаКонтейнера);
			Если МинимальныйИндекс = -1 Или МинимальныйИндекс > ИндексСтроки Тогда
				МинимальныйИндекс = ИндексСтроки;
			КонецЕсли;
			Если МаксимальныйИндекс < ИндексСтроки Тогда
				МаксимальныйИндекс = ИндексСтроки;
			КонецЕсли;
		КонецЦикла;
		
		Счт = МаксимальныйИндекс;
		Пока Счт >= МинимальныйИндекс Цикл
			СтрокаПорядка = НастройкаОбъект.ПорядокОбластей.Получить(Счт);
			Если СтрокаПорядка.Область = ИменаОбластей.ГруппаИнфо
					Или СтрокаПорядка.Область = ИменаОбластей.ПанельТаблицыТоваров Тогда
				НастройкаОбъект.ПорядокОбластей.Удалить(Счт);
			КонецЕсли;
			Счт = Счт - 1;
		КонецЦикла;
		
		ОтборИзбранное = Новый Структура("Область", ИменаОбластей.ПанельИзбранныхТоваров);
		СтрокиИзбранного = НастройкаОбъект.ПорядокОбластей.НайтиСтроки(ОтборИзбранное);
		Если СтрокиИзбранного.Количество() > 0 Тогда
			СтрокиИзбранного[0].Порядок = ПорядкиОбластей.ПорядокПанелиИзбранных;
			ИндексИзбранного = НастройкаОбъект.ПорядокОбластей.Индекс(СтрокиИзбранного[0]);
			ДобавитьИзмененныеОбласти(НастройкаОбъект, ИменаОбластей,
				ИндексИзбранного, ПорядкиОбластей, ВертикальнаяОриентация);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьИзмененныеОбласти(НастройкаОбъект, ИменаОбластей,
		ИндексИзбранного, ПорядкиОбластей, ВертикальнаяОриентация)
		
	СтрокаДанныеЧека = НастройкаОбъект.ПорядокОбластей.Вставить(ИндексИзбранного);
	СтрокаДанныеЧека.ОбластьРодитель = ИменаОбластей.КонтейнерРаботыСТоварами;
	СтрокаДанныеЧека.Область = ИменаОбластей.ДанныеЧека;
	СтрокаДанныеЧека.Порядок = ?(ПорядкиОбластей.ПорядокПанелиИзбранных = 2, 1, 2);
	СтрокаДанныеЧека.ВертикальнаяОриентация = ВертикальнаяОриентация;
	
	СтрокаГруппаИнфо = НастройкаОбъект.ПорядокОбластей.Вставить(ИндексИзбранного + 1);
	СтрокаГруппаИнфо.ОбластьРодитель = ИменаОбластей.ДанныеЧека;
	СтрокаГруппаИнфо.Область = ИменаОбластей.ГруппаИнфо;
	СтрокаГруппаИнфо.Порядок = ?(ПорядкиОбластей.ПорядокГруппыИнфо > ПорядкиОбластей.ПорядокТаблицыТоваров, 2, 1);
	СтрокаГруппаИнфо.ВертикальнаяОриентация = ВертикальнаяОриентация;
	
	СтрокаПанельТаблицыТоваров = НастройкаОбъект.ПорядокОбластей.Вставить(ИндексИзбранного + 2);
	СтрокаПанельТаблицыТоваров.ОбластьРодитель = ИменаОбластей.ДанныеЧека;
	СтрокаПанельТаблицыТоваров.Область = ИменаОбластей.ПанельТаблицыТоваров;
	СтрокаПанельТаблицыТоваров.Порядок
		= ?(ПорядкиОбластей.ПорядокГруппыИнфо > ПорядкиОбластей.ПорядокТаблицыТоваров, 1, 2);
	СтрокаПанельТаблицыТоваров.ВертикальнаяОриентация = ВертикальнаяОриентация;
	
КонецПроцедуры

Процедура ОбновитьРежимНачальнойСтраницы() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиРабочегоМестаКассира.Ссылка КАК НастройкаРМК
	|ИЗ
	|	Справочник.НастройкиРабочегоМестаКассира КАК НастройкиРабочегоМестаКассира";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.НастройкиРабочегоМестаКассира");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.НастройкаРМК);
			Блокировка.Заблокировать();
			
			ЭлементМодифицирован = Ложь;
			ОбъектНастройкаРМК = Выборка.НастройкаРМК.ПолучитьОбъект();
			Если ОбъектНастройкаРМК.УдалитьРежимНачальнойСтраницы = 2 Тогда
				ОбъектНастройкаРМК.ОсновнойПодборПлиточный = Истина;
				ЭлементМодифицирован = Истина;
			ИначеЕсли ОбъектНастройкаРМК.УдалитьРежимНачальнойСтраницы = 1 Тогда
				ОбъектНастройкаРМК.ОсновнойПодборПлиточный = Ложь;
				ЭлементМодифицирован = Истина;
			КонецЕсли;
			ОбновитьПорядокГоризонтальныхОбластей(ОбъектНастройкаРМК, ЭлементМодифицирован);
			ОбновитьПорядокВертикальныхОбластей(ОбъектНастройкаРМК, ЭлементМодифицирован);
			
			Если ЭлементМодифицирован Тогда
				ОбъектНастройкаРМК.ОбменДанными.Загрузка = Истина;
				ОбъектНастройкаРМК.Записать();
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
			ТекстСообщения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИмяСобытия = НСтр("ru = 'Ошибка при обновлении настроек РМК'", КодОсновногоЯзыка);
			ЗаписьЖурналаРегистрации(ИмяСобытия,
				УровеньЖурналаРегистрации.Ошибка,
				Выборка.НастройкаРМК,
				,
				ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьНастройкуОтображенияОстатков() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
