Процедура ОбновитьВложенныеПалитрыНастроек() Экспорт
	
	ЗапросНастроекСПалитрами = Новый Запрос;
	ЗапросНастроекСПалитрами.Текст =
	"ВЫБРАТЬ
	|	НастройкиРабочегоМестаКассира.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НастройкиРабочегоМестаКассира КАК НастройкиРабочегоМестаКассира
	|ГДЕ
	|	НЕ(НастройкиРабочегоМестаКассира.СтруктураПлиточногоИнтерфейсаПодбора = ЗНАЧЕНИЕ(Справочник.ПалитраТоваровРМК.ПустаяСсылка)
	|				И НастройкиРабочегоМестаКассира.СтруктураБыстрыхТоваров = ЗНАЧЕНИЕ(Справочник.ПалитраТоваровРМК.ПустаяСсылка))
	|	И НЕ НастройкиРабочегоМестаКассира.ПометкаУдаления";
	
	РезультатЗапроса = ЗапросНастроекСПалитрами.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НастройкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
			АктуализироватьСписокПалитр(НастройкаОбъект, "СтруктураПлиточногоИнтерфейсаПодбора", "ПалитрыПлиточныйИнтерфейс");
			АктуализироватьСписокПалитр(НастройкаОбъект, "СтруктураБыстрыхТоваров", "ПалитрыИзбранное");
			НастройкаОбъект.ОбменДанными.Загрузка = Истина;
			НастройкаОбъект.Записать();
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура АктуализироватьСписокПалитр(НастройкаОбъект, ИмяРеквизита, ИмяТабличнойЧасти)
	
	НастройкаОбъект[ИмяТабличнойЧасти].Очистить();
	Если ЗначениеЗаполнено(НастройкаОбъект[ИмяРеквизита]) Тогда
		ИсходныйМассив = Новый Массив;
		ИсходныйМассив.Добавить(НастройкаОбъект[ИмяРеквизита]);
		ПодчиненныеПалитры = ИнтерфейсРМКСлужебный.ПолучитьВложенныеПалитры(ИсходныйМассив);
		ПалитрыПризнакСлужебная = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ПодчиненныеПалитры, "Служебная");
		НоваяСтрока = НастройкаОбъект[ИмяТабличнойЧасти].Добавить();
		НоваяСтрока.Палитра = НастройкаОбъект[ИмяРеквизита];
		Для Каждого ПалитраСПризнаком Из ПалитрыПризнакСлужебная Цикл
			Если Не ПалитраСПризнаком.Значение Тогда
				НоваяСтрока = НастройкаОбъект[ИмяТабличнойЧасти].Добавить();
				НоваяСтрока.Палитра = ПалитраСПризнаком.Ключ;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция НеобходимоОбновитьПалитру(ПалитраСсылка, ПараметрЦветаПалитры)
	
	РезультатФункции = Ложь;
	
	Если СокрЛП(ПалитраСсылка.ЦветФонаКнопки) = "" Или СокрЛП(ПалитраСсылка.ЦветФонаПапки) = "" Тогда
		РезультатФункции = Истина;
	Иначе
		КоличествоСтрок = ПалитраСсылка.Состав.Количество();
		ИндексСтроки = 0;
		Пока ИндексСтроки < КоличествоСтрок И Не РезультатФункции Цикл
			СтрокаСостава = ПалитраСсылка.Состав.Получить(ИндексСтроки);
			Если ЗначениеЗаполнено(СтрокаСостава.Номенклатура)
				И СтрокаСостава.ЦветФона = ПараметрЦветаПалитры.ЦветФонаКнопкиУстаревшийСтрокой Тогда
				
				РезультатФункции = Истина;
				
			КонецЕсли;
			ИндексСтроки = ИндексСтроки + 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ОбновитьЦветаПалитрыЗначениямиПоУмолчанию(ПалитраСсылка, ПараметрЦветаПалитры)
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ПалитраТоваровРМК");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ПалитраСсылка);
		Блокировка.Заблокировать();
		
		ПалитраОбъект = ПалитраСсылка.ПолучитьОбъект();
		
		Если СокрЛП(ПалитраОбъект.ЦветФонаКнопки) = "" Тогда
			ПалитраОбъект.ЦветФонаКнопки = ПараметрЦветаПалитры.ЦветФонаКнопкиСтрокой;
		КонецЕсли;
		Если СокрЛП(ПалитраОбъект.ЦветФонаПапки) = "" Тогда
			ПалитраОбъект.ЦветФонаПапки = ПараметрЦветаПалитры.ЦветФонаПапкиСтрокой;
		КонецЕсли;
		Для Каждого СтрокаСостава Из ПалитраОбъект.Состав Цикл
			
			Если ЗначениеЗаполнено(СтрокаСостава.Номенклатура)
				И СтрокаСостава.ЦветФона = ПараметрЦветаПалитры.ЦветФонаКнопкиУстаревшийСтрокой Тогда
				
				СтрокаСостава.ЦветФона = ПараметрЦветаПалитры.ЦветФонаКнопкиСтрокой;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ПалитраОбъект.ОбменДанными.Загрузка = Истина;
		ПалитраОбъект.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ТекстСообщения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИмяСобытия = НСтр("ru = 'Ошибка при обновлении палитры РМК'", КодОсновногоЯзыка);
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,
			ПалитраСсылка,
			,
			ТекстСообщения);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьЦветаПалитрыПоУмолчанию() Экспорт
	
	ПараметрЦветаПалитры = Новый Структура();
	
	ЦветФонаКнопкиСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ЦветаСтиля.ЦветФонаСтаканаРМК);
	ЦветФонаПапкиСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ЦветаСтиля.ЦветПапкиКнопкиРМК);
	ЦветФонаКнопкиУстаревшийСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ЦветаСтиля.ЦветАктивнойКнопкиРМК);
	
	ПараметрЦветаПалитры.Вставить("ЦветФонаКнопкиСтрокой", ЦветФонаКнопкиСтрокой);
	ПараметрЦветаПалитры.Вставить("ЦветФонаПапкиСтрокой", ЦветФонаПапкиСтрокой);
	ПараметрЦветаПалитры.Вставить("ЦветФонаКнопкиУстаревшийСтрокой", ЦветФонаКнопкиУстаревшийСтрокой);
	
	ЗапросПалитр = Новый Запрос;
	ЗапросПалитр.Текст =
	"ВЫБРАТЬ
	|	ПалитраТоваровРМК.Ссылка КАК Палитра
	|ИЗ
	|	Справочник.ПалитраТоваровРМК КАК ПалитраТоваровРМК";
	
	РезультатЗапроса = ЗапросПалитр.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаПалитр = РезультатЗапроса.Выбрать();
		Пока ВыборкаПалитр.Следующий() Цикл
			
			ПалитраСсылка = ВыборкаПалитр.Палитра;
			Если НеобходимоОбновитьПалитру(ПалитраСсылка, ПараметрЦветаПалитры) Тогда
				
				ОбновитьЦветаПалитрыЗначениямиПоУмолчанию(ПалитраСсылка, ПараметрЦветаПалитры);
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьНастройкиРабочегоМестаКассира() Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	НастройкиРабочегоМестаКассира.Ссылка КАК НастройкаРМК
	|ИЗ
	|	Справочник.НастройкиРабочегоМестаКассира КАК НастройкиРабочегоМестаКассира
	|ГДЕ
	|	НЕ НастройкиРабочегоМестаКассира.ПометкаУдаления";
	
	ИспользоватьЗаменуТоваров = ОбщегоНазначенияРМК.ИспользоватьЗаменуТоваров();
	ПечататьКороткийСлипЧек = ОбщегоНазначенияРМК.ФормироватьИнтегрированныйСлипЧек();
	ИспользоватьКонтрольПродаж = ОбщегоНазначенияРМК.ИспользоватьКонтрольПродаж();
	ИспользоватьОплатуСертификатамиНСПК = ОбщегоНазначенияРМК.ИспользоватьОплатуСертификатамиНСПК();
	ИспользоватьСерверЛояльностиПолучательДанных = ОбщегоНазначенияРМК.ИспользоватьСерверЛояльностиПолучательДанных();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НачатьТранзакцию();
			
			Попытка
				
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("Справочник.НастройкиРабочегоМестаКассира");
				ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.НастройкаРМК);
				Блокировка.Заблокировать();
				
				ОбъектНастройкаРМК = Выборка.НастройкаРМК.ПолучитьОбъект();
				Если ИспользоватьЗаменуТоваров Тогда
					ОбъектНастройкаРМК.ИспользоватьЗаменуТоваров = Истина;
				КонецЕсли;
				
				Если ПечататьКороткийСлипЧек Тогда
					ОбъектНастройкаРМК.ПечататьКороткийСлипЧек = Истина;
				КонецЕсли;
				
				Если ИспользоватьОплатуСертификатамиНСПК Тогда
					ОбъектНастройкаРМК.ИспользоватьОплатуСертификатамиНСПК = Истина;
				КонецЕсли;
				
				Если ИспользоватьСерверЛояльностиПолучательДанных Тогда
					ОбъектНастройкаРМК.ИспользоватьСерверЛояльностиПолучательДанных = Истина;
				КонецЕсли;
				
				Если ИспользоватьКонтрольПродаж Тогда
					ОбъектНастройкаРМК.ИспользоватьКонтрольПродаж = Истина;
				КонецЕсли;
				
				ОбъектНастройкаРМК.Записать();
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
				ТекстСообщения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИмяСобытия = НСтр("ru = 'Ошибка при обновлении настроек РМК'", КодОсновногоЯзыка);
					ЗаписьЖурналаРегистрации(ИмяСобытия,
					УровеньЖурналаРегистрации.Ошибка,
					Выборка.НастройкаРМК,
					,
					ТекстСообщения);
				
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаменитьУстаревшиеОбластиНастройкиРМК(НастройкаРМК, ИмяГоризонтальнойПанели, ИмяВертикальнойПанели)
	
	ИмяНовойГоризонтальнойПанели = "ПанельИзбранныхТоваров_Горизонтальная";
	ИмяНовойВертикальнойПанели = "ПанельИзбранныхТоваров_Вертикальная";
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.НастройкиРабочегоМестаКассира");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", НастройкаРМК);
		Блокировка.Заблокировать();
		
		ОбъектНастройкаРМК = НастройкаРМК.ПолучитьОбъект();
		
		ОтборГоризонтальныхОбластей = Новый Структура("Область", ИмяГоризонтальнойПанели);
		СтрокиГоризонтальныхОбластей = ОбъектНастройкаРМК.ПорядокОбластей.НайтиСтроки(ОтборГоризонтальныхОбластей);
		Для Каждого СтрокаОбласти Из СтрокиГоризонтальныхОбластей Цикл
			СтрокаОбласти.Область = ИмяНовойГоризонтальнойПанели;
		КонецЦикла;
		
		ОтборВертикальныхОбластей = Новый Структура("Область", ИмяВертикальнойПанели);
		СтрокиВертикальныхОбластей = ОбъектНастройкаРМК.ПорядокОбластей.НайтиСтроки(ОтборВертикальныхОбластей);
		Для Каждого СтрокаОбласти Из СтрокиВертикальныхОбластей Цикл
			СтрокаОбласти.Область = ИмяНовойВертикальнойПанели;
		КонецЦикла;
		
		ОбъектНастройкаРМК.ОбменДанными.Загрузка = Истина;
		ОбъектНастройкаРМК.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ТекстСообщения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИмяСобытия = НСтр("ru = 'Ошибка при обновлении настроек РМК'", КодОсновногоЯзыка);
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,
			НастройкаРМК,
			,
			ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

Процедура АктуализироватьОбластиНастроекПорядкаОбластей() Экспорт
	
	ИмяГоризонтальнойПанели = "СтраницыПанелиИзбранноеПодбор_Горизонтальная";
	ИмяВертикальнойПанели = "СтраницыПанелиИзбранноеПодбор_Вертикальная";
	
	УстаревшиеОбласти = Новый Массив;
	УстаревшиеОбласти.Добавить(ИмяГоризонтальнойПанели);
	УстаревшиеОбласти.Добавить(ИмяВертикальнойПанели);
	
	ЗапросНастроек = Новый Запрос;
	ЗапросНастроек.Текст =
	"ВЫБРАТЬ
	|	НастройкиРабочегоМестаКассираПорядокОбластей.Ссылка КАК НастройкаРМК
	|ИЗ
	|	Справочник.НастройкиРабочегоМестаКассира.ПорядокОбластей КАК НастройкиРабочегоМестаКассираПорядокОбластей
	|ГДЕ
	|	НастройкиРабочегоМестаКассираПорядокОбластей.Область В(&УстаревшиеОбласти)";
	ЗапросНастроек.УстановитьПараметр("УстаревшиеОбласти", УстаревшиеОбласти);
	РезультатЗапроса = ЗапросНастроек.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаменитьУстаревшиеОбластиНастройкиРМК(Выборка.НастройкаРМК, ИмяГоризонтальнойПанели, ИмяВертикальнойПанели);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьПорядокОбластейВНастройкеДляПлатформы85(НастройкаОбъект, ЭлементМодифицирован)
	
	КомандаОплатитьСверхуГоризонтальная = Ложь;
	
	ОтборОбласти = Новый Структура("Область", "КоманднаяПанельУправленияЧекомГор_Горизонтальная");
	СтрокиКоманднойПанели = НастройкаОбъект.ПорядокОбластей.НайтиСтроки(ОтборОбласти);
	Если СтрокиКоманднойПанели.Количество() > 0 И СтрокиКоманднойПанели[0].Порядок = 1 Тогда
		КомандаОплатитьСверхуГоризонтальная = Истина;
	КонецЕсли;
	
	МассивИндексовУдаляемыхСтрок = Новый Массив;
	ОтборСтрок = Новый Структура("ОбластьРодитель", "ГруппаПанельИнформацииГор_Горизонтальная");
	ДобавитьИндексыСтрокВМассивУдаления(НастройкаОбъект.ПорядокОбластей, МассивИндексовУдаляемыхСтрок, ОтборСтрок);
	
	ОтборСтрок = Новый Структура("ОбластьРодитель", "КоманднаяПанельУправленияЧекомГор_Горизонтальная");
	ДобавитьИндексыСтрокВМассивУдаления(НастройкаОбъект.ПорядокОбластей, МассивИндексовУдаляемыхСтрок, ОтборСтрок);
	
	ОтборСтрок = Новый Структура("ОбластьРодитель", "ГруппаУправленияЧекомГор_Горизонтальная");
	СтрокиПорядка = НастройкаОбъект.ПорядокОбластей.НайтиСтроки(ОтборСтрок);
	УдаленаГоризонтальнаяГруппаУправленияЧеком = (СтрокиПорядка.Количество() > 0);
	Для Каждого СтрокаПорядка Из СтрокиПорядка Цикл
		ИндексСтроки = НастройкаОбъект.ПорядокОбластей.Индекс(СтрокаПорядка);
		ДобавитьИндексВПорядкеУбывания(МассивИндексовУдаляемыхСтрок, ИндексСтроки);
	КонецЦикла;
	
	ОтборСтрок = Новый Структура("ОбластьРодитель", "ВводИнформацииИОплатГор_Горизонтальная");
	СтрокиПорядка = НастройкаОбъект.ПорядокОбластей.НайтиСтроки(ОтборСтрок);
	УдаленВводИнформацииИОплат = (СтрокиПорядка.Количество() > 0);
	Для Каждого СтрокаПорядка Из СтрокиПорядка Цикл
		ИндексСтроки = НастройкаОбъект.ПорядокОбластей.Индекс(СтрокаПорядка);
		ДобавитьИндексВПорядкеУбывания(МассивИндексовУдаляемыхСтрок, ИндексСтроки);
	КонецЦикла;
	
	ОтборСтрок = Новый Структура("ОбластьРодитель", "ЛеваяСредняяКолонкиУправленияЧеком_Вертикальная");
	ДобавитьИндексыСтрокВМассивУдаления(НастройкаОбъект.ПорядокОбластей, МассивИндексовУдаляемыхСтрок, ОтборСтрок);
	
	Если УдаленаГоризонтальнаяГруппаУправленияЧеком И УдаленВводИнформацииИОплат Тогда
		ЭлементМодифицирован = Истина;
		Для Каждого ИндексУдаления Из МассивИндексовУдаляемыхСтрок Цикл
			НастройкаОбъект.ПорядокОбластей.Удалить(ИндексУдаления);
		КонецЦикла;
		
		ОтборСтрок = Новый Структура("ОбластьРодитель", "ГруппаЛевоОболочкаПорядка_Горизонтальная");
		СтрокиПорядка = НастройкаОбъект.ПорядокОбластей.НайтиСтроки(ОтборСтрок);
		Для Каждого СтрокаПорядка Из СтрокиПорядка Цикл
			СтрокаПорядка.ОбластьРодитель = "ГруппаПанельИнформацииГор_Горизонтальная";
		КонецЦикла;
		
		Если УдаленаГоризонтальнаяГруппаУправленияЧеком Тогда
			ДобавитьНастройкиПорядкаОбластейДляПлатформы85(НастройкаОбъект.ПорядокОбластей, КомандаОплатитьСверхуГоризонтальная);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьНастройкиПорядкаОбластейДляПлатформы85(ТаблицаПорядкаОбластей, КомандаОплатитьСверхуГоризонтальная)
	
	НоваяСтрока = ТаблицаПорядкаОбластей.Добавить();
	НоваяСтрока.ОбластьРодитель = "ГруппаУправленияЧекомГор_Горизонтальная";
	НоваяСтрока.Область = "СводнаяПанельИтоговЧекаГор_Горизонтальная";
	НоваяСтрока.Порядок = ?(КомандаОплатитьСверхуГоризонтальная, 2, 1);
	
	НоваяСтрока = ТаблицаПорядкаОбластей.Добавить();
	НоваяСтрока.ОбластьРодитель = "ГруппаУправленияЧекомГор_Горизонтальная";
	НоваяСтрока.Область = "ГруппаУправленияОплатамиГор_Горизонтальная";
	НоваяСтрока.Порядок = ?(КомандаОплатитьСверхуГоризонтальная, 1, 2);
	
	НоваяСтрока = ТаблицаПорядкаОбластей.Добавить();
	НоваяСтрока.ОбластьРодитель = "ГруппаУправленияОплатамиГор_Горизонтальная";
	НоваяСтрока.Область = "ВводИнформацииИтоговЧекаГор_Горизонтальная";
	НоваяСтрока.Порядок = ?(КомандаОплатитьСверхуГоризонтальная, 2, 1);
	
	НоваяСтрока = ТаблицаПорядкаОбластей.Добавить();
	НоваяСтрока.ОбластьРодитель = "ГруппаУправленияОплатамиГор_Горизонтальная";
	НоваяСтрока.Область = "КоманднаяПанельУправленияЧекомГор_Горизонтальная";
	НоваяСтрока.Порядок = ?(КомандаОплатитьСверхуГоризонтальная, 1, 2);
	
КонецПроцедуры

Процедура ДобавитьИндексыСтрокВМассивУдаления(ТаблицаПорядкаОбластей, МассивУдаления, ОтборСтрок)
	
	СтрокиПорядка = ТаблицаПорядкаОбластей.НайтиСтроки(ОтборСтрок);
	Для Каждого СтрокаПорядка Из СтрокиПорядка Цикл
		ИндексСтроки = ТаблицаПорядкаОбластей.Индекс(СтрокаПорядка);
		ДобавитьИндексВПорядкеУбывания(МассивУдаления, ИндексСтроки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьИндексВПорядкеУбывания(МассивИндексов, НовоеЗначение)
	
	ЭлементВставлен = Ложь;
	КоличествоСтрок = МассивИндексов.Количество();
	ИндексМассива = 0;
	Пока ИндексМассива < КоличествоСтрок И Не ЭлементВставлен Цикл
		ТекущийЭлементМассива = МассивИндексов.Получить(ИндексМассива);
		Если НовоеЗначение > ТекущийЭлементМассива Тогда
			МассивИндексов.Вставить(ИндексМассива, НовоеЗначение);
			ЭлементВставлен = Истина;
		КонецЕсли;
		ИндексМассива = ИндексМассива + 1;
	КонецЦикла;
	Если Не ЭлементВставлен Тогда
		МассивИндексов.Добавить(НовоеЗначение);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьНастройкиПорядкаОбластейДляПлатформы85() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиРабочегоМестаКассира.Ссылка КАК НастройкаРМК
	|ИЗ
	|	Справочник.НастройкиРабочегоМестаКассира КАК НастройкиРабочегоМестаКассира";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.НастройкиРабочегоМестаКассира");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.НастройкаРМК);
			Блокировка.Заблокировать();
			
			ЭлементМодифицирован = Ложь;
			ОбъектНастройкаРМК = Выборка.НастройкаРМК.ПолучитьОбъект();
			ОбновитьПорядокОбластейВНастройкеДляПлатформы85(ОбъектНастройкаРМК, ЭлементМодифицирован);
			Если ЭлементМодифицирован Тогда
				ОбъектНастройкаРМК.ОбменДанными.Загрузка = Истина;
				ОбъектНастройкаРМК.Записать();
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			КодОсновногоЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
			ТекстСообщения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИмяСобытия = НСтр("ru = 'Ошибка при обновлении настроек РМК при переходе на платформу 8.5'", КодОсновногоЯзыка);
			ЗаписьЖурналаРегистрации(ИмяСобытия,
				УровеньЖурналаРегистрации.Ошибка,
				Выборка.НастройкаРМК,
				,
				ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьИндексыСтрокПорядкаВМассивУдаления(ТаблицаПорядкаОбластей, МассивУдаления, СтрокиПорядка)
	
	Для Каждого СтрокаПорядка Из СтрокиПорядка Цикл
		ИндексСтроки = ТаблицаПорядкаОбластей.Индекс(СтрокаПорядка);
		ДобавитьИндексВПорядкеУбывания(МассивУдаления, ИндексСтроки);
	КонецЦикла;
	
КонецПроцедуры

Функция ПрисутствуютУстаревшиеДанныеВОбластиПравойКолнки(СтрокиПорядка)
	
	РезультатФункции = Ложь;
	
	ПорядковыйИндекс = 0;
	ИмяГруппыДанныеИтогов = "ДанныеИтоговЧекаВер_Вертикальная";
	ИмяГруппыСлоевКоманднойПанели = "ГруппаСлоевОсновнаяКоманднаяПанельУправленияЧеком_Вертикальная";
	
	Пока ПорядковыйИндекс < СтрокиПорядка.Количество() И Не РезультатФункции Цикл
		ПроверяемаяСтрока = СтрокиПорядка[ПорядковыйИндекс];
		Если ПроверяемаяСтрока.Область = ИмяГруппыСлоевКоманднойПанели
				Или ПроверяемаяСтрока.Область = ИмяГруппыДанныеИтогов Тогда
			РезультатФункции = Истина;
		КонецЕсли;
		ПорядковыйИндекс = ПорядковыйИндекс + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура УдалитьУстаревшиеСтрокиПорядка(ТаблицаПорядкаОбластей, МассивУдаления)
	
	Для Каждого ИндексУдаления Из МассивУдаления Цикл
		ТаблицаПорядкаОбластей.Удалить(ИндексУдаления);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьНастройкиПорядкаГоризонтальныхОбластей(ТаблицаПорядкаОбластей)
	
	НоваяСтрока = ТаблицаПорядкаОбластей.Добавить();
	НоваяСтрока.ОбластьРодитель = "ГруппаУправленияЧекомГор_Горизонтальная";
	НоваяСтрока.Область = "СводнаяПанельИтоговЧекаГор_Горизонтальная";
	НоваяСтрока.Порядок = 1;
	
	НоваяСтрока = ТаблицаПорядкаОбластей.Добавить();
	НоваяСтрока.ОбластьРодитель = "ГруппаУправленияЧекомГор_Горизонтальная";
	НоваяСтрока.Область = "ПраваяКолонкаУправленияЧеком_Горизонтальная";
	НоваяСтрока.Порядок = 2;
	
	НоваяСтрока = ТаблицаПорядкаОбластей.Добавить();
	НоваяСтрока.ОбластьРодитель = "ПраваяКолонкаУправленияЧеком_Горизонтальная";
	НоваяСтрока.Область = "ГруппаСуммыТоваров_Горизонтальная";
	НоваяСтрока.Порядок = 1;
	
