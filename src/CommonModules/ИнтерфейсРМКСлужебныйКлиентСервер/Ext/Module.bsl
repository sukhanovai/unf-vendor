Функция НастройкаОбластиСоответствуетСценариюИспользования(ЗаголовокОбласти, СвойствоНастройки, Сценарий) Экспорт
	
	РезультатФункции = Истина;
	ЗаголовкиОбластей = ПолучитьЗаголовкиОбластейДляНастроек();
	СценарийСамообслуживание = ПредопределенноеЗначение("Перечисление.СценарииИспользованияРМК.ТерминалСамообслуживания");
	
	СвойствоСтатусСмены = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ПоказыватьСтатусСмены");
	СвойствоОбластьПрименения = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ОбластьПрименения");
	СвойствоРазмерКнопокВПлитке
		= ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.РазмерКнопокПлиточныйИнтерфейс");
	СвойствоРазмерКнопок = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.РазмерКнопок");
	СвойствоВысотаКнопок = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ВысотаКнопок");
	
	Если ЗаголовокОбласти = ЗаголовкиОбластей.ОбластьДанныеТекущегоТовара Тогда
		
		Если (СвойствоНастройки = СвойствоРазмерКнопокВПлитке Или СвойствоНастройки = СвойствоРазмерКнопок)
				И Не Сценарий = СценарийСамообслуживание Тогда
			РезультатФункции = Ложь;
		ИначеЕсли СвойствоНастройки = СвойствоВысотаКнопок И Сценарий = СценарийСамообслуживание Тогда
			РезультатФункции = Ложь;
		КонецЕсли;
		
	ИначеЕсли ЗаголовокОбласти = ЗаголовкиОбластей.ОбластьПанельОпераций Тогда
		
		Если (СвойствоНастройки = СвойствоСтатусСмены Или СвойствоНастройки = СвойствоОбластьПрименения)
				И Сценарий = СценарийСамообслуживание Тогда
			РезультатФункции = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СкорректироватьВысотуКнопкиОплатыВРежимеКСО(КнопкаОплаты ,НастройкиКнопкиОплаты)
	
	СвойствоВысота = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ВысотаКнопок");
	ЗначениеВысоты = НастройкиКнопкиОплаты.Получить(СвойствоВысота);
	Если ЗначениеЗаполнено(ЗначениеВысоты) Тогда
		КнопкаОплаты.Родитель.Высота = ЗначениеВысоты;
		КнопкаОплаты.МаксимальнаяВысота = ЗначениеВысоты;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтрокуВидаКонтроля(СтрокиВидовКонтроля, ВидКонтроля)
	
	РезультатФункции = Неопределено;
	КоличествоСтрок = СтрокиВидовКонтроля.Количество();
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоСтрок И РезультатФункции = Неопределено Цикл
		СтрокаВидаКонтроля = СтрокиВидовКонтроля.Получить(ИндексСтроки);
		Если СтрокаВидаКонтроля.ВидКонтроля = ВидКонтроля Тогда
			РезультатФункции = СтрокаВидаКонтроля;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьСтрокуЭлементаКонтроляПродаж(ЭлементыКонтроляПродаж, КонтрольПродаж)
	
	РезультатФункции = Неопределено;
	КоличествоСтрок = ЭлементыКонтроляПродаж.Количество();
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоСтрок И РезультатФункции = Неопределено Цикл
		СтрокаЭлементаКонтроляПродаж = ЭлементыКонтроляПродаж.Получить(ИндексСтроки);
		Если СтрокаЭлементаКонтроляПродаж.КонтрольПродаж = КонтрольПродаж Тогда
			РезультатФункции = СтрокаЭлементаКонтроляПродаж;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьСтрокуКонтроля(СтрокиКонтроля, СтрокаКонтроляИсточник)
	
	РезультатФункции = Неопределено;
	КоличествоСтрок = СтрокиКонтроля.Количество();
	ИндексСтроки = 0;
	ИменаСравниваемыхПолей = "ВидКонтроля,НачалоПериода,КонецПериода,ДеньНедели,ВремяНачала,ВремяОкончания";
	Пока ИндексСтроки < КоличествоСтрок И РезультатФункции = Неопределено Цикл
		СтрокаКонтроля = СтрокиКонтроля.Получить(ИндексСтроки);
		
		Если СтруктурыИдентичны(СтрокаКонтроля, СтрокаКонтроляИсточник, ИменаСравниваемыхПолей) Тогда
			РезультатФункции = СтрокаКонтроля;
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	Возврат РезультатФункции;
	
КонецФункции

Функция СтруктурыИдентичны(СтруктураПервая, СтруктураВторая, ИменаПолей)
	
	РезультатФункции = Истина;
	МассивПолей = СтрРазделить(ИменаПолей, ",");
	
	КоличествоПолей = МассивПолей.Количество();
	ИндексПоля = 0;
	Пока ИндексПоля < КоличествоПолей И РезультатФункции = Истина Цикл
		ИмяПоля = МассивПолей[ИндексПоля];
		ЗначениеПервое = Неопределено;
		ЗначениеВторое = Неопределено;
		СтруктураПервая.Свойство(ИмяПоля, ЗначениеПервое);
		СтруктураВторая.Свойство(ИмяПоля, ЗначениеВторое);
		Если Не ЗначениеПервое = ЗначениеВторое Тогда
			РезультатФункции = Ложь;
		КонецЕсли;
		ИндексПоля = ИндексПоля + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ПеренестиНедостающиеЭлементыПростогоМассива(МассивИсточник, МассивПриемник)
	
	Для Каждого ЭлементМассива Из МассивИсточник Цикл
		Если МассивПриемник.Найти(ЭлементМассива) = Неопределено Тогда
			МассивПриемник.Добавить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтрокуНоменклатурыКонтроляПродаж(НоменклатураКонтроляПродажПриемник,
		СтрокаНоменклатурыКонтроляИсточник)
		
	РезультатФункции = Неопределено;
	КоличествоСтрок = НоменклатураКонтроляПродажПриемник.Количество();
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоСтрок И РезультатФункции = Неопределено Цикл
		СтрокаНоменклатурыКонтроляПродаж = НоменклатураКонтроляПродажПриемник.Получить(ИндексСтроки);
		Если СтрокаНоменклатурыКонтроляПродаж.Номенклатура = СтрокаНоменклатурыКонтроляИсточник.Номенклатура
			И СтрокаНоменклатурыКонтроляПродаж.Характеристика = СтрокаНоменклатурыКонтроляИсточник.Характеристика Тогда
			
			РезультатФункции = СтрокаНоменклатурыКонтроляПродаж;
			
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ВосстановитьПодсказки(ЭлементПодгруппы)
	Для Каждого ЭлементСтраницы Из ЭлементПодгруппы.ПодчиненныеЭлементы Цикл
		Если Найти(ЭлементСтраницы.Имя, "Подсказка") > 0 Тогда
			УстановитьВидимостьЭлементаФормы(ЭлементСтраницы, Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция МаскаВводаДаты()
	Возврат НСтр("ru = '99.99.9999'");
КонецФункции

Функция ОставитьЦифрыТелефонаБезКодаСтраны(ИсходноеЗначение)
	
	ДлинаНомераТелефона = 10;
	РезультатФункции = ИсходноеЗначение;
	Если СтрНайти(РезультатФункции, ТелефонныйКодСтраны()) = 1 Тогда
		РезультатФункции = Сред(РезультатФункции, СтрДлина(ТелефонныйКодСтраны()) + 1);
		РезультатФункции = ТолькоЦифры(РезультатФункции);
	Иначе
		РезультатФункции = ТолькоЦифры(РезультатФункции);
		Если СтрДлина(РезультатФункции) > ДлинаНомераТелефона Тогда
			РезультатФункции = Прав(РезультатФункции, ДлинаНомераТелефона);
		КонецЕсли;
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

Функция ПозицияПоследнейЦифрыВСтроке(ПроверяемаяСтрока)
	
	РезультатФункции = 0;
	
	КоличествоСимволов = СтрДлина(ПроверяемаяСтрока);
	ИндексСимвола = КоличествоСимволов;
	Пока ИндексСимвола > 0 И РезультатФункции = 0 Цикл
		ПроверяемыйСимвол = Сред(ПроверяемаяСтрока, ИндексСимвола, 1);
		Если СтрНайти("0123456789", ПроверяемыйСимвол) > 0 Тогда
			РезультатФункции = ИндексСимвола;
		КонецЕсли;
		ИндексСимвола = ИндексСимвола - 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПараметрыИнтерфейсаКСО()
	
	ПараметрыИнтерфейса = Новый Структура;
	ПараметрыИнтерфейса.Вставить("ВысотаКоманды", 2);
