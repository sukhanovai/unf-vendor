Функция ОписаниеКартыДляИнтерфейса(ДанныеССервераЛояльности) Экспорт
	Результат = СтруктураДанныхКартыДляИнтерфейса();
	НомерКарты = ?(ЗначениеЗаполнено(ДанныеССервераЛояльности.Barcode), ДанныеССервераЛояльности.Barcode, ДанныеССервераЛояльности.MagneticCode);
	Результат.КодКарты = НомерКарты;
	Если ДанныеССервераЛояльности.Свойство("BonusData") Тогда
		Результат.ПокупательФИО = ДанныеССервераЛояльности.ClientName;
		Результат.НомерТелефона = ДанныеССервераЛояльности.Phone;
		Результат.ПокупательПочта = ДанныеССервераЛояльности.EMail;
		Результат.ФизическоеЛицо = ДанныеССервераЛояльности.IsPerson;
		СтрокаXMLТолькоЧастьДата = Лев(ДанныеССервераЛояльности.DateOfBirth, 10);
		СтрокаДатыДляПреобразования = СтрЗаменить(СтрокаXMLТолькоЧастьДата, "-", "");
		ДатаРожденияКлиента = Дата(СтрокаДатыДляПреобразования);
		Результат.ДатаРождения = ДатаРожденияКлиента;

		Результат.ВидДисконтнойКарты =  ДанныеССервераЛояльности.TypeCard;
		Результат.КартаНедействительна =  НЕ ДанныеССервераЛояльности.Valid;
		//
		Результат.ИдентификаторКарты =  ДанныеССервераЛояльности.CardGUID;
		Результат.ОстатокБонусныхБаллов =  ДанныеССервераЛояльности.BonusData.BonusCount;
		Результат.КурсБонусов =  ДанныеССервераЛояльности.BonusData.BonusRate;
		Результат.ОстатокБалловРуб =  Результат.ОстатокБонусныхБаллов * Результат.КурсБонусов;
		Результат.КоличествоОстатокЛимит =  ДанныеССервераЛояльности.BonusData.BonusLimitBalance;
		Результат.ПродажиОборот =  ДанныеССервераЛояльности.SellCount;
		Результат.МаксимальныйПроцентОплаты =  ДанныеССервераЛояльности.BonusData.PaymentPercent;
		Результат.ИдентификаторБонуснойПрограммы =  ДанныеССервераЛояльности.BonusData.BonusGUID;
		Результат.БонуснаяПрограмма = ДанныеССервераЛояльности.BonusData.BonusGUID;
		Результат.БонуснаяПрограммаНаименование = ДанныеССервераЛояльности.BonusData.BonusName;
		Результат.ИдентификаторПокупателя = ДанныеССервераЛояльности.ClientGUID;
	Иначе
		Результат.ИдентификаторКарты =  ДанныеССервераЛояльности.CardRef;
		Результат.ОстатокБонусныхБаллов =  ДанныеССервераЛояльности.BonusCount;
		Результат.КурсБонусов =  ДанныеССервераЛояльности.BonusRate;
		Результат.ОстатокБалловРуб =  Результат.ОстатокБонусныхБаллов * Результат.КурсБонусов;
		Результат.КоличествоОстатокЛимит =  ДанныеССервераЛояльности.BonusLimitBalance;
		Результат.МаксимальныйПроцентОплаты =  ДанныеССервераЛояльности.PaymentPercent;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура ОтобразитьИнформациюОБонусныхБаллах85(Форма, ДанныеБонусов) Экспорт
	
	Элементы = Форма.Элементы;
	
	Если Форма.СписатьБаллыПоВладельцу Тогда
		КоличествоБонусов = 0;
		КоличествоБонусовКОплатеВВалюте = 0;
		Для Каждого СтрокаТаблицы Из Форма.ТаблицаВыбранныхКарт Цикл
			КоличествоБонусов = КоличествоБонусов + СтрокаТаблицы.ОстатокБонусныхБаллов;
			КоличествоБонусовКОплатеВВалюте = КоличествоБонусовКОплатеВВалюте + СтрокаТаблицы.ОстатокБонусныхБаллов * ?(СтрокаТаблицы.КурсБонусов = 0, 1, СтрокаТаблицы.КурсБонусов);
		КонецЦикла;
		Если Форма.ПроцентБонуснойПрограммы = 0 Тогда
			Форма.ПроцентОплатыБонусами = ДанныеБонусов.МаксимальныйПроцентОплаты;
		Иначе
			Форма.ПроцентОплатыБонусами = Форма.ПроцентБонуснойПрограммы;
		КонецЕсли;
		
	Иначе
		КоличествоБонусов = ДанныеБонусов.ОстатокБонусныхБаллов;
		КоличествоБонусовКОплатеВВалюте = КоличествоБонусов * ?(ДанныеБонусов.КурсБонусов = 0, 1, ДанныеБонусов.КурсБонусов);
		Форма.ПроцентОплатыБонусами = ДанныеБонусов.МаксимальныйПроцентОплаты;
	КонецЕсли;
	Форма.КоличествоБонусов = КоличествоБонусов;
	Форма.КурсБонусов = ДанныеБонусов.КурсБонусов;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеБонусов, "КоличествоБонусовОграничение") Тогда
		Форма.КоличествоБонусовОграничение = ДанныеБонусов.КоличествоБонусовОграничение;
	КонецЕсли;
	Форма.БонусыДоступноКОплате = КоличествоБонусовКОплатеВВалюте;
		
	ТекстСообщения = СтрШаблон(НСтр("ru = 'Бонусами можно оплатить до %1%% от суммы чека'"), Форма.ПроцентОплатыБонусами);
		
КонецПроцедуры

Процедура ОчиститьДанныеПанелиИзбранных(Форма) Экспорт
	
	ДанныеКнопок = Форма.ДанныеКнопок;
