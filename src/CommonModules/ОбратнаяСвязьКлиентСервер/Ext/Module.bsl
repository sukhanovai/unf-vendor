	ВопросыПоФормам.Вставить("Документ.ОтчетОПереработке.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ОтчетПереработчика.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ПеремещениеДС.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ПеремещениеДСПлан.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ПеремещениеЗапасов.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ПеремещениеПоЯчейкам.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
