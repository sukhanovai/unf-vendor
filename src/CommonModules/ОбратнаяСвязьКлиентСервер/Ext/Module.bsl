КонецФункции

// Возвращает настройку опроса по его идентификатору
// 
// Параметры:
//  Идентификатор - Строка
//  
// Возвращаемое значение:
//  - Неопределено - настройка не найдена
//  - Структура: см. ОбратнаяСвязьКлиентСервер.НастройкиОбратнойСвязи
//
Функция НастройкаОпросаПоИдентификатору(Идентификатор) Экспорт
	
	ВсеНастройки = НастройкиОпросовПоФормамИСобытиям();
	НастройкаОпроса = Неопределено;
	
	Для каждого КлючИЗначение Из ВсеНастройки Цикл
		
		ЗначениеНастройки = КлючИЗначение.Значение;
		Если ЗначениеНастройки.ИдентификаторОпроса = Идентификатор Тогда
			НастройкаОпроса = ЗначениеНастройки;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НастройкаОпроса;
	
КонецФункции

// Возвращает значение свойства настройки опроса
// 
// Параметры:
//  ИдентификаторОпроса - Строка
//  ИмяСвойства - Строка
//  
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеСвойстваНастройкиОпроса(ИдентификаторОпроса, ИмяСвойства) Экспорт
	
	ВсеНастройки = НастройкиОпросовПоФормамИСобытиям();
	Результат = Неопределено;
	
	Для каждого КлючИЗначение Из ВсеНастройки Цикл
		
		Настройка = КлючИЗначение.Значение;
		Если Настройка.ИдентификаторОпроса = ИдентификаторОпроса Тогда
			Если Настройка.Свойство(ИмяСвойства, Результат) Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру с настройками для опроса пользователей, работающих в конфигурации без опыта.
//
// Возвращаемое значение:
//   Структура:
//     * ОпытПриложения1С                          - Строка
//     * ОпытДругиеСистемыУчета                    - Строка
//     * ОпытПеречислениеСистемУчета               - Строка - перечень систем учета, с которыми есть опыт
//     * ЭтоПользовательБезОпыта                   - Булево
//     * РазрешеноВключениеИнтерфейса85            - Булево - разрешено ли включение интерфейса 8.5 при начале работы
//                                                            в приложении
//     * ИнтерфейсТаксиПередНачаломРаботы          - Булево
//     * ДатаНачалаРаботы                          - Дата - дата начала работы в конфигурации
//     * ОбщееКоличествоПроведенныхДокументов      - Число - общее количество проведенных документов
//     * УсловияДляПоказаОпросаВыполнены           - Булево - выполнены ли условия для показа опроса
//     * ПредельноеКоличествоПроведенныхДокументов - Число - пороговое количество проведенных документов для опроса 
//     * МинимальноеКоличествоДнейРаботы           - Число - минимальное количество дней работы для опроса
//     * ПредельноеКоличествоДнейРаботы            - Число - пороговое количество дней работы для опроса
//     * ИмяОткрытойФормыСОпросом                  - Строка - имя формы, в которой уже открыт опрос
//     * ОтправленоОповещениеОПоказеОпроса         - Булево
//     * ХэшИдентификатораПользователя                      - Строка
//
Функция НастройкиОпросаПользователейБезОпыта() Экспорт
	
	ОпытРаботы = Новый Структура();
	ОпытРаботы.Вставить("ОпытПриложения1С", "");
	ОпытРаботы.Вставить("ОпытДругиеСистемыУчета", "");
	ОпытРаботы.Вставить("ОпытПеречислениеСистемУчета", "");
	ОпытРаботы.Вставить("ЭтоПользовательБезОпыта", Ложь);
	ОпытРаботы.Вставить("РазрешеноВключениеИнтерфейса85", Ложь);
	ОпытРаботы.Вставить("ИнтерфейсТаксиПередНачаломРаботы", Истина);
	ОпытРаботы.Вставить("ДатаНачалаРаботы", '00010101');
	ОпытРаботы.Вставить("ОбщееКоличествоПроведенныхДокументов", 0);
	ОпытРаботы.Вставить("УсловияДляПоказаОпросаВыполнены", Ложь);
	ОпытРаботы.Вставить("ПредельноеКоличествоПроведенныхДокументов", 50);
	ОпытРаботы.Вставить("МинимальноеКоличествоДнейРаботы", 7);
	ОпытРаботы.Вставить("ПредельноеКоличествоДнейРаботы", 14);
	ОпытРаботы.Вставить("ИмяОткрытойФормыСОпросом", "");
	ОпытРаботы.Вставить("ОтправленоОповещениеОПоказеОпроса", Ложь);
	ОпытРаботы.Вставить("ХэшИдентификатораПользователя", "");
	
	Возврат ОпытРаботы;
	
КонецФункции

// Конструктор настроек опроса
// 
// Возвращаемое значение:
//  Структура - настройки опроса:
//   * Событие                           - Строка - имя события, при котором будет отображаться опрос
//   * Вопрос                            - Строка - текст вопроса
//   * РазвернутыйВопрос                 - Строка - Поясненяющий текст, выводится под заголовок вопроса
//   * МаксимальнаяОценка                - Число  - максимальная оценка, которую может выбрать пользователь
//   * ПоказыватьПояснение               - Булево - признак необходимости показывать поле ввода пояснения
//   * ТолькоВРежимеРазделяемыхДанных    - Булево - признак необходимости показывать опрос только в разделяемых данных
//   * ТолькоВИнтерфейсе85               - Булево - признак необходимости показывать опрос только в интерфейсе 8.5
//   * ПолноеИмяФормы                    - Строка - полное имя формы, в которой будет отображаться опрос
//   * ВсеФормы                          - Булево - показывать опрос во всех подходящих формах
//   * ПроведенийНовыхДляОпроса          - Число  - количество проведений новых документов для опроса
//   * ПроцентПользователейДляОпроса     - Число  - примерный процент пользователей, для которых будет показан опрос
//   * ИдентификаторОпроса               - Строка - идентификатор опроса
//   * ПоказыватьТолькоВОднойФорме       - Булево - показывать только в первой открываемой подходящей форме
//   * Родитель                          - Строка - имя родительской группы для размещения опроса
//   * Элемент                           - Строка - имя элемента, над которым надо вывести группу опроса
//   * ИмяГруппыОбратнойСвязи            - Строка - имя создаваемой группы с элементами опроса
//   * Заголовок                         - Строка - заголовок создаваемой группы с элементами опроса
//   * ПоложениеГруппыТерминальныхКоманд - Строка - положение группы терминальных команд в группе опроса
//                                                  Например, "Низ" или "Право".
//   * КомандыОбратнойСвязи              - Массив Из см. КомандыОбратнойСвязи
//
Функция НастройкиОбратнойСвязи() Экспорт
	
	Данные = Новый Структура();
	Данные.Вставить("Событие", "");
	Данные.Вставить("Вопрос", "");
	Данные.Вставить("РазвернутыйВопрос", "");
	Данные.Вставить("МаксимальнаяОценка", 5);
	Данные.Вставить("ПоказыватьПояснение", Истина);
	Данные.Вставить("ТолькоВРежимеРазделяемыхДанных", Истина);
	Данные.Вставить("ТолькоВИнтерфейсе85", Ложь);
	Данные.Вставить("ПолноеИмяФормы", "");
	Данные.Вставить("ВсеФормы", Ложь);
	Данные.Вставить("ПроведенийНовыхДляОпроса", 5);
	Данные.Вставить("ПроцентПользователейДляОпроса", 10);
	Данные.Вставить("ИдентификаторОпроса", "");
	Данные.Вставить("ПоказыватьТолькоВОднойФорме", Ложь);
	Данные.Вставить("Родитель", "");
	Данные.Вставить("Элемент", "");
	Данные.Вставить("ИмяГруппыОбратнойСвязи", "");
	Данные.Вставить("Заголовок", "");
	Данные.Вставить("ПоложениеГруппыТерминальныхКоманд", "Право");
	Данные.Вставить("КомандыОбратнойСвязи", Новый Массив);
	
	Возврат Данные;

КонецФункции

// Показывает панель обратной связи на форме, устанавливая видимость соответствующей группы.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - Форма, на которой нужно показать панель обратной связи
//   ВидимостьПанели - Булево - Признак видимости панели обратной связи
//
Процедура УстановитьВидимостьПанелиОбратнойСвязи(Форма, ВидимостьПанели = Истина) Экспорт
	
	Элементы = Форма.Элементы;
	ИмяГруппыОбратнойСвязи = ИмяГруппыОбратнойСвязи();

	ПанельОбратнойСвязи = Элементы.Найти(ИмяГруппыОбратнойСвязи);
	Если ПанельОбратнойСвязи <> Неопределено Тогда
		Если Форма.ОбратнаяСвязь_ПоказыватьОпрос Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяГруппыОбратнойСвязи, "Видимость",
				ВидимостьПанели);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НастройкиПриходныеНакладныеПроведение()
	
	НастройкиОпроса = НастройкиОбратнойСвязи();
	НастройкиОпроса.Событие = "Проведение";
	НастройкиОпроса.Вопрос = НСтр("ru = 'Насколько легко было оформить накладную?'");
	НастройкиОпроса.МаксимальнаяОценка = 5;
	НастройкиОпроса.ПоказыватьПояснение = Истина;
	НастройкиОпроса.ТолькоВРежимеРазделяемыхДанных = Истина;
	НастройкиОпроса.ПолноеИмяФормы = "Документ.ПриходнаяНакладная.Форма.ФормаСписка";
	НастройкиОпроса.ВсеФормы = Ложь;
	НастройкиОпроса.ПроведенийНовыхДляОпроса = 5;
	НастройкиОпроса.ПроцентПользователейДляОпроса = 10;
	НастройкиОпроса.ИдентификаторОпроса = "8324d306-68e6-4c60-bdac-d758ef1d0b00";
	
	НастройкиОпроса.Родитель = "ПраваяПанель";
	НастройкиОпроса.Элемент = "ГруппаОтступ";
	НастройкиОпроса.ИмяГруппыОбратнойСвязи = ИмяГруппыОбратнойСвязи();
	НастройкиОпроса.Заголовок = НСтр("ru = 'Опрос'");
	НастройкиОпроса.ПоложениеГруппыТерминальныхКоманд = "Право";
	
	ЗаполнитьКомандыПриходныеНакладные(НастройкиОпроса.КомандыОбратнойСвязи);
	
	Возврат НастройкиОпроса;
	
КонецФункции

Процедура ЗаполнитьКомандыПриходныеНакладные(ТерминальныеКоманды)
 
	КомандаЗакрытия = КомандыОбратнойСвязи();
	КомандаЗакрытия.ЭтоКоманда = Ложь;
	КомандаЗакрытия.Имя = НСтр("ru = 'ОбратнаяСвязь_Закрыть'");
