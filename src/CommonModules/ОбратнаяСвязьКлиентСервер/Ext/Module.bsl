// Возвращает структуру команд обратной связи с начальными значениями для использования на форме.
//
// Возвращаемое значение:
//   Структура:
//     * ЭтоКоманда                   - Булево - если ложь, то это декорация
//     * Имя                          - Строка - идентификатор команды
//     * Заголовок                    - Строка - тип представления элемента (КомандаФормы или ДекорацияФормы)
//     * Действие                     - Строка - вид декорации для типа ДекорацияФормы
//     * Картинка                     - Картинка - картинка для кнопки
//     * Отображение                  - ОтображениеКнопки - вид отображения для типа КомандаФормы
//     * Доступность                  - Булево - начальная доступность элемента
//     * Вид                          - ВидДекорацииФормы - вид декорации для типа ДекорацияФормы
//     * Событие                      - Строка - имя события для типа ДекорацияФормы
//     * ВертикальноеПоложениеВГруппе - ВертикальноеПоложениеЭлемента - положение декорации в группе
//     * Гиперссылка                  - Булево - признак гиперссылки для типа ДекорацияФормы
//     * РазмерКартинки               - РазмерКартинки - размер картинки для типа ДекорацияФормы
//
Функция КомандыОбратнойСвязи()
	
	Команды = Новый Структура();
	Команды.Вставить("ЭтоКоманда", Ложь);
	Команды.Вставить("Имя", "");
	Команды.Вставить("Заголовок", "");
	Команды.Вставить("Действие", "");
	Команды.Вставить("ИмяКоманды", "");
	Команды.Вставить("Важность", ВажностьКнопки.Обычная);
	Команды.Вставить("Картинка", Новый Картинка);
	Команды.Вставить("Отображение", ОтображениеКнопки.Авто);
	Команды.Вставить("Доступность", Истина);
	
	// Для декораций
	Команды.Вставить("Вид", ВидДекорацииФормы.Картинка);
	Команды.Вставить("Событие", "");
	Команды.Вставить("ВертикальноеПоложениеВГруппе", ВертикальноеПоложениеЭлемента.Авто);
	Команды.Вставить("ГоризонтальноеПоложениеВГруппе", ГоризонтальноеПоложениеЭлемента.Авто);
	Команды.Вставить("Гиперссылка", Истина);
	Команды.Вставить("РазмерКартинки", РазмерКартинки.АвтоРазмер);
	Команды.Вставить("ИмяКартинки", "");
	
	Возврат Команды;
	
КонецФункции

