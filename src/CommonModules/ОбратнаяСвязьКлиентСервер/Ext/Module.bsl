	ВопросыПоФормам.Вставить("Документ.РасходИзКассы.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.РасходСоСчета.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.СборкаЗапасов.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.СверкаВзаиморасчетов.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.СдельныйНаряд.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.СчетНаОплатуПоставщика.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.СчетФактура.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
