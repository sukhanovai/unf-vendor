	ВопросыПоФормам.Вставить("Документ.ПоступлениеДСПлан.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ПоступлениеНаСчет.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ПриемИПередачаВРемонт.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
