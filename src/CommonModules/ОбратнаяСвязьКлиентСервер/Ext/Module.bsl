	ВопросыПоФормам.Вставить("Документ.НачислениеЗарплатыУНФ.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ОтчетКомиссионера.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ОтчетКомиссионераОСписании.Форма.ФормаСписка",
