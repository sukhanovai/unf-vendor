// Возвращает настройки опросов по формам
// 
// Возвращаемое значение:
//  Соответствие Из КлючИЗначение - Настройки опросов по формам:
//   * Ключ     - Строка - Имя формы
//   * Значение - Структура: см. ОбратнаяСвязьКлиентСервер.НастройкиОбратнойСвязи
//
Функция НастройкиОпросовПоФормамИСобытиям() Экспорт
	
	НастройкиНачалоРаботыСПрограммой = НастройкиНачалоРаботыСПрограммой();
	
	ВопросыПоФормам = Новый Соответствие;
	// После проведения новых приходных накладных
	ВопросыПоФормам.Вставить("Документ.ПриходнаяНакладная.Форма.ФормаСписка", НастройкиПриходныеНакладныеПроведение());
	// Пользователи без опыта работы с программой
	ВопросыПоФормам.Вставить("Обработка.НачалоРаботыСПрограммой.Форма", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.РасходнаяНакладная.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.СчетНаОплату.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.АктВыполненныхРабот.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ЗаказНаПеремещение.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ЗаказНаПроизводство.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ЗаказПокупателя.Форма.ФормаСписка", НастройкиНачалоРаботыСПрограммой);
	ВопросыПоФормам.Вставить("Документ.ЗаказПокупателя.Форма.ФормаСпискаЗаказНаряда",
