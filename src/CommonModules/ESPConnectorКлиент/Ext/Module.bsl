#Область ПрограммныйИнтерфейс

// Параметры подключения к интеграционному компоненту ЕСП ТС ПИоТ
//                                 
// Возвращаемое значение:
//  Структура -
// * Provider - Перечисление.ESPConnectorProvider - 
// * ComponentId - Строка - 
// * ComponentName - Строка - 
// * ComponentToken - Строка - 
// * ComponentVersion - Строка - 
// * ComponentLastKey - Строка -  
//
Функция ПараметрыПодключения() Экспорт
	
	Параметры = Новый Структура;      
	Параметры.Вставить("Провайдер", Неопределено); // Перечисление.ESPConnectorProvider, Необязательно - Провайдер. 
	Параметры.Вставить("ComponentId");
	Параметры.Вставить("ComponentName");
	Параметры.Вставить("ComponentToken");
	Параметры.Вставить("ComponentVersion");
	Параметры.Вставить("ComponentLastKey");
	Возврат Параметры;
	
КонецФункции

Асинх Функция ПодключитьESPConnectКлиентАсинх() Экспорт
	
	ОписаниеКомпонентыПодключения = ОписаниеКомпоненты();
	ИмяОбъекта = ОписаниеКомпонентыПодключения.ИмяОбъекта;
	ПолноеИмяМакета = ОписаниеКомпонентыПодключения.ПолноеИмяМакета;
	
	Результат = ВнешниеКомпонентыБПОКлиент.РезультатПодключения();
	
	ОбъектКомпоненты = МенеджерОборудованияКлиент.ОбъектДрайвераИзКэша(ИмяОбъекта);
	Если ОбъектКомпоненты <> Неопределено Тогда   
		Результат.Подключено = Истина;
		Результат.ПодключаемыйМодуль = ОбъектКомпоненты;   
		Возврат Результат;
	КонецЕсли;
	
	РезультатПодключения = Ждать ВнешниеКомпонентыБПОКлиент.ПодключитьКомпонентуИзМакетаАсинх(ИмяОбъекта, ПолноеИмяМакета);
	Если Не РезультатПодключения.Подключено Тогда
		
		РезультатУстановки = Ждать ВнешниеКомпонентыБПОКлиент.УстановитьКомпонентуИзМакетаАсинх(ПолноеИмяМакета); // Структура
		Если Не РезультатУстановки.Установлено Тогда
			Результат.Подключено = Ложь;
			Результат.ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Ошибка установки компоненты %1: %2'"), ИмяОбъекта, РезультатУстановки.ОписаниеОшибки);
			Возврат Результат;
		КонецЕсли;
		
		РезультатПодключения = Ждать ВнешниеКомпонентыБПОКлиент.ПодключитьКомпонентуИзМакетаАсинх(ИмяОбъекта, ПолноеИмяМакета);
		Если Не РезультатПодключения.Подключено Тогда
			Результат.Подключено = Ложь;
			Результат.ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Ошибка подключения компоненты %1: %2'"), ИмяОбъекта, РезультатПодключения.ОписаниеОшибки);
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Результат, РезультатПодключения);
	
	МенеджерОборудованияКлиент.ДобавитьДрайверВКэш(ИмяОбъекта, РезультатПодключения.ПодключаемыйМодуль); 
	
	Возврат Результат; 
	
КонецФункции

Асинх Функция ПодключитьОборудованиеАсинх(Параметры) Экспорт
	
	РезультатПодключения = Ждать ПодключитьESPConnectКлиентАсинх();
	Если Не РезультатПодключения.Подключено Тогда
		Возврат ОшибкаПодключенияКомпоненты(РезультатПодключения.ОписаниеОшибки);
	КонецЕсли; 
	
	Провайдер = ПолучитьКодПровайдера(Параметры.Провайдер);
	Если ПустаяСтрока(Провайдер) Тогда     
		ОписаниеОшибки = НСтр("ru='Провайдер подключения не определен.'");
		РезультатОперации = СформироватьРезультатОперации(Ложь, ОписаниеОшибки);
		Возврат РезультатОперации;
	КонецЕсли; 
	
	Параметры.Вставить("Provider", Провайдер);
	
	ПараметрыXML = МенеджерОборудованияВызовСервера.ПолучитьПараметрыXML(Параметры, Неопределено, Ложь);
	ИДУстройства = "";
	
	ОбъектДрайвера = РезультатПодключения.ПодключаемыйМодуль;
	Попытка
		РезультатВызова = Ждать ОбъектДрайвера.ПодключитьОборудованиеАсинх(ИДУстройства, "", ПараметрыXML);   
		Результат = РезультатВызова.Значение;
		Если Результат Тогда    
			РезультатОперации = СформироватьРезультатОперации(); 
			РезультатОперации.Вставить("ИДУстройства", РезультатВызова.Параметры[0]); 
		Иначе
			РезультатОперации = Ждать СформироватьИнформациюОбОшибкеАсинх(ОбъектДрайвера);
		КонецЕсли;
	Исключение           
		РезультатОперации = ОшибкаВызоваМетодаКомпоненты("ПодключитьОборудование");
	КонецПопытки;
	
	Возврат РезультатОперации;
	
КонецФункции       

Асинх Функция ОтключитьОборудованиеАсинх(Параметры) Экспорт
	
	РезультатПодключения = Ждать ПодключитьESPConnectКлиентАсинх();
	Если Не РезультатПодключения.Подключено Тогда
		Возврат ОшибкаПодключенияКомпоненты(РезультатПодключения.ОписаниеОшибки);
	КонецЕсли;
	
	ИДУстройства = Параметры.ИДУстройства;
	ОбъектДрайвера = РезультатПодключения.ПодключаемыйМодуль;
	Попытка
		РезультатВызова = Ждать ОбъектДрайвера.ОтключитьОборудованиеАсинх(ИДУстройства);   
		Результат = РезультатВызова.Значение;
		Если Результат Тогда    
			РезультатОперации = СформироватьРезультатОперации();   
		Иначе
			РезультатОперации = Ждать СформироватьИнформациюОбОшибкеАсинх(ОбъектДрайвера);
		КонецЕсли;
	Исключение           
		РезультатОперации = ОшибкаВызоваМетодаКомпоненты("ОтключитьОборудование");
	КонецПопытки;
	
	Возврат РезультатОперации;
	
КонецФункции       

Асинх Функция ЗапросНаПроверкуАсинх(Параметры) Экспорт
	
	РезультатПодключения = Ждать ПодключитьESPConnectКлиентАсинх();
	Если Не РезультатПодключения.Подключено Тогда
		Возврат ОшибкаПодключенияКомпоненты(РезультатПодключения.ОписаниеОшибки);
	КонецЕсли;
	
	ИДУстройства = Параметры.ИДУстройства;  
	СтрокаКМ = Параметры.СтрокаКМ;
	ОбъектДрайвера = РезультатПодключения.ПодключаемыйМодуль;
	Попытка
		РезультатВызова = Ждать ОбъектДрайвера.ЗапросНаПроверкуАсинх(ИДУстройства, СтрокаКМ);   
		Результат = РезультатВызова.Значение;
		Если Результат Тогда    
			РезультатОперации = СформироватьРезультатОперации();   
		Иначе
			РезультатОперации = Ждать СформироватьИнформациюОбОшибкеАсинх(ОбъектДрайвера);
		КонецЕсли;
	Исключение           
		РезультатОперации = ОшибкаВызоваМетодаКомпоненты("ЗапросНаПроверку");
	КонецПопытки;
	
	Возврат РезультатОперации;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеКомпоненты()
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяОбъекта", "C1CESPConnect");
	Параметры.Вставить("ПолноеИмяМакета", "ОбщийМакет.КомпонентаESPConnect");
	Возврат Параметры;               
	
КонецФункции

Функция ПолучитьКодПровайдера(Провайдер)  
	
	Если Провайдер = ПредопределенноеЗначение("Перечисление.ESPConnectorProvider.MSS") Тогда
		Результат = 0; 
	ИначеЕсли Провайдер = ПредопределенноеЗначение("Перечисление.ESPConnectorProvider.ATOL") Тогда
		Результат = 1; 
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

// Результат выполнения операции
// 
// Возвращаемое значение:
//  Структура - Результат операции:
// * Результат - Булево. - 
// * ОписаниеОшибки - Строка. - 
//
Функция СформироватьРезультатОперации(Знач Результат = Истина, Знач ОписаниеОшибки = "")
	
	РезультатОперации = Новый Структура;
	РезультатОперации.Вставить("Результат", Результат);
	РезультатОперации.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	Возврат РезультатОперации;
	
КонецФункции

Асинх Функция СформироватьИнформациюОбОшибкеАсинх(ОбъектДрайвера)
	
	РезультатВызова = Ждать ОбъектДрайвера.ПолучитьОшибкуАсинх(""); // Структура
	Результат = СформироватьРезультатОперации(Ложь, РезультатВызова.Параметры[0]);
	Возврат Результат;
	
КонецФункции

Функция ОшибкаВызоваМетодаКомпоненты(Метод)
	
	ОписаниеОшибки = НСтр("ru='Ошибка вызова метода драйвера <%1>.:%2'");
	ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, Метод, ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке()));
	
	РезультатОперации = СформироватьРезультатОперации();
	РезультатОперации.Результат = Ложь;
	РезультатОперации.ОписаниеОшибки = ОписаниеОшибки;
	Возврат РезультатОперации;
	
КонецФункции  

Функция ОшибкаПодключенияКомпоненты(ОписаниеОшибки)
	
	РезультатОперации = СформироватьРезультатОперации();
	РезультатОперации.Результат = Ложь;
	РезультатОперации.ОписаниеОшибки = ОписаниеОшибки;
	Возврат РезультатОперации;
	
КонецФункции  

#КонецОбласти
