Функция ЗаполнитьПараметрыКартыЛояльности85(ОписаниеКарты) Экспорт
	
	ПараметрыКарты = ИнтерфейсРМКСлужебныйКлиентСервер.ПараметрыКартыЛояльности();
	
	ПараметрыКарты.ИдентификаторКарты = ОписаниеКарты.ИдентификаторКарты;
	ПараметрыКарты.КодКарты = ОписаниеКарты.НомерКарты;
	ПараметрыКарты.ФИО = ОписаниеКарты.ФИО;
	ПараметрыКарты.НомерТелефонаВладельцаКарты = ОписаниеКарты.Телефон;
	ПараметрыКарты.АдресЭПВладельцаКарты = ОписаниеКарты.Почта;
	ПараметрыКарты.ДатаРождения = ОписаниеКарты.ДатаРождения;
	ПараметрыКарты.ЭтоКомпания = Не ОписаниеКарты.ФизЛицо;
	ПараметрыКарты.ЭтоБонуснаяКарта = ЗначениеЗаполнено(ОписаниеКарты.БонуснаяПрограмма);
	
	Если ОписаниеКарты.Свойство("ПродажиОборот") Тогда
		ПараметрыКарты.СуммаПродаж = Формат(ОписаниеКарты.ПродажиОборот,"ЧДЦ=2");
	КонецЕсли;
	
	Возврат ПараметрыКарты;
	
КонецФункции

Процедура ПрименитьНаФормеМасштабИзПараметров(Форма, Параметры) Экспорт
	
	Если ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85() Тогда
		Если Параметры.Свойство("УвеличенныйВариантМасштаба") Тогда
			Если Параметры.УвеличенныйВариантМасштаба = Истина Тогда
				Форма.ВариантМасштаба = ВариантМасштабаФормКлиентскогоПриложения.Обычный;
			Иначе
				Форма.ВариантМасштаба = ВариантМасштабаФормКлиентскогоПриложения.Компактный;
			КонецЕсли;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "УвеличенныйВариантМасштаба") Тогда
				Форма.УвеличенныйВариантМасштаба = Параметры.УвеличенныйВариантМасштаба;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Параметры.Свойство("Масштаб") Тогда
			Форма.Масштаб = Параметры.Масштаб;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьКнопкуСкидкаПенсионераКСОВОкнеОплаты(Форма, Настройки = Неопределено) Экспорт
	
	ДобавитьКнопкуСкидкаПенсионераКСО(Форма, Настройки, 1);
	
КонецПроцедуры

