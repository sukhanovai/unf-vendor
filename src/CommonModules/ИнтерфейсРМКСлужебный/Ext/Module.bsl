Функция ПолучитьТаблицуСвязанныхПолей(Форма)
	
	РезультатФункции = Новый ТаблицаЗначений;
	РезультатФункции.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
	РезультатФункции.Колонки.Добавить("МассивКнопок", Новый ОписаниеТипов("Массив"));
	РезультатФункции.Колонки.Добавить("ИндивидуальнаяШирина", Новый ОписаниеТипов("Булево"));
	
	КнопкиКоличества = Новый Массив();
	КнопкиКоличества.Добавить("ТекущийТоварУменьшитьКоличество");
	КнопкиКоличества.Добавить("ТекущийТоварУвеличитьКоличество");
	
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "ТекущийТоварЦенаИзКарточки", КнопкиКоличества, Истина);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "ТекущийТоварКоличество", КнопкиКоличества, Истина);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "ТекущийТоварКоличествоСобрано", КнопкиКоличества, Истина);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "ТекущийТоварСкидка", "ТекущийТоварСкидкаПереключатель", Истина);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоНал", "ОплатаНаличными", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоБН", "ОплатаКартой", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоСБП", "ОплатаСБП", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоЮКасса", "ОплатаЮКасса", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоСертификатамиНСПК", "ОплатаСертификатомНСПК", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоПредоплата", "Предоплата", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоВРассрочку", "ОплатаВРассрочку", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоЗачетАванса", "ЗачетАванса", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоБезнал", "Безнал", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоКредитом", "ОплатаКредитом", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаОплаченоБонусами", "ОплатаБонусами", Ложь);
	ДобавитьОписаниеСвязанногоПоля(РезультатФункции, "СуммаНаличныхКВыдаче", Новый Массив, Ложь);
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ДобавитьОписаниеСвязанногоПоля(ТаблицаПолей, ИмяПоля, ИменаКнопок, ИндивидуальнаяШирина)
	Перем МассивКнопок;
	
	Если ТипЗнч(ИменаКнопок) = Тип("Строка") Тогда
		МассивКнопок = Новый Массив();
		МассивКнопок.Добавить(ИменаКнопок);
	Иначе
		МассивКнопок = ИменаКнопок;
	КонецЕсли;
	
	НоваяСтрока = ТаблицаПолей.Добавить();
	НоваяСтрока.ИмяПоля = ИмяПоля;
	НоваяСтрока.МассивКнопок = МассивКнопок;
	НоваяСтрока.ИндивидуальнаяШирина = ИндивидуальнаяШирина;
	
КонецПроцедуры

Функция СформироватьНастройкиСвязанныхПолей(Форма, НастройкиЭлементов)
	
	ШиринаПолейОплат = 0;
	ШрифтыПолей = Новый Соответствие();
	ШиринаПолей = Новый Соответствие();
	
	ТаблицаПолей = ПолучитьТаблицуСвязанныхПолей(Форма);
	Для Каждого СтрокаТаблицы Из ТаблицаПолей Цикл
		
		ЭлементПоле = Форма.Элементы.Найти(СтрокаТаблицы.ИмяПоля);
		ВысотаКнопок = ПолучитьМинимальнуюВысотуКнопок(НастройкиЭлементов, СтрокаТаблицы.МассивКнопок);
		Если ВысотаКнопок > 1 И Не ЭлементПоле = Неопределено Тогда
			
			МасштабШрифта = 100 + 45 * (ВысотаКнопок - 1);
			ПрибавкаШирины = (ВысотаКнопок - 1);
			ДельтаТипаОплаты = 0;
			ТекущийШрифт = ЭлементПоле.Шрифт;
			Коэффициент = ?(СтрокаТаблицы.ИндивидуальнаяШирина, 3, 2);
			Если ЭлементПоле.Имя = "СуммаОплаченоСБП" Или ЭлементПоле.Имя = "СуммаОплаченоЮКасса" Тогда
				ДельтаТипаОплаты = 1;
				Коэффициент = 1;
			ИначеЕсли ЭлементПоле.Имя = "ТекущийТоварЦенаИзКарточки" Тогда
				ДельтаТипаОплаты = 1;
				ТекущийШрифт = ШрифтыСтиля.ШрифтОбычный12РМК;
			ИначеЕсли ЭлементПоле.Вид = ВидПоляФормы.ПолеНадписи Или ЭлементПоле.Имя = "ТекущийТоварКоличество"
				Или ЭлементПоле.Имя = "ТекущийТоварКоличествоСобрано "Тогда
				ДельтаТипаОплаты = 0;
			ИначеЕсли ЭлементПоле.Имя = "ТекущийТоварСкидка" Тогда
				Коэффициент = 2;
				ТекущийШрифт = ШрифтыСтиля.ШрифтОбычный12РМК;
			КонецЕсли;
			НовыйШрифт = Новый Шрифт(ТекущийШрифт,,,,,,, МасштабШрифта);
			НоваяШирина = ЭлементПоле.Ширина + Коэффициент * ПрибавкаШирины + ДельтаТипаОплаты;
			
			Если СтрокаТаблицы.ИндивидуальнаяШирина Тогда
				ЭлементПоле.Ширина = НоваяШирина;
				ШиринаПолей.Вставить(СтрокаТаблицы.ИмяПоля, НоваяШирина);
			ИначеЕсли ШиринаПолейОплат < НоваяШирина Тогда
				ШиринаПолейОплат = НоваяШирина;
			КонецЕсли;
			ЭлементПоле.Шрифт = НовыйШрифт;
			ШрифтыПолей.Вставить(СтрокаТаблицы.ИмяПоля, НовыйШрифт);
			
		ИначеЕсли ВысотаКнопок = 1 И Не ЭлементПоле = Неопределено И Не СтрокаТаблицы.ИндивидуальнаяШирина Тогда
			ШрифтыПолей.Вставить(СтрокаТаблицы.ИмяПоля, ЭлементПоле.Шрифт);
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы = Форма.Элементы;
	
	// Применение ширины к элементам оплаты
	Если ШиринаПолейОплат > 0 Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаПолей Цикл
			Если Не СтрокаТаблицы.ИндивидуальнаяШирина Тогда
				ЭлементПоле = Элементы.Найти(СтрокаТаблицы.ИмяПоля);
				ДельтаТипаОплаты = 0;
				Если ЭлементПоле.Имя = "СуммаОплаченоСБП" Или ЭлементПоле.Имя = "СуммаОплаченоЮКасса" Тогда
					ДельтаТипаОплаты = -1;
				ИначеЕсли ЭлементПоле.Вид = ВидПоляФормы.ПолеНадписи Тогда
					ДельтаТипаОплаты = 1;
				КонецЕсли;
				НоваяШирина = ШиринаПолейОплат + ДельтаТипаОплаты;
				ЭлементПоле.Ширина = НоваяШирина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ПараметрыПолей = Новый Структура();
	ПараметрыПолей.Вставить("ШиринаПолейОплат", ШиринаПолейОплат);
	ПараметрыПолей.Вставить("ШрифтыПолей", ШрифтыПолей);
	ПараметрыПолей.Вставить("ШиринаПолей", ШиринаПолей);
	
	Возврат ПараметрыПолей;
	
КонецФункции

Функция ПолучитьМинимальнуюВысотуКнопок(НастройкиЭлементов, Кнопки)
	
	ВысотаКнопок = Неопределено;
	СвойствоВысота = Перечисления.СвойстваЭлементовРМК.ВысотаКнопок;
	
	Для Каждого ИмяКнопки Из Кнопки Цикл
		НаборСвойств = НастройкиЭлементов.Получить(ИмяКнопки);
		Если Не НаборСвойств = Неопределено Тогда
			ЗначениеВысоты = НаборСвойств.Получить(СвойствоВысота);
			Если ЗначениеЗаполнено(ЗначениеВысоты) И (ВысотаКнопок = Неопределено Или ВысотаКнопок > ЗначениеВысоты) Тогда
				ВысотаКнопок = ЗначениеВысоты;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ВысотаКнопок = Неопределено Тогда
		ВысотаКнопок = 0;
	КонецЕсли;
	Возврат ВысотаКнопок;
	
КонецФункции

Функция ПривестиТипЗначенияСвойства(СвойствоЭлементов, ИсходноеЗначениеСвойства)
	Перем ЗначениеСвойства;
	
	Если СвойствоЭлементов = Перечисления.СвойстваЭлементовРМК.ЦветКнопок
			Или СвойствоЭлементов = Перечисления.СвойстваЭлементовРМК.ЦветШрифта
			Или СвойствоЭлементов = Перечисления.СвойстваЭлементовРМК.ШрифтКнопок Тогда
			
		ЗначениеСвойства = ОбщегоНазначения.ЗначениеИзСтрокиXML(ИсходноеЗначениеСвойства);
		
	Иначе
		
		ЗначениеСвойства = ИсходноеЗначениеСвойства;
		
	КонецЕсли;
	Возврат ЗначениеСвойства;
	
КонецФункции

Процедура ОбработатьВыборкуНастроекОбластей(НастройкиЭлементов, ВыборкаНастроекОбластей)
	
	СвойствоСтатусСмены = Перечисления.СвойстваЭлементовРМК.ПоказыватьСтатусСмены;
	СвойстваПанели = Новый Массив;
	СвойстваПанели.Добавить(Перечисления.СвойстваЭлементовРМК.ВыравниваниеЭлементов);
	СвойстваПанели.Добавить(Перечисления.СвойстваЭлементовРМК.ПоложениеЧасов);
	СвойстваПанели.Добавить(СвойствоСтатусСмены);
	ОбластиПримененияНастроек = ОбластиПримененияНастроекПанели();
	ЗаголовкиОбластей = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьЗаголовкиОбластейДляНастроек();
	
	Пока ВыборкаНастроекОбластей.Следующий() Цикл
		
		НаборНастроекЭлементов = Новый Соответствие();
		НаборНастроекПанелиОпераций = Новый Соответствие();
		ОбластьПрименения = ОбластиПримененияНастроек.Везде;
		ВыборкаСвойств = ВыборкаНастроекОбластей.Выбрать();
		Пока ВыборкаСвойств.Следующий() Цикл
			
			Если ВыборкаСвойств.СвойствоЭлементов = Перечисления.СвойстваЭлементовРМК.ОбластьПрименения Тогда
				// ОбластьПрименения = ВыборкаСвойств.ЗначениеСвойства;
			ИначеЕсли Не СвойстваПанели.Найти(ВыборкаСвойств.СвойствоЭлементов) = Неопределено Тогда
				НаборНастроекПанелиОпераций.Вставить(ВыборкаСвойств.СвойствоЭлементов, ВыборкаСвойств.ЗначениеСвойства);
			Иначе
				ЗначениеСвойства = ПривестиТипЗначенияСвойства(ВыборкаСвойств.СвойствоЭлементов, ВыборкаСвойств.ЗначениеСвойства);
				НаборНастроекЭлементов.Вставить(ВыборкаСвойств.СвойствоЭлементов, ЗначениеСвойства);
			КонецЕсли;
			
		КонецЦикла;
		
		ДобавитьНастройкиВсемЭлементамОбласти(НастройкиЭлементов, ВыборкаНастроекОбластей.ЗаголовокОбласти,
			НаборНастроекЭлементов);
		Если ВыборкаНастроекОбластей.ЗаголовокОбласти = ЗаголовкиОбластей.ОбластьПанельОпераций Тогда
			
			ДобавитьСтрокиИзСоответствия(НаборНастроекПанелиОпераций, НаборНастроекЭлементов);
			НастройкиЭлементов.Вставить(ВыборкаНастроекОбластей.ЗаголовокОбласти, НаборНастроекПанелиОпераций);
			
		КонецЕсли;
		
		Если ВыборкаНастроекОбластей.ЗаголовокОбласти = ЗаголовкиОбластей.ОбластьПанельОпераций Тогда
			
			НаборНастроекПлиточныйИнтерфейс = СкопироватьСоответствие(НаборНастроекЭлементов);
			ДобавитьСтрокиИзСоответствия(НаборНастроекПлиточныйИнтерфейс, НаборНастроекПанелиОпераций);
