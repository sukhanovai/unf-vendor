	ДобавитьИзменяемыеПараметрыЭлементаФормы(ДанныеЭлемента, "Высота", 8, 3);
	ДобавитьИзменяемыеПараметрыЭлементаФормы(ДанныеЭлемента, "ГоризонтальноеПоложениеПодчиненных",
