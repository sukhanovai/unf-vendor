		Если НоваяКоманда = Неопределено Тогда
			НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
			НоваяКоманда.Действие = ПараметрыПостроения.ИмяКомандыГорячейКлавиши;
		КонецЕсли;
		НоваяКоманда.СочетаниеКлавиш = СочетаниеКлавиш;
		
		ИмяЭлемента = СтрШаблон("ИзбранноеКнопка_%1", ИндексКнопки);
		КнопкаИзбранного = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), СтраницаКнопки);
