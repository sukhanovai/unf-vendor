	ОсновнойРядЭлемента.РастягиватьПоВертикали = Истина;
	ОсновнойРядЭлемента.РастягиватьПоГоризонтали = Истина;
	
	ИмяЭлемента = СтрШаблон("НаименованиеЭлементаИзбранного%1_%2", СуффиксИмени, ИндексКнопки);
	ПолеНаименование = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ОсновнойРядЭлемента);
	ПолеНаименование.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеНаименование.ПутьКДанным = СтрШаблон("ДанныеКнопок[%1].ИмяЭлемента", ИндексДанных);
	ПолеНаименование.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеНаименование.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
	ПолеНаименование.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	ПолеНаименование.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Центр;
	ПолеНаименование.Высота = 2;
	ПолеНаименование.АвтоМаксимальнаяШирина = Ложь;
	ПолеНаименование.АвтоМаксимальнаяВысота = Истина;
	ПолеНаименование.РастягиватьПоГоризонтали = Истина;
	ПолеНаименование.РастягиватьПоВертикали = Истина;
	ПолеНаименование.Шрифт = ПараметрыПостроения.БазовыйШрифт;
	
	Если Не СочетаниеКлавиш = Неопределено Тогда
	
		ИмяЭлемента = СтрШаблон("ИзбранноеЭлементНомерКлавиши%1_%2", СуффиксИмени, ИндексКнопки);
		
		ЭлементНомерКлавиши = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ОсновнойРядЭлемента);
		ЭлементНомерКлавиши.Вид = ВидДекорацииФормы.Надпись;
		ЭлементНомерКлавиши.Шрифт = ШрифтыСтиля.ЗаголовокПятогоУровня;
		ЭлементНомерКлавиши.Заголовок = Строка(ИндексКнопки);
		ЭлементНомерКлавиши.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
		
	КонецЕсли;
	
	Если ПараметрыПостроения.ОтображатьОстаток Или Не ПараметрыПостроения.СкрыватьЦену Тогда
	
		ИмяЭлемента = СтрШаблон("ИзбранноеРядПоказателейЭлемента%1_%2", СуффиксИмени, ИндексКнопки);
		РядПоказателейЭлемента = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаКолонкаДанных);
		РядПоказателейЭлемента.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		РядПоказателейЭлемента.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		РядПоказателейЭлемента.ОтображатьЗаголовок = Ложь;
		РядПоказателейЭлемента.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
		РядПоказателейЭлемента.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
		РядПоказателейЭлемента.РастягиватьПоВертикали = Истина;
		РядПоказателейЭлемента.РастягиватьПоГоризонтали = Истина;
		
		Если ПараметрыПостроения.ОтображатьОстаток Тогда
			ИмяЭлемента = СтрШаблон("ОстатокВИзбранном%1_%2", СуффиксИмени, ИндексКнопки);
			ПолеОстаток = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), РядПоказателейЭлемента);
			ПолеОстаток.Вид = ВидПоляФормы.ПолеНадписи;
			ПолеОстаток.ПутьКДанным = СтрШаблон("ДанныеКнопок[%1].КоличествоТекст", ИндексДанных);
			ПолеОстаток.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
			ПолеОстаток.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
			ПолеОстаток.Ширина = 1;
			ПолеОстаток.Высота = 1;
			ПолеОстаток.АвтоМаксимальнаяШирина = Ложь;
			ПолеОстаток.АвтоМаксимальнаяВысота = Истина;
			ПолеОстаток.РастягиватьПоГоризонтали = Истина;
			ПолеОстаток.РастягиватьПоВертикали = Ложь;
		КонецЕсли;
		
		Если Не ПараметрыПостроения.СкрыватьЦену Тогда
			ШрифтЦены = Новый Шрифт(ШрифтыСтиля.ТекстТретьегоУровня, , , Истина);
			ИмяЭлемента = СтрШаблон("ЦенаВИзбранном%1_%2", СуффиксИмени, ИндексКнопки);
			ПолеЦена = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), РядПоказателейЭлемента);
			ПолеЦена.Вид = ВидПоляФормы.ПолеНадписи;
			ПолеЦена.ПутьКДанным = СтрШаблон("ДанныеКнопок[%1].ЦенаТекст", ИндексДанных);
			ПолеЦена.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
			ПолеЦена.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
			ПолеЦена.Ширина = 1;
			ПолеЦена.Высота = 1;
			ПолеЦена.АвтоМаксимальнаяШирина = Ложь;
			ПолеЦена.АвтоМаксимальнаяВысота = Истина;
			ПолеЦена.РастягиватьПоГоризонтали = Истина;
			ПолеЦена.РастягиватьПоВертикали = Ложь;
			ПолеЦена.Шрифт = ШрифтЦены;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтраницуНавигацииИзбранного(Форма, КонтейнерПлитки, ГорячиеКлавиши)
	
	ЭлементыФормы = Форма.Элементы;
	
	СочетаниеКлавишНазад = Неопределено;
	СочетаниеКлавишВперед = Неопределено;
	Если Не ГорячиеКлавиши = Неопределено Тогда
		Если (ГорячиеКлавиши.Alt ИЛИ ГорячиеКлавиши.Shift ИЛИ ГорячиеКлавиши.Ctrl) Тогда
			
			ДополнительнаяКлавишаНазад = Клавиша["_9"];
			ДополнительнаяКлавишаВперед = Клавиша["_0"];
			
			СочетаниеКлавишНазад = Новый СочетаниеКлавиш(ДополнительнаяКлавишаНазад,
				ГорячиеКлавиши.Alt, ГорячиеКлавиши.Ctrl, ГорячиеКлавиши.Shift);
			СочетаниеКлавишВперед = Новый СочетаниеКлавиш(ДополнительнаяКлавишаВперед,
				ГорячиеКлавиши.Alt, ГорячиеКлавиши.Ctrl, ГорячиеКлавиши.Shift);
				
		КонецЕсли;
	КонецЕсли;
	ИмяСобытияНазад = "Подключаемый_ИзбранноеНазад";
	ИмяСобытияВперед = "Подключаемый_ИзбранноеВперед";
	ИмяКомандыНазад = "Подключаемый_ИзбранноеКомандаНазад";
	ИмяКомандыВперед = "Подключаемый_ИзбранноеКомандаВперед";
	ИмяСобытияСменаСтраницы = "Подключаемый_ПриСменеСтраницыИзбранное";
	
	ИмяЭлемента = "СтраницаИзбранноеНавигация";
	СтраницаКонтейнера = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), КонтейнерПлитки);
	СтраницаКонтейнера.Вид = ВидГруппыФормы.Страница;
	СтраницаКонтейнера.ОтображатьЗаголовок = Ложь;
	СтраницаКонтейнера.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СтраницаКонтейнера.ГоризонтальныйИнтервал  = ИнтервалМеждуЭлементамиФормы.Половинный;
	СтраницаКонтейнера.РастягиватьПоВертикали = Истина;
	СтраницаКонтейнера.РастягиватьПоГоризонтали = Истина;
	СтраницаКонтейнера.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Право;
	
	ИмяЭлемента = "КнопкаИзбранноеНазад";
	ГруппаКнопкаНазад = ДобавитьГруппуКарточку(ЭлементыФормы, СтраницаКонтейнера, ИмяЭлемента, ИмяСобытияНазад);
	ГруппаКнопкаНазад.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
	ГруппаКнопкаНазад.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Право;
	ГруппаКнопкаНазад.ЦветФона = ЦветУправляющейКнопки(Истина);
	ГруппаКнопкаНазад.РастягиватьПоВертикали = Истина;
	
	Если СочетаниеКлавишНазад = Неопределено Тогда
		
		ИмяЭлемента = "ДекорацияИзбранноеНазад";
		ДобавитьДекорациюНавигации(ЭлементыФормы, ИмяЭлемента, ГруппаКнопкаНазад, БиблиотекаКартинок.СтрелкаВлевоРМК);
		
	Иначе
		
		ИмяЭлемента = "СтраницыНавигацииНазад";
		СтраницыНавигацииНазад = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаКнопкаНазад);
		СтраницыНавигацииНазад.Вид = ВидГруппыФормы.Страницы;
		СтраницыНавигацииНазад.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		СтраницыНавигацииНазад.УстановитьДействие("ПриСменеСтраницы", ИмяСобытияСменаСтраницы);
	
		ИмяЭлемента = "СтраницаНавигацииИзображениеНазад";
		СтраницаНавигацииИзображениеНазад = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), СтраницыНавигацииНазад);
		СтраницаНавигацииИзображениеНазад.Вид = ВидГруппыФормы.Страница;
		СтраницаНавигацииИзображениеНазад.ОтображатьЗаголовок = Ложь;
		
		ИмяЭлемента = "ДекорацияИзбранноеНазад";
		ДобавитьДекорациюНавигации(ЭлементыФормы, ИмяЭлемента,
			СтраницаНавигацииИзображениеНазад, БиблиотекаКартинок.СтрелкаВлевоРМК);
		
		ИмяЭлемента = "СтраницаНавигацииГорячаяКнопкаНазад";
		СтраницаГорячаяКнопкаНазад = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), СтраницыНавигацииНазад);
		СтраницаГорячаяКнопкаНазад.Вид = ВидГруппыФормы.Страница;
		СтраницаГорячаяКнопкаНазад.ОтображатьЗаголовок = Ложь;
		
		ИмяЭлемента = "ИзбранноеНазад";
		КнопкаНазад = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), СтраницаГорячаяКнопкаНазад);
		КнопкаНазад.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КнопкаНазад.ИмяКоманды = ИмяКомандыНазад;
		КнопкаНазад.Заголовок = "_";
		КнопкаНазад.СочетаниеКлавиш = СочетаниеКлавишНазад;
		
	КонецЕсли;
	
	ИмяЭлемента = "КнопкаИзбранноеВперед";
	ГруппаКнопкаВперед = ДобавитьГруппуКарточку(ЭлементыФормы, СтраницаКонтейнера, ИмяЭлемента, ИмяСобытияВперед);
	ГруппаКнопкаВперед.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
	ГруппаКнопкаВперед.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Право;
	ГруппаКнопкаВперед.ЦветФона = ЦветУправляющейКнопки(Истина);
	ГруппаКнопкаВперед.РастягиватьПоВертикали = Истина;
	
	Если СочетаниеКлавишВперед = Неопределено Тогда
		
		ИмяЭлемента = "ДекорацияИзбранноеВперед";
		ДобавитьДекорациюНавигации(ЭлементыФормы, ИмяЭлемента, ГруппаКнопкаВперед, БиблиотекаКартинок.СтрелкаВправоРМК);
		
	Иначе
		
		ИмяЭлемента = "СтраницыНавигацииВперед";
		СтраницыНавигацииВперед = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаКнопкаВперед);
		СтраницыНавигацииВперед.Вид = ВидГруппыФормы.Страницы;
		СтраницыНавигацииВперед.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		СтраницыНавигацииВперед.УстановитьДействие("ПриСменеСтраницы", ИмяСобытияСменаСтраницы);
	
		ИмяЭлемента = "СтраницаНавигацииИзображениеВперед";
		СтраницаНавигацииИзображениеВперед
			= ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), СтраницыНавигацииВперед);
		СтраницаНавигацииИзображениеВперед.Вид = ВидГруппыФормы.Страница;
		СтраницаНавигацииИзображениеВперед.ОтображатьЗаголовок = Ложь;
		
		ИмяЭлемента = "ДекорацияИзбранноеВперед";
		ДобавитьДекорациюНавигации(ЭлементыФормы, ИмяЭлемента,
			СтраницаНавигацииИзображениеВперед, БиблиотекаКартинок.СтрелкаВправоРМК);
		
		ИмяЭлемента = "СтраницаНавигацииГорячаяКнопкаВперед";
		СтраницаГорячаяКнопкаВперед = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), СтраницыНавигацииВперед);
		СтраницаГорячаяКнопкаВперед.Вид = ВидГруппыФормы.Страница;
		СтраницаГорячаяКнопкаВперед.ОтображатьЗаголовок = Ложь;
		
		ИмяЭлемента = "ИзбранноеВперед";
		КнопкаВперед = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), СтраницаГорячаяКнопкаВперед);
		КнопкаВперед.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КнопкаВперед.ИмяКоманды = ИмяКомандыВперед;
		КнопкаВперед.Заголовок = "_";
		КнопкаВперед.СочетаниеКлавиш = СочетаниеКлавишВперед;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтраницуНавигацииПлитки(Форма, КонтейнерПлитки)
	
	ЭлементыФормы = Форма.Элементы;
	ИмяСобытияНазад = "Подключаемый_ПлиткаНазад";
	ИмяСобытияВперед = "Подключаемый_ПлиткаВперед";
	
	ИмяЭлемента = "СтраницаПлиткаНавигация";
	СтраницаКонтейнера = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), КонтейнерПлитки);
	СтраницаКонтейнера.Вид = ВидГруппыФормы.Страница;
	СтраницаКонтейнера.ОтображатьЗаголовок = Ложь;
	СтраницаКонтейнера.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	СтраницаКонтейнера.ВертикальныйИнтервал  = ИнтервалМеждуЭлементамиФормы.Половинный;
	СтраницаКонтейнера.РастягиватьПоВертикали = Истина;
	СтраницаКонтейнера.РастягиватьПоГоризонтали = Истина;
	СтраницаКонтейнера.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;
	
	ИмяЭлемента = "КнопкаПлиткаНазад";
	ГруппаКнопкаНазад = ДобавитьГруппуКарточку(ЭлементыФормы, СтраницаКонтейнера, ИмяЭлемента, ИмяСобытияНазад);
	ГруппаКнопкаНазад.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	ГруппаКнопкаНазад.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;
	ГруппаКнопкаНазад.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
	ГруппаКнопкаНазад.ЦветФона = ЦветУправляющейКнопки(Истина);
	ГруппаКнопкаНазад.РастягиватьПоВертикали = Истина;
	ГруппаКнопкаНазад.РастягиватьПоГоризонтали = Истина;
	
	ИмяЭлемента = "ДекорацияПлиткаНазад";
	ДобавитьДекорациюНавигации(ЭлементыФормы, ИмяЭлемента, ГруппаКнопкаНазад, БиблиотекаКартинок.РМКСтрелкаВверх);
	
	ИмяЭлемента = "КнопкаПлиткаВперед";
	ГруппаКнопкаВперед = ДобавитьГруппуКарточку(ЭлементыФормы, СтраницаКонтейнера, ИмяЭлемента, ИмяСобытияВперед);
	ГруппаКнопкаВперед.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	ГруппаКнопкаВперед.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;
	ГруппаКнопкаВперед.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
	ГруппаКнопкаВперед.ЦветФона = ЦветУправляющейКнопки(Истина);
	ГруппаКнопкаВперед.РастягиватьПоВертикали = Истина;
	ГруппаКнопкаВперед.РастягиватьПоГоризонтали = Истина;
	
	ИмяЭлемента = "ДекорацияПлиткаВперед";
	ДобавитьДекорациюНавигации(ЭлементыФормы, ИмяЭлемента, ГруппаКнопкаВперед, БиблиотекаКартинок.РМКСтрелкаВниз);
	
КонецПроцедуры

Функция ДобавитьДекорациюНавигации(ЭлементыФормы, ИмяЭлемента, ГруппаКнопки, КартинкаДекорации)
	
	КартинкаКнопки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ГруппаКнопки);
	КартинкаКнопки.Вид = ВидДекорацииФормы.Картинка;
	КартинкаКнопки.АвтоМаксимальнаяШирина = Ложь;
	КартинкаКнопки.МаксимальнаяШирина = 7;
	КартинкаКнопки.РастягиватьПоВертикали = Истина;
	КартинкаКнопки.РастягиватьПоГоризонтали = Истина;
	КартинкаКнопки.Картинка = КартинкаДекорации;
	КартинкаКнопки.РазмерКартинки = РазмерКартинки.Пропорционально;
	КартинкаКнопки.ЦветКартинки = ЦветУправляющейКнопки();
	
	Возврат КартинкаКнопки;
	
КонецФункции

Функция ПараметрыРазмеровКомандУправленияЧекомДляОбычногоРежима(ПараметрыУвеличенногоИнтерфейса)
	
	ПараметрыРазмеров = Новый Структура;
	
	ПараметрыРазмеров.Вставить("ВысотаКоманды", ПараметрыУвеличенногоИнтерфейса.ВысотаКоманды);
	ПараметрыРазмеров.Вставить("ШиринаКоманды", ПараметрыУвеличенногоИнтерфейса.ШиринаКоманды);
	ПараметрыРазмеров.Вставить("ВысотаКомандыОперации", ПараметрыУвеличенногоИнтерфейса.ВысотаКоманды);
	ПараметрыРазмеров.Вставить("ШиринаКомандыОперации", ПараметрыУвеличенногоИнтерфейса.ШиринаКоманды);
	
	Возврат ПараметрыРазмеров;
	
КонецФункции

Функция ПринадлежитГруппеОпераций(Элементы, ЭлементФормы)
	
	РезультатФункции = Ложь;
	ГруппаОперации = Элементы.ГруппаОперации;
	Если ЭлементФормы.Родитель = ГруппаОперации
		Или (ТипЗнч(ЭлементФормы.Родитель) = Тип("ГруппаФормы") И ЭлементФормы.Родитель.Родитель = ГруппаОперации) Тогда
		
		РезультатФункции = Истина;
		
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

Функция ИгнорироватьЭлементДляУвеличенияРазмера(РежимКСО, Элементы, ЭлементФормы)
	
	РезультатФункции = Ложь;

	Если (Не ТипЗнч(ЭлементФормы) = Тип("КнопкаФормы")) Или ЭлементФормы.Вид = ВидКнопкиФормы.Гиперссылка
		Или (РежимКСО И ПринадлежитГруппеОпераций(Элементы, ЭлементФормы)) Тогда
		
		РезультатФункции = Истина;
		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ДобавитьРядКнопокПлиток(РодительскийЭлемент, ИндексРяда, Элементы)
	
	ИмяРяда = СтрШаблон("ПлиткаРядКнопок_%1", ИндексРяда);
	НовыйРяд = Элементы.Найти(ИмяРяда);
	Если НовыйРяд = Неопределено Тогда
		НовыйРяд = Элементы.Добавить(ИмяРяда, Тип("ГруппаФормы"), РодительскийЭлемент);
	КонецЕсли;
	НовыйРяд.Вид 						= ВидГруппыФормы.ОбычнаяГруппа;
	НовыйРяд.Группировка				= ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйРяд.ОтображатьЗаголовок 		= Ложь;
	НовыйРяд.РастягиватьПоГоризонтали	= Истина;
	НовыйРяд.РастягиватьПоВертикали		= Истина;
	НовыйРяд.Высота 					= 1;
	Если ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85() Тогда
		НовыйРяд.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	КонецЕсли;
	
	Возврат НовыйРяд;
	
КонецФункции

Функция ПолучитьШрифтПлиткиПоУмолчанию(Форма)
	
	Перем БазовыйШрифт;
	
	ШрифтТекстом = "";
	ПалитраФормы = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "СтруктураПлиточногоИнтерфейсаПодбора") Тогда
		ШрифтТекстом
			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.СтруктураПлиточногоИнтерфейсаПодбора, "ШрифтЭлементовПодбора");
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ТекущаяНастройкаРМК") Тогда
		ШрифтТекстом = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.ТекущаяНастройкаРМК,
			"СтруктураПлиточногоИнтерфейсаПодбора.ШрифтЭлементовПодбора");
	КонецЕсли;
	Если ЗначениеЗаполнено(ШрифтТекстом) Тогда
		БазовыйШрифт = ОбщегоНазначения.ЗначениеИзСтрокиXML(ШрифтТекстом);
	Иначе
		БазовыйШрифт = Новый Шрифт(ШрифтыСтиля.ЗаголовокЧетвертогоУровня, , , Истина);
	КонецЕсли;
	Возврат БазовыйШрифт;
	
КонецФункции

Функция ПолучитьШрифтИзбранногоПоУмолчанию(Форма)
	
	Перем БазовыйШрифт;
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	ШрифтТекстом = "";
	ПалитраИзбранных = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "НастройкиРМК") Тогда
		ПалитраИзбранных = Форма.НастройкиРМК.СтруктураБыстрыхТоваров;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ТекущаяНастройкаРМК") Тогда
		ПалитраИзбранных = Форма.ТекущаяНастройкаРМК.СтруктураБыстрыхТоваров;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПалитраИзбранных) Тогда
		ШрифтТекстом = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПалитраИзбранных, "ШрифтЭлементовПодбора");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШрифтТекстом) Тогда
		БазовыйШрифт = ОбщегоНазначения.ЗначениеИзСтрокиXML(ШрифтТекстом);
	Иначе
		ШрифтТакси = Новый Шрифт(ШрифтыСтиля.ЗаголовокТретьегоУровня, , , Ложь);
		БазовыйШрифт = ?(ЭтоИнтерфейс85, ШрифтыСтиля.ШрифтИзбранногоПоУмолчанию85, ШрифтТакси);
	КонецЕсли;
	
	Возврат БазовыйШрифт;
	
КонецФункции

Процедура ДобавитьКнопкуВРядПлитокКарточек(РядКнопок, ИндексКнопки, Форма, ПараметрыПостроения)
	
	ЭлементыФормы = Форма.Элементы;
	
	ИмяЭлемента = СтрШаблон("КонтейнерПлитки_%1", ИндексКнопки);
	КонтейнерПлитки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), РядКнопок);
	КонтейнерПлитки.Вид = ВидГруппыФормы.Страницы;
	КонтейнерПлитки.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	ИмяЭлемента = СтрШаблон("СтраницаПлиткаПустоеМесто_%1", ИндексКнопки);
	СтраницаКонтейнера = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), КонтейнерПлитки);
	СтраницаКонтейнера.Вид = ВидГруппыФормы.Страница;
	
	ИмяЭлемента = СтрШаблон("ДекорацияПустоеМесто_%1", ИндексКнопки);
	ПустаяДекорация = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), СтраницаКонтейнера);
	ПустаяДекорация.Вид = ВидДекорацииФормы.Надпись;
	ПустаяДекорация.РастягиватьПоВертикали = Истина;
	ПустаяДекорация.РастягиватьПоГоризонтали = Истина;
	ПустаяДекорация.Заголовок = " ";
	
	ИмяЭлемента = СтрШаблон("СтраницаСодержимогоГруппы_%1", ИндексКнопки);
	СтраницаКонтейнера = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), КонтейнерПлитки);
	СтраницаКонтейнера.Вид = ВидГруппыФормы.Страница;
	СтраницаКонтейнера.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	СтраницаКонтейнера.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	СтраницаКонтейнера.РастягиватьПоГоризонтали = Истина;
	СтраницаКонтейнера.РастягиватьПоВертикали = Истина;
	СтраницаКонтейнера.ОтображатьЗаголовок = Ложь;
	НаполнитьСтраницуГруппыПлитки(ЭлементыФормы, СтраницаКонтейнера, ИндексКнопки, ПараметрыПостроения);
	
	ИмяЭлемента = СтрШаблон("СтраницаСодержимогоЭлемента_%1", ИндексКнопки);
	СтраницаКонтейнера = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), КонтейнерПлитки);
	СтраницаКонтейнера.Вид = ВидГруппыФормы.Страница;
	СтраницаКонтейнера.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	СтраницаКонтейнера.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	СтраницаКонтейнера.РастягиватьПоГоризонтали = Истина;
	СтраницаКонтейнера.РастягиватьПоВертикали = Истина;
	СтраницаКонтейнера.ОтображатьЗаголовок = Ложь;
	НаполнитьСтраницуЭлементаПлитки(ЭлементыФормы, СтраницаКонтейнера, ИндексКнопки, ПараметрыПостроения);
	
	Если ИндексКнопки = (Форма.КоличествоЭлементовВРяду * Форма.КоличествоРядовНаСтранице - 1) Тогда
		ДобавитьСтраницуНавигацииПлитки(Форма, КонтейнерПлитки);
	КонецЕсли;
	
КонецПроцедуры

Процедура НаполнитьСтраницуГруппыПлитки(ЭлементыФормы, СтраницаКонтейнера, ИндексКнопки, ПараметрыПостроения)
	
	ЭлементыПлитки = Новый Структура();
	НаполнитьСтраницуПлиткиОбщимиЭлементами(ЭлементыФормы, СтраницаКонтейнера, ИндексКнопки,
		ПараметрыПостроения, ЭлементыПлитки);
	ЭлементыПлитки.ПлиткаКарточка.ВидОтображения = ВидОтображенияКарточки.Группа;
	
КонецПроцедуры

Процедура НаполнитьСтраницуЭлементаПлитки(ЭлементыФормы, СтраницаКонтейнера, ИндексКнопки, ПараметрыПостроения)
	
	ЭлементыПлитки = Новый Структура();
	НаполнитьСтраницуПлиткиОбщимиЭлементами(ЭлементыФормы, СтраницаКонтейнера, ИндексКнопки,
		ПараметрыПостроения, ЭлементыПлитки);
	
	Если ПараметрыПостроения.ОтображатьОстаток Тогда
		
		ИмяЭлемента = СтрШаблон("ГруппаИнформацияЭлемента_%1", ИндексКнопки);
		ГруппаИнформация = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ЭлементыПлитки.ПлиткаКарточка);
		ГруппаИнформация.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаИнформация.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		ГруппаИнформация.ОтображатьЗаголовок = Ложь;
		ГруппаИнформация.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
		ГруппаИнформация.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
		
		ИмяЭлемента = СтрШаблон("ЦенаВПлитке_%1", ИндексКнопки);
		ЭлементФормы = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаИнформация);
		ЭлементФормы.Вид = ВидПоляФормы.ПолеНадписи;
		ЭлементФормы.ПутьКДанным = СтрШаблон("ДанныеКнопокПлиток[%1].ЦенаТекст", ИндексКнопки);
		ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ЭлементФормы.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
		ЭлементФормы.Высота = 1;
		ЭлементФормы.Ширина = 1;
		ЭлементФормы.АвтоМаксимальнаяШирина = Ложь;
		ЭлементФормы.РастягиватьПоГоризонтали = Истина;
		ЭлементФормы.РастягиватьПоВертикали = Ложь;
		ЭлементФормы.Шрифт = ПараметрыПостроения.ШрифтЦены;
		
		ИмяЭлемента = СтрШаблон("ОстатокВПлитке_%1", ИндексКнопки);
		ЭлементФормы = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаИнформация);
		ЭлементФормы.Вид = ВидПоляФормы.ПолеНадписи;
		ЭлементФормы.ПутьКДанным = СтрШаблон("ДанныеКнопокПлиток[%1].КоличествоТекст", ИндексКнопки);
		ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ЭлементФормы.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
		ЭлементФормы.Высота = 1;
		ЭлементФормы.Ширина = 1;
		ЭлементФормы.АвтоМаксимальнаяШирина = Ложь;
		ЭлементФормы.РастягиватьПоГоризонтали = Истина;
		ЭлементФормы.РастягиватьПоВертикали = Ложь;
		ЭлементФормы.Шрифт = ПараметрыПостроения.ШрифтЦены;
		
	ИначеЕсли Не ПараметрыПостроения.СкрыватьЦену Тогда
		
		ИмяЭлемента = СтрШаблон("ЦенаВПлитке_%1", ИндексКнопки);
		ЭлементФормы = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ЭлементыПлитки.ПлиткаКарточка);
		ЭлементФормы.Вид = ВидПоляФормы.ПолеНадписи;
		ЭлементФормы.ПутьКДанным = СтрШаблон("ДанныеКнопокПлиток[%1].ЦенаТекст", ИндексКнопки);
		ЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ЭлементФормы.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
		ЭлементФормы.Высота = 1;
		ЭлементФормы.Ширина = 1;
		ЭлементФормы.АвтоМаксимальнаяШирина = Ложь;
		ЭлементФормы.РастягиватьПоГоризонтали = Истина;
		ЭлементФормы.РастягиватьПоВертикали = Ложь;
		ЭлементФормы.Шрифт = ПараметрыПостроения.ШрифтЦены;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура НаполнитьСтраницуПлиткиОбщимиЭлементами(ЭлементыФормы, СтраницаКонтейнера, ИндексКнопки,
		ПараметрыПостроения, ЭлементыПлитки)
	
	БезРамки = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки);
	
	НачалоИмениГруппы = "СтраницаСодержимогоГруппы";
	ПостфиксЭлементаФормы = ?(СтрНайти(СтраницаКонтейнера.Имя, НачалоИмениГруппы) > 0, "Группы", "Элемента");
	
	ИмяЭлемента = СтрШаблон("ПлиткаКарточка%1_%2", ПостфиксЭлементаФормы, ИндексКнопки);
	ПлиткаКарточка = ДобавитьГруппуКарточку(ЭлементыФормы,
		СтраницаКонтейнера, ИмяЭлемента, ПараметрыПостроения.ИмяКомандыНажатия);
	ПлиткаКарточка.РастягиватьПоГоризонтали = Истина;
	ПлиткаКарточка.РастягиватьПоВертикали = Истина;
	ПлиткаКарточка.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	ПлиткаКарточка.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	Если Не ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85() Тогда
		ПлиткаКарточка.Ширина = 26;
	КонецЕсли;
	
	ИмяЭлемента = СтрШаблон("Наименование%1Плитки_%2", ПостфиксЭлементаФормы, ИндексКнопки);
	НадписьПлитки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ПлиткаКарточка);
	НадписьПлитки.Вид = ВидПоляФормы.ПолеНадписи;
	НадписьПлитки.ПутьКДанным = СтрШаблон("ДанныеКнопокПлиток[%1].ИмяЭлемента", ИндексКнопки);
	НадписьПлитки.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НадписьПлитки.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
	НадписьПлитки.РастягиватьПоГоризонтали = Истина;
	НадписьПлитки.Шрифт = ПараметрыПостроения.БазовыйШрифт;
	НадписьПлитки.Высота = 2;
	НадписьПлитки.АвтоМаксимальнаяВысота = Ложь;
	НадписьПлитки.АвтоМаксимальнаяШирина = Ложь;
	НадписьПлитки.МаксимальнаяВысота = 2;
	
	ИмяЭлемента = СтрШаблон("Изображение%1ВПлитке_%2", ПостфиксЭлементаФормы, ИндексКнопки);
	КартинкаПлитки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ПлиткаКарточка);
	КартинкаПлитки.Вид = ВидПоляФормы.ПолеКартинки;
	КартинкаПлитки.ПутьКДанным = СтрШаблон("ДанныеКнопокПлиток[%1].АдресИзображения", ИндексКнопки);
	КартинкаПлитки.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	КартинкаПлитки.РазмерКартинки = РазмерКартинки.Пропорционально;
	КартинкаПлитки.Высота = 1;
	КартинкаПлитки.Ширина = 1;
	КартинкаПлитки.Рамка = БезРамки;
	КартинкаПлитки.РастягиватьПоВертикали = Истина;
	КартинкаПлитки.РастягиватьПоГоризонтали = Истина;
	
	ЭлементыПлитки.Вставить("ПлиткаКарточка", ПлиткаКарточка);
	
КонецПроцедуры

Процедура ЗаполнитьСоставПалитрыИзбранногоПоДаннымДереваВУзле(СоставПалитры, ЭлементыДерева, НомерКатегории, НомерСтроки)
	Перем ЦветШрифтаСтроки, ЦветФонаСтроки;
	
	ТекущийИндексПозиции = 0;
	ТекущийНомерКатегории = НомерКатегории;
	
	ИндексыКрайнихПустыхОбластей = Новый Массив;
	
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		
		НовыйЭлементСостава = СоставПалитры.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйЭлементСостава, ЭлементДерева);
		Если Не НомерСтроки = Неопределено Тогда
			НомерСтроки = НомерСтроки + 1;
			НовыйЭлементСостава.НомерСтроки = ЭлементДерева.НомерСтроки;
		КонецЕсли;
		ТекущийИндексПозиции = ТекущийИндексПозиции + 1;
		НовыйЭлементСостава.ИндексПозиции = ТекущийИндексПозиции;
		
		НовыйЭлементСостава.НомерКатегорииРазмещения = НомерКатегории;
		
		ЭтоЭлементГруппа = ЭлементДерева.ЭтоКатегория ИЛИ ЭлементДерева.ИмеетсяВложенность;
		Если ЭтоЭлементГруппа И НЕ ЗначениеЗаполнено(ЭлементДерева.ВидМодификатора) Тогда
			
			ТекущийНомерКатегории = ТекущийНомерКатегории + 1;
			НовыйЭлементСостава.НомерКатегории = ТекущийНомерКатегории;
			ЗаполнитьСоставПалитрыИзбранногоПоДаннымДереваВУзле(СоставПалитры,
				ЭлементДерева.Строки, ТекущийНомерКатегории, НомерСтроки);
			
		КонецЕсли;
		
		ИменаСвойствЗаполнения = "ИндексПозиции, НомерКатегорииРазмещения, НомерКатегории";
		ЗаполнитьЗначенияСвойств(ЭлементДерева,
			НовыйЭлементСостава, ИменаСвойствЗаполнения);
			
		Если ЭлементДерева.ЦветШрифта.Вид = ВидЦвета.WindowsЦвет
				Или ЭлементДерева.ЦветШрифта.Вид = ВидЦвета.ЭлементСтиля Тогда
				
			ЦветШрифтаСтроки = ЭлементДерева.ЦветШрифта.ПолучитьАбсолютный();
				
		Иначе
			
			ЦветШрифтаСтроки =  ЭлементДерева.ЦветШрифта;
			
		КонецЕсли;
		
		Если ЭлементДерева.ЦветФона.Вид = ВидЦвета.WindowsЦвет
				Или ЭлементДерева.ЦветФона.Вид = ВидЦвета.ЭлементСтиля Тогда
				
			ЦветФонаСтроки = ЭлементДерева.ЦветФона.ПолучитьАбсолютный();
				
		Иначе
			
			ЦветФонаСтроки =  ЭлементДерева.ЦветФона;
			
		КонецЕсли;
			
		НовыйЭлементСостава.ЦветШрифта = ОбщегоНазначения.ЗначениеВСтрокуXML(ЦветШрифтаСтроки);
		НовыйЭлементСостава.ЦветФона = ОбщегоНазначения.ЗначениеВСтрокуXML(ЦветФонаСтроки);
		Если ЭлементДерева.ПустаяОбласть Тогда
			ИндексыКрайнихПустыхОбластей.Вставить(0, СоставПалитры.Индекс(НовыйЭлементСостава));
		ИначеЕсли Не (ЭлементДерева.ПустаяОбласть Или ЗначениеЗаполнено(ЭлементДерева.ВидМодификатора)) Тогда
			ИндексыКрайнихПустыхОбластей.Очистить();
		КонецЕсли;
		
	КонецЦикла;
	Для Каждого ИндексЛишнего Из ИндексыКрайнихПустыхОбластей Цикл
		СоставПалитры.Удалить(ИндексЛишнего);
	КонецЦикла;
	
	НомерКатегории = ТекущийНомерКатегории;
	
КонецПроцедуры

Процедура НастроитьИспользованиеКнопкиВыбораПоля(Элементы, ИмяПоля, ПоказатьКнопкуВыбора, УвеличитьШирину)
	
	ДельтаШирины = 2;
	Элементы[ИмяПоля].КнопкаВыбора = ПоказатьКнопкуВыбора;
	Если УвеличитьШирину Тогда
		Элементы[ИмяПоля].Ширина = Элементы[ИмяПоля].Ширина + ДельтаШирины;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОтборРазделаГорячихКлавиш(Элементы, Элемент)
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение =
		Новый ПолеКомпоновкиДанных(Элементы.ДеревоГорячиеКлавишиНомерСтроки.ПутьКДанным);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
КонецПроцедуры

Процедура ДобавитьОтборНекорректныхКомбинацийГорячихКлавиш(Элемент, ТиНарушения)
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоГорячиеКлавиши.ТипНарушения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
	ОтборЭлемента.ПравоеЗначение = ТиНарушения;
	
КонецПроцедуры

Процедура ДобавитьОтборНекорректныхКомбинацийГорячихКлавишКупюр(Элемент, ТиНарушения)
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("НастройкиРМК.ВводНаличных.ТипНарушения");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = ТиНарушения;
	
КонецПроцедуры

Функция ПодготовитьСочетаниеГорячейКлавиши(АкселераторыКупюр, КлавишаСтрокой)
	СочетаниеКлавиш = Неопределено;
	ПустаяКлавиша = ИнтерфейсРМКСлужебныйКлиентСервер.ПредставлениеПустойКлавиши();
	Если ЗначениеЗаполнено(КлавишаСтрокой) И Не КлавишаСтрокой = ПустаяКлавиша Тогда
		
		ДополнительнаяКлавиша = Клавиша[КлавишаСтрокой];
		СочетаниеКлавиш = Новый СочетаниеКлавиш(ДополнительнаяКлавиша,
			АкселераторыКупюр.Alt, АкселераторыКупюр.Ctrl, АкселераторыКупюр.Shift);
				
	КонецЕсли;
	Возврат СочетаниеКлавиш;
КонецФункции

Процедура ДобавитьСлужебныеГруппыВесовогоТовараВОпорныеДанные(Форма)
	
	ЦветаФона = ПолучитьЦветаПлиточногоИнтерфейсаПоУмолчанию(Форма);
	ПараметрыПостроения = Новый Структура();
	ПараметрыПостроения.Вставить("ЦветаФона", ЦветаФона);
	
	ИмяПапкиДругихВесовыхТоваров = ИнтерфейсРМКСлужебныйКлиентСервер.ИмяГруппыДругихВесовыхТоваров();
	ИмяОбратнойПапки = ИнтерфейсРМКСлужебныйКлиентСервер.ИмяГруппыРаспознанныхВесовыхТоваров();
	ИсточникиДанныхПлитки = ИнтерфейсРМКСлужебныйКлиентСервер.ИсточникиДанныхДляПлитки();
	ИсточникСлужебныеГруппы = ИсточникиДанныхПлитки.СлужебныеГруппы;
	
	ОтборДанных = Новый Структура("ИсточникПлитки", ИсточникСлужебныеГруппы);
	СлужебныеСтроки = Форма.ОпорныеДанные.НайтиСтроки(ОтборДанных);
	Если СлужебныеСтроки.Количество() = 0 Тогда
		ДобавитьСлужебнуюГруппуВОпорныеДанные(Форма, ИмяПапкиДругихВесовыхТоваров, Ложь,
			ИсточникСлужебныеГруппы, ПараметрыПостроения);
		ДобавитьСлужебнуюГруппуВОпорныеДанные(Форма, ИмяОбратнойПапки, Истина,
			ИсточникСлужебныеГруппы, ПараметрыПостроения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСлужебнуюГруппуВОпорныеДанные(Форма, ИмяЭлемента,
		ОбратнаяГруппа, ИсточникПлитки, ПараметрыПостроения)
	
	ОпорныеДанные = Форма.ОпорныеДанные;
	НоваяСтрока = ОпорныеДанные.Добавить();
	НоваяСтрока.НомерКатегории = ?(ОбратнаяГруппа, 0, 1);
	НоваяСтрока.ИндексПозицииВКатегории = ?(ОбратнаяГруппа, 1, 0);
	НоваяСтрока.НомерКатегорииРазмещенияЭлемента = ?(ОбратнаяГруппа, 1, 0);
	НоваяСтрока.ЭтоКатегория = Истина;
	НоваяСтрока.ЦветФона = ПараметрыПостроения.ЦветаФона.ЦветФонаПапки;
	НоваяСтрока.ИмяЭлемента = ИмяЭлемента;
	НоваяСтрока.ДоступностьКоманды = Истина;
	НоваяСтрока.ПервыйИндексПлитки = 0;
	НоваяСтрока.ИмеетсяВложенность = Истина;
	НоваяСтрока.ИсточникПлитки = ИсточникПлитки;
	НоваяСтрока.ЭтоТекущаяКатегория = ?(ОбратнаяГруппа, Истина, Ложь);
	
КонецПроцедуры

Функция ДобавитьПакетВОпорныеДанныеПриНеобходимости(ОпорныеДанные, Форма, НовыйИндекс)
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	СтрокаПакета = Неопределено;
	ИсточникиДанныхПлитки = ИнтерфейсРМКСлужебныйКлиентСервер.ИсточникиДанныхДляПлитки();
	ДанныеПакета = Форма.ДанныеПакета;
	Если (Не ДанныеПакета = Неопределено) И ЗначениеЗаполнено(ДанныеПакета.Номенклатура) Тогда
		
		НовыйИндекс = НовыйИндекс + 1;
		СтрокаПакета = ОпорныеДанные.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПакета, ДанныеПакета);
		СтрокаПакета.ИндексПозицииВКатегории = НовыйИндекс;
		СтрокаПакета.ЦветШрифта = Новый Цвет();
		СтрокаПакета.ЦветФона = ?(ЭтоИнтерфейс85, Новый Цвет(), ЦветаПалитры.СветлоБежевыйРМК);
		СтрокаПакета.ИмяЭлемента = Общегоназначения.ЗначениеРеквизитаОбъекта(ДанныеПакета.Номенклатура, "Наименование");
		СтрокаПакета.Доступностькоманды = Истина;
		СтрокаПакета.ИсточникПлитки = ИсточникиДанныхПлитки.Избранное;
		СтрокаПакета.ПервыйИндексПлитки = ОпорныеДанные.Индекс(СтрокаПакета);
		Если ЭтоРежимКассыСамообслуживания(Форма) Тогда
			СтрокаПакета.АдресИзображения
				= ПоместитьВоВременноеХранилище(БиблиотекаКартинок.РМКПакетКрупно.ПолучитьДвоичныеДанные(Истина),
					Форма.УникальныйИдентификатор);
		Иначе
			СтрокаПакета.АдресИзображения
				= ПоместитьВоВременноеХранилище(БиблиотекаКартинок.РМКДобавитьПакетQR.ПолучитьДвоичныеДанные(Истина),
					Форма.УникальныйИдентификатор);
		КонецЕсли;
		
	КонецЕсли;
	Возврат СтрокаПакета;
	
КонецФункции

Функция ЭтоРежимКассыСамообслуживания(Форма)
	
	РезультатФункции = Ложь;
	Если Форма.ИмяФормы = "Обработка.РабочееМестоКассира.Форма.ФормаРМК" Тогда
		РезультатФункции = Форма.РежимКассыСамообслуживания;
	ИначеЕсли Форма.ИмяФормы = "ОбщаяФорма.НастройкиРабочегоМестаКассира" Тогда
		РезультатФункции = (Форма.НастройкиРМК.СценарийИспользования
			= Перечисления.СценарииИспользованияРМК.ТерминалСамообслуживания);
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьНачальныйИндексНаСтранице(СтрокаПлитки, НомерСтраницыВКатегории, КоличествоПлитокНаСтранице)
	
	КоличествоКарточекНаСтранице = 1;
	ИсточникиДанныхПлитки = ИнтерфейсРМКСлужебныйКлиентСервер.ИсточникиДанныхДляПлитки();
	Если СтрокаПлитки.ИсточникПлитки = ИсточникиДанныхПлитки.Избранное Тогда
		КоличествоКарточекНаСтранице = ИнтерфейсРМКСлужебныйКлиентСервер.КоличествоКарточекИзбранногоНаСтранице();
	Иначе
		КоличествоКарточекНаСтранице = КоличествоПлитокНаСтранице;
	КонецЕсли;
	
	РезультатФункции = 0;
	Если СтрокаПлитки.НомерКатегорииРазмещенияЭлемента = 0 Тогда
		РезультатФункции = (НомерСтраницыВКатегории * (КоличествоКарточекНаСтранице - 1)) + 1;
	Иначе
		РезультатФункции = (НомерСтраницыВКатегории * (КоличествоКарточекНаСтранице - 2)) + 2;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьНомерСтраницыЭлемента(СтрокаПлитки, КоличествоВКатегориях,
		КоличествоВКатегорияхПалитры, КоличествоПлитокНаСтранице)
	
	КоличествоКарточекНаСтранице = 1;
	МаксимальныйИндексВКатегории = 0;
	ИсточникиДанныхПлитки = ИнтерфейсРМКСлужебныйКлиентСервер.ИсточникиДанныхДляПлитки();
	Если СтрокаПлитки.ИсточникПлитки = ИсточникиДанныхПлитки.Избранное Тогда
		КоличествоКарточекНаСтранице = ИнтерфейсРМКСлужебныйКлиентСервер.КоличествоКарточекИзбранногоНаСтранице();
		МаксимальныйИндексВКатегории = КоличествоВКатегориях.Получить(СтрокаПлитки.НомерКатегорииРазмещенияЭлемента);
	Иначе
		КоличествоКарточекНаСтранице = КоличествоПлитокНаСтранице;
		МаксимальныйИндексВКатегории = КоличествоВКатегорияхПалитры.Получить(СтрокаПлитки.НомерКатегорииРазмещенияЭлемента);
	КонецЕсли;
	
	РезультатФункции = 0;
	Если МаксимальныйИндексВКатегории > КоличествоКарточекНаСтранице Тогда
		Если СтрокаПлитки.НомерКатегорииРазмещенияЭлемента = 0 Тогда
			РезультатФункции = Цел((СтрокаПлитки.ИндексПозицииВКатегории - 1) / (КоличествоКарточекНаСтранице - 1));
		Иначе
			РезультатФункции = Цел((СтрокаПлитки.ИндексПозицииВКатегории - 2) / (КоличествоКарточекНаСтранице - 2));
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ДобавитьКоличествоКатегории(КоличествоВКатегориях, СтрокаОпорныхДанных)
	
	КоличествоВКатегории = КоличествоВКатегориях.Получить(СтрокаОпорныхДанных.НомерКатегорииРазмещенияЭлемента);
	Если КоличествоВКатегории = Неопределено Или КоличествоВКатегории < СтрокаОпорныхДанных.ИндексПозицииВКатегории Тогда
		КоличествоВКатегориях.Вставить(СтрокаОпорныхДанных.НомерКатегорииРазмещенияЭлемента,
			СтрокаОпорныхДанных.ИндексПозицииВКатегории);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОпорныеДанныеСтрокамиПалитры(Форма, Выборка, ПалитраПлитки) Экспорт

	УникальныйИдентификаторФормы = Форма.УникальныйИдентификатор;
	
	ВертикальнаяОриентация = Ложь;
	ИсточникиДанныхПлитки = ИнтерфейсРМКСлужебныйКлиентСервер.ИсточникиДанныхДляПлитки();
	ДанныеАвтоКартинки = БиблиотекаКартинок.РМККассаЗеленая.ПолучитьДвоичныеДанные();
	АдресКартинкиГруппыПоУмолчанию = ПоместитьВоВременноеХранилище(ДанныеАвтоКартинки, УникальныйИдентификаторФормы);
	ДанныеКартинкиПодарок = БиблиотекаКартинок.РМКПодарок.ПолучитьДвоичныеДанные();
	АдресКартинкиПодаркаПоУмолчанию = ПоместитьВоВременноеХранилище(ДанныеКартинкиПодарок, УникальныйИдентификаторФормы);
	ОбозначениеПалитры = ПолучитьОбозначениеПалитрыПоУмолчанию();
	
	КоличествоЭлементовВРяду = 0;
	КоличествоРядовНаСтранице = 0;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ВертикальнаяОриентация") Тогда
		ВертикальнаяОриентация = Форма.ВертикальнаяОриентация;
	КонецЕсли;
	
	Если Не ПалитраПлитки = Неопределено И ОбщегоНазначения.СсылкаСуществует(ПалитраПлитки) Тогда
		ИменаРеквизитов = "Наименование,КоличествоЭлементовВРяду,КоличествоРядов";
		РеквизитыПалитры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПалитраПлитки, ИменаРеквизитов);
		Если РеквизитыПалитры.КоличествоЭлементовВРяду > 0 И РеквизитыПалитры.КоличествоРядов > 0 Тогда
			
			КоличествоЭлементовВРяду = РеквизитыПалитры.КоличествоЭлементовВРяду;
			КоличествоРядовНаСтранице = РеквизитыПалитры.КоличествоРядов;
			
		КонецЕсли;
		ОбозначениеПалитры = РеквизитыПалитры.Наименование;
	КонецЕсли;
	Если КоличествоЭлементовВРяду < 2 Или КоличествоРядовНаСтранице < 2 Тогда
		РазмерыПлиткиПоУмолчанию
			= ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьРазмерыПлиткиПоУмолчанию(ВертикальнаяОриентация);
			
		Если КоличествоЭлементовВРяду < 2 Тогда
			КоличествоЭлементовВРяду = РазмерыПлиткиПоУмолчанию.КоличествоЭлементовВРяду;
		КонецЕсли;
		Если КоличествоРядовНаСтранице < 2 Тогда
			КоличествоРядовНаСтранице = РазмерыПлиткиПоУмолчанию.КоличествоРядовНаСтранице;
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущийНомерКатегорииРазмещения = -1;
	ТекущийИсточникДанныхПалитры = -1;
	ОпорныеДанные = Форма.ОпорныеДанные;
	НовыйИндекс = 0;
	МаксимальноеКоличествоИзбранных = 0;
	СтрокаПакета = Неопределено;
	ЦветаПакетаУстановлены = Ложь;
	КоличествоВКатегориях = Новый Соответствие;
	КоличествоВКатегорияхПалитры = Новый Соответствие;
	НаименованияКатегорий = Новый Соответствие;
	НаименованияКатегорий.Вставить(0, ОбозначениеПалитры);
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ТекущийНомерКатегорииРазмещения = Выборка.НомерКатегорииРазмещенияЭлемента
			Или Не ТекущийИсточникДанныхПалитры = Выборка.ИсточникПлитки Тогда
			НовыйИндекс = 0;
			Если Выборка.ИсточникПлитки = ИсточникиДанныхПлитки.Избранное И Выборка.НомерКатегорииРазмещенияЭлемента = 0 Тогда
				СтрокаПакета = ДобавитьПакетВОпорныеДанныеПриНеобходимости(ОпорныеДанные, Форма, НовыйИндекс);
			КонецЕсли;
			ТекущийНомерКатегорииРазмещения = Выборка.НомерКатегорииРазмещенияЭлемента;
			ТекущийИсточникДанныхПалитры = Выборка.ИсточникПлитки;
		КонецЕсли;
		
		НовыйИндекс = НовыйИндекс + 1;
		
		СтрокаОпорныхДанных = ОпорныеДанные.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОпорныхДанных, Выборка);
		СтрокаОпорныхДанных.ИндексПозицииВКатегории = НовыйИндекс;
		СтрокаОпорныхДанных.ДоступностьКоманды = Истина;
		СтрокаОпорныхДанных.ПервыйИндексПлитки = ОпорныеДанные.Индекс(СтрокаОпорныхДанных);
		
		СтрокаОпорныхДанных.ЦветШрифта = ОбщегоНазначения.ЗначениеИзСтрокиXML(Выборка.ЦветШрифта);
		СтрокаОпорныхДанных.ЦветФона = ОбщегоНазначения.ЗначениеИзСтрокиXML(Выборка.ЦветФона);
		
		Если Выборка.ИсточникПлитки = ИсточникиДанныхПлитки.Избранное И (Не СтрокаПакета = Неопределено)
				И (Не ЦветаПакетаУстановлены) И ЗначениеЗаполнено(СтрокаОпорныхДанных.Номенклатура) Тогда
			ЦветаПакетаУстановлены = Истина;
			СтрокаПакета.ЦветШрифта = СтрокаОпорныхДанных.ЦветШрифта;
			СтрокаПакета.ЦветФона = СтрокаОпорныхДанных.ЦветФона;
		КонецЕсли;
		
		СсылкаНаПрисоединенныйФайл = Выборка.ИзображениеЭлемента;
		Если Не СсылкаНаПрисоединенныйФайл.Пустая() Тогда
			АдресКартинки = НавигационнаяСсылкаИзображения(СсылкаНаПрисоединенныйФайл, УникальныйИдентификаторФормы);
			СтрокаОпорныхДанных.АдресИзображения = АдресКартинки;
		ИначеЕсли Выборка.ЭтоКатегория И Выборка.КартинкапоУмолчанию Тогда
			СтрокаОпорныхДанных.АдресИзображения = АдресКартинкиГруппыПоУмолчанию;
		ИначеЕсли Выборка.ЭтоПодарок И Выборка.КартинкапоУмолчанию Тогда
			СтрокаОпорныхДанных.АдресИзображения = АдресКартинкиПодаркаПоУмолчанию;
		КонецЕсли;
		
		Если Выборка.ИсточникПлитки = ИсточникиДанныхПлитки.Избранное Тогда
			МаксимальноеКоличествоИзбранных = Макс(МаксимальноеКоличествоИзбранных, СтрокаОпорныхДанных.ИндексПозицииВКатегории);
			ДобавитьКоличествоКатегории(КоличествоВКатегориях, СтрокаОпорныхДанных);
		ИначеЕсли Выборка.ИсточникПлитки = ИсточникиДанныхПлитки.Палитра Тогда
			ДобавитьКоличествоКатегории(КоличествоВКатегорияхПалитры, СтрокаОпорныхДанных);
		КонецЕсли;
		ДобавитьВКэшИмяКатегории(НаименованияКатегорий, Выборка, ИсточникиДанныхПлитки);
		
	КонецЦикла;
	
	Попытка
		КоличествоПлитокНаСтранице = КоличествоЭлементовВРяду * КоличествоРядовНаСтранице;
		Фильтр = Новый Структура;
		Фильтр.Вставить("ИмеетсяВложенность", Истина);
		Фильтр.Вставить("ЭтоТекущаяКатегория", Ложь);
		СтрокиПлитки = ОпорныеДанные.НайтиСтроки(Фильтр);
		ФильтрЭлемента = Новый Структура;
		
		Для Каждого СтрокаПлитки Из СтрокиПлитки Цикл
			
			Фильтр = Новый Структура;
			Фильтр.Вставить("ЭтоТекущаяКатегория", Истина);
			Фильтр.Вставить("НомерКатегорииРазмещенияЭлемента", СтрокаПлитки.НомерКатегории);
			Фильтр.Вставить("ИсточникПлитки", СтрокаПлитки.ИсточникПлитки);
			
			ЭлементыОпорныхДанных = ОпорныеДанные.НайтиСтроки(Фильтр);
			Если ЭлементыОпорныхДанных.Количество() Тогда
				ПервыйЭлементКатегорииПлитки = ЭлементыОпорныхДанных[0];
				СтрокаПлитки.ПервыйИндексПлитки = ОпорныеДанные.Индекс(ПервыйЭлементКатегорииПлитки);
				ЗаменитьИмяУОбратногоЭлементаПлитки(ПервыйЭлементКатегорииПлитки, СтрокаПлитки.НомерКатегорииРазмещенияЭлемента,
					НаименованияКатегорий, ИсточникиДанныхПлитки);
				
				НомерСтраницыВКатегории
					= ПолучитьНомерСтраницыЭлемента(СтрокаПлитки, КоличествоВКатегориях, КоличествоВКатегорияхПалитры,
						КоличествоПлитокНаСтранице);
				НачальныйИндексПозицииНаСтранице
					= ПолучитьНачальныйИндексНаСтранице(СтрокаПлитки, НомерСтраницыВКатегории, КоличествоПлитокНаСтранице);
				
				ФильтрЭлемента.Вставить("НомерКатегорииРазмещенияЭлемента", СтрокаПлитки.НомерКатегорииРазмещенияЭлемента);
				ФильтрЭлемента.Вставить("ИндексПозицииВКатегории", НачальныйИндексПозицииНаСтранице);
				ФильтрЭлемента.Вставить("ИсточникПлитки", СтрокаПлитки.ИсточникПлитки);
				СтрокаНачальнойПозиции = ОпорныеДанные.НайтиСтроки(ФильтрЭлемента)[0];
				
				Если СтрокаПлитки.НомерКатегорииРазмещенияЭлемента = 0 Тогда
					ПервыйЭлементКатегорииПлитки.ПервыйИндексПлитки = ОпорныеДанные.Индекс(СтрокаНачальнойПозиции);
				Иначе
					ПервыйЭлементКатегорииПлитки.ВторойИндексПлитки = ОпорныеДанные.Индекс(СтрокаНачальнойПозиции);
					ФильтрЭлемента.Вставить("ИндексПозицииВКатегории", 1);
					СтрокаПозицииГруппы = ОпорныеДанные.НайтиСтроки(ФильтрЭлемента)[0];
					ПервыйЭлементКатегорииПлитки.ПервыйИндексПлитки = ОпорныеДанные.Индекс(СтрокаПозицииГруппы);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	Исключение
		ОпорныеДанные.Очистить();
	КонецПопытки;
	
	ТекущийПервыйИндексИзбранного = -1;
	ТекущийВторойИндексИзбранного = -1;
	ТекущийПервыйИндексПлитки = -1;
	ТекущийВторойИндексПлитки = -1;
	ТекущаяСтраницаКнопок = -1;
	Фильтр = Новый Структура;
	Фильтр.Вставить("НомерКатегорииРазмещенияЭлемента", 0);
	Фильтр.Вставить("ИндексПозицииВКатегории", 1);
	Фильтр.Вставить("ИсточникПлитки", ИсточникиДанныхПлитки.Палитра);
	СтрокиПлитки = ОпорныеДанные.НайтиСтроки(Фильтр);
	
	Если СтрокиПлитки.Количество() > 0 Тогда
		ТекущийПервыйИндексПлитки = ОпорныеДанные.Индекс(СтрокиПлитки[0]);
		Фильтр.Вставить("ИндексПозицииВКатегории", 2);
		СтрокиПлитки = ОпорныеДанные.НайтиСтроки(Фильтр);
		Если СтрокиПлитки.Количество() > 0 Тогда
			ТекущийВторойИндексПлитки = ОпорныеДанные.Индекс(СтрокиПлитки[0]);
		КонецЕсли;
	КонецЕсли;
	
	Фильтр.Вставить("ИсточникПлитки", ИсточникиДанныхПлитки.Избранное);
	Фильтр.Вставить("ИндексПозицииВКатегории", 1);
	СтрокиПлитки = ОпорныеДанные.НайтиСтроки(Фильтр);
	Если СтрокиПлитки.Количество() = 0 Тогда
		СтрокаПакета = ДобавитьПакетВОпорныеДанныеПриНеобходимости(ОпорныеДанные, Форма, 0);
	КонецЕсли;
	
	СтрокиПлитки = ОпорныеДанные.НайтиСтроки(Фильтр);
	Если СтрокиПлитки.Количество() > 0 Тогда
		ТекущаяСтраницаКнопок = ОпорныеДанные.Индекс(СтрокиПлитки[0]);
		ТекущийПервыйИндексИзбранного = ТекущаяСтраницаКнопок;
		Фильтр.Вставить("ИндексПозицииВКатегории", 2);
		СтрокиПлитки = ОпорныеДанные.НайтиСтроки(Фильтр);
		Если СтрокиПлитки.Количество() > 0 Тогда
			ТекущийВторойИндексИзбранного = ОпорныеДанные.Индекс(СтрокиПлитки[0]);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураРеквизитовФормы = Новый Структура;
	СтруктураРеквизитовФормы.Вставить("КоличествоЭлементовВРяду", КоличествоЭлементовВРяду);
	СтруктураРеквизитовФормы.Вставить("КоличествоРядовНаСтранице", КоличествоРядовНаСтранице);
	СтруктураРеквизитовФормы.Вставить("ТекущийПервыйИндексПлитки", ТекущийПервыйИндексПлитки);
	СтруктураРеквизитовФормы.Вставить("ТекущийВторойИндексПлитки", ТекущийВторойИндексПлитки);
	СтруктураРеквизитовФормы.Вставить("ТекущаяСтраницаКнопок", ТекущаяСтраницаКнопок);
	СтруктураРеквизитовФормы.Вставить("ТекущийПервыйИндексИзбранного", ТекущийПервыйИндексИзбранного);
	СтруктураРеквизитовФормы.Вставить("ТекущийВторойИндексИзбранного", ТекущийВторойИндексИзбранного);
	СтруктураРеквизитовФормы.Вставить("МаксимальноеКоличествоИзбранныхНаСтранице", МаксимальноеКоличествоИзбранных);
	СтруктураРеквизитовФормы.Вставить("ЕстьГруппыИзбранногоБолее4", (МаксимальноеКоличествоИзбранных > 4));
	ЗаполнитьЗначенияСвойств(Форма, СтруктураРеквизитовФормы);
	
КонецПроцедуры

Процедура ДобавитьВКэшИмяКатегории(НаименованияКатегорий, Выборка, ИсточникиДанныхПлитки)
	
	Если Выборка.ЭтоКатегория И Выборка.ИсточникПлитки = ИсточникиДанныхПлитки.Палитра
			И Не Выборка.ЭтоТекущаяКатегория Тогда
		Если НаименованияКатегорий.Получить(Выборка.НомерКатегории) = Неопределено Тогда
			НаименованияКатегорий.Вставить(Выборка.НомерКатегории, Выборка.ИмяЭлемента);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаменитьИмяУОбратногоЭлементаПлитки(СтрокаДанных, НомерКатегорииРодителя,
		НаименованияКатегорий, ИсточникиДанныхПлитки)
		
	Если СтрокаДанных.ИсточникПлитки = ИсточникиДанныхПлитки.Палитра Тогда
		НаименованиеРодителяКатегории = НаименованияКатегорий.Получить(НомерКатегорииРодителя);
		Если Не НаименованиеРодителяКатегории = Неопределено Тогда
			СтрокаДанных.ИмяЭлемента = НаименованиеРодителяКатегории;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Функция ТекстЗапросаТоваровДляУстройствИзПалитры()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТоварыУстройств.Номенклатура КАК Номенклатура,
	|	ТоварыУстройств.Характеристика КАК Характеристика,
	|	ТоварыУстройств.Весовой КАК Весовой,
	|	ТоварыУстройств.SKU КАК SKU
	|ПОМЕСТИТЬ втТоварыУстройств
	|ИЗ
	|	&ТоварыУстройств КАК ТоварыУстройств
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПалитраТоваровРМКСостав.НомерСтроки КАК НомерСтроки,
	|	ПалитраТоваровРМКСостав.Номенклатура КАК Номенклатура,
	|	ПалитраТоваровРМКСостав.Характеристика КАК Характеристика,
	|	ПалитраТоваровРМКСостав.НомерКатегории КАК НомерКатегории,
	|	ПалитраТоваровРМКСостав.НомерКатегорииРазмещения КАК НомерКатегорииРазмещения,
	|	ПалитраТоваровРМКСостав.ИндексПозиции КАК ИндексПозиции,
	|	ПалитраТоваровРМКСостав.ЦветШрифта КАК ЦветШрифта,
	|	ПалитраТоваровРМКСостав.ЦветФона КАК ЦветФона,
	|	ПалитраТоваровРМКСостав.ЭтоКатегория КАК ЭтоКатегория,
	|	ПалитраТоваровРМКСостав.ИмяЭлемента КАК ИмяЭлемента,
	|	ПалитраТоваровРМКСостав.ИзображениеЭлемента КАК ИзображениеЭлемента,
	|	ПалитраТоваровРМКСостав.ВидМодификатора КАК ВидМодификатора,
	|	ПалитраТоваровРМКСостав.ЭтоКатегория КАК ИмеетсяВложенность,
	|	ПалитраТоваровРМКСостав.Упаковка КАК Упаковка,
	|	ПалитраТоваровРМКСостав.СкрыватьОстаток КАК СкрыватьОстаток,
	|	ПалитраТоваровРМКСостав.КартинкаПоУмолчанию КАК КартинкаПоУмолчанию,
	|	ЕСТЬNULL(ТоварыУстройств.SKU, 0) КАК SKU,
	|	ЕСТЬNULL(ТоварыУстройств.Весовой, ЛОЖЬ) КАК Весовой
	|ПОМЕСТИТЬ ПалитраТоваровРМКСостав
	|ИЗ
	|	Справочник.ПалитраТоваровРМК.Состав КАК ПалитраТоваровРМКСостав
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТоварыУстройств КАК ТоварыУстройств
	|		ПО (ТоварыУстройств.Номенклатура = ПалитраТоваровРМКСостав.Номенклатура
	|					И ТоварыУстройств.Характеристика = ПалитраТоваровРМКСостав.Характеристика)
	|ГДЕ
	|	ПалитраТоваровРМКСостав.Ссылка = &ПалитраТоваров
	|	И (ЕСТЬNULL(ТоварыУстройств.SKU, 0) > 0 ИЛИ ПалитраТоваровРМКСостав.ЭтоКатегория)
	|	И ПалитраТоваровРМКСостав.ВидМодификатора = ЗНАЧЕНИЕ(Перечисление.ВидыМодификаторовРМК.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПалитраТоваровРМКСостав.НомерСтроки КАК НомерСтроки,
	|	ПалитраТоваровРМКСостав.НомерКатегории КАК НомерКатегории,
	|	ПалитраТоваровРМКСостав.НомерКатегорииРазмещения КАК НомерКатегорииРазмещения,
	|	ПалитраТоваровРМКСостав.ИндексПозиции КАК ИндексПозиции,
	|	ПалитраТоваровРМКСостав.ЭтоКатегория КАК ЭтоКатегория,
	|	ПалитраТоваровРМКСостав.ИмеетсяВложенность КАК ИмеетсяВложенность,
	|	ПалитраТоваровРМКСостав.SKU КАК SKU
	|ПОМЕСТИТЬ СтруктураПалитрыБезМодификаторов
	|ИЗ
	|	ПалитраТоваровРМКСостав КАК ПалитраТоваровРМКСостав
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПалитраТоваровРМКСостав.НомерСтроки КАК НомерСтроки,
	|	0 КАК НомерКатегории,
	|	ПалитраТоваровРМКСостав.НомерКатегории КАК НомерКатегорииРазмещенияЭлемента,
	|	1 КАК ИндексПозицииВКатегории,
	|	ПалитраТоваровРМКСостав.ЭтоКатегория КАК ЭтоКатегория,
	|	ПалитраТоваровРМКСостав.ИмеетсяВложенность КАК ИмеетсяВложенность,
	|	ИСТИНА КАК ЭтоТекущаяКатегория,
	|	1 КАК ПорядокВидов
	|ПОМЕСТИТЬ ИтоговаяСтруктура
	|ИЗ
	|	ПалитраТоваровРМКСостав КАК ПалитраТоваровРМКСостав
	|ГДЕ
	|	ПалитраТоваровРМКСостав.НомерКатегории > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтруктураПалитрыБезМодификаторов.НомерСтроки,
	|	СтруктураПалитрыБезМодификаторов.НомерКатегории,
	|	СтруктураПалитрыБезМодификаторов.НомерКатегорииРазмещения,
	|	СтруктураПалитрыБезМодификаторов.ИндексПозиции,
	|	СтруктураПалитрыБезМодификаторов.ЭтоКатегория,
	|	СтруктураПалитрыБезМодификаторов.ИмеетсяВложенность,
	|	ЛОЖЬ,
	|	3
	|ИЗ
	|	СтруктураПалитрыБезМодификаторов КАК СтруктураПалитрыБезМодификаторов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК ИсточникПлитки,
	|	ИтоговаяСтруктура.НомерСтроки КАК НомерСтроки,
	|	ИтоговаяСтруктура.НомерКатегорииРазмещенияЭлемента КАК НомерКатегорииРазмещенияЭлемента,
	|	ИтоговаяСтруктура.ПорядокВидов КАК ПорядокВидов,
	|	ИтоговаяСтруктура.ИндексПозицииВКатегории КАК ИндексПозицииВКатегории,
	|	ИтоговаяСтруктура.НомерКатегории КАК НомерКатегории,
	|	ИтоговаяСтруктура.ИмеетсяВложенность КАК ИмеетсяВложенность,
	|	ИтоговаяСтруктура.ЭтоКатегория КАК ЭтоКатегория,
	|	ИтоговаяСтруктура.ЭтоТекущаяКатегория КАК ЭтоТекущаяКатегория,
	|	ПалитраТоваровРМКСостав.ИмяЭлемента КАК ИмяЭлемента,
	|	ПалитраТоваровРМКСостав.ВидМодификатора КАК ВидМодификатора,
	|	ПалитраТоваровРМКСостав.Номенклатура КАК Номенклатура,
	|	ПалитраТоваровРМКСостав.Характеристика КАК Характеристика,
	|	ПалитраТоваровРМКСостав.ЦветШрифта КАК ЦветШрифта,
	|	ПалитраТоваровРМКСостав.ЦветФона КАК ЦветФона,
	|	ПалитраТоваровРМКСостав.ИзображениеЭлемента КАК ИзображениеЭлемента,
	|	ПалитраТоваровРМКСостав.Упаковка КАК Упаковка,
	|	ПалитраТоваровРМКСостав.СкрыватьОстаток КАК СкрыватьОстаток,
	|	ПалитраТоваровРМКСостав.КартинкаПоУмолчанию КАК КартинкаПоУмолчанию,
	|	ПалитраТоваровРМКСостав.SKU КАК SKU,
	|	ПалитраТоваровРМКСостав.Весовой КАК Весовой,
	|	ЛОЖЬ КАК ЭтоПодарок
	|ИЗ
	|	ИтоговаяСтруктура КАК ИтоговаяСтруктура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПалитраТоваровРМКСостав КАК ПалитраТоваровРМКСостав
	|		ПО ИтоговаяСтруктура.НомерСтроки = ПалитраТоваровРМКСостав.НомерСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерКатегорииРазмещенияЭлемента,
	|	ПорядокВидов,
	|	ИндексПозицииВКатегории";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ВыделитьНеПопавшиеВПалитруТовары(ТаблицаТоваровПолная, ТаблицаТоваровПалитры)
	
	РезультатФункции = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаТоваровПолная.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваровПолная.Характеристика КАК Характеристика,
	|	ТаблицаТоваровПолная.Весовой КАК Весовой,
	|	ТаблицаТоваровПолная.SKU КАК SKU
	|ПОМЕСТИТЬ втТаблицаТоваровПолная
	|ИЗ
	|	&ТаблицаТоваровПолная КАК ТаблицаТоваровПолная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваровПалитры.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваровПалитры.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ втТаблицаТоваровПалитры
	|ИЗ
	|	&ТаблицаТоваровПалитры КАК ТаблицаТоваровПалитры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваровПолная.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваровПолная.Характеристика КАК Характеристика,
	|	ТаблицаТоваровПолная.Весовой КАК Весовой,
	|	ТаблицаТоваровПолная.SKU КАК SKU
	|ИЗ
	|	втТаблицаТоваровПолная КАК ТаблицаТоваровПолная
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТаблицаТоваровПалитры КАК втТаблицаТоваровПалитры
	|		ПО ТаблицаТоваровПолная.Номенклатура = втТаблицаТоваровПалитры.Номенклатура
	|			И ТаблицаТоваровПолная.Характеристика = втТаблицаТоваровПалитры.Характеристика
	|ГДЕ
	|	втТаблицаТоваровПалитры.Номенклатура ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ТаблицаТоваровПолная", ТаблицаТоваровПолная);
	Запрос.УстановитьПараметр("ТаблицаТоваровПалитры", ТаблицаТоваровПалитры);

	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		РезультатФункции = РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ДобавитьВОпорныеДанныеТоварыНеИзПалитры(Форма,
		ТаблицаТоваров,
		НужнаОтдельнаяГруппа,
		ЦветФона,
		ДополнительныеПараметры = Неопределено)
		
	ОпорныеДанные = Форма.ОпорныеДанные;
	НомерКатагорииГруппы = 0;
	Если НужнаОтдельнаяГруппа Тогда
		ДобавитьГруппуОстальныхТоваровВОпорныеДанные(Форма, ДополнительныеПараметры, НомерКатагорииГруппы);
	КонецЕсли;
	ИдентификаторФормы = Форма.УникальныйИдентификатор;
	
	ЗапросИзображений = Новый Запрос;
	ЗапросИзображений.Текст =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Весовой КАК Весовой,
	|	ТаблицаТоваров.SKU КАК SKU
	|ПОМЕСТИТЬ втТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПалитраТоваровРМКСостав.Номенклатура КАК Номенклатура,
	|	ПалитраТоваровРМКСостав.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ПалитраТоваровРМКСостав.ИзображениеЭлемента) КАК ИзображениеЭлемента
	|ПОМЕСТИТЬ втИзображенияТовара
	|ИЗ
	|	Справочник.ПалитраТоваровРМК.Состав КАК ПалитраТоваровРМКСостав
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втТаблицаТоваров КАК ТаблицаТоваров
	|		ПО ПалитраТоваровРМКСостав.Номенклатура = ТаблицаТоваров.Номенклатура
	|			И ПалитраТоваровРМКСостав.Характеристика = ТаблицаТоваров.Характеристика
	|ГДЕ
	|	НЕ ПалитраТоваровРМКСостав.Ссылка.ПометкаУдаления
	|	И НЕ ПалитраТоваровРМКСостав.ИзображениеЭлемента = ЗНАЧЕНИЕ(Справочник.ПалитраТоваровРМКПрисоединенныеФайлы.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПалитраТоваровРМКСостав.Номенклатура,
	|	ПалитраТоваровРМКСостав.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Характеристика.Наименование КАК ХарактеристикаНаименование,
	|	ТаблицаТоваров.Весовой КАК Весовой,
	|	ТаблицаТоваров.SKU КАК SKU,
	|	ЕСТЬNULL(втИзображенияТовара.ИзображениеЭлемента, ЗНАЧЕНИЕ(Справочник.ПалитраТоваровРМКПрисоединенныеФайлы.ПустаяСсылка)) КАК Изображение
	|ИЗ
	|	втТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ втИзображенияТовара КАК втИзображенияТовара
	|		ПО ТаблицаТоваров.Номенклатура = втИзображенияТовара.Номенклатура
	|			И ТаблицаТоваров.Характеристика = втИзображенияТовара.Характеристика";
	ЗапросИзображений.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	
	ЦветЧерный = ЦветаСтиля.ЦветТекстаПодсказки;
	ИсточникиПлитки = ИнтерфейсРМКСлужебныйКлиентСервер.ИсточникиДанныхДляПлитки();
	ИндексПозицииВКатегории = ?(НужнаОтдельнаяГруппа, 2, 1);
	Выборка = ЗапросИзображений.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаОпорныхДанных = ОпорныеДанные.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОпорныхДанных, Выборка);
		СтрокаОпорныхДанных.НомерКатегории = 0;
		СтрокаОпорныхДанных.ИндексПозицииВКатегории = ИндексПозицииВКатегории;
		СтрокаОпорныхДанных.НомерКатегорииРазмещенияЭлемента = НомерКатагорииГруппы;
		СтрокаОпорныхДанных.ЦветШрифта = ЦветЧерный;
		СтрокаОпорныхДанных.ЦветФона = ЦветФона;
		ИмяХарактеристики = "";
		Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда
			ИмяХарактеристики = СтрШаблон(", %1", Выборка.ХарактеристикаНаименование);
		КонецЕсли;
		ИмяЭлемента = СтрШаблон("%1%2", Выборка.НоменклатураНаименование, ИмяХарактеристики);
		СтрокаОпорныхДанных.ИмяЭлемента = ИмяЭлемента;
		СтрокаОпорныхДанных.ДоступностьКоманды = Истина;
		СтрокаОпорныхДанных.ПервыйИндексПлитки = ОпорныеДанные.Индекс(СтрокаОпорныхДанных);
		СтрокаОпорныхДанных.ИсточникПлитки = ИсточникиПлитки.ВесовойТовар;
		Если ЗначениеЗаполнено(Выборка.Изображение) Тогда
			АдресКартинки = РаботаСФайлами.ДанныеФайла(Выборка.Изображение, ИдентификаторФормы).СсылкаНаДвоичныеДанныеФайла;
			СтрокаОпорныхДанных.АдресИзображения = АдресКартинки;
		КонецЕсли;
		
		ИндексПозицииВКатегории = ИндексПозицииВКатегории + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОбозначениеПалитрыПоУмолчанию()
	
	Возврат НСтр("ru = 'На главную'");
	
КонецФункции

Процедура ДобавитьГруппуОстальныхТоваровВОпорныеДанные(Форма, ДополнительныеПараметры, НомерКатагорииГруппы)
	
	ИсточникиПлитки = ИнтерфейсРМКСлужебныйКлиентСервер.ИсточникиДанныхДляПлитки();
	ОпорныеДанные = Форма.ОпорныеДанные;
	НомерКатагорииГруппы = 1;
	ИндексПозицииВКатегории = 1;
	Если Не ДополнительныеПараметры = Неопределено Тогда
		НомерКатагорииГруппы = ДополнительныеПараметры.МаксимальныйНомерКатегории + 1;
		ИндексПозицииВКатегории = ДополнительныеПараметры.МаксимальныйИндексПозицииВНулевойКатегории + 1;
	КонецЕсли;
	
	ЦветЧерный = ЦветаСтиля.ЦветТекстаПодсказки;
	ИмяГруппыОстальныхТоваров = НСтр("ru = 'Остальные товары'");
	ИмяОбратнойГруппы = НСтр("ru = 'Все весовые товары'");
	ТекущееКоличествоЭлементов = ОпорныеДанные.Количество();

	// Добавление группы
	СтрокаОпорныхДанных = ОпорныеДанные.Добавить();
	СтрокаОпорныхДанных.НомерКатегории = НомерКатагорииГруппы;
	СтрокаОпорныхДанных.ИндексПозицииВКатегории = ИндексПозицииВКатегории;
	СтрокаОпорныхДанных.НомерКатегорииРазмещенияЭлемента = 0;
	СтрокаОпорныхДанных.ЭтоКатегория = Истина;
	СтрокаОпорныхДанных.ЦветШрифта = ЦветЧерный;
	СтрокаОпорныхДанных.ЦветФона = Форма.ЦветаФормы.ПапкаКнопка;
	СтрокаОпорныхДанных.ИмяЭлемента = ИмяГруппыОстальныхТоваров;
	СтрокаОпорныхДанных.ДоступностьКоманды = Истина;
	СтрокаОпорныхДанных.ПервыйИндексПлитки = ТекущееКоличествоЭлементов + 1;
	СтрокаОпорныхДанных.ИмеетсяВложенность = Истина;
	СтрокаОпорныхДанных.ИсточникПлитки = ИсточникиПлитки.ВесовойТовар;
	СтрокаОпорныхДанных.ЭтоТекущаяКатегория = Ложь;
	
	// Добавление обратной группы
	СтрокаОпорныхДанных = ОпорныеДанные.Добавить();
	СтрокаОпорныхДанных.НомерКатегории = 0;
	СтрокаОпорныхДанных.ИндексПозицииВКатегории = 1;
	СтрокаОпорныхДанных.НомерКатегорииРазмещенияЭлемента = НомерКатагорииГруппы;
	СтрокаОпорныхДанных.ЭтоКатегория = Истина;
	СтрокаОпорныхДанных.ЦветШрифта = ЦветЧерный;
	СтрокаОпорныхДанных.ЦветФона = Форма.ЦветаФормы.ПапкаКнопка;
	СтрокаОпорныхДанных.ИмяЭлемента = ИмяОбратнойГруппы;
	СтрокаОпорныхДанных.ДоступностьКоманды = Истина;
	СтрокаОпорныхДанных.ПервыйИндексПлитки = 0;
	СтрокаОпорныхДанных.ИмеетсяВложенность = Истина;
	СтрокаОпорныхДанных.ИсточникПлитки = ИсточникиПлитки.ВесовойТовар;
	СтрокаОпорныхДанных.ЭтоТекущаяКатегория = Истина;
	
КонецПроцедуры

Функция ПолучитьТаблицуТоваровОпорныхДанных(ОпорныеДанные, ДополнительныеПараметры)
	
	ТаблицаТоваров = ОпорныеДанные.Выгрузить(Новый Массив, "Номенклатура,Характеристика");
	Для Каждого СтрокаОпорныхДанных Из ОпорныеДанные Цикл
		Если ЗначениеЗаполнено(СтрокаОпорныхДанных.Номенклатура) Тогда
			НоваяСтрока = ТаблицаТоваров.Добавить();
			НоваяСтрока.Номенклатура = СтрокаОпорныхДанных.Номенклатура;
			НоваяСтрока.Характеристика = СтрокаОпорныхДанных.Характеристика;
		КонецЕсли;
		Если СтрокаОпорныхДанных.НомерКатегории > ДополнительныеПараметры.МаксимальныйНомерКатегории Тогда
			ДополнительныеПараметры.МаксимальныйНомерКатегории = СтрокаОпорныхДанных.НомерКатегории;
		КонецЕсли;
		Если СтрокаОпорныхДанных.ИндексПозицииВКатегории > ДополнительныеПараметры.МаксимальныйИндексПозицииВНулевойКатегории
				И СтрокаОпорныхДанных.НомерКатегорииРазмещенияЭлемента = 0 Тогда
			ДополнительныеПараметры.МаксимальныйИндексПозицииВНулевойКатегории = СтрокаОпорныхДанных.ИндексПозицииВКатегории;
		КонецЕсли;
	КонецЦикла;
	Возврат ТаблицаТоваров;
	
КонецФункции

Процедура ПрименитьИсключенияОбработкиПорядкаОбластей(Форма, ТаблицаПорядка)
	
	УстановитьНастройкиПорядкаОбластейПоУмолчанию(Форма);
	Если Форма.ВертикальнаяОриентация Тогда
		ПрименитьИсключенияОбработкиПорядкаОбластейВертикальнаяОриентация(Форма, ТаблицаПорядка);
	Иначе
		ПрименитьИсключенияОбработкиПорядкаОбластейГоризонтальнаяОриентация(Форма, ТаблицаПорядка);
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьПорядокГоризонтальныхПанелей(ТаблицаПорядка)
	
	ПорядокПанелей = Новый Структура();

	ИмяГруппыШапкиТоваров = "ГруппаИнфо_Горизонтальная";
	ИмяГруппыДанныхЧека = "СтраницыОбластиСоставаЧека_Горизонтальная";
	ИмяГруппыРодителяКоманднойПанели = "ГруппаУправленияЧекомГор_Горизонтальная";
	ИмяРабочейОбласти = "Страницы_Горизонтальная";
	ИмяГруппыИтогиИОплаты = "ПраваяКолонкаУправленияЧеком_Горизонтальная";
	ИмяГруппыИтогов = "ГруппаСуммыТоваров_Горизонтальная";
	ИмяГруппыПереходаКОплате = "ОсновнаяКоманднаяПанельУправленияЧеком_Горизонтальная";
	ИмяГруппыОплатить = "ГруппаКомандКОплате_Горизонтальная";
	
	ПорядокПанелей.Вставить("ПорядокДанныхТовара",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяГруппыДанныхЧека, ИмяГруппыШапкиТоваров));
	ПорядокПанелей.Вставить("ПорядокПанелиУправления",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяРабочейОбласти, ИмяГруппыРодителяКоманднойПанели));
	ПорядокПанелей.Вставить("ПорядокИтогов",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяГруппыИтогиИОплаты, ИмяГруппыИтогов));
	ПорядокПанелей.Вставить("ПорядокКомандыОплаты",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяГруппыПереходаКОплате, ИмяГруппыОплатить));
	
	Возврат ПорядокПанелей;
	
КонецФункции

Процедура ПрименитьИсключенияОбработкиПорядкаОбластейГоризонтальнаяОриентация(Форма, ТаблицаПорядка)
	
	Элементы = Форма.Элементы;
	Элементы.ГруппаЦифроваяПанель.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
	
	ПорядокПанелей = ОпределитьПорядокГоризонтальныхПанелей(ТаблицаПорядка);
	
	Если ПорядокПанелей.ПорядокДанныхТовара > 1 Тогда
		Если ПорядокПанелей.ПорядокИтогов = 1 Тогда
			Элементы.Переместить(Элементы.ПлиткаГруппаИнфо, Элементы.ГруппаЛево, Элементы.ПлиткаГруппаНиз);
		Иначе
			Элементы.Переместить(Элементы.ПлиткаГруппаИнфо, Элементы.ГруппаЛево, Неопределено);
		КонецЕсли;
		Элементы.Переместить(Элементы.ПлиткаИнфоТекущейСтроки, Элементы.ПлиткаГруппаИнфо, Неопределено);
	КонецЕсли;
	Если ПорядокПанелей.ПорядокПанелиУправления = 1 Тогда
		Элементы.Переместить(Элементы.ГруппаРаботаСТоварамиПлитки, Элементы.ПлиткаГруппаДанные, Элементы.ПанельПодбора);
	КонецЕсли;
	
	Если ПорядокПанелей.ПорядокИтогов > 1 Тогда
		Элементы.Переместить(Элементы.ПлиткаГруппаОплатить, Элементы.ГруппаЛево,
			Элементы.НастраиваемаяПанельЛево);
			Если ПорядокПанелей.ПорядокДанныхТовара = 1 Тогда //
				Элементы.Переместить(Элементы.ПлиткаГруппаИнфо, Элементы.ГруппаЛево, Элементы.НастраиваемаяПанельЛево);
			КонецЕсли; //
		Элементы.ГруппаЦифроваяПанель.ВертикальноеПоложениеВГруппе
			= ВертикальноеПоложениеЭлемента.Верх;
		Элементы.ГруппаСлоевОсновнаяКоманднаяПанельУправленияЧеком.ВертикальноеПоложениеПодчиненных
			= ВертикальноеПоложениеЭлемента.Верх;
		Элементы.ГруппаСуммыТоваров.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
		Элементы.ГруппаСуммыТоваров.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Низ;
	КонецЕсли;
	Если ПорядокПанелей.ПорядокКомандыОплаты = 1 Тогда
		Элементы.Переместить(Элементы.ГруппаКомандСозданияЗаказа, Элементы.ГруппаКомандПереходаКОплате,
			Элементы.ГруппаДополнительногоУправленияОплат);
		Если ПорядокПанелей.ПорядокИтогов > 1 Тогда
			Элементы.Переместить(Элементы.ОтсутQRCode, Элементы.ГруппаQRCode, Неопределено);
		Иначе
			Элементы.ОтступГруппыКомандКОплате.Видимость = Истина;
			Элементы.ОтсутQRCode.Видимость = Ложь;
			Элементы.Переместить(Элементы.ОтступГруппыКомандКОплате, Элементы.ГруппаКомандКОплате,
				Элементы.ГруппаВысотыКнопкиПерейтиКОплате);
		КонецЕсли;
	Иначе
		Элементы.Переместить(Элементы.ГруппаКомандСозданияЗаказа, Элементы.ГруппаКомандПереходаКОплате,
			Элементы.ГруппаКомандКОплате);
		Если ПорядокПанелей.ПорядокИтогов > 1 Тогда
			Элементы.ОтступГруппыКомандКОплате.Видимость = Истина;
			Элементы.ОтсутQRCode.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьПорядокВертикальныхПанелей(ТаблицаПорядка)
	
	ПорядокПанелей = Новый Структура();
	
	ИмяКорневойГруппы = "ВертикальнаяОриентация";
	ИмяПанелиОпераций = "ГруппаУправленияСтатическая_Вертикальная";
	ИмяРодителяПанелиИтоговЧека = "ГруппаУправленияЧекомВер_Вертикальная";
	ИмяПанелиИтогоЧека = "ПраваяКолонкаУправленияЧеком_Вертикальная";
	ИмяРабочейОбласти = "Страницы_Вертикальная";
	ИмяГруппыРаботыСТоварами = "СтраницыОбластиСоставаЧека_Вертикальная";
	ИмяГруппыДанныхТовара = "ГруппаИнфо_Вертикальная";
	ИмяГруппыСпискаТоваров = "ПанельТаблицыТоваров_Вертикальная";
	ИмяГруппыПереходаКОплате = "ОсновнаяКоманднаяПанельУправленияЧеком_Вертикальная";
	
	ПорядокПанелей.Вставить("ПорядокОплатить",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяПанелиИтогоЧека, ИмяГруппыПереходаКОплате));
	ПорядокПанелей.Вставить("ПорядокКолонкиУправления",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяРодителяПанелиИтоговЧека, ИмяПанелиИтогоЧека));
	ПорядокПанелей.Вставить("ПорядокГруппыОпераций",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяКорневойГруппы, ИмяПанелиОпераций));
	ПорядокПанелей.Вставить("ПорядокПанелиУправления",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяРабочейОбласти, ИмяРодителяПанелиИтоговЧека));
	ПорядокПанелей.Вставить("ПорядокДанныхТекущегоТовара",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяГруппыРаботыСТоварами, ИмяГруппыДанныхТовара));
	ПорядокПанелей.Вставить("ПорядокСпискаТоваров",
		ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяГруппыРаботыСТоварами, ИмяГруппыСпискаТоваров));
	
	Возврат ПорядокПанелей;
	
КонецФункции

Процедура ПрименитьИсключенияОбработкиПорядкаОбластейВертикальнаяОриентация(Форма, ТаблицаПорядка)
	
	Элементы = Форма.Элементы;
	Элементы.Переместить(Элементы.ПлиткаГруппаИнфо, Элементы.ПлиткаТаблицаТоваровВер, Элементы.НастраиваемаяПанельЛево);
	
	НаправлениеВерх = ВертикальноеПоложениеЭлемента.Верх;
	НаправлениеПраво = ГоризонтальноеПоложениеЭлемента.Право;
	
	ПорядокПанелей = ОпределитьПорядокВертикальныхПанелей(ТаблицаПорядка);
	Если ПорядокПанелей.ПорядокОплатить = 1 Тогда
		Элементы.Переместить(Элементы.ПлиткаГруппаОплатить, Элементы.ПлиткаГруппаНиз,
			Элементы.ПлиткаГруппаИтого);
		Элементы.ГруппаСлоевОсновнаяКоманднаяПанельУправленияЧеком.ВертикальноеПоложениеПодчиненных
			= ВертикальноеПоложениеЭлемента.Верх;
		Элементы.КолонкаБыстрыхОплат.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Верх;
		Элементы.СуммаИтогоПлитка.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
	КонецЕсли;
	
	Если ПорядокПанелей.ПорядокКолонкиУправления = 1 Тогда
		Элементы.ЛеваяСредняяКолонкиУправленияЧеком.ГоризонтальноеПоложениеВГруппе = НаправлениеПраво;
		Элементы.ПраваяКолонкаУправленияЧеком.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
		Элементы.Переместить(Элементы.КолонкаЛояльности, Элементы.ГруппаЛояльностиИБыстрыхОплат, Неопределено);
		
		Элементы.ГруппаСлоевЛеваяВерхняяВспомогательнаяПанель.ГоризонтальноеПоложениеВГруппе
			= ГоризонтальноеПоложениеЭлемента.Право;
		Элементы.Переместить(Элементы.ПлиткаПанельИтоговВер, Элементы.ОболочкаПлиткиВер, Элементы.ПлиткаТаблицаТоваровВер);
	КонецЕсли;
	
	Если ПорядокПанелей.ПорядокДанныхТекущегоТовара > ПорядокПанелей.ПорядокСпискаТоваров Тогда
		Элементы.Переместить(Элементы.ПлиткаГруппаИнфо, Элементы.ПлиткаТаблицаТоваровВер, Неопределено);
		Элементы.Переместить(Элементы.ПлиткаИнфоТекущейСтроки, Элементы.ПлиткаГруппаИнфо, Неопределено);
	КонецЕсли;
	
	Если ПорядокПанелей.ПорядокПанелиУправления = 1 Тогда
		Элементы.Переместить(Элементы.ГруппаРаботаСТоварамиПлитки, Элементы.ПлиткаГруппаДанные, Элементы.ПанельПодбора);
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьПорядокПанелиВГруппе(ТаблицаПорядка, ИмяРодительскойГруппы, ИмяПанели)
	
	РезультатФункции = 0;
	
	ОтборСтрокРодителя = Новый Структура("ОбластьРодитель", ИмяРодительскойГруппы);
	СтрокиГруппы = ТаблицаПорядка.НайтиСтроки(ОтборСтрокРодителя);
	КоличествоСтрок = СтрокиГруппы.Количество();
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоСтрок И РезультатФункции = 0 Цикл
		СтрокаГруппы = СтрокиГруппы[ИндексСтроки];
		Если СтрокаГруппы.Область = ИмяПанели Тогда
			РезультатФункции = СтрокаГруппы.Порядок;
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура УстановитьНастройкиПорядкаОбластейПоУмолчанию(Форма)
	
	Элементы = Форма.Элементы;
	НаправлениеНиз = ВертикальноеПоложениеЭлемента.Низ;
	НаправлениеЛево = ГоризонтальноеПоложениеЭлемента.Лево;
	НаправлениеПраво = ГоризонтальноеПоложениеЭлемента.Право;
	Элементы.ОтступКоманднойПанели.Видимость = Ложь;
	Элементы.СводнаяПанельИтоговЧекаГор.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Авто;
	Элементы.КоманднаяПанельУправленияЧекомГор.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
	Элементы.ЛеваяСредняяКолонкиУправленияЧеком.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Авто;
	Элементы.ПраваяКолонкаУправленияЧеком.ГоризонтальноеПоложениеВГруппе = НаправлениеПраво;
	Элементы.ГруппаСлоевЛеваяВерхняяВспомогательнаяПанель.ГоризонтальноеПоложениеВГруппе
		= ГоризонтальноеПоложениеЭлемента.Авто;
	
	Элементы.Переместить(Элементы.ГруппаРаботаСТоварамиПлитки, Элементы.ПлиткаГруппаДанные, Неопределено);
	Элементы.Переместить(Элементы.ПлиткаГруппаОплатить, Элементы.ПлиткаГруппаНиз, Неопределено);
	Элементы.Переместить(Элементы.ПлиткаПанельИтоговВер, Элементы.ОболочкаПлиткиВер, Неопределено);
	Элементы.Переместить(Элементы.ПлиткаИнфоТекущейСтроки, Элементы.ПлиткаГруппаИнфо, Элементы.ПлиткаГруппаПродавец);
	
	Элементы.ГруппаУправленияОплатамиГор.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
	Элементы.СуммаИтогоПлитка.ВертикальноеПоложениеВГруппе = ?(Форма.ВертикальнаяОриентация,
		ВертикальноеПоложениеЭлемента.Верх, ВертикальноеПоложениеЭлемента.Низ);
	
	Элементы.ГруппаЦифроваяПанель.ВертикальноеПоложениеВГруппе
		= ВертикальноеПоложениеЭлемента.Низ;
	Элементы.ГруппаСлоевОсновнаяКоманднаяПанельУправленияЧеком.ВертикальноеПоложениеПодчиненных
		= ВертикальноеПоложениеЭлемента.Низ;
		
	Элементы.ГруппаСуммыТоваров.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
	Элементы.ГруппаСуммыТоваров.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Верх;
	
	Элементы.Переместить(Элементы.ГруппаКомандСозданияЗаказа, Элементы.ГруппаКомандПереходаКОплате,
		Элементы.ГруппаКомандКОплате);
	Элементы.ОтступГруппыКомандКОплате.Видимость = Ложь;
	Элементы.ОтсутQRCode.Видимость = Не Форма.ВертикальнаяОриентация;
	Элементы.Переместить(Элементы.КолонкаЛояльности, Элементы.ГруппаЛояльностиИБыстрыхОплат,
		Элементы.КолонкаБыстрыхОплат);
	Элементы.КолонкаБыстрыхОплат.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Низ;
	Элементы.Переместить(Элементы.ОтсутQRCode, Элементы.ГруппаQRCode, Элементы.ГруппаQRCodeНаличные);
	Элементы.Переместить(Элементы.ОтступГруппыКомандКОплате, Элементы.ГруппаКомандКОплате, Неопределено);
	
КонецПроцедуры

Функция СформироватьСоставПалитрыСУчетомВложенныхПалитр(Форма)

	ИсточникиДанныхПлитки = ИнтерфейсРМКСлужебныйКлиентСервер.ИсточникиДанныхДляПлитки();
	ПалитраПлитки = Справочники.ПалитраТоваровРМК.ПустаяСсылка();
	МассивПалитр = Новый СписокЗначений;
	ЗаполнитьПараметрыПалитрыДляСКД(Форма, ПалитраПлитки, МассивПалитр);
	
	СхемаИерархииПалитры = Справочники.ПалитраТоваровРМК.ПолучитьМакет("МакетПалитрыСКД");
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаИерархииПалитры.НастройкиПоУмолчанию);

	ПараметрПалитраПлитка = Новый ПараметрКомпоновкиДанных("ПалитраПлитка");
	ПараметрМассивПалитр = Новый ПараметрКомпоновкиДанных("МассивПалитр");
	ПараметрИсточникПалитрыПлитка = Новый ПараметрКомпоновкиДанных("ИсточникПалитрыПлитка");
	ПараметрИсточникПалитрыИзбранное = Новый ПараметрКомпоновкиДанных("ИсточникПалитрыИзбранное");
	
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрПалитраПлитка, ПалитраПлитки);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрМассивПалитр, МассивПалитр);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрИсточникПалитрыПлитка,
		ИсточникиДанныхПлитки.Палитра);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрИсточникПалитрыИзбранное,
		ИсточникиДанныхПлитки.Избранное);
	
	ТекущиеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	ТипГенератораДляКоллекции = Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаИерархииПалитры, ТекущиеНастройки, , , ТипГенератораДляКоллекции);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ДеревоИерархииПалитры = Новый ДеревоЗначений;
	ПроцессорВывода.УстановитьОбъект(ДеревоИерархииПалитры);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат СформироватьЛинейныйИерархическийСоставПалитр(ДеревоИерархииПалитры);
	
КонецФункции

Процедура ОбойтиСтрокиДереваСоставаПалитры(ТаблицаПалитры, СтрокиУровня, ДанныеПреобразования,
		Знач УровеньДерева, ИсточникПалитры)
	
	УровеньДерева = УровеньДерева + 1;
	Для Каждого СтрокаДерева Из СтрокиУровня Цикл
		
		Если УровеньДерева = 1 Тогда
			Если ИсточникПалитры <> СтрокаДерева.ИсточникПалитры Тогда
				Если ИсточникПалитры > 0 Тогда
					ОчиститьДанныеПреобразования(ДанныеПреобразования);
					ДанныеПреобразования = ИнициализироватьДанныеПреобразования();
				КонецЕсли;
				ИсточникПалитры = СтрокаДерева.ИсточникПалитры;
				ДобавитьКорневуюКатегориюВДанныеПреобразования(ДанныеПреобразования, СтрокаДерева.ПалитраВладелец);
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаДерева.ЭтоПалитра Тогда
			ОбойтиСтрокиДереваСоставаПалитры(ТаблицаПалитры, СтрокаДерева.Строки,
				ДанныеПреобразования, УровеньДерева, ИсточникПалитры);
		Иначе
			Если Не (ЗначениеЗаполнено(СтрокаДерева.Номенклатура)
					И ОбщегоНазначенияРМК.ТребуетсяВводХарактеристикиДляНоменклатуры(СтрокаДерева.Номенклатура)
					И (Не ЗначениеЗаполнено(СтрокаДерева.Характеристика))) Тогда
				
				НоваяСтрокаПалитры = ТаблицаПалитры.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаПалитры, СтрокаДерева);
				СкорректироватьДанныеСтрокиСоставаПалитры(НоваяСтрокаПалитры, СтрокаДерева,
					ДанныеПреобразования, ИсточникПалитры);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СкорректироватьДанныеСтрокиСоставаПалитры(СтрокаСоставаПалитры, СтрокаДерева,
		ДанныеПреобразования, ИсточникПалитры)
		
	ДанныеПреобразования.НомерСтроки = ДанныеПреобразования.НомерСтроки + 1;
	
	ДанныеРазмещенияДерева = ПолучитьДанныеРазмещенияСтрокиДерева(СтрокаДерева, ДанныеПреобразования);
	НовыеДанныеРазмещения = ПолучитьНовыеДанныеКатегорииРазмещения(ДанныеПреобразования, ДанныеРазмещенияДерева);
	ПрисвоитьКатегорию = Ложь;
	Если Не НовыеДанныеРазмещения = Неопределено Тогда
		СтрокаСоставаПалитры.НомерКатегорииРазмещения = НовыеДанныеРазмещения.НовыйНомер;
		НовыеДанныеРазмещения.ТекущийИндексВКатегории = НовыеДанныеРазмещения.ТекущийИндексВКатегории + 1;
		СтрокаСоставаПалитры.ИндексПозиции = НовыеДанныеРазмещения.ТекущийИндексВКатегории;
		ПрисвоитьКатегорию = НовыеДанныеРазмещения.ИмеетсяГрупповойМодификатор;
	КонецЕсли;
	СтрокаСоставаПалитры.НомерСтроки = ДанныеПреобразования.НомерСтроки;
	СтрокаСоставаПалитры.ИсточникПалитры = ИсточникПалитры;
	
	Если СтрокаДерева.НомерКатегории > 0 Тогда
		ИмеетсяГрупповойМодификатор = ГруппаИмеетГрупповойМодификатор(СтрокаДерева);
		НовыйНомерКатегории = ЗарегистрироватьНовыйНомерКатегории(ДанныеПреобразования,
			СтрокаДерева, ИмеетсяГрупповойМодификатор);
		СтрокаСоставаПалитры.НомерКатегории = НовыйНомерКатегории;
	ИначеЕсли ПрисвоитьКатегорию И ЗначениеЗаполнено(СтрокаДерева.Номенклатура)
			И Не ЗначениеЗаполнено(СтрокаДерева.ВидМодификатора) Тогда
			
		ДанныеПреобразования.ВыделенныйНомерКатегории = ДанныеПреобразования.ВыделенныйНомерКатегории + 1;
		СтрокаСоставаПалитры.НомерКатегории = ДанныеПреобразования.ВыделенныйНомерКатегории;
		СтрокаСоставаПалитры.ИмеетсяВложенность = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗарегистрироватьНовыйНомерКатегории(ДанныеПреобразования, СтрокаДерева, ИмеетсяГрупповойМодификатор)
	
	НовыйНомерКатегории = 0;
	КатегорииПалитры = ДанныеПреобразования.СоответствиеКатегорий.Получить(СтрокаДерева.ПалитраВладелец);
	Если КатегорииПалитры = Неопределено Тогда
		КатегорииПалитры = Новый Соответствие();
		ДанныеПреобразования.СоответствиеКатегорий.Вставить(СтрокаДерева.ПалитраВладелец, КатегорииПалитры);
	КонецЕсли;
	ДанныеКатегории = КатегорииПалитры.Получить(СтрокаДерева.НомерКатегории);
	Если ДанныеКатегории = Неопределено Тогда
		ДанныеПреобразования.ВыделенныйНомерКатегории = ДанныеПреобразования.ВыделенныйНомерКатегории + 1;
		Если СтрокаДерева.НомерКатегории > 0 Тогда
			ДанныеКатегории = Новый Структура();
			ДанныеКатегории.Вставить("НовыйНомер", ДанныеПреобразования.ВыделенныйНомерКатегории);
			ДанныеКатегории.Вставить("ТекущийИндексВКатегории", 0);
			ДанныеКатегории.Вставить("ИмеетсяГрупповойМодификатор", ИмеетсяГрупповойМодификатор);
			КатегорииПалитры.Вставить(СтрокаДерева.НомерКатегории, ДанныеКатегории);
		КонецЕсли;
		НовыйНомерКатегории = ДанныеПреобразования.ВыделенныйНомерКатегории;
	Иначе
		НовыйНомерКатегории = ДанныеКатегории.НовыйНомер;
	КонецЕсли;
	Возврат НовыйНомерКатегории;
	
КонецФункции

Функция ПолучитьНовыеДанныеКатегорииРазмещения(ДанныеПреобразования, ДанныеРазмещенияДерева)
	
	РезультатФункции = Неопределено;
	
	КатегорииПалитры
		= ДанныеПреобразования.СоответствиеКатегорий.Получить(ДанныеРазмещенияДерева.ПалитраКатегорииРазмещения);
	Если Не КатегорииПалитры = Неопределено Тогда
		РезультатФункции = КатегорииПалитры.Получить(ДанныеРазмещенияДерева.НомерКатегорииРазмещения);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьДанныеРазмещенияСтрокиДерева(СтрокаДерева, ДанныеПреобразования)
	
	РезультатФункции = Новый Структура();
	НомерКатегорииРазмещения = 0;
	ПалитраКатегорииРазмещения = Неопределено;
	ПроверяемаяСтрока = СтрокаДерева;
	Пока НомерКатегорииРазмещения = 0 И Не ПроверяемаяСтрока = Неопределено Цикл
		НомерКатегорииРазмещения = ПроверяемаяСтрока.НомерКатегорииРазмещения;
		Если НомерКатегорииРазмещения > 0 Тогда
			ПалитраКатегорииРазмещения = ПроверяемаяСтрока.ПалитраВладелец;
		КонецЕсли;
		ПроверяемаяСтрока = ПроверяемаяСтрока.Родитель;
	КонецЦикла;
	Если НомерКатегорииРазмещения = 0 Тогда
		ПалитраКатегорииРазмещения = ДанныеПреобразования.ПалитраВладелец;
	КонецЕсли;
	РезультатФункции.Вставить("НомерКатегорииРазмещения", НомерКатегорииРазмещения);
	РезультатФункции.Вставить("ПалитраКатегорииРазмещения", ПалитраКатегорииРазмещения);
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ДобавитьКорневуюКатегориюВДанныеПреобразования(ДанныеПреобразования, ПалитраВладелец)
	
	ДанныеНулевойКатегории = Новый Структура("НовыйНомер,ТекущийИндексВКатегории", 0, 0);
	ДанныеНулевойКатегории.Вставить("ИмеетсяГрупповойМодификатор", Ложь);
	КатегорииПалитры = Новый Соответствие();
	КатегорииПалитры.Вставить(0, ДанныеНулевойКатегории);
	
	ДанныеПреобразования.ПалитраВладелец = ПалитраВладелец;
	ДанныеПреобразования.СоответствиеКатегорий.Вставить(ПалитраВладелец, КатегорииПалитры);
	
КонецПроцедуры

Функция ИнициализироватьДанныеПреобразования()
	
	РезультатФункции = Новый Структура();
	РезультатФункции.Вставить("НомерСтроки", 0);
	РезультатФункции.Вставить("ВыделенныйНомерКатегории", 0);
	РезультатФункции.Вставить("СоответствиеКатегорий", Новый Соответствие());
	РезультатФункции.Вставить("ПалитраВладелец", Справочники.ПалитраТоваровРМК.ПустаяСсылка());
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ОчиститьДанныеПреобразования(ДанныеПреобразования)
	
	Для Каждого КлючЗначение Из ДанныеПреобразования.СоответствиеКатегорий Цикл
		КлючЗначение.Значение.Очистить();
	КонецЦикла;
	ДанныеПреобразования.СоответствиеКатегорий.Очистить();
	
КонецПроцедуры

Функция СформироватьЛинейныйИерархическийСоставПалитр(ДеревоИерархииПалитры)
	
	ДанныеПреобразования = ИнициализироватьДанныеПреобразования();
	УровеньДерева = 0;
	ИсточникПалитры = 0;
	ТаблицаПалитры = ШаблонЛинейногоИерархическогоСоставаПалитр();
	
	ОбойтиСтрокиДереваСоставаПалитры(ТаблицаПалитры,
		ДеревоИерархииПалитры.Строки, ДанныеПреобразования, УровеньДерева, ИсточникПалитры);
	ОчиститьДанныеПреобразования(ДанныеПреобразования);
	Возврат ТаблицаПалитры;
	
КонецФункции

Функция ШаблонЛинейногоИерархическогоСоставаПалитр()
	
	ШаблонСостава = Справочники.ПалитраТоваровРМК.ПустаяСсылка().Состав.ВыгрузитьКолонки();
	ШаблонСостава.Колонки.Удалить("КатегорияРазмещения");
	ШаблонСостава.Колонки.Удалить("Шрифт");
	ШаблонСостава.Колонки.Удалить("ХарактеристикиИспользуются");
	ШаблонСостава.Колонки.Удалить("ЗаголовокЭлемента");
	ШаблонСостава.Колонки.Удалить("Палитра");
	
	ШаблонСостава.Колонки.Добавить("ИсточникПалитры", ОбщегоНазначения.ОписаниеТипаЧисло(2, 0, ДопустимыйЗнак.Неотрицательный));
	
	Возврат ШаблонСостава;
	
КонецФункции

Процедура ЗаполнитьПараметрыПалитрыДляСКД(Форма, ПалитраПлитки, МассивПалитр)
	
	ПалитраИзбранных = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "СтруктураПлиточногоИнтерфейсаПодбора") Тогда
		ПалитраПлитки = Форма.СтруктураПлиточногоИнтерфейсаПодбора;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "СтруктураПлиточногоИнтерфейса") Тогда
		ПалитраПлитки = Форма.СтруктураПлиточногоИнтерфейса;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "НастройкиРМК") Тогда
		ПалитраИзбранных = Форма.НастройкиРМК.СтруктураБыстрыхТоваров;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ТекущаяНастройкаРМК") Тогда
		ПалитраИзбранных = Форма.ТекущаяНастройкаРМК.СтруктураБыстрыхТоваров;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПалитраПлитки) Тогда
		МассивПалитр.Добавить(ПалитраПлитки);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПалитраИзбранных) Тогда
		МассивПалитр.Добавить(ПалитраИзбранных);
	КонецЕсли;
	
КонецПроцедуры

Функция ГруппаИмеетГрупповойМодификатор(СтрокаДерева)

	РезультатФункции = Ложь;
	
	СтрокиУровня = ?(СтрокаДерева.Родитель = Неопределено, СтрокаДерева.Владелец().Строки, СтрокаДерева.Родитель.Строки);
	ОтборПодчиненныхСтрок = Новый Структура("НомерКатегорииРазмещения,ИсточникПалитры",
		СтрокаДерева.НомерКатегории, СтрокаДерева.ИсточникПалитры);
	ПодчиненныеЭлементы = СтрокиУровня.НайтиСтроки(ОтборПодчиненныхСтрок);
	ИндексПодчиненногоЭлемента = 0;
	КоличествоЭлементов = ПодчиненныеЭлементы.Количество();
	Пока ИндексПодчиненногоЭлемента < КоличествоЭлементов И Не РезультатФункции Цикл
		ПодчиненныйЭлемент = ПодчиненныеЭлементы.Получить(ИндексПодчиненногоЭлемента);
		Если ЗначениеЗаполнено(ПодчиненныйЭлемент.ВидМодификатора) Тогда
			РезультатФункции = Истина;
		КонецЕсли;
		ИндексПодчиненногоЭлемента = ИндексПодчиненногоЭлемента + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура НастроитьОтображениеСпискаТоваров(Форма, НаборСвойств)
	
	СвойствоШрифт = Перечисления.СвойстваЭлементовРМК.ШрифтКнопок;
	СвойствоПереносить = Перечисления.СвойстваЭлементовРМК.ПереноситьТекст;
	СвойствоШиринаТовара = Перечисления.СвойстваЭлементовРМК.ШиринаКнопок;
	СвойствоШиринаСуммы = Перечисления.СвойстваЭлементовРМК.ВысотаКнопок;
	
	ЗначениеШрифта = НаборСвойств.Получить(СвойствоШрифт);
	Если Не ЗначениеШрифта = Неопределено Тогда
		Форма.Элементы.Товары.Шрифт = ЗначениеШрифта;
		Форма.Элементы.ТоварыСумма.Шрифт = ЗначениеШрифта;
	КонецЕсли;
	ЗначениеПереносить = НаборСвойств.Получить(СвойствоПереносить);
	Если ЗначениеПереносить = Истина Тогда
		Форма.Элементы.ТоварыПредставлениеНоменклатураХарактеристика.АвтоВысотаЯчейки = Истина;
	КонецЕсли;
	ЗначениеШириныТовара = НаборСвойств.Получить(СвойствоШиринаТовара);
	ЗначениеШириныСуммы = НаборСвойств.Получить(СвойствоШиринаСуммы);
	Если ЗначениеЗаполнено(ЗначениеШириныТовара) Тогда
		Форма.Элементы.ТоварыПредставлениеНоменклатураХарактеристика.Ширина = ЗначениеШириныТовара;
	КонецЕсли;
	ПределШирины = 6;
	Если ЗначениеЗаполнено(ЗначениеШириныСуммы) Тогда
		Форма.Элементы.ТоварыЦена.Ширина = ЗначениеШириныСуммы - ?(ЗначениеШириныСуммы > ПределШирины, 2, 0);
		Форма.Элементы.ТоварыСуммаСкидокОбщая.Ширина = ЗначениеШириныСуммы - ?(ЗначениеШириныСуммы > ПределШирины, 2, 0);
		Форма.Элементы.ТоварыСумма.Ширина = ЗначениеШириныСуммы;
		Форма.Элементы.ТоварыМиниСписокКоличество.Ширина = ЗначениеШириныСуммы - ?(ЗначениеШириныСуммы > ПределШирины, 3, 0);
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьПрименитьПоложениеЧасов(Форма, ПоложениеЧасов, НаборСвойств)
	
	Если ПоложениеЧасов = "" Тогда
		СвойствоПоложениеЧасов = Перечисления.СвойстваЭлементовРМК.ПоложениеЧасов;
		ЗначениеПоложения = НаборСвойств.Получить(СвойствоПоложениеЧасов);
		Если Не ЗначениеПоложения = Неопределено Тогда
			ПоложениеЛево = НСтр("ru = 'Лево'");
			ПоложениеПраво = НСтр("ru = 'Право'");
			Элементы = Форма.Элементы;
			
			ПоложениеЧасов = ЗначениеПоложения;
			Если ПоложениеЧасов = ПоложениеЛево Тогда
				Элементы.Переместить(Элементы.ПодгруппаЧасы, Элементы.ГруппаОперации,
					Элементы.ОткрытьПлиточныйИнтерфейсКаталога);
				Элементы.ПодгруппаЧасы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
			ИначеЕсли ПоложениеЧасов = ПоложениеПраво Тогда
				Элементы.Переместить(Элементы.ПодгруппаЧасы,
					Элементы.ГруппаОперации, Элементы.ЗакрытьПлиточныйИнтерфейс);
				Элементы.ПодгруппаЧасы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

