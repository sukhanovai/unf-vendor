Процедура ЗаполнитьСтраницуГруппыИзбранного(Форма, СтраницаГруппы, ИндексКнопки,
		СочетаниеКлавиш, ПараметрыПостроения)
		
	БезРамки = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки);
	СКартинкой = ПараметрыПостроения.ЕстьКартинка;
	СуффиксИмени = ?(СКартинкой, "Картинка", "");
	ЭлементыФормы = Форма.Элементы;
	ИндексДанных = ИндексКнопки - 1;
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	
	Если СКартинкой Тогда
		ИмяЭлемента = СтрШаблон("ИзображениеИзбранногоГруппа_%1", ИндексКнопки);
		ИзображениеИзбранного = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), СтраницаГруппы);
		ИзображениеИзбранного.Вид = ВидПоляФормы.ПолеКартинки;
		ИзображениеИзбранного.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ИзображениеИзбранного.Рамка = БезРамки;
		ИзображениеИзбранного.ПутьКДанным = СтрШаблон("ДанныеКнопок[%1].АдресИзображения", ИндексДанных);
		ИзображениеИзбранного.РазмерКартинки = РазмерКартинки.АвтоРазмер;
		ИзображениеИзбранного.Ширина = ?(ЭтоИнтерфейс85, 7, 6);
		ИзображениеИзбранного.Высота = 1;
		ИзображениеИзбранного.АвтоМаксимальнаяВысота = Истина;
		ИзображениеИзбранного.АвтоМаксимальнаяШирина = Ложь;
		ИзображениеИзбранного.МаксимальнаяШирина = 7;
		ИзображениеИзбранного.РастягиватьПоВертикали = Истина;
		ИзображениеИзбранного.РастягиватьПоГоризонтали = Ложь;
	КонецЕсли;
	
	ИмяЭлемента = СтрШаблон("НаименованиеГруппыИзбранного%1_%2", СуффиксИмени, ИндексКнопки);
	ПолеНаименование = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), СтраницаГруппы);
	ПолеНаименование.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеНаименование.ПутьКДанным = СтрШаблон("ДанныеКнопок[%1].ИмяЭлемента", ИндексДанных);
	ПолеНаименование.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеНаименование.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	ПолеНаименование.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
	ПолеНаименование.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Центр;
	ПолеНаименование.Высота = 3;
	ПолеНаименование.АвтоМаксимальнаяШирина = Ложь;
	ПолеНаименование.АвтоМаксимальнаяВысота = Ложь;
	ПолеНаименование.МаксимальнаяВысота = 2;
	ПолеНаименование.РастягиватьПоГоризонтали = Истина;
	ПолеНаименование.Шрифт = ПараметрыПостроения.БазовыйШрифт;
	
	ИмяЭлемента = СтрШаблон("ПраваяКолонкаГруппыИзбранного%1_%2", СуффиксИмени, ИндексКнопки);
	КолонкаГруппы = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), СтраницаГруппы);
	КолонкаГруппы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	КолонкаГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КолонкаГруппы.ОтображатьЗаголовок = Ложь;
	КолонкаГруппы.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	КолонкаГруппы.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	КолонкаГруппы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
	КолонкаГруппы.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Право;
	КолонкаГруппы.РастягиватьПоВертикали = Истина;
	КолонкаГруппы.РастягиватьПоГоризонтали = Ложь;
	
	Если Не СочетаниеКлавиш = Неопределено Тогда
		
		ИмяЭлемента = СтрШаблон("ИзбранноеГруппаНомерКлавиши%1_%2", СуффиксИмени, ИндексКнопки);
		
		ГруппаНомерКлавиши = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), КолонкаГруппы);
		ГруппаНомерКлавиши.Вид = ВидДекорацииФормы.Надпись;
		ГруппаНомерКлавиши.Шрифт = ШрифтыСтиля.ЗаголовокПятогоУровня;
		ГруппаНомерКлавиши.Заголовок = Строка(ИндексКнопки);
		ГруппаНомерКлавиши.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
		
	КонецЕсли;
	
	ИмяЭлемента = СтрШаблон("ИзбранноеСтатусаГруппы%1_%2", СуффиксИмени, ИндексКнопки);
	КартинкаСтатуса = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), КолонкаГруппы);
	КартинкаСтатуса.Вид = ВидДекорацииФормы.Картинка;
	КартинкаСтатуса.Ширина = 2;
	КартинкаСтатуса.РастягиватьПоВертикали = Ложь;
	КартинкаСтатуса.РастягиватьПоГоризонтали = Ложь;
	КартинкаСтатуса.Картинка = БиблиотекаКартинок.РМКНаУровеньВниз;
	КартинкаСтатуса.РазмерКартинки = РазмерКартинки.Пропорционально;
	КартинкаСтатуса.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;
	
КонецПроцедуры

