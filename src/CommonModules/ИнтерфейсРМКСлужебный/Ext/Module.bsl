Функция ПолучитьТиповыеАвтоЗначенияСвойствНастроекЭлементов()
	
	ЦветАвто = Новый Цвет();
	ЦветАвтоСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ЦветАвто);
	ШрифтАвто = Новый Шрифт();
	ШрифтАвтоСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ШрифтАвто);
	
	ТиповыеАвтоЗначения = Новый Структура();
	ТиповыеАвтоЗначения.Вставить("ЦветАвто", ЦветАвтоСтрокой);
	ТиповыеАвтоЗначения.Вставить("ШрифтАвто", ШрифтАвтоСтрокой);
	ТиповыеАвтоЗначения.Вставить("ФигураАвто", НСтр("ru = 'Авто'"));
	ТиповыеАвтоЗначения.Вставить("ВыравниваниеАвто", НСтр("ru = 'Авто'"));
	ТиповыеАвтоЗначения.Вставить("ПоложениеЧасовНет", НСтр("ru = 'Нет'"));
	
	Возврат ТиповыеАвтоЗначения;
	
КонецФункции

Процедура ДобавитьНастройкиОбластиОплатить(ТаблицаНастроек, ИмяОбласти, ТиповыеАвтоЗначения,
		МаксимальнаяВысотаКнопки, МаксимальнаяШиринаКнопок)
	
	СвойствоВысотаКнопок = Перечисления.СвойстваЭлементовРМК.ВысотаКнопок;
	СвойствоШиринаКнопок = Перечисления.СвойстваЭлементовРМК.ШиринаКнопок;
	СвойствоЦветКнопок = Перечисления.СвойстваЭлементовРМК.ЦветКнопок;
	СвойствоФигураКнопок = Перечисления.СвойстваЭлементовРМК.ФигураКнопок;
	
	ЗначенияВысотыКнопок = Новый Структура();
	ЗначенияВысотыКнопок.Вставить("ЗначениеПоУмолчанию", 0);
	ЗначенияВысотыКнопок.Вставить("МаксимальноеЗначение", МаксимальнаяВысотаКнопки);
	
	ЗначенияШириныКнопок = Новый Структура();
	ЗначенияШириныКнопок.Вставить("ЗначениеПоУмолчанию", 0);
	ЗначенияШириныКнопок.Вставить("МаксимальноеЗначение", МаксимальнаяШиринаКнопок);
	
	ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоВысотаКнопок, ЗначенияВысотыКнопок);
	ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоШиринаКнопок, ЗначенияШириныКнопок);
	ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоЦветКнопок, ТиповыеАвтоЗначения.ЦветАвто);
	Если Не ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85() Тогда
		ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоФигураКнопок, ТиповыеАвтоЗначения.ФигураАвто);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьНастройкиОбластиПанельОпераций(ТаблицаНастроек, ТиповыеАвтоЗначения)
	
	ЗаголовкиОбластей = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьЗаголовкиОбластейДляНастроек();
	ИмяОбласти = ЗаголовкиОбластей.ОбластьПанельОпераций;
	ОбластиПрименения = ОбластиПримененияНастроекПанели();
	
	СвойствоРазмерКнопок = Перечисления.СвойстваЭлементовРМК.РазмерКнопок;
	СвойствоВысотаКнопок = Перечисления.СвойстваЭлементовРМК.ВысотаКнопок;
	СвойствоШиринаКнопок = Перечисления.СвойстваЭлементовРМК.ШиринаКнопок;
	СвойствоЦветКнопок = Перечисления.СвойстваЭлементовРМК.ЦветКнопок;
	СвойствоПоложениеЧасов = Перечисления.СвойстваЭлементовРМК.ПоложениеЧасов;
	СвойствоОбластьПрименения = Перечисления.СвойстваЭлементовРМК.ОбластьПрименения;
	СвойствоПоказыватьСтатусСмены = Перечисления.СвойстваЭлементовРМК.ПоказыватьСтатусСмены;
	
	Если ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85() Тогда
		
		ЗначенияРазмераКнопок = Новый Структура();
		ЗначенияРазмераКнопок.Вставить("ЗначениеПоУмолчанию", 0);
		ЗначенияРазмераКнопок.Вставить("МаксимальноеЗначение", 4);
		
		ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоРазмерКнопок, ЗначенияРазмераКнопок);
		
	Иначе
		
		ЗначенияВысотыКнопок = Новый Структура();
		ЗначенияВысотыКнопок.Вставить("ЗначениеПоУмолчанию", 0);
		ЗначенияВысотыКнопок.Вставить("МаксимальноеЗначение", 8);
		
		ЗначенияШириныКнопок = Новый Структура();
		ЗначенияШириныКнопок.Вставить("ЗначениеПоУмолчанию", 0);
		ЗначенияШириныКнопок.Вставить("МаксимальноеЗначение", 28);
	
		ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоВысотаКнопок, ЗначенияВысотыКнопок);
		ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоШиринаКнопок, ЗначенияШириныКнопок);
		
	КонецЕсли;
	ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоЦветКнопок, ТиповыеАвтоЗначения.ЦветАвто);
	ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоПоложениеЧасов,
		ТиповыеАвтоЗначения.ПоложениеЧасовНет);
	ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоПоказыватьСтатусСмены, Ложь);
	ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоОбластьПрименения,
		ОбластиПрименения.ОбычныйИнтерфейс);
	
КонецПроцедуры

Функция ДобавитьСтрокуНастроекЭлементов(ТаблицаНастроек, СвойствоЭлементов, ЗначениеПоУмолчанию)
	
	НоваяСтрока = ТаблицаНастроек.Добавить();
	НоваяСтрока.СвойствоЭлементов = СвойствоЭлементов;
	НоваяСтрока.ЗначениеСвойства = ЗначениеПоУмолчанию;
	
	Возврат НоваяСтрока;
	
КонецФункции

Процедура ДобавитьМаксимальноеЗначениеНастройкиЭлемента(ТаблицаНастроек,
		ИмяЭлемента, СвойствоЭлементов, МаксимальноеЗначение)
	
	НоваяСтрока = ТаблицаНастроек.Добавить();
	НоваяСтрока.ИмяЭлемента = ИмяЭлемента;
	НоваяСтрока.СвойствоЭлементов = СвойствоЭлементов;
	НоваяСтрока.МаксимальноеЗначение = МаксимальноеЗначение;
	
КонецПроцедуры

Процедура ДобавитьСтрокуНастроекОбластей(ТаблицаНастроек, ИмяОбласти, СвойствоОбласти, ЗначениеСвойства)
	
	НоваяСтрока = ТаблицаНастроек.Добавить();
	НоваяСтрока.ЗаголовокОбласти = ИмяОбласти;
	НоваяСтрока.СвойствоЭлементовОбласти = СвойствоОбласти;
	Если ТипЗнч(ЗначениеСвойства) = Тип("Структура") Тогда
		НоваяСтрока.ЗначениеСвойства = ЗначениеСвойства.ЗначениеПоУмолчанию;
		НоваяСтрока.МаксимальноеЗначение = ЗначениеСвойства.МаксимальноеЗначение;
	Иначе
		НоваяСтрока.ЗначениеСвойства = ЗначениеСвойства;
	КонецЕсли;
	
КонецПроцедуры

Процедура СброситьПодсказкиЭлементовВРежимеКСО(ЭлементыФормы)
	
	ЭлементыДляОбработки = Новый Массив;
	
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ВвестиДанныеПокупателя);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ВернутьсяВРежимПодбораТовара);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.НайтиПромокод);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ОплатаБонусами);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ОплатаКартой);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ОплатаСБП);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ОплатаЮКасса);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ОпровергнутьВозраст);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ОткрытьПлиточныйИнтерфейсКаталога);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ОтменаВводаПромокода);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ОтменаРасчетаСкидок);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ОтменитьВсеОплаты);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ПерейтиВОплату);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ПерейтиКОплате);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ПрименитьПромокод);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.ПродолжитьРаботуСЧеком);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.РассчитатьСкидки);
	ЭлементыДляОбработки.Добавить(ЭлементыФормы.УдалитьЧек);
	
	Для Каждого ЭлементФормыКСО Из ЭлементыДляОбработки Цикл
		ЭлементФормыКСО.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКартинкуСтатусаКассовыхСмен(СтатусСмен)
	
	КартинкиСтатусов = Новый Соответствие;
	ГрупповыеСтатусы = ИнтерфейсРМКСлужебныйКлиентСервер.ГрупповыеСтатусыКассовыхСмен();
	КартинкиСтатусов.Вставить(ГрупповыеСтатусы.СменыАктуальны, БиблиотекаКартинок.РМКЗеленыйКруг);
	КартинкиСтатусов.Вставить(ГрупповыеСтатусы.СменыАктуальныЧастично, БиблиотекаКартинок.РМККрасноЗеленыйКруг);
	КартинкиСтатусов.Вставить(ГрупповыеСтатусы.ТребуетсяОткрытиеСмен, БиблиотекаКартинок.РМККрасныйКруг);
	
	Возврат КартинкиСтатусов.Получить(СтатусСмен);
	
КонецФункции

Процедура ПеренестиЗначенияСвойствВНабор(НаборПриемник, НаборИсточник)
	
	Для Каждого СтрокаСвойства Из НаборИсточник Цикл
		НаборПриемник.Вставить(СтрокаСвойства.Ключ, СтрокаСвойства.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция ОбластиПримененияНастроекПанели()
	
	ОбластиПрименения = Новый Структура();
	ОбластиПрименения.Вставить("ОбычныйИнтерфейс", 0);
	ОбластиПрименения.Вставить("ПлиточныйИнтерфейс", 1);
	ОбластиПрименения.Вставить("Везде", 2);
	
	Возврат ОбластиПрименения;
	
КонецФункции

Функция ПолучитьСтрокиСоставаПалитрыБезСвязи(СоставПалитры, ПроверяемыеКатегории = Неопределено)
	
	МассивСтрокСостава = Новый Массив;
	
	КоличествоСтрок = СоставПалитры.Количество();
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоСтрок Цикл
		ИндексТекущейСтроки = КоличествоСтрок - ИндексСтроки - 1;
		СтрокаСостава = СоставПалитры.Получить(ИндексТекущейСтроки);
		
		Если СтрокаСостава.ЭтоКатегория И (ПроверяемыеКатегории = Неопределено
				Или Не ПроверяемыеКатегории.Найти(СтрокаСостава.НомерКатегории) = Неопределено) Тогда
				
			ОтборДетей = Новый Структура("НомерКатегорииРазмещения", СтрокаСостава.НомерКатегории);
			ДетиГруппы = СоставПалитры.НайтиСтроки(ОтборДетей);
			Если ДетиГруппы.Количество() = 0 Тогда
				МассивСтрокСостава.Добавить(СтрокаСостава);
			КонецЕсли;
			
		ИначеЕсли ПроверяемыеКатегории = Неопределено И ЗначениеЗаполнено(СтрокаСостава.ВидМодификатора)
				И СтрокаСостава.НомерКатегорииРазмещения > 0 Тогда
			
			ОтборРодителей = Новый Структура("НомерКатегории", СтрокаСостава.НомерКатегорииРазмещения);
			РодителиМодификатора = СоставПалитры.НайтиСтроки(ОтборРодителей);
			Если РодителиМодификатора.Количество() = 0 Тогда
				МассивСтрокСостава.Добавить(СтрокаСостава);
			КонецЕсли;
			
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Возврат МассивСтрокСостава;
	
КонецФункции

Процедура ДобавитьСтрокиУровняДерева(Форма, ИсходныеСтроки, СтрокиПриемника, Знач ТекущийУровень, ГруппировкаУровня)
	
	ТипыГруппировок = ИнтерфейсРМКСлужебныйКлиентСервер.ТипыГруппировок();
	ВозможныеСостоянияНастроек = ИнтерфейсРМКСлужебныйКлиентСервер.ВозможныеСостоянияНастроек();
	
	КолонкаШирина = "Ширина";
	КолонкаВысота = "Высота";
	КолонкаШиринаВПроцентах = "ШиринаВПроцентах";
	КолонкаВысотаВПроцентах = "ВысотаВПроцентах";
	МаксимальныйПроцент = 100;
	ШиринаГруппы = ПолучитьОбщуюШиринуГруппы(ИсходныеСтроки, ГруппировкаУровня);
	ВысотаГруппы = ПолучитьОбщуюВысотуГруппы(ИсходныеСтроки, ГруппировкаУровня);
	ОбщееЗначениеРазмера = ?(ГруппировкаУровня = ТипыГруппировок.Вертикальная, ВысотаГруппы, ШиринаГруппы);
	Если ТекущийУровень = 1 Тогда
		Форма.ШиринаСхемыРМК = ШиринаГруппы;
		Форма.ВысотаСхемыРМК = ВысотаГруппы;
	КонецЕсли;
	
	ИмяКолонкиРаспределения = ?(ГруппировкаУровня = ТипыГруппировок.Вертикальная, КолонкаВысота, КолонкаШирина);
	ИмяКолонкиРаспределенияВПроцентах
		= ?(ГруппировкаУровня = ТипыГруппировок.Вертикальная, КолонкаВысотаВПроцентах, КолонкаШиринаВПроцентах);
	
	НаименьшийРазмер = 0;
	НаибольшийРазмер = 0;
	МинимальнаяСтрока = Неопределено;
	МаксимальнаяСтрока = Неопределено;
	РазницаОкругления = 100;
	
	Для Каждого СтрокаИсточника Из ИсходныеСтроки Цикл
		
		ПроцентРазмераДробный = 100 * СтрокаИсточника[ИмяКолонкиРаспределения] / ОбщееЗначениеРазмера;
		ПроцентРазмера = Окр(ПроцентРазмераДробный, 1, РежимОкругления.Окр15как20);
		
		НоваяСтрока = СтрокиПриемника.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточника);
		НоваяСтрока.ИсходныйПорядок = СтрокиПриемника.Индекс(НоваяСтрока) + 1;
		
		Если СтрокаИсточника.ДоступностьГруппы Тогда
			НоваяСтрока.ШиринаВПроцентах = ?(ГруппировкаУровня = ТипыГруппировок.Вертикальная,
				МаксимальныйПроцент, ПроцентРазмера);
			НоваяСтрока.ВысотаВПроцентах = ?(ГруппировкаУровня = ТипыГруппировок.Вертикальная,
				ПроцентРазмера, МаксимальныйПроцент);
			
			Если НаименьшийРазмер = 0 Или СтрокаИсточника[ИмяКолонкиРаспределения] < НаименьшийРазмер Тогда
				НаименьшийРазмер = СтрокаИсточника[ИмяКолонкиРаспределения];
				МинимальнаяСтрока = НоваяСтрока;
			КонецЕсли;
			Если СтрокаИсточника[ИмяКолонкиРаспределения] > НаибольшийРазмер Тогда
				НаибольшийРазмер = СтрокаИсточника[ИмяКолонкиРаспределения];
				МаксимальнаяСтрока = НоваяСтрока;
			КонецЕсли;
			РазницаОкругления = РазницаОкругления - ПроцентРазмера;
			
			ДобавитьСтрокиУровняДерева(Форма, СтрокаИсточника.Строки, НоваяСтрока.ПолучитьЭлементы(), ТекущийУровень + 1,
				СтрокаИсточника.Группировка);
		Иначе
			НоваяСтрока.ШиринаВПроцентах = 0;
			НоваяСтрока.ВысотаВПроцентах = 0;
		КонецЕсли;
		НоваяСтрока.СостояниеНастроек = ПолучитьИндексСостоянияНастроекОбласти(Форма, СтрокаИсточника.ЗаголовокОбласти);
		
	КонецЦикла;
	
	Если РазницаОкругления <> 100 И РазницаОкругления <> 0 Тогда
		Если РазницаОкругления > 0 И Не МинимальнаяСтрока = Неопределено Тогда
			МинимальнаяСтрока[ИмяКолонкиРаспределенияВПроцентах]
				= МинимальнаяСтрока[ИмяКолонкиРаспределенияВПроцентах] + РазницаОкругления;
		ИначеЕсли РазницаОкругления < 0 И Не МаксимальнаяСтрока = Неопределено Тогда
			МаксимальнаяСтрока[ИмяКолонкиРаспределенияВПроцентах]
				= МаксимальнаяСтрока[ИмяКолонкиРаспределенияВПроцентах] + РазницаОкругления;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрименитьСохраненныйПорядокОбластей(Форма)
	
	МодельОбластейРМК = Форма.МодельОбластейРМК;
	КорневаяГруппа = ?(Форма.ГоризонтальнаяОриентация,
		МодельОбластейРМК.ГоризонтальнаяОриентация, МодельОбластейРМК.ВертикальнаяОриентация);
	ПрименитьСохраненныйПорядокДляУровня(Форма, КорневаяГруппа.Имя, Форма.ДеревоОбластейФормыРМК.ПолучитьЭлементы());
	
КонецПроцедуры

Процедура ПрименитьСохраненныйПорядокДляУровня(Форма, ИмяРодителя, СтрокиУровня)
	
	Для Каждого СтрокаДерева Из СтрокиУровня Цикл
		Если СтрокаДерева.ПолучитьЭлементы().Количество() > 0 Тогда
			ПрименитьСохраненныйПорядокДляУровня(Форма, СтрокаДерева.ИмяОбласти, СтрокаДерева.ПолучитьЭлементы());
		КонецЕсли;
	КонецЦикла;
	ПрименитьСохраненныйПорядокДляПодчиненныхСтрокУровня(Форма, ИмяРодителя, СтрокиУровня);
	
КонецПроцедуры

Процедура ПрименитьСохраненныйПорядокДляПодчиненныхСтрокУровня(Форма, ИмяРодителя, СтрокиУровня)
	
	ОтборСтрок = Новый Структура("ОбластьРодитель,ВертикальнаяОриентация",
		ИмяРодителя, (Не Форма.ГоризонтальнаяОриентация));
	СтрокиПорядка = Форма.ПорядокОбластей.НайтиСтроки(ОтборСтрок);
	Для Каждого СтрокаПорядка Из СтрокиПорядка Цикл
		ИндексОбластиВДереве = -1;
		СтрокаОбластиВДереве = ПолучитьСтрокуДереваОбластиПоИмени(СтрокиУровня, СтрокаПорядка.Область, ИндексОбластиВДереве);
		ВПределахГраницы = (СтрокаПорядка.Порядок > 0 И СтрокаПорядка.Порядок <= СтрокиУровня.Количество());
		Если (Не СтрокаОбластиВДереве = Неопределено) И СтрокаПорядка.Порядок <> ИндексОбластиВДереве + 1
				И ВПределахГраницы Тогда
			СтрокиУровня.Сдвинуть(ИндексОбластиВДереве, СтрокаПорядка.Порядок - ИндексОбластиВДереве - 1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОбщуюШиринуГруппы(ИсходныеСтроки, ГруппировкаУровня)
	
	ТипыГруппировок = ИнтерфейсРМКСлужебныйКлиентСервер.ТипыГруппировок();
	
	РезультатФункции = 0;
	Если ИсходныеСтроки.Количество() > 0 Тогда
		Если ГруппировкаУровня = ТипыГруппировок.Вертикальная Тогда
			РезультатФункции = ИсходныеСтроки[0].Ширина;
		Иначе
			Для Каждого СтрокаОбласти Из ИсходныеСтроки Цикл
				Если СтрокаОбласти.ДоступностьГруппы Тогда
					РезультатФункции = РезультатФункции + СтрокаОбласти.Ширина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если РезультатФункции = 0 Тогда
		РезультатФункции = 1;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьОбщуюВысотуГруппы(ИсходныеСтроки, ГруппировкаУровня)
	
	ТипыГруппировок = ИнтерфейсРМКСлужебныйКлиентСервер.ТипыГруппировок();
	
	РезультатФункции = 0;
	Если ИсходныеСтроки.Количество() > 0 Тогда
		Если ГруппировкаУровня = ТипыГруппировок.Вертикальная Тогда
			Для Каждого СтрокаОбласти Из ИсходныеСтроки Цикл
				Если СтрокаОбласти.ДоступностьГруппы Тогда
					РезультатФункции = РезультатФункции + СтрокаОбласти.Высота;
				КонецЕсли;
			КонецЦикла;
		Иначе
			РезультатФункции = ИсходныеСтроки[0].Высота;
		КонецЕсли;
	КонецЕсли;
	Если РезультатФункции = 0 Тогда
		РезультатФункции = 1;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьСтрокуДереваОбластиПоИмени(СтрокиУровня, ИмяОбласти, ИндексОбластиВДереве)
	
	РезультатФункции = Неопределено;
	
	КоличествоСтрок = СтрокиУровня.Количество();
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоСтрок И РезультатФункции = Неопределено Цикл
		СтрокаОбласти = СтрокиУровня.Получить(ИндексСтроки);
		Если СтрокаОбласти.ИмяОбласти = ИмяОбласти Тогда
			РезультатФункции = СтрокаОбласти;
			ИндексОбластиВДереве = ИндексСтроки;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьИндексСостоянияНастроекОбласти(Форма, ЗаголовокОбласти)
	Перем СценарийИспользования;
	
	ВозможныеСостоянияНастроек = ИнтерфейсРМКСлужебныйКлиентСервер.ВозможныеСостоянияНастроек();
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ВлияющиеПараметры") Тогда
		СценарийИспользования = Форма.ВлияющиеПараметры.СценарийИспользования;
	Иначе
		СценарийИспользования = Форма.НастройкиРМК.СценарийИспользования;
	КонецЕсли;
	ОтборСтрокНастроек = Новый Структура();
	ОтборСтрокНастроек.Вставить("ЗаголовокОбласти", ЗаголовокОбласти);
	СтрокиНастроекФормы = Форма.НастройкиОбластейФормыРМК.НайтиСтроки(ОтборСтрокНастроек);
	ИндексСтроки = 0;
	РезультатФункции = ВозможныеСостоянияНастроек.НеИмеетНастроек;
	
	Пока ИндексСтроки < СтрокиНастроекФормы.Количество()
				И Не РезультатФункции = ВозможныеСостоянияНастроек.НастройкиИзменены Цикл
		СтрокаНастройки = СтрокиНастроекФормы[ИндексСтроки];
		ЗаголовокОбласти = СтрокаНастройки.ЗаголовокОбласти;
		Если ИнтерфейсРМКСлужебныйКлиентСервер.НастройкаОбластиСоответствуетСценариюИспользования(ЗаголовокОбласти,
				СтрокаНастройки.СвойствоЭлементовОбласти, СценарийИспользования) Тогда
			Если Не СтрокаНастройки.ЗначениеСвойства = СтрокаНастройки.ЗначениеПоУмолчанию Тогда
				РезультатФункции = ВозможныеСостоянияНастроек.НастройкиИзменены;
			ИначеЕсли РезультатФункции = ВозможныеСостоянияНастроек.НеИмеетНастроек Тогда
				РезультатФункции = ВозможныеСостоянияНастроек.НастройкиПоУмолчанию;
			КонецЕсли;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьБазовыеНастройкиЭлементовРМК()
	
	СвойствоШиринаКнопок = Перечисления.СвойстваЭлементовРМК.ШиринаКнопок;
	СвойствоЦветКнопок = Перечисления.СвойстваЭлементовРМК.ЦветКнопок;
	
	ТиповыеАвтоЗначения = ПолучитьТиповыеАвтоЗначенияСвойствНастроекЭлементов();
	ТаблицаНастроек = Справочники.НастройкиРабочегоМестаКассира.ПустаяСсылка().НастройкиЭлементов.ВыгрузитьКолонки();
	ТаблицаНастроек.Колонки.Удалить("ИмяЭлемента");
	ДобавитьСтрокуНастроекЭлементов(ТаблицаНастроек, СвойствоШиринаКнопок, 0);
	ДобавитьСтрокуНастроекЭлементов(ТаблицаНастроек, СвойствоЦветКнопок, ТиповыеАвтоЗначения.ЦветАвто);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Процедура ДобавитьПараметрНастройки(ПараметрыНастроек, ИмяПараметра, ЗначениеПараметра)
	
	Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		ПараметрыНастроек.Вставить(ИмяПараметра, ЗначениеПараметра);
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПанельУправленияТекущимТоваромКСО(Форма, НастройкиЭлементов)
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	ЭлементыФормы = Форма.Элементы;
	ЭлементыФормы.ГруппаРучнаяСкидка.Видимость = Ложь;
	
	ЗаголовкиОбластей = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьЗаголовкиОбластейДляНастроек();
	НаборСвойствПанели = НастройкиЭлементов.Получить(ЗаголовкиОбластей.ОбластьДанныеТекущегоТовара);
	СвойствоЦветКнопок = Перечисления.СвойстваЭлементовРМК.ЦветКнопок;
	СвойствоРазмер = Перечисления.СвойстваЭлементовРМК.РазмерКнопок;
	СвойствоРазмерВПлитке = Перечисления.СвойстваЭлементовРМК.РазмерКнопокПлиточныйИнтерфейс;
	
	ЗначениеРазмера = 0;
	ЗначениеРазмераВПлитке = 0;
	
	ПараметрыНастроек = Новый Структура();
	ПараметрыНастроек.Вставить("БазовыйРазмер", 14);
	ПараметрыНастроек.Вставить("ЗначениеЦвета", ?(ЭтоИнтерфейс85, Неопределено, WebЦвета.Бежевый));
	
	Если Не НаборСвойствПанели = Неопределено Тогда
		Если ЗначениеЗаполнено(НаборСвойствПанели.Получить(СвойствоРазмер)) Тогда
			ЗначениеРазмера = НаборСвойствПанели.Получить(СвойствоРазмер);
		КонецЕсли;
		Если ЗначениеЗаполнено(НаборСвойствПанели.Получить(СвойствоРазмерВПлитке)) Тогда
			ЗначениеРазмераВПлитке = НаборСвойствПанели.Получить(СвойствоРазмерВПлитке);
		КонецЕсли;
		ДобавитьПараметрНастройки(ПараметрыНастроек, "ЗначениеЦвета", НаборСвойствПанели.Получить(СвойствоЦветКнопок));
	КонецЕсли;
	
	ПриведенныйРазмер = ПараметрыНастроек.БазовыйРазмер + 2 * ЗначениеРазмера - 2;
	ПриведенныйРазмерВПлитке = (ПараметрыНастроек.БазовыйРазмер + 1) + 2 * ЗначениеРазмераВПлитке;
	ВысотаГруппы = 3 + ЗначениеРазмера;
	ВысотаГруппыВПлитке = ?(ЭтоИнтерфейс85, 5, 5) + ЗначениеРазмераВПлитке;
	
	ПараметрыНастроек.Вставить("ПриведенныйРазмер", ПриведенныйРазмер);
	ПараметрыНастроек.Вставить("ПриведенныйРазмерВПлитке", ПриведенныйРазмерВПлитке);
	ПараметрыНастроек.Вставить("ВысотаГруппы", ВысотаГруппы);
	ПараметрыНастроек.Вставить("ВысотаГруппыВПлитке", ВысотаГруппыВПлитке);
	
	СформироватьПанельТекущегоТовараСпискаКСО(Форма, ПараметрыНастроек);
	ПараметрыНастроек.БазовыйРазмер = 15;
	СформироватьПанельТекущегоТовараПлиточногоИнтерфейсаКСО(Форма, ПараметрыНастроек);
	
КонецПроцедуры

Процедура СформироватьПанельОперацийКСО(Форма, НастройкиЭлементов)
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	ЭлементыФормы = Форма.Элементы;
	ЭлементыФормы.ГруппаУправления.Видимость = Ложь;
	ЗаголовкиОбластей = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьЗаголовкиОбластейДляНастроек();
	НаборСвойствПанели = НастройкиЭлементов.Получить(ЗаголовкиОбластей.ОбластьПанельОпераций);
	СвойствоШирина = Перечисления.СвойстваЭлементовРМК.ШиринаКнопок;
	СвойствоВысота = Перечисления.СвойстваЭлементовРМК.ВысотаКнопок;
	СвойствоЦветКнопок = Перечисления.СвойстваЭлементовРМК.ЦветКнопок;
	СвойствоПоложениеЧасов = Перечисления.СвойстваЭлементовРМК.ПоложениеЧасов;
	СвойствоРазмер = Перечисления.СвойстваЭлементовРМК.РазмерКнопок;
	
	ЗначениеШирины = 0;
	ЗначениеВысоты = 0;
	ЗначениеРазмера = 0;
	ПараметрыНастроек = Новый Структура();
	ПараметрыНастроек.Вставить("БазоваяШирина", 15);
	ПараметрыНастроек.Вставить("ЗначениеЦвета", ?(ЭтоИнтерфейс85, Неопределено, WebЦвета.Бежевый));
	ПараметрыНастроек.Вставить("ЗначениеПоложенияЧасов", Неопределено);
	
	Если Не НаборСвойствПанели = Неопределено Тогда
		Если ЗначениеЗаполнено(НаборСвойствПанели.Получить(СвойствоШирина)) Тогда
			ЗначениеШирины = НаборСвойствПанели.Получить(СвойствоШирина);
		КонецЕсли;
		Если ЗначениеЗаполнено(НаборСвойствПанели.Получить(СвойствоВысота)) Тогда
			ЗначениеВысоты = НаборСвойствПанели.Получить(СвойствоВысота);
		КонецЕсли;
		Если ЗначениеЗаполнено(НаборСвойствПанели.Получить(СвойствоРазмер)) Тогда
			ЗначениеРазмера = НаборСвойствПанели.Получить(СвойствоРазмер);
		КонецЕсли;
		ДобавитьПараметрНастройки(ПараметрыНастроек, "ЗначениеЦвета", НаборСвойствПанели.Получить(СвойствоЦветКнопок));
		ДобавитьПараметрНастройки(ПараметрыНастроек, "ЗначениеПоложенияЧасов",
			НаборСвойствПанели.Получить(СвойствоПоложениеЧасов));
	КонецЕсли;
	
	ШиринаТакси = ?(ЗначениеЗаполнено(ЗначениеШирины), ЗначениеШирины, ПараметрыНастроек.БазоваяШирина);
	ШиринаКарточки = ?(ЭтоИнтерфейс85, ПараметрыНастроек.БазоваяШирина + 2 * ЗначениеРазмера, ШиринаТакси);
	ВысотаТакси = ?(ЗначениеЗаполнено(ЗначениеВысоты), ЗначениеВысоты, 5);
	ВысотаГруппы = ?(ЭтоИнтерфейс85, 5 + ЗначениеРазмера, ВысотаТакси);
	ПараметрыНастроек.Вставить("ВысотаГруппы", ВысотаГруппы);
	ПараметрыНастроек.Вставить("ШиринаКарточки", ШиринаКарточки);
	
	СформироватьПанельОперацийСпискаКСО(Форма, ПараметрыНастроек);
	СформироватьПанельОперацийПлиточногоИнтерфейсаКСО(Форма, ПараметрыНастроек);
	ЭлементыФормы.ГруппаУправленияПлиточныйИнтерфейс.Видимость = Ложь;
	ЭлементыФормы.ГруппаУправленияКСО.Видимость = Истина;
	
	ПараметрыНастроек.БазоваяШирина = 20;
	ПараметрыНастроек.ШиринаКарточки = Цел(1.33 * ПараметрыНастроек.ШиринаКарточки);
	
	НастроитьНижнююПанельКСО(Форма, ПараметрыНастроек);
	НастроитьПанельЗавершенияОплатыКСО(Форма, ПараметрыНастроек);
	
КонецПроцедуры

Функция ШаблонДанныхКнопкиПанелиОперацийКСО()
	
	ДанныеКнопки = Новый Структура();
	ДанныеКнопки.Вставить("Имя", "");
	ДанныеКнопки.Вставить("ИмяДействия", "");
	ДанныеКнопки.Вставить("Положение", Неопределено);
	ДанныеКнопки.Вставить("Картинка", Неопределено);
	ДанныеКнопки.Вставить("Заголовок", "");
	ДанныеКнопки.Вставить("ВысотаЗаголовка", 0);
	
	Возврат ДанныеКнопки;
	
КонецФункции

Функция ШаблонДанныхПоляПанелиКСО()
	
	ДанныеКнопки = Новый Структура();
	ДанныеКнопки.Вставить("Имя", "");
	ДанныеКнопки.Вставить("Редактирование", Ложь);
	ДанныеКнопки.Вставить("ПутьКДанным", "");
	ДанныеКнопки.Вставить("Формат", "");
	
	Возврат ДанныеКнопки;
	
КонецФункции

Функция ПолучитьПриведенныйРазмер(ПараметрыНастроек, ИспользоватьПлиточныеРазмеры)
	
	РезультатФункции = ?(ИспользоватьПлиточныеРазмеры, ПараметрыНастроек.ПриведенныйРазмерВПлитке,
		ПараметрыНастроек.ПриведенныйРазмер);
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьМасштабШрифтаКартинки(ПараметрыНастроек, ИспользоватьПлиточныеРазмеры = Ложь)
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	БазовыйМасштаб = 120;
	БазоваяШирина = ?(ПараметрыНастроек.Свойство("БазовыйРазмер"),
		ПараметрыНастроек.БазовыйРазмер, ПараметрыНастроек.БазоваяШирина);
	ШиринаКарточки = ?(ПараметрыНастроек.Свойство("ШиринаКарточки"),
		ПараметрыНастроек.ШиринаКарточки, ПолучитьПриведенныйРазмер(ПараметрыНастроек, ИспользоватьПлиточныеРазмеры));
	
	Если ШиринаКарточки <= БазоваяШирина И Не ЭтоИнтерфейс85 Тогда
		МасштабШрифтаКартинки = БазовыйМасштаб;
	Иначе
		МасштабШрифтаКартинки
			= Цел(БазовыйМасштаб * Pow(ШиринаКарточки / БазоваяШирина, 2));
	КонецЕсли;
	
	Возврат МасштабШрифтаКартинки;
	
КонецФункции

Функция ПолучитьМасштабШрифтаКартинкиОплаты(ВысотаКнопкиОплаты)
	
	РезультатФункции = 120;
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	БазоваяВысота = 5;
	
	Если ВысотаКнопкиОплаты > БазоваяВысота Или ЭтоИнтерфейс85 Тогда
		РезультатФункции = Цел(РезультатФункции * Pow(ВысотаКнопкиОплаты / БазоваяВысота, 2));
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ДобавитьПолеВГруппуУправления(Форма, ГруппаУправления, ДанныеПоля, ПараметрыНастроек)
	
	ЭлементыФормы = Форма.Элементы;
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	
	МасштабШрифта = Цел(?(ЭтоИнтерфейс85, 100, 120)
		* Pow(ПараметрыНастроек.ПриведенныйРазмер / (ПараметрыНастроек.БазовыйРазмер - 1), 2));
	Если ЭтоИнтерфейс85 Тогда
	
		ИмяЭлемента = СтрШаблон("Группа%1КСО", ДанныеПоля.Имя);
		КарточкаПоля = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаУправления);
		КарточкаПоля.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		КарточкаПоля.Отображение = ОтображениеОбычнойГруппы.Нет;
		КарточкаПоля.ОтображатьЗаголовок = Ложь;
		КарточкаПоля.ОтображатьКакКарточку = Истина;
		КарточкаПоля.Гиперссылка = ДанныеПоля.Редактирование;
		КарточкаПоля.ЦветФона = ЦветаПалитры.Серый;
	
		Если ДанныеПоля.Редактирование Тогда
			ИмяСобытия = СтрШаблон("Подключаемый_Группа%1КСОНажатие", ДанныеПоля.Имя);
			КарточкаПоля.УстановитьДействие("Нажатие", ИмяСобытия);
		КонецЕсли;
	
		ИмяЭлемента = СтрШаблон("%1КСО", ДанныеПоля.Имя);
		ПолеДанных = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), КарточкаПоля);
		ПолеДанных.Вид = ВидПоляФормы.ПолеНадписи;
		ПолеДанных.АвтоМаксимальнаяШирина = Ложь;
		ПолеДанных.МаксимальнаяШирина = ПараметрыНастроек.ПриведенныйРазмер;
		ПолеДанных.ИспользоватьКопирование = Ложь;
		ПолеДанных.РастягиватьПоГоризонтали = Истина;
		Если ЗначениеЗаполнено(ДанныеПоля.Формат) Тогда
			ПолеДанных.Формат = ДанныеПоля.Формат;
		КонецЕсли;
		ПолеДанных.ЦветФона = WebЦвета.Белый;
		
	Иначе
		
		ИмяЭлемента = СтрШаблон("%1КСО", ДанныеПоля.Имя);
		ПолеДанных = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаУправления);
		ПолеДанных.Вид = ВидПоляФормы.ПолеВвода;
		ПолеДанных.КнопкаВыбора = Ложь;
		ПолеДанных.АвтоМаксимальнаяШирина = Ложь;
		ПолеДанных.Ширина = ПараметрыНастроек.БазовыйРазмер
			+ 2 * (ПараметрыНастроек.ПриведенныйРазмер - ПараметрыНастроек.БазовыйРазмер + 2);
			
		Если ДанныеПоля.Редактирование Тогда
			ИмяСобытияПриИзменении = СтрШаблон("Подключаемый_%1КСОПриИзменении", ДанныеПоля.Имя);
			ПолеДанных.УстановитьДействие("ПриИзменении", ИмяСобытияПриИзменении);
			
			ИмяСобытияНачалоВыбора = СтрШаблон("Подключаемый_%1КСОНачалоВыбора", ДанныеПоля.Имя);
			ПолеДанных.УстановитьДействие("НачалоВыбора", ИмяСобытияНачалоВыбора);
			
			ИмяСобытияАвтоПодбор = СтрШаблон("Подключаемый_%1КСОАвтоПодбор", ДанныеПоля.Имя);
			ПолеДанных.УстановитьДействие("АвтоПодбор", ИмяСобытияАвтоПодбор);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеПоля.Формат) Тогда
			ПолеДанных.ФорматРедактирования = ДанныеПоля.Формат;
		КонецЕсли;
		
	КонецЕсли;
	ПолеДанных.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеДанных.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
	ПолеДанных.ПутьКДанным = ДанныеПоля.ПутьКДанным;
	ПолеДанных.РастягиватьПоВертикали = Истина;
	ПолеДанных.Шрифт = Новый Шрифт(ШрифтыСтиля.ЗаголовокВторогоУровня, , , , , , , МасштабШрифта);
	ПолеДанных.ТолькоПросмотр = Не ДанныеПоля.Редактирование;
	
КонецФункции

Функция ДобавитьТекстовуюКнопкуВГруппуУправления(Форма, ГруппаУправления, ДанныеКнопки, ПараметрыНастроек,
		ИспользоватьПлиточныеРазмеры = Ложь)
		
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	ЭлементыФормы = Форма.Элементы;
	ИмяДействия = СтрШаблон("Подключаемый_Кнопка%1КСОНажатие", ДанныеКнопки.Имя);
	
	ИмяЭлемента = СтрШаблон("Кнопка%1КСО", ДанныеКнопки.Имя);
	КнопкаКарточка = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаУправления);
	КнопкаКарточка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	КнопкаКарточка.Отображение = ОтображениеОбычнойГруппы.Нет;
	КнопкаКарточка.ОтображатьЗаголовок = Ложь;
	КнопкаКарточка.ОтображатьКакКарточку = Истина;
	КнопкаКарточка.Гиперссылка = Истина;
	Если Не ДанныеКнопки.Положение = Неопределено Тогда
		КнопкаКарточка.ГоризонтальноеПоложениеВГруппе = ДанныеКнопки.Положение;
	КонецЕсли;
	КнопкаКарточка.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Центр;
	КнопкаКарточка.РастягиватьПоГоризонтали = Ложь;
	КнопкаКарточка.РастягиватьПоВертикали = Истина;
	Если Не ПараметрыНастроек.ЗначениеЦвета = Неопределено Тогда
		КнопкаКарточка.ЦветФона = ПараметрыНастроек.ЗначениеЦвета;
	КонецЕсли;
	КнопкаКарточка.УстановитьДействие("Нажатие", ИмяДействия);
	
	ПриведенныйРазмер = ?(ИспользоватьПлиточныеРазмеры, ПараметрыНастроек.ПриведенныйРазмерВПлитке,
		ПараметрыНастроек.ПриведенныйРазмер);
	МасштабШрифта = Цел(?(ЭтоИнтерфейс85, 100, 120) * Pow(ПриведенныйРазмер / (ПараметрыНастроек.БазовыйРазмер - 2), 2));
	
	ИмяЭлемента = СтрШаблон("ЗаголовокКнопки%1КСО", ДанныеКнопки.Имя);
	ЗаголовокКнопки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), КнопкаКарточка);
	ЗаголовокКнопки.Вид = ВидДекорацииФормы.Надпись;
	ЗаголовокКнопки.Шрифт = Новый Шрифт(ШрифтыСтиля.ЗаголовокВторогоУровня, , , , , , , МасштабШрифта);
	ЗаголовокКнопки.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.РастягиватьПоГоризонтали = Истина;
	ЗаголовокКнопки.Заголовок = ДанныеКнопки.Заголовок;
	Если ЗначениеЗаполнено(ДанныеКнопки.ВысотаЗаголовка) Тогда
		ЗаголовокКнопки.Высота = ДанныеКнопки.ВысотаЗаголовка;
		ЗаголовокКнопки.ВысотаЗаголовка = ДанныеКнопки.ВысотаЗаголовка;
	КонецЕсли;
	
	Возврат КнопкаКарточка;
	
КонецФункции

Процедура ДобавитьКнопкуВГруппуУправления(Форма, ГруппаУправления, ДанныеКнопки, ПараметрыНастроек)
	
	ЭлементыФормы = Форма.Элементы;
	ИмяДействия = СтрШаблон("Подключаемый_Кнопка%1КСОНажатие", ДанныеКнопки.Имя);
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	
	ИмяЭлемента = СтрШаблон("Кнопка%1КСО", ДанныеКнопки.Имя);
	КнопкаКарточка = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаУправления);
	КнопкаКарточка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	КнопкаКарточка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	КнопкаКарточка.Отображение = ОтображениеОбычнойГруппы.Нет;
	КнопкаКарточка.ОтображатьЗаголовок = Ложь;
	КнопкаКарточка.ОтображатьКакКарточку = Истина;
	КнопкаКарточка.Гиперссылка = Истина;
	КнопкаКарточка.Ширина = ПараметрыНастроек.ШиринаКарточки;
	КнопкаКарточка.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	Если Не ДанныеКнопки.Положение = Неопределено Тогда
		КнопкаКарточка.ГоризонтальноеПоложениеВГруппе = ДанныеКнопки.Положение;
	КонецЕсли;
	КнопкаКарточка.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Центр;
	КнопкаКарточка.РастягиватьПоГоризонтали = Ложь;
	КнопкаКарточка.РастягиватьПоВертикали = Истина;
	Если Не ПараметрыНастроек.ЗначениеЦвета = Неопределено Тогда
		КнопкаКарточка.ЦветФона = ПараметрыНастроек.ЗначениеЦвета;
	КонецЕсли;
	КнопкаКарточка.УстановитьДействие("Нажатие", ИмяДействия);

	МасштабШрифтаКартинки = ПолучитьМасштабШрифтаКартинки(ПараметрыНастроек);
	МасштабШрифтаЗаголовка = Цел(?(ЭтоИнтерфейс85, 90, 100)
		* ПараметрыНастроек.ШиринаКарточки / ПараметрыНастроек.БазоваяШирина);
	
	ИмяЭлемента = СтрШаблон("ИконкаКнопки%1КСО", ДанныеКнопки.Имя);
	ИконкаКнопки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), КнопкаКарточка);
	ИконкаКнопки.Вид = ВидДекорацииФормы.Картинка;
	ИконкаКнопки.Картинка = ДанныеКнопки.Картинка;
	ИконкаКнопки.Шрифт = Новый Шрифт(ШрифтыСтиля.ЗаголовокПервогоУровня, , , , , , , МасштабШрифтаКартинки);
	ИконкаКнопки.РазмерКартинки = РазмерКартинки.ПоРазмеруШрифта;
	ИконкаКнопки.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	ИконкаКнопки.РастягиватьПоВертикали = Ложь;
	
	ИмяЭлемента = СтрШаблон("ЗаголовокКнопки%1КСО", ДанныеКнопки.Имя);
	ЗаголовокКнопки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), КнопкаКарточка);
	ЗаголовокКнопки.Вид = ВидДекорацииФормы.Надпись;
	ЗаголовокКнопки.Шрифт = Новый Шрифт(ШрифтыСтиля.ЗаголовокВторогоУровня, , , , , , , МасштабШрифтаЗаголовка);
	ЗаголовокКнопки.МаксимальнаяШирина = ПараметрыНастроек.ШиринаКарточки;
	ЗаголовокКнопки.АвтомаксимальнаяШирина = Ложь;
	ЗаголовокКнопки.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.РастягиватьПоГоризонтали = Истина;
	ЗаголовокКнопки.Заголовок = ДанныеКнопки.Заголовок;
	Если ЗначениеЗаполнено(ДанныеКнопки.ВысотаЗаголовка) Тогда
		ЗаголовокКнопки.Высота = ДанныеКнопки.ВысотаЗаголовка;
		ЗаголовокКнопки.ВысотаЗаголовка = ДанныеКнопки.ВысотаЗаголовка;
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьКнопкуНавигацииВГруппуУправления(Форма, ГруппаУправления, ДанныеКнопки, ПараметрыНастроек,
		ИспользоватьПлиточныеРазмеры = Ложь)
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	ЭлементыФормы = Форма.Элементы;
	ИмяДействия = "";
	Если ЗначениеЗаполнено(ДанныеКнопки.ИмяДействия) Тогда
		ИмяДействия = ДанныеКнопки.ИмяДействия;
	Иначе
		ИмяДействия = СтрШаблон("Подключаемый_Кнопка%1КСОНажатие", ДанныеКнопки.Имя);
	КонецЕсли;
	
	ИмяЭлемента = СтрШаблон("Кнопка%1КСО", ДанныеКнопки.Имя);
	КнопкаКарточка = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаУправления);
	КнопкаКарточка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	КнопкаКарточка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	КнопкаКарточка.Отображение = ОтображениеОбычнойГруппы.Нет;
	КнопкаКарточка.ОтображатьЗаголовок = Ложь;
	КнопкаКарточка.ОтображатьКакКарточку = Истина;
	КнопкаКарточка.Гиперссылка = Истина;
	Если Не ДанныеКнопки.Положение = Неопределено Тогда
		КнопкаКарточка.ГоризонтальноеПоложениеВГруппе = ДанныеКнопки.Положение;
	КонецЕсли;
	Если Не ПараметрыНастроек.ЗначениеЦвета = Неопределено Тогда
		КнопкаКарточка.ЦветФона = ПараметрыНастроек.ЗначениеЦвета;
	КонецЕсли;
	КнопкаКарточка.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Центр;
	КнопкаКарточка.УстановитьДействие("Нажатие", ИмяДействия);
	
	МасштабШрифтаКартинки = ПолучитьМасштабШрифтаКартинки(ПараметрыНастроек, ИспользоватьПлиточныеРазмеры);
	
	ИмяЭлемента = СтрШаблон("ИконкаКнопки%1КСО", ДанныеКнопки.Имя);
	ИконкаКнопки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), КнопкаКарточка);
	ИконкаКнопки.Вид = ВидДекорацииФормы.Картинка;
	ИконкаКнопки.Картинка = ДанныеКнопки.Картинка;
	ИконкаКнопки.Шрифт = Новый Шрифт(ШрифтыСтиля.ЗаголовокПервогоУровня, , , , , , , МасштабШрифтаКартинки);
	ИконкаКнопки.РазмерКартинки = РазмерКартинки.ПоРазмеруШрифта;
	ИконкаКнопки.РастягиватьПоВертикали = Истина;
	ИконкаКнопки.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	Если ЗначениеЗаполнено(ГруппаУправления.Высота) Тогда
		КнопкаКарточка.Ширина = Цел(ГруппаУправления.Высота * 1.7);
	КонецЕсли;
	
	Возврат КнопкаКарточка;
	
КонецФункции

Процедура ДобавитьКнопкуВесовогоОтбораКСО(Форма, ГруппаУправления, ПараметрыНастроек)
	
	ЭлементыФормы = Форма.Элементы;
	
	ИмяЭлемента = "ГруппаКнопкиВесовойОтборКСО";
	ГруппаКнопкиВесовойОтборКСО = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаУправления);
	ГруппаКнопкиВесовойОтборКСО.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКнопкиВесовойОтборКСО.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаКнопкиВесовойОтборКСО.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаКнопкиВесовойОтборКСО.ОтображатьЗаголовок = Ложь;
	ГруппаКнопкиВесовойОтборКСО.РастягиватьПоВертикали = Истина;
	Если Форма.ВертикальнаяОриентация Тогда
		ГруппаКнопкиВесовойОтборКСО.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
	КонецЕсли;
	
	Если Не Форма.ВертикальнаяОриентация Тогда
		
		ИмяЭлемента = "ДекорацияОтступВесовойКСО";
		ДекорацияОтступ = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ГруппаКнопкиВесовойОтборКСО);
		ДекорацияОтступ.Вид = ВидДекорацииФормы.Надпись;
		ДекорацияОтступ.Заголовок = " ";
		ДекорацияОтступ.Ширина = 2;
		ДекорацияОтступ.РастягиватьПоГоризонтали = Ложь;
		
	КонецЕсли;
	
	ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
	ДанныеКнопки.Вставить("Имя", "ВесовойОтбор");
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКФильтрВесовой);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Весовой'"));
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаКнопкиВесовойОтборКСО, ДанныеКнопки, ПараметрыНастроек);
	
КонецПроцедуры

Процедура ПодключитьЧасыНаПанельОперацийКСО(Форма, ГруппаУправления, ЗначениеПоложенияЧасов, ПанельПлитки = Ложь)
	
	Если ЗначениеПоложенияЧасов = "Лево" Или ЗначениеПоложенияЧасов = "Центр" Или ЗначениеПоложенияЧасов = "Право" Тогда
		
		ЭлементыФормы = Форма.Элементы;
		ЧастьИмени = ?(ПанельПлитки, "Плитка", "");
		
		ИмяПодгруппы = СтрШаблон("ПодгруппаЧасы%1КСО", ЧастьИмени);
		ПодгруппаЧасы = ЭлементыФормы.Добавить(ИмяПодгруппы, Тип("ГруппаФормы"), ГруппаУправления);
		ПодгруппаЧасы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ПодгруппаЧасы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		ПодгруппаЧасы.Отображение = ОтображениеОбычнойГруппы.Нет;
		ПодгруппаЧасы.ОтображатьЗаголовок = Ложь;
		ПодгруппаЧасы.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
		ПодгруппаЧасы.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
		ПодгруппаЧасы.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
		ПодгруппаЧасы.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Центр;
		ПодгруппаЧасы.РастягиватьПоВертикали = Истина;
		
		СледующийЭлемент = Неопределено;
		Если ЗначениеПоложенияЧасов = "Центр" Тогда
			
			ИмяЭлемента = СтрШаблон("ДекорацияСлеваЧасы%1КСО", ЧастьИмени);
			ДекорацияСлева = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ПодгруппаЧасы);
			ДекорацияСлева.Вид = ВидДекорацииФормы.Надпись;
			ДекорацияСлева.Заголовок = " ";
			ДекорацияСлева.Ширина = 2;
			ДекорацияСлева.АвтоМаксимальнаяШирина = Ложь;
			ДекорацияСлева.РастягиватьПоГоризонтали = Истина;
			
			ИмяЭлемента = СтрШаблон("ДекорацияСправаЧасы%1КСО", ЧастьИмени);
			ДекорацияСправа = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ПодгруппаЧасы);
			ДекорацияСправа.Вид = ВидДекорацииФормы.Надпись;
			ДекорацияСправа.Заголовок = " ";
			ДекорацияСправа.Ширина = 2;
			ДекорацияСправа.АвтоМаксимальнаяШирина = Ложь;
			ДекорацияСправа.РастягиватьПоГоризонтали = Истина;
			
			СледующийЭлемент = ДекорацияСправа;
			ЭлементПослеЧасов = ?(ПанельПлитки, ЭлементыФормы.КнопкаПомощьСотрудникаВПлиткеКСО,
				ЭлементыФормы.КнопкаПомощьСотрудникаКСО);
			ЭлементыФормы.Переместить(ПодгруппаЧасы, ГруппаУправления, ЭлементПослеЧасов);
			
		ИначеЕсли ЗначениеПоложенияЧасов = "Лево" Тогда
			
			ПодгруппаЧасы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
			ЭлементПослеЧасов = ?(ПанельПлитки, ЭлементыФормы.КнопкаКСпискуКСО, ЭлементыФормы.КнопкаКаталогКСО);
			ЭлементыФормы.Переместить(ПодгруппаЧасы, ГруппаУправления, ЭлементПослеЧасов);
			
		Иначе
			
			ПодгруппаЧасы.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
			
		КонецЕсли;
		Если ПанельПлитки Тогда
			
			ИмяЭлемента = "КартинкаЧасыВПлиткеКСО";
			КартинкаЧасыКСО = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ПодгруппаЧасы);
			КартинкаЧасыКСО.Вид = ВидДекорацииФормы.Картинка;
			КартинкаЧасыКСО.Картинка = БиблиотекаКартинок.РМКЧасы;
			КартинкаЧасыКСО.РазмерКартинки = РазмерКартинки.РеальныйРазмер;
			
			ИмяЭлемента = "ПолеЧасовВПлиткеКСО";
			ПолеЧасов = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ПодгруппаЧасы);
			ПолеЧасов.Вид = ВидПоляФормы.ПолеHTMLДокумента;
			ПолеЧасов.Высота = 1;
			ПолеЧасов.Ширина = 8;
			ПолеЧасов.РастягиватьПоВертикали = Истина;
			ПолеЧасов.РастягиватьПоГоризонтали = Ложь;
			ПолеЧасов.ПутьКДанным = "КодЧасов";
			ПолеЧасов.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
			ПолеЧасов.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки, 0);
			ПолеЧасов.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
			ПолеЧасов.ЦветРамки = ЦветаСтиля.ЦветФонаФормы;
			ПолеЧасов.ТолькоПросмотр = Истина;
			
			Если ЗначениеПоложенияЧасов = "Центр" Тогда
				ЭлементыФормы.Переместить(ДекорацияСправа, ПодгруппаЧасы, Неопределено);
			КонецЕсли;
			
		Иначе
			ЭлементыФормы.Переместить(ЭлементыФормы.КартинкаЧасы, ПодгруппаЧасы, СледующийЭлемент);
			ЭлементыФормы.Переместить(ЭлементыФормы.ПолеЧасов, ПодгруппаЧасы, СледующийЭлемент);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПанельОперацийСпискаКСО(Форма, ПараметрыНастроек)
	
	ЭлементыФормы = Форма.Элементы;
	ГруппаУправленияКСО = ЭлементыФормы.ГруппаУправленияКСО;
	
	ИмяЭлемента = "ГруппаУправленияСписок";
	ГруппаУправленияСписок = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаУправленияКСО);
	ГруппаУправленияСписок.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаУправленияСписок.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаУправленияСписок.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаУправленияСписок.ОтображатьЗаголовок = Ложь;
	ГруппаУправленияСписок.Высота = ПараметрыНастроек.ВысотаГруппы;
	ГруппаУправленияСписок.РастягиватьПоГоризонтали = Истина;
	ГруппаУправленияСписок.РастягиватьПоВертикали = Ложь;
	ГруппаУправленияСписок.ВертикальнаяПрокруткаПриСжатии = Ложь;
	
	КартинкаКаталог = ?(ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85(), БиблиотекаКартинок.РМККарточки,
		БиблиотекаКартинок.РМКЭлементПалитрыВложеннаяПалитра);
	ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
	ДанныеКнопки.Вставить("Имя", "Каталог");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
	ДанныеКнопки.Вставить("Картинка", КартинкаКаталог);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Каталог'"));
	ДанныеКнопки.Вставить("ВысотаЗаголовка", 0);
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаУправленияСписок, ДанныеКнопки, ПараметрыНастроек);
	
	ДанныеКнопки.Вставить("Имя", "ВвестиШтрихкод");
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКСозданиеШтрихкода);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Ввести штрихкод'"));
	ДанныеКнопки.Вставить("ВысотаЗаголовка", 2);
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаУправленияСписок, ДанныеКнопки, ПараметрыНастроек);
	
	ДанныеКнопки.Вставить("Имя", "ПомощьСотрудника");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Право);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКДобавитьПерсонал);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Помощь сотрудника'"));
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаУправленияСписок, ДанныеКнопки, ПараметрыНастроек);
	
	ДанныеКнопки.Вставить("Имя", "НоваяПокупка");
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКНоваяПродажа24);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Новая покупка'"));
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаУправленияСписок, ДанныеКнопки, ПараметрыНастроек);
	
	ПодключитьЧасыНаПанельОперацийКСО(Форма, ГруппаУправленияСписок, ПараметрыНастроек.ЗначениеПоложенияЧасов);
	ЭлементыФормы.КнопкаКаталогКСО.Видимость = ЗначениеЗаполнено(Форма.СтруктураПлиточногоИнтерфейсаПодбора);
	
КонецПроцедуры

Процедура СформироватьПанельОперацийПлиточногоИнтерфейсаКСО(Форма, ПараметрыНастроек)
	
	ЭлементыФормы = Форма.Элементы;
	ГруппаУправленияКСО = ЭлементыФормы.ГруппаУправленияКСО;
	ГруппаКнопокНавигации = Неопределено;

	ИмяЭлемента = "ГруппаУправленияПлиточныйИнтерфейс";
	ГруппаУправленияПлитка = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаУправленияКСО);
	ГруппаУправленияПлитка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаУправленияПлитка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаУправленияПлитка.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаУправленияПлитка.ОтображатьЗаголовок = Ложь;
	ГруппаУправленияПлитка.РастягиватьПоГоризонтали = Истина;
	
	ИмяЭлемента = "ГруппаВерхнийРядУправленияПлитка";
	ГруппаУправленияВерх = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаУправленияПлитка);
	ГруппаУправленияВерх.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаУправленияВерх.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаУправленияВерх.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаУправленияВерх.ОтображатьЗаголовок = Ложь;
	ГруппаУправленияВерх.Высота = ПараметрыНастроек.ВысотаГруппы;
	ГруппаУправленияВерх.РастягиватьПоГоризонтали = Истина;
	ГруппаУправленияВерх.РастягиватьПоВертикали = Ложь;
	ГруппаУправленияВерх.ВертикальнаяПрокруткаПриСжатии = Ложь;
	
	Если Форма.ВертикальнаяОриентация Тогда
	
		ИмяЭлемента = "ГруппаНижнийРядУправленияПлитка";
		ГруппаУправленияНиз = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаУправленияПлитка);
		ГруппаУправленияНиз.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаУправленияНиз.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		ГруппаУправленияНиз.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаУправленияНиз.ОтображатьЗаголовок = Ложь;
		ГруппаУправленияНиз.РастягиватьПоГоризонтали = Истина;
		ГруппаУправленияНиз.РастягиватьПоВертикали = Ложь;
		ГруппаУправленияНиз.ВертикальнаяПрокруткаПриСжатии = Ложь;
		ГруппаКнопокНавигации = ГруппаУправленияНиз;
		
	Иначе
		
		ГруппаКнопокНавигации = ГруппаУправленияВерх;
		
	КонецЕсли;
	
	ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
	
	Если Не Форма.ОсновнойПодборПлиточный Тогда
		ДанныеКнопки.Вставить("Имя", "КСписку");
		ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
		ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.ПереместитьВлевоРМК);
		ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'К списку'"));
		ДанныеКнопки.Вставить("ВысотаЗаголовка", 0);
		ДобавитьКнопкуВГруппуУправления(Форма, ГруппаУправленияВерх, ДанныеКнопки, ПараметрыНастроек);
	КонецЕсли;
	
	Если Форма.ВертикальнаяОриентация Тогда
		
		ДанныеКнопки.Вставить("ИмяДействия", "Подключаемый_КнопкаПлиткаДомойКСОНажатие");
		ДанныеКнопки.Вставить("Имя", "ПлиткаДомойВерх");
		ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
		ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.ПереходДомойРМК);
		ДобавитьКнопкуНавигацииВГруппуУправления(Форма, ГруппаУправленияВерх, ДанныеКнопки, ПараметрыНастроек);
		
	КонецЕсли;
	
	ДанныеКнопки.Вставить("ИмяДействия", "");
	ДанныеКнопки.Вставить("Имя", "ПлиткаДомой");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.ПереходДомойРМК);
	КнопкаПлиткаДомой
		= ДобавитьКнопкуНавигацииВГруппуУправления(Форма, ГруппаКнопокНавигации, ДанныеКнопки, ПараметрыНастроек);
	КнопкаПлиткаДомой.Видимость = Не Форма.ВертикальнаяОриентация;
	
	ДобавитьКнопкуВесовогоОтбораКСО(Форма, ГруппаКнопокНавигации, ПараметрыНастроек);
	
	ДанныеКнопки.Вставить("Имя", "ВвестиШтрихкодВПлитке");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Право);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКСозданиеШтрихкода);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Ввести штрихкод'"));
	ДанныеКнопки.Вставить("ВысотаЗаголовка", 2);
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаУправленияВерх, ДанныеКнопки, ПараметрыНастроек);
	
	ДанныеКнопки.Вставить("Имя", "ПомощьСотрудникаВПлитке");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Право);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКДобавитьПерсонал);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Помощь сотрудника'"));
	ДанныеКнопки.Вставить("ВысотаЗаголовка", 2);
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаУправленияВерх, ДанныеКнопки, ПараметрыНастроек);
	
	ДанныеКнопки.Вставить("Имя", "НоваяПокупкаВПлитке");
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКНоваяПродажа24);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Новая покупка'"));
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаУправленияВерх, ДанныеКнопки, ПараметрыНастроек);
	
	ПодключитьЧасыНаПанельОперацийКСО(Форма, ГруппаУправленияВерх, ПараметрыНастроек.ЗначениеПоложенияЧасов, Истина);
	
	ДанныеКнопки.Вставить("Имя", "ЗакрытьПлитку");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Право);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.Cancel);
	КнопкаЗакрыть
		= ДобавитьКнопкуНавигацииВГруппуУправления(Форма, ГруппаУправленияВерх, ДанныеКнопки, ПараметрыНастроек);
	КнопкаЗакрыть.Видимость = Ложь;
	
КонецПроцедуры

Процедура СформироватьПанельТекущегоТовараСпискаКСО(Форма, ПараметрыНастроек)
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	ЭлементыФормы = Форма.Элементы;
	ГруппаУправлениеТоваромКСО = ЭлементыФормы.ГруппаУправлениеТоваромКСО;
	ГруппаУправлениеТоваромКСО.Высота = ПараметрыНастроек.ВысотаГруппы;
	
	ДанныеПоля = ШаблонДанныхПоляПанелиКСО();
	ДанныеПоля.Имя = "ЦенаИзКарточки";
	ДанныеПоля.ПутьКДанным = "ТекущийТоварЦенаИзКарточки";
	ДанныеПоля.Формат = "ЧДЦ=2; ЧН=0.00; ЧФ='Ч ₽'";
	ДобавитьПолеВГруппуУправления(Форма, ГруппаУправлениеТоваромКСО, ДанныеПоля, ПараметрыНастроек);
	
	ДанныеПоля.Имя = "Количество";
	ДанныеПоля.Редактирование = Истина;
	ДанныеПоля.ПутьКДанным = "ТекущийТоварКоличество";
	ДанныеПоля.Формат = "";
	ДобавитьПолеВГруппуУправления(Форма, ГруппаУправлениеТоваромКСО, ДанныеПоля, ПараметрыНастроек);
	
	ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
	ДанныеКнопки.Вставить("Имя", "ТоварУменьшитьКоличество");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.Minus);
	КнопкаУменьшить = ДобавитьКнопкуНавигацииВГруппуУправления(Форма,
		ГруппаУправлениеТоваромКСО, ДанныеКнопки, ПараметрыНастроек);
	КнопкаУменьшить.Доступность = Ложь;
	
	ДанныеКнопки.Вставить("Имя", "ТоварУвеличитьКоличество");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.Plus);
	КнопкаУвеличить = ДобавитьКнопкуНавигацииВГруппуУправления(Форма,
		ГруппаУправлениеТоваромКСО, ДанныеКнопки, ПараметрыНастроек);
	КнопкаУвеличить.Доступность = Ложь;
	
	КнопкаДробноеКоличество = ЭлементыФормы.ТекущийТоварУстановитьДробноеКоличество;
	Если КнопкаДробноеКоличество.Видимость Тогда
		ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
		ДанныеКнопки.Вставить("Имя", "ТоварУстановитьДробноеКоличество");
		ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
		ДанныеКнопки.Вставить("Заголовок", КнопкаДробноеКоличество.Заголовок);
		КнопкаДробноеКоличествоКСО
			= ДобавитьТекстовуюКнопкуВГруппуУправления(Форма, ГруппаУправлениеТоваромКСО, ДанныеКнопки, ПараметрыНастроек);
		КнопкаДробноеКоличествоКСО.Ширина = ПараметрыНастроек.ВысотаГруппы * 1.7
			+ ?(ПараметрыНастроек.ВысотаГруппы < 5, 1, 0);
		КнопкаДробноеКоличествоКСО.Доступность = Ложь;
	КонецЕсли;
	
	ДанныеКнопки.Вставить("Имя", "ПолучитьВес");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКГиря);
	КнопкаВес = ДобавитьКнопкуНавигацииВГруппуУправления(Форма,
		ГруппаУправлениеТоваромКСО, ДанныеКнопки, ПараметрыНастроек);
	КнопкаВес.Доступность = Ложь;
	КнопкаВес.Видимость = ЭлементыФормы.ПолучитьВес.Видимость;
	
	ДанныеКнопки.Вставить("Имя", "УдалитьТовар");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Право);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.УдалитьТовар);
	КнопкаУдаления = ДобавитьКнопкуНавигацииВГруппуУправления(Форма,
		ГруппаУправлениеТоваромКСО, ДанныеКнопки, ПараметрыНастроек);
	ИконкаУдалитьТовар = ЭлементыФормы.ИконкаКнопкиУдалитьТоварКСО;
	ИмяСвойстваЦвета = ?(ЭтоИнтерфейс85, "ЦветКартинки", "ЦветТекста");
	ИконкаУдалитьТовар[ИмяСвойстваЦвета] = ЦветаПалитры.Красный;
	КнопкаУдаления.Доступность = Ложь;
	
КонецПроцедуры

Процедура СформироватьПанельТекущегоТовараПлиточногоИнтерфейсаКСО(Форма, ПараметрыНастроек)
	
	Если Форма.ЗакрыватьПодборПриВыбореТовара Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	ЭлементыФормы = Форма.Элементы;
	ГруппаУправлениеТоваромВПлитке = ЭлементыФормы.ПлиткаИнфоТекущейСтроки;
	ГруппаУправлениеТоваромВПлитке.Высота = ПараметрыНастроек.ВысотаГруппыВПлитке;
	
	ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
	ДанныеКнопки.Вставить("Имя", "ТоварУменьшитьКоличествоВПлитке");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.Minus);
	КнопкаУменьшить = ДобавитьКнопкуНавигацииВГруппуУправления(Форма,
		ГруппаУправлениеТоваромВПлитке, ДанныеКнопки, ПараметрыНастроек, Истина);
	КнопкаУменьшить.Доступность = Ложь;
	
	ДанныеКнопки.Вставить("Имя", "ТоварУвеличитьКоличествоВПлитке");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.Plus);
	КнопкаУвеличить = ДобавитьКнопкуНавигацииВГруппуУправления(Форма,
		ГруппаУправлениеТоваромВПлитке, ДанныеКнопки, ПараметрыНастроек, Истина);
	КнопкаУвеличить.Доступность = Ложь;
	
	КнопкаДробноеКоличество = ЭлементыФормы.ТекущийТоварУстановитьДробноеКоличество;
	Если КнопкаДробноеКоличество.Видимость Тогда
		ДанныеКнопки.Вставить("Имя", "ТоварУстановитьДробноеКоличествоВПлитке");
		ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
		ДанныеКнопки.Вставить("Заголовок", КнопкаДробноеКоличество.Заголовок);
		КнопкаДробноеКоличествоКСО = ДобавитьТекстовуюКнопкуВГруппуУправления(Форма,
			ГруппаУправлениеТоваромВПлитке, ДанныеКнопки, ПараметрыНастроек, Истина);
		КнопкаДробноеКоличествоКСО.Ширина = ПараметрыНастроек.ВысотаГруппыВПлитке * 1.7;
		КнопкаДробноеКоличествоКСО.Доступность = Ложь;
	КонецЕсли;
	
	ДанныеКнопки.Вставить("Имя", "ПолучитьВесВПлитке");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Лево);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКГиря);
	КнопкаВес = ДобавитьКнопкуНавигацииВГруппуУправления(Форма,
		ГруппаУправлениеТоваромВПлитке, ДанныеКнопки, ПараметрыНастроек, Истина);
	КнопкаВес.Доступность = Ложь;
	КнопкаВес.Видимость = ЭлементыФормы.ПолучитьВес.Видимость;
	
	ДанныеКнопки.Вставить("Имя", "УдалитьТоварВПлитке");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Право);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.УдалитьТовар);
	КнопкаУдаления = ДобавитьКнопкуНавигацииВГруппуУправления(Форма,
		ГруппаУправлениеТоваромВПлитке, ДанныеКнопки, ПараметрыНастроек, Истина);
	ИконкаУдалитьТовар = ЭлементыФормы.ИконкаКнопкиУдалитьТоварВПлиткеКСО;
	ИмяСвойстваЦвета = ?(ЭтоИнтерфейс85, "ЦветКартинки", "ЦветТекста");
	ИконкаУдалитьТовар[ИмяСвойстваЦвета] = ЦветаПалитры.Красный;
	КнопкаУдаления.Доступность = Ложь;
	
КонецПроцедуры

Процедура СформироватьКнопкуЛояльностиКСО(Форма, НастройкиЭлементов)
	
	ЗаголовкиОбластей = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьЗаголовкиОбластейДляНастроек();
	НастройкиВводаПокупателей = НастройкиЭлементов.Получить(ЗаголовкиОбластей.ВвестиДанныеПокупателя);
	КнопкаЛояльности = ДобавитьКнопкуЛояльностиКСО(Форма, НастройкиВводаПокупателей);
	
КонецПроцедуры

Функция ДобавитьКнопкуЛояльностиКСО(Форма, НастройкиВводаПокупателей, ВысотаЗаголовка = 2)
	
	ГруппаКарточка = Неопределено;
	Если Форма.ВводДисконтныхКарт Тогда
	
		ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
		ЭлементыФормы = Форма.Элементы;
		СвойствоШирина = Перечисления.СвойстваЭлементовРМК.ШиринаКнопок;
		СвойствоВысота = Перечисления.СвойстваЭлементовРМК.ВысотаКнопок;
		СвойствоЦветКнопок = Перечисления.СвойстваЭлементовРМК.ЦветКнопок;
		СвойствоРазмер = Перечисления.СвойстваЭлементовРМК.РазмерКнопок;
		
		ПараметрыНастроек = Новый Структура();
		ПараметрыНастроек.Вставить("БазоваяШирина", 20);
		ПараметрыНастроек.Вставить("ЗначениеЦвета", ?(ЭтоИнтерфейс85, Неопределено, WebЦвета.Бежевый));
		ЗначениеШирины = 0;
		ЗначениеВысоты = 0;
		ЗначениеРазмера = 0;
		
		Если Не НастройкиВводаПокупателей = Неопределено Тогда
			Если ЗначениеЗаполнено(НастройкиВводаПокупателей.Получить(СвойствоШирина)) Тогда
				ЗначениеШирины = НастройкиВводаПокупателей.Получить(СвойствоШирина);
			КонецЕсли;
			Если ЗначениеЗаполнено(НастройкиВводаПокупателей.Получить(СвойствоВысота)) Тогда
				ЗначениеВысоты = НастройкиВводаПокупателей.Получить(СвойствоВысота);
			КонецЕсли;
			Если ЗначениеЗаполнено(НастройкиВводаПокупателей.Получить(СвойствоРазмер)) Тогда
				ЗначениеРазмера = НастройкиВводаПокупателей.Получить(СвойствоРазмер);
			КонецЕсли;
			ДобавитьПараметрНастройки(ПараметрыНастроек, "ЗначениеЦвета",
				НастройкиВводаПокупателей.Получить(СвойствоЦветКнопок));
		КонецЕсли;
		
		ШиринаТакси = ?(ЗначениеЗаполнено(ЗначениеШирины), ЗначениеШирины, ПараметрыНастроек.БазоваяШирина);
		ШиринаКарточки = ?(ЭтоИнтерфейс85, ПараметрыНастроек.БазоваяШирина + 2 * ЗначениеРазмера, ШиринаТакси);
		ВысотаТакси = ?(ЗначениеЗаполнено(ЗначениеВысоты), ЗначениеВысоты, 5);
		ВысотаГруппы = ?(ЭтоИнтерфейс85, 5 + ЗначениеРазмера, ВысотаТакси);

		ПараметрыНастроек.Вставить("ВысотаГруппы", ВысотаГруппы);
		ПараметрыНастроек.Вставить("ШиринаКарточки", ШиринаКарточки);
		
		ГруппаВвестиДанныеПокупателяКСО = ЭлементыФормы.ГруппаЛояльностиКСО;
		ГруппаВвестиДанныеПокупателяКСО.Высота = ПараметрыНастроек.ВысотаГруппы;
		ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
		ДанныеКнопки.Вставить("Имя", "ВвестиДанныеПокупателя");
		ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Центр);
		ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.ВвестиДанныеПокупателя);
		ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Карта лояльности'"));
		ДанныеКнопки.Вставить("ВысотаЗаголовка", ВысотаЗаголовка);
		ДобавитьКнопкуВГруппуУправления(Форма, ГруппаВвестиДанныеПокупателяКСО, ДанныеКнопки, ПараметрыНастроек);
		
		ИмяЭлемента = СтрШаблон("ИконкаКнопки%1КСО", ДанныеКнопки.Имя);
		КартинкаКарточки = ЭлементыФормы.Найти(ИмяЭлемента);
		КартинкаКарточки.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
		
		ИмяЭлемента = СтрШаблон("ЗаголовокКнопки%1КСО", ДанныеКнопки.Имя);
		ЗаголовокКарточки = ЭлементыФормы.Найти(ИмяЭлемента);
		ЗаголовокКарточки.МаксимальнаяШирина = 0;
		
		ИмяЭлемента = СтрШаблон("Кнопка%1КСО", ДанныеКнопки.Имя);
		ГруппаКарточка = ЭлементыФормы.Найти(ИмяЭлемента);
		ГруппаКарточка.РастягиватьПоГоризонтали = Истина;
		
	КонецЕсли;
	Возврат ГруппаКарточка;
	
КонецФункции

Процедура НастроитьНижнююПанельКСО(Форма, ПараметрыНастроек)
	
	ЭлементыФормы = Форма.Элементы;
	ГруппаНачатьСканирование = ЭлементыФормы.НачатьСканированиеКСО;
	ГруппаНачатьСканирование.Высота = ПараметрыНастроек.ВысотаГруппы;
	
	ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
	ДанныеКнопки.Вставить("Имя", "СканерШтрихкода");
	ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Центр);
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКЗеленаяСтрелкаВниз48);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Сканер штрихкода'"));
	ДанныеКнопки.Вставить("ВысотаЗаголовка", 2);
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаНачатьСканирование, ДанныеКнопки, ПараметрыНастроек);
	
КонецПроцедуры

Процедура НастроитьПанельЗавершенияОплатыКСО(Форма, ПараметрыНастроек)
	
	ЭлементыФормы = Форма.Элементы;
	ГруппаОкончаниеЧекаКоманднаяПанель = ЭлементыФормы.ГруппаОкончаниеЧекаКоманднаяПанель;
	ГруппаОкончаниеЧекаКоманднаяПанель.Высота = ПараметрыНастроек.ВысотаГруппы;
	
	ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
	ДанныеКнопки.Вставить("Имя", "НачатьПокупку");
	ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКПакет);
	ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Начать покупку'"));
	ДобавитьКнопкуВГруппуУправления(Форма, ГруппаОкончаниеЧекаКоманднаяПанель, ДанныеКнопки, ПараметрыНастроек);
	
КонецПроцедуры

Процедура ПривестиКЕдинойШиринеКнопкиВидовОплат(Форма)
	
	Элементы = Форма.Элементы;
	ЕдинаяШирина = 22;
	
	КнопкиВидовОплат = Новый Массив;
	КнопкиВидовОплат.Добавить(Элементы.ОплатаНаличными);
	КнопкиВидовОплат.Добавить(Элементы.ОплатаКартой);
	КнопкиВидовОплат.Добавить(Элементы.ПодготовитьДанныеВыдачиНаличных);
	КнопкиВидовОплат.Добавить(Элементы.ОткрытьДенежныйЯщикПриВыдачеНаличных);
	КнопкиВидовОплат.Добавить(Элементы.ОплатаСБП);
	КнопкиВидовОплат.Добавить(Элементы.ОплатаЮКасса);
	КнопкиВидовОплат.Добавить(Элементы.ОплатаСертификатомНСПК);
	КнопкиВидовОплат.Добавить(Элементы.ЗаменаТоваров);
	КнопкиВидовОплат.Добавить(Элементы.Предоплата);
	КнопкиВидовОплат.Добавить(Элементы.ОплатаВРассрочку);
	КнопкиВидовОплат.Добавить(Элементы.ЗачетАванса);
	КнопкиВидовОплат.Добавить(Элементы.Безнал);
	КнопкиВидовОплат.Добавить(Элементы.ОплатаКредитом);
	КнопкиВидовОплат.Добавить(Элементы.ДобавитьСертификат);
	КнопкиВидовОплат.Добавить(Элементы.ДоплатитьСертификатом);
	КнопкиВидовОплат.Добавить(Элементы.ОплатаБонусами);
	
	Для Каждого КнопкаЭлемент Из КнопкиВидовОплат Цикл
		КнопкаЭлемент.Ширина = ЕдинаяШирина;
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьКнопкуСкидкаПенсионераКСО(Форма, НастройкиЭлементов)
	
	КнопкаСкидкаПенсионераКСО = ДобавитьКнопкуСкидкаПенсионераКСО(Форма);
	Если Форма.ОсновнойПодборПлиточный Тогда
		Форма.Элементы.Переместить(Форма.Элементы.ГруппаСкидкаПенсионераКСО,
			Форма.Элементы.ПлиткаГруппаНиз, Форма.Элементы.ПлиткаГруппаОплатить);
		Форма.Элементы.ГруппаСкидкаПенсионераКСО.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
		Форма.Элементы.Переместить(Форма.Элементы.ПлиткаГруппаОплатить,
			Форма.Элементы.ГруппаСкидкаПенсионераКСО);
	Иначе
		Если Форма.ВертикальнаяОриентация Тогда
			Форма.Элементы.СтраницаУправленияЛояльностьюКСО.Группировка = 
				ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		Иначе
			Форма.Элементы.Переместить(Форма.Элементы.ГруппаСкидкаПенсионераКСО,
				Форма.Элементы.ГруппаУправленияЛояльностьюКСО, Форма.Элементы.ГруппаДанныеСкидки);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ДобавитьКнопкуСкидкаПенсионераКСО(Форма, Настройки = Неопределено, ВысотаЗаголовка = 2)
	
	ГруппаКарточка = Неопределено;
	Если Форма.ВводДисконтныхКарт Тогда
	
		ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
		ЭлементыФормы = Форма.Элементы;
		СвойствоШирина = Перечисления.СвойстваЭлементовРМК.ШиринаКнопок;
		СвойствоВысота = Перечисления.СвойстваЭлементовРМК.ВысотаКнопок;
		СвойствоЦветКнопок = Перечисления.СвойстваЭлементовРМК.ЦветКнопок;
		СвойствоРазмер = Перечисления.СвойстваЭлементовРМК.РазмерКнопок;
		
		ПараметрыНастроек = Новый Структура();
		ПараметрыНастроек.Вставить("БазоваяШирина", 20);
		ПараметрыНастроек.Вставить("ЗначениеЦвета", ?(ЭтоИнтерфейс85, Неопределено, WebЦвета.Бежевый));
		ЗначениеШирины = 0;
		ЗначениеВысоты = 0;
		ЗначениеРазмера = 0;
		
		Если Не Настройки = Неопределено Тогда
			Если ЗначениеЗаполнено(Настройки.Получить(СвойствоШирина)) Тогда
				ЗначениеШирины = Настройки.Получить(СвойствоШирина);
			КонецЕсли;
			Если ЗначениеЗаполнено(Настройки.Получить(СвойствоВысота)) Тогда
				ЗначениеВысоты = Настройки.Получить(СвойствоВысота);
			КонецЕсли;
			Если ЗначениеЗаполнено(Настройки.Получить(СвойствоРазмер)) Тогда
				ЗначениеРазмера = Настройки.Получить(СвойствоРазмер);
			КонецЕсли;
			ДобавитьПараметрНастройки(ПараметрыНастроек, "ЗначениеЦвета",
				Настройки.Получить(СвойствоЦветКнопок));
		КонецЕсли;
		
		ШиринаТакси = ?(ЗначениеЗаполнено(ЗначениеШирины), ЗначениеШирины, ПараметрыНастроек.БазоваяШирина);
		ШиринаКарточки = ?(ЭтоИнтерфейс85, ПараметрыНастроек.БазоваяШирина + 2 * ЗначениеРазмера, ШиринаТакси);
		ВысотаТакси = ?(ЗначениеЗаполнено(ЗначениеВысоты), ЗначениеВысоты, 5);
		ВысотаГруппы = ?(ЭтоИнтерфейс85, 5 + ЗначениеРазмера, ВысотаТакси);

		ПараметрыНастроек.Вставить("ВысотаГруппы", ВысотаГруппы);
		ПараметрыНастроек.Вставить("ШиринаКарточки", ШиринаКарточки);
		
		ГруппаСкидкаПенсионераКСО = ЭлементыФормы.ГруппаСкидкаПенсионераКСО;
		ГруппаСкидкаПенсионераКСО.Высота = ПараметрыНастроек.ВысотаГруппы;
		ДанныеКнопки = ШаблонДанныхКнопкиПанелиОперацийКСО();
		ДанныеКнопки.Вставить("Имя", "СкидкаПенсионера");
		ДанныеКнопки.Вставить("Положение", ГоризонтальноеПоложениеЭлемента.Центр);
		ДанныеКнопки.Вставить("Картинка", БиблиотекаКартинок.РМКПенсионер);
		ДанныеКнопки.Вставить("Заголовок", НСтр("ru = 'Скидка пенсионерам'"));
		ДанныеКнопки.Вставить("ВысотаЗаголовка", ВысотаЗаголовка);
		ДобавитьКнопкуВГруппуУправления(Форма, ГруппаСкидкаПенсионераКСО, ДанныеКнопки, ПараметрыНастроек);
		
		ИмяЭлемента = СтрШаблон("ИконкаКнопки%1КСО", ДанныеКнопки.Имя);
		КартинкаКарточки = ЭлементыФормы.Найти(ИмяЭлемента);
		КартинкаКарточки.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
		
		ИмяЭлемента = СтрШаблон("ЗаголовокКнопки%1КСО", ДанныеКнопки.Имя);
		ЗаголовокКарточки = ЭлементыФормы.Найти(ИмяЭлемента);
		ЗаголовокКарточки.МаксимальнаяШирина = 0;
		
		ИмяЭлемента = СтрШаблон("Кнопка%1КСО", ДанныеКнопки.Имя);
		ГруппаКарточка = ЭлементыФормы.Найти(ИмяЭлемента);
		ГруппаКарточка.РастягиватьПоГоризонтали = Истина;
		
	КонецЕсли;
	Возврат ГруппаКарточка;
	
КонецФункции

Процедура ДобавитьКнопкуОплаты(Форма, ГруппаКонтейнер, ДанныеКнопки, СуффиксИмени)
	
	ЭлементыФормы = Форма.Элементы;
	ИмяДействия = СтрШаблон("Подключаемый_Кнопка%1%2Нажатие", ДанныеКнопки.Имя, СуффиксИмени);
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	БазоваяВысота = 5;
	
	ИмяЭлемента = СтрШаблон("Кнопка%1%2", ДанныеКнопки.Имя, СуффиксИмени);
	КнопкаКарточка = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ГруппаКонтейнер);
	КнопкаКарточка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	КнопкаКарточка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	КнопкаКарточка.Отображение = ОтображениеОбычнойГруппы.Нет;
	КнопкаКарточка.ОтображатьЗаголовок = Ложь;
	КнопкаКарточка.ОтображатьКакКарточку = Истина;
	КнопкаКарточка.Гиперссылка = Истина;
	КнопкаКарточка.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	КнопкаКарточка.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Центр;
	КнопкаКарточка.РастягиватьПоГоризонтали = Истина;
	КнопкаКарточка.РастягиватьПоВертикали = Ложь;
	КнопкаКарточка.Высота = ДанныеКнопки.Высота;
	КнопкаКарточка.ЦветФона = ДанныеКнопки.ЦветФона;
	КнопкаКарточка.УстановитьДействие("Нажатие", ИмяДействия);
	Если ЗначениеЗаполнено(ДанныеКнопки.Ширина) Тогда
		КнопкаКарточка.Ширина = ДанныеКнопки.Ширина;
	КонецЕсли;

	МасштабШрифтаКартинки = ПолучитьМасштабШрифтаКартинкиОплаты(ДанныеКнопки.Высота);
	МасштабШрифтаЗаголовка = Цел(?(ЭтоИнтерфейс85, 100, 110) * ДанныеКнопки.Высота / БазоваяВысота);
	
	ИмяЭлемента = СтрШаблон("ИконкаКнопки%1%2", ДанныеКнопки.Имя, СуффиксИмени);
	ИконкаКнопки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), КнопкаКарточка);
	ИконкаКнопки.Вид = ВидДекорацииФормы.Картинка;
	ИконкаКнопки.Картинка = ДанныеКнопки.Картинка;
	ИконкаКнопки.Шрифт = Новый Шрифт(ШрифтыСтиля.ЗаголовокПервогоУровня, , , , , , , МасштабШрифтаКартинки);
	ИконкаКнопки.РазмерКартинки = РазмерКартинки.ПоРазмеруШрифта;
	ИконкаКнопки.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	ИконкаКнопки.РастягиватьПоВертикали = Ложь;
	
	ИмяЭлемента = СтрШаблон("ЗаголовокКнопки%1%2", ДанныеКнопки.Имя, СуффиксИмени);
	ЗаголовокКнопки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), КнопкаКарточка);
	ЗаголовокКнопки.Вид = ВидДекорацииФормы.Надпись;
	ЗаголовокКнопки.Шрифт = Новый Шрифт(ШрифтыСтиля.ЗаголовокВторогоУровня, , , , , , , МасштабШрифтаЗаголовка);
	ЗаголовокКнопки.МаксимальнаяШирина = 0;
	ЗаголовокКнопки.АвтомаксимальнаяШирина = Ложь;
	ЗаголовокКнопки.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	ЗаголовокКнопки.РастягиватьПоГоризонтали = Истина;
	ЗаголовокКнопки.Заголовок = ДанныеКнопки.Заголовок;
	
КонецПроцедуры

Процедура ДобавитьУникальнуюКнопкуОплатыНаФорме(Форма, УникальныйВидОплаты, ПараметрыПостроения)
	
	ИменаВидовОплат = ИнтерфейсРМКСлужебныйКлиентСервер.ИменаУникальныхВидовОплат();
	
	ПоказатьQR = ПараметрыПостроения.ОтображатьQRОплаты;
	МинимальнаяВысота = ?(ПоказатьQR, 6, 5);
	ВысотаКнопки = МинимальнаяВысота;
	Если ПараметрыПостроения.ВысотаКнопокОплат > 9 Тогда
		ВысотаКнопки = 9;
	ИначеЕсли ПараметрыПостроения.ВысотаКнопокОплат > МинимальнаяВысота Тогда
		ВысотаКнопки = ПараметрыПостроения.ВысотаКнопокОплат;
	КонецЕсли;
	
	Отказ = Ложь;
	ДанныеКнопки = ШаблонДанныхКнопкиОплатыКСО();
	ДанныеКнопки.Имя = СтрШаблон("Оплатить%1", УникальныйВидОплаты);
	ДанныеКнопки.Высота = ВысотаКнопки;
	ДанныеКнопки.Ширина = ПараметрыПостроения.ШиринаКнопокОплат;
	Если УникальныйВидОплаты = ИменаВидовОплат.Карта Тогда
		ДанныеКнопки.Картинка = ?(ПоказатьQR, БиблиотекаКартинок.РМКQRОплатаКартой, БиблиотекаКартинок.РМКВидОплатыКарта);
		ДанныеКнопки.Заголовок = НСтр("ru='Карта'");
		ДанныеКнопки.ЦветФона = ИнтерфейсРМКСлужебный.ЦветУправляющейКнопки(Истина);
	ИначеЕсли УникальныйВидОплаты = ИменаВидовОплат.Наличные Тогда
		ДанныеКнопки.Картинка
			= ?(ПоказатьQR, БиблиотекаКартинок.РМКQRОплатаНаличными, БиблиотекаКартинок.РМКВидОплатыНаличные);
		ДанныеКнопки.Заголовок = НСтр("ru='Наличные'");
		ДанныеКнопки.ЦветФона = ИнтерфейсРМКСлужебный.ЦветГиперссылки(Истина);
	ИначеЕсли УникальныйВидОплаты = ИменаВидовОплат.СБП Тогда
		ДанныеКнопки.Картинка = ?(ПоказатьQR, БиблиотекаКартинок.РМКQRОплатаСБП, БиблиотекаКартинок.РМКВидОплатыСБП);
		ДанныеКнопки.Заголовок = НСтр("ru='СБП'");
		ДанныеКнопки.ЦветФона = ИнтерфейсРМКСлужебный.ЦветВспомогательнойКнопки(Истина);
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
	Если Не Отказ Тогда
		ЭлементыФормы = Форма.Элементы;
		ГруппаОплатыСписок = ЭлементыФормы.ГруппаУникальнойКнопкиОплаты;
		ДобавитьКнопкуОплаты(Форма, ГруппаОплатыСписок, ДанныеКнопки, "Список");
		
		ГруппаОплатыПлитка = ЭлементыФормы.СтраницаУникальнойКнопкиОплатыПлитка;
		ДобавитьКнопкуОплаты(Форма, ГруппаОплатыПлитка, ДанныеКнопки, "Плитка");
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьЭлементыКнопокУникальнойОплаты(Форма)
	
	ЭлементыФормы = Форма.Элементы;
	ОчиститьЭлементыГруппы(ЭлементыФормы, ЭлементыФормы.ГруппаУникальнойКнопкиОплаты);
	ОчиститьЭлементыГруппы(ЭлементыФормы, ЭлементыФормы.СтраницаУникальнойКнопкиОплатыПлитка);
	
КонецПроцедуры

Процедура ОчиститьЭлементыГруппы(ЭлементыФормы, ГруппаНаФорме)
	
	КоличествоВложенныхЭлементов = ГруппаНаФорме.ПодчиненныеЭлементы.Количество();
	Если КоличествоВложенныхЭлементов > 0 Тогда
		Для ИндексЭлемента = 1 По КоличествоВложенныхЭлементов Цикл
			ТекущийИндекс = КоличествоВложенныхЭлементов - ИндексЭлемента;
			ВложенныйЭлемент = ГруппаНаФорме.ПодчиненныеЭлементы.Получить(ТекущийИндекс);
			ЭлементыФормы.Удалить(ВложенныйЭлемент);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
