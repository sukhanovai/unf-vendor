	// Дерево действующих скидок
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ФормаРМК.Элементы.ДеревоДействующихСкидок.Имя);
	ДобавитьЭлементОтбораКомпоновкиДанныхРавенство(Элемент.Отбор, ФормаРМК.Элементы.ДеревоДействующихСкидокУровень.ПутьКДанным, 1);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтОбычныйПолужирный12РМК);
	
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ФормаРМК.Элементы.ДеревоДействующихСкидок.Имя);
	ДобавитьЭлементОтбораКомпоновкиДанныхРавенство(Элемент.Отбор, ФормаРМК.Элементы.ДеревоДействующихСкидокУровень.ПутьКДанным, 2);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтОбычныйНаклонный12РМК);
	
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ФормаРМК.Элементы.ДеревоСкидокУниверсальнаяКоманда.Имя);
	ДобавитьЭлементОтбораКомпоновкиДанныхРавенство(Элемент.Отбор, "ДеревоСкидок.ЭтоУправляемаяСкидка", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("Картинка", БиблиотекаКартинок.ОформлениеКрест);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Нстр("ru = 'удалить скидку'"));

	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ФормаРМК.Элементы.ДеревоСкидокУниверсальнаяКоманда.Имя);
	ДобавитьЭлементОтбораКомпоновкиДанныхРавенство(Элемент.Отбор, "ДеревоСкидок.МожноДобавитьУправляемуюСкидку", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("Картинка", БиблиотекаКартинок.СоздатьЭлементСписка);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Нстр("ru = 'добавить скидку'"));

	// Отбор группа
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ФормаРМК.Элементы.ОтборГруппа.Имя);
	ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОтборГруппа.Ссылка");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Новый ПолеКомпоновкиДанных("НастройкаКаталогаТекущаяГруппа");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаРежимаПродажиРМК);
	
	// Отбор категории
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ФормаРМК.Элементы.ОтборКатегория.Имя);
	ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ОтборКатегория.Ссылка");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Новый ПолеКомпоновкиДанных("НастройкаКаталогаТекущаяКатегория");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаРежимаПродажиРМК);
	
	// Объединенная строка номенклатуры в каталоге
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ФормаРМК.Элементы.СписокТоваров.Имя);
	ДобавитьЭлементОтбораКомпоновкиДанныхРавенство(Элемент.Отбор, ФормаРМК.Элементы.СписокТоваровВидСтроки.ПутьКДанным, 1);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветАктивнойКнопкиРМК);

	// Сумма баллов к начислению в карточке
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ИмяРеквизита = ФормаРМК.Элементы.БудетНачислено.ПутьКДанным;
	ИмяЭлемента = ФормаРМК.Элементы.БудетНачислено.Имя;
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	ДобавитьЭлементОтбораКомпоновкиДанныхРавенство(Элемент.Отбор, ИмяРеквизита, 0);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Сумма баллов будет списано
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ИмяРеквизита = ФормаРМК.Элементы.БудетСписано.ПутьКДанным;
	ИмяЭлемента = ФормаРМК.Элементы.БудетСписано.Имя;
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	ДобавитьЭлементОтбораКомпоновкиДанныхРавенство(Элемент.Отбор, ИмяРеквизита, 0);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Не отображать информацию о баллах, если ДК не заполнена
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ИмяРеквизита = "ВведенаБонуснаяКарта";
	ИмяЭлемента = ФормаРМК.Элементы.КоличествоБонусовВКарточке.Имя;
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	ДобавитьЭлементОтбораКомпоновкиДанныхРавенство(Элемент.Отбор, ИмяРеквизита, Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Курсивом в списке товаров отображать код и артикул
	Элемент = ФормаРМК.УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ФормаРМК.Элементы.ТоварыПредставлениеКодАртикул.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ФормаРМК.Элементы.ТоварыМиниСписокКодАртикул.Имя);
	ГруппаОтбораЭлементов = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбораЭлементов.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ЭлементОтбора = ГруппаОтбораЭлементов.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.Код");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ЭлементОтбора = ГруппаОтбораЭлементов.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.Артикул");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтыСтиля.ШрифтОбычныйНаклонный10РМК);
	
КонецПроцедуры

Функция СоответствиеНоминаловЦветам()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("10", ЦветаПалитры.Серый);
	Результат.Вставить("50", ЦветаПалитры.Голубой);
	Результат.Вставить("100", ЦветаПалитры.Желтый);
	Результат.Вставить("200", ЦветаПалитры.ЗеленыйСветлоТусклыйРМК);
	Результат.Вставить("500", ЦветаПалитры.Фиолетовый);
	Результат.Вставить("1000", ЦветаПалитры.Зеленый);
	Результат.Вставить("2000", ЦветаПалитры.ГолубойОсветленныйРМК);
	Результат.Вставить("5000", ЦветаПалитры.Оранжевый);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьКупюруНаПанельВводаНаличных(Элементы, Команды, ГруппаРядКупюр, ДанныеКупюры, РежимКлавиатуры = Ложь)
	
	Номинал = ДанныеКупюры.НоминалКупюры;
	
	ИмяГруппыКупюры = "ГруппаКупюры" + Номинал;
	Если НЕ Элементы.Найти(ИмяГруппыКупюры) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяГруппаКупюры = Элементы.Добавить(ИмяГруппыКупюры, Тип("ГруппаФормы"), ГруппаРядКупюр);
	НоваяГруппаКупюры.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппаКупюры.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяГруппаКупюры.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	НоваяГруппаКупюры.ОтображатьЗаголовок = Ложь;
	НоваяГруппаКупюры.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппаКупюры.Высота = ?(РежимКлавиатуры, 5, 0);
	
	ИмяКоманды = "ВыборКупюры" + Номинал;
	НоваяКоманда = Команды.Найти(ИмяКоманды);
	Если НоваяКоманда = Неопределено Тогда
		НоваяКоманда = Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = "Подключаемый_ВыбратьКупюру";
		Если Не ДанныеКупюры.ГорячаяКлавиша = Неопределено Тогда
			НоваяКоманда.СочетаниеКлавиш = ДанныеКупюры.ГорячаяКлавиша;
		КонецЕсли;
	КонецЕсли;
	
	ИмяКнопкиКупюры = "Купюра" + Номинал;
	КнопкаКупюры = Элементы.Добавить(ИмяКнопкиКупюры, Тип("КнопкаФормы"), НоваяГруппаКупюры);
	КнопкаКупюры.ИмяКоманды = ИмяКоманды;
	Если Номинал = "0" Тогда
		КнопкаКупюры.Заголовок = "X";
	Иначе
		КнопкаКупюры.Заголовок = Номинал;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеКупюры.ЦветФона) Тогда
		КнопкаКупюры.ЦветФона = ДанныеКупюры.ЦветФона;
	КонецЕсли;
	КнопкаКупюры.Ширина = 8;
	КнопкаКупюры.РастягиватьПоГоризонтали = Истина;
	КнопкаКупюры.РастягиватьПоВертикали = Истина;
	КнопкаКупюры.Отображение = ОтображениеКнопки.Текст;
	
КонецПроцедуры

Функция ДобавитьРядКнопок(Форма, РодительскийЭлемент, ИндексРяда, ПараметрыПостроения, ГорячиеКлавиши)
	
	Элементы = Форма.Элементы;
	
	ИмяРяда = СтрШаблон("РядКнопок_%1", ИндексРяда);
	НовыйРяд = Элементы.Найти(ИмяРяда);
	Если НовыйРяд = Неопределено Тогда
		НовыйРяд = Элементы.Добавить(ИмяРяда, Тип("ГруппаФормы"), РодительскийЭлемент);
	КонецЕсли;
	НовыйРяд.Вид 								= ВидГруппыФормы.ОбычнаяГруппа;
	НовыйРяд.ГоризонтальноеПоложениеПодчиненных	= ГоризонтальноеПоложениеЭлемента.Центр;
	НовыйРяд.Группировка						= ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйРяд.ОтображатьЗаголовок 				= Ложь;
	НовыйРяд.Отображение						= ОтображениеОбычнойГруппы.Нет;
	НовыйРяд.РастягиватьПоГоризонтали			= Истина;
	НовыйРяд.РастягиватьПоВертикали				= Ложь;
	НовыйРяд.ГоризонтальныйИнтервал 			= ИнтервалМеждуЭлементамиФормы.Половинный;
	
	КоличествоКнопокВРяду = 4;
	Для Счт = 1 По КоличествоКнопокВРяду Цикл
		
		НомерКарточки = КоличествоКнопокВРяду * (ИндексРяда - 1) + Счт;
		ДобавитьКнопкуВРяд(Форма, НовыйРяд, НомерКарточки, ГорячиеКлавиши, ПараметрыПостроения);
		
	КонецЦикла;
	Возврат НовыйРяд;
	
КонецФункции

Процедура ДобавитьКнопкуВРяд(Форма, РядКнопок, ИндексКнопки, ГорячиеКлавиши, ПараметрыПостроения)
	
	ЭтоИнтерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	СочетаниеКлавиш = Неопределено;
	Если Не ГорячиеКлавиши = Неопределено Тогда
		Если (ГорячиеКлавиши.Alt ИЛИ ГорячиеКлавиши.Shift ИЛИ ГорячиеКлавиши.Ctrl) И ИндексКнопки < 10 Тогда
			
			ИмяКлавиши = СтрШаблон("_%1", (ИндексКнопки));
			ДополнительнаяКлавиша = Клавиша[ИмяКлавиши];
			
			СочетаниеКлавиш = Новый СочетаниеКлавиш(ДополнительнаяКлавиша,
				ГорячиеКлавиши.Alt, ГорячиеКлавиши.Ctrl, ГорячиеКлавиши.Shift);
		КонецЕсли;
	КонецЕсли;
	
	ЭлементыФормы = Форма.Элементы;
	
	ИмяЭлемента = СтрШаблон("КонтейнерИзбранное_%1", ИндексКнопки);
	КонтейнерПлитки = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), РядКнопок);
	КонтейнерПлитки.Вид = ВидГруппыФормы.Страницы;
	КонтейнерПлитки.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонтейнерПлитки.РастягиватьПоВертикали = Ложь;
	
	ИмяЭлемента = СтрШаблон("СтраницаИзбранноеПустоеМесто_%1", ИндексКнопки);
	СтраницаКонтейнера = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), КонтейнерПлитки);
	СтраницаКонтейнера.Вид = ВидГруппыФормы.Страница;
	СтраницаКонтейнера.ОтображатьЗаголовок = Ложь;
	
	БезРамки = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки);
	ИмяЭлемента = СтрШаблон("ДекорацияИзбранноеПустоеМесто_%1", ИндексКнопки);
	ИзображениеИзбранного = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), СтраницаКонтейнера);
	ИзображениеИзбранного.Вид = ВидПоляФормы.ПолеКартинки;
	ИзображениеИзбранного.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ИзображениеИзбранного.Рамка = БезРамки;
	ИзображениеИзбранного.ПутьКДанным = "ПустаяКартинка";
	ИзображениеИзбранного.РазмерКартинки = РазмерКартинки.АвтоРазмер;
	ИзображениеИзбранного.Ширина = 17;
	ИзображениеИзбранного.Высота = 1;
	ИзображениеИзбранного.АвтоМаксимальнаяВысота = Истина;
	ИзображениеИзбранного.АвтоМаксимальнаяШирина = Ложь;
	ИзображениеИзбранного.РастягиватьПоВертикали = Истина;
	ИзображениеИзбранного.РастягиватьПоГоризонтали = Истина;
	
	ИмяЭлемента = СтрШаблон("СтраницаСодержимоеИзбранного_%1", ИндексКнопки);
	СтраницаКонтейнера = ЭлементыФормы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), КонтейнерПлитки);
	СтраницаКонтейнера.Вид = ВидГруппыФормы.Страница;
	СтраницаКонтейнера.ОтображатьЗаголовок = Ложь;
	
	ИмяЭлемента = СтрШаблон("КарточкаИзбранного_%1", ИндексКнопки);
	ПлиткаИзбранного = ДобавитьГруппуКарточку(ЭлементыФормы, СтраницаКонтейнера, ИмяЭлемента,
		ПараметрыПостроения.ИмяКомандыНажатия);
	ПлиткаИзбранного.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ПлиткаИзбранного.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	ПлиткаИзбранного.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Нет;
	ПлиткаИзбранного.Ширина = 34;
	ПлиткаИзбранного.РастягиватьПоГоризонтали = Истина;
	
	ЗаполнитьКарточкуИзбранного(Форма, ПлиткаИзбранного, ИндексКнопки, СочетаниеКлавиш, ПараметрыПостроения);
	
	Если ИндексКнопки = 8 Тогда
		
		ДобавитьСтраницуНавигацииИзбранного(Форма, КонтейнерПлитки, ГорячиеКлавиши);
		
	КонецЕсли;
	
КонецПроцедуры

