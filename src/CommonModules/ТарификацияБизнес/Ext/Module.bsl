	ОповеститьОПодключенииОтключенииПриложения(ОписаниеПриложения, Истина);
	
КонецПроцедуры

Процедура ОповеститьОбОтключенномПриложении(ОписаниеПриложения)
	
	ОповеститьОПодключенииОтключенииПриложения(ОписаниеПриложения, Ложь);
	
КонецПроцедуры

Процедура ОповеститьОПодключенииОтключенииПриложения(ОписаниеПриложения, ПриложениеБылоПодключено)
	
	ИмяОповещения = ТарификацияБизнесКлиентСервер.ИмяСерверногоОповещения();
	
	Данные = Новый Структура;
	Данные.Вставить("ОписаниеПриложения", ОписаниеПриложения);
	Данные.Вставить("ПриложениеБылоПодключено", ПриложениеБылоПодключено);
	Данные.Вставить("ВремяСрабатывания", ТекущаяДатаСеанса());
	
	СерверныеОповещения.ОтправитьСерверноеОповещение(ИмяОповещения, Данные, Неопределено, Истина);
	
КонецПроцедуры

Функция ДоступныеВозможностиПриложенийЕБВ(ОписаниеДоступныхПриложений) 
	
	ТаблицаВозможностей = ТарификацияБизнес.НоваяТаблицаВозможностей();
	Если ОписаниеДоступныхПриложений.Количество() = 0 Тогда 
		ТаблицаВозможностей.Свернуть("ЗначениеПоУмолчанию, Имя");
		Возврат ТаблицаВозможностей;
	КонецЕсли;
	
	Для каждого ОписаниеПриложения Из ОписаниеДоступныхПриложений Цикл
		Попытка
			МодульПриложения = ОбщегоНазначения.ОбщийМодуль(ОписаниеПриложения.МодульПриложения);
			ДоступныеЕБВФункциональныеВозможностиПриложения = МодульПриложения.ЕБВФункциональныеВозможностиПриложения();
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДоступныеЕБВФункциональныеВозможностиПриложения, ТаблицаВозможностей);
		Исключение
			
			Комментарий = НСтр("ru='Ошибка при попытке сформировать список доступных возможностей ЕБВ по причине:
			|%2.'");
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			Комментарий = СтрШаблон(Комментарий, ОписаниеПриложения.Имя, ТекстОшибки);
			ЗаписьЖурналаРегистрации(ИмяЖР(), УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	// Удаляем ФО с типами, которых нет в таблице
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ЗначениеПоУмолчанию", Неопределено);
	МассивСтрокДляУдаления = ДоступныеЕБВФункциональныеВозможностиПриложения.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаДляУдаления Из МассивСтрокДляУдаления Цикл
		ДоступныеЕБВФункциональныеВозможностиПриложения.Удалить(СтрокаДляУдаления);
	КонецЦикла;

	ТаблицаВозможностей.Свернуть("ЗначениеПоУмолчанию, Имя");
	Возврат ТаблицаВозможностей;
	
КонецФункции

Функция ИзмененныеФОЕБВ(ДоступныеВозможностиЕБВ) 
	
	ИзмененныеФО = ДоступныеВозможностиЕБВ.СкопироватьКолонки();
	ИзмененныеФО.Колонки.Добавить("Изменена", Новый ОписаниеТипов("Булево"));
	ИзмененныеФО.Колонки.Добавить("ЗначениеАктуальное", Новый ОписаниеТипов(ТипыЗначенийФОЕБВ()));

	Для Каждого Строка Из ДоступныеВозможностиЕБВ Цикл
		ИмяКонстанты = Строка.Имя;
		Значение = Константы[ИмяКонстанты].Получить();
		Если Значение <> Строка.ЗначениеПоУмолчанию Тогда
			СтрокаИзмененная = ИзмененныеФО.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаИзмененная, Строка);
			СтрокаИзмененная.Изменена = Истина;
			СтрокаИзмененная.ЗначениеАктуальное = Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат ИзмененныеФО;
	
КонецФункции

Функция ТипыЗначенийФОЕБВ()
	
	Возврат Метаданные.ОпределяемыеТипы.ТипыЗначенийФОЕБВ.Тип;
	
КонецФункции

Процедура ВосстановитьСохранившиесяФО(ИзмененныеФо, ДоступныеПослеОбновленияФО)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзмененныеФо.ЗначениеАктуальное КАК ЗначениеАктуальное,
		|	ИзмененныеФо.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
		|	ИзмененныеФо.Изменена КАК Изменена,
		|	ИзмененныеФо.Имя КАК Имя
		|ПОМЕСТИТЬ втИзмененныеФо
		|ИЗ
		|	&ИзмененныеФо КАК ИзмененныеФо
		|ГДЕ
		|	ИзмененныеФо.Изменена = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДоступныеФО.Имя КАК Имя,
		|	втДоступныеФО.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
		|ПОМЕСТИТЬ втДоступныеФО
		|ИЗ
		|	&втДоступныеФО КАК втДоступныеФО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втИзмененныеФо.ЗначениеАктуальное КАК ЗначениеАктуальное,
		|	втИзмененныеФо.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
		|	втИзмененныеФо.Изменена КАК Изменена,
		|	втИзмененныеФо.Имя КАК Имя
		|ИЗ
		|	втИзмененныеФо КАК втИзмененныеФо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втДоступныеФО КАК втДоступныеФО
		|		ПО ((ВЫРАЗИТЬ(втИзмененныеФо.Имя КАК СТРОКА(150))) = (ВЫРАЗИТЬ(втДоступныеФО.Имя КАК СТРОКА(150))))
		|ГДЕ
		|	втИзмененныеФо.ЗначениеАктуальное <> втИзмененныеФо.ЗначениеПоУмолчанию";
	Запрос.УстановитьПараметр("ИзмененныеФо", ИзмененныеФо);
	Запрос.УстановитьПараметр("втДоступныеФО", ДоступныеПослеОбновленияФО);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	МассивВосстановленныхФО = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Попытка
			ИмяКонстанты = ВыборкаДетальныеЗаписи.Имя;
			Константы[ИмяКонстанты].Установить(ВыборкаДетальныеЗаписи.ЗначениеАктуальное);
			СтрокиИзмененная = ИзмененныеФо.НайтиСтроки(Новый Структура("Имя", ИмяКонстанты));
			Если СтрокиИзмененная.Количество() > 0 Тогда
				ИзмененныеФо.Удалить(СтрокиИзмененная[0]);	
			КонецЕсли;
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Комментарий = НСтр("ru='Ошибка попытки установки значения ""%1"" в константу ""%2"" по причине:
			|%3.'");
			Комментарий = СтрШаблон(Комментарий, Ложь, ИмяКонстанты, ТекстОшибки);
			ЗаписьЖурналаРегистрации(ТарификацияБизнес.ИмяЖР(), УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура СохранитьБолееНедоступныеФО(ИзмененныеФо, ДоступныеВозможностиЕБВ, ДоступныеВозможностиЕБВ_После)

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзмененныеФо.ЗначениеАктуальное КАК ЗначениеАктуальное,
		|	ИзмененныеФо.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
		|	ИзмененныеФо.Изменена КАК Изменена,
		|	ИзмененныеФо.Имя КАК Имя
		|ПОМЕСТИТЬ втИзмененныеФо
		|ИЗ
		|	&ИзмененныеФо КАК ИзмененныеФо
		|ГДЕ
		|	ИзмененныеФо.Изменена = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДоступныеФО.Имя КАК Имя,
		|	втДоступныеФО.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
		|ПОМЕСТИТЬ втДоступныеФО
		|ИЗ
		|	&втДоступныеФО КАК втДоступныеФО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДоступныеФОПосле.Имя КАК Имя,
		|	втДоступныеФОПосле.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
		|ПОМЕСТИТЬ втДоступныеФОПосле
		|ИЗ
		|	&втДоступныеФОПосле КАК втДоступныеФОПосле
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втДоступныеФО.Имя КАК Имя,
		|	втДоступныеФО.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
		|ПОМЕСТИТЬ втНедоступныеФО
		|ИЗ
		|	втДоступныеФО КАК втДоступныеФО
		|		ЛЕВОЕ СОЕДИНЕНИЕ втДоступныеФОПосле КАК втДоступныеФОПосле
		|		ПО ВЫРАЗИТЬ(втДоступныеФО.Имя КАК СТРОКА(150)) = ВЫРАЗИТЬ(втДоступныеФОПосле.Имя КАК СТРОКА(150))
		|ГДЕ
		|	втДоступныеФОПосле.ЗначениеПоУмолчанию ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втИзмененныеФо.ЗначениеАктуальное КАК ЗначениеАктуальное,
		|	втИзмененныеФо.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
		|	втИзмененныеФо.Изменена КАК Изменена,
		|	втИзмененныеФо.Имя КАК Имя
		|ИЗ
		|	втИзмененныеФо КАК втИзмененныеФо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втНедоступныеФО КАК втНедоступныеФО
		|		ПО ВЫРАЗИТЬ(втИзмененныеФо.Имя КАК СТРОКА(150)) = ВЫРАЗИТЬ(втНедоступныеФО.Имя КАК СТРОКА(150))";
	Запрос.УстановитьПараметр("ИзмененныеФо", ИзмененныеФо);
	Запрос.УстановитьПараметр("втДоступныеФО", ДоступныеВозможностиЕБВ);
	Запрос.УстановитьПараметр("втДоступныеФОПосле", ДоступныеВозможностиЕБВ_После);  
	ПоддерживаемыеТипы = Метаданные.ОпределяемыеТипы.ТипыЗначенийФОЕБВ.Тип;

	Выборка = Запрос.Выполнить().Выбрать();                                          
	
	Пока Выборка.Следующий() Цикл 
		ТипЕстьВРегистре = ПоддерживаемыеТипы.СодержитТип(ТипЗнч(Выборка.ЗначениеАктуальное));
		Если ТипЕстьВРегистре <> Истина Тогда
			Продолжить;	
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ИзмененныеФО.СоздатьНаборЗаписей();
	    НаборЗаписей.Отбор.ИмяФО.Установить(СокрЛП(Выборка.Имя));
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		СтрокаЗапись = НаборЗаписей.Добавить(); 
		СтрокаЗапись.ИмяФО = СокрЛП(Выборка.Имя);
		СтрокаЗапись.Значение = Выборка.ЗначениеАктуальное;
		НаборЗаписей.Записать(Истина);
	КонецЦикла;	

	//УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

