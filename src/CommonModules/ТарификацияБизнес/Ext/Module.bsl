		|	ИзмененныеФО.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ИзмененныеФО КАК ИзмененныеФО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВновьДоступныеФО КАК втВновьДоступныеФО
		|		ПО ВЫРАЗИТЬ(ИзмененныеФО.ИмяФО КАК СТРОКА(150)) = ВЫРАЗИТЬ(втВновьДоступныеФО.Имя КАК СТРОКА(150))";
	Запрос.УстановитьПараметр("ИзмененныеФо", ИзмененныеФо);
	Запрос.УстановитьПараметр("втДоступныеФО", ДоступныеВозможностиЕБВ);
	Запрос.УстановитьПараметр("втДоступныеФОПосле", ДоступныеВозможностиЕБВ_После);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ИмяКонстанты = Выборка.Имя;
			Значение = Константы[ИмяКонстанты].Получить();
			Если Значение <> Выборка.Значение Тогда
				Константы[ИмяКонстанты].Установить(Выборка.Значение);
			КонецЕсли;
			НаборЗаписей = РегистрыСведений.ИзмененныеФО.СоздатьНаборЗаписей();
	   	 	НаборЗаписей.Отбор.ИмяФО.Установить(Выборка.Имя);
            НаборЗаписей.Записать();
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Комментарий = НСтр("ru='Ошибка попытки установки значения ""%1"" в константу ""%2"" по причине:
			|%3.'");
			Комментарий = СтрШаблон(Комментарий, Ложь, ИмяКонстанты, ТекстОшибки);
			ЗаписьЖурналаРегистрации(ТарификацияБизнес.ИмяЖР(), УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
			ВызватьИсключение;
			
		КонецПопытки;
	КонецЦикла;	

	//УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура УдалитьИгнорируемыеФО(ИзмененныеФО)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзмененныеФо.ЗначениеАктуальное КАК ЗначениеАктуальное,
		|	ИзмененныеФо.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
		|	ИзмененныеФо.Изменена КАК Изменена,
		|	ИзмененныеФо.Имя КАК Имя
		|ПОМЕСТИТЬ втИзмененныеФо
		|ИЗ
		|	&ИзмененныеФО КАК ИзмененныеФо
		|ГДЕ
		|	ИзмененныеФо.Изменена = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втИгнорируемыеФО.Имя КАК Имя,
		|	втИгнорируемыеФО.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
		|ПОМЕСТИТЬ втИгнорируемыеФО
		|ИЗ
		|	&втИгнорируемыеФО КАК втИгнорируемыеФО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	втИзмененныеФо.ЗначениеАктуальное КАК ЗначениеАктуальное,
		|	втИзмененныеФо.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
		|	втИзмененныеФо.Изменена КАК Изменена,
		|	втИзмененныеФо.Имя КАК Имя
		|ИЗ
		|	втИзмененныеФо КАК втИзмененныеФо
		|		ЛЕВОЕ СОЕДИНЕНИЕ втИгнорируемыеФО КАК втИгнорируемыеФО
		|		ПО ВЫРАЗИТЬ(втИзмененныеФо.Имя КАК СТРОКА(150)) = ВЫРАЗИТЬ(втИгнорируемыеФО.Имя КАК СТРОКА(150))
		|ГДЕ
		|	втИгнорируемыеФО.ЗначениеПоУмолчанию ЕСТЬ NULL";  
	Запрос.УстановитьПараметр("ИзмененныеФО", ИзмененныеФо);
	Запрос.УстановитьПараметр("втИгнорируемыеФО", ТаблицаИгнорируемыхФО());
	
	ИзмененныеФО = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

#КонецОбласти

Функция НовыйОписаниеПриложения()
	
	ОписаниеПриложения = Новый Структура;
	ОписаниеПриложения.Вставить("Имя", "");
	ОписаниеПриложения.Вставить("Синоним", "");
	ОписаниеПриложения.Вставить("ИдентификаторУслугиСервиса", "");
	ОписаниеПриложения.Вставить("МодульПриложения", "");
	ОписаниеПриложения.Вставить("ЗамещаетПриложения", Новый Массив);
	ОписаниеПриложения.Вставить("СовместныеПриложения", Новый Массив);
	ОписаниеПриложения.Вставить("ЭтоБизнесПриложение", Ложь);
	Возврат ОписаниеПриложения;
	
КонецФункции

Функция ПодключенныеУслугиПриложений()
	
	ИдентификаторПоставщикаУНФ = ТарификацияУНФ.ИдентификаторПоставщикаУНФ();
	
	ВсеУслугиПриложений = СписокУслуг();
	Результат = Новый Массив;
	
	Для каждого ОписаниеУслуги Из ВсеУслугиПриложений Цикл
		Если Тарификация.ЗарегистрированаЛицензияБезлимитнойУслуги(ИдентификаторПоставщикаУНФ, ОписаниеУслуги.Идентификатор) Тогда
			Результат.Добавить(ОписаниеУслуги.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПриложенияПоИдентификаторамУслуг(ИдентификаторыУслуг)
	
	Если ТипЗнч(ИдентификаторыУслуг) <> Тип("Массив") Тогда
		ОтборИдентификаторыУслуг = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдентификаторыУслуг);
	Иначе
		ОтборИдентификаторыУслуг = ИдентификаторыУслуг;
	КонецЕсли;
	
	Результат = Новый Массив;
	ОписаниеПриложений = ОписаниеВсехПриложений();
	
	Для каждого ОписаниеПриложения Из ОписаниеПриложений Цикл
		Если ОтборИдентификаторыУслуг.Найти(ОписаниеПриложения.ИдентификаторУслугиСервиса) <> Неопределено Тогда
			Результат.Добавить(ОписаниеПриложения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПриложениеЗамещено(
	ОписаниеПриложения, ОписаниеВсехПриложений = Неопределено, ОписаниеПриложенийДляПроверки = Неопределено)
	
	Если ОписаниеВсехПриложений = Неопределено Тогда
		ОписаниеВсехПриложений = ОписаниеВсехПриложений();
	КонецЕсли;
	
	Если ОписаниеПриложенийДляПроверки = Неопределено Тогда
		ОписаниеПриложенийДляПроверки = РегистрыСведений.ПодключениеКомбинированныхПриложений.ПодключенныеПриложения();
	КонецЕсли;
	
	НовыеПриложенияДляПроверки = Новый Массив;
	Для Каждого Приложение Из ОписаниеПриложенийДляПроверки Цикл
		
		Для Каждого ЗамещаемоеПриложение Из Приложение.ЗамещаетПриложения Цикл
			
			Если ЗамещаемоеПриложение = ОписаниеПриложения.Имя Тогда
				Возврат Истина;
			КонецЕсли;
			
			ОписаниеПриложенияДляПроверки = ОписаниеПриложенияПоИмени(ЗамещаемоеПриложение, ОписаниеВсехПриложений);
			НовыеПриложенияДляПроверки.Добавить(ОписаниеПриложенияДляПроверки);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если НовыеПриложенияДляПроверки.Количество() Тогда
		Возврат ЭтоПриложениеЗамещено(ОписаниеПриложения, ОписаниеВсехПриложений, НовыеПриложенияДляПроверки);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ОписаниеПриложенияПоИмени(Имя, ОписаниеВсехПриложений)
	
	Для Каждого Описание Из ОписаниеВсехПриложений Цикл
		Если Описание.Имя = Имя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Процедура ПолучитьВерхнеуровневоеПриложение(ОписаниеЗамещаемыхПриложений)
	
	МассивВложенныхПриложений = Новый Массив;
	Для Каждого Приложение Из ОписаниеЗамещаемыхПриложений Цикл     
		Для Каждого ЗамещаемоеПриложение Из Приложение.ЗамещаетПриложения Цикл
			МассивВложенныхПриложений.Добавить(ЗамещаемоеПриложение);	
		КонецЦикла;
	КонецЦикла; 
	ИтоговоеОписаниеПриложений = Новый Массив;
	Для Каждого ОписаниеПриложения Из ОписаниеЗамещаемыхПриложений Цикл
		Если МассивВложенныхПриложений.Найти(ОписаниеПриложения.Имя) = Неопределено Тогда
			ИтоговоеОписаниеПриложений.Добавить(ОписаниеПриложения); 	
		КонецЕсли;
	КонецЦикла;    
	
	ОписаниеЗамещаемыхПриложений = ИтоговоеОписаниеПриложений;
	
КонецПроцедуры

#Область РегламентноеЗадание   

Процедура АктуализацияСостоянийПодключенныхПодписок() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.АктуализацияСостоянийПодключенныхПодписок);
	
	АктуализироватьСостояниеПодписок();
	
КонецПроцедуры  

Процедура АктуализироватьСостояниеПодписок() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);  
	ДоступныеПриложения = ОписаниеВсехПриложений();
	
	ТаблицаДанные = Новый ТаблицаЗначений;
	ТаблицаДанные.Колонки.Добавить("ИдентификаторПоставщика", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТаблицаДанные.Колонки.Добавить("ИдентификаторУслуги", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));   
	ИдентификаторПоставщикаУНФ = ТарификацияУНФ.ИдентификаторПоставщикаУНФ();
	
	ТаблицаЗамещение = Новый ТаблицаЗначений; 
	ТаблицаЗамещение.Колонки.Добавить("ИдентификаторУслуги", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТаблицаЗамещение.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255)));
 	ТаблицаЗамещение.Колонки.Добавить("ЗамещаемыеПриложения", Новый ОписаниеТипов("Массив"));

	Для Каждого ОписаниеПриложения Из ДоступныеПриложения Цикл
		СтрокаДанные = ТаблицаДанные.Добавить();
		СтрокаДанные.ИдентификаторУслуги = ОписаниеПриложения.ИдентификаторУслугиСервиса;
		СтрокаДанные.ИдентификаторПоставщика = ИдентификаторПоставщикаУНФ; 
		СтрокаЗамещение =  ТаблицаЗамещение.Добавить();
		СтрокаЗамещение.Имя = ОписаниеПриложения.Имя;
		СтрокаЗамещение.ИдентификаторУслуги = ОписаниеПриложения.ИдентификаторУслугиСервиса;
		ЗамещаемыйМассив = Новый Массив;
		Для Каждого ЭлементЗамещаемый Из ОписаниеПриложения.ЗамещаетПриложения Цикл
			ЗамещаемыйМассив.Добавить(ЭлементЗамещаемый);
		КонецЦикла;		                                 
		СтрокаЗамещение.ЗамещаемыеПриложения = ЗамещаемыйМассив;
	КонецЦикла;  
	
	ДанныеЛицензийБезлимитныхУслуг = Тарификация.ДанныеЛицензийБезлимитныхУслуг(ТаблицаДанные, ТекущаяУниверсальнаяДата());
	ДанныеЛицензийБезлимитныхУслуг.Колонки.Добавить("ДоступнаПослеУдаления", Новый ОписаниеТипов("Булево")); 
	
	ОписаниеСобытия = НСтр("ru='Запуск регламентного задания по актуализации лицензий.'");
	ЗаписьЖурналаРегистрации(ИмяЖР(), УровеньЖурналаРегистрации.Информация,,, ОписаниеСобытия);
	
	КопияСАктуальнымиПриложениями = ДанныеЛицензийБезлимитныхУслуг.СкопироватьКолонки();  
	ПодключенныеПриложения = РегистрыСведений.ПодключениеКомбинированныхПриложений.ПодключенныеПриложения();	
	
	ДоступныеВозможностиЕБВ = ДоступныеВозможностиПриложенийЕБВ(ПодключенныеПриложения);
	ИзмененныеФОЕБВ = ИзмененныеФОЕБВ(ДоступныеВозможностиЕБВ); 
	УдалитьИгнорируемыеФО(ИзмененныеФОЕБВ);
	
	МассивПодключенных = Новый Массив;
	Для Каждого СтрокаПодключенная Из ПодключенныеПриложения Цикл
		МассивПодключенных.Добавить(СтрокаПодключенная.ИдентификаторУслугиСервиса);
		СтрокиПриложение = ДанныеЛицензийБезлимитныхУслуг.НайтиСтроки(Новый Структура("ИдентификаторУслуги", СтрокаПодключенная.ИдентификаторУслугиСервиса));
		Если СтрокиПриложение.Количество() = 1 Тогда
			СтрокаТаблицы = СтрокиПриложение[0];
			Если СтрокаТаблицы.Действует = Ложь Тогда
				СтрокаКопия = КопияСАктуальнымиПриложениями.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКопия, СтрокаТаблицы);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;    
	
	СтрокиДействующие = ДанныеЛицензийБезлимитныхУслуг.НайтиСтроки(Новый Структура("Действует", Истина));
	МассивЗамещаемых = Новый Массив;
	Для Каждого СтрокаЛицензии Из СтрокиДействующие Цикл 
		СтрокиЗамещение = ТаблицаЗамещение.НайтиСтроки(Новый Структура("ИдентификаторУслуги", СтрокаЛицензии.ИдентификаторУслуги));
		Если СтрокиЗамещение.Количество() > 0 Тогда
			ЗамещаемыеПриложения = СтрокиЗамещение[0].ЗамещаемыеПриложения;
			Для Каждого Элемент Из ЗамещаемыеПриложения Цикл
				СтрокаИдентификатор = ТаблицаЗамещение.НайтиСтроки(Новый Структура("Имя", Элемент));
				Если СтрокаИдентификатор.Количество() > 0 Тогда
					МассивЗамещаемых.Добавить(СтрокаИдентификатор[0].ИдентификаторУслуги);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;    
	
	Для Каждого СтрокаЛицензии Из СтрокиДействующие Цикл
		Если МассивПодключенных.Найти(СтрокаЛицензии.ИдентификаторУслуги) = Неопределено И 
				МассивЗамещаемых.Найти(СтрокаЛицензии.ИдентификаторУслуги) = Неопределено Тогда
			СтрокаКопия = КопияСАктуальнымиПриложениями.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКопия, СтрокаЛицензии);
		КонецЕсли;
	КонецЦикла;    
	ДанныеЛицензийБезлимитныхУслуг = КопияСАктуальнымиПриложениями;	
	
	МассивВключенныхЗамещенныхПриложений = Новый Массив;
	Для Каждого Строка Из ДанныеЛицензийБезлимитныхУслуг Цикл
		Если Строка.Действует = Истина Тогда    
			СтрокиЗамещение = ТаблицаЗамещение.НайтиСтроки(Новый Структура("ИдентификаторУслуги", Строка.ИдентификаторУслуги));
			Для Каждого СтрокаЗамещение Из СтрокиЗамещение Цикл
				Для Каждого ЭлементЗамещение Из СтрокаЗамещение.ЗамещаемыеПриложения Цикл
					Если МассивВключенныхЗамещенныхПриложений.Найти(ЭлементЗамещение) = Неопределено Тогда
						МассивВключенныхЗамещенныхПриложений.Добавить(ЭлементЗамещение);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла; 
	Для Каждого Строка Из ДанныеЛицензийБезлимитныхУслуг Цикл
		Если Строка.Действует = Ложь Тогда  
			СтрокиИмя = ТаблицаЗамещение.НайтиСтроки(Новый Структура("ИдентификаторУслуги", Строка.ИдентификаторУслуги));
			Если СтрокиИмя.Количество() > 0 Тогда
				Имя = СтрокиИмя[0].Имя;
				Если МассивВключенныхЗамещенныхПриложений.Найти(Имя) <> Неопределено Тогда
					Строка.ДоступнаПослеУдаления = Истина;	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 

	Для Каждого Строка Из ДанныеЛицензийБезлимитныхУслуг Цикл
		ПараметрыЛицензии = Новый Структура;
		ПараметрыЛицензии.Вставить("Услуга", Строка.Ссылка);
		ПараметрыЛицензии.Вставить("ДоступнаПослеУдаления", Строка.ДоступнаПослеУдаления);
		ПараметрыЛицензии.Вставить("ИдентификаторУслуги", Строка.ИдентификаторУслуги);
		ПараметрыЛицензии.Вставить("НомерЛицензии", "Регламентное");
		// Фикс Опопвещения
		Если Строка.Действует = Истина Тогда 
			ПараметрыЛицензии.Вставить("НеОповещать", Истина);
		КонецЕсли;
		ОписаниеСобытия = НСтр("ru='Регламентное. Удаление лицензии: ""%1""'");
		ОписаниеСобытия = СтрШаблон(ОписаниеСобытия, ПараметрыЛицензии.ИдентификаторУслуги);
		ЗаписьЖурналаРегистрации(ИмяЖР(), УровеньЖурналаРегистрации.Информация,,, ОписаниеСобытия);
		
		ПриУдаленииДоступныхЛицензий(ПараметрыЛицензии);
		Если Строка.Действует = Истина Тогда
	       	//@skip-check query-in-loop	
			ПодключенныеПриложения = РегистрыСведений.ПодключениеКомбинированныхПриложений.ПодключенныеПриложения();
			УжеПодключено = Ложь;
			Для Каждого СтрокаПодключенная Из ПодключенныеПриложения Цикл
				Если СтрокаПодключенная.ИдентификаторУслугиСервиса = Строка.ИдентификаторУслуги Тогда
					УжеПодключено = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;      
			Если УжеПодключено = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			ОписаниеСобытия = НСтр("ru='Регламентное. Обновление лицензии: ""%1""'");
			ОписаниеСобытия = СтрШаблон(ОписаниеСобытия, ПараметрыЛицензии.ИдентификаторУслуги);
			ЗаписьЖурналаРегистрации(ИмяЖР(), УровеньЖурналаРегистрации.Информация,,, ОписаниеСобытия);
       		ПриОбновленииДоступныхЛицензий(ПараметрыЛицензии);
		КонецЕсли;
	КонецЦикла;        

	ОписаниеСобытия = НСтр("ru='Завершение регламентного задания по актуализации лицензий.'");
	ЗаписьЖурналаРегистрации(ИмяЖР(), УровеньЖурналаРегистрации.Информация,,, ОписаниеСобытия);
	
	ПодключенныеПриложенияПосле = РегистрыСведений.ПодключениеКомбинированныхПриложений.ПодключенныеПриложения(); 
	ДоступныеВозможностиЕБВ_После = ДоступныеВозможностиПриложенийЕБВ(ПодключенныеПриложенияПосле);
	
	ВосстановитьСохранившиесяФО(ИзмененныеФОЕБВ, ДоступныеВозможностиЕБВ_После);	
	СохранитьБолееНедоступныеФО(ИзмененныеФОЕБВ, ДоступныеВозможностиЕБВ, ДоступныеВозможностиЕБВ_После);
	ВосстановитьВновьДоступныеФО(ИзмененныеФОЕБВ, ДоступныеВозможностиЕБВ, ДоступныеВозможностиЕБВ_После);	
	
	УстановитьПривилегированныйРежим(Ложь);  
	
КонецПроцедуры	

Процедура ВключитьРегламентноеЗаданиеАктуализацияСостоянийПодключенныхПодписок()
	
	РегламентноеЗадание = Метаданные.РегламентныеЗадания.АктуализацияСостоянийПодключенныхПодписок;
	Задание = РегламентныеЗаданияСервер.Задание(РегламентноеЗадание);
	Если Задание = Неопределено Тогда
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("Метаданные", РегламентноеЗадание);
		ПараметрыЗадания.Вставить("Использование", Истина);
		ПараметрыЗадания.Вставить("Расписание", РасписаниеРегламентногоЗаданияАктуализацияСостоянийПодключенныхПодписок());
		ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении", ?(ОбщегоНазначения.РежимОтладки(), 20, 3600));
		ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении", 3);  
		Если ЗначениеЗаполнено(РегламентноеЗадание.Ключ) Тогда
			ПараметрыЗадания.Вставить("Ключ", РегламентноеЗадание.Ключ);
		КонецЕсли;		
		РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);
	КонецЕсли;

КонецПроцедуры
 
Функция РасписаниеРегламентногоЗаданияАктуализацияСостоянийПодключенныхПодписок()
	
	Месяцы = Новый Массив;
	Месяцы.Добавить(1);
	Месяцы.Добавить(2);
	Месяцы.Добавить(3);
	Месяцы.Добавить(4);
	Месяцы.Добавить(5);
	Месяцы.Добавить(6);
	Месяцы.Добавить(7);
	Месяцы.Добавить(8);
	Месяцы.Добавить(9);
	Месяцы.Добавить(10);
	Месяцы.Добавить(11);
	Месяцы.Добавить(12);
	
	ДниНедели = Новый Массив;
	ДниНедели.Добавить(1);
	ДниНедели.Добавить(2);
	ДниНедели.Добавить(3);
	ДниНедели.Добавить(4);
	ДниНедели.Добавить(5);
	ДниНедели.Добавить(6);
	ДниНедели.Добавить(7);
	
	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ДниНедели   = ДниНедели;
	Расписание.Месяцы      = Месяцы;
	Расписание.ПериодПовтораВТечениеДня = 3600 * 12;
	Расписание.ПериодПовтораДней        = 1; // Каждый день.
	
	Возврат Расписание;
	
КонецФункции

