Процедура ОбработатьПодключениеПриложения(
	ОписаниеНовогоПриложения,
	ПричинаПодключения,
	ПроверятьЛицензии,
	ОтправлятьОповещение = Ложь,
	ОчищатьНастройкиПользователя = Истина) Экспорт
	
	ОписаниеДоступныхПриложений = ДоступныеПриложения(ПроверятьЛицензии, Истина);
	ОписаниеДоступныхПриложений = УдалитьПриложениеИзСписка(ОписаниеДоступныхПриложений, ОписаниеНовогоПриложения.Имя);
	
	ПодключенноеПриложениеАктуально = Истина;   
	Если ПроверятьЛицензии = Истина Тогда
		ПодключенноеПриложениеАктуально = Тарификация.ЗарегистрированаЛицензияБезлимитнойУслуги(
												ТарификацияУНФ.ИдентификаторПоставщикаУНФ(), ОписаниеНовогоПриложения.ИдентификаторУслугиСервиса);
	КонецЕсли;
	
	ПриложенияДляОтключения = Новый Массив;
	ПриложенияДляПодключения = Новый Массив;
	
	ЗамещаемыеПриложенияПодключаемогоПриложения = ОписаниеНовогоПриложения.ЗамещаетПриложения;
	ОписаниеЗамещаемыхПриложений = ОписаниеВыбранныхПриложений(ОписаниеДоступныхПриложений, ЗамещаемыеПриложенияПодключаемогоПриложения);
	СовместныеПриложенияПодключаемогоПриложения = ОписаниеНовогоПриложения.СовместныеПриложения;
	ОписаниеСовместныхПриложений = ОписаниеВыбранныхПриложений(ОписаниеДоступныхПриложений, СовместныеПриложенияПодключаемогоПриложения);
	
	КоличествоДоступныхПриложений = ОписаниеДоступныхПриложений.Количество() - ОписаниеСовместныхПриложений.Количество();
	ЭтоЗамещениеПриложения = ОписаниеЗамещаемыхПриложений.Количество() >= КоличествоДоступныхПриложений;
	
	ЗамещаемыеПриложенияПодключенныхПриложений = ЗамещаемыеПриложенияПодключенныхПриложений(ОписаниеДоступныхПриложений);
	ПодключаетсяЗамещаемоеПриложение = ЗамещаемыеПриложенияПодключенныхПриложений.Найти(ОписаниеНовогоПриложения.Имя) <> Неопределено;
	
	Если ОчищатьНастройкиПользователя И ЭтоЗамещениеПриложения И ПодключенноеПриложениеАктуально = Истина Тогда
		ПриложенияДляОтключения = ОписаниеЗамещаемыхПриложений;
		РабочийСтолУНФ.ОчиститьРабочийСтол();
		РабочийСтолУНФ.ОчиститьНастройкиСоставаИнтерфейса();
	КонецЕсли;
	
	Если НЕ ПодключаетсяЗамещаемоеПриложение И ПодключенноеПриложениеАктуально = Истина Тогда       
		ПриложенияДляПодключения.Добавить(ОписаниеНовогоПриложения);
	КонецЕсли;
	
	ДоступныеВозможностиПриложений = ДоступныеВозможностиПриложений(ОписаниеДоступныхПриложений, ЗамещаемыеПриложенияПодключаемогоПриложения);
	ОтключитьПриложения(ПриложенияДляОтключения, ПричинаПодключения, ДоступныеВозможностиПриложений);
	ПодключитьПриложения(ПриложенияДляПодключения, ПричинаПодключения);
	
	Если ОтправлятьОповещение И НЕ ПодключаетсяЗамещаемоеПриложение Тогда
		ОповеститьОПодключенномПриложении(ОписаниеНовогоПриложения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьОтключениеПриложения(
	ОписаниеОтключаемогоПриложения,
	ПричинаОтключения,
	ПроверятьЛицензии,
	ОтправлятьОповещение = Ложь,
	ОчищатьНастройкиПользователя = Истина) Экспорт
	
	ПриложенияДляОтключения = Новый Массив;
	ПриложенияДляПодключения = Новый Массив;
	
	ОписаниеДоступныхПриложений = ДоступныеПриложения(ПроверятьЛицензии, Истина);      
	ОписаниеДоступныхПриложений = УдалитьПриложениеИзСписка(ОписаниеДоступныхПриложений, ОписаниеОтключаемогоПриложения.Имя);
	
	ЗамещаемыеПриложенияОтключаемогоПриложения = ОписаниеОтключаемогоПриложения.ЗамещаетПриложения;
	ОписаниеЗамещаемыхПриложений = ОписаниеВыбранныхПриложений(ОписаниеДоступныхПриложений, ЗамещаемыеПриложенияОтключаемогоПриложения);
	СовместныеПриложенияОтключаемогоПриложения = ОписаниеОтключаемогоПриложения.СовместныеПриложения;
	ОписаниеСовместныхПриложений = ОписаниеВыбранныхПриложений(ОписаниеДоступныхПриложений, СовместныеПриложенияОтключаемогоПриложения);
	
	КоличествоДоступныхПриложений = ОписаниеДоступныхПриложений.Количество() - ОписаниеСовместныхПриложений.Количество();
	ЭтоЗамещениеПриложения = ОписаниеЗамещаемыхПриложений.Количество() >= КоличествоДоступныхПриложений;
	
	Если ОчищатьНастройкиПользователя И ЭтоЗамещениеПриложения Тогда
		ПриложенияДляОтключения = ОписаниеСовместныхПриложений;
		РабочийСтолУНФ.ОчиститьРабочийСтол();
		РабочийСтолУНФ.ОчиститьНастройкиСоставаИнтерфейса();
	КонецЕсли;
	
	ПриложенияДляОтключения.Добавить(ОписаниеОтключаемогоПриложения);
	
	ДоступныеВозможностиПриложений = ДоступныеВозможностиПриложений(ОписаниеДоступныхПриложений);
	ОтключитьПриложения(ПриложенияДляОтключения, ПричинаОтключения, ДоступныеВозможностиПриложений);
	
	//новое подключение
	Если ЭтоЗамещениеПриложения Тогда
		ПолучитьВерхнеуровневоеПриложение(ОписаниеЗамещаемыхПриложений);	
		ПодключитьПриложения(ОписаниеЗамещаемыхПриложений, ПричинаОтключения);
	КонецЕсли;
	
	Если ОтправлятьОповещение И Не ЭтоПриложениеЗамещено(ОписаниеОтключаемогоПриложения) Тогда
		ОповеститьОбОтключенномПриложении(ОписаниеОтключаемогоПриложения);
	КонецЕсли;
	
КонецПроцедуры

Функция ПриложениеМожетБытьПодключено(ОписаниеПриложения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Результат", Истина);
	Результат.Вставить("Причина", "");
	
	Если Не ОбщегоНазначения.РазделениеВключено() Тогда
		Если ВозможностиПриложения.ЭтоБизнесПриложение() Тогда
			Возврат Результат;
		Иначе
			Результат.Результат = Ложь;
			Результат.Причина = НСтр("ru='Приложение может быть подключено только в режиме запуска комбинированного приложения.'");
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	ЗарегистрированаЛицензия = Тарификация.ЗарегистрированаЛицензияБезлимитнойУслуги(
		ТарификацияУНФ.ИдентификаторПоставщикаУНФ(), ОписаниеПриложения.ИдентификаторУслугиСервиса);
	
	Если Не ЗарегистрированаЛицензия Тогда
		Результат.Результат = Ложь;
		Результат.Причина = НСтр("ru='Не подключена услуга ""%1"".'");
		Результат.Причина = СтрШаблон(Результат.Причина, ОписаниеПриложения.ИдентификаторУслугиСервиса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОтключитьВсеПриложения(Причина, ПроверятьЛицензии = Ложь, ТолькоБизнесПриложения = Ложь) Экспорт
	
	ОписаниеПриложений = ДоступныеПриложения(ПроверятьЛицензии);
	Для Каждого ОписаниеПриложения Из ОписаниеПриложений Цикл
		
		Если Не ОписаниеПриложения.ЭтоБизнесПриложение Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработатьОтключениеПриложения(ОписаниеПриложения, Причина, ПроверятьЛицензии, , Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИмяМодуляПоИдентификаторуПриложения(Идентификатор)
	
	ОписаниеВсехПриложений = ОписаниеВсехПриложений();
	Для Каждого ОписаниеПриложения Из ОписаниеВсехПриложений Цикл
		Если ОписаниеПриложения.ИдентификаторУслугиСервиса = Идентификатор Тогда
			Возврат ОписаниеПриложения.МодульПриложения;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьИдентификаторПоИмениПриложения(ИмяПриложения) Экспорт
	
	ОписаниеВсехПриложений = ОписаниеВсехПриложений();
	Для Каждого ОписаниеПриложения Из ОписаниеВсехПриложений Цикл
		Если ОписаниеПриложения.Имя = ИмяПриложения Тогда
			Возврат ОписаниеПриложения.ИдентификаторУслугиСервиса;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьТаблицыДоступныхИИзмененных() Экспорт
	
	ИмяТекущегоВидаПриложения = ВидыПриложенийСервер.ИмяТекущегоВидаПриложения();
	
	Если ИмяТекущегоВидаПриложения = "" ИЛИ ИмяТекущегоВидаПриложения <> "Бизнес"  Тогда
		Список = Новый СписокЗначений; 
		ТаблицаДоступных = ТарификацияБизнес.НоваяТаблицаВозможностей();
		ТаблицаДоступных.Свернуть("ЗначениеПоУмолчанию, Имя");

		ТаблицаИзмененных = ТарификацияБизнес.НоваяТаблицаВозможностей();
		ТаблицаИзмененных.Колонки.Добавить("Изменена", Новый ОписаниеТипов("Булево"));
		ТаблицаИзмененных.Колонки.Добавить("ЗначениеАктуальное", Новый ОписаниеТипов(ТипыЗначенийФОЕБВ()));
	
		
		Список.Добавить(ТаблицаДоступных, "ДоступныеВозможностиЕБВ");
		Список.Добавить(ТаблицаИзмененных, "ИзмененныеФОЕБВ");
		
		Возврат Список;
	КонецЕсли;
	
	ПодключенныеПриложения = РегистрыСведений.ПодключениеКомбинированныхПриложений.ПодключенныеПриложения(); 
	ДоступныеВозможностиЕБВ = ДоступныеВозможностиПриложенийЕБВ(ПодключенныеПриложения);
	ИзмененныеФОЕБВ = ИзмененныеФОЕБВ(ДоступныеВозможностиЕБВ); 
	УдалитьИгнорируемыеФО(ИзмененныеФОЕБВ);
	
	Список = Новый СписокЗначений;
	Список.Добавить(ДоступныеВозможностиЕБВ, "ДоступныеВозможностиЕБВ");
	Список.Добавить(ИзмененныеФОЕБВ, "ИзмененныеФОЕБВ");
	
	Возврат Список;
	
КонецФункции

Процедура ОбработатьНастройкиЕБВ(СписокТаблиц) Экспорт
	
	ИмяТекущегоВидаПриложения = ВидыПриложенийСервер.ИмяТекущегоВидаПриложения();
	
	Если ИмяТекущегоВидаПриложения = "" Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяТекущегоВидаПриложения <> "Бизнес" Тогда
		Возврат;
	КонецЕсли;
	
	ПодключенныеПриложения = РегистрыСведений.ПодключениеКомбинированныхПриложений.ПодключенныеПриложения(); 
	ДоступныеВозможностиЕБВ_После = ДоступныеВозможностиПриложенийЕБВ(ПодключенныеПриложения);
	ДоступныеВозможностиЕБВ = СписокТаблиц[0].Значение;
	ИзмененныеФОЕБВ = СписокТаблиц[1].Значение;
	
	СохранитьБолееНедоступныеФО(ИзмененныеФОЕБВ, ДоступныеВозможностиЕБВ, ДоступныеВозможностиЕБВ_После);
	ВосстановитьВновьДоступныеФО(ИзмененныеФОЕБВ, ДоступныеВозможностиЕБВ, ДоступныеВозможностиЕБВ_После);

КонецПроцедуры

Функция ТаблицаИгнорируемыхФО()
	
	ТаблицаВозможностей = ТарификацияБизнес.НоваяТаблицаВозможностей();
	// Специфическая функциональность, часто меняется при нестандартной обработке в кубиках
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей,"ИспользоватьРаспознаваниеДокументов", Ложь);
	// Везде Ложь кроме одного кубика
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей,"ИспользоватьРаботуСПоискомКонтрагентовВСписке", Ложь);
	// Разное значение в разных кубиках, под вопросом, тк один кубик - ВыставлениеСчетов
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей,"ФункциональнаяОпцияИспользоватьРучныеСкидкиНаценкиПродажи", Ложь);
	// Разное значение в разных кубиках
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей,"ФункциональнаяОпцияПередачаТоваровНаКомиссию", Ложь);
	// Разное значение в разных кубиках
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей,"ФункциональнаяОпцияИспользоватьПечатьЭтикетокИЦенников", Ложь);
	// Своя логика работы
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей,"ФункциональнаяОпцияИспользуетсяОСНО", Ложь);

	Возврат ТаблицаВозможностей;
	
КонецФункции 

Функция МассивИменИгнорируемыхФО(МассивИмен = Неопределено) Экспорт
	
	Если МассивИмен = Неопределено Тогда
		МассивИмен = Новый Массив;	
	КонецЕсли;
	
	ТаблицаИгнорируемыхФО = ТаблицаИгнорируемыхФО();
	Для Каждого СтрокаТаблицы Из ТаблицаИгнорируемыхФО Цикл
		Если МассивИмен.Найти(СтрокаТаблицы.Имя) = Неопределено Тогда
			МассивИмен.Добавить(СтрокаТаблицы.Имя);
		КонецЕсли;
	КонецЦикла;                                    
	
	Возврат МассивИмен; 
	
КонецФункции 

Функция ПолучитьПересечение(ИдентификаторПриложение1, ИдентификаторПриложение2) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторПриложение1) ИЛИ Не ЗначениеЗаполнено(ИдентификаторПриложение2) Тогда
		Возврат Неопределено;	
	КонецЕсли;  
	
	МодульПриложения1 = ПолучитьИмяМодуляПоИдентификаторуПриложения(ИдентификаторПриложение1);
	МодульПриложения2 = ПолучитьИмяМодуляПоИдентификаторуПриложения(ИдентификаторПриложение2);
	
	Если МодульПриложения1 = "" ИЛИ МодульПриложения2 = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	МодульПриложения1 = ОбщегоНазначения.ОбщийМодуль(МодульПриложения1);
	МодульПриложения2 = ОбщегоНазначения.ОбщийМодуль(МодульПриложения2);
	
	ТаблицаКонстантЕБВ1 = МодульПриложения1.ЕБВФункциональныеВозможностиПриложения();
	ТаблицаКонстантЕБВ2 = МодульПриложения2.ЕБВФункциональныеВозможностиПриложения();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 		"ВЫБРАТЬ
	|	втПриложение1.Имя КАК Имя,
	|	втПриложение1.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
	|ПОМЕСТИТЬ втПриложение1
	|ИЗ
	|	&втПриложение1 КАК втПриложение1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПриложение2.Имя КАК Имя,
	|	втПриложение2.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
	|ПОМЕСТИТЬ втПриложение2
	|ИЗ
	|	&втПриложение2 КАК втПриложение2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(втПриложение1.Имя КАК СТРОКА(150)) КАК ИмяФО,
	|	втПриложение1.ЗначениеПоУмолчанию КАК Значение1,
	|	втПриложение2.ЗначениеПоУмолчанию КАК Значение2,
	|	втПриложение1.ЗначениеПоУмолчанию = втПриложение2.ЗначениеПоУмолчанию КАК Совпадают
	|ИЗ
	|	втПриложение1 КАК втПриложение1
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПриложение2 КАК втПриложение2
	|		ПО ((ВЫРАЗИТЬ(втПриложение1.Имя КАК СТРОКА(150))) = (ВЫРАЗИТЬ(втПриложение2.Имя КАК СТРОКА(150))))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫРАЗИТЬ(втПриложение1.Имя КАК СТРОКА(150))";
	Запрос.УстановитьПараметр("втПриложение1", ТаблицаКонстантЕБВ1);
	Запрос.УстановитьПараметр("втПриложение2", ТаблицаКонстантЕБВ2);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

