	ТаблицаКонстантЕБВ1 = МодульПриложения1.ЕБВФункциональныеВозможностиПриложения();
	ТаблицаКонстантЕБВ2 = МодульПриложения2.ЕБВФункциональныеВозможностиПриложения();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	|	втПриложение1.Имя КАК Имя,
	|	втПриложение1.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
	|ПОМЕСТИТЬ втПриложение1
	|ИЗ
	|	&втПриложение1 КАК втПриложение1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втПриложение2.Имя КАК Имя,
	|	втПриложение2.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
	|ПОМЕСТИТЬ втПриложение2
	|ИЗ
	|	&втПриложение2 КАК втПриложение2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(втПриложение1.Имя КАК СТРОКА(150)) КАК ИмяФО,
	|	втПриложение1.ЗначениеПоУмолчанию КАК Значение1,
	|	втПриложение1.ЗначениеПоУмолчанию КАК Значение2,
	|	ИСТИНА КАК Совпадают
	|ПОМЕСТИТЬ втИтог
	|ИЗ
	|	втПриложение1 КАК втПриложение1
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПриложение2 КАК втПриложение2
	|		ПО ((ВЫРАЗИТЬ(втПриложение1.Имя КАК СТРОКА(150))) = (ВЫРАЗИТЬ(втПриложение2.Имя КАК СТРОКА(150))))
	|ГДЕ
	|	втПриложение2.ЗначениеПоУмолчанию ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(втПриложение2.Имя КАК СТРОКА(150)),
	|	втПриложение2.ЗначениеПоУмолчанию,
	|	втПриложение2.ЗначениеПоУмолчанию,
	|	ЛОЖЬ
	|ИЗ
	|	втПриложение2 КАК втПриложение2
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПриложение1 КАК втПриложение1
	|		ПО ((ВЫРАЗИТЬ(втПриложение1.Имя КАК СТРОКА(150))) = (ВЫРАЗИТЬ(втПриложение2.Имя КАК СТРОКА(150))))
	|ГДЕ
	|	втПриложение1.ЗначениеПоУмолчанию ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втИтог.ИмяФО КАК ИмяФО,
	|	втИтог.Значение1 КАК Значение1,
	|	втИтог.Значение2 КАК Значение2,
	|	втИтог.Совпадают КАК Совпадают
	|ИЗ
	|	втИтог КАК втИтог
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИмяФО";
	Запрос.УстановитьПараметр("втПриложение1", ТаблицаКонстантЕБВ1);
	Запрос.УстановитьПараметр("втПриложение2", ТаблицаКонстантЕБВ2);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

