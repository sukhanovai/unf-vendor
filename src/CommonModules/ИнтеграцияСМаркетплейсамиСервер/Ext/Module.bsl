Функция ОтчетКомиссионераПоОтчетуОРеализацииТоваровЗаполнить( ОтчетОРеализацииТоваровДанные, ОбъектДляЗаполнения ) Экспорт

	Результат = Новый Структура;
    Результат.Вставить( "НоменклатураПоИдентификаторамНеСопоставлена", Неопределено );
    Результат.Вставить( "ОбъектДляЗаполненияИзменен", Истина );
    
	УчетнаяЗаписьМаркетплейса = ОтчетОРеализацииТоваровДанные.Данные.Шапка.УчетнаяЗаписьМаркетплейса;
	
	НоменклатураПоИдентификаторамНеСопоставлена =
	ОтчетОРеализацииТоваровДанные.Данные.НоменклатураПоИдентификаторамНеСопоставлена;
	Если НоменклатураПоИдентификаторамНеСопоставлена.Количество() > 0 Тогда
		
		Результат.НоменклатураПоИдентификаторамНеСопоставлена = НоменклатураПоИдентификаторамНеСопоставлена;
		
		ТекстСообщенияШаблон = 
		НСтр( "ru = 'Импорт отчета о реализации из Ozon: Не найдена номенклатура в базе 1С по данным Ozon: %1.
               |Необходимо выполнить сопоставление номенклатуры и повторить загрузку.'" );
		ТекстСообщения = СтрШаблон( ТекстСообщенияШаблон, НоменклатураПоИдентификаторамНеСопоставлена.Количество() );
		ОбщегоНазначения.СообщитьПользователю( ТекстСообщения );
		
		Если ОбменСВнешнимиСистемамиЛогирование.ЛогированиеВключено( УчетнаяЗаписьМаркетплейса ) Тогда
		
			ЛогКомментарий = ТекстСообщения + Символы.ПС + Символы.ПС
			+ НСтр( "ru = 'Таблица идентификаторов'" ) + ":" + Символы.ПС
			+ ОбменСВнешнимиСистемамиЛогирование.ОбъектПредставление( НоменклатураПоИдентификаторамНеСопоставлена );
			ОбменСВнешнимиСистемамиЛогирование.ЗаписатьВЛог( ЛогКомментарий, УчетнаяЗаписьМаркетплейса, Истина );
			
		КонецЕсли;
		
	КонецЕсли;
	
	Шапка = ОтчетОРеализацииТоваровДанные.Данные.Шапка;
	ТоварыПродажи = ОтчетОРеализацииТоваровДанные.Данные.ТоварыПродажи;
	ТоварыВозвраты = ОтчетОРеализацииТоваровДанные.Данные.ТоварыВозвраты;

	#Область Шапка

	ОбъектДляЗаполнения.Организация = Шапка.Организация;
	ОбъектДляЗаполнения.Контрагент = Шапка.Контрагент;
	ОбъектДляЗаполнения.Договор = Шапка.ДоговорКонтрагента;

	ОтчетОРеализацииТоваровЗаполнитьШапкуПоОрганизации( ОбъектДляЗаполнения, Шапка.Организация );

	ОбъектДляЗаполнения.Дата = Шапка.ДатаВходящегоДокумента;

	ОбъектДляЗаполнения.НомерВходящегоДокумента = Шапка.НомерВходящегоДокумента;
	ОбъектДляЗаполнения.ДатаВходящегоДокумента = Шапка.ДатаВходящегоДокумента;

	КомментарийШаблон = НСтр( "ru = 'Импорт из Ozon %1: %2 от %3'" );
	ОбъектДляЗаполнения.Комментарий = СтрШаблон( КомментарийШаблон, ТекущаяДатаСеанса(), 
	ОбъектДляЗаполнения.НомерВходящегоДокумента, 
	Формат( ОбъектДляЗаполнения.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy" ) )
	+ Символы.ПС + ОбъектДляЗаполнения.Комментарий;

	#КонецОбласти

	НастройкиЗаполненияНДС = НалогиУНФ.НастройкиНДСОрганизации( ОбъектДляЗаполнения.Организация, ,
	ОбъектДляЗаполнения.Дата );

	СпособРаспределенияАвто = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто;


	// ТЧ Покупатели
	ОбъектДляЗаполнения.Покупатели.Очистить();
	ПокупателиСтрока = ОбъектДляЗаполнения.Покупатели.Добавить();
	ПокупателиСтрока.КлючСвязи = 1;
	ПокупателиСтрока.Покупатель = Шапка.Контрагент;

	#Область ТЧ_Запасы

	ОбъектДляЗаполнения.Запасы.Очистить();
	Для Каждого ТоварыПродажиСтрока Из ТоварыПродажи Цикл
		
		ЗапасыСтрока = ОбъектДляЗаполнения.Запасы.Добавить();
		
		ЗапасыСтрока.КлючСвязи = 1;
		
		ЗапасыСтрока.Номенклатура = ТоварыПродажиСтрока.Номенклатура;
		ЗапасыСтрока.Характеристика = ТоварыПродажиСтрока.Характеристика;
		
		ЗапасыСтрока.ЕдиницаИзмерения = ТоварыПродажиСтрока.ЕдиницаИзмерения;
		ЗапасыСтрока.СтавкаНДС = ТоварыПродажиСтрока.СтавкаНДС;
		
		ЗапасыСтрока.Количество = ?( ТоварыПродажиСтрока.Количество = 0, 1, ТоварыПродажиСтрока.Количество );
		ЗапасыСтрока.Сумма = ТоварыПродажиСтрока.Сумма + ТоварыПродажиСтрока.Доплата;
		ЗапасыСтрока.Цена = ЗапасыСтрока.Сумма/ЗапасыСтрока.Количество;
		
		ЗапасыСтрока.Всего = ЗапасыСтрока.Сумма;
		ЗапасыСтрока.СуммаВознаграждения = 0;
		ЗапасыСтрока.СпособРаспределения = СпособРаспределенияАвто;
		
	КонецЦикла;

	// ставка НДС
	НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти( ОбъектДляЗаполнения,
	"Запасы", Истина, НастройкиЗаполненияНДС.ВидСтавкиНДС );

	#КонецОбласти

	ПокупателиСтрока.Всего = ОбъектДляЗаполнения.Запасы.Итог( "Всего" );

	// ТЧ Покупатели возвраты
	ОбъектДляЗаполнения.ПокупателиВозвраты.Очистить();
	ПокупателиВозвратыСтрока = ОбъектДляЗаполнения.ПокупателиВозвраты.Добавить();
	ПокупателиВозвратыСтрока.КлючСвязи = 1;
	ПокупателиВозвратыСтрока.Покупатель = Шапка.Контрагент;

	#Область ТЧ_ЗапасыВозвраты

	ОбъектДляЗаполнения.ЗапасыВозвраты.Очистить();
	Для Каждого ТоварыВозвратыСтрока Из ТоварыВозвраты Цикл
		
		ЗапасыВозвратыСтрока = ОбъектДляЗаполнения.ЗапасыВозвраты.Добавить();
		
		ЗапасыВозвратыСтрока.КлючСвязи = 1;
		
		ЗапасыВозвратыСтрока.Номенклатура = ТоварыВозвратыСтрока.Номенклатура;
		ЗапасыВозвратыСтрока.Характеристика = ТоварыВозвратыСтрока.Характеристика;
		
		ЗапасыВозвратыСтрока.ЕдиницаИзмерения = ТоварыВозвратыСтрока.ЕдиницаИзмерения;
		ЗапасыВозвратыСтрока.СтавкаНДС = ТоварыВозвратыСтрока.СтавкаНДС;
		
		ЗапасыВозвратыСтрока.Количество = ?( ТоварыВозвратыСтрока.Количество = 0, 1, ТоварыВозвратыСтрока.Количество );
		ЗапасыВозвратыСтрока.Сумма = ТоварыВозвратыСтрока.Сумма + ТоварыВозвратыСтрока.Доплата;
		ЗапасыВозвратыСтрока.Цена = ЗапасыВозвратыСтрока.Сумма/ЗапасыВозвратыСтрока.Количество;
		
		ЗапасыВозвратыСтрока.Всего = ЗапасыВозвратыСтрока.Сумма;
		ЗапасыВозвратыСтрока.СуммаВознаграждения = 0;
		ЗапасыВозвратыСтрока.СпособРаспределения = СпособРаспределенияАвто;
		
	КонецЦикла;

	// ставка НДС
	НоменклатураВДокументахСервер.ОбновитьСтавкуНДСТабличнойЧасти( ОбъектДляЗаполнения, 
	"ЗапасыВозвраты", Истина, НастройкиЗаполненияНДС.ВидСтавкиНДС );

	#КонецОбласти

	ПокупателиВозвратыСтрока.Всего = ОбъектДляЗаполнения.ЗапасыВозвраты.Итог( "Всего" );
	        
	Возврат Результат;
КонецФункции

Функция ОтчетОРеализацииТоваровПолучитьИОтчетКомиссионераЗаполнить( Параметры ) Экспорт

	Результат = Новый Структура;

	Если ТипЗнч( Параметры ) <> Тип( "Структура" ) Тогда
		Возврат Результат;
	КонецЕсли;

	// получить данные о продажах для заполнения объекта
	ОтчетОРеализацииТоваровДанные = ОтчетОРеализацииТоваровПолучить( Параметры );
	
	Если ЗначениеЗаполнено( ОтчетОРеализацииТоваровДанные.Ошибка.ОписаниеОшибки ) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОтчетКомиссионераПоОтчетуОРеализацииТоваровЗаполнить( ОтчетОРеализацииТоваровДанные, Параметры );
	
	Возврат Результат;
КонецФункции

Функция ВыполнитьЗагрузкуНовыхЗаказов(ДанныеУчетнойЗаписи, Знач ИдентификаторФормы, Знач ВыделенныеСтроки) Экспорт

	//@skip-check bsl-legacy-check-string-literal
	ДанныеУчетнойЗаписи.ВидМаркетплейса =
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеУчетнойЗаписи.УчетнаяЗапись, "ВидМаркетплейса");

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Ozon. Загрузка заказов.'");
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	ИмяМетода = "ИнтеграцияСМаркетплейсамиСервер.ЗаказыЗагрузитьСТорговойПлощадки";
	
	ОкончаниеПериода = КонецДня(ТекущаяДатаСеанса());
	НачалоПериода    = НачалоДня(ДобавитьМесяц(ОкончаниеПериода, -1));
	
	Если ВыделенныеСтроки = Неопределено Тогда
		ИдентификаторыЗаказов = Неопределено;
	Иначе
		ИдентификаторыЗаказов = Новый Массив;
		
		Для Каждого ДанныеВыделеннойСтроки Из ВыделенныеСтроки Цикл
			ИдентификаторыЗаказов.Добавить(ДанныеВыделеннойСтроки.ИдентификаторЗаказа);
			
			НачалоПериода    = Мин(НачалоПериода, ДанныеВыделеннойСтроки.ДатаСозданияОтправления);
			ОкончаниеПериода = Макс(ОкончаниеПериода, ДанныеВыделеннойСтроки.ДатаСозданияОтправления);
		КонецЦикла;
	КонецЕсли;
	
	Если ДанныеУчетнойЗаписи.ВидМаркетплейса = Перечисления.ВидыМаркетплейсов.МаркетплейсOzon Тогда
		ПараметрыФункции = ИнтеграцияСМаркетплейсомOzonСервер.НовыйПараметрыЗагрузкиЗаказов();
		ПараметрыФункции.НачалоПериода       = НачалоДня(НачалоПериода);
		ПараметрыФункции.ОкончаниеПериода    = КонецДня(ОкончаниеПериода);
		ПараметрыФункции.ИдентификаторЗаказа = ИдентификаторыЗаказов;
		Если ВыделенныеСтроки = Неопределено Тогда
			// Загрузка только новых заказов.
			ПараметрыФункции.СтатусОтправления = "awaiting_packaging";
		КонецЕсли;
	Иначе
		ПараметрыФункции = Новый Структура;
	КонецЕсли;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяМетода,
		ДанныеУчетнойЗаписи.УчетнаяЗапись,
		ПараметрыФункции);

КонецФункции

// Выполняет перенос (копирование) элементов справочника "Номенклатура партнеров" между владельцами.
//
// Параметры:      
//   Параметры   - см. ИнтеграцияСМаркетплейсамиКлиентСервер.ПараметрыИзмененияВладельцаТоварногоКаталога.
//   Скопировать - Булево - Истина, если скопировать элементы.
//
// Возвращаемое значение:
//   См. НоваяОшибка.
//
Функция ПеренестиНоменклатуруПартнера(Параметры, Скопировать = Истина) Экспорт
	
	Ошибка = НоваяОшибка();
	
	Если Ошибка.Детализация = Неопределено Тогда
		Ошибка.Детализация = Новый Массив;
	КонецЕсли;
	
	Замер = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
		"ИнтеграцияСМаркетплейсамиСервер.ПеренестиНоменклатуруПартнера");
	
	Если Параметры.ВидТорговойПлощадки = Перечисления.ВидыМаркетплейсов.МаркетплейсЯндексМаркет Тогда
		ИмяРегистраСведений       = "СтатусыПубликацииТоваровЯндексМаркет";
		ИмяИзмеренияУчетнаяЗапись = "УчетнаяЗапись";
	ИначеЕсли Параметры.ВидТорговойПлощадки = Перечисления.ВидыМаркетплейсов.МаркетплейсOzon Тогда
		ИмяРегистраСведений       = "СтатусыПубликацииОбъектовМаркетплейсаOzon";
		ИмяИзмеренияУчетнаяЗапись = "УчетнаяЗаписьМаркетплейса";
	ИначеЕсли ИнтеграцияСМаркетплейсамиСИ.ЭтоМаркетплейсСИ(Параметры.ВидТорговойПлощадки) И Не Скопировать Тогда
		ИмяРегистраСведений       = "";
		ИмяИзмеренияУчетнаяЗапись = "";
	Иначе
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неизвестный вид торговой площадки %1.'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			Строка(Параметры.ВидТорговойПлощадки));
		
		Ошибка.КодОшибки      = "НоменклатураКонтрагентов_Запись";
		Ошибка.ОписаниеОшибки = ТекстОшибки;
			
		Возврат Ошибка;
	КонецЕсли;
	
	ИмяРегистра = СтрШаблон("РегистрСведений.%1", ИмяРегистраСведений);
	
	ПараметрыОбработки = НовыеПараметрыОбработкиДанныхНоменклатурыПартнераДляПереноса();
	ПараметрыОбработки.ПрефиксИмпортируемыеТовары = "ИмпортируемыеТовары";
	ПараметрыОбработки.ПрефиксСтатусыПубликации = "СтатусыПубликации";
	ПараметрыОбработки.КопироватьЭлементы = Скопировать;
	
	Если Скопировать Тогда
		
		ПараметрыОбработки.ИмпортируемыеТоварыСтарые = РегистрыСведений.ИмпортируемыеТоварыТорговыхПлощадок.СоздатьНаборЗаписей();
		ПараметрыОбработки.ИмпортируемыеТоварыНовые = РегистрыСведений.ИмпортируемыеТоварыТорговыхПлощадок.СоздатьНаборЗаписей();
		
		Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяРегистра);
		
		ПараметрыОбработки.СтатусыПубликацииСтарые = Менеджер.СоздатьНаборЗаписей(); // РегистрСведенийНаборЗаписей.СтатусыПубликацииОбъектовМаркетплейсаOzon, РегистрСведенийНаборЗаписей.СтатусыПубликацииТоваровЯндексМаркет
		ПараметрыОбработки.СтатусыПубликацииНовые = Менеджер.СоздатьНаборЗаписей(); // РегистрСведенийНаборЗаписей.СтатусыПубликацииОбъектовМаркетплейсаOzon, РегистрСведенийНаборЗаписей.СтатусыПубликацииТоваровЯндексМаркет
		
	КонецЕсли;
	
	ПакетЗапросов = ДанныеНоменклатурыПартнераДляПереноса(
		ИмяРегистра,
		ИмяИзмеренияУчетнаяЗапись,
		Параметры,
		ПараметрыОбработки);
	
	РезультатЗапросаПоГруппам = ПакетЗапросов[0];
	РезультатЗапроса = ПакетЗапросов[1];
	
	Если РезультатЗапросаПоГруппам.Пустой()
			И РезультатЗапроса.Пустой()
			И Не Параметры.ОбрабатыватьЗаписиБезВладельца Тогда
		Возврат Ошибка;
	КонецЕсли;
	
	ПараметрыОбработки.ИменаКолонокИмпортируемыеТовары = ИменаКолонокРезультатаЗапросаПоПрефиксу(
		РезультатЗапроса, ПараметрыОбработки.ПрефиксИмпортируемыеТовары);
		
	ПараметрыОбработки.ИменаКолонокСтатусыПубликации = ИменаКолонокРезультатаЗапросаПоПрефиксу(
		РезультатЗапроса, ПараметрыОбработки.ПрефиксСтатусыПубликации);
	
	ЗаполняемыеСвойстваЭлемента = ИменаРеквизитовСправочникаНоменклатураКонтрагентов(Ложь);
	ЗаполняемыеСвойстваГруппы = ИменаРеквизитовСправочникаНоменклатураКонтрагентов(Истина);
	
	ИспользоватьХарактеристикиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристики");
	ИспользоватьУпаковкиНоменклатуры       = ПолучитьФункциональнуюОпцию("УчетВРазличныхЕдиницахИзмерения");
	
	НачатьТранзакцию();
	
	Попытка
		
		БлокировкаДанных = Новый БлокировкаДанных;
		
		Если Скопировать Тогда
			
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ИмпортируемыеТоварыТорговыхПлощадок");
			ЭлементБлокировкиДанных.ИсточникДанных = РезультатЗапроса;
			ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных(
				"УчетнаяЗапись", ПараметрыОбработки.ПрефиксИмпортируемыеТовары + "УчетнаяЗапись");
			ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных(
				"НоменклатураПартнера", ПараметрыОбработки.ПрефиксИмпортируемыеТовары + "НоменклатураПартнера");
			
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить(ИмяРегистра);
			ЭлементБлокировкиДанных.ИсточникДанных = РезультатЗапроса;
			ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных(
				ИмяИзмеренияУчетнаяЗапись, ПараметрыОбработки.ПрефиксСтатусыПубликации + ИмяИзмеренияУчетнаяЗапись);
			ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных(
				"Номенклатура", ПараметрыОбработки.ПрефиксСтатусыПубликации + "Номенклатура");
			
			Если Параметры.ВидТорговойПлощадки = Перечисления.ВидыМаркетплейсов.МаркетплейсOzon Тогда
				ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных(
					"НоменклатураПартнера", ПараметрыОбработки.ПрефиксСтатусыПубликации + "НоменклатураПартнера");
			КонецЕсли;
			
			Если ИспользоватьХарактеристикиНоменклатуры Тогда
				ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных(
					"Характеристика", ПараметрыОбработки.ПрефиксСтатусыПубликации + "Характеристика");
			КонецЕсли;
			
			Если ИспользоватьУпаковкиНоменклатуры Тогда
				ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных(
					"Упаковка", ПараметрыОбработки.ПрефиксСтатусыПубликации + "Упаковка");
			КонецЕсли;
			
		Иначе
			
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.НоменклатураКонтрагентов");
			ЭлементБлокировкиДанных.ИсточникДанных = РезультатЗапросаПоГруппам;
			ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("Ссылка", "ПредыдущаяСсылка");
			
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Справочник.НоменклатураКонтрагентов");
			ЭлементБлокировкиДанных.ИсточникДанных = РезультатЗапроса;
			ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("Ссылка", "ПредыдущаяСсылка");
			
		КонецЕсли;
		
		БлокировкаДанных.Заблокировать();
		
		ПараметрыОбработки.РезультатЗапроса = РезультатЗапросаПоГруппам;
		ПараметрыОбработки.ЗаполняемыеСвойства = ЗаполняемыеСвойстваГруппы;
		ПараметрыОбработки.ЭтоОбработкаГрупп = Истина;
		
		ПеренестиНоменклатуруПартнераСлужебный(
			Параметры.ВидТорговойПлощадки, Параметры.НовыйВладелец, Ошибка, ПараметрыОбработки);
		
		ПараметрыОбработки.РезультатЗапроса = РезультатЗапроса;
		ПараметрыОбработки.ЗаполняемыеСвойства = ЗаполняемыеСвойстваЭлемента;
		ПараметрыОбработки.ЭтоОбработкаГрупп = Ложь;
		
		ПеренестиНоменклатуруПартнераСлужебный(
			Параметры.ВидТорговойПлощадки, Параметры.НовыйВладелец, Ошибка, ПараметрыОбработки);
		
		Если ПараметрыОбработки.ИмпортируемыеТоварыСтарые <> Неопределено
				И ПараметрыОбработки.ИмпортируемыеТоварыСтарые.Количество() > 0 Тогда
			ПараметрыОбработки.ИмпортируемыеТоварыСтарые.Записать(РежимЗамещения.Удаление);
		КонецЕсли;
		
		Если ПараметрыОбработки.ИмпортируемыеТоварыНовые <> Неопределено
				И ПараметрыОбработки.ИмпортируемыеТоварыНовые.Количество() > 0 Тогда
			ПараметрыОбработки.ИмпортируемыеТоварыНовые.Записать(РежимЗамещения.Слияние);
		КонецЕсли;
		
		Если ПараметрыОбработки.СтатусыПубликацииСтарые <> Неопределено
				И ПараметрыОбработки.СтатусыПубликацииСтарые.Количество() > 0 Тогда
			ПараметрыОбработки.СтатусыПубликацииСтарые.Записать(РежимЗамещения.Удаление);
		КонецЕсли;
		
		Если ПараметрыОбработки.СтатусыПубликацииНовые <> Неопределено
				И ПараметрыОбработки.СтатусыПубликацииНовые.Количество() > 0 Тогда
			ПараметрыОбработки.СтатусыПубликацииНовые.Записать(РежимЗамещения.Слияние);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		
		Если Скопировать Тогда
			ШаблонОшибки = НСтр("ru = 'При копировании позиций товарного каталога возникли ошибки: %1.'",
				ОбщегоНазначения.КодОсновногоЯзыка());
		Иначе
			ШаблонОшибки = НСтр("ru = 'При переносе позиций товарного каталога возникли ошибки: %1.'",
				ОбщегоНазначения.КодОсновногоЯзыка());
		КонецЕсли;
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонОшибки,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации(Параметры.ВидТорговойПлощадки),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
		
		Ошибка.КодОшибки      = "НоменклатураКонтрагентов_Запись";
		Ошибка.ОписаниеОшибки = ТекстОшибки;
			
		Возврат Ошибка;
	КонецПопытки;
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(
		Замер, 
		ПараметрыОбработки.КоличествоОбработано / 100);
	
	ОтправитьСерверноеУведомлениеНаКлиент(Параметры.ИмяСобытияОповещения, Параметры.УчетнаяЗапись);
	
	Возврат Ошибка;
	
КонецФункции


Функция ИменаКолонокРезультатаЗапросаПоПрефиксу(РезультатЗапроса, Префикс)
	
	Результат = Новый Массив; // Массив из Строка
	
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		
		Если Не СтрНачинаетсяС(Колонка.Имя, Префикс) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКолонки = Сред(Колонка.Имя, СтрДлина(Префикс) + 1);
		
		Если ИмяКолонки = "ЕстьДанные" Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(ИмяКолонки);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Конструктор параметров обработки данных номенклатуры партнера.
// 
// Возвращаемое значение:
//  Структура:
//   * РезультатЗапроса - Неопределено, РезультатЗапроса - элемент пакета запросов из см. ДанныеНоменклатурыПартнераДляПереноса. 
//   * Дубли - Соответствие из КлючИЗначение:
//      ** Ключ - Строка - идентификатор элемента или наименование группы.
//      ** Значение - СправочникСсылка.НоменклатураКонтрагентов - элемент справочника.
//   * Родители - Соответствие из КлючИЗначение:
//      ** Ключ - СправочникСсылка.НоменклатураКонтрагентов - группа номенклатуры прежнего владельца.
//      ** Значение - СправочникСсылка.НоменклатураКонтрагентов - группа номенклатуры нового владельца.
//   * ЗаполняемыеСвойства - Строка - имена заполняемых свойств через запятую.
//   * ЭтоОбработкаГрупп - Булево - признак создания групп номенклатуры контрагентов.
//   * КопироватьЭлементы - Булево - признак необходимости копировать элементы вместо изменения владельца.
//   * КоличествоОбработано - Число - количество обработанных элементов.
//   * ИмпортируемыеТоварыСтарые - Неопределено - если КопироватьЭлементы = Ложь.
//                               - РегистрСведенийНаборЗаписей.ИмпортируемыеТоварыТорговыхПлощадок
//   * ИмпортируемыеТоварыНовые - Неопределено - если КопироватьЭлементы = Ложь.
//                              - РегистрСведенийНаборЗаписей.ИмпортируемыеТоварыТорговыхПлощадок
//   * СтатусыПубликацииСтарые - Неопределено - если КопироватьЭлементы = Ложь.
//                             - РегистрСведенийНаборЗаписей.СтатусыПубликацииОбъектовМаркетплейсаOzon
//                             - РегистрСведенийНаборЗаписей.СтатусыПубликацииТоваровЯндексМаркет
//   * СтатусыПубликацииНовые - Неопределено - если КопироватьЭлементы = Ложь.
//                            - РегистрСведенийНаборЗаписей.СтатусыПубликацииОбъектовМаркетплейсаOzon
//                            - РегистрСведенийНаборЗаписей.СтатусыПубликацииТоваровЯндексМаркет
//   * ПрефиксИмпортируемыеТовары - Строка - префикс полей запроса для данных регистра импортируемых товаров.
//   * ПрефиксСтатусыПубликации - Строка - префикс полей запроса для данных регистра со статусами публикации.
//   * ИменаКолонокИмпортируемыеТовары - Массив из Строка - имена полей запроса для данных регистра импортируемых товаров.
//   * ИменаКолонокСтатусыПубликации - Массив из Строка - имена полей запроса для данных регистра со статусами публикации.
//
Функция НовыеПараметрыОбработкиДанныхНоменклатурыПартнераДляПереноса()
	
	Результат = Новый Структура;
	
	Результат.Вставить("РезультатЗапроса", Неопределено);
	Результат.Вставить("Дубли", Новый Соответствие);
	Результат.Вставить("Родители", Новый Соответствие);
	Результат.Вставить("ЗаполняемыеСвойства", "");
	Результат.Вставить("ЭтоОбработкаГрупп", Ложь);
	Результат.Вставить("КопироватьЭлементы", Ложь);
	Результат.Вставить("КоличествоОбработано", 0);
	
	Результат.Вставить("ИмпортируемыеТоварыСтарые", Неопределено);
	Результат.Вставить("ИмпортируемыеТоварыНовые", Неопределено);
	Результат.Вставить("СтатусыПубликацииСтарые", Неопределено);
	Результат.Вставить("СтатусыПубликацииНовые", Неопределено);
	
	Результат.Вставить("ПрефиксИмпортируемыеТовары", "");
	Результат.Вставить("ПрефиксСтатусыПубликации", "");
	Результат.Вставить("ИменаКолонокИмпортируемыеТовары", Новый Массив);
	Результат.Вставить("ИменаКолонокСтатусыПубликации", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеНоменклатурыПартнераДляПереноса(ИмяРегистра, ИмяИзмеренияУчетнаяЗапись, Параметры, ПараметрыОбработки)
	
	ТекстЗапросаПолейНоменклатураКонтрагентов = ТекстЗапросаПолейОбъектаМетаданных(
		"Справочник.НоменклатураКонтрагентов", "ПредыдущаяНоменклатураКонтрагентов");
	
	Тексты = Новый Массив; // Массив из Строка
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ПредыдущаяНоменклатураКонтрагентов.Ссылка КАК ПредыдущаяСсылка,
		|	ПредыдущаяНоменклатураКонтрагентов.Родитель КАК РеквизитУпорядочивания,
		|	ЕСТЬNULL(НоваяНоменклатураКонтрагентов.Ссылка, ЗНАЧЕНИЕ(Справочник.НоменклатураКонтрагентов.ПустаяСсылка)) КАК НоваяСсылка,
		|	ЛОЖЬ КАК ИмпортируемыеТоварыЕстьДанные,
		|	ЛОЖЬ КАК СтатусыПубликацииЕстьДанные,
		|	&ТекстЗапросаПоляСправочника КАК Поля
		|ИЗ
		|	Справочник.НоменклатураКонтрагентов КАК ПредыдущаяНоменклатураКонтрагентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатураКонтрагентов КАК НоваяНоменклатураКонтрагентов
		|		ПО (НоваяНоменклатураКонтрагентов.Владелец = &НовыйВладелец)
		|			И (НоваяНоменклатураКонтрагентов.Наименование = ПредыдущаяНоменклатураКонтрагентов.Наименование)
		|			И (НоваяНоменклатураКонтрагентов.ЭтоГруппа)
		|ГДЕ
		|	ПредыдущаяНоменклатураКонтрагентов.Владелец = &ТекущийВладелец
		|	И ПредыдущаяНоменклатураКонтрагентов.ЭтоГруппа";
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ТекстЗапросаПоляСправочника КАК Поля",
		ТекстЗапросаПолейНоменклатураКонтрагентов);
		
	Если Не ПараметрыОбработки.КопироватьЭлементы Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
			|	И НоваяНоменклатураКонтрагентов.Ссылка ЕСТЬ NULL";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	РеквизитУпорядочивания";
	
	Тексты.Добавить(ТекстЗапроса);
	
	Если ПараметрыОбработки.КопироватьЭлементы Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ПредыдущаяНоменклатураКонтрагентов.Ссылка КАК ПредыдущаяСсылка,
			|	ЕСТЬNULL(НоваяНоменклатураКонтрагентов.Ссылка, ЗНАЧЕНИЕ(Справочник.НоменклатураКонтрагентов.ПустаяСсылка)) КАК НоваяСсылка,
			|	ИмпортируемыеТовары.НоменклатураПартнера ЕСТЬ НЕ NULL  КАК ИмпортируемыеТоварыЕстьДанные,
			|	СтатусыПубликации.НоменклатураПартнера ЕСТЬ НЕ NULL  КАК СтатусыПубликацииЕстьДанные,
			|	&ТекстЗапросаПоляСправочника КАК Поля,
			|	&ТекстЗапросаПоляРегистраИмпортируемыеТовары КАК Поля1,
			|	&ТекстЗапросаПоляРегистраСтатусыПубликации КАК Поля2
			|ИЗ
			|	Справочник.НоменклатураКонтрагентов КАК ПредыдущаяНоменклатураКонтрагентов
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатураКонтрагентов КАК НоваяНоменклатураКонтрагентов
			|		ПО (НоваяНоменклатураКонтрагентов.Владелец = &НовыйВладелец)
			|			И (НоваяНоменклатураКонтрагентов.Идентификатор = ПредыдущаяНоменклатураКонтрагентов.Идентификатор)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИмпортируемыеТоварыТорговыхПлощадок КАК ИмпортируемыеТовары
			|		ПО (ИмпортируемыеТовары.НоменклатураПартнера = ПредыдущаяНоменклатураКонтрагентов.Ссылка)
			|			И (ИмпортируемыеТовары.УчетнаяЗапись = &УчетнаяЗапись)
			|		ЛЕВОЕ СОЕДИНЕНИЕ ТекстЗапросаПолноеИмяРегистра КАК СтатусыПубликации
			|		ПО (СтатусыПубликации.НоменклатураПартнера = ПредыдущаяНоменклатураКонтрагентов.Ссылка)
			|			И (&ТекстЗапросаИмяПоляУчетнаяЗапись = &УчетнаяЗапись)
			|ГДЕ
			|	ПредыдущаяНоменклатураКонтрагентов.Владелец = &ТекущийВладелец
			|	И НЕ ПредыдущаяНоменклатураКонтрагентов.ЭтоГруппа";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТекстЗапросаПолноеИмяРегистра", ИмяРегистра);
		
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"&ТекстЗапросаИмяПоляУчетнаяЗапись",
			СтрШаблон("СтатусыПубликации.%1", ИмяИзмеренияУчетнаяЗапись));
		
		ТекстЗапросаПоляРегистраИмпортируемыеТовары = ТекстЗапросаПолейОбъектаМетаданных(
			"РегистрСведений.ИмпортируемыеТоварыТорговыхПлощадок",
			"ИмпортируемыеТовары", ,
			ПараметрыОбработки.ПрефиксИмпортируемыеТовары);
		
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"&ТекстЗапросаПоляРегистраИмпортируемыеТовары КАК Поля1",
			ТекстЗапросаПоляРегистраИмпортируемыеТовары);
		
		ТекстЗапросаПоляРегистраСтатусыПубликации = ТекстЗапросаПолейОбъектаМетаданных(
			ИмяРегистра,
			"СтатусыПубликации", ,
			ПараметрыОбработки.ПрефиксСтатусыПубликации);
		
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"&ТекстЗапросаПоляРегистраСтатусыПубликации КАК Поля2",
			ТекстЗапросаПоляРегистраСтатусыПубликации);
		
	Иначе
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ПредыдущаяНоменклатураКонтрагентов.Ссылка КАК ПредыдущаяСсылка,
			|	ЕСТЬNULL(НоваяНоменклатураКонтрагентов.Ссылка, ЗНАЧЕНИЕ(Справочник.НоменклатураКонтрагентов.ПустаяСсылка)) КАК НоваяСсылка,
			|	ЛОЖЬ КАК ИмпортируемыеТоварыЕстьДанные,
			|	ЛОЖЬ КАК СтатусыПубликацииЕстьДанные,
			|	&ТекстЗапросаПоляСправочника КАК Поля
			|ИЗ
			|	Справочник.НоменклатураКонтрагентов КАК ПредыдущаяНоменклатураКонтрагентов
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НоменклатураКонтрагентов КАК НоваяНоменклатураКонтрагентов
			|		ПО (НоваяНоменклатураКонтрагентов.Владелец = &НовыйВладелец)
			|			И (НоваяНоменклатураКонтрагентов.Идентификатор = ПредыдущаяНоменклатураКонтрагентов.Идентификатор)
			|ГДЕ
			|	ПредыдущаяНоменклатураКонтрагентов.Владелец = &ТекущийВладелец
			|	И НЕ ПредыдущаяНоменклатураКонтрагентов.ЭтоГруппа
			|	И НоваяНоменклатураКонтрагентов.Ссылка ЕСТЬ NULL";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ТекстЗапросаПоляСправочника КАК Поля",
		ТекстЗапросаПолейНоменклатураКонтрагентов);
	
	ТекстЗапроса = ТекстЗапроса + "
			|УПОРЯДОЧИТЬ ПО
			|	ПредыдущаяСсылка";
	
	Тексты.Добавить(ТекстЗапроса);
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(Тексты, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Запрос.УстановитьПараметр("УчетнаяЗапись",   Параметры.УчетнаяЗапись);
	Запрос.УстановитьПараметр("ТекущийВладелец", Параметры.ТекущийВладелец);
	Запрос.УстановитьПараметр("НовыйВладелец",   Параметры.НовыйВладелец);
	
	УстановитьПривилегированныйРежим(Истина);
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ПакетЗапросов;
	
КонецФункции

Процедура ПеренестиНоменклатуруПартнераСлужебный(ВидТорговойПлощадки, НовыйВладелец, Ошибка, ПараметрыОбработки)
	
	ВыборкаДанных = ВыборкаДанныхРезультатаЗапросаНоменклатураПартнераДляПереноса(
		ПараметрыОбработки.РезультатЗапроса);
	
	Пока ВыборкаДанных.СледующийПоЗначениюПоля("ПредыдущаяСсылка") Цикл
		
		Если ПараметрыОбработки.ЭтоОбработкаГрупп Тогда
			НоменклатураКонтрагентовСсылка = ПараметрыОбработки.Дубли.Получить(ВыборкаДанных.Наименование);
		Иначе
			НоменклатураКонтрагентовСсылка = ПараметрыОбработки.Дубли.Получить(ВыборкаДанных.Идентификатор);
		КонецЕсли;
		
		Если ПараметрыОбработки.КопироватьЭлементы И ЗначениеЗаполнено(ВыборкаДанных.НоваяСсылка) Тогда
			НоменклатураКонтрагентовСсылка = ВыборкаДанных.НоваяСсылка; // СправочникСсылка.НоменклатураКонтрагентов
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоменклатураКонтрагентовСсылка) Тогда
			
			Если ПараметрыОбработки.КопироватьЭлементы Тогда
				
				Если ПараметрыОбработки.ЭтоОбработкаГрупп Тогда
					НоменклатураКонтрагентовОбъект = Справочники.НоменклатураКонтрагентов.СоздатьГруппу();
				Иначе
					НоменклатураКонтрагентовОбъект = Справочники.НоменклатураКонтрагентов.СоздатьЭлемент();
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(
					НоменклатураКонтрагентовОбъект, ВыборкаДанных, ПараметрыОбработки.ЗаполняемыеСвойства);
				НоменклатураКонтрагентовОбъект.Родитель = ПараметрыОбработки.Родители.Получить(
					ВыборкаДанных.Родитель);
				
			Иначе
				НоменклатураКонтрагентовОбъект = ВыборкаДанных.ПредыдущаяСсылка.ПолучитьОбъект();
				НоменклатураКонтрагентовОбъект.ОбменДанными.Загрузка = Истина;
			КонецЕсли;
			
			НоменклатураКонтрагентовОбъект.Владелец             = НовыйВладелец;
			НоменклатураКонтрагентовОбъект.ВладелецНоменклатуры = НовыйВладелец;
			
			Попытка
				
				НоменклатураКонтрагентовОбъект.Записать();
				НоменклатураКонтрагентовСсылка = НоменклатураКонтрагентовОбъект.Ссылка;
				
				Если Не ПараметрыОбработки.КопироватьЭлементы Тогда
					// Не выполнять кэширование данных
				ИначеЕсли ПараметрыОбработки.ЭтоОбработкаГрупп Тогда
					ПараметрыОбработки.Дубли.Вставить(ВыборкаДанных.Наименование, НоменклатураКонтрагентовСсылка);
					ПараметрыОбработки.Родители.Вставить(ВыборкаДанных.ПредыдущаяСсылка, НоменклатураКонтрагентовСсылка);
				Иначе
					ПараметрыОбработки.Дубли.Вставить(ВыборкаДанных.Идентификатор, НоменклатураКонтрагентовСсылка);
				КонецЕсли;
				
			Исключение
				
				Если ПараметрыОбработки.КопироватьЭлементы Тогда
					ШаблонОшибки = НСтр("ru = 'При копировании позиции товарного каталога %1 возникли ошибки.'",
						ОбщегоНазначения.КодОсновногоЯзыка());
				Иначе
					ШаблонОшибки = НСтр("ru = 'При переносе позиции товарного каталога %1 возникли ошибки.'",
						ОбщегоНазначения.КодОсновногоЯзыка());
				КонецЕсли;
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ШаблонОшибки,
					Строка(ВыборкаДанных.ПредыдущаяСсылка));
				
				Ошибка.КодОшибки = "НоменклатураКонтрагентов_Запись";
				Ошибка.Детализация.Добавить(ТекстОшибки);
				
				ЗаписьЖурналаРегистрации(
					СобытиеЖурналаРегистрации(ВидТорговойПлощадки),
					УровеньЖурналаРегистрации.Ошибка, , ,
					ТекстОшибки);
				
			КонецПопытки;
			
		ИначеЕсли ПараметрыОбработки.КопироватьЭлементы И ПараметрыОбработки.ЭтоОбработкаГрупп Тогда
			ПараметрыОбработки.Родители.Вставить(ВыборкаДанных.ПредыдущаяСсылка, НоменклатураКонтрагентовСсылка);
		КонецЕсли;
		
		Если Не ПараметрыОбработки.КопироватьЭлементы
				Или ПараметрыОбработки.ЭтоОбработкаГрупп
				Или Не ЗначениеЗаполнено(НоменклатураКонтрагентовСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Пока ВыборкаДанных.Следующий() Цикл
			
			Если ВыборкаДанных.ИмпортируемыеТоварыЕстьДанные Тогда
				
				СтараяСтрокаИмпортируемыеТовары = ПараметрыОбработки.ИмпортируемыеТоварыСтарые.Добавить();
				НоваяСтрокаИмпортируемыеТовары = ПараметрыОбработки.ИмпортируемыеТоварыНовые.Добавить();
				
				Для Каждого ИмяКолонки Из ПараметрыОбработки.ИменаКолонокИмпортируемыеТовары Цикл
					
					Значение = ВыборкаДанных[ПараметрыОбработки.ПрефиксИмпортируемыеТовары + ИмяКолонки];
					
					СтараяСтрокаИмпортируемыеТовары[ИмяКолонки] = Значение;
					НоваяСтрокаИмпортируемыеТовары[ИмяКолонки] = Значение;
					
				КонецЦикла;
				
				НоваяСтрокаИмпортируемыеТовары.НоменклатураПартнера = НоменклатураКонтрагентовСсылка;
				
			КонецЕсли;
			
			Если ВыборкаДанных.СтатусыПубликацииЕстьДанные Тогда
				
				СтараяСтрокаСтатусыПубликации = ПараметрыОбработки.СтатусыПубликацииСтарые.Добавить();
				НоваяСтрокаСтатусыПубликации = ПараметрыОбработки.СтатусыПубликацииНовые.Добавить();
				
				Для Каждого ИмяКолонки Из ПараметрыОбработки.ИменаКолонокСтатусыПубликации Цикл
					
					Значение = ВыборкаДанных[ПараметрыОбработки.ПрефиксСтатусыПубликации + ИмяКолонки]; // Произвольный
					
					СтараяСтрокаСтатусыПубликации[ИмяКолонки] = Значение;
					НоваяСтрокаСтатусыПубликации[ИмяКолонки] = Значение;
					
				КонецЦикла;
				
				НоваяСтрокаСтатусыПубликации.НоменклатураПартнера = НоменклатураКонтрагентовСсылка;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПараметрыОбработки.КоличествоОбработано = ПараметрыОбработки.КоличествоОбработано + ВыборкаДанных.Количество();
	
КонецПроцедуры

Функция ИменаРеквизитовСправочникаНоменклатураКонтрагентов(ТолькоРеквизитыГруппы)
	
	ИменаРеквизитов = Новый Массив; // Массив из Строка
	ИменаРеквизитов.Добавить("Наименование");
	ИменаРеквизитов.Добавить("ПометкаУдаления");
	
	ВариантыИспользования = Новый Массив; // Массив из ИспользованиеРеквизита
	ВариантыИспользования.Добавить(Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппыИЭлемента);
	Если ТолькоРеквизитыГруппы Тогда
		ВариантыИспользования.Добавить(Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы);
	Иначе
		ВариантыИспользования.Добавить(Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента);
	КонецЕсли;
	
	Для Каждого Реквизит Из Метаданные.Справочники.НоменклатураКонтрагентов.Реквизиты Цикл
		Если ВариантыИспользования.Найти(Реквизит.Использование) <> Неопределено Тогда
			ИменаРеквизитов.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Результат = СтрСоединить(ИменаРеквизитов, ",");
	Возврат Результат;
	
КонецФункции

// Дополняет состав ошибки.
//
// Параметры:
//   Приемник - см. НоваяОшибка.
//   Источник - см. НоваяОшибка.
//
Процедура ДополнитьОшибку(Приемник, Источник) Экспорт

	Если ПустаяСтрока(Источник.КодОшибки) Тогда
		Возврат;
	ИначеЕсли ПустаяСтрока(Приемник.КодОшибки) Тогда
		Приемник = Источник;
	Иначе
		Если Не ЗначениеЗаполнено(Приемник.Детализация) Тогда
			ОписаниеОшибки = Новый Массив;
			Если Не ПустаяСтрока(Приемник.ОписаниеОшибки) Тогда
				ОписаниеОшибки.Добавить(Приемник.ОписаниеОшибки);
			КонецЕсли;
			Если Не ПустаяСтрока(Источник.ОписаниеОшибки) Тогда
				ОписаниеОшибки.Добавить(Источник.ОписаниеОшибки);
			КонецЕсли;
			
			Приемник.ОписаниеОшибки = ?(ОписаниеОшибки.Количество() > 0, СтрСоединить(ОписаниеОшибки, Символы.ПС), "");;
			Приемник.Детализация = Источник.Детализация;
		Иначе
			Если ТипЗнч(Приемник.Детализация) = Тип("Массив") Тогда
				Детализация = Приемник.Детализация;
			Иначе
				Детализация = Новый Массив;
				Детализация.Добавить(Приемник.Детализация);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Источник.Детализация) Тогда
				СоставОшибкиИсточника = ?(ПустаяСтрока(Источник.ОписаниеОшибки), "", Источник.ОписаниеОшибки + ":" + Символы.ПС)
					+ СтрСоединить(Источник.Детализация, Символы.ПС + "   ");
			Иначе
				СоставОшибкиИсточника = Источник.ОписаниеОшибки;
			КонецЕсли;
			
			Детализация.Добавить(СоставОшибкиИсточника);
			
			Приемник.Детализация = Детализация;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Отправляет уведомление с сервера на клиент через МенеджерУведомленийКлиента с ключом серверных уведомлений подсистемы.
//
// Параметры:
//  ИмяСобытияОповещения - Строка - оповещение для уточнения события, которое будет передано на клиент.
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиМаркетплейсов - учетная запись торговой площадки.
//
Процедура ОтправитьСерверноеУведомлениеНаКлиент(ИмяСобытияОповещения, УчетнаяЗапись) Экспорт
	
	Если ПустаяСтрока(ИмяСобытияОповещения) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеУведомления = ИнтеграцияСМаркетплейсамиКлиентСервер.НовыеДанныеСерверногоУведомления();
	
	ДанныеУведомления.ИмяСобытияОповещения = ИмяСобытияОповещения;
	ДанныеУведомления.УчетнаяЗапись        = УчетнаяЗапись;
	
	УведомленияКлиента.ОтправитьУведомление(
		ИнтеграцияСМаркетплейсамиКлиентСервер.КлючСерверныхУведомлений(), ДанныеУведомления);
	
КонецПроцедуры

// Формирует текст запроса для выбора всех полей объекта метаданных.
//
// Параметры:
//   ИмяОбъектаМетаданных - Строка - имя объекта метаданных, например:"РегистрСведений.ЗаказыТорговыхПлощадок".
//   ПсевдонимТаблицы     - Строка - имя таблицы в запросе, из которой выполняется выборка данных.
//   ИсключаемыеПоля      - Неопределено, Массив из Строка - исключаемые из запроса поля. Для исключения полей
//                          табличных частей необходимо их указать в виде "ИмяТабличнойЧасти.ИмяИсключаемогоПоля".
//   ПрефиксПолей         - Строка - префикс для полей, выбираемых в запросе.
//
// Возвращаемое значение:
//   Строка - текст запроса для выбора полей объекта.
//
Функция ТекстЗапросаПолейОбъектаМетаданных(ИмяОбъектаМетаданных, ПсевдонимТаблицы, Знач ИсключаемыеПоля = Неопределено,
			ПрефиксПолей = "") Экспорт
	
	Если ИсключаемыеПоля = Неопределено Тогда
		ИсключаемыеПоля = Новый Массив;
	КонецЕсли;
	
	МетаданныеРегистра = ОбщегоНазначения.ОбъектМетаданныхПоПолномуИмени(ИмяОбъектаМетаданных);
	
	Кандидаты = Новый Структура;
	Кандидаты.Вставить("Измерения", Неопределено);
	Кандидаты.Вставить("Ресурсы", Неопределено);
	Кандидаты.Вставить("СтандартныеРеквизиты", Неопределено);
	Кандидаты.Вставить("Реквизиты", Неопределено);
	Кандидаты.Вставить("ТабличныеЧасти", Неопределено);
	
	ЗаполнитьЗначенияСвойств(Кандидаты, МетаданныеРегистра);
	
	ПустыеЗначенияПолей = Новый Соответствие;
	ДобавляемыеПоля = Новый Массив; // Массив из Строка
	
	ДобавитьПоляКоллекцииМетаданных(
		Кандидаты.Измерения, ДобавляемыеПоля, ИсключаемыеПоля, ПустыеЗначенияПолей);
	ДобавитьПоляКоллекцииМетаданных(
		Кандидаты.Ресурсы, ДобавляемыеПоля, ИсключаемыеПоля, ПустыеЗначенияПолей);
	ДобавитьПоляКоллекцииМетаданных(
		Кандидаты.СтандартныеРеквизиты, ДобавляемыеПоля, ИсключаемыеПоля, ПустыеЗначенияПолей);
	ДобавитьПоляКоллекцииМетаданных(
		Кандидаты.Реквизиты, ДобавляемыеПоля, ИсключаемыеПоля, ПустыеЗначенияПолей);
	
	ПоляРегистра = Новый Массив; // Массив из Строка
	
	Для Каждого ИмяПоля Из ДобавляемыеПоля Цикл
		
		ПустоеЗначение = ПустыеЗначенияПолей.Получить(ИмяПоля);
		ТекстПоля = СтрШаблон("ЕСТЬNULL(%1.%2, %3) КАК %4%2", ПсевдонимТаблицы, ИмяПоля, ПустоеЗначение, ПрефиксПолей);
		ПоляРегистра.Добавить(ТекстПоля);
		
	КонецЦикла;
	
	Если Кандидаты.ТабличныеЧасти <> Неопределено Тогда
		
		Для Каждого ТабличнаяЧасть Из Кандидаты.ТабличныеЧасти Цикл // ОбъектМетаданныхТабличнаяЧасть
			
			ИмяТабличнойЧасти = ТабличнаяЧасть.Имя;
			
			ДобавляемыеПоляТабличнойЧасти = Новый Массив;
			
			ДобавитьПоляКоллекцииМетаданных(
				ТабличнаяЧасть.СтандартныеРеквизиты,
				ДобавляемыеПоляТабличнойЧасти,
				ИсключаемыеПоля, ,
				ИмяТабличнойЧасти);
				
			ДобавитьПоляКоллекцииМетаданных(
				ТабличнаяЧасть.Реквизиты,
				ДобавляемыеПоляТабличнойЧасти,
				ИсключаемыеПоля, ,
				ИмяТабличнойЧасти);
			
			ПоляТабличнойЧасти = Новый Массив; // Массив из Строка
			
			Для Каждого ИмяПоля Из ДобавляемыеПоляТабличнойЧасти Цикл
				ПоляТабличнойЧасти.Добавить(СтрШаблон("	%1 КАК %1", ИмяПоля));
			КонецЦикла;
			
			ТекстЗапросаПоляТабличнойЧасти = СтрСоединить(ПоляТабличнойЧасти, "," + Символы.ПС);
			
			ТекстПоляВыборкиТабличнойЧасти = СтрШаблон(
				"%1.%2.(
				|	Ссылка КАК Ссылка,
				|%3
				|) КАК %4%2",
				ПсевдонимТаблицы,
				ИмяТабличнойЧасти,
				ТекстЗапросаПоляТабличнойЧасти,
				ПрефиксПолей);
			
			ПоляРегистра.Добавить(ТекстПоляВыборкиТабличнойЧасти);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Результат = СтрСоединить(ПоляРегистра, "," + Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  РезультатЗапроса - РезультатЗапроса - элемент пакета запросов из см. ДанныеНоменклатурыПартнераДляПереноса.
//
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - содержит все поля справочника НоменклатураКонтрагентов, а также дополнительно:
//      * ПредыдущаяСсылка - СправочникСсылка.НоменклатураКонтрагентов - ссылка номенклатуры предыдущего владельца.
//      * НоваяСсылка - СправочникСсылка.НоменклатураКонтрагентов - ссылка номенклатуры нового владельца.
//      * Родитель - СправочникСсылка.НоменклатураКонтрагентов - ссылка на родителя номенклатуры предыдущего владельца.
//      * Идентификатор - Строка - идентификатор номенклатуры контрагента.
//      * Наименование - Строка - наименование номенклатуры контрагента.
//      * ИмпортируемыеТоварыЕстьДанные - Булево - признак наличия данных в регистре импортируемых товаров.
//      * СтатусыПубликацииЕстьДанные - Булево - признак наличия данных в регистре со статусами публикации.
//
Функция ВыборкаДанныхРезультатаЗапросаНоменклатураПартнераДляПереноса(РезультатЗапроса)
	Возврат РезультатЗапроса.Выбрать();
КонецФункции

// Параметры:
//  КоллекцияМетаданных - Неопределено -
//                      - Массив из ОбъектМетаданныхИзмерение - 
//                      - Массив из ОбъектМетаданныхРесурс - 
//                      - Массив из ОбъектМетаданныхРеквизит - 
//  ДобавляемыеПоля     - Массив из Строка - 
//  ИсключаемыеПоля     - Массив из Строка - 
//  ПустыеЗначенияПолей - Неопределено - 
//                      - Соответствие из Строка - 
//  ИмяТабличнойЧасти   - Строка - 
//
Процедура ДобавитьПоляКоллекцииМетаданных(КоллекцияМетаданных, ДобавляемыеПоля, ИсключаемыеПоля,
			ПустыеЗначенияПолей = Неопределено, ИмяТабличнойЧасти = "")
	
	Если КоллекцияМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		
		ИмяПоля = ОбъектМетаданных.Имя;
		
		Если ПустаяСтрока(ИмяТабличнойЧасти) Тогда
			ИмяИсключаемогоПоля = ИмяПоля;
		Иначе
			ИмяИсключаемогоПоля = СтрШаблон("%1.%2", ИмяТабличнойЧасти, ИмяПоля);
		КонецЕсли;
		
		Если ИсключаемыеПоля.Найти(ИмяИсключаемогоПоля) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавляемыеПоля.Добавить(ИмяПоля);
		
		Если ПустыеЗначенияПолей = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТипПоля = ОбъектМетаданных.Тип;
		ПустоеЗначениеПоля = "НЕОПРЕДЕЛЕНО";
		
		Если ТипПоля.Типы().Количество() = 1 Тогда
			ТипЗначения = ТипПоля.Типы()[0];
			
			Если ОбщегоНазначения.ЭтоСсылка(ТипЗначения) Тогда
				МетаданныеПоТипу = Метаданные.НайтиПоТипу(ТипЗначения);
				ПустоеЗначениеПоля = СтрШаблон("ЗНАЧЕНИЕ(%1.ПустаяСсылка)", МетаданныеПоТипу.ПолноеИмя());
				
			ИначеЕсли ТипЗначения = Тип("Строка") Тогда
				ПустоеЗначениеПоля = """""";
				
			ИначеЕсли ТипЗначения = Тип("Число") Тогда
				ПустоеЗначениеПоля = "0";
				
			ИначеЕсли ТипЗначения = Тип("Дата") Тогда
				ПустоеЗначениеПоля = "ДАТАВРЕМЯ(1, 1, 1)";
				
			ИначеЕсли ТипЗначения = Тип("Булево") Тогда
				ПустоеЗначениеПоля = "ЛОЖЬ";
			КонецЕсли;
			
		КонецЕсли;
		
		ПустыеЗначенияПолей.Вставить(ИмяПоля, ПустоеЗначениеПоля);
		
	КонецЦикла;
	
КонецПроцедуры

// Создание / изменение регламентного задания.
// 
// Параметры:
//  ПараметрыЗадания - Структура - ключевые параметры задания. Свойства:
//   * Метаданные - ОбъектМетаданныхРегламентноеЗадание - Регламентное задание
//   * Ключ - Строка - Ключ
//   * Использование - Булево - Использование задания
//  Наименование - Строка - Используется только, если Создавать = Истина
//  Создавать - Булево - Создать регламентное задание, если такое не найдено и Использование = Истина
Процедура СоздатьИзменитьРегламентноеЗадание(ПараметрыЗадания, Наименование = "", Создавать = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыПоиска = Новый Структура("Метаданные, Ключ", Неопределено, "");
	ЗаполнитьЗначенияСвойств(ПараметрыПоиска, ПараметрыЗадания);
	НайденныеРегламентныеЗадания = РегламентныеЗаданияСервер.НайтиЗадания(ПараметрыПоиска);
	КоличествоНайденныхЗаданий = НайденныеРегламентныеЗадания.Количество();
	
	Если КоличествоНайденныхЗаданий = 0 И ПараметрыЗадания.Использование И Создавать Тогда
		
		Если Не ОбщегоНазначения.РазделениеВключено() Тогда
			Если ПустаяСтрока(Наименование) Тогда
				ПараметрыЗадания.Вставить("Наименование",
					ИнтеграцияСМаркетплейсамиКлиентСервер.СформироватьНаименованиеРегламентногоЗадания(
						ПараметрыЗадания.Метаданные.Синоним, ПараметрыЗадания.Метаданные.ИмяМетода));
			Иначе
				ПараметрыЗадания.Вставить("Наименование", Наименование);
			КонецЕсли;
		КонецЕсли;
		
		РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);
		
	ИначеЕсли НайденныеРегламентныеЗадания.Количество() > 0 Тогда
		
		Для Каждого НайденноеРегламентноеЗадания Из НайденныеРегламентныеЗадания Цикл
			Если НайденноеРегламентноеЗадания.Использование <> ПараметрыЗадания.Использование Тогда
				РегламентныеЗаданияСервер.ИзменитьЗадание(НайденноеРегламентноеЗадания.УникальныйИдентификатор, ПараметрыЗадания);
			КонецЕсли;
			Если ПараметрыЗадания.Использование Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Выгружает цены на маркетплейсы.
// 
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиМаркетплейсов - Учетная запись
//   ДополнительныеПараметры - Неопределено, Структура - Возможные ключи дополнительных параметров:
//    * ПоРасписанию - Булево - признак автоматического или ручного запуска регламентного задания.
//    * АдресРезультата - Строка - Адрес временного хранилища, в которое необходимо положить результат выполнения функции.
//    * ТаблицаТоваров        - ТаблицаЗначений - список товаров:
//      ** УчетнаяЗапись        - СправочникСсылка.УчетныеЗаписиМаркетплейсов - учетная запись подключения к сервису;
//      ** Номенклатура         - СправочникСсылка.Номенклатура - номенклатура;
//      ** Характеристика       - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика;
//      ** Упаковка             - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка.
Процедура ВыгрузитьЦеныНаМаркетплейсы(УчетнаяЗапись, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ВыгрузкаЦенНаМаркетплейсы);
	
	ВидМаркетплейса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ВидМаркетплейса");
	
	Если ИнтеграцияСМаркетплейсамиСИ.ЭтоМаркетплейсСИ(ВидМаркетплейса) Тогда
		Если ДополнительныеПараметры = Неопределено Тогда
			ДополнительныеПараметры = Новый Структура;
		КонецЕсли;
		ДополнительныеПараметры.Вставить("ВидМаркетплейса", ВидМаркетплейса);
		ИнтеграцияСМаркетплейсамиСИ.ВыгрузитьЦеныТоваровРегламентнымЗаданием(УчетнаяЗапись, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

// Выгружает остатки товаров на маркетплейсы.
// 
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиМаркетплейсов - Учетная запись
//   ДополнительныеПараметры - Неопределено, Структура - см. ДополнительныеПараметрыРегламентногоЗадания
Процедура ВыгрузитьОстаткиНаМаркетплейсы(УчетнаяЗапись, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ВыгрузкаОстатковНаМаркетплейсы);
	
	ВидМаркетплейса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ВидМаркетплейса");
	
	Если ИнтеграцияСМаркетплейсамиСИ.ЭтоМаркетплейсСИ(ВидМаркетплейса) Тогда
		Если ДополнительныеПараметры = Неопределено Тогда
			ДополнительныеПараметры = Новый Структура;
		КонецЕсли;
		ДополнительныеПараметры.Вставить("ВидМаркетплейса", ВидМаркетплейса);
		
		ИнтеграцияСМаркетплейсамиСИ.ВыгрузитьОстаткиТоваровРегламентнымЗаданием(УчетнаяЗапись, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
