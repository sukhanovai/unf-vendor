Функция ЗаказыСостоянияСопоставлениеПолучить( УчетнаяЗапись ) Экспорт
	
	Результат = Новый Соответствие;
	
	ЗапросТекст =
	"ВЫБРАТЬ
	|	УчетныеЗаписиМаркетплейсовЗаказыСостоянияСопоставление.СостояниеСайт КАК СостояниеСайт,
	|	УчетныеЗаписиМаркетплейсовЗаказыСостоянияСопоставление.Состояние1С КАК Состояние1С,
	|	УчетныеЗаписиМаркетплейсовЗаказыСостоянияСопоставление.РезервироватьТовар КАК РезервироватьТовар
	|ИЗ
	|	Справочник.УчетныеЗаписиМаркетплейсов.ЗаказыСостоянияСопоставление КАК
	|		УчетныеЗаписиМаркетплейсовЗаказыСостоянияСопоставление";
	ЗапросОбъект = Новый Запрос( ЗапросТекст );
	ЗапросОбъект.УстановитьПараметр( "УчетнаяЗапись", УчетнаяЗапись );
	ЗапросВыборка = ЗапросОбъект.Выполнить().Выбрать();
	Пока ЗапросВыборка.Следующий() Цикл
		
		Элемент = Новый Структура( "Состояние1С, РезервироватьТовар",
		ЗапросВыборка.Состояние1С, ЗапросВыборка.РезервироватьТовар );
		 
		Результат.Вставить( ЗапросВыборка.СостояниеСайт, Элемент );
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

функция ТоварыИдентификаторыНовый() Экспорт
	
	ОписаниеТиповСтрока50 = Новый ОписаниеТипов( "Строка",, Новый КвалификаторыСтроки( 50, ДопустимаяДлина.Переменная) );
	ОписаниеТиповСтрока250 = Новый ОписаниеТипов( "Строка",, Новый КвалификаторыСтроки( 250, ДопустимаяДлина.Переменная) );
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить( "Идентификатор", ОписаниеТиповСтрока50 );// sku
	Результат.Колонки.Добавить( "Артикул", ОписаниеТиповСтрока50 ); // offer_id
	Результат.Колонки.Добавить( "Штрихкод", ОписаниеТиповСтрока50 ); // barcode
	
	Результат.Колонки.Добавить( "Наименование", ОписаниеТиповСтрока250 ); // name
	
	Возврат Результат;
КонецФункции

