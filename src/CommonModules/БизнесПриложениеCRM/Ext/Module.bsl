		Элементы.Переместить(Элементы.КонтрагентИнформация, Элементы.КолонкаШапкаЛево);
		Элементы.Переместить(Элементы.ДоговорИнформация, Элементы.КолонкаШапкаЛево);

		Элементы.ОтображениеПодписиРуководитель.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента .Авто;
		Элементы.ОтображениеПодписиБухгалтер.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента .Авто;
		Элементы.ГруппаПечатьВыставлениеСчетов.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента .Авто;
		Элементы.ПечатьВыставлениеСчетов.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента .Авто;
		Элементы.СкидкаСуммаВыставлениеСчетов.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента .Авто;
		Элементы.СкидкаПроцентВыставлениеСчетов.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента .Авто;
		Элементы.СкидкиВыставлениеСчетов.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента .Авто;
		Элементы.СкидкаПроцентВыставлениеСчетов.РастягиватьПоГоризонтали = Неопределено;
		Элементы.СкидкиВыставлениеСчетов.РастягиватьПоГоризонтали = Неопределено;
		
		Элементы.ГруппаЗаказИПраваяПанель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.ПраваяПанель.Ширина = 0;
		Элементы.ГруппаОтступ.Видимость = Ложь;
		
		Элементы.ГруппаПодписиРеклама.Ширина = 0;
		Элементы.ГруппаПодписиРеклама.РастягиватьПоГоризонтали = Неопределено;
		Элементы.ТекстУсловийСчетаЗаказаВыставлениеСчетов.Ширина = 0;
		Элементы.ТекстУсловийСчетаЗаказаВыставлениеСчетов.РастягиватьПоГоризонтали = Неопределено;
		Элементы.РекламныйБлокПечтаныхФорм.АвтоМаксимальнаяШирина = Истина;
		Элементы.КолонкаШапкаЛево.РастягиватьПоГоризонтали = Истина;
		
		Элементы.ПодвалВыставлениеСчетов.Поведение = ПоведениеОбычнойГруппы.Авто;
		Элементы.ПодвалВыставлениеСчетовСвернуто.Видимость = Ложь;
		Элементы.ГруппаИтогиВыставлениеСчетов.Ширина = 0;
		Элементы.ГруппаИтогиВыставлениеСчетов.РастягиватьПоГоризонтали = Неопределено;
		
		Элементы.Переместить(Элементы.ШапкаВыставлениеСчетовПраваяКолонка, Элементы.ГруппаДляЛого);
		Элементы.ГруппаДляЛого.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элементы.ГруппаДляЛого.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы .Нет;
		Элементы.ЛоготипВыставлениеСчетов.Высота = 3;
		Элементы.ДекорацияQR.Высота = 2;
		Элементы.ДекорацияQRСБП.Высота = 2;
		Элементы.ИтогОбъем.Ширина = 10;
		Элементы.ИтогВес.Ширина = 13;
		
		Если ЭтоТакси Тогда
			Элементы.НомерВыставлениеСчетов.ШрифтЗаголовка = Новый Шрифт;
			Элементы.ДатаВыставлениеСчетов.ШрифтЗаголовка = Новый Шрифт;
			Элементы.ОтгрузкаДо.Заголовок = НСтр("ru = 'Отгрузка'");
			Элементы.ОтгрузкаДо.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы .Авто;
			Элементы.ОплатаДо.Заголовок = НСтр("ru = 'Оплата'");
			Элементы.ОплатаДо.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы .Авто;
			Элементы.ДекорацияQR.Ширина = 6;
			Элементы.ДекорацияQRСБП.Ширина = 6;
			Элементы.Переместить(Элементы.НомерВыставлениеСчетов, Элементы.РеквизитыШапкиВыставлениеСчетов);
			Элементы.Переместить(Элементы.ДатаВыставлениеСчетов, Элементы.РеквизитыШапкиВыставлениеСчетов);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

Функция ПолучитьОплатуОтгрузкуЗаказа(Заказ) Экспорт
	
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ОтгрузкаПолувыставлятор", 2);
	СтруктураОтвет.Вставить("ОплатаПолувыставлятор", 2);
	
	ЗапросЗаказ = Новый Запрос;
	ЗапросЗаказ.Текст = "ВЫБРАТЬ
	                    |	ВЫБОР
	                    |		КОГДА ДокументЗаказПокупателя.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	                    |				ИЛИ НЕ ДокументЗаказПокупателя.Проведен
	                    |				ИЛИ ДокументЗаказПокупателя.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаявкаНаПродажу), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаявкаЗаказНаряд))
	                    |				ИЛИ ДокументЗаказПокупателя.НетСтрокВДокументе
	                    |			ТОГДА -1
	                    |		КОГДА ДокументЗаказПокупателя.ОжидаетсяВыборВариантаКП
	                    |			ТОГДА 2
	                    |		КОГДА ГрафикВыполнения.Заказ ЕСТЬ NULL
	                    |				И ГрафикВыполненияПлан.Заказ ЕСТЬ NULL
	                    |			ТОГДА 0
	                    |		КОГДА ЕСТЬNULL(ГрафикВыполнения.Выполнено, 0) = 0
	                    |				И ЕСТЬNULL(ГрафикВыполненияПлан.Выполнено, 0) = 0
	                    |			ТОГДА ВЫБОР
	                    |					КОГДА ГрафикВыполнения.Заказ ЕСТЬ NULL
	                    |						ТОГДА 2
	                    |					КОГДА ГрафикВыполнения.Период < &АктуальнаяДатаСеанса
	                    |						ТОГДА 6
	                    |					КОГДА ГрафикВыполнения.Период = &АктуальнаяДатаСеанса
	                    |						ТОГДА 4
	                    |					ИНАЧЕ 2
	                    |				КОНЕЦ
	                    |		ИНАЧЕ ВЫБОР
	                    |				КОГДА ГрафикВыполнения.Заказ ЕСТЬ NULL
	                    |					ТОГДА 1
	                    |				КОГДА ГрафикВыполнения.Период < &АктуальнаяДатаСеанса
	                    |					ТОГДА 5
	                    |				КОГДА ГрафикВыполнения.Период = &АктуальнаяДатаСеанса
	                    |					ТОГДА 3
	                    |				ИНАЧЕ 1
	                    |			КОНЕЦ
	                    |	КОНЕЦ КАК НомерКартинкиОтгрузки,
	                    |	ВЫБОР
	                    |		КОГДА НЕ ДокументЗаказПокупателя.Контрагент.ВестиРасчетыПоЗаказам
	                    |			ТОГДА -1
	                    |		КОГДА ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) = 0
	                    |			ТОГДА ВЫБОР
	                    |					КОГДА ДокументЗаказПокупателя.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	                    |							ИЛИ НЕ ДокументЗаказПокупателя.Проведен
	                    |							ИЛИ ДокументЗаказПокупателя.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаявкаНаПродажу), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаявкаЗаказНаряд))
	                    |						ТОГДА -1
	                    |					КОГДА (ДокументЗаказПокупателя.ЗапланироватьОплату
	                    |							ИЛИ ДокументЗаказПокупателя.ОплатаДо <> ДАТАВРЕМЯ(1, 1, 1))
	                    |							И НЕ ГрафикОплаты.СчетНаОплату ЕСТЬ NULL
	                    |							И НЕ ДокументЗаказПокупателя.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
	                    |						ТОГДА ВЫБОР
	                    |								КОГДА ГрафикОплаты.Период < &АктуальнаяДатаСеанса
	                    |									ТОГДА 6
	                    |								КОГДА ГрафикОплаты.Период = &АктуальнаяДатаСеанса
	                    |									ТОГДА 4
	                    |								ИНАЧЕ 2
	                    |							КОНЕЦ
	                    |					КОГДА ЕСТЬNULL(ФактОплаты.Сумма, 0) = 0
	                    |						ТОГДА -1
	                    |					ИНАЧЕ 2
	                    |				КОНЕЦ
	                    |		КОГДА ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) = ДокументЗаказПокупателя.СуммаДокумента
	                    |			ТОГДА 0
	                    |		КОГДА ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) > ДокументЗаказПокупателя.СуммаДокумента
	                    |			ТОГДА 7
	                    |		ИНАЧЕ ВЫБОР
	                    |				КОГДА ДокументЗаказПокупателя.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
	                    |						ИЛИ НЕ ДокументЗаказПокупателя.Проведен
	                    |						ИЛИ ДокументЗаказПокупателя.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаявкаНаПродажу), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаявкаЗаказНаряд))
	                    |					ТОГДА 1
	                    |				КОГДА (ДокументЗаказПокупателя.ЗапланироватьОплату
	                    |						ИЛИ ДокументЗаказПокупателя.ОплатаДо <> ДАТАВРЕМЯ(1, 1, 1))
	                    |						И НЕ ГрафикОплаты.СчетНаОплату ЕСТЬ NULL
	                    |						И НЕ ДокументЗаказПокупателя.СостояниеЗаказа = ЗНАЧЕНИЕ(Справочник.СостоянияЗаказовПокупателей.Завершен)
	                    |					ТОГДА ВЫБОР
	                    |							КОГДА ГрафикОплаты.Период < &АктуальнаяДатаСеанса
	                    |								ТОГДА 5
	                    |							КОГДА ГрафикОплаты.Период = &АктуальнаяДатаСеанса
	                    |								ТОГДА 3
	                    |							ИНАЧЕ 1
	                    |						КОНЕЦ
	                    |				ИНАЧЕ 1
	                    |			КОНЕЦ
	                    |	КОНЕЦ КАК НомерКартинкиОплаты
	                    |ИЗ
	                    |	Документ.ЗаказПокупателя КАК ДокументЗаказПокупателя
	                    |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикВыполненияЗаказов КАК ГрафикВыполнения
	                    |		ПО ДокументЗаказПокупателя.Ссылка = ГрафикВыполнения.Заказ
	                    |			И (ГрафикВыполнения.Период <= &АктуальнаяДатаСеанса)}
	                    |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикВыполненияЗаказов КАК ГрафикВыполненияПлан
	                    |		ПО ДокументЗаказПокупателя.Ссылка = ГрафикВыполненияПлан.Заказ
	                    |			И (ГрафикВыполненияПлан.Период > &АктуальнаяДатаСеанса)}
	                    |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикОплатыЗаказов КАК ГрафикОплаты
	                    |		ПО ДокументЗаказПокупателя.Ссылка = ГрафикОплаты.СчетНаОплату
	                    |			И (ГрафикОплаты.Период <= &АктуальнаяДатаСеанса)}
	                    |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФактОплатыЗаказов КАК ФактОплаты
	                    |		ПО ДокументЗаказПокупателя.Ссылка = ФактОплаты.СчетНаОплату}
	                    |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
	                    |		ПО (СостоянияЭД.СсылкаНаОбъект = ДокументЗаказПокупателя.Ссылка)}
	                    |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыПокупателейССайта
	                    |		ПО ДокументЗаказПокупателя.Ссылка = ЗаказыПокупателейССайта.ЗаказПокупателя}
	                    |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
	                    |		ПО ДокументЗаказПокупателя.Ссылка = НаличиеФайлов.ОбъектСФайлами}
	                    |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОригиналовПервичныхДокументов КАК СостоянияОригиналовПервичныхДокументов
	                    |		ПО ДокументЗаказПокупателя.Ссылка = СостоянияОригиналовПервичныхДокументов.Владелец
	                    |			И (СостоянияОригиналовПервичныхДокументов.ОбщееСостояние = ИСТИНА)}
	                    |ГДЕ
	                    |	ДокументЗаказПокупателя.Ссылка = &Ссылка";
	ЗапросЗаказ.УстановитьПараметр("Ссылка", Заказ);
	ЗапросЗаказ.УстановитьПараметр("АктуальнаяДатаСеанса", НачалоДня(ТекущаяДатаСеанса()));
	ЛидыДоступны = РаботаСЛидами.ЛидыДоступны();
	ЗапросЗаказ.УстановитьПараметр("ЛидыДоступны", ЛидыДоступны);
	ЗапросЗаказ.УстановитьПараметр("НеУчитывается", НСтр("ru = 'Не учитывается'"));
	ЗапросЗаказ.УстановитьПараметр("ОплаченПолностью", НСтр("ru = 'Оплачен полностью'"));
	ЗапросЗаказ.УстановитьПараметр("ОплаченЧастично", НСтр("ru = 'Оплачен частично'"));
	ЗапросЗаказ.УстановитьПараметр("БезОплаты", НСтр("ru = 'Без оплаты'")); 
	
	Выборка = ЗапросЗаказ.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда                                 
		СтруктураОтвет.ОтгрузкаПолувыставлятор = Выборка.НомерКартинкиОтгрузки;	
		СтруктураОтвет.ОплатаПолувыставлятор = Выборка.НомерКартинкиОплаты;	
	КонецЕсли;
	
	Возврат СтруктураОтвет;
	
КонецФункции

Процедура ОчиститьОплатуОтгрузкуВНеудачноЗавершенныхДокументах() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.СостояниеЗаказа = &СостояниеЗаказа
		|	И ЗаказПокупателя.ВариантЗавершения = &ВариантЗавершения
		|	И (ЗаказПокупателя.ОтгруженВВыставленииСчетов = ИСТИНА
		|			ИЛИ ЗаказПокупателя.ОплаченВВыставленииСчетов = ИСТИНА)";
	Запрос.УстановитьПараметр("СостояниеЗаказа", Справочники.СостоянияЗаказовПокупателей.Завершен);
	Запрос.УстановитьПараметр("ВариантЗавершения", Перечисления.ВариантыЗавершенияЗаказа.Отменен);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Попытка
			ДокументОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ДокументОбъект.ОтгруженВВыставленииСчетов = Ложь;
			ДокументОбъект.ОплаченВВыставленииСчетов = Ложь;
			ДокументОбъект.ВидЗакрывающегоДокументаВыставлениеСчетов = Перечисления.ДоступныеПечатныеФормыВыставлениеСчетов.ПустаяСсылка();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ИнформацияОшибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ОшибкаИзмененияДокументаПриПереходеИзВыставленияСчетов",
				УровеньЖурналаРегистрации.Ошибка,,, ИнформацияОшибка);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры	

Процедура УстановитьОплатуОтгрузкуВУдачноЗавершенныхДокументах() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.СостояниеЗаказа = &СостояниеЗаказа
		|	И ЗаказПокупателя.ВариантЗавершения = &ВариантЗавершения
		|	И ((ЗаказПокупателя.ОтгруженВВыставленииСчетов = ИСТИНА
		|				И ЗаказПокупателя.ОплаченВВыставленииСчетов <> ИСТИНА)
		|			ИЛИ (ЗаказПокупателя.ОтгруженВВыставленииСчетов <> ИСТИНА
		|				И ЗаказПокупателя.ОплаченВВыставленииСчетов = ИСТИНА))";
	Запрос.УстановитьПараметр("СостояниеЗаказа", Справочники.СостоянияЗаказовПокупателей.Завершен);
	Запрос.УстановитьПараметр("ВариантЗавершения", Перечисления.ВариантыЗавершенияЗаказа.Успешно);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Попытка
			ДокументОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ДокументОбъект.ОтгруженВВыставленииСчетов = Истина;
			ДокументОбъект.ОплаченВВыставленииСчетов = Истина;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ИнформацияОшибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ОшибкаИзмененияДокументаПриПереходеИзВыставленияСчетов",
				УровеньЖурналаРегистрации.Ошибка,,, ИнформацияОшибка);
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры	

Процедура ОбработатьПодключениеПолувыставлятора() Экспорт
	
	Константы.ВыставлениеСчетовБылоОтключено.Установить(Ложь);
	Константы.ИспользоватьПолувыставлятор.Установить(Истина);
	БизнесПриложениеCRM.ОчиститьОплатуОтгрузкуВНеудачноЗавершенныхДокументах();
	БизнесПриложениеCRM.УстановитьОплатуОтгрузкуВУдачноЗавершенныхДокументах(); 
	
КонецПроцедуры 

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

Процедура ПроизвестиНестандартнуюОбработкуПриВключении()

	Если НЕ ВозможностиПриложения.КонстантаДоступнаВПриложении("ИспользоватьРаспознаваниеДокументов") Тогда
		Константы.ИспользоватьРаспознаваниеДокументов.Установить(Ложь);
	КонецЕсли;
	
	Константы.ИспользоватьРаботуСПоискомКонтрагентовВСписке.Установить(Ложь);
	УправлениеКонтактнойИнформациейУНФ.ОбновитьВидыКИ();
	
	Если Константы.ВыставлениеСчетовБылоОтключено.Получить() = Истина Тогда
		БизнесПриложениеCRM.ОбработатьПодключениеПолувыставлятора();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроизвестиНестандартнуюОбработкуПриОтключении()

	УправлениеКонтактнойИнформациейУНФ.ОбновитьВидыКИ();
	
КонецПроцедуры

#КонецОбласти
