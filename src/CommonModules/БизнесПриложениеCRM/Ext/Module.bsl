#Область СлужебныйПрограммныйИнтерфейс     

Процедура ПриСозданииНаСервереЗаказПокупателяПолувыставлятор(Форма, Объект) Экспорт
	                                                             
	Элементы = Форма.Элементы;
	
	ИспользоватьПолувыставлятор = ПолучитьФункциональнуюОпцию("ИспользоватьПолувыставлятор");
	Если ИспользоватьПолувыставлятор = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	БылЗавершенВВыставленииСчетов =	Объект.ОтгруженВВыставленииСчетов И Объект.ОплаченВВыставленииСчетов 
		И Объект.СостояниеЗаказа = ПредопределенноеЗначение("Справочник.СостоянияЗаказовПокупателей.Завершен")
		И Объект.ВариантЗавершения = Перечисления.ВариантыЗавершенияЗаказа.Успешно;
	ЭтоМобильныйКлиент = ОбщегоНазначения.ЭтоМобильныйКлиент();

	// Проверяем на даты запрета	
	ОбъектНеПроходитПоДатеЗапрета = Ложь;   
	ОбъектНеПроходитПоДатеЗапрета = ДатыЗапретаИзменения.ИзменениеЗапрещено(Форма.РеквизитФормыВЗначение("Объект"));
	Форма.ЗаблокированДатойЗапрета = ОбъектНеПроходитПоДатеЗапрета;
	Если ОбъектНеПроходитПоДатеЗапрета = Истина Тогда
		Если Объект.Ссылка.Пустая() Тогда
			ОбъектНеПроходитПоДатеЗапрета = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбъектНеПроходитПоДатеЗапрета = Истина Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПраваяПанель", "ТолькоПросмотр", Истина);	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодвалВыставлениеСчетов", "ТолькоПросмотр", Истина);	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Банк", "ТолькоПросмотр", Истина);	
	КонецЕсли;
		
	// Включаем правую панель
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПраваяПанель", "Видимость", Истина);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПраваяПанельСвернуто", "Видимость", Ложь);
	
	//Подключаем шапку и подвал от Выставления счетов
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ШапкаВыставлениеСчетов", "Видимость", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Шапка", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодвалВыставлениеСчетовОбъединение", "Видимость", Истина);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодвалВыставлениеСчетов", "Видимость", Истина);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодвалВыставлениеСчетовСвернуто", "Видимость", Истина);	
	
	// Прячем кнопку печатных форм от Выставления счетов
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОформитьАктНакладнуюВыставлениеСчетов", "Видимость", Ложь);	
	
	// Прячем элементы от Выставления счетов
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонтрагентВыставлениеСчетов", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СкидкиВыставлениеСчетов", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИтогиВыставлениеСчетовТакси", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтгруженВВыставленииСчетов", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОплаченВВыставленииСчетов", "Видимость", Ложь);  
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияОтгружен", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияОплачен", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияЗавершен", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СчетЗавершен", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СчетЗавершен", "ТолькоПросмотр", Истина); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИтогиВыставлениеСчетовКолонка1", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИтогиВыставлениеСчетовКолонка2", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗаглушкаСтатусаЗавершен", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИтогиПредоплата", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПечатьОтправить", "Видимость", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ШапкаВыставлениеСчетовПраваяКолонка", "Видимость", Ложь);

	// Видимость элементов, зависящих от завершенности в выставлении счетов
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаЗакрывающийДокумент", "Видимость", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВидЗакрывающегоДокументаБизнесПриложение", "Видимость", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НомерЗакрывающегоДокумента", "Видимость", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДатаЗакрывающегоДокумента", "Видимость", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаКнопкиАктаНакладной", "Видимость", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НапечататьАктНакладную", "Видимость", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДополнительныеРеквизитыБизнесПриложение", "Видимость", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТекстУсловийСчетаЗаказаВыставлениеСчетов", "Видимость", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Комментарий", "Видимость", НЕ БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВидИСостояние", "ТолькоПросмотр", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВариантЗавершения", "ТолькоПросмотр", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВариантЗавершенияПраваяПанель", "ТолькоПросмотр", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СостояниеЗаказа", "ТолькоПросмотр", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗапасыВставитьСтроки", "Видимость", НЕ БылЗавершенВВыставленииСчетов);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗапасыПодбор", "Доступность", НЕ БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗагрузкаДанныхИзВнешнегоИсточника", "Доступность", НЕ БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗапасыКомандыИзменитьРезерв", "Доступность", НЕ БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПланируемыеДатыПраваяПанель", "ТолькоПросмотр", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗапасыУстановитьФлажки", "Доступность", НЕ БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗапасыГруппаОтменаТоваров", "ТолькоПросмотр", БылЗавершенВВыставленииСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗапасыПоискПоШтрихкоду", "Доступность", НЕ БылЗавершенВВыставленииСчетов);

	// Включаем видимость наших элементов 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтгрузкаПолувыставлятор", "Видимость", Истина);
