	ПараметрыДляОткрытия.Вставить("ЗаголовокЭлемента", НСтр("ru = ''"));
	ПараметрыДляОткрытия.Вставить("ТипЗначения", Неопределено);
	ПараметрыДляОткрытия.Вставить("Формат", НСтр("ru = ''"));
	ПараметрыДляОткрытия.Вставить("МаскаВвода", НСтр("ru = ''"));
	ПараметрыДляОткрытия.Вставить("ЗначениеЭлемента", Неопределено);
	ПараметрыДляОткрытия.Вставить("ТребуетсяРазделитель", Истина);
	ПараметрыДляОткрытия.Вставить("РежимКассыСамообслуживания", Ложь);
	ПараметрыДляОткрытия.Вставить("КомпактныйРежимПодменю", Ложь);
	
	Возврат ПараметрыДляОткрытия;
	
КонецФункции

Функция СформироватьЗаголовокВызоваСотрудника(ЭтоУдаленныйСотрудник, НаименованиеПользователяВОбращении) Экспорт
	
	РезультатФункции = "";
	Если ЗначениеЗаполнено(НаименованиеПользователяВОбращении) Тогда
		НачалоФразы = НСтр("ru = 'Обратитесь к'");
		РезультатФункции = СтрШаблон("%1 %2", НачалоФразы, НаименованиеПользователяВОбращении);
	ИначеЕсли ЭтоУдаленныйСотрудник Тогда
		РезультатФункции = НСтр("ru = 'Обратитесь к сотруднику.'");
	Иначе
		РезультатФункции = НСтр("ru = 'Ожидайте сотрудника.'");
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

Функция ИспользуетсяУникальныйВидОплаты(Форма) Экспорт
	
	РезультатФункции = Ложь;
	Если Не Форма.ИспользуемыеВидыОплат = Неопределено Тогда
		МассивПоддерживаемыхВидов = ИнтерфейсРМКСлужебныйКлиентСервер.ПоддерживаемыеКнопкиУникальныхВидовОплат();
		РезультатФункции = (Форма.ИспользуемыеВидыОплат.Количество() = 1
			И (Не МассивПоддерживаемыхВидов.Найти(Форма.ИспользуемыеВидыОплат[0]) = Неопределено));
	КонецЕсли;
		
	Возврат РезультатФункции;
	
КонецФункции

Процедура НастроитьВидКнопкиОплатыВПлитке(Форма, ЭтоВозврат = Ложь) Экспорт
	
	Элементы = Форма.Элементы;
	Если (Не ЭтоВозврат) И (Не Форма.РежимЗаказа) И ПропуститьОкноСВыборомКартыЛояльностиДопустимо(Форма) Тогда
		Элементы.СтраницаКнопкиПереходаКОплатеПлитка.Видимость = Ложь;
		Элементы.СтраницаУникальнойКнопкиОплатыПлитка.Видимость = Истина;
		Элементы.ВидыКнопкиОплатыВПлитке.ТекущаяСтраница = Элементы.СтраницаУникальнойКнопкиОплатыПлитка;
	Иначе
		Элементы.СтраницаКнопкиПереходаКОплатеПлитка.Видимость = Истина;
		Элементы.СтраницаУникальнойКнопкиОплатыПлитка.Видимость = Ложь;
		Элементы.ВидыКнопкиОплатыВПлитке.ТекущаяСтраница = Элементы.СтраницаКнопкиПереходаКОплатеПлитка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПропуститьОкноСВыборомКартыЛояльностиДопустимо(Форма) Экспорт
	
	РезультатФункции = (Форма.НапоминатьПроВводКартыЛояльности Или (Не Форма.ВводДисконтныхКарт)
		Или ИнтерфейсРМКСлужебныйКлиентСервер.ДанныеЛояльностиЗаполнены(Форма));
	Возврат РезультатФункции;
	
КонецФункции

Функция ШаблонДанныхВосстановленияОплатПриВозврате() Экспорт
	
	РезультатФункции = Новый Структура();
	РезультатФункции.Вставить("ТоварыПриВозврате", Новый Массив);
	РезультатФункции.Вставить("ОплатыПриВозврате", Новый Массив);
	РезультатФункции.Вставить("ДисконтнаяКарта", Неопределено);
	РезультатФункции.Вставить("Контрагент", Неопределено);
	РезультатФункции.Вставить("ИдентификаторКарты", "");
	РезультатФункции.Вставить("КодКарты", "");
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ЗаполнитьКэшДанныхОплатВозврата(Форма) Экспорт
	
	ДанныеОбъекта = Форма.Объект;
	ДанныеОплатПриВозврате = Форма.ДанныеОплатПриВозврате;
	Если ДанныеОплатПриВозврате.ОплатыПриВозврате.Количество() = 0 И ДанныеОбъекта.Оплата.Количество() > 0 Тогда
		
		Для Каждого СтрокаТовара Из ДанныеОбъекта.Товары Цикл
			ДанныеСтрокиТовары = Новый Структура();
			ДанныеСтрокиТовары.Вставить("Номенклатура", СтрокаТовара.Номенклатура);
			ДанныеСтрокиТовары.Вставить("Характеристика", СтрокаТовара.Характеристика);
			ДанныеСтрокиТовары.Вставить("Количество", СтрокаТовара.Количество);
			ДанныеОплатПриВозврате.ТоварыПриВозврате.Добавить(ДанныеСтрокиТовары);
		КонецЦикла;
		
		Для Каждого СтрокаОплаты Из ДанныеОбъекта.Оплата Цикл
			ДанныеСтрокиОплаты = Новый Структура();
			Для Каждого КолонкаОплаты Из Форма.КолонкиТаблицФормы.Оплата Цикл
				ДанныеСтрокиОплаты.Вставить(КолонкаОплаты.Имя, СтрокаОплаты[КолонкаОплаты.Имя]);
			КонецЦикла;
			ДанныеОплатПриВозврате.ОплатыПриВозврате.Добавить(ДанныеСтрокиОплаты);
		КонецЦикла;
		ДанныеОплатПриВозврате.ДисконтнаяКарта = ДанныеОбъекта.ДисконтнаяКарта;
		ДанныеОплатПриВозврате.Контрагент = ДанныеОбъекта.Контрагент;
		Если Не Форма.ПараметрыКартыЛояльности = Неопределено Тогда
			ДанныеОплатПриВозврате.ИдентификаторКарты = Форма.ПараметрыКартыЛояльности.ИдентификаторКарты;
			ДанныеОплатПриВозврате.КодКарты = Форма.ПараметрыКартыЛояльности.КодКарты;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВосстановитьТаблицуОплатВозврата(Форма) Экспорт
	
	ДанныеОбъекта = Форма.Объект;
	ОплатыПриВозврате = Форма.ДанныеОплатПриВозврате.ОплатыПриВозврате;
	Для Каждого ЭлементОплаты Из ОплатыПриВозврате Цикл
		НоваяСтрока = ДанныеОбъекта.Оплата.Добавить();
		Для Каждого КолонкаОплаты Из Форма.КолонкиТаблицФормы.Оплата Цикл
			ЗначениеКолонки = Неопределено;
			Если ЭлементОплаты.Свойство(КолонкаОплаты.Имя, ЗначениеКолонки) Тогда
				НоваяСтрока[КолонкаОплаты.Имя] = ЗначениеКолонки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьКэшДанныхОплатВозврата(ДанныеОплатПриВозврате) Экспорт
	
	ДанныеОплатПриВозврате.ТоварыПриВозврате.Очистить();
	ДанныеОплатПриВозврате.ОплатыПриВозврате.Очистить();
	ДанныеОплатПриВозврате.ДисконтнаяКарта = Неопределено;
	ДанныеОплатПриВозврате.Контрагент = Неопределено;
	ДанныеОплатПриВозврате.ИдентификаторКарты = "";
	ДанныеОплатПриВозврате.КодКарты = "";
	
КонецПроцедуры

Функция ДанныеЛояльностиВозвратаИдентичны(Форма) Экспорт
	
	ДанныеОбъекта = Форма.Объект;
	ДанныеОплатПриВозврате = Форма.ДанныеОплатПриВозврате;
	
	РезультатФункции = ДанныеОбъекта.ДисконтнаяКарта = ДанныеОплатПриВозврате.ДисконтнаяКарта
		И ДанныеОбъекта.Контрагент = ДанныеОплатПриВозврате.Контрагент
		И ((Форма.ПараметрыКартыЛояльности = Неопределено И ДанныеОплатПриВозврате.ИдентификаторКарты = ""
			И ДанныеОплатПриВозврате.КодКарты = "")
				Или (Форма.ПараметрыКартыЛояльности <> Неопределено
					И Форма.ПараметрыКартыЛояльности.ИдентификаторКарты = ДанныеОплатПриВозврате.ИдентификаторКарты
					И Форма.ПараметрыКартыЛояльности.КодКарты = ДанныеОплатПриВозврате.КодКарты));
	
	Возврат РезультатФункции
	
КонецФункции

Функция СоставНоменклатурыВозвратаИдентичен(Товары, КэшИсходныхТоваров) Экспорт
	
	РезультатФункции = Истина;
	КэшТоваров = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(КэшИсходныхТоваров);
	Если Товары.Количество() = КэшТоваров.Количество() Тогда
		КоличествоСтрок = Товары.Количество();
		Счт = 0;
		Пока Счт < КоличествоСтрок И РезультатФункции Цикл
			СтрокаТовара = Товары.Получить(Счт);
			ИндексДанныхКэша = ПолучитьИндексЭлементаКэшаТоваров(КэшТоваров, СтрокаТовара);
			Если ИндексДанныхКэша >= 0 Тогда
				КэшТоваров.Удалить(ИндексДанныхКэша);
			Иначе
				РезультатФункции = Ложь;
			КонецЕсли;
			Счт = Счт + 1;
		КонецЦикла;
	Иначе
		РезультатФункции = Ложь;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

#Область РаботаСЭлектроннымиВесами

Процедура ДобавитьПустоеОписаниеРазмещенияНаЭлектронныхВесах(ДанныеРазмещения, ЭлектронныеВесы) Экспорт
	
	СтрокаРазмещения = ПолучитьСтрокуДанныхРазмещения(ДанныеРазмещения, ЭлектронныеВесы);
	Если СтрокаРазмещения = Неопределено Тогда
		НовоеОписание = МенеджерОборудованияРМККлиент.ПолучитьПараметрыСобытияВеса();
		Если Не НовоеОписание = Неопределено Тогда
			НовоеОписание.ИдентификаторУстройства = ЭлектронныеВесы;
			ДанныеРазмещения.Добавить(НовоеОписание);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьДанныеРазмещенияНаЭлектронныхВесах(ДанныеРазмещения, ПараметрыОповещения) Экспорт
	
	СтрокаРазмещения = ПолучитьСтрокуДанныхРазмещения(ДанныеРазмещения, ПараметрыОповещения.ИдентификаторУстройства);
	Если СтрокаРазмещения = Неопределено Тогда
		СтрокаРазмещения = МенеджерОборудованияРМККлиент.ПолучитьПараметрыСобытияВеса();
		Если Не СтрокаРазмещения = Неопределено Тогда
			СтрокаРазмещения.ИдентификаторУстройства = ПараметрыОповещения.ИдентификаторУстройства;
			ДанныеРазмещения.Добавить(СтрокаРазмещения);
		КонецЕсли;
	КонецЕсли;
	Если Не СтрокаРазмещения = Неопределено Тогда
		СтрокаРазмещения.ОшибкаРазмещения = ПараметрыОповещения.ОшибкаРазмещения;
		СтрокаРазмещения.ЗонаПересечения = ПараметрыОповещения.ЗонаПересечения;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтрокуДанныхРазмещения(ДанныеРазмещения, ЭлектронныеВесы) Экспорт
	
	РезультатФункции = Неопределено;
	
	КоличествоЭлементов = ДанныеРазмещения.Количество();
	Счт = 0;
	Пока Счт < КоличествоЭлементов И РезультатФункции = Неопределено Цикл
		ТекущееОписание = ДанныеРазмещения[Счт];
		Если ТекущееОписание.ИдентификаторУстройства = ЭлектронныеВесы Тогда
			РезультатФункции = ТекущееОписание;
		КонецЕсли;
		Счт = Счт + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция СкопироватьДанныеРазмещенияНаЭлектронныхВесах(ДанныеРазмещения) Экспорт
	
	НовыеДанные = Новый Массив;
	ПоляКопирования = "ОшибкаРазмещения,ИдентификаторУстройства"; // При расширении надо будет поддержать
	// копирование массива зона пересечения, не копирование ссылки
	
	Для Каждого СтрокаРазмещения Из ДанныеРазмещения Цикл
		НоваяСтрокаРазмещения = МенеджерОборудованияРМККлиент.ПолучитьПараметрыСобытияВеса();
		Если Не НоваяСтрокаРазмещения = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРазмещения, СтрокаРазмещения, ПоляКопирования);
			НовыеДанные.Добавить(НоваяСтрокаРазмещения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НовыеДанные;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СхемаФормыРМК

Процедура ЗаполнитьЗначенияШириныГлавнойГруппы(ШиринаОбластиВПроцентах, МинимальнаяШиринаОбласти)
	
	МинимальнаяШиринаВертикальногоЭкрана = 0;
	ПодключенГоризонтальныйЭкран = Ложь;
	ПодключенВертикальныйЭкран = Ложь;
	ИнформацияЭкранов = ПолучитьИнформациюЭкрановКлиента();
	Для Каждого ДанныеЭкрана Из ИнформацияЭкранов Цикл
		Если ДанныеЭкрана.Ширина > ДанныеЭкрана.Высота Тогда
			ПодключенГоризонтальныйЭкран = Истина;
		Иначе
			ПодключенВертикальныйЭкран = Истина;
			Если МинимальнаяШиринаВертикальногоЭкрана = 0 Или ДанныеЭкрана.Ширина < МинимальнаяШиринаВертикальногоЭкрана Тогда
				МинимальнаяШиринаВертикальногоЭкрана = ДанныеЭкрана.Ширина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ПодключенГоризонтальныйЭкран Тогда
		ШиринаОбластиВПроцентах = 60;
		Коэффициент = 0.45;
		Если ПодключенВертикальныйЭкран Тогда
			МинимальнаяШиринаОбласти = Окр(Коэффициент * МинимальнаяШиринаВертикальногоЭкрана, 0, 1);
		КонецЕсли;
	Иначе
		ШиринаОбластиВПроцентах = 98;
	КонецЕсли;
	
КонецПроцедуры

Функция ШаблонСхемыФормыРМК()
	
	РезультатФункции = 
	"<html>
	|	<head>
	|		<meta charset=""utf-8"">
	|		<style>
	|			&WrapperStyle}
	|
	|			.box {
	|				position: absolute;
	|				left: 0;
	|				top: 0;
	|				width: 100%;
	|				height: 100%;
	|				border: 1px solid black;
	|			}
	|			&StyleContent
	|		</style>
	|	</head>
	|	<body>
	|		<div class=""wrapper"">
	|			<div class=""box"">
	|				&FieldContent
	|			</div>
	|		</div>
	|	</body>
	|</html>";
	
	Возврат РезультатФункции;
	
КонецФункции

Функция СформироватьСтильГлавнойГруппы(Форма)
	
	СтильГруппы = "";
	
	Если Форма.ГоризонтальнаяОриентация Тогда
		ПроцентПропорции = Окр(100 * Форма.ВысотаСхемыРМК / Форма.ШиринаСхемыРМК, 1, 1);
		СтильГруппы =
		".wrapper {
		|	position: relative;
		|	width: 98%;
		|	padding-top: &Ratio%;
		|	}";
		СтильГруппы = СтрЗаменить(СтильГруппы, "&Ratio", Формат(ПроцентПропорции, "ЧРД=.; ЧГ="));
	Иначе
		ШиринаОбластиВПроцентах = 0;
		МинимальнаяШиринаОбласти = 0;
		ЗаполнитьЗначенияШириныГлавнойГруппы(ШиринаОбластиВПроцентах, МинимальнаяШиринаОбласти);
		СтильГруппы =
		".wrapper {
		|	position: relative;
		|	height: 98%;
		|	width: &DivWidth%;
		|	&DivMinWidth
		|	}";
		СтильГруппы = СтрЗаменить(СтильГруппы, "&DivWidth", Формат(ШиринаОбластиВПроцентах, "ЧРД=.; ЧГ="));
		МинимальнаяШиринаСтрокой = "";
		Если МинимальнаяШиринаОбласти > 0 Тогда
			МинимальнаяШиринаСтрокой = СтрШаблон("min-width: %1px;", Формат(МинимальнаяШиринаОбласти, "ЧГ="));
		КонецЕсли;
		СтильГруппы = СтрЗаменить(СтильГруппы, "&DivMinWidth", МинимальнаяШиринаСтрокой);
	КонецЕсли;
	
	Возврат СтильГруппы;
	
КонецФункции

Функция ПолучитьВложенныйБлок(Форма, СтрокиБлока, ГруппировкаБлока, Знач ИмяТекущейОбласти, Знач Уровень)
	
	ТипыГруппировок = ИнтерфейсРМКСлужебныйКлиентСервер.ТипыГруппировок();
	
	КлассГлавныхБлоков = "class=""generalBlock""";
	КлассДетальныхБлоков = "class=""detailedBlock""";
	КлассВыбранногоБлока = "class=""selectedBlock""";
	ВложенныйБлок = "<table style = ""width: 100%; height: 100%; border-collapse: collapse; margin: 0;"">";
	Если Уровень <= 2 Тогда
		ВложенныйБлок = СтрЗаменить(ВложенныйБлок, "border-collapse: collapse;", "");
	КонецЕсли;
	Если ГруппировкаБлока = ТипыГруппировок.Горизонтальная Тогда
		ВложенныйБлок = СтрШаблон("%1%2%3", ВложенныйБлок, Символы.ПС, "<tr style = ""height: 100%;"">");
	КонецЕсли;
	Для Каждого СтрокаБлока Из СтрокиБлока Цикл
		Если СтрокаБлока.ДоступностьГруппы Тогда
			Если ГруппировкаБлока = ТипыГруппировок.Вертикальная Тогда
				ТэгНачалаСтроки = "<tr style = ""height: &RowHeight%;"">";
				ТэгНачалаСтроки = СтрЗаменить(ТэгНачалаСтроки, "&RowHeight", Формат(СтрокаБлока.ВысотаВПроцентах, "ЧРД=.; ЧГ="));
				ВложенныйБлок = СтрШаблон("%1%2%3", ВложенныйБлок, Символы.ПС, ТэгНачалаСтроки);
			КонецЕсли;
			ЯчейкаБлока = "<td id=""&FiledName"" &TdClass style = ""width: &ColumnWidth%; &BackgroundColor"">&BlockContent</td>";
			ЯчейкаБлока = СтрЗаменить(ЯчейкаБлока, "&FiledName", СтрокаБлока.ИмяОбласти);
			ПредставлениеЦвета = ПолучитьПредставлениеЦвета(СтрокаБлока.ЦветОбласти);
			ЦветЯчейки = СтрШаблон("background-color: %1", ПредставлениеЦвета);
			ЯчейкаБлока = СтрЗаменить(ЯчейкаБлока, "&BackgroundColor", ЦветЯчейки);
			Если СтрокаБлока.ИмяОбласти = ИмяТекущейОбласти Тогда
				КлассБлоков = КлассВыбранногоБлока;
			Иначе
				КлассБлоков = ?(Уровень > 2, КлассДетальныхБлоков, КлассГлавныхБлоков);
			КонецЕсли;
			ЯчейкаБлока = СтрЗаменить(ЯчейкаБлока, "&TdClass", КлассБлоков);
			ЯчейкаБлока = СтрЗаменить(ЯчейкаБлока, "&ColumnWidth", Формат(СтрокаБлока.ШиринаВПроцентах, "ЧРД=.; ЧГ="));
			СодержимоеБлока = ПолучитьСодержимоеБлока(Форма, СтрокаБлока, ИмяТекущейОбласти, Уровень);
			ЯчейкаБлока = СтрЗаменить(ЯчейкаБлока, "&BlockContent", СодержимоеБлока);
			ВложенныйБлок = СтрШаблон("%1%2%3", ВложенныйБлок, Символы.ПС, ЯчейкаБлока);
			Если ГруппировкаБлока = ТипыГруппировок.Вертикальная Тогда
				ВложенныйБлок = СтрШаблон("%1%2%3", ВложенныйБлок, Символы.ПС, "</tr>");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ГруппировкаБлока = ТипыГруппировок.Горизонтальная Тогда
		ВложенныйБлок = СтрШаблон("%1%2%3", ВложенныйБлок, Символы.ПС, "</tr>");
	КонецЕсли;
	
	ВложенныйБлок = СтрШаблон("%1%2%3", ВложенныйБлок, Символы.ПС, "</table>");
	
	Возврат ВложенныйБлок;
	
КонецФункции

Функция ПолучитьСодержимоеБлока(Форма, СтрокаБлока, Знач ИмяТекущейОбласти, Знач Уровень)
	
	РезультатФункции = "";
	
	Если СтрокаБлока.ПолучитьЭлементы().Количество() = 0 Тогда
		ДополнительныеПараметры = Новый Структура("РеквизитыПалитры", Форма.РеквизитыПалитры);
		РезультатФункции = ПолучитьСодержимоеИменнойОбластиСхемыФормыРМК(Форма, СтрокаБлока, ДополнительныеПараметры);
	Иначе
		РезультатФункции = ПолучитьВложенныйБлок(Форма, СтрокаБлока.ПолучитьЭлементы(),
			СтрокаБлока.Группировка, ИмяТекущейОбласти, Уровень + 1);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьПредставлениеЦвета(ЦветОбласти)
	
	РезультатФункции = "";
	Если Не ЦветОбласти = Неопределено Тогда
		Если ЦветОбласти.Вид = ВидЦвета.WebЦвет Тогда
			ЦветСтрокой = Строка(ЦветОбласти);
			ПозицияНачалаСкобок = СтрНайти(ЦветСтрокой, "(");
			ПозицияКонцаСкобок = СтрНайти(ЦветСтрокой, ")");
			Если ПозицияНачалаСкобок > 0 И ПозицияКонцаСкобок - ПозицияНачалаСкобок > 1 Тогда
				РезультатФункции = Сред(ЦветСтрокой, ПозицияНачалаСкобок + 1);
				РезультатФункции = Лев(РезультатФункции, ПозицияКонцаСкобок - ПозицияНачалаСкобок - 1);
			КонецЕсли;
		ИначеЕсли ЦветОбласти.Вид = ВидЦвета.Абсолютный Тогда
			РезультатФункции = СтрШаблон("#%1%2%3", ИнтерфейсРМКСлужебныйКлиентСервер.DecToHex(ЦветОбласти.Красный),
				ИнтерфейсРМКСлужебныйКлиентСервер.DecToHex(ЦветОбласти.Зеленый),
				ИнтерфейсРМКСлужебныйКлиентСервер.DecToHex(ЦветОбласти.Синий));
		Иначе
			РезультатФункции = "#FFFFFF";
		КонецЕсли;
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

#КонецОбласти

Функция ПолучитьИндексЭлементаКэшаТоваров(МассивТоваров, СтрокаТовара)
	
	РезультатФункции = -1;
	
	КоличествоЭлементов = МассивТоваров.Количество();
	Счт = 0;
	Пока Счт < КоличествоЭлементов И РезультатФункции = -1 Цикл
		ЭлементКэша = МассивТоваров[Счт];
		Если ЭлементКэша.Номенклатура = СтрокаТовара.Номенклатура И ЭлементКэша.Характеристика = СтрокаТовара.Характеристика
				И ЭлементКэша.Количество = СтрокаТовара.Количество Тогда
				
			РезультатФункции = Счт;
				
		КонецЕсли;
		Счт = Счт + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьИменаЭлементовПлитки()
	
	РезультатФункции = Новый Структура();
	РезультатФункции.Вставить("ВидСтраницы", "КонтейнерПлитки_");
	РезультатФункции.Вставить("ВидЭлемент", "СтраницаСодержимогоЭлемента_");
	РезультатФункции.Вставить("ВидПапка", "СтраницаСодержимогоГруппы_");
	РезультатФункции.Вставить("ВидПустой", "СтраницаПлиткаПустоеМесто_");
	РезультатФункции.Вставить("Остаток", "ОстатокВПлитке_");
	РезультатФункции.Вставить("Текст1", "НаименованиеГруппыПлитки_");
	РезультатФункции.Вставить("Текст2", "НаименованиеЭлементаПлитки_");
	РезультатФункции.Вставить("КарточкаЭлемента", "ПлиткаКарточкаЭлемента_");
	РезультатФункции.Вставить("КарточкаГруппы", "ПлиткаКарточкаГруппы_");
	РезультатФункции.Вставить("СтатусГруппы", "КартинкаСтатусаГруппы_");
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура УстановитьЦветаИзбранного(Элементы, НомерКарточки, ИзбраннаяПозиция, ОтображатьОстаток, СкрыватьЦену)
	
	ИменаЭлементов = ПолучитьИменаЭлементовИзбранного();
	Элементы[ИменаЭлементов.ТекстЭлемент + НомерКарточки].ЦветТекста = ИзбраннаяПозиция.ЦветШрифта;
	Элементы[ИменаЭлементов.ТекстГруппа + НомерКарточки].ЦветТекста = ИзбраннаяПозиция.ЦветШрифта;
	Если ОтображатьОстаток Тогда
		Элементы[ИменаЭлементов.ТекстОстаток + НомерКарточки].ЦветТекста = ИзбраннаяПозиция.ЦветШрифта;
	КонецЕсли;
	Если Не СкрыватьЦену Тогда
		Элементы[ИменаЭлементов.ТекстЦена + НомерКарточки].ЦветТекста = ИзбраннаяПозиция.ЦветШрифта;
	КонецЕсли;
	Элементы[ИменаЭлементов.КарточкаИзбранного + НомерКарточки].ЦветФона = ИзбраннаяПозиция.ЦветФона;
	
КонецПроцедуры

Процедура УстановитьЦветаПлитки(Элементы, ИменаЭлементов, ИндексПП, ИзбраннаяПозиция, ОтображатьОстаток)
	
	Элементы[ИменаЭлементов.Текст1 + ИндексПП].ЦветТекста = ИзбраннаяПозиция.ЦветШрифта;
	Элементы[ИменаЭлементов.Текст2 + ИндексПП].ЦветТекста = ИзбраннаяПозиция.ЦветШрифта;
	Если ОтображатьОстаток Тогда
		Элементы[ИменаЭлементов.Остаток + ИндексПП].ЦветТекста = ИзбраннаяПозиция.ЦветШрифта;
	КонецЕсли;
	
	ИмяКарточки = ?(ИзбраннаяПозиция.ЭтоКатегория И Не ИзбраннаяПозиция.ЭтоТекущаяКатегория,
		ИменаЭлементов.КарточкаГруппы, ИменаЭлементов.КарточкаЭлемента);
	Элементы[ИмяКарточки + ИндексПП].ЦветФона = ИзбраннаяПозиция.ЦветФона;
	
КонецПроцедуры

Функция ПолучитьКартинкуСтатусаГруппыИзбранного(Интерфейс8_5, ИзбраннаяПозиция)
	
	РезультатФункции = Неопределено;
	
	Если Интерфейс8_5 Тогда
		РезультатФункции = ?(ИзбраннаяПозиция.ЭтоТекущаяКатегория,
			БиблиотекаКартинок.РМКНаУровеньВверх, БиблиотекаКартинок.РМКНаУровеньВниз);
	Иначе
		РезультатФункции = ?(ИзбраннаяПозиция.ЭтоТекущаяКатегория,
			БиблиотекаКартинок.УровеньВверх, БиблиотекаКартинок.УровеньВниз);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьДлинуЗначащихСимволов(ИсходныйТекст, ПозицияВТексте, СимволИсключения)
	
	РезультатФункции = 0;
	ИндексСимвола = 1;
	Пока ИндексСимвола < ПозицияВТексте Цикл
		ТекущийСимвол = Сред(ИсходныйТекст, ИндексСимвола, 1);
		Если Не ТекущийСимвол = СимволИсключения Тогда
			РезультатФункции = РезультатФункции + 1;
		КонецЕсли;
		ИндексСимвола = ИндексСимвола + 1;
	КонецЦикла;
	Возврат РезультатФункции;
	
КонецФункции

Функция АктивироватьЭлементВводаПриВозможности(Форма, РедактируемыйЭлемент)
	
	РезультатФункции = Ложь;
	Если Не РедактируемыйЭлемент = Неопределено Тогда
		Форма.ТекущийЭлемент = РедактируемыйЭлемент;
		РезультатФункции = Истина;
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьНастройкиЧасовРМК(Форма)
	
	РезультатФункции = Новый Структура("Использование", Ложь);

	УменьшенныйМасштаб = ПредопределенноеЗначение("Перечисление.ВидыОтображения.Уменьшенный");
	СтандартныйМасштаб = ПредопределенноеЗначение("Перечисление.ВидыОтображения.Стандартный");
	УвеличенныйМасштаб = ПредопределенноеЗначение("Перечисление.ВидыОтображения.Увеличенный");
	
	ВыравниваниеАвто = НСтр("ru = 'Авто'");
	ПоложениеНет = НСтр("ru = 'Нет'");
	СвойствоПоложениеЧасов = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ПоложениеЧасов");
	СвойствоВысотаКнопок = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ВысотаКнопок");
	СвойствоЦветФона = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ЦветКнопок");
	СвойствоЦветТекста = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ЦветШрифта");
	СвойствоШрифт = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ШрифтКнопок");
	СвойствоВыравнивание = ПредопределенноеЗначение("Перечисление.СвойстваЭлементовРМК.ВыравниваниеЭлементов");
	ЗаголовкиОбластей = ИнтерфейсРМКСлужебныйКлиентСервер.ПолучитьЗаголовкиОбластейДляНастроек();
	НастройкиЭлементов = Форма.СвойстваНастроекЭлементов;
	ГруппаОтбора = ?(Форма.РежимПлитки, ЗаголовкиОбластей.ПлиточныйИнтерфейс, ЗаголовкиОбластей.ОбластьПанельОпераций);
	НаборСвойств = НастройкиЭлементов.Получить(ГруппаОтбора);
	ЗначениеВыравнивания = Неопределено;
	Если Не НаборСвойств = Неопределено Тогда
		ПоложениеЧасов = НаборСвойств.Получить(СвойствоПоложениеЧасов);
		ЗначениеВыравнивания = НаборСвойств.Получить(СвойствоВыравнивание);
		Если Не ПоложениеЧасов = ПоложениеНет Тогда
			РезультатФункции.Использование = Истина;
			
			ЗначениеШрифта = НаборСвойств.Получить(СвойствоШрифт);
			
			ПараметрыЦветаФона = СформироватьПараметрыЦветаИзНастроек(НаборСвойств, СвойствоЦветФона);
			ПараметрыЦветаТекста = СформироватьПараметрыЦветаИзНастроек(НаборСвойств, СвойствоЦветТекста);;
			ВысотаПоля = 1;
			ШиринаПоля = 10;
			ШрифтЖирный = Ложь;
			ШрифтНаклонный = Ложь;
			Если Не (ЗначениеШрифта = Неопределено Или ЗначениеШрифта.Вид = ВидШрифта.АвтоШрифт) Тогда
				ШрифтАбсолютный = ?(ЗначениеШрифта.Вид = ВидШрифта.Абсолютный, ЗначениеШрифта, ЗначениеШрифта.ПолучитьАбсолютный());
				ШрифтЖирный = ШрифтАбсолютный.Полужирный;
				ШрифтНаклонный = ШрифтАбсолютный.Наклонный;
			КонецЕсли;
			
			ЗначениеВысоты = НаборСвойств.Получить(СвойствоВысотаКнопок);
			Если ЗначениеЗаполнено(ЗначениеВысоты) Тогда
				ВысотаПоля = Мин(ЗначениеВысоты, 2);
			ИначеЕсли Форма.РежимПлитки И Форма.ВидОтображения = УменьшенныйМасштаб Тогда
				ВысотаПоля = 2;
			Иначе
				ВысотаПоля = 1;
			КонецЕсли;
			
			Если ВысотаПоля = 1 И Форма.ВидОтображения = УменьшенныйМасштаб Тогда
				ШиринаПоля = 8;
			ИначеЕсли ВысотаПоля = 1 И Форма.ВидОтображения = СтандартныйМасштаб Тогда
				ШиринаПоля = 9;
			ИначеЕсли ВысотаПоля = 2 И Форма.ВидОтображения = УвеличенныйМасштаб Тогда
				ШиринаПоля = 11;
			КонецЕсли;
			
			РазмерШрифта = 12 + (ШиринаПоля - 7) * 2;
			
			РезультатФункции.Вставить("ЦветФона", ПараметрыЦветаФона);
			РезультатФункции.Вставить("ЦветТекста", ПараметрыЦветаТекста);
			РезультатФункции.Вставить("Высота", ВысотаПоля);
			РезультатФункции.Вставить("Ширина", ШиринаПоля);
			РезультатФункции.Вставить("РазмерШрифта", РазмерШрифта);
			РезультатФункции.Вставить("ШрифтЖирный", ШрифтЖирный);
			РезультатФункции.Вставить("ШрифтНаклонный", ШрифтНаклонный);
			РезультатФункции.Вставить("ПоложениеЧасов", ПоложениеЧасов);
			
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеВыравнивания = Неопределено Тогда
		ЗначениеВыравнивания = ВыравниваниеАвто;
	КонецЕсли;
	РезультатФункции.Вставить("ВыравниваниеПанели", ЗначениеВыравнивания);
	
	Возврат РезультатФункции;
	
КонецФункции

Функция СформироватьПараметрыЦветаИзНастроек(НаборСвойств, СвойствоЦвет)
	
	РезультатФункции = Новый Структура();
	РезультатФункции.Вставить("Зеленый", Неопределено);
	РезультатФункции.Вставить("Красный", Неопределено);
	РезультатФункции.Вставить("Синий", Неопределено);
	
	ЗначениеЦвета = НаборСвойств.Получить(СвойствоЦвет);
	Если Не (ЗначениеЦвета = Неопределено Или ЗначениеЦвета.Вид = ВидЦвета.АвтоЦвет) Тогда
		ЗначенияОттенков = ?(ЗначениеЦвета.Вид = ВидЦвета.Абсолютный, ЗначениеЦвета, ЗначениеЦвета.ПолучитьАбсолютный());
		
		РезультатФункции.Зеленый = ЗначенияОттенков.Зеленый;
		РезультатФункции.Красный = ЗначенияОттенков.Красный;
		РезультатФункции.Синий = ЗначенияОттенков.Синий;
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция СформироватьПредставлениеЦвета(ПараметрыЦвета)
	
	Возврат СтрШаблон("#%1%2%3", ИнтерфейсРМКСлужебныйКлиентСервер.DecToHex(ПараметрыЦвета.Красный),
		ИнтерфейсРМКСлужебныйКлиентСервер.DecToHex(ПараметрыЦвета.Зеленый),
		ИнтерфейсРМКСлужебныйКлиентСервер.DecToHex(ПараметрыЦвета.Синий));
	
КонецФункции

