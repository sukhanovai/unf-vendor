Функция НайтиФормуПоИмениИВладельцу(ИмяПроверяемойФормы, ВладелецФормы) Экспорт
	
	РезультатФункции = Неопределено;
	ОткрытыеОкна = ПолучитьОкна();
	Счт = 0;
	Пока Счт < ОткрытыеОкна.Количество() И РезультатФункции = Неопределено Цикл
		ТекущееОкно = ОткрытыеОкна.Получить(Счт);
		Если ТекущееОкно.Содержимое.Количество() > 0 Тогда
			ФормаОкна = ТекущееОкно.Содержимое[0];
			Если ТипЗнч(ФормаОкна) = Тип("ФормаКлиентскогоПриложения") И ФормаОкна.ИмяФормы = ИмяПроверяемойФормы
					И ФормаОкна.ВладелецФормы = ВладелецФормы Тогда
				РезультатФункции = ФормаОкна;
			КонецЕсли;
		КонецЕсли;
		Счт = Счт + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

