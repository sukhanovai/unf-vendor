	РезультатФункции = СтрЗаменить(РезультатФункции, "&TableHeight&", ВысотаТаблицы);
	РезультатФункции = СтрЗаменить(РезультатФункции, "&Color&", СтрокаЦветТекста);
	РезультатФункции = СтрЗаменить(РезультатФункции, "&Bold&", СтрокаЖирногоШрифта);
	РезультатФункции = СтрЗаменить(РезультатФункции, "&Italic&", СтрокаНаклонногоШрифта);
	РезультатФункции = СтрЗаменить(РезультатФункции, "&FontSize&", Строка(НастройкиЧасов.РазмерШрифта));
	
