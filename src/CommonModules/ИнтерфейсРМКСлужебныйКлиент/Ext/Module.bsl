Процедура ЗапуститьЧасы(Форма, НастройкиЧасов)
	
	Элементы = Форма.Элементы;
	ПоложениеЦентр = НСтр("ru = 'Центр'");
	ВыравниваниеАвто = НСтр("ru = 'Авто'");
	ВидимостьДекорации = Ложь;
	ВидимостьОтступа = Ложь;
	НуженРазделительКоманд = Ложь;
	
	Если Не Элементы.ПолеЧасов.Видимость = НастройкиЧасов.Использование Тогда
		Элементы.ПолеЧасов.Видимость = НастройкиЧасов.Использование;
		Элементы.КартинкаЧасы.Видимость = НастройкиЧасов.Использование;
	КонецЕсли;
	
	Если НастройкиЧасов.Использование Тогда
		
		Если Не Элементы.ПолеЧасов.Высота = НастройкиЧасов.Высота Тогда
			Элементы.ПолеЧасов.Высота = НастройкиЧасов.Высота;
		КонецЕсли;
		Если Не Элементы.ПолеЧасов.Ширина = НастройкиЧасов.Ширина Тогда
			Элементы.ПолеЧасов.Ширина = НастройкиЧасов.Ширина;
		КонецЕсли;
		Если Форма.РежимКассыСамообслуживания
				И ОбщегоНазначенияРМККлиентСервер.ЕстьСвойство(Элементы, "ПолеЧасовВПлиткеКСО") Тогда
			
			Если Не Элементы.ПолеЧасовВПлиткеКСО.Высота = НастройкиЧасов.Высота Тогда
				Элементы.ПолеЧасовВПлиткеКСО.Высота = НастройкиЧасов.Высота;
			КонецЕсли;
			Если Не Элементы.ПолеЧасовВПлиткеКСО.Ширина = НастройкиЧасов.Ширина Тогда
				Элементы.ПолеЧасовВПлиткеКСО.Ширина = НастройкиЧасов.Ширина;
			КонецЕсли;
			
		КонецЕсли;
		ВидимостьДекорации = (НастройкиЧасов.ПоложениеЧасов = ПоложениеЦентр
			И НастройкиЧасов.ВыравниваниеПанели = ВыравниваниеАвто);
		ВидимостьОтступа = (НастройкиЧасов.ПоложениеЧасов = ПоложениеЦентр
			И Не НастройкиЧасов.ВыравниваниеПанели = ВыравниваниеАвто);
		НуженРазделительКоманд = Не (НастройкиЧасов.ПоложениеЧасов = ПоложениеЦентр
			Или НастройкиЧасов.ВыравниваниеПанели = ВыравниваниеАвто);
		
		Форма.КодЧасов = ПолучитьКодРеализацииЧасов(НастройкиЧасов);
		
	ИначеЕсли Не НастройкиЧасов.ВыравниваниеПанели = ВыравниваниеАвто Тогда
		НуженРазделительКоманд = Истина;
		Форма.КодЧасов = "";
	КонецЕсли;
	
	Если Не Форма.РежимКассыСамообслуживания Тогда
		ИспользуетсяОтборВесовогоТовара = (Форма.РежимПлитки И Форма.ЕстьВесовойТоварВПлитке);
		Если Не Элементы.ДекорацияРастяжениеПослеЧасов.Видимость = ВидимостьДекорации Тогда
			Элементы.ДекорацияРастяжениеПослеЧасов.Видимость = ВидимостьДекорации;
		КонецЕсли;
		Если Не Элементы.ДекорацияОперацияОтступСправа.Видимость = ВидимостьОтступа Тогда
			Элементы.ДекорацияОперацияОтступСправа.Видимость = ВидимостьОтступа;
		КонецЕсли;
		Если Не Элементы.Декорация1.Видимость = ИспользуетсяОтборВесовогоТовара Тогда
			Элементы.Декорация1.Видимость = ИспользуетсяОтборВесовогоТовара;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВычестьИзДлиныПостфикс(ДлинаТекста, РедактируемыйЭлемент)
	
	СтрокаФорматаРедактирования = РедактируемыйЭлемент.ФорматРедактирования;
	
	Если Не СокрЛП(СтрокаФорматаРедактирования) = "" Тогда
		Постфикс = ПолучитьПостфиксИзСтрокиФормата(СтрокаФорматаРедактирования);
		ДлинаТекста = ДлинаТекста - СтрДлина(Постфикс);
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьМаскуСимволовПередПостфиксом()
	
	РезультатФункции = Новый Массив;
	
	РезультатФункции.Добавить(СтрШаблон(НСтр("ru = 'NF%1ЧФ'"), Символы.ПС));
	РезультатФункции.Добавить("=");
	РезультатФункции.Добавить("'");
	РезультатФункции.Добавить(СтрШаблон(НСтр("ru = 'N%1Ч'"), Символы.ПС));
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьСтрокиПроверки(НаборСтрок, ПозицияПроверки)
	
	СтрокиДляПроверки = Новый Массив;
	Если НаборСтрок.Количество() > ПозицияПроверки Тогда
		СтрокиВхождения = НаборСтрок[ПозицияПроверки];
		СтрокиДляПроверки = СтрРазделить(СтрокиВхождения, Символы.ПС, Ложь);
	КонецЕсли;
	Возврат СтрокиДляПроверки;
	
КонецФункции

Функция ПроверитьВхождениеСтрок(СтрокаФорматаРедактирования, НомерСимвола, СтрокиПроверки)
	
	РезультатФункции = Новый Структура("ЕстьВхождение,ДлинаВхождения", Ложь, 0);
	
	КоличествоСтрок = СтрокиПроверки.Количество();
	ИндексСтроки = 0;
	Пока ИндексСтроки < КоличествоСтрок И Не РезультатФункции.ЕстьВхождение Цикл
		ПодстрокаПроверки = СтрокиПроверки[ИндексСтроки];
		ДлинаПодстроки = СтрДлина(ПодстрокаПроверки);
		Если Сред(СтрокаФорматаРедактирования, НомерСимвола, ДлинаПодстроки) = ПодстрокаПроверки Тогда
			РезультатФункции.ЕстьВхождение = Истина;
			РезультатФункции.ДлинаВхождения = ДлинаПодстроки;
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьПостфиксИзСтрокиФормата(СтрокаФорматаРедактирования)
	
	Постфикс = "";
	ПозицияПроверки = 0;
	ЭтоФормированиеПостфикса = Ложь;
	СимволЗавершения = "'";
	МаскаПередПостфиксом = СформироватьМаскуСимволовПередПостфиксом();
	
	КоличествоСимволов = СтрДлина(СтрокаФорматаРедактирования);
	НомерСимвола = 0;
	Пока НомерСимвола < КоличествоСимволов Цикл
		НомерСимвола = НомерСимвола + 1;
		ТекущийСимвол = Сред(СтрокаФорматаРедактирования, НомерСимвола, 1);
		Если ЭтоФормированиеПостфикса Тогда
			
			Если ТекущийСимвол = СимволЗавершения Тогда
				ЭтоФормированиеПостфикса = Ложь;
				НомерСимвола = КоличествоСимволов;
			ИначеЕсли Не ТекущийСимвол = """" Тогда
				Постфикс = Постфикс + ТекущийСимвол;
			КонецЕсли;
			
		ИначеЕсли Не ТекущийСимвол = " " Тогда
			
			СтрокиПроверки = ПолучитьСтрокиПроверки(МаскаПередПостфиксом, ПозицияПроверки);
			РезультатПроверкиВхождения = ПроверитьВхождениеСтрок(СтрокаФорматаРедактирования, НомерСимвола, СтрокиПроверки);
			Если РезультатПроверкиВхождения.ЕстьВхождение Тогда
				Если РезультатПроверкиВхождения.ДлинаВхождения > 1 Тогда
					НомерСимвола = НомерСимвола + РезультатПроверкиВхождения.ДлинаВхождения - 1;
				КонецЕсли;
				ПозицияПроверки = ПозицияПроверки + 1;
				Если ПозицияПроверки = МаскаПередПостфиксом.Количество() Тогда
					ЭтоФормированиеПостфикса = Истина;
				КонецЕсли;
			ИначеЕсли ПозицияПроверки > 0 Тогда
				ПозицияПроверки = 0;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Постфикс;
	
КонецФункции

Процедура ЗаполнитьПолныйПутьПлитки(Форма, ДанныеПлитокДляЗаполнения)
	
	ПолныйПуть = "";
	
	Если ДанныеПлитокДляЗаполнения.Количество() > 0 Тогда
		ЭлементаПлитки = ДанныеПлитокДляЗаполнения[0];
		ИзбраннаяПозиция = Форма.ДанныеДляПлитки[ЭлементаПлитки.ПорядковыйНомер];
		
		Если ИзбраннаяПозиция.НомерКатегорииРазмещенияЭлемента = 0 Тогда
			Если Форма.ИмяФормы = "Обработка.РабочееМестоКассира.Форма.ФормаРМК" Тогда
				
				ПолныйПуть = ПолучитьНаименованиеКорняПлиточногоИнтерфейсаРМК(Форма);
				
			ИначеЕсли Форма.ИмяФормы = "Обработка.РабочееМестоКассира.Форма.ФормаОбученияУстройствРаспознавания" Тогда
				ПолныйПуть = НСтр("ru='Распознанный товар'");
			Иначе
				ПолныйПуть = Форма.НаименованиеПалитры;
			КонецЕсли;
		Иначе
			ПолныйПуть = ПолучитьНаименованиеПутиПоЭлементуПлитки(Форма, ИзбраннаяПозиция);
		КонецЕсли;
	КонецЕсли;
	
	Форма.Элементы.ДекорацияПутьПлиточногоИнтерфейса.Заголовок = ПолныйПуть;
	
КонецПроцедуры

Функция ПолучитьНаименованиеПутиПоЭлементуПлитки(Форма, ИзбраннаяПозиция)
	
	РезультатФункции = "";
	
	МассивКатегорий = Новый Массив;
	ОчереднаяПлитка = ИзбраннаяПозиция;
	Счт = 0;
	Пока Счт < 3 И ОчереднаяПлитка.НомерКатегорииРазмещенияЭлемента > 0 Цикл
		ПлиткаРодитель = ПолучитьПлиткуКатегории(Форма, ОчереднаяПлитка.НомерКатегорииРазмещенияЭлемента);
		Если Не ПлиткаРодитель = Неопределено Тогда
			ПлиткаИзОпорныхДанных = Форма.ОпорныеДанные[ПлиткаРодитель.ИндексИзОпорныхДанных];
			МассивКатегорий.Вставить(0, ПлиткаИзОпорныхДанных.ИмяЭлемента);
			ОчереднаяПлитка = ПлиткаРодитель;
		Иначе
			Счт = 4;
		КонецЕсли;
		
		Счт = Счт + 1;
		Если Счт = 3 И ОчереднаяПлитка.НомерКатегорииРазмещенияЭлемента > 0 Тогда
			МассивКатегорий.Вставить(0, НСтр("ru='...'"));
		КонецЕсли;
	КонецЦикла;
	НуженРазделитель = Ложь;
	Для Каждого ЭлементМассива Из МассивКатегорий Цикл
		СимволРазделитель = ?(НуженРазделитель, "\", "");
		РезультатФункции = СтрШаблон("%1%2%3", РезультатФункции, СимволРазделитель, ЭлементМассива);
		НуженРазделитель = Истина; 
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьПлиткуКатегории(Форма, НомерКатегории)
	
	РезультатФункции = Неопределено;
	
	ОтборКатегорий = Новый Структура("НомерКатегории", НомерКатегории);
	СтрокиКатегории = ОбщегоНазначенияРМККлиентСервер.НайтиСтрокиМассиваСтруктур(Форма.ДанныеДляПлитки, ОтборКатегорий);
	Если СтрокиКатегории.Количество() > 0 Тогда
		РезультатФункции = СтрокиКатегории[0];
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьНаименованиеКорняПлиточногоИнтерфейсаРМК(Форма)
	
	РезультатФункции = "";
	Если Форма.ТипПостроенияПлитки = Форма.ТипыПостроенияПлитки.РаспознанныйВесовойТовар Тогда
		РезультатФункции = НСтр("ru='Распознанный товар'");
	ИначеЕсли Форма.ТипПостроенияПлитки = Форма.ТипыПостроенияПлитки.ВесовойТовар Тогда
		РезультатФункции = НСтр("ru='Весовой товар'");
	Иначе
		РезультатФункции = Форма.НаименованиеПалитры;
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

Функция ЭтоПодтверждениеЧерезMAX(СтрокаВидаКонтроля, ИспользоватьПодтверждениеВозрастаЧерезMAX)
	
	Если НЕ ИспользоватьПодтверждениеВозрастаЧерезMAX Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПодтверждениеЧерезMAX = Ложь;
	ПараметрПодтверждениеЧерезMAX = ПредопределенноеЗначение(
		"Перечисление.ПараметрыКонтроляПродаж.ПодтверждениеЧерезMAX");
	
	Для каждого ПараметрКонтроля Из СтрокаВидаКонтроля.ПараметрыКонтроля Цикл
		Если ПараметрКонтроля.Параметр = ПараметрПодтверждениеЧерезMAX Тогда
			ПодтверждениеЧерезMAX = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПодтверждениеЧерезMAX;
	
КонецФункции

Процедура ОпределитьПозициюДобавленияОграниченияТипаПроверкаПокупателя(СтрокаОграничения,
	ЭтоПроверкаВозраста, ЗначениеВозраста, ПодтверждениеЧерезMAX,
	ПозицияДобавления, КоличествоОграничений, ИндексОграничения)
	
	// Пример сортировки:
	//  0)без параметра возраст(возраст = 0)
	//  1)проверка возраста сотрудником(возраст = 20)
	//  2)проверка возраста через MAX или сотрудника(возраст = 18)
	//  3)проверка возраста сотрудником(возраст = 18)
	//  4)проверка возраста сотрудником(возраст = 17)
	
	Если СтрокаОграничения.ВозрастКонтроля = 0 Тогда
		// Без параметра возраст(возраст = 0)
		ИндексОграничения = ИндексОграничения + 1;
		ПозицияДобавления = ИндексОграничения;
	ИначеЕсли СтрокаОграничения.ВозрастКонтроля > ЗначениеВозраста Тогда
		Если Не ЭтоПроверкаВозраста Тогда
			ИндексОграничения = КоличествоОграничений;
		Иначе
			ИндексОграничения = ИндексОграничения + 1;
			ПозицияДобавления = ИндексОграничения;
		КонецЕсли;
	ИначеЕсли СтрокаОграничения.ВозрастКонтроля < ЗначениеВозраста Тогда
		ИндексОграничения = КоличествоОграничений;
	Иначе
		// Ветка условия для СтрокаОграничения.ВозрастКонтроля = ЗначениеВозраста
		Если ПодтверждениеЧерезMAX И Не СтрокаОграничения.ПодтверждениеЧерезMAX Тогда
			ИндексОграничения = КоличествоОграничений;
		Иначе
			ИндексОграничения = ИндексОграничения + 1;
			ПозицияДобавления = ИндексОграничения;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ФормаОшибки
Процедура ОткрытьФормуСообщенияОбОшибке(ВладелецФормы, ПараметрыОткрытияОшибки, ОбработчикОповещения = Неопределено) Экспорт
	
	Если ПараметрыОткрытияОшибки.Свойство("НеБлокироватьОкно") И ПараметрыОткрытияОшибки.НеБлокироватьОкно Тогда
		РежимБлокировкиОкна = РежимБлокировкиПриОткрытииОкнаФормы.НеБлокировать;
	Иначе
		РежимБлокировкиОкна = РежимБлокировкиПриОткрытииОкнаФормы.БлокироватьВладельца;
	КонецЕсли;
	
	ОткрытьФорму("Обработка.РабочееМестоКассира.Форма.ФормаСообщенияОбОшибке", ПараметрыОткрытияОшибки, ВладелецФормы,,,,
		ОбработчикОповещения, РежимБлокировкиОкна);
	
КонецПроцедуры
	
Функция ПолучитьПараметрыОшибки(СообщениеОбОшибки, ТекстЗаголовка = "") Экспорт
	ПараметрыОшибки = Новый Структура;
	ПараметрыОшибки.Вставить("ТекстЗаголовка", ТекстЗаголовка);
	ПараметрыОшибки.Вставить("ТекстОшибки", СообщениеОбОшибки);
	ПараметрыОшибки.Вставить("ЭтоПредупреждение", Ложь);
	ПараметрыОшибки.Вставить("НеБлокироватьОкно", Ложь);
	Возврат ПараметрыОшибки;
КонецФункции

#КонецОбласти
