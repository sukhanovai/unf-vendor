Функция СодержимоеОбластиПлитки(РеквизитыПалитры)
	
	СтрокаЯчейки = "
	|	<td class = ""plateTd""></td>%1";
	
	СтрокаРяда = "<tr class = ""plateTr"">%1
	|</tr>";
	Для НомерКолонки = 1 По РеквизитыПалитры.КоличествоЭлементовВРяду Цикл
		СтрокаРяда = СтрШаблон(СтрокаРяда, СтрокаЯчейки);
	КонецЦикла;
	СтрокаРяда = СтрШаблон(СтрокаРяда, "");
	СлужебнаяСтрокаРяда = СтрШаблон("%1%2%3", СтрокаРяда, Символы.ПС, "%1");
	СтрокаПлитки = "<table class = ""plateTable"">%1</table>";
	
	Для НомерРяда = 1 По РеквизитыПалитры.КоличествоРядовНаСтранице Цикл
		СтрокаПлитки = СтрШаблон(СтрокаПлитки, СлужебнаяСтрокаРяда);
	КонецЦикла;
	
	Возврат СтрШаблон(СтрокаПлитки, "");
	
КонецФункции

