Процедура НастроитьПерсонализированнуюПанельОпераций(Форма) Экспорт
	
	Если Форма.РежимКассыСамообслуживания Или Не Форма.ОсновнойПодборПлиточный Тогда
		НастройкиЧасов = ПолучитьНастройкиЧасовРМК(Форма);
		ЗапуститьЧасы(Форма, НастройкиЧасов);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСодержимоеИменнойОбластиСхемыФормыРМК(Форма, ДанныеБлока, ДополнительныеПараметры) Экспорт
	
	РезультатФункции = "";
	ИмяОбластиРабочаяОбласть = "Страницы_";
	ИмяОбластиСпискаТоваров = "ПанельТаблицыТоваров_";
	ИмяОбластиГлавнойКоманды = "ОсновнаяКоманднаяПанельУправленияЧеком_";
	ИмяОбластиПлиткиГоризонтально = "ГруппаПанельИнформацииГор_Горизонтальная";
	ИмяОбластиПлиткиВертикально = "ГруппаПанельИнформацииВер_Вертикальная";
	
	Если СтрНайти(ДанныеБлока.ИмяОбласти, ИмяОбластиСпискаТоваров) = 1 Тогда
		РезультатФункции = СодержимоеОбластиСпискаТоваров(ДанныеБлока);
	ИначеЕсли СтрНайти(ДанныеБлока.ИмяОбласти, ИмяОбластиГлавнойКоманды) = 1 Тогда
		РезультатФункции = СодержимоеОбластиГлавнойКоманды(ДанныеБлока);
	ИначеЕсли СтрНайти(ДанныеБлока.ИмяОбласти, ИмяОбластиРабочаяОбласть) = 1 Тогда
		РезультатФункции = СодержимоеОбластиДомашнейСтраницы(Форма.ЗаставкаСтрокой);
	ИначеЕсли ДанныеБлока.ИмяОбласти = ИмяОбластиПлиткиГоризонтально
			Или ДанныеБлока.ИмяОбласти = ИмяОбластиПлиткиВертикально Тогда
		РезультатФункции = СодержимоеОбластиПлитки(ДополнительныеПараметры.РеквизитыПалитры);
	Иначе
		РезультатФункции = СодержимоеТиповойОбласти(ДанныеБлока);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ЭтоУвеличенныйВариантМасштаба(Форма, СценарийИспользования)
	
	РезультатФункции = Ложь;
	СценарийСамообслуживания = ПредопределенноеЗначение("Перечисление.СценарииИспользованияРМК.ТерминалСамообслуживания");
	Если СценарийИспользования = СценарийСамообслуживания Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "УвеличенныйВариантМасштаба") Тогда
			РезультатФункции = Форма.УвеличенныйВариантМасштаба;
		Иначе
			РезультатФункции = Форма.НастройкиРМК.УвеличенныйВариантМасштаба;
		КонецЕсли;
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

Функция ПолучитьЗначениеНастройкиФормы(Форма, ИмяНастройки)
	
	РезультатФункции = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяНастройки) Тогда
		РезультатФункции = Форма[ИмяНастройки];
	Иначе
		РезультатФункции = Форма.НастройкиРМК[ИмяНастройки];
	КонецЕсли;
	Возврат РезультатФункции;
	
КонецФункции

Функция СформироватьДокументСхемыФормыРМК(Форма) Экспорт
	
	Интерфейс85 = ОбщегоНазначенияРМККлиентСервер.ЭтоИнтерфейс85();
	
	Элементы = Форма.Элементы;
	СценарийИспользования = ПолучитьЗначениеНастройкиФормы(Форма, "СценарийИспользования");
	ВидОтображения = ПолучитьЗначениеНастройкиФормы(Форма, "ВидОтображения");
	УвеличенныйВариантМасштаба = ЭтоУвеличенныйВариантМасштаба(Форма, СценарийИспользования);
	
	ИмяТекущейОбласти = "";
	ЭлементДеревоОбластей = Элементы.Найти("ДеревоОбластейФормыРМК");
	Если Не ЭлементДеревоОбластей = Неопределено Тогда
		ТекущиеДанныеОбласти = ЭлементДеревоОбластей.ТекущиеДанные;
		Если Не ТекущиеДанныеОбласти = Неопределено Тогда
			ИмяТекущейОбласти = ТекущиеДанныеОбласти.ИмяОбласти;
		КонецЕсли;
	КонецЕсли;
	ТипыГруппировок = ИнтерфейсРМКСлужебныйКлиентСервер.ТипыГруппировок();
	
	КоэффициентМасштаба = 0;
	Если УвеличенныйВариантМасштаба И Интерфейс85 Тогда
		КоэффициентМасштаба = 1;
	ИначеЕсли ВидОтображения = ПредопределенноеЗначение("Перечисление.ВидыОтображения.Увеличенный") И Не Интерфейс85 Тогда
		КоэффициентМасштаба = 1;
	ИначеЕсли ВидОтображения = ПредопределенноеЗначение("Перечисление.ВидыОтображения.Уменьшенный") И Не Интерфейс85 Тогда
		КоэффициентМасштаба = -1;
	КонецЕсли;
	РазмерТекстаОбластей = 20;
	СмещениеРазмераТекста = 4;
	РазмерТекстаОбластей = РазмерТекстаОбластей + КоэффициентМасштаба * СмещениеРазмераТекста;
	
	РазмерТекстаСпискаТоваров = 38;
	СмещениеРазмераТекстаСпискаТоваров = 6;
	РазмерТекстаСпискаТоваров = РазмерТекстаСпискаТоваров + КоэффициентМасштаба * СмещениеРазмераТекстаСпискаТоваров;
	
	ШиринаЯчейкиВПроцентах = Цел(100 / Форма.РеквизитыПалитры.КоличествоЭлементовВРяду);
	ВысотаЯчейкиВПроцентах = Цел(100 / Форма.РеквизитыПалитры.КоличествоРядовНаСтранице);
	БлокСтилей = 
	".generalBlock {
	|	border: 1px solid black;
	|	padding: 0px;
	|		}
	|.detailedBlock {
	|	border: 1px dotted black;
	|	padding: 0px;
	|		}
	|.selectedBlock {
	|	border: 2px solid red;
	|		}
	|.ordinaryLabel {
	|			text-align: center;
	|			vertical-align: middle;
	|			align: center;
	|			font-size: &LabelSizepx;
	|	}
	|.plateTd {
	|			width: &CellWidth%;
	|			border: 0px;
	|			background-color: #C0C0C0;
	|		}
	|.plateTr {
	|			height: &CellHeight%;
	|		}
	|.plateTable {
	|			width: 100%;
	|			height: 100%;
	|		}
	|#goodsList {
	|			text-align: center;
	|			vertical-align: middle;
	|			align: center;
	|			font-size: &GoodsFontSizepx;
	|	}";
	БлокСтилей = СтрЗаменить(БлокСтилей, "&GoodsFontSize", Формат(РазмерТекстаСпискаТоваров, "ЧГ="));
	БлокСтилей = СтрЗаменить(БлокСтилей, "&LabelSize", Формат(РазмерТекстаОбластей, "ЧГ="));
	БлокСтилей = СтрЗаменить(БлокСтилей, "&CellWidth", ШиринаЯчейкиВПроцентах);
	БлокСтилей = СтрЗаменить(БлокСтилей, "&CellHeight", ВысотаЯчейкиВПроцентах);
	
	БлокПанелей = ПолучитьВложенныйБлок(Форма, Форма.ДеревоОбластейФормыРМК.ПолучитьЭлементы(),
		ТипыГруппировок.Вертикальная, ИмяТекущейОбласти, 1);
	
	СтильГлавнойГруппы = СформироватьСтильГлавнойГруппы(Форма);

	ШаблонДокумента = ШаблонСхемыФормыРМК();
	СодержимоеДокумента = СтрЗаменить(ШаблонДокумента, "&WrapperStyle}", СтильГлавнойГруппы);
	СодержимоеДокумента = СтрЗаменить(СодержимоеДокумента, "&StyleContent", БлокСтилей);
	СодержимоеДокумента = СтрЗаменить(СодержимоеДокумента, "&FieldContent", БлокПанелей);
	
	Возврат СодержимоеДокумента;
	
КонецФункции

Функция ОчиститьКэшКонтроляПродаж(КэшКонтроляПродаж, ТолькоДанныеКорзины = Ложь) Экспорт
	
	Если ТолькоДанныеКорзины Тогда
		ПостоянныеЭлементыКонтроляПродаж = ПолучитьПостоянныеЭлементыКонтроляПродаж(КэшКонтроляПродаж);
		ПостоянныеВидыКонтроля = ПолучитьПостоянныеВидыКонтроля(КэшКонтроляПродаж, ПостоянныеЭлементыКонтроляПродаж);
		КоличествоСтрокЭлементовКонтроля = КэшКонтроляПродаж.ЭлементыКонтроляПродаж.Количество();
		КоличествоСтрокВидов = КэшКонтроляПродаж.СтрокиВидовКонтроля.Количество();
		
		ИндексСтроки = 0;
		Пока ИндексСтроки < КоличествоСтрокЭлементовКонтроля Цикл
			ТекущийИндекс = КоличествоСтрокЭлементовКонтроля - ИндексСтроки - 1;
			СтрокаЭлементаКонтроля = КэшКонтроляПродаж.ЭлементыКонтроляПродаж.Получить(ТекущийИндекс);
			Если ПостоянныеЭлементыКонтроляПродаж.Найти(СтрокаЭлементаКонтроля.КонтрольПродаж) = Неопределено Тогда
				КэшКонтроляПродаж.ЭлементыКонтроляПродаж.Удалить(ТекущийИндекс);
			КонецЕсли;
			ИндексСтроки = ИндексСтроки + 1;
		КонецЦикла;
		
		ИндексСтроки = 0;
		Пока ИндексСтроки < КоличествоСтрокВидов Цикл
			ТекущийИндекс = КоличествоСтрокВидов - ИндексСтроки - 1;
			СтрокаВида = КэшКонтроляПродаж.СтрокиВидовКонтроля.Получить(ТекущийИндекс);
			Если ПостоянныеВидыКонтроля.Найти(СтрокаВида.ВидКонтроля) = Неопределено Тогда
				КэшКонтроляПродаж.СтрокиВидовКонтроля.Удалить(ТекущийИндекс);
			КонецЕсли;
			ИндексСтроки = ИндексСтроки + 1;
		КонецЦикла;
	Иначе
		КэшКонтроляПродаж.ЭлементыКонтроляПродаж.Очистить();
		КэшКонтроляПродаж.СтрокиВидовКонтроля.Очистить();
		КэшКонтроляПродаж.НоменклатураПлиткиКонтроляПродаж.Очистить();
		КэшКонтроляПродаж.ОбщийКонтрольПродаж.Очистить();
	КонецЕсли;
	КэшКонтроляПродаж.НоменклатураКонтроляПродаж.Очистить();
	
КонецФункции

Функция ШаблонРезультатаКонтроляПродаж() Экспорт
	
	РезультатФункции = Новый Структура();
	РезультатФункции.Вставить("КонтролируемыеСтрокиТоваров", Новый Массив);
	РезультатФункции.Вставить("ОграниченияПродаж", Новый Массив);
	РезультатФункции.Вставить("ОповещениеПриУспехе", Неопределено);
	РезультатФункции.Вставить("ОповещениеПриОтказе", Неопределено);
	РезультатФункции.Вставить("ЭтапКонтроля", -1);
	РезультатФункции.Вставить("НуженПересчет", Ложь);
	РезультатФункции.Вставить("ДобавлениеПодбором", Ложь);
	РезультатФункции.Вставить("ДобавлениеИзПлитки", Ложь);
	РезультатФункции.Вставить("НужнаПроверкаДоступностиОплаты", Ложь);
	РезультатФункции.Вставить("БылоУдалениеСтрок", Ложь);
	РезультатФункции.Вставить("ТекстПредупрежденияЗапретаОплатыБонусами", "");
	РезультатФункции.Вставить("НеВыводитьЗапретБонусов", Ложь);
	РезультатФункции.Вставить("БылоИзменениеЦены", Ложь);
	РезультатФункции.Вставить("ТребуетсяПроверкаМарки", Ложь);
	РезультатФункции.Вставить("КонтекстПроверкиМарки", Неопределено);
	РезультатФункции.Вставить("СтартКонтроля", Ложь);
	
	Возврат РезультатФункции;
	
КонецФункции

Функция СформироватьЗаголовокПредупрежденияПоТипуКонтроля(ТипКонтроля) Экспорт
	
	РезультатФункции = "";
	
	Если ТипКонтроля = ПредопределенноеЗначение("Перечисление.ТипыКонтроля.ЛимитКоличестваВСтроке") Тогда
		РезультатФункции = НСтр("ru = 'Превышение допустимого количества в строке товара.'");
	ИначеЕсли ТипКонтроля = ПредопределенноеЗначение("Перечисление.ТипыКонтроля.ЛимитКоличестваСтрокВЧеке") Тогда
		РезультатФункции = НСтр("ru = 'Превышение количества строк в чеке.'");
	ИначеЕсли ТипКонтроля = ПредопределенноеЗначение("Перечисление.ТипыКонтроля.ЛимитСуммыВЧеке") Тогда
		РезультатФункции = НСтр("ru = 'Превышение допустимой суммы в чеке.'");
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ЭтапыКонтроляПродаж() Экспорт
	
	РезультатФункции = Новый Структура();
	РезультатФункции.Вставить("ДобавлениеТовара", 0);
	РезультатФункции.Вставить("ОткрытиеЧека", 1);
	РезультатФункции.Вставить("ПробитиеЧека", 2);
	РезультатФункции.Вставить("ИзменениеСтрокиТовара", 3);
	РезультатФункции.Вставить("ПереходКОплате", 4);
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура ВыполнитьПроверкиКонтроляПродаж(Форма, ЭтапКонтроля, ДополнительныеПараметры = Неопределено) Экспорт
	
	ЭтапыКонтроляПродаж = ЭтапыКонтроляПродаж();
	Если (ЭтапКонтроля = ЭтапыКонтроляПродаж.ДобавлениеТовара И Форма.СписокДобавленныхСтрокТоваров.Количество() = 0)
			Или Не Форма.ИспользоватьКонтрольПродаж Тогда
		Форма.СписокДобавленныхСтрокТоваров.Очистить();
		Возврат;
	КонецЕсли;
	
	РезультатКонтроля = Форма.РезультатКонтроляПродаж;
	КэшКонтроляПродаж = Форма.КэшКонтроляПродаж;
	ИспользуемыеТипыКонтроля = ПолучитьТипыКонтроляЭтапа(ЭтапКонтроля);
	
	ОчиститьРезультатКонтроляПродаж(РезультатКонтроля);
	РезультатКонтроля.ЭтапКонтроля = ЭтапКонтроля;
	Если ЭтапКонтроля = ЭтапыКонтроляПродаж.ДобавлениеТовара
			Или ЭтапКонтроля = ЭтапыКонтроляПродаж.ИзменениеСтрокиТовара Тогда
			
		Для Каждого СтрокаДобавленногоТовара Из Форма.СписокДобавленныхСтрокТоваров Цикл
			ОтборСтроки = Новый Структура("ИдентификаторСтроки", СтрокаДобавленногоТовара.Значение);
				
			СтрокиТоваров = Форма.объект.Товары.НайтиСтроки(ОтборСтроки);
			Если СтрокиТоваров.Количество() > 0 Тогда
				РезультатКонтроля.КонтролируемыеСтрокиТоваров.Добавить(СтрокиТоваров[0]);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	ДатаПроверки = ОбщегоНазначенияКлиент.ДатаСеанса();
	
	ОтобранныеВидыКонтроля = ОтобратьВидыКонтроляПоТипам(КэшКонтроляПродаж, ИспользуемыеТипыКонтроля);
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ЭтапКонтроля", ЭтапКонтроля);
	ПараметрыПроверки.Вставить("МассивВидовКонтроля", ОтобранныеВидыКонтроля.МассивВидовКонтроля);
	ПараметрыПроверки.Вставить("СоответствиеСтрокВидовКонтроля", ОтобранныеВидыКонтроля.СоответствиеСтрокВидовКонтроля);
	ПараметрыПроверки.Вставить("ДатаПроверки", ДатаПроверки);
	ПараметрыПроверки.Вставить("ИспользуемыеТипыКонтроля", ИспользуемыеТипыКонтроля);
	
	КоличествоОбщихЭлементов = КэшКонтроляПродаж.ОбщийКонтрольПродаж.Количество();
	ИндексЭлементаКонтроля = 0;
	Пока ИндексЭлементаКонтроля < КоличествоОбщихЭлементов Цикл
		ЭлементОбщегоКонтроля = КэшКонтроляПродаж.ОбщийКонтрольПродаж.Получить(ИндексЭлементаКонтроля);
		СтрокаЭлементаКонтроляПродаж = ПолучитьСтрокуЭлементаКонтроляПродаж(КэшКонтроляПродаж, ЭлементОбщегоКонтроля);
		Если Не СтрокаЭлементаКонтроляПродаж = Неопределено Тогда
			
			КоличествоСтрокКонтроля = СтрокаЭлементаКонтроляПродаж.СтрокиКонтроля.Количество();
			ИндексСтрокиКонтроля = 0;
			Пока ИндексСтрокиКонтроля < КоличествоСтрокКонтроля Цикл
				СтрокаКонтроляПродаж = СтрокаЭлементаКонтроляПродаж.СтрокиКонтроля.Получить(ИндексСтрокиКонтроля);
				ВыполнитьПроверкиДляСтрокиКонтроляПродаж(Форма, СтрокаЭлементаКонтроляПродаж, СтрокаКонтроляПродаж,
					Неопределено, ПараметрыПроверки);
				ИндексСтрокиКонтроля = ИндексСтрокиКонтроля + 1;
			КонецЦикла;
			
		КонецЕсли;
		ИндексЭлементаКонтроля = ИндексЭлементаКонтроля + 1;
	КонецЦикла;
	
	КоллекцияТоваров = ?(ЭтапКонтроля = ЭтапыКонтроляПродаж.ДобавлениеТовара,
		РезультатКонтроля.КонтролируемыеСтрокиТоваров, Форма.Объект.Товары);
		
	КоличествоСтрокТоваров = КоллекцияТоваров.Количество();
	ИндексСтрокиТовара = 0;
	Пока ИндексСтрокиТовара < КоличествоСтрокТоваров Цикл
		СтрокаТовара = КоллекцияТоваров.Получить(ИндексСтрокиТовара);
		СтрокиЭлементовКонтроляПродаж = ПолучитьЭлементыКонтроляПродажПоНоменклатуре(КэшКонтроляПродаж, СтрокаТовара);
		КоличествоЭлементовКонтроляПродаж = СтрокиЭлементовКонтроляПродаж.Количество();
		ИндексЭлементаКонтроля = 0;
		Пока ИндексЭлементаКонтроля < КоличествоЭлементовКонтроляПродаж Цикл
			СтрокаЭлементаКонтроляПродаж = СтрокиЭлементовКонтроляПродаж.Получить(ИндексЭлементаКонтроля);
			
			КоличествоСтрокКонтроля = СтрокаЭлементаКонтроляПродаж.СтрокиКонтроля.Количество();
			ИндексСтрокиКонтроля = 0;
			Пока ИндексСтрокиКонтроля < КоличествоСтрокКонтроля Цикл
				СтрокаКонтроляПродаж = СтрокаЭлементаКонтроляПродаж.СтрокиКонтроля.Получить(ИндексСтрокиКонтроля);
				ВыполнитьПроверкиДляСтрокиКонтроляПродаж(Форма, СтрокаЭлементаКонтроляПродаж, СтрокаКонтроляПродаж,
					СтрокаТовара, ПараметрыПроверки);
				ИндексСтрокиКонтроля = ИндексСтрокиКонтроля + 1;
			КонецЦикла;
			
			ИндексЭлементаКонтроля = ИндексЭлементаКонтроля + 1;
		КонецЦикла;
		ИндексСтрокиТовара = ИндексСтрокиТовара + 1;
	КонецЦикла;

	УстановитьТекстПредупрежденияЗапретаОплатыБонусами(РезультатКонтроля, КэшКонтроляПродаж, ПараметрыПроверки);
	Если РезультатКонтроля.ТекстПредупрежденияЗапретаОплатыБонусами = "" Тогда
		РезультатКонтроля.ТекстПредупрежденияЗапретаОплатыБонусами
			= НСтр("ru = 'Бонусами и скидками запрещено оплачивать подарки'");
	КонецЕсли;
	
	Форма.СписокДобавленныхСтрокТоваров.Очистить();
	
КонецПроцедуры

Процедура ОчиститьРезультатКонтроляПродаж(РезультатКонтроляПродаж) Экспорт
	
	РезультатКонтроляПродаж.КонтролируемыеСтрокиТоваров.Очистить();
	РезультатКонтроляПродаж.ОграниченияПродаж.Очистить();
	РезультатКонтроляПродаж.ОповещениеПриУспехе = Неопределено;
	РезультатКонтроляПродаж.ОповещениеПриОтказе = Неопределено;
	РезультатКонтроляПродаж.ЭтапКонтроля = -1;
	РезультатКонтроляПродаж.НуженПересчет = Ложь;
	РезультатКонтроляПродаж.ДобавлениеПодбором = Ложь;
	РезультатКонтроляПродаж.ДобавлениеИзПлитки = Ложь;
	РезультатКонтроляПродаж.НужнаПроверкаДоступностиОплаты = Ложь;
	РезультатКонтроляПродаж.БылоУдалениеСтрок = Ложь;
	РезультатКонтроляПродаж.ТребуетсяПроверкаМарки = Ложь;
	РезультатКонтроляПродаж.КонтекстПроверкиМарки = Неопределено;
	РезультатКонтроляПродаж.СтартКонтроля = Ложь;
	
КонецПроцедуры

Функция ПолучитьПараметрыИзТекстаШаблонаПредупреждения(ТекстШаблона) Экспорт
	
	РезультатФункции = Новый Массив;
	
	СимволНачалаПараметра = "[";
	СимволКонцаПараметра = "]";
	СтрокаШаблона = ТекстШаблона;
	ПозицияНачала = СтрНайти(СтрокаШаблона, СимволНачалаПараметра);
	Пока ПозицияНачала > 0 Цикл
		
		ПозицияОкончания = СтрНайти(СтрокаШаблона, СимволКонцаПараметра);
		Если ПозицияОкончания > 0 Тогда
			ИмяПараметра = Сред(СтрокаШаблона, ПозицияНачала + 1, ПозицияОкончания - ПозицияНачала - 1);
			Если СтрДлина(ИмяПараметра) > 0 И СтрНайти(ИмяПараметра, " ") = 0 Тогда
				РезультатФункции.Добавить(ИмяПараметра);
			КонецЕсли;
			СтрокаШаблона = Сред(СтрокаШаблона, ПозицияОкончания + 1);
			ПозицияНачала = СтрНайти(СтрокаШаблона, СимволНачалаПараметра);
		Иначе
			ПозицияНачала = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

#Область РаботаСУниверсальнойЦифровойКлавиатурой

Функция ПолучитьТекстКнопкиДваНуля() Экспорт
	
	Возврат "00";
	
КонецФункции

Функция ПолучитьСимволЗвездочка() Экспорт
	
	Возврат "*";
	
КонецФункции

Функция ПолучитьСимволКоманды(ИмяКоманды) Экспорт
	
	РезультатФункции = "";
	
	ИмяХвоста = "УниверсальнаяКлавиатура";
	ДлинаПрефикса = 5;
	ПозицияХвоста = СтрНайти(ИмяКоманды, ИмяХвоста);
	Если ПозицияХвоста > 1 Тогда
		РезультатФункции = Сред(ИмяКоманды, ДлинаПрефикса + 1, 1);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ОчиститьТекстРедактированияВПолеФормы(Форма, РедактируемыйЭлемент) Экспорт
	
	ДлинаТекста = СтрДлина(РедактируемыйЭлемент.ТекстРедактирования);
	РедактируемыйЭлемент.УстановитьГраницыВыделения(1,ДлинаТекста+1);
	РедактируемыйЭлемент.ВыделенныйТекст = "";
	Возврат АктивироватьЭлементВводаПриВозможности(Форма, РедактируемыйЭлемент);
	
КонецФункции

Функция ПолучитьПозициюКурсораСУчетомФорматирования(ТекстДо, ТекстПосле, НачалоВыделения, ДлинаВставки, СимволИсключения) Экспорт
	
	РезультатФункции = 1;
	ИндексСимвола = 1;
	ДлинаТекста = СтрДлина(ТекстПосле);
	ДлинаЛевойЧасти = ПолучитьДлинуЗначащихСимволов(ТекстДо, НачалоВыделения, СимволИсключения) + ДлинаВставки;
	ИндексЗначимогоСимвола = 0;
	Пока ИндексСимвола <= ДлинаТекста И ИндексЗначимогоСимвола < ДлинаЛевойЧасти Цикл
		
		ТекущийСимвол = Сред(ТекстПосле, ИндексСимвола, 1);
		Если Не ТекущийСимвол = СимволИсключения Тогда
			ИндексЗначимогоСимвола = ИндексЗначимогоСимвола + 1;
		КонецЕсли;
		РезультатФункции = РезультатФункции + 1;
		
		ИндексСимвола = ИндексСимвола + 1;
		
	КонецЦикла;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ВычислитьПозициюВыделенияПослеВставки(Форма, РедактируемыйЭлемент, ТекстДоРедактирования, ПараметрыВыделения,
		СимволыКлавиатуры) Экспорт
	
	РезультатФункции = 0;
	
	ДлинаТекста = СтрДлина(РедактируемыйЭлемент.ТекстРедактирования);
	ВычестьИзДлиныПостфикс(ДлинаТекста, РедактируемыйЭлемент);
	ДлинаВставки = СтрДлина(СимволыКлавиатуры);
	
	СимволРазделителя = ИнтерфейсРМКСлужебныйКлиентСервер.РазделительДробнойЧасти();
	ВводДробнойЧасти = Ложь;
	ПозицияРазделителя = СтрНайти(ТекстДоРедактирования, СимволРазделителя);
	ВводДробнойЧасти = (ПараметрыВыделения.НачалоВыделения > ПозицияРазделителя);
	Если ИнтерфейсРМКСлужебныйКлиентСервер.ЭтоПолеТелефонаСМаской(РедактируемыйЭлемент) Тогда
		Если ПараметрыВыделения.НачалоВыделения < 3 Тогда
			ПараметрыВыделения.НачалоВыделения = 3;
		КонецЕсли;
		РезультатФункции = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПозициюКурсораСУчетомФорматирования(ТекстДоРедактирования,
			РедактируемыйЭлемент.ТекстРедактирования, ПараметрыВыделения.НачалоВыделения, ДлинаВставки, " ");
	ИначеЕсли ВводДробнойЧасти Тогда
	
		РезультатФункции = Мин(ДлинаТекста + 1, ПараметрыВыделения.НачалоВыделения + ДлинаВставки);
	
	ИначеЕсли ПозицияРазделителя > 0 И ПараметрыВыделения.НачалоВыделения <= ПозицияРазделителя
			И ПараметрыВыделения.КонецВыделения > ПозицияРазделителя Тогда
		
		РезультатФункции = СтрНайти(РедактируемыйЭлемент.ТекстРедактирования, СимволРазделителя);
		
	Иначе
		
		ТекстЦелоеДоЕдиницы = СтрШаблон("0%1", СимволРазделителя);
		Если Лев(ТекстДоРедактирования, 2) = ТекстЦелоеДоЕдиницы Тогда
			ПараметрыВыделения.НачалоВыделения = 1;
		КонецЕсли;
		РезультатФункции = ИнтерфейсРМКСлужебныйКлиент.ПолучитьПозициюКурсораСУчетомФорматирования(ТекстДоРедактирования,
			РедактируемыйЭлемент.ТекстРедактирования, ПараметрыВыделения.НачалоВыделения, ДлинаВставки, Символы.НПП);
		
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Процедура УдалитьСимволыВРедактируемомПоле(Форма, РедактируемыйЭлемент, СимволИсключения) Экспорт
	
	Если Не РедактируемыйЭлемент = Неопределено Тогда
		
		ПараметрыВыделения = Новый Структура();
		ПараметрыВыделения.Вставить("НачалоВыделения", 0);
		ПараметрыВыделения.Вставить("НачалоСтроки", 0);
		ПараметрыВыделения.Вставить("КонецВыделения", 0);
		ПараметрыВыделения.Вставить("КонецСтроки", 0);
		
		РедактируемыйЭлемент.ПолучитьГраницыВыделения(ПараметрыВыделения.НачалоСтроки, ПараметрыВыделения.НачалоВыделения,
			ПараметрыВыделения.КонецСтроки, ПараметрыВыделения.КонецВыделения);
		РедактируемыйТекст = РедактируемыйЭлемент.ТекстРедактирования;
		Форма.ТекущийЭлемент = РедактируемыйЭлемент;
		
		НовыйКонецВыделения = 1;
		МинимальноеНачало = 1;
		СимволЗамены = "";
		Если ПараметрыВыделения.НачалоВыделения = ПараметрыВыделения.КонецВыделения Тогда
			Если ПараметрыВыделения.НачалоВыделения > МинимальноеНачало Тогда
				СимволСлева = Сред(РедактируемыйТекст, ПараметрыВыделения.НачалоВыделения - 1, 1);
				Если СимволСлева = СимволИсключения Тогда
					НовыйКонецВыделения = ПараметрыВыделения.НачалоВыделения - 1;
				Иначе
					РедактируемыйЭлемент.УстановитьГраницыВыделения(ПараметрыВыделения.НачалоВыделения - 1,
						ПараметрыВыделения.НачалоВыделения);
					РедактируемыйЭлемент.ВыделенныйТекст = СимволЗамены;
					Форма.ОбновитьОтображениеДанных(РедактируемыйЭлемент);
					
					ПараметрыПозиции = Новый Структура();
					ПараметрыПозиции.Вставить("НачалоВыделения", ПараметрыВыделения.НачалоВыделения - 1);
					ПараметрыПозиции.Вставить("КонецВыделения", ПараметрыВыделения.КонецВыделения);
					
					НовыйКонецВыделения = ВычислитьПозициюВыделенияПослеВставки(Форма, РедактируемыйЭлемент, РедактируемыйТекст,
						ПараметрыПозиции, "");
				КонецЕсли;
			КонецЕсли;
		Иначе
			РедактируемыйЭлемент.ВыделенныйТекст = СимволЗамены;
			Форма.ОбновитьОтображениеДанных(РедактируемыйЭлемент);
			НовыйКонецВыделения = ВычислитьПозициюВыделенияПослеВставки(Форма, РедактируемыйЭлемент, РедактируемыйТекст,
				ПараметрыВыделения, "");
		КонецЕсли;
		РедактируемыйЭлемент.УстановитьГраницыВыделения(НовыйКонецВыделения, НовыйКонецВыделения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВставитьСимволыВРедактируемоеПоле(Форма, РедактируемыйЭлемент, СимволыКлавиатуры) Экспорт
	
	Если Не РедактируемыйЭлемент = Неопределено Тогда
		
		ПараметрыВыделения = Новый Структура();
		ПараметрыВыделения.Вставить("НачалоВыделения", 0);
		ПараметрыВыделения.Вставить("НачалоСтроки", 0);
		ПараметрыВыделения.Вставить("КонецВыделения", 0);
		ПараметрыВыделения.Вставить("КонецСтроки", 0);
		
		РедактируемыйЭлемент.ПолучитьГраницыВыделения(ПараметрыВыделения.НачалоСтроки, ПараметрыВыделения.НачалоВыделения,
			ПараметрыВыделения.КонецСтроки, ПараметрыВыделения.КонецВыделения);
		РедактируемыйТекст = РедактируемыйЭлемент.ТекстРедактирования;
		
		Форма.ТекущийЭлемент = РедактируемыйЭлемент;
		РедактируемыйЭлемент.ВыделенныйТекст = СимволыКлавиатуры;
		Форма.ОбновитьОтображениеДанных(РедактируемыйЭлемент);
		
		НовыйКонецВыделения = ИнтерфейсРМКСлужебныйКлиент.ВычислитьПозициюВыделенияПослеВставки(ЭтотОбъект,
			РедактируемыйЭлемент, РедактируемыйТекст, ПараметрыВыделения, СимволыКлавиатуры);
		
		РедактируемыйЭлемент.УстановитьГраницыВыделения(НовыйКонецВыделения, НовыйКонецВыделения);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеХарактеристик

// Процедура заполнения плитки выбора данными из таблицы
// Параметры:
//  Форма - Форма рабочего места кассира.
Процедура ПостроитьПлиткуВыбораЗначений(Форма) Экспорт
	
	МаксимальноеКоличествоНаСтранице = ИнтерфейсРМКСлужебныйКлиентСервер.КоличествоКарточекИзбранногоНаСтранице();
	ЗначенияНаСтранице = Форма.ДанныеПлиткиПодбораЗначений;
	ОбщееКоличествоЭлементов = ЗначенияНаСтранице.Количество();
	Элементы = Форма.Элементы;
	ДанныеКнопок = Форма.ДанныеКнопок;
	
	// Скрываются лишние ряды, если элементов достаточно для одного ряда
	ЭлементРяд = Элементы.РядКнопок_2;
	Если Не (Форма.ЕстьГруппыИзбранногоБолее4 И Форма.ИзбранноеРазвернуто) Тогда
		ЭлементРяд.Видимость = (ОбщееКоличествоЭлементов > Цел(МаксимальноеКоличествоНаСтранице / 2));
	КонецЕсли;
	
	ОтображатьОстаток = Ложь;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ОтображатьОстаток") Тогда
		ОтображатьОстаток = Форма.ОтображатьОстаток;
	КонецЕсли;
	
	СкрыватьЦену = Ложь;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "СкрыватьЦенуИзбранных") Тогда
		СкрыватьЦену = Форма.СкрыватьЦенуИзбранных;
	КонецЕсли;
	
	ОтображатьНаименованиеДляПечати = Ложь;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,
		"ОтображатьНаименованиеДляПечати") Тогда
		ОтображатьНаименованиеДляПечати = Форма.ОтображатьНаименованиеДляПечати;
	КонецЕсли;
	
	ИзбраннаяПозиция = Неопределено;
	ИменаЭлементов = ПолучитьИменаЭлементовИзбранного();
	
	Для ИндексПП = 0 По МаксимальноеКоличествоНаСтранице - 1 Цикл
		
		НомерКарточки = ИндексПП + 1;
		ПозицияКнопки = ДанныеКнопок[ИндексПП];
		ПозицияКнопки.АдресИзображения = "";
		ПозицияКнопки.ПервыйИндексПлитки = -1;
		ПозицияКнопки.ВторойИндексПлитки = -1;
		ПозицияКнопки.ЭтоКатегория = Ложь;
		ПозицияКнопки.Номенклатура = Неопределено;
		ПозицияКнопки.Характеристика = Неопределено;
		ПозицияКнопки.ЭтоТекущаяКатегория = Ложь;
		ПозицияКнопки.ИмеетсяВложенность = Ложь;
		ПозицияКнопки.КоличествоТекст = "";
		ПозицияКнопки.ЦенаТекст = "";
		ПозицияКнопки.ИмяЭлемента = "";
		
		ЭтоПустаяОбласть = (ИндексПП >= ОбщееКоличествоЭлементов);
		Если ЭтоПустаяОбласть Тогда
			Элементы[ИменаЭлементов.Контейнер + НомерКарточки].ТекущаяСтраница
				= Элементы[ИменаЭлементов.ВидПустой + НомерКарточки];
		Иначе
			ИзбраннаяПозиция = ЗначенияНаСтранице[ИндексПП];
			Если ИндексПП = МаксимальноеКоличествоНаСтранице - 1 И Не ЗначениеЗаполнено(ИзбраннаяПозиция.ЗначениеВыбора) Тогда
				СтраницаХарактеристики = Элементы[ИменаЭлементов.СтраницаГруппы + НомерКарточки];
			Иначе
				СтраницаХарактеристики = Элементы[ИменаЭлементов.СтраницаЭлемента + НомерКарточки];
			КонецЕсли;
			Элементы[ИменаЭлементов.СтраницыИзбранного + НомерКарточки].ТекущаяСтраница = СтраницаХарактеристики;
			
			Элементы[ИменаЭлементов.Контейнер + НомерКарточки].ТекущаяСтраница
				= Элементы[ИменаЭлементов.СтраницаИзбранное + НомерКарточки];
			УстановитьЦветаИзбранного(Элементы, НомерКарточки, ИзбраннаяПозиция, ОтображатьОстаток, СкрыватьЦену);
			ПараметрыЗаполнения = Новый Структура();
			ПараметрыЗаполнения.Вставить("ОтображатьОстаток", ОтображатьОстаток);
			ПараметрыЗаполнения.Вставить("СкрыватьЦену", СкрыватьЦену);
			ПараметрыЗаполнения.Вставить("ОтображатьНаименованиеДляПечати", ОтображатьНаименованиеДляПечати);
			ЗаполнитьДанныеКарточкиХарактеристики(ПозицияКнопки, ИзбраннаяПозиция, ПараметрыЗаполнения);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти

