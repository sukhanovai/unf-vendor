Функция СформироватьПакетДляОтправки(СоставОбратнойСвязи)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеОбратнойСвязи = СоставОбратнойСвязи;
	Окружение = ПолучитьДанныеОкружения();
	ПараметрыПользователя = ПолучитьПараметрыПользователя();
	
	Результат = Новый Структура;
	Результат.Вставить("ОбратнаяСвязь", ДанныеОбратнойСвязи);
	Результат.Вставить("Окружение", Окружение);
	Результат.Вставить("ПараметрыПользователя", ПараметрыПользователя);
	
	РезультатJSON = СтруктураВСтрокуJSON(Результат);
	
	Возврат РезультатJSON;
	
КонецФункции

Функция ПолучитьДанныеОкружения()
	
	Настройки = ХранилищеСистемныхНастроек.Загрузить(
		"Общее/НастройкиКлиентскогоПриложения", "");
	Если Настройки.ВариантИнтерфейсаКлиентскогоПриложения
		= ВариантИнтерфейсаКлиентскогоПриложения.Версия8_5 Тогда
		ВариантИнтерфейса = "Версия8_5";
	Иначе
		ВариантИнтерфейса = "Такси";
	КонецЕсли;
	
	ПараметрыЭкранов = ПолучитьИнформациюЭкрановКлиента();
	Если ПараметрыЭкранов <> Неопределено Тогда
		ПервыйЭкран = ПараметрыЭкранов[0];
		ШаблонРазрешениеПервогоЭкрана = "%1x%2x%3";
		РазрешениеПервогоЭкрана = СтрШаблон(ШаблонРазрешениеПервогоЭкрана, ПервыйЭкран.Ширина, ПервыйЭкран.Высота,
			ПервыйЭкран.DPI);
		РазрешениеПервогоЭкрана = СтрЗаменить(РазрешениеПервогоЭкрана, Символы.НПП, "");
		РазрешениеПервогоЭкрана = СтрЗаменить(РазрешениеПервогоЭкрана, ",", "");
	Иначе
		РазрешениеПервогоЭкрана = "0x0x0";
	КонецЕсли;

	ПТемаКлиентскогоПриложения = Настройки.ТемаКлиентскогоПриложения;
	ПВариантОтображенияОсновногоОкнаКлиентскогоПриложения = Настройки.ВариантОтображенияОсновногоОкнаКлиентскогоПриложения;
	ПВариантОткрытияОконКлиентскогоПриложения = Настройки.ВариантОткрытияОконКлиентскогоПриложения;
	ПВариантМасштабаКлиентскогоПриложения = Настройки.ВариантМасштабаКлиентскогоПриложения;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВариантИнтерфейса", Строка(ВариантИнтерфейса));
	Результат.Вставить("ТемаКлиентскогоПриложения", Строка(ПТемаКлиентскогоПриложения));
	Результат.Вставить("ВариантОтображенияОсновногоОкнаКлиентскогоПриложения",
		Строка(ПВариантОтображенияОсновногоОкнаКлиентскогоПриложения));
	Результат.Вставить("ВариантОткрытияОконКлиентскогоПриложения", Строка(ПВариантОткрытияОконКлиентскогоПриложения));
	Результат.Вставить("ВариантМасштабаКлиентскогоПриложения", Строка(ПВариантМасштабаКлиентскогоПриложения));
	Результат.Вставить("РазрешениеЭкрана", РазрешениеПервогоЭкрана);
	Результат.Вставить("ТипКлиентскогоПриложения", Строка(КлиентскоеПриложение.ТипПриложения()));
	Результат.Вставить("Приложение", Метаданные.Имя);
	ОСистеме = Новый СистемнаяИнформация;
	Результат.Вставить("ВерсияПлатформы", ОСистеме.ВерсияПриложения);
	Результат.Вставить("ВерсияПриложения", Метаданные.Версия);
	
	МодельСервиса = ОбщегоНазначения.РазделениеВключено();
	Результат.Вставить("ЭтоМодельСервиса", МодельСервиса);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПараметрыПользователя()
	
	Пользователь = Пользователи.АвторизованныйПользователь();
	ИДПользователя = Строка(Пользователь.УникальныйИдентификатор());
	
	Результат = Новый Структура;
	Результат.Вставить("НачалоРаботы", НачалоРаботыПользователя(Пользователь));
	Результат.Вставить("ДоступныеПрофили", ПрофилиПользователя(Пользователь));
	Результат.Вставить("ХэшИдентификатораПользователя", ХэшИдентификатораПользователя(ИДПользователя));
	
	Возврат Результат;
	
КонецФункции

Функция ПрофилиПользователя(Пользователь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ГруппыДоступа.Профиль КАК Профиль
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступа
	|		ПО ГруппыДоступаПользователи.Ссылка = ГруппыДоступа.Ссылка
	|ГДЕ
	|	ГруппыДоступаПользователи.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Результат = Запрос.Выполнить().Выбрать();
	
	ДоступныеПрофили = Новый Массив;
	Пока Результат.Следующий() Цикл
		ИмяРеквизитаНаименование = "Наименование";
		НаименованиеПрофиля = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.Профиль, ИмяРеквизитаНаименование);
		ДоступныеПрофили.Добавить(НаименованиеПрофиля);
	КонецЦикла;
	
	СписокДоступныхПрофилей = СтрСоединить(ДоступныеПрофили, ";");
	
	Возврат СписокДоступныхПрофилей;
	
КонецФункции

Функция СтруктураВСтрокуJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Процедура ЗаписатьОшибкуВЖурналРегистрации(Комментарий)
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Обратная связь'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка, , , Комментарий);
	
КонецПроцедуры

Процедура УвеличитьСчетчикПроведенныхДокументов(ОпытНачалоРаботы)
	
	ОбщееКоличествоПроведенныхДокументов = 0;

	Если Не ОпытНачалоРаботы.Свойство("ОбщееКоличествоПроведенныхДокументов", ОбщееКоличествоПроведенныхДокументов) Тогда
		ОбщееКоличествоПроведенныхДокументов = 0;
		ОпытНачалоРаботы.Вставить("ОбщееКоличествоПроведенныхДокументов", ОбщееКоличествоПроведенныхДокументов);
	КонецЕсли;

	МаксимальноеЗначениеСчетчика = 999;
	Если ОбщееКоличествоПроведенныхДокументов = МаксимальноеЗначениеСчетчика Тогда
		Возврат;
	КонецЕсли;

	ОбщееКоличествоПроведенныхДокументов = Мин(ОбщееКоличествоПроведенныхДокументов + 1, МаксимальноеЗначениеСчетчика);
	ОпытНачалоРаботы.ОбщееКоличествоПроведенныхДокументов = ОбщееКоличествоПроведенныхДокументов;
	
	СохранитьНастройкуОпросаНачалоРаботы(ОпытНачалоРаботы);
	
КонецПроцедуры

#КонецОбласти

