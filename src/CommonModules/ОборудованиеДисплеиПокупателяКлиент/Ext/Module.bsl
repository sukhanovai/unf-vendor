// Вывести тестовые строки на подключенные дисплеи покупателя.
// 
// Параметры:
//  Клиент - ФормаКлиентскогоПриложения - идентификатор формы.
//  Устройство - СправочникСсылка.ПодключаемоеОборудование - идентификатор устройства, если неопределенно - будет предложен выбор.
//  ПараметрыОперации - Структура - параметры выполнения операции.
//  ДополнительныеПараметры - Структура - дополнительные команды.
//
// Возвращаемое значение:
//  Структура
//
Асинх Функция ВывестиИнформациюНаДисплеиПокупателяАсинх(Знач Клиент, Знач Устройство = Неопределено, Знач ПараметрыОперации = Неопределено, Знач ДополнительныеПараметры = Неопределено) Экспорт
	
	Результаты = Новый Массив;
	Команда = "DisplayText";
	Контекст = ОборудованиеДисплеиПокупателяКлиентСервер.НовыйКонтекстОперацииСОборудованием();
	Контекст.Клиент = Клиент;
	Контекст.ДополнительныеПараметры = ДополнительныеПараметры;
	
	Если Не ЗначениеЗаполнено(Устройство) Тогда
		ПоддерживаемыеТипы = МенеджерОборудованияКлиентСервер.ПараметрыТипыОборудования();
		ПоддерживаемыеТипы.ДисплейПокупателя = Истина;
		ПодключенныеУстройства = МенеджерОборудованияКлиент.ПолучитьПодключенныеУстройства(ПоддерживаемыеТипы);
		Если ПодключенныеУстройства.Количество() > 0 Тогда
			Для Каждого Устройство Из ПодключенныеУстройства Цикл
				Контекст.ОсновноеУстройство = Устройство.ИдентификаторУстройства;
				Результаты.Добавить(Ждать МенеджерОборудованияСлужебныйКлиент.ВыполнитьОперациюАсинх(Контекст, Команда, ПараметрыОперации));
			КонецЦикла;
		КонецЕсли;
	Иначе
		Контекст.ОсновноеУстройство = Устройство;
		Результаты.Добавить(Ждать МенеджерОборудованияСлужебныйКлиент.ВыполнитьОперациюАсинх(Контекст, Команда, ПараметрыОперации));
	КонецЕсли;
	
	Возврат Результаты;
	
КонецФункции

 // Вывести QR-код на подключенные дисплеи покупателя.
//
// Параметры:
