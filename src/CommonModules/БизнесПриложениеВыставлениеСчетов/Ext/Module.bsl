	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаСправка", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаИзменитьФорму", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодменюОтчеты", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаКоманднаяПанельКомандыЭДО", "Видимость", Ложь);
	
	Элементы.КоманднаяПанель.Видимость = Ложь;
	Элементы.СписокКонтекстноеМенюУстановитьСостояние.Видимость = Ложь;
	Элементы.СписокКонтекстноеМенюСоздатьНаОснованииПереопределен.Видимость = Ложь;
	Элементы.СписокКонтекстноеМенюГруппаПроведение.Видимость = Ложь;
	Элементы.Детали.Видимость = Ложь;
	Элементы.ЗначокДетали.Видимость = Ложь;
	
	Элементы.ГруппаАналитикаВыставлениеСчетов.Видимость = Элементы.ПраваяПанельСтраницы.Видимость;
	Элементы.КоманднаяПанельУпрощенно.Видимость = Истина;
	Элементы.УстановитьСостояниеЗавершенКМВыставлениеСчетов.Видимость = Истина;
	
	Элементы.ЗагрузитьСтатусыОплатыВыставлениеСчетов.Видимость = ИнтеграцияСПлатежнымиСистемамиДоступна;
	
	Если ЭтоИнтерфейсТакси Тогда
		Элементы.Переместить(Элементы.КоманднаяПанельУпрощенно, Форма.КоманднаяПанель);
	Иначе
		Элементы.Переместить(Элементы.КоманднаяПанельУпрощенно, Элементы.Список.КоманднаяПанель, Элементы.КоманднаяПанель);
	КонецЕсли;
	
	ОбновитьАналитикуВСпискеЗаказов(Форма);
	
	Если ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		
		Элементы.Переместить(Элементы.ГруппаАналитикаВыставлениеСчетов, Элементы.ГруппаОтступ);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура дополняет движения документа "Заказ покупателя" необходимыми данными для приложения "Выставление счетов"
//
// Параметры:
//  ДокументСсылкаЗаказПокупателя	 - ДокументСсылка.ЗаказПокупателя - Заказ, который проводится
//  СтруктураДополнительныеСвойства	 - Структура - Параметры проведения
//
Процедура ПриПроведенииЗаказаПокупателя(ДокументСсылкаЗаказПокупателя, СтруктураДополнительныеСвойства) Экспорт
	
	ОплаченВВыставленииСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылкаЗаказПокупателя, "ОплаченВВыставленииСчетов");
	ОтгруженВВыставленииСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылкаЗаказПокупателя, "ОтгруженВВыставленииСчетов");
	
	Если ОплаченВВыставленииСчетов Тогда
		
		ИсходнаяТаблица = СтруктураДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаОплатаСчетовИЗаказов.Скопировать();
		
		Для каждого ИсходнаяСтрока Из ИсходнаяТаблица Цикл
		
			НоваяСтрока = СтруктураДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаОплатаСчетовИЗаказов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока);
			НоваяСтрока.СуммаАванса = НоваяСтрока.Сумма;
			НоваяСтрока.Сумма = 0;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ОтгруженВВыставленииСчетов Тогда
		
		ИсходнаяТаблица = СтруктураДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаЗаказыПокупателей.Скопировать();
		
		Для каждого ИсходнаяСтрока Из ИсходнаяТаблица Цикл
		
			НоваяСтрока = СтруктураДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаЗаказыПокупателей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока);
			НоваяСтрока.ВидДвижения = ?(ИсходнаяСтрока.ВидДвижения = ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура обновляет аналитику в списке заказов покупателей
//
// Параметры:
//  Форма	 - ФормаКлиентскогоПриложения	 - Форма списка заказов покупателей
//
Процедура ОбновитьАналитикуВСпискеЗаказов(Форма) Экспорт
	
	ДанныеАналитики = Новый Структура;
	ДанныеАналитики.Вставить("ВсегоЗаказов", 0);
	ДанныеАналитики.Вставить("ОплаченоЗаказов", 0);
	ДанныеАналитики.Вставить("СуммаВсего", 0);
	ДанныеАналитики.Вставить("СуммаОплачено", 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказПокупателя.Ссылка), 0) КАК ВсегоЗаказов,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА ЗаказПокупателя.СуммаДокумента <= ЕСТЬNULL(ФактОплатыЗаказов.СуммаАванса, 0) + ЕСТЬNULL(ФактОплатыЗаказов.СуммаОплаты, 0)
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК ОплаченоЗаказов,
		|	ЕСТЬNULL(СУММА(ЗаказПокупателя.СуммаДокумента), 0) КАК СуммаВсего,
		|	ЕСТЬNULL(СУММА(ЕСТЬNULL(ФактОплатыЗаказов.СуммаАванса, 0) + ЕСТЬNULL(ФактОплатыЗаказов.СуммаОплаты, 0)), 0) КАК СуммаОплачено
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФактОплатыЗаказов КАК ФактОплатыЗаказов
		|		ПО (ФактОплатыЗаказов.СчетНаОплату = ЗаказПокупателя.Ссылка)
		|ГДЕ
		|	ЗаказПокупателя.Проведен
		|	И ЗаказПокупателя.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаявкаНаПродажу)
		|	И ЗаказПокупателя.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказПокупателя.ЗаявкаЗаказНаряд)
		|	И &Отборы";
	
	СтрокаОтборов = "";
	
	Если ЗначениеЗаполнено(Форма.ОтборПериод.ДатаНачала) 
		ИЛИ ЗначениеЗаполнено(Форма.ОтборПериод.ДатаОкончания) Тогда
		
		Если НЕ ЗначениеЗаполнено(Форма.ОтборПериод.ДатаОкончания) Тогда
			СтрокаОтборов = " И ЗаказПокупателя.Дата >= &ДатаНачала";
		Иначе
			СтрокаОтборов = " И ЗаказПокупателя.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ДатаНачала", Форма.ОтборПериод.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", Форма.ОтборПериод.ДатаОкончания);
		
	КонецЕсли;
	
	ШаблонОтбора = " И ЗаказПокупателя.ИмяПоляОтбора В (&ИмяПоляОтбора)";
	
	СписокОтборы = Новый Массив;
	СписокОтборы.Добавить("Организация");
	СписокОтборы.Добавить("Контрагент");
	СписокОтборы.Добавить("СостояниеЗаказа");
	СписокОтборы.Добавить("ВариантЗавершения");
	
	Для каждого СтрокаОтбора Из Форма.ДанныеМеток Цикл
		
		Если СписокОтборы.Найти(СтрокаОтбора.ИмяПоляОтбора) <> Неопределено Тогда
			СписокОтборы.Удалить(СписокОтборы.Найти(СтрокаОтбора.ИмяПоляОтбора));
			СтрокаОтборов = СтрокаОтборов + СтрЗаменить(ШаблонОтбора, "ИмяПоляОтбора", СтрокаОтбора.ИмяПоляОтбора);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаОтбора Из Форма.ДанныеМеток Цикл
		
		Если НЕ Запрос.Параметры.Свойство(СтрокаОтбора.ИмяПоляОтбора) Тогда
			 Запрос.УстановитьПараметр(СтрокаОтбора.ИмяПоляОтбора, Новый Массив);
		КонецЕсли;
		
		Запрос.Параметры[СтрокаОтбора.ИмяПоляОтбора].Добавить(СтрокаОтбора.Метка);
		
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &Отборы", СтрокаОтборов);
	
	ВыборкаИтоги = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаИтоги.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеАналитики, ВыборкаИтоги);
	КонецЕсли;
	
	ЭтоТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	Если ЭтоТакси Тогда
		МаксимальнаяДлинаИндикатора = 320;
	Иначе
		МаксимальнаяДлинаИндикатора = 340;
	КонецЕсли;
	ШаблонСумма = НСтр("ru='%1 ₽'");
	ШаблонКоличество = НСтр("ru='%1 шт.'");
	
	Форма.Элементы.ДекорацияСуммаВсего.Заголовок = СтрШаблон(ШаблонСумма, ДанныеАналитики.СуммаВсего);
	Форма.Элементы.ДекорацияСуммаОплачено.Заголовок = СтрШаблон(ШаблонСумма, ДанныеАналитики.СуммаОплачено);
	Форма.Элементы.ДекорацияКоличествоВсего.Заголовок = СтрШаблон(ШаблонКоличество, ДанныеАналитики.ВсегоЗаказов);
	Форма.Элементы.ДекорацияКоличествоОплачено.Заголовок = СтрШаблон(ШаблонКоличество, ДанныеАналитики.ОплаченоЗаказов);
	
	Если ДанныеАналитики.СуммаВсего = 0 ИЛИ ДанныеАналитики.СуммаОплачено = 0 Тогда
		ДлинаИндикатораОплаты = 0;
	Иначе
		Доля = ДанныеАналитики.СуммаОплачено / ДанныеАналитики.СуммаВсего;
		ДлинаИндикатораОплаты = Цел(МаксимальнаяДлинаИндикатора * Доля);
		Если ДлинаИндикатораОплаты > МаксимальнаяДлинаИндикатора Тогда
			ДлинаИндикатораОплаты = МаксимальнаяДлинаИндикатора;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоТакси Тогда
		ШаблонСостояниеОплатыЗаказов = ШаблонСостояниеОплатыЗаказовТакси();
		Форма.Элементы.СостояниеОплатыЗаказов.Ширина = 32;
	Иначе
		ШаблонСостояниеОплатыЗаказов = ШаблонСостояниеОплатыЗаказов85();
		Форма.Элементы.СостояниеОплатыЗаказов.Ширина = 34;
	КонецЕсли;
	ИмяВременногоФайлаSVG = ПолучитьИмяВременногоФайла();
	ФайлКартинки = Новый ЗаписьТекста(ИмяВременногоФайлаSVG);
	ФайлКартинки.Записать(СтрШаблон(ШаблонСостояниеОплатыЗаказов, ДлинаИндикатораОплаты));
	ФайлКартинки.Закрыть();
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайлаSVG);
	УдалитьФайлы(ИмяВременногоФайлаSVG);
	
	Форма.СостояниеОплатыЗаказов = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Форма.УникальныйИдентификатор);
	
КонецПроцедуры

// Процедура настраивает отображения декорации QR-кода
//
// Параметры:
//  Форма	 - ФормаКлиентскогоПриложения	 - Форма документа заказ покупателя
//
Процедура НастроитьДекорациюQR(Форма) Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИнтерфейсВыставлениеСчетов") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.Объект.Контрагент, "ВидКонтрагента");
	ЭтоЮрЛицо = ВидКонтрагента = Перечисления.ВидыКонтрагентов.ГосударственныйОрган
					ИЛИ ВидКонтрагента = Перечисления.ВидыКонтрагентов.ЮридическоеЛицо
					ИЛИ ВидКонтрагента = Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель;
					
	Если ЭтоЮрЛицо Тогда
		
		Элементы.ДекорацияQR.Видимость = Ложь;
		Элементы.ДекорацияQRСБП.Видимость = Ложь;
		
	Иначе
		
		Если ПереводыСБПc2b.ПереводыСБПДоступны() Тогда
			НастройкиСБП = РегистрыСведений.СоответствиеНастроекИнтеграцииРМК.НастройкиИнтеграции(Форма.Объект.Организация, Форма.Объект.СтруктурнаяЕдиницаПродажи);
			НастроенСБП = НастройкиСБП <> Неопределено;
		Иначе
			НастроенСБП = Ложь;
		КонецЕсли;
		
		Если НастроенСБП Тогда
			Элементы.ДекорацияQR.Видимость = Ложь;
			Элементы.ДекорацияQRСБП.Видимость = Истина;
		Иначе
			Элементы.ДекорацияQR.Видимость = Истина;
			Элементы.ДекорацияQRСБП.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Сохраняет переданные настройки формы при их имзменении
//
// Параметры:
//  СтруктураНастроек - Структура - Настройки для сохранения.
//
Процедура СохранитьНастройкиФормы(СтруктураНастроек) Экспорт
	
	ИмяКлючаОбъекта = ПолучитьКлючОбъектаЗаказ();
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(ИмяКлючаОбъекта, ИмяКлючаОбъекта + СтруктураНастроек.Имя, СтруктураНастроек.Значение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ПриСозданииНаСервереСписокКонтрагентов(Форма) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУпрощеннуюФормуКонтрагентов") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	ЭтоИнтерфейсТакси = Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаСправка", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаИзменитьФорму", "Видимость", Ложь);
	
	Элементы.КоманднаяПанель.Видимость = Ложь;
	Элементы.КонтактноеЛицо.Видимость = Ложь;
	Элементы.ЭДО.Видимость = Ложь;
	Элементы.ФильтрыНастройкиИДопИнфо.Видимость = Ложь;
	Элементы.ЗначкиФильтры.Видимость = Ложь;
	Элементы.СписокКонтекстноеМенюГруппаКоманд.Видимость = Ложь;
	Элементы.ФормаИзменитьОбъединитьВыделенныеКМ.Видимость = Ложь;
	Элементы.ГлобальныеКомандыКМ.Видимость = Ложь;
	Элементы.Подменю1СПАРКРиски.Видимость = Ложь;
	
	Элементы.КоманднаяПанельУпрощенно.Видимость = Истина;
	
	Если ЭтоИнтерфейсТакси Тогда
		Элементы.Переместить(Элементы.КоманднаяПанельУпрощенно, Форма.КоманднаяПанель);
	Иначе
		Элементы.Переместить(Элементы.КоманднаяПанельУпрощенно, Элементы.Список.КоманднаяПанель, Элементы.КоманднаяПанель);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ШаблонСостояниеОплатыЗаказовТакси()
	
	Возврат "<svg width=""320px"" height=""30px"" viewBox=""0 -10 321 30"" version=""1.1"" xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">
			|<rect x=""1"" y=""1"" rx=""2"" ry=""2"" width=""320"" height=""8"" fill=""#D0D0D0""/>
			|<rect x=""1"" y=""1"" rx=""2"" ry=""2"" width=""%1"" height=""8"" fill=""#00AA00""/>
			|</svg>";
	
КонецФункции

Функция ШаблонСостояниеОплатыЗаказов85()
	
	Возврат "<svg width=""340px"" height=""130px"" viewBox=""0 -10 341 40"" version=""1.1"" xmlns=""http://www.w3.org/2000/svg"" xmlns:xlink=""http://www.w3.org/1999/xlink"">
			|<rect x=""1"" y=""1"" rx=""6"" ry=""6"" width=""340"" height=""12"" fill=""#D0D0D0""/>
			|<rect x=""1"" y=""1"" rx=""6"" ry=""6"" width=""%1"" height=""12"" fill=""#0cdc40""/>
			|</svg>";
	
КонецФункции

Функция СформироватьСтрокуСимволов(Знач Символ, Знач ДлинаСтроки) Экспорт
	
	Результат = "";
	Для Индекс = 1 По ДлинаСтроки Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ФункциональныеВозможностиПриложения() Экспорт
	
	ТаблицаВозможностей = ТарификацияБизнес.НоваяТаблицаВозможностей();
	
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ФункциональнаяОпцияИспользоватьРучныеСкидкиНаценкиПродажи", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ИнтерфейсВыставлениеСчетов", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ИспользоватьУпрощеннуюРаботуСПодписями", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "УпрощеннаяРаботаСоСтавкамиНДС", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ИспользоватьУпрощеннуюФормуКонтрагентов", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ИспользоватьУпрощеннуюФормуНоменклатуры", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ИспользоватьПростуюКоманднуюПанельВЗаказеПокупателя", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ИспользоватьПростуюКоманднуюПанельВОрганизациях", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ОтображатьПереходКСпискуНоменклатурыВГлавном", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ОтображатьПереходКСпискуПокупателей", Истина);
	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей, "ФункциональнаяОпцияУчетЦенПродажи", Истина);

	ЕБВФункциональныеВозможностиПриложения(ТаблицаВозможностей);
	
	Возврат ТаблицаВозможностей;
	
КонецФункции

Функция ЕБВФункциональныеВозможностиПриложения(ТаблицаВозможностей = Неопределено) Экспорт 
	
	Если ТаблицаВозможностей = Неопределено Тогда
		ТаблицаВозможностей = ТарификацияБизнес.НоваяТаблицаВозможностей();
	КонецЕсли;	
	
	Возврат ТаблицаВозможностей;
	
КонецФункции

Процедура УстановитьЗначенияНастроекПриложения()
	
	// Настройки необходимо выполнить только в том случае, если счета еще не выставлялись
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Дата отгрузки по умолчанию будет равна дате документа
	НаборКонстант = Константы.СоздатьНабор("ВариантЗаполненияДатыОтгрузки,
		|ВидДнейРасчетаДатыОтгрузки, ПроизводственныйКалендарьРасчетаДатыОтгрузки, КоличествоДнейРасчетаДатыОтгрузки");
	
	НастройкиПоУмолчанию = Новый Структура;
	НастройкиПоУмолчанию.Вставить("ВариантЗаполненияДатыОтгрузки", Перечисления.ВариантыЗаполненияДатыОтгрузки.Прибавлять);
	НастройкиПоУмолчанию.Вставить("ВидДнейРасчетаДатыОтгрузки", Перечисления.ВидыДнейРасчетаДатыОтгрузки.Календарные);
	
	Календари = Справочники.ПроизводственныеКалендари.СписокПроизводственныхКалендарей();
	Если Календари.Количество() = 0 Тогда
		Календарь = Справочники.ПроизводственныеКалендари.ПустаяСсылка();
	Иначе
		Календарь = Календари[0];
	КонецЕсли;
	
	НастройкиПоУмолчанию.Вставить("ПроизводственныйКалендарьРасчетаДатыОтгрузки", Календарь);
	НастройкиПоУмолчанию.Вставить("КоличествоДнейРасчетаДатыОтгрузки", 0);
	
	ЗаполнитьЗначенияСвойств(НаборКонстант, НастройкиПоУмолчанию);
	НаборКонстант.Записать();
	
	// Дата оплаты по умолчанию будет равна дате документа
	НаборКонстант = Константы.СоздатьНабор("ВариантЗаполненияДатыОплаты,
		|ВидДнейРасчетаДатыОплаты, ПроизводственныйКалендарьРасчетаДатыОплаты, КоличествоДнейРасчетаДатыОплаты");
	
	НастройкиПоУмолчанию = Новый Структура;
	НастройкиПоУмолчанию.Вставить("ВариантЗаполненияДатыОплаты", Перечисления.ВариантыЗаполненияДатыОтгрузки.Прибавлять);
	НастройкиПоУмолчанию.Вставить("ВидДнейРасчетаДатыОплаты", Перечисления.ВидыДнейРасчетаДатыОтгрузки.Календарные);
	
	Календари = Справочники.ПроизводственныеКалендари.СписокПроизводственныхКалендарей();
	Если Календари.Количество() = 0 Тогда
		Календарь = Справочники.ПроизводственныеКалендари.ПустаяСсылка();
	Иначе
		Календарь = Календари[0];
	КонецЕсли;
	
	НастройкиПоУмолчанию.Вставить("ПроизводственныйКалендарьРасчетаДатыОплаты", Календарь);
	НастройкиПоУмолчанию.Вставить("КоличествоДнейРасчетаДатыОплаты", 0);
	
	ЗаполнитьЗначенияСвойств(НаборКонстант, НастройкиПоУмолчанию);
	НаборКонстант.Записать();
	
	// Выводим сумму без скидки в ПФ
	Константы.ВыводитьСуммуБезСкидки.Установить(Перечисления.ВариантыВыводаСуммыБезСкидки.Печатать);
	Константы.ПредставлениеКодовВПечатныхФормах.Установить(Перечисления.КодыНоменклатурыВДокументах.Артикул);
	Константы.ПредставлениеНомераДокументаБезПрефиксаИнформационнойБазы.Установить(Истина);
	Константы.ПредставлениеНомераДокументаБезПрефиксаОрганизации.Установить(Истина);
	Константы.ФункциональнаяОпцияКонтрольДоговоров.Установить(Перечисления.ВидыКонтроляДоговоровПриПроведении.НеКонтролировать);
	
	РегистрыСведений.СчетчикиПодсказок.ОтключитьСчетчик(Перечисления.ВидыПодсказок.РеквизитыОрганизацииДляПечати, 
														10, , Справочники.Организации.ОсновнаяОрганизация);
	
КонецПроцедуры

Процедура ВосстановитьНастройкиФормыЗаказа(Форма)
	
	ИмяКлючаОбъекта = ПолучитьКлючОбъектаЗаказ();
	
	ЭтоНовыйОбъект = Форма.Объект.Ссылка.Пустая();
	ЭтоКопирование = ЗначениеЗаполнено(Форма.Параметры.ЗначениеКопирования);
	
	Если ЭтоНовыйОбъект И НЕ ЭтоКопирование Тогда
		
		СохраненноеЗначение = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ИмяКлючаОбъекта, ИмяКлючаОбъекта+"_НДСУпрощенно");
		Если ЗначениеЗаполнено(СохраненноеЗначение) Тогда
			Форма.НДСУпрощенно = СохраненноеЗначение;
		КонецЕсли;
		
		СохраненноеЗначение = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ИмяКлючаОбъекта, ИмяКлючаОбъекта+"_ИспользоватьСкидки");
		Если СохраненноеЗначение  <> Неопределено Тогда
			Форма.Объект.ИспользоватьСкидкиВыставлениеСчетов = СохраненноеЗначение;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКлючОбъектаЗаказ()
	
	Возврат "ЗаказПокупателяВыставлениеСчетов"; // Не локализуется
	
КонецФункции

Процедура ПроизвестиНестандартнуюОбработкуПриВключении()

	Константы.ИспользоватьРаботуСПоискомКонтрагентовВСписке.Установить(Ложь);
	Константы.ВыставлениеСчетовБылоВключено.Установить(Истина);
	
	// Устанавливаем настройки ЕБВ, которые необходимы для комфортной работы с приложением
	УстановитьЗначенияНастроекПриложения();
	
КонецПроцедуры

Процедура ПроизвестиНестандартнуюОбработкуПриОтключении()

	Константы.ВыставлениеСчетовБылоВключено.Установить(Истина);
	Константы.ВыставлениеСчетовБылоОтключено.Установить(Истина);
	
КонецПроцедуры

#КонецОбласти