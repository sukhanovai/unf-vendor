
// Описание механизма работы изменения значений ФО:
// В момент подключения приложения будут изменены функциональные опции, относящиеся к следующим категориям:
// - функциональные опции Булевского типа, имеющие значение по умолчанию = Истина
// - функциональные опции, для которых установлен параметр Принудительное включение
// Остальные ФО остаются в том же состоянии, что и были.
// В момент отключения приложения происходит следующее:
// - функциональные опции, для которых установлен параметр ЗначениеПриОтключении принимают это значенин
// - функциональные опции Булевского типа, имеющие значение по умолчанию = Истина становятся равны Ложь
// - остальные ФО принимают значение, указанное в поле ЗначениеПоУмолчанию
// Ниже будут приведены основные сценарии добавления новых ФО в кубик с описанием действий, которые необходимо
// предпринять для того или иного результата:
// - Если необходимо просто задеклалировать наличие ФО в кубике, достаточно использовать следующую конструкцию:
//
//	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей,"ФункциональнаяОпцияУчетВРазличныхЕдиницахИзмерения", Ложь);
//
// В момент подключения приложения указанная ФО просто станет доступной, в момент отключения приложения примет значение Ложь
//	
// - Если необходимо, чтобы в момент включения ФО приняла указанное значение:
//
//	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей,"ПредставлениеКодовВПечатныхФормах", Перечисления.КодыНоменклатурыВДокументах.Код, , Истина);
//
// В момент подключения приложения указанная ФО примет значение Перечисления.КодыНоменклатурыВДокументах.Код,
// в момент отключения ФО так же станет Перечисления.КодыНоменклатурыВДокументах.Код
//
// - Если необходимо, чтобы в момент подключения ФО приняла одно значение, а в момент отключения - другое:
//
//	ТарификацияБизнес.ДобавитьВозможностьВПриложение(ТаблицаВозможностей,"ПредставлениеКодовВПечатныхФормах", 
//		Перечисления.КодыНоменклатурыВДокументах.Код, Перечисления.КодыНоменклатурыВДокументах.Артикул, Истина);
//
// Важно уточнить, что для максимально корректной работы, в особенности в вопросе сохранения значений ФО,
// рекомендуется использовать оба параметра, как на примере выше - и принудительное включение, и значение при отключении.
// В случае использования только одного параметра рекомендуется вносить такую ФО в список Игнорируемых ФО (ТарификацияБизнес.ТаблицаИгнорируемыхФО),
// так как для таких случаев не гарантируется корректное сохранение значений измененных ФО

#Область ПрограммныйИнтерфейс

Процедура ВключитьВозможностиПриложения() Экспорт
	
	ВозможностиПодключаемогоПриложения = ФункциональныеВозможностиПриложения();
	
	Отбор = Новый Структура("ЗначениеПоУмолчанию", Истина);
	ВозможностиПриложенияВключенныеПоУмолчанию = ВозможностиПодключаемогоПриложения.НайтиСтроки(Отбор);
	
	Для каждого ВозможностьПриложения Из ВозможностиПриложенияВключенныеПоУмолчанию Цикл
		
		Попытка
			ИмяКонстанты = ВозможностьПриложения.Имя;
			Константы[ИмяКонстанты].Установить(Истина);
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Комментарий = НСтр("ru='Ошибка попытки установки значения ""%1"" в константу ""%2"" по причине:
			|%3.'");
			Комментарий = СтрШаблон(Комментарий, Ложь, ИмяКонстанты, ТекстОшибки);
			ЗаписьЖурналаРегистрации(ТарификацияБизнес.ИмяЖР(), УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Отбор = Новый Структура("ПринудительноеВключение", Истина);
	ВозможностиПриложенияВключенныеПоУмолчанию = ВозможностиПодключаемогоПриложения.НайтиСтроки(Отбор);
	
	Для каждого ВозможностьПриложения Из ВозможностиПриложенияВключенныеПоУмолчанию Цикл
		
		Попытка
			ИмяКонстанты = ВозможностьПриложения.Имя;
			Константы[ИмяКонстанты].Установить(ВозможностьПриложения.ЗначениеПоУмолчанию);
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Комментарий = НСтр("ru='Ошибка попытки установки значения ""%1"" в константу ""%2"" по причине:
			|%3.'");
			Комментарий = СтрШаблон(Комментарий, Ложь, ИмяКонстанты, ТекстОшибки);
			ЗаписьЖурналаРегистрации(ТарификацияБизнес.ИмяЖР(), УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	ПроизвестиНестандартнуюОбработкуПриВключении();
	
КонецПроцедуры

Процедура ОтключитьВозможностиПриложения(ИсключаяВозможностиПриложений) Экспорт
	
	ОтключаемыеВозможности = ФункциональныеВозможностиПриложения();
	
	Для Каждого ОтключаемаяВозможность Из ОтключаемыеВозможности Цикл
		
		Если ИсключаяВозможностиПриложений.Найти(ОтключаемаяВозможность.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ИмяКонстанты = ОтключаемаяВозможность.Имя; 
			
			Если ОтключаемаяВозможность.ЗначениеПриОтключении <> Неопределено Тогда
				Константы[ИмяКонстанты].Установить(ОтключаемаяВозможность.ЗначениеПриОтключении); 
			Иначе	
				Константы[ИмяКонстанты].Установить(Ложь);
			КонецЕсли;    
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Комментарий = НСтр("ru='Ошибка попытки установки значения ""%1"" в константу ""%2"" по причине:
			|%3.'");
			Комментарий = СтрШаблон(Комментарий, Ложь, ИмяКонстанты, ТекстОшибки);
			ЗаписьЖурналаРегистрации(ТарификацияБизнес.ИмяЖР(), УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
			ВызватьИсключение;
	
		КонецПопытки;
		
	КонецЦикла;
	
	// специфичная функциональность
	ПроизвестиНестандартнуюОбработкуПриОтключении();	
	
КонецПроцедуры

// Процедура настраивает форму заказа покупателя для приложения "Выставление счетов"
//
// Параметры:
//  Форма	 - ФормаКлиентскогоПриложения	 - Форма документа "Заказ покупателя"
//
Процедура ПриСозданииНаСервереЗаказПокупателя(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	
	ИнтерфейсВыставленияСчетов = ПолучитьФункциональнуюОпцию("ИнтерфейсВыставлениеСчетов");
	
	// Специфические действия с элементами формы
	Если ИнтерфейсВыставленияСчетов Тогда
		
		// Прячем контекстные отчеты
		ПараметрыФОСвязанныхОтчетов = Новый Структура;
		ПараметрыФОСвязанныхОтчетов.Вставить("СвязанныеОтчеты", Неопределено);
		Форма.УстановитьПараметрыФункциональныхОпцийФормы(ПараметрыФОСвязанныхОтчетов);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Страницы", "ОтображениеСтраниц", ОтображениеСтраницФормы.Нет);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаПодарки", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаДоставка", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаПлатежныйКалендарь", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПредоплата", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаБонусы", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаОтчетПоСкидкам", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаОбменССайтом", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСостояниеЭДО", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаДополнительно", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаЗавершениеЗаказа", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаПодарки", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаМатериалыЗаказчика", "Видимость", Ложь);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСодержимоеЗаказа", "ВертикальнаяПрокруткаПриСжатии", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаЗапасы", "ВертикальнаяПрокруткаПриСжатии", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СтраницаТаблицаЗапасы", "ВертикальнаяПрокруткаПриСжатии", Ложь);
		Форма.ВертикальнаяПрокрутка = ВертикальнаяПрокруткаФормы.ИспользоватьПриНеобходимости;

		Если НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
			Форма.АвтоЗаголовок = Ложь;
			Форма.Заголовок = НСтр("ru = 'Счет (создание)'");
		КонецЕсли;
		
		ВосстановитьНастройкиФормыЗаказа(Форма);
		
