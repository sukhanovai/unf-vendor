	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Лиды.Ссылка КАК Лид,
		|	ВЫБОР
		|		КОГДА Лиды.ДатаСоздания МЕЖДУ &НовыеНачало И &НовыеКонец
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Новый,
		|	Лиды.Ответственный КАК Менеджер,
		|	Лиды.ДатаСоздания КАК Создан,
		|	Лиды.СостояниеЛида КАК СостояниеЛида,
		|	Лиды.ВариантЗавершения КАК Результат,
		|	ПРЕДСТАВЛЕНИЕ(Лиды.Ссылка) КАК ПредставлениеЛида,
		|	ПРЕДСТАВЛЕНИЕ(Лиды.Ответственный) КАК ПредставлениеМенеджера
		|ИЗ
		|	Справочник.Лиды КАК Лиды
