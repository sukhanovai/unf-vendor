&НаСервере
Процедура СформироватьОтчет()
	
	ОбновитьДиаграммуНовые();
	ОбновитьДиаграммуНовыеПоПериодам();
	ОбновитьДиаграммуПоМенеджерам();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДиаграммуНовые()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(Лиды.Ссылка) КАК КоличествоВсего,
		|	СУММА(ВЫБОР
		|			КОГДА Лиды.ДатаСоздания МЕЖДУ &НовыеНачало И &НовыеКонец
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоНовых
		|ИЗ
		|	Справочник.Лиды КАК Лиды
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиКонтрагентЛид КАК СвязиКонтрагентЛид
		|		ПО Лиды.Ссылка = СвязиКонтрагентЛид.Лид
		|ГДЕ
		|	Лиды.ПометкаУдаления = ЛОЖЬ
		|	И Лиды.ЭтоГруппа = ЛОЖЬ";
		
	Если ЗначениеЗаполнено(ОтборТег) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Лиды.Теги.Тег = &ОтборТег";
		Запрос.УстановитьПараметр("ОтборТег", ОтборТег);
	КонецЕсли;
	
	
	Если ОтборМенеджеры.Количество() > 0 Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Лиды.Ответственный В (&ОтборМенеджеры)";
		Запрос.УстановитьПараметр("ОтборМенеджеры", ОтборМенеджеры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборИсточникПривлеченияПокупателей) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Лиды.ИсточникПривлечения = &ОтборИсточник";
		Запрос.УстановитьПараметр("ОтборИсточник", ОтборИсточникПривлеченияПокупателей);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборСостояние) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Лиды.СостояниеЛида = &ОтборСостояние";
		Запрос.УстановитьПараметр("ОтборСостояние", ОтборСостояние);
	КонецЕсли;
	
	РезультатЛида = РезультатЛидаПоОтбору();
	Если РезультатЛида <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Лиды.ВариантЗавершения = &ОтборРезультат";
		Запрос.УстановитьПараметр("ОтборРезультат", РезультатЛида);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПокупатель) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И СвязиКонтрагентЛид.Контрагент = &ОтборПокупатель";
		Запрос.УстановитьПараметр("ОтборПокупатель", ОтборПокупатель);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиКонтрагентЛид КАК СвязиКонтрагентЛид
		|		ПО Лиды.Ссылка = СвязиКонтрагентЛид.Лид", "");
	КонецЕсли;
	
	ВидЛида = ВидЛидаПоОтбору();
	Если ЗначениеЗаполнено(ВидЛида) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Лиды.Вид = &ОтборВид";
		Запрос.УстановитьПараметр("ОтборВид", ВидЛида);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НовыеНачало", ОтборПериодЗначение.ДатаНачала);
	Запрос.УстановитьПараметр("НовыеКонец", ОтборПериодЗначение.ДатаОкончания);
	
	ВыборкаОбщийИтог = Запрос.Выполнить().Выбрать();
	Если ВыборкаОбщийИтог.Следующий() Тогда
		Новых = ?(ВыборкаОбщийИтог.КоличествоНовых = Null, 0, ВыборкаОбщийИтог.КоличествоНовых);
		Существующих = ?(ВыборкаОбщийИтог.КоличествоВсего = Null, 0, ВыборкаОбщийИтог.КоличествоВсего - Новых);
	Иначе
		Новых = 0;
		Существующих = 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПериодЗначение.ДатаНачала) И ЗначениеЗаполнено(ОтборПериодЗначение.ДатаОкончания) Тогда
		Элементы.ДиаграммаНовые.Заголовок = НСтр("ru = 'Новых за'") +Символы.НПП + Формат(ОтборПериодЗначение.ДатаНачала, "ДФ=dd.MM.yy") + " - " + Формат(ОтборПериодЗначение.ДатаОкончания, "ДФ=dd.MM.yy");
	Иначе
		Элементы.ДиаграммаНовые.Заголовок = НСтр("ru = 'Новых за (период не указан)'");
	КонецЕсли;
	
	ДиаграммаНовые.Обновление = Ложь;
	ДиаграммаНовые.Очистить();
	ДиаграммаНовые.АвтоТранспонирование = Ложь;
	ДиаграммаНовые.МаксимумСерий = МаксимумСерийНеЗадано();
	ДиаграммаНовые.ВидПодписей = ВидПодписейКДиаграммеСерияЗначение();
	ДиаграммаНовые.РазделительПодписей = ": ";
	//@skip-check new-font
	ДиаграммаНовые.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки, -1);
	
	Точка = ДиаграммаНовые.Точки.Добавить("Количество");
	Точка.Текст = "Количество";
	Точка.ПриоритетЦвета = Ложь;
	
	СерияНовые = ДиаграммаНовые.Серии.Добавить(СтрШаблон(НСтр("ru = 'Новые (%1)'"), Новых));
	СерияНовые.Цвет = ЦветаПалитры.ПервыйБрендовый;
	Подсказка = НСтр("ru = 'Создано новых лидов за период:'") + Символы.НПП + Новых;
	ДиаграммаНовые.УстановитьЗначение(Точка, СерияНовые, Новых, "Новые", Подсказка);
	
	СерияСуществующие = ДиаграммаНовые.Серии.Добавить(СтрШаблон(НСтр("ru = 'Существующие (%1)'"), Существующих));
	СерияСуществующие.Цвет = ЦветаПалитры.ВторойБрендовый;
	Подсказка = НСтр("ru = 'Существующих лидов:'") + Символы.НПП + Существующих;
	ДиаграммаНовые.УстановитьЗначение(Точка, СерияСуществующие, Существующих, "Существующие", Подсказка);
	
	ДиаграммаНовые.АвтоТранспонирование = Истина;
	ДиаграммаНовые.Обновление = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДиаграммуНовыеПоПериодам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(Лиды.ДатаСоздания, НЕДЕЛЯ) КАК ДатаСоздания,
		|	Лиды.Ссылка КАК Новый
		|ИЗ
		|	Справочник.Лиды КАК Лиды
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиКонтрагентЛид КАК СвязиКонтрагентЛид
		|		ПО Лиды.Ссылка = СвязиКонтрагентЛид.Лид
		|ГДЕ
		|	Лиды.ПометкаУдаления = ЛОЖЬ
		|	И Лиды.ЭтоГруппа = ЛОЖЬ
		|	И Лиды.ДатаСоздания МЕЖДУ &НовыеНачало И &НовыеКонец
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСоздания
		|ИТОГИ
		|	КОЛИЧЕСТВО(Новый)
		|ПО
		|	ДатаСоздания ПЕРИОДАМИ(НЕДЕЛЯ, &НовыеНачало, &НовыеКонец)";
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "НЕДЕЛЯ", ВРег(Строка(ПараметрПериодичность)));
	
	Если Не ЗначениеЗаполнено(ОтборПокупатель) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиКонтрагентЛид КАК СвязиКонтрагентЛид
		|		ПО Лиды.Ссылка = СвязиКонтрагентЛид.Лид", "");
	КонецЕсли;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	ОтборЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
	
	Если ЗначениеЗаполнено(ОтборТег) Тогда
		ОтборЗапроса.Добавить("Лиды.Теги.Тег = &ОтборТег");
		Запрос.УстановитьПараметр("ОтборТег", ОтборТег);
	КонецЕсли;
	
	
	Если ОтборМенеджеры.Количество() > 0 Тогда
		ОтборЗапроса.Добавить("Лиды.Ответственный В (&ОтборМенеджеры)");
		Запрос.УстановитьПараметр("ОтборМенеджеры", ОтборМенеджеры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборИсточникПривлеченияПокупателей) Тогда
		ОтборЗапроса.Добавить("Лиды.ИсточникПривлечения = &ОтборИсточник");
		Запрос.УстановитьПараметр("ОтборИсточник", ОтборИсточникПривлеченияПокупателей);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборСостояние) Тогда
		ОтборЗапроса.Добавить("Лиды.СостояниеЛида = &ОтборСостояние");
		Запрос.УстановитьПараметр("ОтборСостояние", ОтборСостояние);
	КонецЕсли;
	
	РезультатЛида = РезультатЛидаПоОтбору();
	Если РезультатЛида <> Неопределено Тогда
		ОтборЗапроса.Добавить("Лиды.ВариантЗавершения = &ОтборРезультат");
		Запрос.УстановитьПараметр("ОтборРезультат", РезультатЛида);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПокупатель) Тогда
		ОтборЗапроса.Добавить("СвязиКонтрагентЛид.Контрагент = &ОтборПокупатель");
		Запрос.УстановитьПараметр("ОтборПокупатель", ОтборПокупатель);
	КонецЕсли;
	
	ВидЛида = ВидЛидаПоОтбору();
	Если ЗначениеЗаполнено(ВидЛида) Тогда
		ОтборЗапроса.Добавить("Лиды.Вид = &ОтборВид");
		Запрос.УстановитьПараметр("ОтборВид", ВидЛида);
	КонецЕсли;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("НовыеНачало", ОтборПериодЗначение.ДатаНачала);
	Запрос.УстановитьПараметр("НовыеКонец", ОтборПериодЗначение.ДатаОкончания);
	
	ВыборкаДатаСоздания = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ДатаСоздания", "Все");
	
	ДиаграммаНовыеПоПериодам.Обновление = Ложь;
	ДиаграммаНовыеПоПериодам.Очистить();
	ДиаграммаНовыеПоПериодам.АвтоТранспонирование = Ложь;
	ДиаграммаНовыеПоПериодам.МаксимумСерий = МаксимумСерийНеЗадано();
	ДиаграммаНовыеПоПериодам.ВидПодписей = ВидПодписейКДиаграммеЗначение();
	//@skip-check new-font
	ДиаграммаНовыеПоПериодам.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки, -1);
	ДиаграммаНовыеПоПериодам.ФорматЗначенийВПодписях = "ЧДЦ=; ЧН=' '";
	ДиаграммаНовыеПоПериодам.АвтоУстановкаТекстаТочек = Ложь;
	ДиаграммаНовыеПоПериодам.ОбластьПостроения.ОтображатьПодписиШкалыТочек = Истина;
	//@skip-check new-font
	
	Серия = ДиаграммаНовыеПоПериодам.Серии.Добавить("Новые");
	Серия.Линия = Новый Линия(ТипЛинииДиаграммы.Сплошная, 2);
	//@skip-check bsl-legacy-check-dynamic-feature-access
	Серия.Маркер = ТипМаркераДиаграммы.Круг;
	Серия.ПриоритетЦвета = Истина;
	Серия.Цвет = ЦветаПалитры.ВторойБрендовый;
	
	Пока ВыборкаДатаСоздания.Следующий() Цикл
		Текст = Формат(ВыборкаДатаСоздания.ДатаСоздания, "ДФ=dd.MM.yy");
		Точка = ДиаграммаНовыеПоПериодам.Точки.Добавить(Текст);
		Подсказка = НСтр("ru = 'Создано'") + Символы.НПП + ВыборкаДатаСоздания.Новый + Символы.НПП + НСтр("ru = 'лидов'") + Символы.НПП + Текст;
		ДиаграммаНовыеПоПериодам.УстановитьЗначение(Точка, Серия, ?(ВыборкаДатаСоздания.Новый = Null, 0, ВыборкаДатаСоздания.Новый), ВыборкаДатаСоздания.ДатаСоздания, Подсказка);
	КонецЦикла;
	
	ДиаграммаНовыеПоПериодам.АвтоТранспонирование = Истина;
	ДиаграммаНовыеПоПериодам.Обновление = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДиаграммуПоМенеджерам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(Лиды.Ссылка) КАК Лиды,
		|	Лиды.Ответственный КАК Ответственный,
		|	Лиды.Ответственный.Представление КАК ОтветственныйПредставление
		|ИЗ
		|	Справочник.Лиды КАК Лиды
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиКонтрагентЛид КАК СвязиКонтрагентЛид
		|		ПО Лиды.Ссылка = СвязиКонтрагентЛид.Лид
		|ГДЕ
		|	Лиды.ПометкаУдаления = ЛОЖЬ
		|	И Лиды.ЭтоГруппа = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	Лиды.Ответственный,
		|	Лиды.Ответственный.Представление
		|
		|УПОРЯДОЧИТЬ ПО
		|	Лиды УБЫВ,
		|	Лиды.Ответственный.Наименование";
	
	Если Не ЗначениеЗаполнено(ОтборПокупатель) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязиКонтрагентЛид КАК СвязиКонтрагентЛид
		|		ПО Лиды.Ссылка = СвязиКонтрагентЛид.Лид", "");
	КонецЕсли;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	ОтборЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
	
	Если ЗначениеЗаполнено(ОтборТег) Тогда
		ОтборЗапроса.Добавить("Лиды.Теги.Тег = &ОтборТег");
		Запрос.УстановитьПараметр("ОтборТег", ОтборТег);
	КонецЕсли;
	
	
	Если ОтборМенеджеры.Количество() > 0 Тогда
		ОтборЗапроса.Добавить("Лиды.Ответственный В (&ОтборМенеджеры)");
		Запрос.УстановитьПараметр("ОтборМенеджеры", ОтборМенеджеры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборИсточникПривлеченияПокупателей) Тогда
		ОтборЗапроса.Добавить("Лиды.ИсточникПривлечения = &ОтборИсточник");
		Запрос.УстановитьПараметр("ОтборИсточник", ОтборИсточникПривлеченияПокупателей);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборСостояние) Тогда
		ОтборЗапроса.Добавить("Лиды.СостояниеЛида = &ОтборСостояние");
		Запрос.УстановитьПараметр("ОтборСостояние", ОтборСостояние);
	КонецЕсли;
	
	РезультатЛида = РезультатЛидаПоОтбору();
	Если РезультатЛида <> Неопределено Тогда
		ОтборЗапроса.Добавить("Лиды.ВариантЗавершения = &ОтборРезультат");
		Запрос.УстановитьПараметр("ОтборРезультат", РезультатЛида);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПокупатель) Тогда
		ОтборЗапроса.Добавить("СвязиКонтрагентЛид.Контрагент = &ОтборПокупатель");
		Запрос.УстановитьПараметр("ОтборПокупатель", ОтборПокупатель);
	КонецЕсли;
	
	ВидЛида = ВидЛидаПоОтбору();
	Если ЗначениеЗаполнено(ВидЛида) Тогда
		ОтборЗапроса.Добавить("Лиды.Вид = &ОтборВид");
		Запрос.УстановитьПараметр("ОтборВид", ВидЛида);
	КонецЕсли;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	ВыборкаОтветственные = Запрос.Выполнить().Выбрать();
	
	// Для диаграммы используем свой механизм сводной серии, иначе не вывести произвольную легенду
	
	ДиаграммаПоМенеджерам.Обновление = Ложь;
	ДиаграммаПоМенеджерам.Очистить();
	ДиаграммаПоМенеджерам.АвтоТранспонирование = Ложь;
	ДиаграммаПоМенеджерам.МаксимумСерий = МаксимумСерийНеЗадано();
	ДиаграммаПоМенеджерам.ВидПодписей = ВидПодписейКДиаграммеПроцент();
	ДиаграммаПоМенеджерам.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.БезРамки, -1);
	ДиаграммаПоМенеджерам.ФорматПроцентовВПодписях = "ЧДЦ=";
	
	Точка = ДиаграммаПоМенеджерам.Точки.Добавить("Количество");
	Точка.Текст = "Количество";
	Точка.ПриоритетЦвета = Ложь;
	
	СтрокиОстальные = Новый Массив;
	ПорядковыйНомерСерии = 0;
	МаксимумСерийДиаграммы = 6;
	
	Пока ВыборкаОтветственные.Следующий() Цикл
		
		Если ПорядковыйНомерСерии < МаксимумСерийДиаграммы Тогда
			
			ПредставлениеМенеджера = ?(ЗначениеЗаполнено(ВыборкаОтветственные.Ответственный),
				ВыборкаОтветственные.ОтветственныйПредставление, НСтр("ru = '<Менеджер не указан>'"));
			Серия = ДиаграммаПоМенеджерам.Серии.Добавить(СтрШаблон("%1 (%2)", ПредставлениеМенеджера,
				ВыборкаОтветственные.Лиды));
			Серия.Цвет = ЦветСерииДиаграммыЛидовПоМенеджерам(ПорядковыйНомерСерии);
			Подсказка = СтрШаблон(НСтр("ru = '%1, лидов:%2%3'"), ПредставлениеМенеджера, Символы.НПП,
				ВыборкаОтветственные.Лиды);
			ДиаграммаПоМенеджерам.УстановитьЗначение(Точка, Серия, ВыборкаОтветственные.Лиды,
				ВыборкаОтветственные.Ответственный, Подсказка);
			
		Иначе
			
			ПредставлениеМенеджера = НСтр("ru = '<Остальные>'");
			
			Серия = ДиаграммаПоМенеджерам.Серии.Получить(ДиаграммаПоМенеджерам.Серии.Количество() - 1);
			Серия.Текст = СтрШаблон("%1 (%2)", ПредставлениеМенеджера, ВыборкаОтветственные.Лиды);
			Серия.Цвет = ЦветСерииДиаграммыЛидовПоМенеджерам(ПорядковыйНомерСерии);
			
			СводноеЗначение = ДиаграммаПоМенеджерам.ПолучитьЗначение(Точка, Серия);
			
			Подсказка = СтрШаблон(НСтр("ru = '%1, лидов:%2%3'"), ПредставлениеМенеджера, Символы.НПП,
				СводноеЗначение.Значение + ВыборкаОтветственные.Лиды);
			
			Расшифровка = СводноеЗначение.Расшифровка;
			Если ТипЗнч(Расшифровка) = Тип("Массив") Тогда
				Расшифровка.Добавить(ВыборкаОтветственные.Ответственный);
			Иначе
				Расшифровка = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Расшифровка);
				Расшифровка.Добавить(ВыборкаОтветственные.Ответственный);
			КонецЕсли;
			
			ДиаграммаПоМенеджерам.УстановитьЗначение(Точка, Серия, СводноеЗначение.Значение
				+ ВыборкаОтветственные.Лиды, Расшифровка, Подсказка);
			
			ТекстПодробно = ?(ЗначениеЗаполнено(ВыборкаОтветственные.Ответственный),
				ВыборкаОтветственные.ОтветственныйПредставление, НСтр("ru = '<Менеджер не указан>'")) + " – "
				+ ВыборкаОтветственные.Лиды;
			СтрокаОстальные = Новый ФорматированнаяСтрока(ТекстПодробно, Символы.ПС);
			СтрокиОстальные.Добавить(СтрокаОстальные);
			
		КонецЕсли;
		
		ПорядковыйНомерСерии = ПорядковыйНомерСерии + 1;
		
	КонецЦикла;
	
	ДиаграммаПоМенеджерам.АвтоТранспонирование = Истина;
	ДиаграммаПоМенеджерам.Обновление = Истина;
	
	Если СтрокиОстальные.Количество() Тогда
		Элементы.МенеджерыОстальныеОтображение.Видимость = Истина;
		МенеджерыОстальныеОтображение = Новый ФорматированнаяСтрока(СтрокиОстальные);
	Иначе
		Элементы.МенеджерыОстальныеОтображение.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЦветСерииДиаграммыЛидовПоМенеджерам(ИндексСерии)
	
	Если ИндексСерии = 0 Тогда
		Возврат ЦветаПалитры.Голубой;
	ИначеЕсли ИндексСерии = 1 Тогда
		Возврат ЦветаПалитры.Желтый;
	ИначеЕсли ИндексСерии = 2 Тогда
		Возврат ЦветаПалитры.Зеленый;
	ИначеЕсли ИндексСерии = 3 Тогда
		Возврат ЦветаПалитры.Красный;
	ИначеЕсли ИндексСерии = 4 Тогда
		Возврат ЦветаПалитры.Сиреневый;
	Иначе
		Возврат ЦветаПалитры.Фиолетовый;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СформироватьРасшифровкуНовых(Признак)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_НовыеКонтрагенты";
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_НовыеКонтрагенты";
