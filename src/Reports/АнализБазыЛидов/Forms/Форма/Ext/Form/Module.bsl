		Запрос.УстановитьПараметр("ОтборИсточник", ОтборИсточникПривлеченияПокупателей);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборСостояние) Тогда
		ОтборЗапроса.Добавить("Лиды.СостояниеЛида = &ОтборСостояние");
		Запрос.УстановитьПараметр("ОтборСостояние", ОтборСостояние);
	КонецЕсли;
	
	РезультатЛида = РезультатЛидаПоОтбору();
	Если РезультатЛида <> Неопределено Тогда
		ОтборЗапроса.Добавить("Лиды.ВариантЗавершения = &ОтборРезультат");
		Запрос.УстановитьПараметр("ОтборРезультат", РезультатЛида);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПокупатель) Тогда
		ОтборЗапроса.Добавить("СвязиКонтрагентЛид.Контрагент = &ОтборПокупатель");
		Запрос.УстановитьПараметр("ОтборПокупатель", ОтборПокупатель);
	КонецЕсли;
	
	ВидЛида = ВидЛидаПоОтбору();
	Если ЗначениеЗаполнено(ВидЛида) Тогда
		ОтборЗапроса.Добавить("Лиды.Вид = &ОтборВид");
		Запрос.УстановитьПараметр("ОтборВид", ВидЛида);
	КонецЕсли;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("НовыеНачало", ОтборПериодЗначение.ДатаНачала);
	Запрос.УстановитьПараметр("НовыеКонец", ОтборПериодЗначение.ДатаОкончания);
	Запрос.УстановитьПараметр("Менеджеры", Менеджеры);
	
	ТабличныйДокумент.Вывести(СтруктураОбластей.Отступ);
	ТабличныйДокумент.Вывести(СтруктураОбластей.Шапка);
	ТабличныйДокумент.Вывести(СтруктураОбластей.Отступ);
	
	НовыйИтог = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураОбластей.Строка.Параметры.Заполнить(Выборка);
		ТабличныйДокумент.Вывести(СтруктураОбластей.Строка);
		
		НовыйИтог = НовыйИтог + Число(Выборка.Новый);
		
	КонецЦикла;
	
	ТабличныйДокумент.Вывести(СтруктураОбластей.Отступ);
	
	СтруктураОбластей.Итог.Параметры.НовыйИтог = НовыйИтог;
	ТабличныйДокумент.Вывести(СтруктураОбластей.Итог);
	
	Возврат ПоместитьВоВременноеХранилище(ТабличныйДокумент, УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура СФормироватьПриОткрытии()
	
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура МенеджерыЗавершениеВыбора(РезультатВыбора, ПараметрыОбработчика) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ОтборМенеджерыВсе = РезультатВыбора;
	
	ОтборМенеджеры = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из РезультатВыбора Цикл
		Если ЭлементСписка.Пометка Тогда
			ОтборМенеджеры.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление, ЭлементСписка.Пометка, ЭлементСписка.Картинка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция РезультатЛидаПоОтбору()
	
	Если ОтборРезультат = "ВРаботе" Тогда
		Возврат Перечисления.ВариантЗавершенияРаботыСЛидом.ПустаяСсылка();
	ИначеЕсли ОтборРезультат = "КачественныйЛид" Тогда
		Возврат Перечисления.ВариантЗавершенияРаботыСЛидом.ПереведенВПокупателя;
	ИначеЕсли ОтборРезультат = "НекачественныйЛид" Тогда
		Возврат Перечисления.ВариантЗавершенияРаботыСЛидом.НекачественныйЛид;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ВидЛидаПоОтбору()
	
	Если ОтборВид = "Первичное" Тогда
		Возврат Перечисления.ВидыЛидов.ПервичноеОбращение;
	ИначеЕсли ОтборВид = "Повторное" Тогда
		Возврат Перечисления.ВидыЛидов.ПовторноеОбращение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	ПредставлениеЗначения = Новый ФорматированнаяСтрока(БиблиотекаКартинок.ПервичныйЛид, НСтр("ru = ' Первичное'"));
	ИнтерактивныйСписокВыбораВидаЛида.Добавить("Первичное", ПредставлениеЗначения);
	ПредставлениеЗначения = Новый ФорматированнаяСтрока(БиблиотекаКартинок.ПовторныйЛид, НСтр("ru = ' Повторное'"));
	ИнтерактивныйСписокВыбораВидаЛида.Добавить("Повторное", ПредставлениеЗначения);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьЗначениеОтбораПоПериоду()
	
	//@skip-check unknown-form-parameter-access
	Если Параметры.Свойство("Отбор") И ТипЗнч(Параметры.Отбор) = Тип("Структура") Тогда
		Если Параметры.Отбор.Свойство("ПериодРасшифровки") Тогда	
			ОтборПериодРасшифровка = Параметры.Отбор.ПериодРасшифровки; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АдаптацияТакси()
	
	Если ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.КоманднаяПанель.Видимость = Истина;
	Элементы.Переместить(Элементы.ФормаСформировать, Элементы.КоманднаяПанель);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИзменитьФорму", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Справка", "Видимость", Ложь);
	
КонецПроцедуры

#КонецОбласти
